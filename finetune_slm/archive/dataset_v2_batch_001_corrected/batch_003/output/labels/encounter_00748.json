  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I'm worried. I've been waking at night in a sweat, shaking, and my meter says my sugar's low. It's happened three times this month.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for telling me, that's important. What does the meter say, when it happens?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two point eight, once. Three point one another time. I ate some biscuits and it came up.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you lose consciousness, or have a fit, when it happens?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:46",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no, I don't pass out, and I've never had a fit. I wake up myself.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:57",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's go through your treatment.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:03",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Insulin glargine, 20 units at night. Metformin, 1000 mg twice a day. And gliclazide, 80 mg twice a day.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:14",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you take the gliclazide even when you haven't eaten?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:23",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I try to, but if I skip dinner, I sometimes skip it as well. I'm not always sure what I've done.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:36",
      "supports": [
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for being honest. I'll note that the gliclazide is meant to be twice a day, but you're not always sure. Any allergies?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[2]",
        "medications[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none.",
      "start_timestamp": "01:53",
      "end_timestamp": "01:55",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Medical history?",
      "start_timestamp": "01:58",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Type 2 diabetes, fifteen years. And high blood pressure.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any operations?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:11",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Cataracts, both eyes, three years ago.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's the combination. I'd say these night-time lows are most likely due to the gliclazide and insulin together with smaller meals.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:19",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like you to cut the gliclazide to 40 mg twice a day and keep the insulin the same for now. Eat a small snack with carbohydrate at bedtime.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:42",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your sugars may run a little higher, which is safer than lows. I'd like to arrange an HbA1c blood test, to see the longer-term picture.",
      "start_timestamp": "03:52",
      "end_timestamp": "04:05",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Treat with fast sugar, fifteen to twenty grams, a glass of juice, retest in fifteen minutes, then eat a snack. And ring us with your readings.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please do. If you ever can't wake properly or can't treat it yourself, your family should call 999.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:49",
      "supports": [
        "clinical_actions[3]"
      ]
    }
