  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. I'm giving up smoking, I did my last one on Monday, and I'm worried about my cough, because it's got worse since I stopped, and I thought it'd be better.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "First of all, well done. That's the best thing you can do for your health. Tell me about the cough.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's a wet, hacking cough, mostly in the morning. I bring up grey phlegm. It was always there, but it's heavier now.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long have you had the cough, before and after stopping?",
      "start_timestamp": "00:44",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Years, really. Three or four. And the extra bit, since Monday.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much did you smoke?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:02",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Twenty-five a day, for thirty years.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:07",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any breathlessness, wheeze, or chest tightness?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit puffed on the stairs. And a wheeze, sometimes, at night.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any blood in the phlegm?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:26",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. None.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or weight loss?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No weight loss. I've put some on, from the sweets.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:45",
      "supports": [
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any conditions?",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure. That's it.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 82, oxygen 95 percent, blood pressure 136 over 84, temperature 36.7, weight 85 kilos.",
      "start_timestamp": "02:31",
      "end_timestamp": "02:38",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's some wheeze, particularly when you breathe out, and a few crackles at the bases, and your breathing out takes longer than normal.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:33",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "With your history and the cough, wheeze and breathlessness, this suggests chronic obstructive pulmonary disease, COPD, caused by smoking.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:48",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "To be sure, I'd like to arrange a breathing test, spirometry, and a chest X-ray.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:20",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll refer you to the stop smoking service today.",
      "start_timestamp": "05:01",
      "end_timestamp": "05:07",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the cough turns green or yellow with fever, you cough up blood, or you get very breathless, come back or call 999.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:25",
      "supports": [
        "clinical_actions[3]"
      ]
    }
