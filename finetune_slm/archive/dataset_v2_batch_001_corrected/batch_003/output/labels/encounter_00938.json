    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Clusters of blisters on a red base, in a band on the right chest wall, not crossing the middle. That is classic for shingles.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:32",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. Because you're within the first few days, I'd like to start an antiviral, aciclovir, 800 mg, five times a day for seven days.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:55",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "To anyone who hasn't had chickenpox, yes, until the blisters crust over. Please avoid pregnant women, babies and anyone with a weak immune system.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:37",
      "supports": [
        "clinical_actions[2]"
      ]
    },
