    {
      "evidence_id": "EV_018",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, I've done his observations. Pulse 78, blood pressure 130 over 82, temperature 36.9, oxygen 98 percent, breathing 16.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:44",
      "supports": [
