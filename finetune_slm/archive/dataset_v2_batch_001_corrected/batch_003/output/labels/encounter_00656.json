  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. I'll be as precise as I can, because this is a bit unusual. My cousin died suddenly last month, aged thirty-one, and I'd like to be screened.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint",
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm very sorry to hear that. Do you know what the cause was?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:25",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "They say it was his heart, an arrhythmia of some kind. They're still waiting for the full post-mortem results.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:37",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Possibly. Now and then I get a flutter in my chest, a sort of skipped beat. But I can't say when I first noticed it.",
      "start_timestamp": "00:52",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it when you're resting, or exercising?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Resting, usually. It might have been last year, or the year before, I honestly couldn't tell you.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you ever faint, or nearly faint, with it?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, never. I've never fainted in my life.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Do you exercise much?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I run three times a week, five kilometres, and I've never had trouble with it.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:57",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's reassuring. Any allergies I need to know about before I examine you?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:08",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None at all. No allergies.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:15",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 62, regular, and blood pressure 118 over 74.",
      "start_timestamp": "02:39",
      "end_timestamp": "02:45",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A skipped beat at rest, in someone who runs and has a normal pulse, is most likely ectopic beats, which are extra beats and very common.",
      "start_timestamp": "03:07",
      "end_timestamp": "03:19",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to refer you to the inherited cardiac conditions clinic, and they'll do the right tests, probably an ECG, an echocardiogram, and maybe a heart rhythm monitor.",
      "start_timestamp": "03:47",
      "end_timestamp": "04:00",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very much. Ask the family to share the post-mortem findings with the clinic, they'll want to see them.",
      "start_timestamp": "04:10",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Carry on as normal, and if you ever faint, or get chest pain with exercise, or a racing heart that won't settle, go to the emergency department.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:49",
      "supports": [
        "clinical_actions[2]"
      ]
    }
