  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I've been told to come back since the operation, because my stomach's been playing up. I'm trying to remember what I wanted to ask.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "That's the one. Oh, it'll come to me. The hiccups, yes! I get hiccups, and belching, after I eat. Not every time.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do the hiccups go on for long?",
      "start_timestamp": "00:43",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "10 minutes, 15 minutes. And then I belch, loudly. It's very embarrassing at the golf club.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any vomiting?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No vomiting.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:08",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me go through your tablets with you.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:17",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right, I've got a list. Omeprazole, 20 mg, once a day. Ramipril, 5 mg once a day. Paracetamol, 500 mg when I need it. And, hold on, the other one, for the nerves, I think it's amitriptyline, maybe 10 mg, at night?",
      "start_timestamp": "01:20",
      "end_timestamp": "01:40",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the amitriptyline, 10 mg, at night, as you recall it. I'll check the record. Any other medical history?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:54",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medications[3]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, and an irritable bowel.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The scars from the keyhole operation are healing nicely, and your tummy is soft and not tender.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:38",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hiccups and belching after a meal, in someone who's had abdominal surgery, are usually due to swallowing air, eating too fast, or acid reflux. I'd say this is most likely excess air-swallowing and reflux after the operation.",
      "start_timestamp": "02:47",
      "end_timestamp": "03:04",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Usually it does, within a few months. I'd like to arrange a blood test, to make sure everything's in order after the operation, including your liver.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:24",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Eat slowly, take smaller meals, avoid fizzy drinks and chewing gum, and sit upright for an hour after eating.",
      "start_timestamp": "04:18",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks, to see how the belching is.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[1]",
