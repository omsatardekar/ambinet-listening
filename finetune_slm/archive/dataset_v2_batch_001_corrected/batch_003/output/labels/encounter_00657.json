  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, g'day. Look, I'm not really sure why I'm here, the kidney lady said to come and see you. Something about my numbers going down.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired, mostly. Dragging myself around. It's been like that since the winter, I reckon.",
      "start_timestamp": "00:53",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My ankles puff up by the end of the day, my socks leave marks.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Both ankles?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Both, yeah. Though the left's a bit worse.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you noticed any blood in your urine, or has it been frothy?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No blood. It's bubbly sometimes, I suppose, but no blood.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anyone in the family with kidney trouble?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:08",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mum. She ended up with kidney failure, around sixty. She was on dialysis for a bit before she passed.",
      "start_timestamp": "02:11",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sorry. That's helpful for me to know. Any trouble with your breathing?",
      "start_timestamp": "02:24",
      "end_timestamp": "02:31",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my breathing's fine.",
      "start_timestamp": "02:33",
      "end_timestamp": "02:36",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's mild swelling around both ankles, a bit more on the left, and when I press it leaves a dent.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:26",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your lungs are clear. Good.",
      "start_timestamp": "04:02",
      "end_timestamp": "04:05",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The kidney number, called the eGFR, is lower than it should be and it's been falling. With the tiredness and swelling, I can't rule out something blocking the flow of urine, though a slow, long-term kidney problem is more likely.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:31",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a kidney ultrasound, to look at their size and check there's no blockage.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:47",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the one. And I'd like a urine test to look for protein. You'll collect a sample in the morning.",
      "start_timestamp": "04:55",
      "end_timestamp": "05:07",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try to eat less salt, because it makes the ankles swell, and put your feet up in the evenings.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:23",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Maybe fewer pies. If the swelling spreads up your legs, or you start passing much less urine, come back sooner.",
      "start_timestamp": "05:32",
      "end_timestamp": "05:44",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
