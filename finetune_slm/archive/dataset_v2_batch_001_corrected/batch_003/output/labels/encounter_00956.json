  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'm Meena, I look after Mrs Rao in the daytime. Her fingers go white, very white, in the cold. She wanted me here.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. White.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When does it happen, Mrs Rao?",
      "start_timestamp": "00:21",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Cold. Fridge. Winter.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Even when she takes the milk out of the fridge, doctor. And the tips of the fingers go blue after, and then red.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it painful?",
      "start_timestamp": "00:48",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When warm. Tingling. Pain.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's worse in the evening, she rubs her hands together and she cries a little.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any sores on the fingertips?",
