  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Last Tuesday, at 10.40 in the morning, I lost the vision in my left eye. Completely, like a curtain coming down from above. It lasted about four minutes, and then it went away.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:58",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very clear, thank you. Was it just the one eye?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. When I covered the right eye, I could see nothing. When I covered the left, the right was normal.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain in the eye, headache, or flashing lights?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No pain. No headache. No flashes.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness in your face or limbs, or any trouble with speech at that time?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None of those.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:01",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me look at your medicines.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:07",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "I've got the list, doctor. Aspirin, 75 mg, once a day. Atorvastatin, 40 mg at night. And amlodipine, 5 mg, once a day.",
      "start_timestamp": "02:09",
      "end_timestamp": "02:22",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your medical history?",
      "start_timestamp": "02:28",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "High blood pressure, high cholesterol, and he had a heart attack, six years ago.",
      "start_timestamp": "02:32",
      "end_timestamp": "02:41",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your vision, pupils and eye movements are normal, and the back of the eye looks healthy. There's a swishing sound, a bruit, over the left side of your neck.",
      "start_timestamp": "03:12",
      "end_timestamp": "03:28",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Of the eye, yes, it's the same process. It's a warning. I'd like you to have an urgent ultrasound scan of the arteries in your neck, a carotid scan, within days, and blood tests.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:18",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Una. Keep taking all your tablets, especially the aspirin and the atorvastatin.",
      "start_timestamp": "04:43",
      "end_timestamp": "04:50",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it happens again, or you get weakness in the face or an arm, slurred speech, or loss of vision that doesn't clear, call 999 immediately.",
      "start_timestamp": "04:57",
      "end_timestamp": "05:10",
      "supports": [
        "clinical_actions[3]"
      ]
    }
