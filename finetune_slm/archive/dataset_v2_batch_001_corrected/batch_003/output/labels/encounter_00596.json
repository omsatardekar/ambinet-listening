  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Well. It's been a good few weeks since you came out of hospital. How would you say things are going?",
      "start_timestamp": "00:44",
      "end_timestamp": "00:56",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "That's great. And when you're out on that walk, have you had any chest pain at all?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No. None.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "What about getting short of breath, going up the hill or the stairs?",
      "start_timestamp": "01:49",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No, I'm not.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:01",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling around your ankles in the evenings?",
      "start_timestamp": "02:02",
      "end_timestamp": "02:07",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No. Feet are fine.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:17",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "The aspirin. And the cholesterol one.",
      "start_timestamp": "02:28",
      "end_timestamp": "02:33",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "The aspirin, is that the 75 mg, once a day?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:40",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yeah. With breakfast.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:45",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "And the cholesterol tablet, the atorvastatin. Is that 40 mg?",
      "start_timestamp": "02:47",
      "end_timestamp": "02:53",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "That's it. At night, before bed.",
      "start_timestamp": "02:55",
      "end_timestamp": "02:59",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I'd say yes, in stages. Start with the driving range and a short nine, before you try a full round.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:07",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Ha. And I should ask, you used to smoke, didn't you? Where are we with that?",
      "start_timestamp": "04:14",
      "end_timestamp": "04:23",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Gave up smoking. Twelve years ago now.",
      "start_timestamp": "04:25",
      "end_timestamp": "04:29",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Well done. Keep it that way. And you've still got the high blood pressure on your record, from years back.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:42",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I do, yeah. They keep an eye on it.",
      "start_timestamp": "04:45",
      "end_timestamp": "04:50",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Your chest is clear, both sides. Nothing to worry about there.",
      "start_timestamp": "05:32",
      "end_timestamp": "05:38",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "So, from what I can see today, you're recovering well. That's what I'd call it, a steady recovery, on track.",
      "start_timestamp": "06:00",
      "end_timestamp": "06:12",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a blood test for your cholesterol, to check the tablet's doing its job. The nurse at the desk will book it.",
      "start_timestamp": "06:19",
      "end_timestamp": "06:33",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to see you again in six weeks, to go through the result and see how the walking is going.",
      "start_timestamp": "06:55",
      "end_timestamp": "07:06",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Keep the walking up, and build it slowly. Don't push to the point of being wrecked.",
      "start_timestamp": "07:12",
      "end_timestamp": "07:20",
      "supports": [
