  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Hi, doctor. Dad's been constipated since the iron tablets.",
      "start_timestamp": "00:12",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pleased to meet you both. Mr Kapoor, when did the constipation start?",
      "start_timestamp": "00:19",
      "end_timestamp": "00:27",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a month ago, six weeks, I really can't say, it crept up.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's been two months, Dad, since they started the iron.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So between one and two months, we'll say. How often do you go to the toilet now?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every three or four days. And it's hard. Pellets, like a rabbit.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about your medicines.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:09",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ferrous sulphate, 200 mg, twice a day, for my anaemia. And metformin, 500 mg, twice a day, for my diabetes.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:24",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That fits. Iron is a very common cause of constipation. Do you have any family history of bowel problems?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:38",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "His brother had bowel polyps, doctor. Removed, about ten years ago.",
      "start_timestamp": "01:39",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. And what do you eat, any fibre in your diet?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Rice, dal, a bit of chapatti. Not much fruit. I don't like it.",
      "start_timestamp": "02:00",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tummy is soft, and I can feel some firm stool in the left lower side. Pulse is 72, blood pressure 130 over 82.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:43",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, but not why it was low. I'd like to arrange a blood test, to see how the iron is responding, and I'll check on a bowel referral.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:28",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, we can try one tablet a day, or every other day, which is gentler. Take it with orange juice for absorption.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:51",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And a stool softener, plus more fibre, prunes, brown bread, and plenty of water.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:07",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in four weeks, with the blood results.",
      "start_timestamp": "04:54",
