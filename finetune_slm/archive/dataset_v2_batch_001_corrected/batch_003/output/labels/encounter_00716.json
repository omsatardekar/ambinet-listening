  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi. Um, I think I might have malaria. I got back from Ghana ten days ago, and I've been getting these fevers.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for coming promptly. Tell me about the fevers.",
      "start_timestamp": "00:15",
      "end_timestamp": "00:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "They come in waves. I'll be fine, then I get cold and shivering, and then burning hot, and drenched in sweat. It's every second day, I think.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does each episode last?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Five or six hours. Then I'm wiped out.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's useful to know. Any diarrhoea or vomiting?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No diarrhoea. I was a bit nauseous during the fevers, but I haven't been sick.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:32",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any rash, or yellowing of your skin or eyes?",
