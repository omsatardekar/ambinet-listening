    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's what happens with malaria, so I'm taking it seriously. From what you describe, fevers every second day after a trip to West Africa, I'd say malaria is the likely cause until proven otherwise.",
      "start_timestamp": "03:02",
      "end_timestamp": "03:22",
