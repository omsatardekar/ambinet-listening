    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tummy is soft, and I can feel your spleen edge, it's a little bit enlarged.",
      "start_timestamp": "02:44",
