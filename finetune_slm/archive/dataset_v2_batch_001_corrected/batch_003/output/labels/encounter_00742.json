  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I've come about the weight clinic, I think? Or was it the diabetes clinic? Oh, the letter's in my bag somewhere.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "To lose weight. I've been trying for years, diets, the gym, all of it, and I put it all back on. I'm up to the highest I've ever been.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much do you weigh now, as far as you know?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I haven't weighed myself in a month, because the scales scare me. Last time it was a hundred and fourteen.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Knees ache, I get out of breath on the stairs, and I'm tired.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:20",
      "supports": [
        "review_of_systems[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, or breathlessness at rest?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:28",
      "supports": [
        "review_of_systems[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing at rest. Just on the stairs.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:34",
      "supports": [
        "review_of_systems[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your waist measures 112 centimetres, which is in the high-risk range for heart and diabetes problems.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:32",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange blood tests, for sugar, cholesterol, liver, kidneys and thyroid, to see what weight is doing to you and whether anything else is contributing.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:42",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Next, a dietitian will see you, and I'd like you to see them before the next appointment.",
      "start_timestamp": "03:58",
      "end_timestamp": "04:07",
      "supports": [
        "review_of_systems[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "For now, keep a food diary for two weeks, everything you eat and drink, honestly, and walk twenty minutes a day.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:40",
      "supports": [
        "clinical_actions[2]"
