  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. I'm not here for a lecture. I had COVID in March, and I'm still not right, six months on.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No lecture. Tell me how you're not right.",
      "start_timestamp": "00:14",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tired. Not normal tired, flat. I wake up tired. I was running a team of twelve and now I can't concentrate on an email.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else?",
      "start_timestamp": "00:35",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Breathless on the stairs, and when I walk quickly. I get a tight feeling in my chest, but no pain.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain at all?",
      "start_timestamp": "00:53",
      "end_timestamp": "00:56",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I said, it's tightness, not pain. No chest pain.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:03",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair, thank you. What are you taking at the moment?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:12",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Vitamin D, 1000 units, every day, which I forget about half the time. That's all.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:20",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, so the plan is daily, but you often forget. Any long-term conditions?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:28",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Type 2 diabetes, diet-controlled.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:32",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any lung problems in the family?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:39",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mum had COPD. She smoked.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you smoke?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Never. Not once.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:54",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 82, blood pressure 128 over 80, temperature 36.7, oxygen 97 percent, and weight 79 kilos.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:26",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's clear again today, no wheeze at all.",
      "start_timestamp": "03:03",
      "end_timestamp": "03:09",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "After COVID, many people have fatigue and breathlessness for months. That's what's commonly called long COVID. But I can't rule out asthma coming on after the infection, because of the chest tightness.",
      "start_timestamp": "03:17",
      "end_timestamp": "03:36",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a breathing test, spirometry, to see how your lungs behave.",
      "start_timestamp": "03:43",
      "end_timestamp": "03:51",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, I'm going to give you a salbutamol inhaler, 100 micrograms, two puffs when you're tight or breathless, and we'll see if it helps.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:13",
      "supports": [
        "medications[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pace yourself, short breaks during the day, build up activity slowly, and don't push on the bad days.",
      "start_timestamp": "04:20",
      "end_timestamp": "04:28",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If your breathlessness is no better in four weeks, come back and see me and we'll look at other tests.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:01",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
