      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing physical.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:08",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What you describe, low mood every autumn and winter, with oversleeping and overeating, lifting in spring, fits seasonal affective disorder.",
      "start_timestamp": "03:11",
      "end_timestamp": "03:23",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Get outdoors for half an hour at lunchtime, even if it's cloudy, and keep a regular sleep routine.",
      "start_timestamp": "03:49",
      "end_timestamp": "03:59",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A light box, a bright light you sit in front of for thirty minutes each morning, has good evidence.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:19",
      "supports": [
        "clinical_actions[3]"
      ]
    },
