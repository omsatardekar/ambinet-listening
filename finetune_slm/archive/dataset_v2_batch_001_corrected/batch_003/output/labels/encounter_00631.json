  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi doctor. Sorry, I know it's silly, but I can't stop sneezing and I'm starting to panic a bit.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It comes in fits. Like, I'll sneeze eight or nine times in a row, and then my eyes stream and my nose runs like a tap.",
      "start_timestamp": "00:18",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been going on?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the start of September. So about three weeks, I think. Maybe more.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it come at any particular time of day, or in particular places?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mornings, mostly, and when I'm outside walking the dog. It's much better when I'm indoors with the windows shut.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The lining of your nose is pale and a bit swollen on both sides. Nothing blocking it.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:29",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Well, to find out what is triggering it, I'd like to arrange a skin prick test.",
      "start_timestamp": "03:47",
      "end_timestamp": "03:58",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The nurse will book you in, within a fortnight or so. Don't take any antihistamines for three days beforehand, or the test won't work.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:42",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the windows shut in the morning, shower and change when you get in from the dog walk, and wash the dog's bed.",
      "start_timestamp": "04:48",
      "end_timestamp": "04:59",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most people get it under control once we know the trigger. I'd like to see you again in three weeks to go over the test.",
      "start_timestamp": "05:09",
      "end_timestamp": "05:21",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
