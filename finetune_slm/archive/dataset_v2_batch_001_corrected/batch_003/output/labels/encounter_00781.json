  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, I'm Marcus, Mr Delaney's carer. I'll be precise. Yesterday evening, around six, his face drooped on the right side, and his speech was slurred for about ten minutes. It's cleared now.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Marcus, that's very helpful. Mr Delaney, how are you now?",
      "start_timestamp": "00:17",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm fine now. Just a bit tired.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:31",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe what happened, as you remember it?",
      "start_timestamp": "00:34",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was watching the news. My mouth felt strange, like it was numb. And I couldn't find my words.",
      "start_timestamp": "00:41",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "His right cheek sagged, and his words came out garbled. His arm was fine, I tested it.",
      "start_timestamp": "00:53",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the droop completely gone now, Marcus?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Completely gone, the droop and the slurring. By seven it was normal.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness in your arm or leg, or loss of vision, even for a moment?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:30",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines is he taking?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:34",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Amlodipine, 5 mg once a day, and a little blue tablet for his cholesterol, I can't name it, it's in a dosette box, and the pharmacist fills it.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:49",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll check the record for the blue one. Any allergies?",
      "start_timestamp": "01:51",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, none.",
      "start_timestamp": "01:57",
      "end_timestamp": "01:59",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And his history?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:02",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "High blood pressure, for years.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does he smoke, or drink?",
      "start_timestamp": "02:10",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I gave up smoking years ago. I take a small whisky in the evenings.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:22",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your face is symmetrical, your speech is clear, your arm strength and grip are normal, and your walking is steady.",
      "start_timestamp": "02:56",
      "end_timestamp": "03:08",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Today he looks normal, but what you describe sounds like a mini-stroke, a transient ischaemic attack, where the blood supply to part of the brain is briefly interrupted.",
      "start_timestamp": "03:16",
      "end_timestamp": "03:30",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to refer him today to the stroke clinic, where they'll see him within 24 hours.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:06",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Until then, if the symptoms return, even for a moment, call 999 straight away, don't wait.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:36",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And please don't let him drive.",
      "start_timestamp": "04:42",
      "end_timestamp": "04:46",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. I'd like to see him again after the stroke clinic, next week.",
