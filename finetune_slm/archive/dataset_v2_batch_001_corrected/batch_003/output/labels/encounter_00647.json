  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello! I'm so sorry to be back, I feel like I'm wasting your time, but this throat just won't go.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nine days ago, and it started with a scratchy bit, and then it got worse and I couldn't swallow properly, so I went to the pharmacy and they gave me a course of something.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A course, antibiotics I think, I finished it yesterday, and I thought it'd be gone, but it's not, it's actually worse, my left ear hurts when I swallow too.",
      "start_timestamp": "00:55",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So you've had a sore throat for nine days and it's not improving. How would you rate the pain?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's bad. I'd say severe at the moment. I can't eat toast.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no fever, I've been taking my temperature. It's been normal.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies, particularly to antibiotics?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:50",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Penicillin, I believe. I know I react to it, but I honestly can't remember what happened. It was years ago and Mum told me not to take it.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:06",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's very useful, so we'll avoid that whole family. Anything else in your medical history?",
      "start_timestamp": "02:08",
      "end_timestamp": "02:16",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just asthma, but it's mild.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tonsils are red and swollen, and there are white patches on both of them.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:54",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It tells me there's a bacterial infection on the tonsils. It fits with tonsillitis, so I'd say bacterial tonsillitis is the likely cause.",
      "start_timestamp": "03:00",
      "end_timestamp": "03:12",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly. So I'm going to start you on clarithromycin, 500 mg twice a day, for five days.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:48",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a different family, which you can take safely with your penicillin reaction. It's for the throat infection, and take it with food.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:07",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Plenty of fluids, soft food, and rest. Gargling with warm salty water can ease the soreness.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:25",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I'd like to see you in a week to be sure it's gone, especially with the ear pain.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
