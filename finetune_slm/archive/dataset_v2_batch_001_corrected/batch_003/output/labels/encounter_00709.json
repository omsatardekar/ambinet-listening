  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm knackered. I had a bad flu in October, and I've never really got over it. It's been six weeks.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:52",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What does knackered feel like?",
      "start_timestamp": "00:56",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Like my battery's at ten percent. I sleep nine hours and wake up tired. I can't concentrate in lectures.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other symptoms?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My throat's been sore on and off, and my glands feel lumpy, here.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, night sweats, or weight loss?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. I'd have noticed.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't rule out glandular fever, given your housemate, the sore throat, the tender glands, and fatigue after a viral illness, though it could also be a slow recovery from the flu.",
      "start_timestamp": "02:47",
      "end_timestamp": "03:03",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, I'd like to arrange a blood test, to check for the glandular fever virus and your blood count.",
      "start_timestamp": "03:13",
      "end_timestamp": "03:24",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, no contact sports, in case your spleen is enlarged, and avoid alcohol until we know.",
      "start_timestamp": "03:53",
      "end_timestamp": "04:01",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Maybe ask for shifts that don't involve lifting crates, too. Rest when you can, and eat regularly.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:37",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you get severe tummy pain on the left side, or a high fever, or difficulty swallowing, come in the same day.",
      "start_timestamp": "04:47",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_actions[3]"
      ]
