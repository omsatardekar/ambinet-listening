      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "We had a large roast, with a great deal of crackling, and about an hour after, I felt a pressure behind my breastbone. It lasted about twenty minutes, and it's not happened since.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A burning, a sort of heat, rising up behind the bone.",
      "start_timestamp": "00:53",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did it spread anywhere?",
      "start_timestamp": "01:01",
