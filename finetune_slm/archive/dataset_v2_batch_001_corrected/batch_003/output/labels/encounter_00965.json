  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I had a funny turn on Saturday night, chest discomfort after a very big meal, and my wife insisted I come, although I'm sure it's nothing.",
