      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, not to my arm or my jaw. It stayed where it was.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:13",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you get it when you walk, or climb stairs?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I walk to the farm gate and back every day. Nothing like that.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:31",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Did you feel bloated?",
