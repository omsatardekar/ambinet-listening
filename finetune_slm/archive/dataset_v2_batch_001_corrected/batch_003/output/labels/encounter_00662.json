  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "We were told to come back today. The midwife said the baby was a bit yellow on Tuesday.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_4",
      "speaker_role": "clinical_staff",
      "transcript_text": "Hello, I'm Marsha, the healthcare assistant. I did her bilirubin reading just before you came in.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:36",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She's been sleepy, very sleepy, I have to wake her for feeds. And she's not finishing them, she falls asleep on the breast.",
      "start_timestamp": "00:48",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How many feeds is she taking in a day, roughly?",
      "start_timestamp": "01:02",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Six or seven, but short ones. I'm not sure it's enough.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "She's telling us she's hungry. When did you first notice the yellow colour?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "I couldn't tell you exactly. Maybe Monday, maybe Tuesday morning, I honestly don't know. I'm not good at remembering with so little sleep.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[2]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's absolutely fine. Are her nappies wet and what colour are her poos?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:53",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Wet, plenty. The poos are yellow-green, not pale. I looked at them in the light, like they said.",
      "start_timestamp": "01:54",
      "end_timestamp": "02:05",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Has she had any fevers or felt hot?",
      "start_timestamp": "02:06",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, nothing hot. She's actually a bit cool, with her little hands.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:20",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How was the birth? Was she born on time?",
      "start_timestamp": "02:21",
      "end_timestamp": "02:26",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Thirty-seven weeks, so a bit early, but she was a good weight.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:34",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
      "speaker_role": "clinical_staff",
      "transcript_text": "Doctor, the reading I got was 210. I did it twice.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:41",
      "supports": [
        "procedures_and_investigations[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Heart rate 142, temperature 36.9, breathing rate 38, oxygen 98 percent, weight 3.1 kilos.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:13",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "She's yellow down to her chest, her soft spot is flat and normal, and she's alert when she's awake, with good tone.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:23",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]",
        "physical_examination[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a heel prick, just a few drops. I'd like to send a bilirubin blood test today, and I'd like her feed volumes checked with the midwife.",
      "start_timestamp": "04:53",
      "end_timestamp": "05:06",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Feed her at least eight times a day, wake her if she sleeps more than three hours, and keep her in daylight, near a window, not in direct sun.",
      "start_timestamp": "05:22",
      "end_timestamp": "05:40",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If she's very sleepy, won't feed, or her poos go pale, ring us straight away, any hour.",
      "start_timestamp": "05:49",
      "end_timestamp": "05:59",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to see you both tomorrow, to review the result and her weight.",
      "start_timestamp": "06:04",
      "end_timestamp": "06:13",
