  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'd rather not make a fuss, but my wife insisted. I've got a terrible pain in my left side, round the back.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You were right to come. Let's get you comfortable. When did the pain start?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About six this morning. It woke me up. I've not had a pain like it, to be honest.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How would you describe it? Constant, or does it come in waves?",
      "start_timestamp": "00:35",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Waves. It builds up until I can hardly stand, then eases off a bit, then builds up again.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How bad is it at the worst, if you had to put a word to it?",
      "start_timestamp": "00:54",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Severe. I was sick once on the way here, though I tried not to be in the car.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it spread anywhere, down into the groin for instance?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, it goes round the front and down low. That's what frightened me.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Understood. Have you had a temperature or shivering? Any fever at all?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:41",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No shivers. Nothing like that.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:46",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Now, what tablets do you take, if any?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:54",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Amlodipine, 5 mg, once a day. I take it in the morning with my tea.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:05",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you have any allergies, to medicines or anything else?",
      "start_timestamp": "02:07",
      "end_timestamp": "02:13",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none that I know of. Never have.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:19",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Is there any kidney trouble in your family? Your wife mentioned something on the phone.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My brother has polycystic kidney disease. That's why she was so worried when I called out.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:44",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 96, blood pressure 148 over 90, temperature 36.8, oxygen 99 percent, and you're breathing 18 times a minute.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:31",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You're very tender over the left loin, here, when I press. Your tummy itself is soft.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:20",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What you describe, with pain coming in waves and spreading to the groin, most likely a kidney stone. I'd like to be sure it's nothing more, though.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:43",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a CT scan of your kidneys today. It's quick, and it shows a stone and whether your kidneys are blocked.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:03",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll make sure the nurses see you straight away in the scan area. Please drink water while you wait, small sips.",
      "start_timestamp": "05:34",
      "end_timestamp": "05:44",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain suddenly gets much worse, or you start shivering, tell the staff at once.",
      "start_timestamp": "05:54",
      "end_timestamp": "06:03",
      "supports": [
        "clinical_actions[2]"
      ]
    }
