  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Mrs Whitcombe, good morning. I've got the letter here from your pharmacist, saying your pulse felt uneven when she checked it. Who've you brought with you?",
      "start_timestamp": "00:00",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "A fluttering, here in my chest, like a bird caught in a net. Comes and goes, been about two weeks.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I get a bit light-headed if I stand up too fast, but I put that down to age.",
      "start_timestamp": "01:51",
      "end_timestamp": "02:00",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She did go wobbly on Tuesday in the kitchen, doctor. She held on to the counter and it passed.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:12",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Maria, that's helpful. Mrs Whitcombe, I need to ask you something that may seem to come out of nowhere. Do you have any allergies?",
      "start_timestamp": "02:14",
      "end_timestamp": "02:27",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Allergies? Oh dear. I think I might be allergic to something, but I couldn't tell you what.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:38",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's said that to me as well, doctor. A bad turn after something, but never a name.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:18",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 142/88. Pulse is 92, and it's irregular. Temperature is 36.6 °C, and oxygen saturation is 97%.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:26",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Mostly fine. The irregular pulse is what I'd like to look at more closely. I'd like to do an ECG today, which is a tracing of the heart's rhythm.",
      "start_timestamp": "04:35",
      "end_timestamp": "04:49",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "A small one is not a problem today. Tell me, how much do you drink, as a rule?",
      "start_timestamp": "05:24",
      "end_timestamp": "05:34",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Oh, I like a drink of an evening, just a small sherry. The odd glass at Christmas, otherwise.",
      "start_timestamp": "05:37",
      "end_timestamp": "05:46",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Accurate, I'd say. If the fluttering gets any worse, please ring us, and if you faint, call an ambulance.",
      "start_timestamp": "06:38",
      "end_timestamp": "06:48",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    }
