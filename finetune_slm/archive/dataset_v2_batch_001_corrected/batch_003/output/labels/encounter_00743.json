    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It is, Frank, nice to meet you both. You finished the treatment course, I see. Remind me what you took.",
      "start_timestamp": "00:13",
      "end_timestamp": "00:23",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
