  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning, doctor. I'm Frank, and this is my wife Lorraine. We've come for the helicobacter retest, I hope that's the right word.",
