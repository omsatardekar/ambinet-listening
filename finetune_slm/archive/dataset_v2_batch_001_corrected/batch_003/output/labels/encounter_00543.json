  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've been throwing up since last night, doctor, and my sugar's been through the roof all day. I'm scared, I can't keep anything down, not even water.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:32",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I stopped counting. Maybe eight or nine times since last night. It's just a yellowish liquid now.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I took my long-acting insulin last night, 24 units, same as always. But I couldn't eat anything, so I wasn't sure if I should.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:41",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure is 98 over 60, heart rate is 118, and his blood sugar reading is 412.",
      "start_timestamp": "02:23",
      "end_timestamp": "02:34",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Have you got any chest pain, or trouble breathing?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:40",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my chest is fine. I'm breathing okay, just a bit fast, I guess.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:51",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your mouth is very dry, the lining looks parched. Now I'll press on your belly, tell me if it hurts.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:24",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your belly is soft, with mild tenderness in the upper part. No sign of anything needing surgery, which is good.",
      "start_timestamp": "03:37",
      "end_timestamp": "03:48",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, I already did a urine test when he came in, the result is on the screen.",
      "start_timestamp": "03:50",
      "end_timestamp": "03:58",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Perfect, thanks. Mr. Alvarez, do you have any allergies we should know about before we give anything?",
      "start_timestamp": "04:00",
      "end_timestamp": "04:10",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hmm. I think so, maybe. There was some medicine they gave me in a hospital once that didn't agree with me. I couldn't tell you what it was.",
      "start_timestamp": "04:11",
      "end_timestamp": "04:26",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "caregiver",
      "transcript_text": "I've only been with him two years, so I wouldn't know. It's not in his folder either.",
      "start_timestamp": "04:28",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good idea. Now, here's what I'm thinking. With the vomiting, the high sugar, the fast breathing and the dry mouth, this looks like ketoacidosis, which means acid is building up in the blood.",
      "start_timestamp": "05:00",
      "end_timestamp": "05:16",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "First, I'd like to order blood tests for ketones and your salts, to see how much acid and how low your fluids are.",
      "start_timestamp": "05:50",
      "end_timestamp": "06:02",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd also like to do an ECG, a heart tracing, because the salts can affect the heart's rhythm. It's painless, just stickers on your chest.",
      "start_timestamp": "06:16",
      "end_timestamp": "06:28",
      "supports": [
        "procedures_and_investigations[2]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll decide on the treatment once the results are back. I'll come back to see you in two hours, or sooner if anything changes.",
      "start_timestamp": "06:36",
      "end_timestamp": "06:50",
      "supports": [
        "clinical_actions[4]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not for now, please. Nothing to eat or drink until I've seen the results, even sips, because he might vomit again.",
      "start_timestamp": "06:59",
      "end_timestamp": "07:09",
      "supports": [
        "clinical_actions[3]"
      ]
    }
