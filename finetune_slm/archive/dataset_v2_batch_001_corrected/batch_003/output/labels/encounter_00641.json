  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Thanks for seeing us. Darragh has had a cold since Sunday and last night I heard a whistling in his chest.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about the whistling. Is it there all the time?",
      "start_timestamp": "00:29",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's mostly when he breathes out. It comes and goes. It was loudest at about two this morning.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any temperature? Has he felt hot at all?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, I checked him this morning, he's not hot. No temperature at all.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a bit of wheeze on both sides when he breathes out, but the air's moving well, there's no work of breathing and no sucking in under the ribs.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:39",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd say this is a viral wheeze, brought on by his cold, which is very common in toddlers.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:54",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep him drinking, let him rest, and keep the room smoke-free. Raise his head a little at night if he'll tolerate a pillow.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:56",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If he's breathing fast, you can see his tummy sucking in, he can't finish a sentence or a feed, or his lips go a bit blue, call 999.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:29",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I don't expect it, but I'd rather you know. And if the wheeze is still there after five days, or he's not feeding, bring him back.",
      "start_timestamp": "04:37",
      "end_timestamp": "04:52",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
