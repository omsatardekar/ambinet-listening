  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. It's the whiplash, from the car crash in the summer. I'm better but not right, if you know what I mean.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me how it is now.",
      "start_timestamp": "00:15",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My neck's stiff, especially in the mornings, and I get a pain across my shoulders by the afternoon. Worse after driving.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the pain going down your arms, any numbness or tingling?",
      "start_timestamp": "00:52",
      "end_timestamp": "00:58",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing in my arms. No tingling.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you using for the pain?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:10",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Naproxen, 250 mg, twice a day, maybe? And paracetamol, 1 gram, but I only take that when it's bad, so not every day.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:23",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. So 250 mg twice a day, as you recall it, and the paracetamol only when it's bad. Remind me of your history.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:39",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, a stomach ulcer, years ago, and my back's not great. Slipped disc.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:51",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any operations?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "An operation on my lower back, a discectomy, in 2014.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you working?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:07",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I'm a delivery driver. Hours in the van.",
      "start_timestamp": "02:09",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tender over the muscles on both sides of the neck, tight and knotted in the upper shoulder muscles, and the movement is limited when you look over your shoulder.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:58",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's common. Whiplash can take months to settle, and the muscles tighten and guard. I'd say this is a persisting whiplash strain.",
      "start_timestamp": "03:05",
      "end_timestamp": "03:17",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand. Gentle exercises and physiotherapy help most. I'd like to arrange a referral for physio.",
      "start_timestamp": "03:38",
      "end_timestamp": "03:48",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A few weeks. Meanwhile, I'd like to arrange an X-ray of the neck, to be thorough, given the time that's passed.",
      "start_timestamp": "03:55",
      "end_timestamp": "04:06",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Also, naproxen and your old stomach ulcer don't mix well, so please always take it with food.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Use a warm pack, and break up your driving with stops to stretch.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain spreads into your arm, or you get weakness or numbness in your hands, come back that day.",
      "start_timestamp": "05:06",
      "end_timestamp": "05:17",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
