  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. My irritable bowel is flaring up again, and I've got exams in two weeks, so I'm panicking a bit.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, let's see what we can do. What's your tummy doing at the moment?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Cramping and cramping. Mostly lower down. Then I'm in the toilet a lot.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did this flare start?",
      "start_timestamp": "00:34",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm not sure. Maybe a week ago, or ten days? It crept up on me.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is the stool loose or hard?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Loose, mostly. Sometimes constipated for a day, then loose again.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any blood in the stool, or weight loss?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No blood. I've not lost any weight that I know of.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:20",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has this happened during exams before?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:26",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, every exam season. I've had IBS since I was sixteen.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:34",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 78, blood pressure 116 over 72, temperature 36.7, oxygen 99 percent, breathing 14.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:11",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mild tenderness in the left lower abdomen, soft, no guarding and no lumps.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:56",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It fits with an IBS flare brought on by stress. Nothing here worries me.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:11",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Peppermint oil capsules can ease the cramping. And a low-FODMAP diet can help for a few weeks.",
      "start_timestamp": "03:19",
      "end_timestamp": "03:28",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A diet that cuts out certain fermentable carbohydrates, like onions, garlic, and some fruits. I'll give you a leaflet.",
      "start_timestamp": "03:36",
      "end_timestamp": "03:45",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Try regular meals and less coffee. Even a short walk each day helps a flare.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll also arrange a blood test and a stool test, just to be certain that nothing else is going on.",
      "start_timestamp": "04:28",
      "end_timestamp": "04:38",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, within the week. If you're not better in two weeks, come back and we'll talk again.",
