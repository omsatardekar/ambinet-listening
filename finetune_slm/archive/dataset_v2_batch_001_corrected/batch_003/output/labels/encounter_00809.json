  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. I'll be direct. I'm eleven weeks pregnant, and I was in contact with a child with chickenpox on Tuesday, and I don't know if I'm immune.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:18",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you ever had chickenpox yourself?",
      "start_timestamp": "00:44",
      "end_timestamp": "00:48",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't think so. I was never told I'd had it. I can't remember a rash.",
      "start_timestamp": "00:51",
      "end_timestamp": "01:00",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any sign of a rash on you, or a fever?",
      "start_timestamp": "01:02",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No rash. A slight headache yesterday. No fever.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how's the pregnancy going otherwise?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit sick in the mornings, and tired. Nothing alarming.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking at the moment?",
      "start_timestamp": "01:30",
      "end_timestamp": "01:34",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Folic acid, 400 micrograms once a day, and a pregnancy multivitamin. I'm supposed to take them daily, but I miss a few days.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:46",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted, and that's fine. Any other conditions?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:52",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have asthma, and hypothyroidism.",
      "start_timestamp": "01:55",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 80, blood pressure 108 over 66, temperature 36.7, oxygen 99 percent.",
      "start_timestamp": "02:32",
      "end_timestamp": "02:39",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Clear, no wheeze. Now, what matters is whether you're immune. If you haven't had chickenpox, you could catch it, and in pregnancy it can be serious for you and the baby.",
      "start_timestamp": "03:13",
      "end_timestamp": "03:30",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a blood test today, to check for antibodies against chickenpox, with a result within a day or two.",
      "start_timestamp": "03:37",
      "end_timestamp": "03:48",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You are, comfortably. I'd say it's a possible exposure, and I'd call it a high-priority check, not an emergency.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:27",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, avoid contact with other pregnant women and newborns, and if a rash, fever, cough or breathing trouble appears, call me straight away.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:45",
      "supports": [
        "clinical_actions[1]"
      ]
    }
