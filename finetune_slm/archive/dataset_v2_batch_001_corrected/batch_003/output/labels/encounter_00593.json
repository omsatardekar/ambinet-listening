  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I'm here for the hep C follow-up, I think? The letter wasn't very clear about it.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:09",
      "supports": [
        "chief_complaint",
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's right. You finished your course of treatment in the spring, so today is about how you are and what we check next. How are you feeling in yourself?",
      "start_timestamp": "00:11",
      "end_timestamp": "00:28",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Better, mostly. I mean, tired, I'd say. Still tired, if I'm honest.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How tired, and is it there all day or only at certain times?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Most afternoons I just hit a wall. Heavy, sort of, I can't explain it better than that.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else you've noticed since you finished the treatment?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My joints are achy, knees and hands mostly.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did that start?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, I couldn't tell you. It crept up on me, I've no idea when it began.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough, that's very common. What about your tummy, any trouble there?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:36",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Now and then I feel queasy after fatty stuff, a fry-up or a takeaway.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is your skin or the whites of your eyes looking yellow at all?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:52",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. I'd have noticed, and so would the lads at work.",
      "start_timestamp": "01:53",
      "end_timestamp": "02:00",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your tummy is soft with no tenderness, and your ankles look fine, no swelling.",
      "start_timestamp": "02:36",
      "end_timestamp": "02:44",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's good, yes. Now, you've had a bit of a history with the hep C itself, which we're still confirming has cleared. Any operations in the past?",
      "start_timestamp": "02:51",
      "end_timestamp": "03:05",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just my appendix out when I was a teenager.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:13",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you smoke? What do you do for a living?",
      "start_timestamp": "03:16",
      "end_timestamp": "03:22",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Never smoked in my life. I drive a delivery van, so it's a lot of sitting about.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:33",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That fits with the afternoon slump, partly. Tiredness after treatment is common, but I can't rule out an underactive thyroid yet.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:46",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not especially, which is why it's only on my list rather than a diagnosis. I'd like to arrange blood tests, including the viral load to confirm the virus has cleared, and a thyroid check at the same draw.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:16",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, you can eat normally. I'd also like to book an ultrasound of your liver, just to look at it properly after everything it's been through.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:38",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Plan a short walk and a proper lunch break between deliveries, and try not to rely on sugary snacks to get you through.",
      "start_timestamp": "05:11",
      "end_timestamp": "05:22",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the tiredness isn't any better in six weeks, come back and see me and we'll look again.",
      "start_timestamp": "05:32",
      "end_timestamp": "05:44",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    }
