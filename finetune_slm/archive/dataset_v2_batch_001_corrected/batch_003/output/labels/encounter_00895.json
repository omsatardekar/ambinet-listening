  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I know this will sound odd, but I keep feeling like I'm going to black out when I'm standing in queues.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It doesn't sound odd at all, it's something I hear fairly often. Tell me what happens.",
      "start_timestamp": "00:15",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I go warm all over, and then the room sort of goes dark at the edges.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you actually fainted, or does it pass before that?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:44",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've never actually gone down. I always manage to lean on something or sit.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:53",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often has this happened?",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, maybe four or five times. Always in a queue, at the bank or the post office.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it happen when you're sitting or walking about?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Never then. Only when I'm standing still for a long time.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you feel your heart racing, or any chest pain with it?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:34",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little fluttering, I think, but no pain at all.",
      "start_timestamp": "01:36",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's reassuring. Do you smoke, or drink much coffee?",
      "start_timestamp": "02:39",
      "end_timestamp": "02:44",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't smoke. Coffee, about four cups a day.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:51",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me tell you what I think is happening. When you stand still, blood can pool in the legs and your pressure dips for a moment.",
      "start_timestamp": "03:11",
      "end_timestamp": "03:27",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most of the time it isn't, but I'd like to record your heart tracing to make sure the rhythm is normal.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:47",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, drink water through the day and have something to eat in the morning.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:16",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you're in a queue and start feeling it, shift your weight from foot to foot, or sit down straight away.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:36",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And if you do faint, or get chest pain, come in or call at once.",
      "start_timestamp": "04:44",
      "end_timestamp": "04:52",
      "supports": [
        "clinical_actions[3]"
      ]
    }
