      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, giving way. On the stairs mostly, going down. Last week I nearly fell at the office.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling?",
