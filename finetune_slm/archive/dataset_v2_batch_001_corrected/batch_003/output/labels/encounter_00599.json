  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Okay, so my sore throat is back again. It's like the fourth time since winter, and I'm honestly sick of it.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Um, a couple of weeks ago, I guess. But it's been on and off for about two months, if you count the earlier ones.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Kind of scratchy, like I swallowed a handful of gravel. Worse when I first wake up.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "There's these lumps under my jaw. They feel like little peas, right here, on both sides.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a fever with this?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, last week I had one, I was kind of shivery for a couple days. But that went away on Sunday.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:56",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Fever gone, then. Any cough with it?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:02",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, not really. Just the throat.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:07",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And is swallowing hard, like food getting stuck?",
      "start_timestamp": "02:08",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, it hurts a little, but nothing gets stuck.",
      "start_timestamp": "02:15",
      "end_timestamp": "02:21",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "There's my blood pressure pill, lisinopril, 10 mg, once a day. I take it with my coffee.",
      "start_timestamp": "02:35",
      "end_timestamp": "02:43",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Tylenol, 500 mg, when it's bad. Probably most days, honestly. And those throat lozenges, I get through a few a day.",
      "start_timestamp": "02:51",
      "end_timestamp": "03:03",
      "supports": [
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. That's three things, then. Any allergies to medicines or anything else?",
      "start_timestamp": "03:05",
      "end_timestamp": "03:12",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nope, no allergies that I know of. I've taken everything.",
      "start_timestamp": "03:13",
      "end_timestamp": "03:19",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Temperature is 37.1 °C, and pulse is 76. Both nice and calm.",
      "start_timestamp": "03:46",
      "end_timestamp": "03:53",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Honestly, I can't say yet. It could be strep that keeps getting a foothold, and I can't rule that out. It might also be something viral that's lingering.",
      "start_timestamp": "04:21",
      "end_timestamp": "04:36",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Being run down helps these things along, but let's not guess. I'd like to do a throat swab for strep today, that's quick.",
      "start_timestamp": "04:44",
      "end_timestamp": "04:55",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd also like to order a blood test to check for mono, since the glands have been swollen so long.",
      "start_timestamp": "05:18",
      "end_timestamp": "05:28",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Warm salt water, plenty of fluids, and rest. Your throat is like a sprained ankle. It heals faster if you stop walking on it.",
      "start_timestamp": "06:15",
      "end_timestamp": "06:27",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in one week, to go through the results together.",
      "start_timestamp": "06:53",
      "end_timestamp": "07:02",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
