  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Morning, doctor. I'm Joan's carer, and we're here for her yearly over-seventy-fives check.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:08",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm fine. I do wish people would stop fussing. But since you ask, the forgetting is getting worse.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What sort of things do you forget?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Names, mostly. Where I've put my glasses. And last week I left the kettle on.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She's done it twice, doctor, the kettle. And she repeats herself.",
      "start_timestamp": "00:47",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My knees ache, particularly on the stairs.",
      "start_timestamp": "01:00",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Both knees?",
      "start_timestamp": "01:06",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Both, though the right is worse. And my hearing's going, I'm sure, though Maureen says it's just that I don't listen.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "It's both, doctor.",
      "start_timestamp": "01:23",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any falls in the last year?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:30",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No falls. I'm very careful.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:34",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And have you lost weight, or has your appetite changed?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I'm eating well. Maureen's cooking sees to that.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:50",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What medicines are you on?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Amlodipine, 5 mg once a day, and paracetamol, 500 mg, when her knees are bad.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:04",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies?",
      "start_timestamp": "02:07",
      "end_timestamp": "02:09",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None. I've been lucky.",
      "start_timestamp": "02:10",
      "end_timestamp": "02:13",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Medical conditions?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:18",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, and osteoarthritis in the knees.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke or drink?",
      "start_timestamp": "02:26",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Never smoked in my life. I have a sherry at Christmas, a small one.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:39",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Lovely. And any breathlessness, chest pain?",
      "start_timestamp": "02:49",
      "end_timestamp": "02:53",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing of that sort.",
      "start_timestamp": "02:56",
      "end_timestamp": "02:59",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's some creaking, a crunch, in both knees when they bend, but no swelling or heat.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:37",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That fits with osteoarthritis. As for the memory, a lot of things can cause forgetfulness, and I can't rule out early memory loss, which is why I'd like to look at it properly.",
      "start_timestamp": "03:44",
      "end_timestamp": "04:02",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I don't want to put a label on it, Joan. I'd like a short memory test, today, if you're willing, and some blood tests to rule out simple causes, like vitamin B12 or thyroid.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:29",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Until the results, please don't leave the kettle unattended. Maybe a kettle with an automatic switch-off.",
      "start_timestamp": "04:55",
      "end_timestamp": "05:03",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, to talk through the tests.",
      "start_timestamp": "05:10",
      "end_timestamp": "05:17",
