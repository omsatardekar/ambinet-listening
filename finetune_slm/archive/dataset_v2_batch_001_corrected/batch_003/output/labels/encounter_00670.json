    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm Dr Wallace. We've got you down for the left eye. Let's look at your medicines first. What are you taking?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:46",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
