      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, mate, it's 3. It's definitely 3. Well, it might have gone up.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:16",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "I'll write down 3 from you and 5 from our records, and we'll check with the pharmacy.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:29",
      "supports": [
        "medications[0]",
        "clinical_uncertainties[0]"
