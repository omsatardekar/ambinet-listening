    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, hello, sorry, I'm Bruce, I'm here for the cataract thing, the pre-op, my wife said I should bring my tablet list but I've left it in the ute, so I'll just tell you.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:18",
