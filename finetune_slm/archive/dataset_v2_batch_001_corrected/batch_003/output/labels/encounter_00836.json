  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Right, I'll be quick, because I've got two more in the car. It's Sorcha, she's seven, she's got nits again, and she's been scratching for a fortnight.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Hello Sorcha. Where does it itch?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My head. At the back.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Behind her ears and the back of her neck, and she scratches in her sleep.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What did you use?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:00",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "The lotion, malathion, I think, I left it on for twelve hours, once. Then a different one, maybe permethrin, I can't remember, and the conditioner and the comb every day. Well, most days.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:19",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. So the lotion, you're not sure which one was the second, and the comb most days but not every day. When did you do the first treatment?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:36",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does Sorcha have any other conditions?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:05",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She has asthma, mild. And eczema on her scalp, sometimes, I forgot to say.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does she go to school, or after-school clubs?",
      "start_timestamp": "02:16",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Yes, school, and Irish dancing three days a week, where they share the hair bands.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:29",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are live lice moving at the back of the scalp, and many eggs stuck to the hair near the roots, with red scratch marks at the nape. No sign of infection.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:20",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's reset. I'd like you to use dimeticone lotion, coat the whole scalp, leave it on overnight, and wash it out in the morning, and repeat it seven days later.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:06",
      "supports": [
        "medications[3]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Also wet-combing with a fine comb and conditioner every three days for two weeks, and check the whole family, and treat only those with live lice.",
      "start_timestamp": "04:22",
      "end_timestamp": "04:35",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please wash her pillowcase and hats in hot water, and don't share hair bands.",
      "start_timestamp": "04:43",
      "end_timestamp": "04:50",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see her again in two weeks, to be sure they've gone.",
      "start_timestamp": "04:58",
      "end_timestamp": "05:05",
