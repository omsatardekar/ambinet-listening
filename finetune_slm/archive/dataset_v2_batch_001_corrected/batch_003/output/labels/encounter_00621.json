  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, I snore, apparently. Quite loudly. But the thing that actually worries me is that I fall asleep in meetings.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:32",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often is that happening, the falling asleep?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Two or three times a week now. Last Thursday I nodded off while presenting the quarterly numbers. It was mortifying.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds exhausting. And the snoring, does anyone say anything else about your nights?",
      "start_timestamp": "00:52",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My wife says I stop breathing for a few seconds and then gasp. She finds it frightening. I've been snoring for years, but it's worse the last six months.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else you've noticed, mornings in particular?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I wake up with a dull headache most days. Morning headaches, right across the front, gone by lunchtime.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:40",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, or pain in your chest when you walk up stairs?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:49",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain, no.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:54",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And any swelling in your legs by evening?",
      "start_timestamp": "01:56",
      "end_timestamp": "02:00",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No swelling of the legs. My ankles are fine.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Now, what medicines do you take?",
      "start_timestamp": "02:07",
      "end_timestamp": "02:11",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Lisinopril, 10 mg once a day, every morning without fail. Metformin 500 mg twice a day, although if I'm honest I skip the evening one when dinner runs late.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:28",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, so the metformin is prescribed twice a day but some evenings it doesn't get taken. That's useful to know, thank you. Any allergies to medicines?",
      "start_timestamp": "02:30",
      "end_timestamp": "02:43",
      "supports": [
        "medications[1]",
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sulfa drugs. I came out in hives once when I was given an antibiotic.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:53",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. And your wider history, the diabetes, the blood pressure, anything else?",
