      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Type 2 diabetes for about eight years, high blood pressure, and high cholesterol. They're managed, I believe.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:14",
      "supports": [
