  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. I'm a teacher, and my voice is going by Wednesday every week.",
      "start_timestamp": "00:20",
      "end_timestamp": "00:28",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has it been like this?",
      "start_timestamp": "00:31",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Four months. It's rough and croaky, and then it gives out in the afternoons.",
      "start_timestamp": "00:36",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it worse at certain times?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "By the end of the school day. By Friday, it's nearly a whisper.",
      "start_timestamp": "00:51",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:01",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Never. I've never smoked.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:06",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me about your work.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I teach Year 3, twenty-eight children, in a noisy classroom. I talk all day, and I'm always raising my voice over them.",
      "start_timestamp": "01:13",
      "end_timestamp": "01:23",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That fits. What about your health generally?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:31",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have cerebral palsy, which affects my legs, so I use the wheelchair. It's never affected my voice before.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any reflux, acid coming up?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:55",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, a bit, and I take omeprazole, 20 mg once a day, for it.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:05",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There are small swellings on both vocal cords, in the middle where they meet.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:52",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "With the history of heavy voice use, I think these are vocal cord nodules.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:07",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll refer you to the speech and language therapist, who'll teach you ways to use your voice without strain.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:42",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Drink plenty of water, rest your voice at breaks, and use a microphone in class, if your school can provide one.",
      "start_timestamp": "05:02",
      "end_timestamp": "05:14",
      "supports": [
        "clinical_actions[1]"
      ]
