      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "I think it was around the festival, but I can't be sure. It might have been earlier.",
      "start_timestamp": "00:47",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it worse at any time of day?",
