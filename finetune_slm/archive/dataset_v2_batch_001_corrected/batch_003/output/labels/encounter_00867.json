      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, she sleeps with two pillows as she always has.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:51",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There is pitting swelling of both lower legs up to the knees, and no redness.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:34",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a fluid build-up. With her heart condition and sitting all day, that's the usual cause.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:50",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I would like to increase the furosemide to 40 milligrams twice a day, morning and early afternoon, and I'll prescribe that.",
