      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And which water tablet is that, and what dose?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:14",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Furosemide, 40 milligrams, once in the morning.",
