      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She has had heart failure for years, and high blood pressure.",
      "start_timestamp": "01:34",
      "end_timestamp": "01:41",
      "supports": [
        "medical_history.past_medical_history[0]",
