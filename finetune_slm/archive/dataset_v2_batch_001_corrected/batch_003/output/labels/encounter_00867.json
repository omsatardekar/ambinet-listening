  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, it's my mother's legs. They've swollen up again, and she sits in the wheelchair all day now.",
