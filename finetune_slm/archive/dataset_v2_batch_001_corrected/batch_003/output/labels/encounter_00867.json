    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, I'm glad you came together. Mrs Pillai, can you tell me about the swelling?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Both my legs are swollen, from the feet to the knees.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did you first notice it?",
      "start_timestamp": "00:35",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't remember. My daughter noticed it first.",
