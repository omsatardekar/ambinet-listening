        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please keep her legs raised when she is resting, and encourage her to take the tablets.",
      "start_timestamp": "04:16",
      "end_timestamp": "04:25",
