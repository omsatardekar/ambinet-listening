  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning. I'll not keep you long. I've still got this chest, and I thought it would have gone by now.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had it nearly two weeks. I had a course from the walk-in centre, finished it on Sunday, and I'm no better, really.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you noticing? Cough, or breathlessness, or both?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A cough, mainly. Wet, and I'm bringing up green phlegm in the mornings. Most of the day, really.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much, would you say, a spoonful, more?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A couple of spoonfuls in the morning, less in the day.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your breathing?",
      "start_timestamp": "01:13",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Breathless on the stairs. I stop halfway up at work, and I never used to.",
      "start_timestamp": "01:18",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you smoke?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:46",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About ten a day. I know, I know.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:53",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can hear some crackles at the bottom of the right lung, and a bit of wheeze on the left.",
      "start_timestamp": "02:55",
      "end_timestamp": "03:07",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it's not better in a week, I'd want a chest X-ray to see what's going on in the lung.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:08",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep drinking lots of fluids, and try not to suppress the cough at night, you want to clear it.",
      "start_timestamp": "04:14",
      "end_timestamp": "04:24",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And come in sooner if you cough up blood, get a high temperature, or get much more breathless.",
      "start_timestamp": "04:47",
      "end_timestamp": "04:56",
      "supports": [
        "clinical_actions[3]"
      ]
    }
