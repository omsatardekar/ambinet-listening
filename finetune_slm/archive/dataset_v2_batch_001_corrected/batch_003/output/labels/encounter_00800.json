      "start_timestamp": "01:46",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any confusion, or have you passed out?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:54",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
