      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any operations?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:01",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Appendix, in 1999.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:06",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Who do you live with, who'd notice if you got worse?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:15",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My brother.",
      "start_timestamp": "02:18",
      "end_timestamp": "02:19",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your throat's red, your chest is clear, and your skin is warm and dry, but you're a little dehydrated.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:57",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]",
        "physical_examination[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Mr Gallagher, with Addison's, a cold can tip you into a crisis if your steroid dose isn't increased. So I'd say this is early adrenal insufficiency brought on by the infection, but I can't rule out a crisis.",
      "start_timestamp": "03:04",
      "end_timestamp": "03:22",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A dangerous drop in your steroid level. We'll prevent it. I'd like you to take hydrocortisone 20 mg now, and then 20 mg twice a day for three days.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:44",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like you to take paracetamol, 1 gram, for the fever and aches, up to four times a day.",
      "start_timestamp": "03:53",
      "end_timestamp": "04:03",
      "supports": [
        "medications[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to take blood tests for salts, sugar and infection, and I'd like him to wait here for an hour, until the BP improves.",
      "start_timestamp": "04:08",
      "end_timestamp": "04:22",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Drink plenty of fluids, salty ones if you can.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:35",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If you vomit, can't keep your tablets down, or get very drowsy, you need an injection, and the ambulance, straight away. Tell your brother.",
      "start_timestamp": "04:41",
      "end_timestamp": "04:55",
      "supports": [
        "clinical_actions[4]"
      ]
