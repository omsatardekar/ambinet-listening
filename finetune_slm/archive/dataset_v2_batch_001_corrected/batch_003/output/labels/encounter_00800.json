    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mr Gallagher, I'm Dr Moran. Una says you're unwell with a cold and you take adrenal tablets. Tell me.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:52",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've got Addison's. Hydrocortisone. I've a cold since Monday. Aching, sore throat, snotty. And I feel weak.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Weak how?",
      "start_timestamp": "01:03",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Legs heavy. Dizzy when I stand.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any vomiting or diarrhoea?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:16",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Not yet.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's the reason you're feeling so rough, probably. Any abdominal pain?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:44",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
