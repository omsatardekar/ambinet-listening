  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning! I'll tell you what, I woke up three mornings in a row with a face like a balloon. Puffy eyes, puffy cheeks. By lunchtime it's gone down. My wife said I should come.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:21",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for coming. When did you first notice it?",
      "start_timestamp": "00:24",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Last Monday. So, five days. It's worse in the morning, and it settles by the afternoon.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other swelling, like your ankles or your tummy?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My ankles are a bit puffy at night, now you mention it.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's a bit frothy, the last week or so. I thought it was the new loo cleaner.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What tablets are you on?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:27",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Amlodipine, 5 mg once a day, for my blood pressure.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:35",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 74, blood pressure 148 over 92, temperature 36.7, oxygen 98 percent, weight 88 kilos.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:13",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You have a puffy, slightly swollen look around both eyes, and there's pitting swelling above both ankles.",
      "start_timestamp": "02:51",
      "end_timestamp": "03:00",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's one of the possibilities, and not the only one. I'd like to arrange a urine test today, to measure protein.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:44",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd also like to take blood tests, for kidney function.",
      "start_timestamp": "03:50",
      "end_timestamp": "03:55",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Meanwhile, cut the salt, put your feet up in the evening, and don't take any anti-inflammatory painkillers like ibuprofen.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:12",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three days, with the results.",
