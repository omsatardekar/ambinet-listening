  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello, doctor. I'm back about my ear. It's still leaking, and I'm worried, because of my diabetes.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Which ear, and what's been coming out?",
      "start_timestamp": "00:15",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The left. A yellowish discharge. It's been going on for two weeks, and the drops I was given didn't clear it.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it painful?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A dull ache. Not like before. And I can't hear well on that side.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or dizziness?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:57",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. No dizziness.",
      "start_timestamp": "01:01",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling or pain behind the ear?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:11",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing behind it.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Remind me what you've been using.",
      "start_timestamp": "01:21",
      "end_timestamp": "01:24",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The antibiotic drops, ciprofloxacin, three drops, twice a day, for ten days. And my diabetes tablet, metformin, 500 mg, twice a day.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:40",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other conditions?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Type 2 diabetes, five years, and high blood pressure.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:13",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The ear canal is swollen and has yellowish debris and discharge in it, and the eardrum is hard to see, but I can see a small hole in it.",
      "start_timestamp": "02:47",
      "end_timestamp": "03:01",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's very treatable. I'd like to arrange a swab from the ear, to see which germ is growing, and a hearing test.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:40",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Diabetes can make ear infections harder to clear, so I'd like you to check your sugars twice a day.",
      "start_timestamp": "03:49",
      "end_timestamp": "04:00",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the ear dry, use a cotton wool ball with petroleum jelly in the ear when you shower, and don't swim.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:22",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in a week, with the swab result.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:40",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
