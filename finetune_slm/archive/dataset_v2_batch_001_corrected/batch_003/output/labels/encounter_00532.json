    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's the hands again, doctor. The tingling, it's the left, no, sorry, it's the right one that's worse, but the left has joined in as well.",
