      "end_timestamp": "03:39",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I taught infants for thirty-five years. Retired.",
      "start_timestamp": "03:40",
      "end_timestamp": "03:44",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
