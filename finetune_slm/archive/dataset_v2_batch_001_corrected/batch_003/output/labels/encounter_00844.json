      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "In our own house for fifty years, until my husband passed and the stairs became too much. I moved into assisted living, you see.",
