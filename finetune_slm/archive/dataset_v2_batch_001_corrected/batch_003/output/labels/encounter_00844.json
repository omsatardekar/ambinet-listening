      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Where were you living before?",
      "start_timestamp": "03:16",
      "end_timestamp": "03:18",
      "supports": [
