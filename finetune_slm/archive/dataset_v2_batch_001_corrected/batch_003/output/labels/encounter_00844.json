  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Welcome. Mrs Whitcombe, Fiona tells me you're feeling low since the move. Is that right?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:48",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I suppose I am. I don't like to complain. I've felt rather low since I moved into the home, about six weeks ago.",
      "start_timestamp": "00:50",
      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How has it affected you?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've lost interest in my knitting, which I've done all my life. I sit and look at the wool.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "She's also awake at four every morning, Mum, you told me.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, I wake at four and can't get back to sleep. I lie there listening to the corridor.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any thoughts of ending your life?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:47",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Goodness, no. Never.",
      "start_timestamp": "01:49",
      "end_timestamp": "01:51",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any falls since the move?",
      "start_timestamp": "01:53",
      "end_timestamp": "01:56",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No falls. The staff are very careful.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:02",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any new aches or pains?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:07",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
