      "speaker_role": "patient",
      "transcript_text": "Nothing new.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:10",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fiona, can you tell me her tablets?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:17",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Amlodipine, 5 mg, once a day. Simvastatin, 20 mg, at night. Levothyroxine, 50 micrograms, in the morning. And paracetamol, 500 mg, when she needs it.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:31",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Any allergies?",
