  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "Sorry I'm late, the car park is a nightmare. Has Mum said anything yet? She's been so tired since she came out of hospital in the spring.",
      "start_timestamp": "00:46",
      "end_timestamp": "00:59",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I wouldn't say tired, exactly. Just a bit, you know...",
      "start_timestamp": "01:00",
      "end_timestamp": "01:05",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A bit what, Mrs Adeyemi? Take your time.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:13",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Slow. I'm not tired. Slow, that's all.",
      "start_timestamp": "01:15",
      "end_timestamp": "01:20",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "She's asleep in the armchair by three o'clock, every single afternoon. Joy finds her there.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough. Do you live on your own, or with family?",
      "start_timestamp": "02:41",
      "end_timestamp": "02:47",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "On my own. In my flat. The ground floor one, I've been there forty years.",
      "start_timestamp": "02:48",
      "end_timestamp": "02:57",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Chin up a little for me. Mm. The scar has healed very neatly, it's flat and quite pale now.",
      "start_timestamp": "03:25",
      "end_timestamp": "03:34",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Of course. I'll tell you what I think. It looks most likely that she's still catching up after the hospital stay. Picture a phone battery that's had a rough month: it takes a while before it holds its charge like before.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:20",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What helps meanwhile is a short walk in the morning light, a proper lunch, and if she does need the afternoon rest, half an hour on her bed rather than the armchair, so it doesn't swallow the whole afternoon.",
      "start_timestamp": "04:49",
      "end_timestamp": "05:10",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I can walk her round the block before lunch, weather permitting. She likes the little park.",
      "start_timestamp": "05:11",
      "end_timestamp": "05:21",
      "supports": [
        "clinical_actions[0]"
      ]
