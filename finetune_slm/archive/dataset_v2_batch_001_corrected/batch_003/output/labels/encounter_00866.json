    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Egypt. A week in Hurghada. I was fine there, mostly, then it started on the flight home.",
      "start_timestamp": "00:23",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often are you going?",
