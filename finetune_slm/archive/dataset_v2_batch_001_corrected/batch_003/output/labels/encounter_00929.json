  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had COVID back in the spring, and I'm still breathless. I thought I'd be back to normal by now.",
      "start_timestamp": "00:03",
      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sorry to hear that, and it's more common than people think. Tell me what the breathlessness is like.",
      "start_timestamp": "00:19",
      "end_timestamp": "00:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Walking up a hill, or the stairs at work. I have to stop halfway.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Before COVID, could you manage those without any trouble?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Easily. I used to run five kilometres on a Saturday.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you coughing, or bringing anything up?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A dry cough, now and again. Nothing much.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain, wheeze, or swelling in your legs?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:22",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. No wheeze. My legs are fine.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or night sweats?",
      "start_timestamp": "01:35",
      "end_timestamp": "01:39",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:46",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you taking any medicines?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:53",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A blue inhaler, salbutamol, two puffs, when I need it, and vitamin D, 1000 units a day.",
      "start_timestamp": "01:57",
      "end_timestamp": "02:04",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any past medical history?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, controlled with diet, and an appendix removal when I was twenty.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:36",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing obvious on listening. I'd like to arrange a chest X-ray, and a breathing test called spirometry, to check how your lungs are working.",
      "start_timestamp": "03:50",
      "end_timestamp": "04:02",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Most people do, but it can take months. Pace yourself, and build up gentle walking a little each week.",
      "start_timestamp": "04:29",
      "end_timestamp": "04:41",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in three weeks, with the results in hand.",
      "start_timestamp": "04:50",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
