  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi, sorry, I probably shouldn't have come in, it's nothing, my heart just did a thing at work.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Come on in, take a seat. What did your heart do?",
      "start_timestamp": "00:23",
      "end_timestamp": "00:30",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It started racing, thumping really, and I felt kind of light-headed. I thought I was about to go down.",
      "start_timestamp": "00:32",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how long did that last?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Maybe ten minutes? Honestly I wasn't looking at a clock, I was gripping the printer.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Has it ever happened before?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hmm. I think so, a while back, but I can't tell you when. Might've been last spring, might've been the winter before.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good to know, thank you. Is it still going on now?",
      "start_timestamp": "01:31",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, it settled while I was waiting. I just feel a bit wrung out, you know?",
      "start_timestamp": "01:38",
      "end_timestamp": "01:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Honestly, today is mostly advice. Cut the coffee down to one or two a day, and drink water at your desk, especially when you're busy.",
      "start_timestamp": "02:50",
      "end_timestamp": "03:03",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The leaflet will say it simply. If it comes back, sit down, breathe slowly, and time it.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:36",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it lasts more than twenty minutes, or you get chest pain, or you actually faint, call for an ambulance. Don't drive yourself.",
      "start_timestamp": "03:45",
      "end_timestamp": "03:59",
      "supports": [
        "clinical_actions[2]"
      ]
    }
