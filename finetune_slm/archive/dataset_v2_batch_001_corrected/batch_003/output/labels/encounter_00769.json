  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Morning! It's my hands again. The arthritis. It flared up, since the cold weather started, and I'm back to square one.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm sorry to hear that. Which joints, and how bad?",
      "start_timestamp": "00:13",
      "end_timestamp": "00:19",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The knuckles and the base of my thumbs, both hands. Stiff and sore, especially in the morning. I can't open jars.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does the morning stiffness last?",
      "start_timestamp": "00:36",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "An hour, an hour and a half. It was ten minutes in the summer.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling or redness, or fever?",
      "start_timestamp": "00:54",
      "end_timestamp": "00:58",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit of swelling in the knuckles. No redness. No fever.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:05",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain in other joints, like your knees, hips or spine?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:14",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my knees are okay. Just the hands.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any rash or dry eyes?",
      "start_timestamp": "01:23",
      "end_timestamp": "01:26",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No rash. My eyes are fine.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you taking, and how did the treatment go after our last visit?",
      "start_timestamp": "01:34",
      "end_timestamp": "01:41",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A gel for the thumbs, I can't remember the name, I got it from the pharmacy. And naproxen, maybe 250 mg, twice a day, on and off.",
      "start_timestamp": "01:45",
      "end_timestamp": "01:57",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the gel you can't name, and naproxen 250 mg twice a day as you recall it. Any other history?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:11",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Osteoarthritis diagnosed years ago, and I had a stomach ulcer once.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:21",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies?",
      "start_timestamp": "02:23",
      "end_timestamp": "02:26",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Years ago, a rash from penicillin, but I've avoided it ever since.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:36",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's bony swelling of the end joints and the base of both thumbs, and tenderness with a bit of warmth in two knuckles, no redness.",
      "start_timestamp": "03:11",
      "end_timestamp": "03:23",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's an osteoarthritis flare, as you say, but with the long morning stiffness and warm knuckles, I can't rule out an inflammatory arthritis, such as rheumatoid, on top of it.",
      "start_timestamp": "03:29",
      "end_timestamp": "03:45",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep using the gel, warm your hands in the morning, and wear thin gloves in cold weather.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:21",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Put a pair by the front door. And take the naproxen with food only.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:38",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the knuckle swelling gets worse, you get new swelling in other joints, or the stiffness lasts all morning, come back to see me and I'll arrange blood tests and a referral.",
