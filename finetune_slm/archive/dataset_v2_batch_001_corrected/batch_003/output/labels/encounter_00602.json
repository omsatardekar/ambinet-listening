  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Dani it is. I'm Dr. Reyes. This is your follow-up on your treatment. How are you feeling overall?",
      "start_timestamp": "00:22",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let's take it piece by piece. Is the cough still around?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Since... um. About three months, I guess? Maybe more.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Any night sweats lately?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Those are gone. They stopped, like, a month ago. I used to wake up soaked, and now... nothing.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'm still tired. Like, I get home and I just...",
      "start_timestamp": "01:42",
      "end_timestamp": "01:47",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "That'll improve. Now, any coughing up blood?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:05",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No. No blood.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:09",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Have you lost weight in the last month?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:15",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
