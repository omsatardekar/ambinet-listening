      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "No... not really. No.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:33",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yeah, the rifampin. 600 mg, once a day. In the morning, before I eat.",
      "start_timestamp": "02:41",
      "end_timestamp": "02:49",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Good. How about your stomach and your general digestion, since starting it? Any trouble?",
      "start_timestamp": "02:50",
      "end_timestamp": "02:58",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It's fine. Nothing there.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:03",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Great. I see TB listed in your history, with the treatment about four months in. Does that match your memory?",
      "start_timestamp": "03:04",
      "end_timestamp": "03:14",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yes. Four months. It feels longer.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:19",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I bet. Any past surgery I should know about?",
      "start_timestamp": "03:21",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "My gallbladder. Um, it was taken out in 2015.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:33",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "My uncle had TB. A long time ago, in the old country. I think. I don't really know the details.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:51",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I work in a bakery. Early shifts. And I... I live with two roommates.",
      "start_timestamp": "04:04",
      "end_timestamp": "04:13",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Chest sounds clear on both sides. And the glands in your neck aren't swollen.",
      "start_timestamp": "05:01",
      "end_timestamp": "05:08",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Yes, that's good. Sit up. Keep the rifampin going, same dose, every morning, don't skip.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:22",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Good. Keep the bakery mask on, and tell your roommates to cover their coughs, too.",
      "start_timestamp": "05:32",
      "end_timestamp": "05:40",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "I'll see you again in four weeks.",
