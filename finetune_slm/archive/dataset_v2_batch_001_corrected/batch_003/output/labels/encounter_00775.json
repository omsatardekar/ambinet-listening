        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good to see you. Let's start with the rash. When did it come back?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About two weeks ago. Across my cheeks and nose, a butterfly thing. It's worse in the sun.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's check what you're taking.",
      "start_timestamp": "00:58",
      "end_timestamp": "01:01",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hydroxychloroquine, 200 mg twice a day. Prednisolone, 5 mg, once a day. And a calcium and vitamin D tablet, once a day, for my bones.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:17",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, that matches. Any fever, or mouth ulcers, or chest pain when you breathe in?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:28",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, none.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:34",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what do you do for work, are you outdoors?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a postwoman, so yes, outdoors most days.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a pink, slightly raised rash across both cheeks and the bridge of your nose, and the skin elsewhere on the face is clear.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:34",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "With the sun-sensitive rash and a bit of morning hand stiffness, I'd say this is a mild flare of your lupus.",
      "start_timestamp": "02:44",
      "end_timestamp": "02:54",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A hat's good, but you need a high-factor sun cream, factor 50, on your face, every day, even when it's cloudy.",
      "start_timestamp": "03:21",
      "end_timestamp": "03:34",
      "supports": [
