  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hi! Right, lupus review. I think I'm doing okay, but you tell me. I've also got a rash on my cheeks that's come back.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:14",
      "supports": [
