      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You should have your yearly eye check, so I'll make sure that's booked.",
      "start_timestamp": "04:05",
      "end_timestamp": "04:13",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the rash spreads, you get a fever, mouth ulcers, swollen ankles, or your urine goes frothy or dark, ring me and come in.",
