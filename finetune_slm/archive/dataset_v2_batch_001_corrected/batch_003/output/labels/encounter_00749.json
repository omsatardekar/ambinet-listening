      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "No, he had his helmet on, thank God. He didn't hit his head, no.",
      "start_timestamp": "01:09",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What's his age, and does he have any medicines?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:26",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He's nine. I gave him a spoon of paracetamol, 250 mg, when we got home, in case.",
      "start_timestamp": "01:30",
      "end_timestamp": "01:39",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good thinking. Any broken bones in the family?",
      "start_timestamp": "01:42",
      "end_timestamp": "01:47",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "His grandfather broke his wrist, years ago, but that's all.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:56",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't rule out a fracture, which is common at this age, so I'd like an X-ray of the wrist and forearm now.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:10",
      "supports": [
