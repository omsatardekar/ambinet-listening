  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. Um, it's my hip, I think. Or my leg? It hurts when I get up from the chair. I forget which side, hang on, the right. The right hip.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:17",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. How long has the right hip been painful?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the summer. About four months. It's mostly after I've been sitting, and then it eases when I get moving.",
      "start_timestamp": "00:27",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Where exactly is it?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "In the groin, sort of, and down the front of my thigh. A dull ache, sometimes sharp when I stand.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:54",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any back pain, or pins and needles down the leg?",
      "start_timestamp": "01:10",
      "end_timestamp": "01:17",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my back's fine. No tingling.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What do you take for it?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:29",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Paracetamol, 1 gram, four times a day, when I remember. Naproxen, 250 mg, twice a day, and a stomach tablet, lansoprazole, 15 mg, once a day.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:46",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any other conditions?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Osteoarthritis, in my knees, high blood pressure, and an underactive thyroid.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:58",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does arthritis run in the family?",
      "start_timestamp": "01:59",
      "end_timestamp": "02:03",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had a hip replaced at seventy.",
      "start_timestamp": "02:04",
      "end_timestamp": "02:09",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And do you exercise?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:14",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I walk the dog twice a day, though it's slower lately.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:22",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 70, blood pressure 138 over 82, temperature 36.5, oxygen 98 percent, weight 79 kilos.",
      "start_timestamp": "02:47",
      "end_timestamp": "02:56",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The right hip is stiff and painful on turning it inwards, and a bit restricted compared with the left.",
      "start_timestamp": "03:26",
      "end_timestamp": "03:36",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "With the groin pain, the stiffness after sitting, and the limited inward rotation, this fits with osteoarthritis of the hip, I'd say.",
      "start_timestamp": "03:42",
      "end_timestamp": "03:53",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not necessarily, it depends how it progresses. First, I'd like an X-ray of your right hip, and of your pelvis, to see how much the joint has changed.",
      "start_timestamp": "04:01",
      "end_timestamp": "04:14",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like to arrange a physiotherapy assessment, because strengthening exercises help a lot.",
      "start_timestamp": "04:20",
      "end_timestamp": "04:28",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes, but I'd suggest the paracetamol regularly, with the naproxen only when it's bad, and with food.",
      "start_timestamp": "04:36",
      "end_timestamp": "04:45",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Put the paracetamol next to your toothbrush. And a walking stick in your left hand will take some load off the right hip.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:02",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It helps more than you'd expect. I'd like to see you in six weeks, with the X-ray results.",
      "start_timestamp": "05:08",
      "end_timestamp": "05:18",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
