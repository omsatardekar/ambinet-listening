  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Hello. Um, I've noticed a yellowish bump on my eye, by the coloured bit, and I don't like it.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:09",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me hear more about it. When did you spot it?",
      "start_timestamp": "00:12",
      "end_timestamp": "00:18",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About two months ago, in the mirror. It was tiny, and it's grown a little.",
      "start_timestamp": "00:21",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it bother you in any way?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My eye feels gritty, like there's sand in it. Mostly when the wind's blowing.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any redness or watering?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It goes red now and then, and waters a bit, particularly outdoors.",
      "start_timestamp": "00:52",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[2]",
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any change in your sight, blurriness?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:04",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, my sight is fine. No blurring at all.",
      "start_timestamp": "01:07",
      "end_timestamp": "01:13",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Are you using anything on the eye?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:18",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Lubricating drops, four times a day, for dry eyes. They help a little.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:26",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And you've had dry eyes for a while?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:32",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Years. And hay fever too, in the summer.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:37",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What work do you do?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:42",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm a gardener. I'm outside all day, in the sun and wind.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:49",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 72, blood pressure 122 over 76.",
      "start_timestamp": "02:12",
      "end_timestamp": "02:16",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. There's a small, raised, yellowish lump on the white of the eye, on the nose side, next to the cornea, and the surface around it is slightly red.",
      "start_timestamp": "02:57",
      "end_timestamp": "03:12",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a benign thickening of the surface, and from the look of it I'd say it's a pinguecula.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:27",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at all. I'd like to do a vision test with the chart now, to have a baseline.",
      "start_timestamp": "04:09",
      "end_timestamp": "04:18",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, your vision is excellent. I'll also take a photograph of the eye, so we can compare it in future.",
      "start_timestamp": "04:39",
      "end_timestamp": "04:50",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wear wraparound sunglasses outdoors, keep using the drops, and avoid rubbing it.",
      "start_timestamp": "04:58",
      "end_timestamp": "05:04",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in six months to compare the photograph.",
      "start_timestamp": "05:13",
      "end_timestamp": "05:21",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
