      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The amlodipine and indapamide, yes. The ramipril, I take every day, except weekends, when I'm away and I forget.",
