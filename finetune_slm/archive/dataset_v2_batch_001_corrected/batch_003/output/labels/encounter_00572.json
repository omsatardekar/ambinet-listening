  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, it's the blood in my wee, doctor. First time, I thought it was beetroot, but I hadn't had any.",
