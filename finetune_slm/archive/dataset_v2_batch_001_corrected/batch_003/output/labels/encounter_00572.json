    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sort of reddy-pink, like weak squash. Comes and goes.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:34",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About three weeks now. Off and on. Some days it's clear, some days it isn't.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it hurt when you pass it?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:54",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no pain at all. That's what's odd. Doesn't hurt a bit.",
      "start_timestamp": "00:55",
      "end_timestamp": "01:02",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any pain in your back or sides? Or a temperature?",
      "start_timestamp": "01:04",
      "end_timestamp": "01:10",
      "supports": [
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Nothing in the back. And no temperature, I'd know, the wife checks me like a Sunday roast.",
      "start_timestamp": "01:11",
      "end_timestamp": "01:21",
      "supports": [
        "negative_findings[1]",
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm up in the night for a wee, three times, that's new. And I'm dog-tired by teatime.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:38",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else? Appetite, weight, swelling?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:42",
      "supports": [
        "symptoms[3]",
        "symptoms[4]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've gone off my grub a bit. And my ankles are like balloons by evening.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:51",
      "supports": [
        "symptoms[3]",
        "symptoms[4]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Mm-hm. Right. Do you have any long-term conditions?",
