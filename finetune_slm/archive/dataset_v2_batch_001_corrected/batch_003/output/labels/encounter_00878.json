  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not great, I'm afraid. The stiffness is worse in the mornings, it takes me an hour to get going, and my right hand shakes.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:42",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So the stiffness is worse first thing, and the right hand has a tremor. Which hand, again?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The right. Sorry, did I say left? The right.",
      "start_timestamp": "00:54",
      "end_timestamp": "00:59",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how's your walking?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Slow. I shuffle. My wife says I'm like a penguin.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had any falls?",
      "start_timestamp": "01:15",
      "end_timestamp": "01:18",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No falls, no. Wobbles, but I've caught myself.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:24",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any hallucinations, seeing things that aren't there?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:31",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:34",
      "end_timestamp": "01:37",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What are you on at the moment?",
      "start_timestamp": "01:39",
      "end_timestamp": "01:44",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Levodopa, 100 mg, four times a day. The last one's at six, and by seven in the morning I'm worn out.",
      "start_timestamp": "01:46",
      "end_timestamp": "01:56",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right. Any allergies?",
      "start_timestamp": "01:58",
      "end_timestamp": "02:00",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No allergies, none.",
      "start_timestamp": "02:03",
      "end_timestamp": "02:05",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your Parkinson's, remind me when you were diagnosed?",
      "start_timestamp": "02:07",
      "end_timestamp": "02:12",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three years ago. Though I think it started a year before.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And you worked as?",
      "start_timestamp": "02:21",
      "end_timestamp": "02:23",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I was a bus driver. Retired now.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check you. Pulse 72, blood pressure 138 over 80, temperature 36.5, oxygen 98 percent, breathing 14, weight 74 kilos.",
      "start_timestamp": "02:49",
      "end_timestamp": "03:00",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]",
        "vital_signs[5]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can see a tremor in the right hand at rest.",
      "start_timestamp": "03:25",
      "end_timestamp": "03:31",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And when I move your right arm, there's stiffness, a cogwheel catch, but the left is normal.",
      "start_timestamp": "03:39",
      "end_timestamp": "03:50",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's what we expect. I think the stiffness in the mornings is the levodopa wearing off between doses.",
      "start_timestamp": "03:57",
      "end_timestamp": "04:08",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to start rasagiline, 1 mg, once a day, to smooth things out.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:23",
      "supports": [
        "medications[1]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A little. I'd also like to arrange a physiotherapy assessment, and blood tests for your kidney and liver function.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:43",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the stiffness isn't better in a month, come back and we'll look at the timing again.",
      "start_timestamp": "04:49",
      "end_timestamp": "04:58",
      "supports": [
        "clinical_actions[2]",
