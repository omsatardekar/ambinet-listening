      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "This looks like a ganglion, a harmless sac of fluid that forms next to a tendon sheath.",
      "start_timestamp": "03:12",
