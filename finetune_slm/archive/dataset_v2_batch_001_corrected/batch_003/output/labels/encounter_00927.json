      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any tingling or numbness in the fingers?",
      "start_timestamp": "01:50",
      "end_timestamp": "01:54",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that.",
      "start_timestamp": "01:57",
