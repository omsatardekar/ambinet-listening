  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've got this lump on my wrist, and I'm worried because I looked it up and it said it could be anything.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's have a look and talk it through. Which wrist is it?",
      "start_timestamp": "00:19",
      "end_timestamp": "00:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The right one, on the back of the wrist. It's about the size of a grape.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:39",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did you first notice it?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three weeks ago, I think. It seems to have got a bit bigger.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does it hurt?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Only when I bend my wrist back a lot, like when I do press-ups.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Does the size change during the day or after using the wrist?",
      "start_timestamp": "01:17",
      "end_timestamp": "01:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's bigger after I've been typing. Smaller in the morning.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had a knock or an injury to it?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:42",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no injury.",
      "start_timestamp": "01:44",
