      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing like that. Sipping cold water slowly, or swallowing a teaspoon of sugar, are the two I'd start with. Some people find that holding their breath for ten seconds or so helps.",
