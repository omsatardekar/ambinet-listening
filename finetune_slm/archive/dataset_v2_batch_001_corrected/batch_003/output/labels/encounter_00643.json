  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right, I'm here for the hand. They said to come back, but I've got to be somewhere by two, so can we crack on?",
