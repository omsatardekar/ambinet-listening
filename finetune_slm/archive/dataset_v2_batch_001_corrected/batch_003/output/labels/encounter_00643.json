      "end_timestamp": "00:15",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Chopping onions. The knife slipped, cut across the palm, on the left. It bled like mad. I had it glued and strapped up yesterday at the walk-in.",
      "start_timestamp": "00:29",
      "end_timestamp": "00:42",
      "supports": [
