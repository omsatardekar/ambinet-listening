      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange a CT scan of your head, and the neurology team will see you before you leave.",
      "start_timestamp": "05:32",
      "end_timestamp": "05:43",
      "supports": [
