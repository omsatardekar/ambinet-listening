  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Doctor, this is Josh Whelan, twenty-six, brought in by ambulance after a first fit at home. He's been a bit muddled, but he's coming round.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:12",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah. Yeah, I can hear you. What happened? I've got a headache and I feel like I've been hit by a bus.",
      "start_timestamp": "00:22",
      "end_timestamp": "00:33",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Paramedics say his flatmate saw him shaking all over for about two minutes, went stiff first, and he wasn't responding.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, Jenny. Josh, you bit your tongue, I see. Does it hurt?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yeah, it's sore. Tastes like blood.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you banged your head, did you fall hard?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:33",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't think so. I don't remember, but nothing hurts on my head except the headache. No bump that I can feel.",
      "start_timestamp": "01:34",
      "end_timestamp": "01:45",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you been unwell lately, any fever, any infection?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:53",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. I've been fine. No, I've been fine all week.",
      "start_timestamp": "01:54",
      "end_timestamp": "02:01",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:06",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. None.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:09",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What do you take, if anything?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:16",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just my sertraline, 50 mg once a day. For anxiety.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And anxiety is the only condition you've been told about?",
      "start_timestamp": "02:28",
      "end_timestamp": "02:34",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Blood pressure 128 over 78, pulse 96, temperature 36.9, oxygen 98 percent, respiratory rate 16, and a sugar of 5.4.",
      "start_timestamp": "03:51",
