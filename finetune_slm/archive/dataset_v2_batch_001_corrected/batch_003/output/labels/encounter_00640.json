  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She isn't putting on weight, doctor. She's nine months and she's been flat for about two months, on the chart, I mean.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:43",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Flat, meaning her line's stopped climbing?",
      "start_timestamp": "00:44",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Yes, it's levelled off. And she's so hungry, she takes every bottle, but it doesn't seem to go on her.",
      "start_timestamp": "00:49",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any vomiting after feeds?",
      "start_timestamp": "01:21",
      "end_timestamp": "01:24",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, she doesn't vomit. Well, no, not now. She was sicky when she was tiny.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:35",
      "supports": [
        "negative_findings[0]",
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What do you mean by sicky when she was tiny?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She had reflux, they said. It settled a bit at about four months.",
      "start_timestamp": "01:44",
      "end_timestamp": "01:51",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay. Any loose stools, runny poos, or poos that smell very bad?",
      "start_timestamp": "01:52",
      "end_timestamp": "01:58",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "No, nothing runny. Normal nappies, I'd say, no problem.",
      "start_timestamp": "02:01",
      "end_timestamp": "02:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is she on any medicine, drops, anything?",
      "start_timestamp": "02:07",
      "end_timestamp": "02:11",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Vitamin D drops, 400 units, once a day. That's all.",
      "start_timestamp": "02:14",
      "end_timestamp": "02:19",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. What do you know of her birth?",
      "start_timestamp": "02:21",
      "end_timestamp": "02:25",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "She was born at 34 weeks. A few weeks in the special care unit. And her tongue-tie was snipped at two weeks old, before we got her.",
      "start_timestamp": "02:26",
      "end_timestamp": "02:41",
      "supports": [
        "medical_history.past_medical_history[1]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand. I can't rule out milk protein intolerance, because it can cause poor weight gain even without vomiting.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:03",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to arrange some blood tests, to look for anaemia and check her nutrition and her gut.",
      "start_timestamp": "04:30",
      "end_timestamp": "04:41",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And in the meantime, offer her solids before the bottle, so she's hungry for them, and write down everything she eats for a week.",
      "start_timestamp": "05:07",
      "end_timestamp": "05:21",
      "supports": [
        "clinical_actions[1]"
      ]
