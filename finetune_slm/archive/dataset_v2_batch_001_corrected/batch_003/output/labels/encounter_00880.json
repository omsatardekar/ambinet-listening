  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, doctor, you know how it is, I came in last month about my back and now there's a new thing, a numb patch on my thigh.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:16",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Right, let's look at the new thing first. Which thigh, and where exactly?",
      "start_timestamp": "00:18",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "The left one, on the outside. About the size of my palm. It feels like it's been to the dentist.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did you first notice it?",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, a few weeks ago? Maybe longer, my daughter thinks it was when we went on holiday. I honestly couldn't say.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it getting bigger, or staying the same?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Staying the same, I think.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any weakness in the leg, or pain going down from your back?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:15",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No weakness. No pain in the leg at all.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any problems passing water or opening your bowels?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:29",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing at all in that department.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:35",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. What medicines are you taking now?",
      "start_timestamp": "01:53",
      "end_timestamp": "01:58",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Naproxen, 500 mg, twice a day, with food. And a tablet for the nerves, amitriptyline, 10 mg, at night. Or was it 25? My wife has the box.",
      "start_timestamp": "01:59",
      "end_timestamp": "02:13",
      "supports": [
        "medications[0]",
        "medications[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "We'll check the dose on the box next time. Any other medical conditions?",
      "start_timestamp": "02:15",
      "end_timestamp": "02:22",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Diabetes, for six years. High blood pressure. And I had a slipped disc some years ago.",
      "start_timestamp": "02:25",
      "end_timestamp": "02:34",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Do you smoke?",
      "start_timestamp": "02:36",
      "end_timestamp": "02:39",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Used to. I gave up fifteen years ago.",
      "start_timestamp": "02:41",
      "end_timestamp": "02:45",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 76, blood pressure 138 over 84.",
      "start_timestamp": "03:09",
      "end_timestamp": "03:13",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There is reduced sensation to light touch and pinprick over the outer left thigh, and the rest of the leg is normal.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:07",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's a pattern we see when a small skin nerve is squeezed, often called meralgia paraesthetica. Diabetes can make it more likely.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:26",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It isn't dangerous, and it often settles. I'd like to check your blood sugar and your B12 with a blood test.",
      "start_timestamp": "04:32",
      "end_timestamp": "04:44",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Avoid tight belts and trousers, and I'll ask the physio to look at it too.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:00",
      "supports": [
        "clinical_actions[1]"
