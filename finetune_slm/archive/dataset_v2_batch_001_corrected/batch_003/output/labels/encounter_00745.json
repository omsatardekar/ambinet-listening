      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Walking in the Scottish Highlands, I do a lot of hill walking.",
      "start_timestamp": "01:52",
      "end_timestamp": "01:59",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Temperature 36.8, pulse 70, blood pressure 122 over 76, oxygen 99 percent, respiratory rate 14.",
      "start_timestamp": "02:24",
      "end_timestamp": "02:33",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's an expanding red ring on the left thigh about fifteen centimetres across, with central clearing, and a tiny scab at the centre where the tick was.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:19",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You've done your homework. The look of it, plus the tick bite, makes Lyme disease very likely, though I can't rule out cellulitis, which can look similar.",
      "start_timestamp": "03:28",
      "end_timestamp": "03:41",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not to start treatment, because the rash itself is enough. But I'd like to arrange blood tests, to check your baseline, and Lyme serology, though it can be negative this early.",
      "start_timestamp": "03:48",
      "end_timestamp": "04:04",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'm going to prescribe doxycycline, 100 mg twice a day, for three weeks.",
      "start_timestamp": "04:12",
      "end_timestamp": "04:19",
      "supports": [
        "medications[1]",
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's the current recommendation. Take it with food and a full glass of water, and stay out of strong sun.",
      "start_timestamp": "04:27",
      "end_timestamp": "04:39",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the rash is still spreading after a few days of treatment, or you develop a fever, a stiff neck, a droopy face, or joint swelling, come back or go to hospital.",
