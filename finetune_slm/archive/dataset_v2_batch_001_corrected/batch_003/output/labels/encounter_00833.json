  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Doctor, I'm Hannah, Greg's wife. He won't say it, so I will: I'm worried about how much he's drinking.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Greg, I'd like to hear from you first. How much do you drink in a typical day?",
      "start_timestamp": "00:21",
      "end_timestamp": "00:31",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bottle of wine, give or take. Maybe a bit more at weekends.",
      "start_timestamp": "00:33",
      "end_timestamp": "00:40",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's more than that. There's a bottle every night, and he's started before lunch on his days off.",
      "start_timestamp": "00:42",
      "end_timestamp": "00:53",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you both. When did the drinking go up, would you say?",
      "start_timestamp": "00:54",
      "end_timestamp": "01:01",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I don't know. Gradually. Since I changed jobs, I think. Or maybe before.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:11",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "It's the last year, I think, but I honestly couldn't say when it tipped over.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:22",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How are your mornings?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Shaky. My hands tremble. I settle down after a coffee.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "And he's sweaty and irritable until he has a drink at lunchtime.",
      "start_timestamp": "01:37",
      "end_timestamp": "01:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How's your sleep?",
      "start_timestamp": "01:47",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Poor. I fall asleep fine, and wake at three, and lie there.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:58",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how's your mood?",
      "start_timestamp": "02:00",
      "end_timestamp": "02:02",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit flat. And anxious, that's the word.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:09",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any thoughts of harming yourself?",
      "start_timestamp": "02:11",
      "end_timestamp": "02:14",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. No, not at all.",
      "start_timestamp": "02:17",
      "end_timestamp": "02:20",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any tablets at the moment?",
      "start_timestamp": "02:21",
      "end_timestamp": "02:25",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just a vitamin B tablet, thiamine, 100 mg, once a day, that Hannah makes me take.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:37",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any allergies to medicines or anything else?",
      "start_timestamp": "02:39",
      "end_timestamp": "02:44",
      "supports": [
        "negative_findings[1]",
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. I'm not allergic to anything.",
      "start_timestamp": "02:45",
      "end_timestamp": "02:48",
      "supports": [
        "negative_findings[1]",
        "allergies[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He reacted to codeine once, Greg, you came out in hives, and your face swelled. It was years ago, before we married.",
      "start_timestamp": "02:50",
      "end_timestamp": "03:01",
      "supports": [
        "negative_findings[1]",
        "allergies[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that you say no allergies and Hannah recalls a reaction to codeine, and I'll record both. Any health conditions?",
      "start_timestamp": "03:02",
      "end_timestamp": "03:15",
      "supports": [
        "negative_findings[1]",
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "allergies[0]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High blood pressure, an ulcer a few years ago, and I had some depression, a while back.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:27",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_024",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 92, blood pressure 150 over 94, temperature 36.8, oxygen 98 percent, weight 94 kilos.",
      "start_timestamp": "03:54",
      "end_timestamp": "04:02",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_025",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The pressure and pulse are up, which fits with the alcohol and the morning shakes. Any breathlessness, chest pain?",
      "start_timestamp": "04:10",
      "end_timestamp": "04:19",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_026",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Nothing.",
      "start_timestamp": "04:21",
      "end_timestamp": "04:23",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Greg, from what you and Hannah describe, drinking a bottle of wine or more daily, shakes in the morning and drinking to settle them, this looks like harmful alcohol use with early dependence.",
      "start_timestamp": "04:26",
      "end_timestamp": "04:42",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_028",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Please don't stop suddenly, because with this level of drinking, withdrawal can be dangerous. We'll plan it safely.",
      "start_timestamp": "05:05",
      "end_timestamp": "05:14",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_029",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to refer you to the community alcohol service, and I'd like to arrange blood tests, for your liver and blood count, today.",
      "start_timestamp": "05:22",
      "end_timestamp": "05:35",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_030",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep taking the thiamine, eat regular meals, and don't drive after drinking.",
      "start_timestamp": "05:41",
      "end_timestamp": "05:47",
      "supports": [
        "clinical_actions[4]"
      ]
    },
    {
      "evidence_id": "EV_031",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you again in a week. If you get severe shakes, confusion, hallucinations, or a fit, go to the emergency department.",
