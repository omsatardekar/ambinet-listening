        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Lisinopril, 10 mg. Once a day, in the morning. For blood pressure.",
      "start_timestamp": "03:23",
      "end_timestamp": "03:30",
      "supports": [
        "medical_history.past_medical_history[2]",
        "medications[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, and the baby aspirin. 81 mg. My cardiologist, um, a few years ago... Anyway, I take it every morning too.",
      "start_timestamp": "03:40",
      "end_timestamp": "03:51",
      "supports": [
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My father had diabetes too. He had it for a long time.",
      "start_timestamp": "04:35",
      "end_timestamp": "04:41",
      "supports": [
        "medical_history.family_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your abdomen is soft, and I can't feel anything unusual under the ribs on the right.",
      "start_timestamp": "05:05",
      "end_timestamp": "05:14",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not at all. Let me also read your numbers. Blood pressure is 134 over 82, and weight is 94 kilograms.",
      "start_timestamp": "05:24",
      "end_timestamp": "05:37",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Those four medicines are all well-established, and none is a common cause of fatty liver. I'd like to order liver blood tests to see how your liver is working.",
      "start_timestamp": "06:07",
      "end_timestamp": "06:21",
      "supports": [
        "procedures_and_investigations[1]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not really. Gradual weight loss, regular movement, and cutting back on sugary drinks help the most. Even a small loss makes a difference.",
      "start_timestamp": "06:46",
      "end_timestamp": "06:59",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Start small. Swap one sugary drink a day for water, and add a ten-minute walk after dinner.",
      "start_timestamp": "07:13",
      "end_timestamp": "07:22",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Exactly. I'd like to see you again in three months, so we can look at the blood results and how things are going.",
      "start_timestamp": "07:30",
      "end_timestamp": "07:42",
