      "end_timestamp": "02:38",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Atorvastatin. 20 mg, at bedtime. It's for, uh, cholesterol. I've had high cholesterol for a long time.",
      "start_timestamp": "02:44",
      "end_timestamp": "02:53",
      "supports": [
