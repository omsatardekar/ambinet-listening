  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Doctor, I'm worried about my heart rhythm, and I'm on warfarin for it. I want to make sure I'm doing everything right.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a good reason to come. Tell me how you've been feeling.",
      "start_timestamp": "00:17",
      "end_timestamp": "00:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Every now and then my heart flutters, like a bird in my chest. It lasts a few minutes.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How often does that happen?",
      "start_timestamp": "00:40",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Maybe once or twice a week.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any dizziness, chest pain, or fainting with it?",
      "start_timestamp": "00:55",
      "end_timestamp": "01:00",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chest pain. No fainting. I do feel a bit breathless sometimes.",
      "start_timestamp": "01:04",
      "end_timestamp": "01:11",
      "supports": [
        "symptoms[1]",
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How is the breathlessness? When does it happen?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "When I climb the stairs, mostly. It settles after a rest.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Warfarin 3 mg, once a day in the evening.",
      "start_timestamp": "01:43",
      "end_timestamp": "01:48",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any missed doses, or bleeding, like nosebleeds or bruising?",
      "start_timestamp": "01:53",
      "end_timestamp": "01:58",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No bleeding. I've not missed a dose.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any allergies to medicines?",
      "start_timestamp": "02:29",
      "end_timestamp": "02:33",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I'm allergic to sulfa drugs. I got a rash with them years ago.",
      "start_timestamp": "02:37",
      "end_timestamp": "02:44",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Noted. Do you drink alcohol?",
      "start_timestamp": "02:47",
      "end_timestamp": "02:50",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "One or two glasses of wine a week.",
      "start_timestamp": "02:54",
      "end_timestamp": "02:58",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Now, with your fluttering and breathlessness, I'd like to record your heart over a few days.",
      "start_timestamp": "03:01",
      "end_timestamp": "03:10",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "You wear a small monitor, a Holter, for forty-eight hours, and it records every heartbeat.",
      "start_timestamp": "03:22",
      "end_timestamp": "03:29",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not with the monitor on, but you can wash around it. I'll arrange it for next week.",
      "start_timestamp": "03:41",
      "end_timestamp": "03:51",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to repeat the INR in two weeks, because small changes in diet can move it.",
      "start_timestamp": "04:03",
