  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "So, it is about my periods, doctor. I'm having bleeding between my periods, since last two months. It was never like this before.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:41",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mostly it is only spotting, light pink or brown, on the underwear. But last week it was little more, I had to use a pad for two days. I was so worried, I told my husband, he said just go and see the doctor.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About ten days after my period finishes. Then again some days later, on and off. My cycle is usually regular, you know, twenty-eight days like a clock. My sister always says I'm the only person who is regular in our family.",
      "start_timestamp": "01:26",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, some pain in my lower tummy, like a dull ache, mild only. It comes with the bleeding, mostly. I thought maybe it is gas, because last Sunday we had my aunt's biryani and I ate too much.",
      "start_timestamp": "01:50",
      "end_timestamp": "02:07",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "All across, I think. Not one side. It is not so bad, I can still do my work.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:30",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Now I need to ask a few things you might find personal, so please say if you'd like a break. Have you had any bleeding after intercourse?",
      "start_timestamp": "02:32",
      "end_timestamp": "02:45",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, no, nothing like that. That is fine.",
      "start_timestamp": "02:46",
      "end_timestamp": "02:51",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or chills, along with these symptoms?",
      "start_timestamp": "02:52",
      "end_timestamp": "02:57",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No fever. I checked also with the thermometer, because my mother-in-law was after me about it.",
      "start_timestamp": "02:58",
      "end_timestamp": "03:06",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And is there any chance that you might be pregnant at the moment?",
      "start_timestamp": "03:08",
      "end_timestamp": "03:14",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No chance, doctor. We are being careful, and my last period was normal, on time.",
      "start_timestamp": "03:15",
      "end_timestamp": "03:23",
      "supports": [
        "negative_findings[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Only the PCOS. Polycystic ovary syndrome, they said, long back. But my periods have been regular, so I stopped worrying about it. That is why this is so strange for me.",
      "start_timestamp": "03:34",
      "end_timestamp": "03:49",
      "supports": [
        "medical_history.past_medical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I had a C-section, four years ago. For my daughter. She is four now, and she is the naughtiest, doctor, you won't believe it. Yesterday she painted the dog with my lipstick.",
      "start_timestamp": "04:02",
      "end_timestamp": "04:19",
      "supports": [
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That sounds like a handful. Is life busy in other ways? What do you do for work?",
      "start_timestamp": "04:21",
      "end_timestamp": "04:30",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I work in IT, in a software company. Lots of sitting, lots of deadlines. Last month we had a release, so I was in office until very late almost every day.",
      "start_timestamp": "04:31",
      "end_timestamp": "04:48",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That would take it out of anyone. And who do you live with?",
      "start_timestamp": "04:49",
      "end_timestamp": "04:55",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "With my husband and his parents, and my daughter. Joint family only. It is nice, but also, no privacy, so sometimes I don't want to tell anybody anything.",
      "start_timestamp": "05:01",
      "end_timestamp": "05:14",
      "supports": [
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your blood pressure is 118 over 76, and your pulse is 78 beats per minute.",
      "start_timestamp": "05:40",
      "end_timestamp": "05:48",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Nothing like that. What I'd like to do first is arrange an ultrasound scan of your pelvis, to look at the womb and the ovaries properly.",
      "start_timestamp": "06:25",
      "end_timestamp": "06:39",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The front desk will give you the first available slot, probably this week. Until then, I'd like you to note down on your phone the date of each bleed, how heavy it is, and any pain.",
      "start_timestamp": "07:17",
      "end_timestamp": "07:33",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's say in ten days. By then the scan report will have reached me and we'll go through it together.",
      "start_timestamp": "07:58",
      "end_timestamp": "08:08",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    }
