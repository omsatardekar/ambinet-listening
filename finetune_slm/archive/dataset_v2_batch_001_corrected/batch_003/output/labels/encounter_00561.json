  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. I have come back about my left leg, as you asked me to when we last met.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:10",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's completely understandable. Take your time here, there's no rush at all. Has the weakness come back at any point since our last visit?",
      "start_timestamp": "00:42",
      "end_timestamp": "00:54",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, not at all. I walked to the mailbox and back twice yesterday, simply to be certain.",
      "start_timestamp": "00:56",
      "end_timestamp": "01:06",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I like that, a careful experiment. And what about numbness in the leg or foot?",
      "start_timestamp": "01:08",
      "end_timestamp": "01:18",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "None, thank you.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:23",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Let's go over your medicines so the chart is right. Are you still on the same tablet as before?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:34",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, amlodipine, 5 milligrams, once daily, for my high blood pressure. That is the only one.",
      "start_timestamp": "01:35",
      "end_timestamp": "01:44",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. And are there any allergies I should keep on the record?",
      "start_timestamp": "01:45",
      "end_timestamp": "01:53",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Codeine. I was allergic to it as a young man. It brought me out in hives, and I have avoided it ever since.",
      "start_timestamp": "01:55",
      "end_timestamp": "02:07",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Varicose veins in the right leg. Nothing else of note, I believe.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:28",
      "supports": [
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure is 128 over 78, and your pulse is 70. That looks lovely.",
      "start_timestamp": "03:06",
      "end_timestamp": "03:15",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Excellent. The strength in your left leg is full, and just as strong as the right.",
      "start_timestamp": "03:59",
      "end_timestamp": "04:07",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good question. I don't want to say anything about causes yet, because I'd be guessing. What I'd like to do is arrange an MRI scan of your lower back, so we can look properly.",
      "start_timestamp": "04:17",
      "end_timestamp": "04:35",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Reception will phone you, and they'll send a letter as well. I'd like to see you again in four weeks to go over the scan together.",
      "start_timestamp": "05:18",
      "end_timestamp": "05:33",
      "supports": [
        "clinical_actions[1]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That brings up the driving. For long trips, stop every two hours, get out of the car and walk about for a few minutes.",
