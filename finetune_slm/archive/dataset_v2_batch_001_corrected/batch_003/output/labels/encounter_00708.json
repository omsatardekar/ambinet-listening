  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning. I'll be precise: I started rosuvastatin eight weeks ago, and I have joint aches since, in my hands and knees.",
      "start_timestamp": "00:02",
      "end_timestamp": "00:13",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, that helps. Tell me about the aches, which joints, when?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Both hands, particularly the knuckles, and both knees. Worse in the morning, easing by about ten.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any swelling or redness in the joints?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No visible swelling. No redness.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:48",
      "supports": [
        "negative_findings[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And what are you taking?",
      "start_timestamp": "00:51",
      "end_timestamp": "00:54",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Rosuvastatin, 10 mg once a day, in the evening. Nothing else at all.",
      "start_timestamp": "00:57",
      "end_timestamp": "01:03",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What conditions do you have?",
      "start_timestamp": "01:07",
      "end_timestamp": "01:10",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "High cholesterol, which is why I started it, and osteoarthritis in the right hip, diagnosed last year.",
      "start_timestamp": "01:12",
      "end_timestamp": "01:21",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you exercise?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:26",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I swim three times a week, one kilometre. I've done it for years.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:37",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any breathlessness, chest tightness, or cough, while we're checking you over?",
      "start_timestamp": "01:40",
      "end_timestamp": "01:47",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, nothing like that. My breathing's fine.",
      "start_timestamp": "01:50",
      "end_timestamp": "01:54",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Pulse 66, blood pressure 120 over 74, temperature 36.5, oxygen 99 percent, weight 71 kilos.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:31",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]",
        "vital_signs[4]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "A sensible point. Joint aches are less typical than muscle aches with statins, but they do happen. I'd say a statin side effect is possible, rather than certain.",
      "start_timestamp": "03:08",
      "end_timestamp": "03:24",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Not yet. I'd like to arrange blood tests, to check your muscle enzymes, thyroid and inflammation markers, and an X-ray of both hands.",
      "start_timestamp": "03:56",
      "end_timestamp": "04:07",
      "supports": [
        "procedures_and_investigations[0]",
        "procedures_and_investigations[1]",
        "clinical_actions[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take paracetamol if the aches get in the way, but not more than the packet says.",
      "start_timestamp": "04:34",
      "end_timestamp": "04:42",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'd like to see you in two weeks with the results.",
