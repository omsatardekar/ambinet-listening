  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, Doctor. Thank you for seeing me. I'm afraid it's rather a small thing, these warts on my hands.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:09",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, the first one appeared on my right thumb, and now there are a few more along my fingers.",
      "start_timestamp": "00:16",
      "end_timestamp": "00:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About four months ago, I'd say. I thought it was a bit of hard skin at first.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do they itch or hurt at all?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:52",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, neither of those. They just look dreadful. My granddaughter won't hold my hand!",
      "start_timestamp": "01:54",
      "end_timestamp": "02:03",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Very common. Blood pressure is 142 over 86, and your pulse is 78.",
      "start_timestamp": "04:15",
      "end_timestamp": "04:21",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I understand. For now, the best thing is not to pick or scratch at them, because that can spread them about.",
      "start_timestamp": "04:51",
      "end_timestamp": "05:01",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wash your hands after touching them, and don't share towels with anyone at home.",
      "start_timestamp": "05:08",
      "end_timestamp": "05:15",
      "supports": [
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If they catch on your gloves, a plaster over the worst one is perfectly fine.",
      "start_timestamp": "05:25",
      "end_timestamp": "05:33",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then we'll look again. If they haven't cleared up in three months, come back and see me, and we'll talk about what else can be done.",
      "start_timestamp": "05:53",
      "end_timestamp": "06:08",
      "supports": [
        "clinical_actions[2]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Three months. That seems fair. And if they start spreading quickly before then?",
      "start_timestamp": "06:10",
      "end_timestamp": "06:17",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then don't wait that long. Ring the surgery and book in sooner.",
      "start_timestamp": "06:19",
      "end_timestamp": "06:26",
      "supports": [
        "clinical_actions[3]"
      ]
    }
