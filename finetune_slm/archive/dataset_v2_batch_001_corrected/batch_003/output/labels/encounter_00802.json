      "supports": [
        "vital_signs[0]",
        "vital_signs[1]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mr Doherty. How did the ear start?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I swam in the sea on Saturday, and the water got in, and by Sunday it was blocked, then painful.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How would you describe the pain?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A throbbing ache, severe when I touch the ear, or pull on it, or chew. It wakes me at night.",
      "start_timestamp": "01:02",
      "end_timestamp": "01:13",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little clear fluid, yesterday. Today it's gone.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any dizziness, or ringing?",
      "start_timestamp": "01:25",
      "end_timestamp": "01:28",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No. Neither.",
      "start_timestamp": "01:29",
      "end_timestamp": "01:31",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any allergies to medicines?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:36",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Ciprofloxacin gave me a rash, years ago, so I avoid that.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:43",
      "supports": [
        "allergies[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you swim regularly, or use earbuds?",
      "start_timestamp": "01:57",
      "end_timestamp": "02:01",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I swim in the sea three times a week, and I use earphones to run.",
      "start_timestamp": "02:02",
      "end_timestamp": "02:11",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The ear canal is swollen and red, with some debris, and pulling the ear is very painful. I can't see the eardrum properly.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:54",
      "supports": [
        "physical_examination[0]",
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It's an infection of the ear canal, outer ear, we call it otitis externa, swimmer's ear.",
      "start_timestamp": "03:03",
      "end_timestamp": "03:13",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Yes. I'm going to prescribe ear drops with an antibiotic and a steroid, three drops, three times a day, for seven days.",
      "start_timestamp": "03:18",
      "end_timestamp": "03:30",
      "supports": [
        "medications[0]",
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd like you to take paracetamol for the pain, 1 gram, up to four times a day.",
      "start_timestamp": "03:50",
      "end_timestamp": "04:01",
      "supports": [
        "medications[1]",
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Keep the ear dry, no swimming, no earphones, and don't poke anything in it.",
      "start_timestamp": "04:05",
      "end_timestamp": "04:12",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If the pain gets worse, you get a fever, swelling behind the ear, or dizziness, come back the same day.",
      "start_timestamp": "04:50",
      "end_timestamp": "05:02",
      "supports": [
        "clinical_actions[0]",
        "follow_up[0]"
      ]
