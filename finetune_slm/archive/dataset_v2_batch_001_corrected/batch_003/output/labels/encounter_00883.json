  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "Doctor, my neighbour here, Mr Hughes, can't hear properly and can't see well, and he's hardly going out anymore. I'm worried about him.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you for bringing him in. Mr Hughes, how are you finding your hearing?",
      "start_timestamp": "00:16",
      "end_timestamp": "00:23",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "What? You'll have to speak up.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:29",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Your hearing, Mr Hughes. Is it giving you trouble?",
      "start_timestamp": "00:32",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Aye, I can't follow the telly, and on the phone it's just noise.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He turns the television up so loud that the whole street can hear it.",
      "start_timestamp": "00:50",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And your eyes?",
      "start_timestamp": "01:01",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Everything's blurry, especially reading. I can't read the paper anymore.",
      "start_timestamp": "01:05",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "When did you start noticing these changes?",
      "start_timestamp": "01:14",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Och, I couldn't tell you. It crept up. A couple of years, maybe.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:27",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "I only noticed this past winter, but I think it was going on before.",
      "start_timestamp": "01:28",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[0]",
        "symptoms[1]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you go out and meet friends?",
      "start_timestamp": "01:36",
      "end_timestamp": "01:41",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Not much now. I get lost in the conversation, so I don't bother.",
      "start_timestamp": "01:42",
      "end_timestamp": "01:49",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He used to go to the bowls club every Thursday, and he stopped last spring.",
      "start_timestamp": "01:52",
      "end_timestamp": "02:00",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Do you have any medical problems?",
      "start_timestamp": "02:17",
      "end_timestamp": "02:20",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "He has high blood pressure, diabetes, and cataracts in the left eye, I think.",
      "start_timestamp": "02:22",
      "end_timestamp": "02:31",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Blood pressure 146 over 84, pulse 72, temperature 36.5, oxygen 97 percent.",
      "start_timestamp": "02:52",
      "end_timestamp": "02:58",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "vital_signs[3]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "There's a lot of wax in both ears, blocking the eardrums.",
      "start_timestamp": "03:35",
      "end_timestamp": "03:40",
      "supports": [
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It may be a big part of it. I'd like to have it removed and then recheck your hearing.",
      "start_timestamp": "03:48",
      "end_timestamp": "03:59",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "The nurse can arrange ear syringing next week, and I'll refer him for an eye test and a hearing test after.",
      "start_timestamp": "04:07",
      "end_timestamp": "04:18",
      "supports": [
        "procedures_and_investigations[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "In the meantime, I'd like him to have an eye test with the optician.",
      "start_timestamp": "04:23",
      "end_timestamp": "04:32",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And I'd encourage him to go back to the bowls club once he can hear again.",
      "start_timestamp": "04:40",
      "end_timestamp": "04:47",
      "supports": [
        "clinical_actions[3]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If he gets sudden hearing loss or severe dizziness, call us straight away.",
      "start_timestamp": "04:54",
      "end_timestamp": "05:00",
