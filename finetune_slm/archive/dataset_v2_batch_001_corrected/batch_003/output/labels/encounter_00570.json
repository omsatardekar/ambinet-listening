  "clinical_uncertainties": [],
  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "Hello, doctor. Sorry, it's Mia, she's been screaming in the night and I'm at my wits' end.",
      "start_timestamp": "00:01",
      "end_timestamp": "00:11",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "About an hour after she goes down, she sits up screaming, eyes wide open, but she doesn't know me. I'm holding her and she pushes me away.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "And how often is this happening?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "Two or three times a week now. It's been three weeks since it started.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:24",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Understood. Has anything changed at home lately?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:30",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "We had a new baby in July, so it's all been a bit upside down. Mia's been very clingy since.",
      "start_timestamp": "01:32",
      "end_timestamp": "01:43",
      "supports": [
        "medical_history.social_history[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's a big change for a four-year-old. Is she tired during the day?",
      "start_timestamp": "01:44",
      "end_timestamp": "01:52",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "Very. She's grumpy by lunchtime, and I had to carry her home from nursery on Monday.",
      "start_timestamp": "01:54",
      "end_timestamp": "02:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any fever, or has she banged her head, or been poorly in some other way?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:12",
      "supports": [
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "No fever, and no bangs to the head. She's just had a stuffy nose for ages.",
      "start_timestamp": "02:13",
      "end_timestamp": "02:21",
      "supports": [
        "symptoms[2]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "It's all stuck, Mummy.",
      "start_timestamp": "02:30",
      "end_timestamp": "02:33",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Poor you. And how's her tummy and her bowels, generally?",
      "start_timestamp": "02:35",
      "end_timestamp": "02:41",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "All normal, regular as anything.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:47",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Any other health problems, or operations she's had in the past?",
      "start_timestamp": "02:50",
      "end_timestamp": "02:56",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "family_member",
      "transcript_text": "She's had eczema since she was a baby, it's quiet at the moment. And she had grommets put in when she was two.",
      "start_timestamp": "02:59",
      "end_timestamp": "03:12",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.surgical_history[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Her nose is blocked up on both sides, with clear mucus. Temperature is 36.8 degrees, pulse 98, and oxygen 99 percent.",
      "start_timestamp": "03:53",
      "end_timestamp": "04:06",
      "supports": [
        "vital_signs[0]",
        "vital_signs[1]",
        "vital_signs[2]",
        "physical_examination[0]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Chest sounds clear, with good air going in and out.",
      "start_timestamp": "04:32",
      "end_timestamp": "04:37",
      "supports": [
        "physical_examination[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "No, don't try to wake her. Stay close, keep her safe, speak softly, and let it pass. She won't remember it.",
      "start_timestamp": "05:33",
      "end_timestamp": "05:46",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll prescribe saline nose drops for the blocked nose, two drops in each nostril, twice a day, for a week or so.",
      "start_timestamp": "05:55",
      "end_timestamp": "06:07",
      "supports": [
        "medications[0]",
        "clinical_actions[0]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Earlier, by half an hour. Overtired children often sleep worse, so try that for a couple of weeks.",
      "start_timestamp": "06:32",
      "end_timestamp": "06:42",
      "supports": [
        "clinical_actions[2]"
      ]
    },
    {
      "evidence_id": "EV_021",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If it carries on for another month, bring her back and we'll think about the next steps.",
      "start_timestamp": "07:05",
      "end_timestamp": "07:15",
      "supports": [
        "clinical_actions[3]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Then ring us straight away, or go to A and E if it's out of hours.",
      "start_timestamp": "07:23",
      "end_timestamp": "07:32",
      "supports": [
        "clinical_actions[4]"
      ]
    }
  ],
