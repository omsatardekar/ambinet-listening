      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about caffeine and alcohol? Tell me what you have in a typical day.",
      "start_timestamp": "02:21",
      "end_timestamp": "02:28",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "About four cups of strong tea, usually the last at around eight in the evening. And I drink wine at the weekend, a glass or two.",
      "start_timestamp": "02:29",
      "end_timestamp": "02:41",
      "supports": [
        "medical_history.social_history[0]",
        "medical_history.social_history[1]"
      ]
