  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Good morning, doctor. I've been keeping a note of this, so I can be precise. My heart pounds at night, and has done for about a month.",
      "start_timestamp": "00:00",
      "end_timestamp": "00:14",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you, that's really useful. Tell me what it feels like.",
      "start_timestamp": "00:15",
      "end_timestamp": "00:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A thumping, in the chest and sometimes in my throat, quite fast. It wakes me up, usually between two and four.",
      "start_timestamp": "00:24",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long does an episode last?",
      "start_timestamp": "00:38",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Anywhere from a couple of minutes to, last Tuesday, I'd say twenty minutes.",
      "start_timestamp": "00:44",
      "end_timestamp": "00:51",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_3",
      "speaker_role": "unknown",
      "transcript_text": "[from the corridor] It was nearer half an hour, last Tuesday.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Oh, someone's talking out there. Ignore that. It lasted a good while, anyway.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:09",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll go by what you tell me. Does anything come with it, dizziness, sweating?",
      "start_timestamp": "01:12",
      "end_timestamp": "01:19",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Dizzy spells, yes. Occasionally I feel light-headed when I stand up in the morning. I can't say when that began.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Roughly, before the thumping, or after?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:36",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I honestly don't know. I only noticed it recently.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:43",
      "supports": [
        "symptoms[1]",
        "clinical_uncertainties[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Fair enough. And do you sweat at night?",
      "start_timestamp": "01:46",
      "end_timestamp": "01:51",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Sometimes, after the thumping. My pyjamas get damp.",
      "start_timestamp": "01:54",
      "end_timestamp": "01:59",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any chest pain with it?",
