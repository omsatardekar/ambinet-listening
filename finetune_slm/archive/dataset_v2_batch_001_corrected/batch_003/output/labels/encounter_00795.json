      "end_timestamp": "00:47",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "First, I see zigzag lights, for twenty minutes. Then the headache. And then I feel sick. Nauseous, I mean.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:58",
      "supports": [
