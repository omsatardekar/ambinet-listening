      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's get the facts first. When one starts, what happens?",
