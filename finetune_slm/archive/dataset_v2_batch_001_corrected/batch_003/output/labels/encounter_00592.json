  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Mum insisted on being right by the door, so I circled for twenty minutes. Anyway, we're here for the check-up after she was so poorly last month.",
