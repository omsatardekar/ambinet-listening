      "supports": [
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I don't get puffed out. I do the stairs two at a time. Well, one at a time.",
      "start_timestamp": "01:58",
      "end_timestamp": "02:07",
      "supports": [
        "negative_findings[1]"
      ]
    },
    {
