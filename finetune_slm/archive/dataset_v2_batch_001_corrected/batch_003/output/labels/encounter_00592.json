      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good. Let's talk about your chest. Have you been coughing at all?",
      "start_timestamp": "00:56",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]",
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "No, I'm not coughing. Not that I've noticed.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:07",
      "supports": [
        "negative_findings[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Mum, you are. You're coughing at night. I can hear you through the wall.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Am I? I don't notice it, dear. I sleep like a log.",
      "start_timestamp": "01:19",
      "end_timestamp": "01:26",
      "supports": [
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, I'll keep both views in mind. Helen, how often do you hear it?",
      "start_timestamp": "01:28",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Most nights, a dry little cough. It doesn't go on for long, but it's there.",
      "start_timestamp": "01:38",
      "end_timestamp": "01:46",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Thank you. Joan, what about the stairs, do you get puffed out?",
      "start_timestamp": "01:48",
