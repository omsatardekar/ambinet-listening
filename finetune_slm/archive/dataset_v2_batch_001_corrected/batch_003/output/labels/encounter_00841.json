  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good morning, Mr Calder. I understand light has become uncomfortable since you were ill.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:35",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes. Three weeks ago I had a viral illness, a fever, aches, a streaming cold. Since then, bright light, sunlight, even the strip lights in the supermarket, hurts my eyes. I squint, and my eyes water.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it both eyes?",
      "start_timestamp": "00:59",
      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Both, equally. There's no redness, and no pain as such, only a discomfort in bright light, like a glare.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "nurse",
      "transcript_text": "Any allergies, Mr Calder? We need it for the drops.",
      "start_timestamp": "01:25",
      "end_timestamp": "01:31",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, that's an interesting one. I think I may have had a reaction to some eye drops years ago, but I can't tell you which drops, or what the reaction was. I've never been sure.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:52",
      "supports": [
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I'll note that as a possible reaction, not confirmed, substance and reaction unknown. Any medicines you take?",
      "start_timestamp": "01:54",
      "end_timestamp": "02:03",
      "supports": [
        "medications[0]",
        "allergies[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Just one, lansoprazole, 15 mg, once a day.",
      "start_timestamp": "02:06",
      "end_timestamp": "02:10",
      "supports": [
        "medications[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any family history of eye problems?",
      "start_timestamp": "02:13",
      "end_timestamp": "02:17",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "My mother had glaucoma, and my uncle had macular degeneration.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:24",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "It is. Light sensitivity after a viral illness, with a normal examination, is common, and it usually settles over a few weeks. I'd say this is post-viral light sensitivity.",
      "start_timestamp": "04:21",
      "end_timestamp": "04:35",
      "supports": [
        "clinical_assessment[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Wear good sunglasses outdoors, and a brimmed hat, and don't stay in a dark room, as that can make the eyes more sensitive.",
      "start_timestamp": "04:58",
      "end_timestamp": "05:09",
      "supports": [
        "clinical_actions[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "If your vision changes, you get eye pain, redness, or a severe headache, or it's still bothering you in six weeks, come back to see me.",
      "start_timestamp": "05:29",
      "end_timestamp": "05:42",
      "supports": [
        "medical_history.family_history[0]",
        "clinical_actions[0]",
        "follow_up[0]"
      ]
    }
