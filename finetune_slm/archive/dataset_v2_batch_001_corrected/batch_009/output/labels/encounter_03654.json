      "end_timestamp": "01:04",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is there anything else with it?",
      "start_timestamp": "01:05",
      "end_timestamp": "01:07",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Pain at night goes along with it, most of the time.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "The pain at night? That's been for two days. And there's being told it was shin splints as well, five days now.",
