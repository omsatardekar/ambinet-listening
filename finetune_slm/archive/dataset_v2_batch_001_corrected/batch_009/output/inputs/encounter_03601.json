{
  "schema_version": "1.0",
  "encounter_id": "03601",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.81,
      "duration_seconds": 4.99,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 10.79,
      "duration_seconds": 4.0,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.45,
      "end_seconds": 16.06,
      "duration_seconds": 4.61,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 20.73,
      "duration_seconds": 2.84,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.37,
      "end_seconds": 26.15,
      "duration_seconds": 3.78,
      "text": "I wanted to get sore ankles looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.76,
      "end_seconds": 31.59,
      "duration_seconds": 3.83,
      "text": "Okay, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.41,
      "end_seconds": 48.19,
      "duration_seconds": 14.78,
      "text": "About a six out of ten. I've also had a dry cough. With dry cough, a three out of ten, I suppose. Tiredness was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.24,
      "end_seconds": 55.27,
      "duration_seconds": 6.03,
      "text": "Have you had sore ankles before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.04,
      "end_seconds": 64.13,
      "duration_seconds": 7.09,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.04,
      "end_seconds": 68.86,
      "duration_seconds": 3.82,
      "text": "Any weight loss, night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.5,
      "end_seconds": 76.26,
      "duration_seconds": 5.76,
      "text": "No, no weight loss, night sweats or coughing up blood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.73,
      "end_seconds": 80.15,
      "duration_seconds": 3.42,
      "text": "I follow. Has there been any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.04,
      "end_seconds": 82.73,
      "duration_seconds": 1.69,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.68,
      "end_seconds": 86.7,
      "duration_seconds": 2.02,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.58,
      "end_seconds": 90.08,
      "duration_seconds": 2.5,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.6,
      "end_seconds": 95.06,
      "duration_seconds": 4.46,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.99,
      "end_seconds": 98.48,
      "duration_seconds": 1.49,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.08,
      "end_seconds": 103.49,
      "duration_seconds": 3.41,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.25,
      "end_seconds": 111.46,
      "duration_seconds": 7.21,
      "text": "I've got an underactive thyroid. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.64,
      "end_seconds": 121.39,
      "duration_seconds": 8.75,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.03,
      "end_seconds": 126.43,
      "duration_seconds": 4.4,
      "text": "Eltroxin. I take it 100 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.05,
      "end_seconds": 132.87,
      "duration_seconds": 4.82,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.05,
      "end_seconds": 136.22,
      "duration_seconds": 2.17,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.51,
      "end_seconds": 139.88,
      "duration_seconds": 2.37,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.94,
      "end_seconds": 143.54,
      "duration_seconds": 1.6,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.15,
      "end_seconds": 162.17,
      "duration_seconds": 2.02,
      "text": "Alright, what about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.05,
      "end_seconds": 170.02,
      "duration_seconds": 3.97,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.67,
      "end_seconds": 171.48,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.19,
      "end_seconds": 175.49,
      "duration_seconds": 2.3,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.99,
      "end_seconds": 180.43,
      "duration_seconds": 3.44,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.44,
      "end_seconds": 184.85,
      "duration_seconds": 3.41,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.17,
      "end_seconds": 188.3,
      "duration_seconds": 2.13,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.46,
      "end_seconds": 192.28,
      "duration_seconds": 2.82,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.8,
      "end_seconds": 197.07,
      "duration_seconds": 3.27,
      "text": "Right, do you work outside the home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.19,
      "end_seconds": 202.51,
      "duration_seconds": 4.32,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.95,
      "end_seconds": 208.63,
      "duration_seconds": 4.68,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.35,
      "end_seconds": 213.18,
      "duration_seconds": 2.83,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.3,
      "end_seconds": 220.93,
      "duration_seconds": 2.63,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.48,
      "end_seconds": 232.17,
      "duration_seconds": 2.69,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.79,
      "end_seconds": 265.42,
      "duration_seconds": 15.63,
      "text": "Okay: BMI works out to 27.1, height 155 centimetres, pulse is 67 beats a minute, oxygen saturation is 97 percent, respiratory rate 16, weight 65 kilos, pressure 110 over 79."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.91,
      "end_seconds": 270.27,
      "duration_seconds": 2.36,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.24,
      "end_seconds": 284.82,
      "duration_seconds": 1.58,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.78,
      "end_seconds": 287.86,
      "duration_seconds": 2.08,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.6,
      "end_seconds": 307.85,
      "duration_seconds": 6.25,
      "text": "There are tender raised red nodules on both shins and your ankles are puffy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.36,
      "end_seconds": 313.42,
      "duration_seconds": 3.06,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.92,
      "end_seconds": 350.13,
      "duration_seconds": 21.21,
      "text": "Having listened and examined, the most likely explanation is possible sarcoidosis. Rest and elevate the legs, and I'm arranging a chest clinic review. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.79,
      "end_seconds": 354.61,
      "duration_seconds": 2.82,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.74,
      "end_seconds": 358.1,
      "duration_seconds": 2.36,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.06,
      "end_seconds": 363.49,
      "duration_seconds": 3.43,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}