{
  "schema_version": "1.0",
  "encounter_id": "03501",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 3.72,
      "duration_seconds": 3.05,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.23,
      "end_seconds": 8.18,
      "duration_seconds": 3.95,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.15,
      "end_seconds": 14.83,
      "duration_seconds": 5.68,
      "text": "it's a bit of stiffness in my knee replacement, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.86,
      "end_seconds": 20.68,
      "duration_seconds": 4.82,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.57,
      "end_seconds": 33.92,
      "duration_seconds": 2.35,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.98,
      "end_seconds": 61.08,
      "duration_seconds": 14.1,
      "text": "okay: temp 36.6 degrees, pressure 115 over 69. And oxygen saturation is 98 percent, pulse is 77 beats a a minute how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.62,
      "end_seconds": 63.94,
      "duration_seconds": 2.32,
      "text": "it's been two days now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.19,
      "end_seconds": 74.22,
      "duration_seconds": 9.03,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.93,
      "end_seconds": 80.63,
      "duration_seconds": 5.7,
      "text": "A eight out of ten, I suppose. Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.29,
      "end_seconds": 83.43,
      "duration_seconds": 2.14,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.48,
      "end_seconds": 92.78,
      "duration_seconds": 8.3,
      "text": "It usually comes with slight warmth. And I've been feeling tired as well, uh, for two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.37,
      "end_seconds": 95.34,
      "duration_seconds": 1.97,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.52,
      "end_seconds": 101.35,
      "duration_seconds": 4.83,
      "text": "The slight warmth? That's been for about a month."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.0,
      "end_seconds": 110.75,
      "duration_seconds": 7.75,
      "text": "have you had a bit of stiffness in your knee replacement before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.58,
      "end_seconds": 118.15,
      "duration_seconds": 5.57,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.8,
      "end_seconds": 123.23,
      "duration_seconds": 4.43,
      "text": "and what about severe pain, wound discharge or high fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.51,
      "end_seconds": 126.45,
      "duration_seconds": 1.94,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.22,
      "end_seconds": 131.55,
      "duration_seconds": 3.33,
      "text": "Right, did you notice any recent injury?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.73,
      "end_seconds": 134.6,
      "duration_seconds": 1.87,
      "text": "Definitely no recent injury."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.18,
      "end_seconds": 137.78,
      "duration_seconds": 2.6,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.11,
      "end_seconds": 143.91,
      "duration_seconds": 2.8,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.7,
      "end_seconds": 146.0,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.99,
      "end_seconds": 152.13,
      "duration_seconds": 4.14,
      "text": "right, nothing, I haven't had any operations"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.99,
      "end_seconds": 165.61,
      "duration_seconds": 2.62,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.71,
      "end_seconds": 169.31,
      "duration_seconds": 2.6,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.96,
      "end_seconds": 172.97,
      "duration_seconds": 2.01,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.44,
      "end_seconds": 180.64,
      "duration_seconds": 6.2,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.13,
      "end_seconds": 185.24,
      "duration_seconds": 3.11,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.59,
      "end_seconds": 190.94,
      "duration_seconds": 4.35,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.9,
      "end_seconds": 194.87,
      "duration_seconds": 1.97,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.82,
      "end_seconds": 199.35,
      "duration_seconds": 2.53,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.41,
      "end_seconds": 210.15,
      "duration_seconds": 2.74,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.72,
      "end_seconds": 213.27,
      "duration_seconds": 2.55,
      "text": "Yes, diclofenac. I get wheezing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.09,
      "end_seconds": 217.84,
      "duration_seconds": 3.75,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.59,
      "end_seconds": 222.4,
      "duration_seconds": 2.81,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.18,
      "end_seconds": 229.12,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.68,
      "end_seconds": 231.8,
      "duration_seconds": 1.12,
      "text": "of course"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.27,
      "end_seconds": 235.37,
      "duration_seconds": 2.1,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.15,
      "end_seconds": 248.98,
      "duration_seconds": 5.83,
      "text": "The knee is mildly warm with a small effusion and the replacement scar is clean."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.99,
      "end_seconds": 255.88,
      "duration_seconds": 1.89,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.56,
      "end_seconds": 283.29,
      "duration_seconds": 12.73,
      "text": "let me tell you where I've got to. It points towards a possible low-grade infection of the knee replacement. Wear and tear is also on my list"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.14,
      "end_seconds": 286.39,
      "duration_seconds": 2.25,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.46,
      "end_seconds": 323.1,
      "duration_seconds": 32.64,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible low-grade infection of the knee replacement, but I'd like to confirm. I'm going to order blood tests, for possible prosthetic infection. I'm going to order a joint aspiration, for warm effusion. That will help us see what's going on underneath and decide the next step. Even without a fever, an infected replacement is serious, so the orthopaedic team will see you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.95,
      "end_seconds": 327.92,
      "duration_seconds": 2.97,
      "text": "We'll refer you to the orthopaedic team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.65,
      "end_seconds": 330.35,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.54,
      "end_seconds": 338.63,
      "duration_seconds": 4.09,
      "text": "do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.39,
      "end_seconds": 342.14,
      "duration_seconds": 2.75,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.72,
      "end_seconds": 349.13,
      "duration_seconds": 5.41,
      "text": "Come back within two days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.88,
      "end_seconds": 354.37,
      "duration_seconds": 3.49,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}