{
  "schema_version": "1.0",
  "encounter_id": "03551",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 7.32,
      "duration_seconds": 6.15,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.5,
      "end_seconds": 12.17,
      "duration_seconds": 3.67,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.89,
      "end_seconds": 23.17,
      "duration_seconds": 10.28,
      "text": "Okay, so honestly, it's a faint rash on the chest, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.97,
      "end_seconds": 27.38,
      "duration_seconds": 2.41,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.73,
      "end_seconds": 34.23,
      "duration_seconds": 5.5,
      "text": "Yeah, you know, it's been about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.75,
      "end_seconds": 38.52,
      "duration_seconds": 3.77,
      "text": "Mm, okay. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.94,
      "end_seconds": 41.79,
      "duration_seconds": 1.85,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.16,
      "end_seconds": 45.22,
      "duration_seconds": 2.06,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.43,
      "end_seconds": 63.28,
      "duration_seconds": 12.85,
      "text": "Erm, when it starts I tend to get mouth ulcers as well. As for mouth ulcers, a four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.64,
      "end_seconds": 72.46,
      "duration_seconds": 7.82,
      "text": "Have you had a faint rash on the chest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.36,
      "end_seconds": 81.27,
      "duration_seconds": 6.91,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.12,
      "end_seconds": 88.6,
      "duration_seconds": 5.48,
      "text": "A few quick ones: recent tick bite, diarrhoea, cough or stiff neck?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.13,
      "end_seconds": 95.9,
      "duration_seconds": 5.77,
      "text": "No, no recent tick bite, diarrhoea, cough or stiff neck."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.33,
      "end_seconds": 100.34,
      "duration_seconds": 4.01,
      "text": "Mm, okay. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.26,
      "end_seconds": 102.9,
      "duration_seconds": 1.64,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.71,
      "end_seconds": 106.45,
      "duration_seconds": 2.74,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.06,
      "end_seconds": 109.75,
      "duration_seconds": 2.69,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.39,
      "end_seconds": 113.68,
      "duration_seconds": 2.29,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.12,
      "end_seconds": 122.01,
      "duration_seconds": 3.89,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.64,
      "end_seconds": 123.92,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.66,
      "end_seconds": 128.95,
      "duration_seconds": 4.29,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.52,
      "end_seconds": 135.87,
      "duration_seconds": 5.35,
      "text": "Let's run through your medicines. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.53,
      "end_seconds": 148.14,
      "duration_seconds": 10.61,
      "text": "I take febuxostat, 80 milligrams, once a day. Lamotrigine, 100 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.33,
      "end_seconds": 152.3,
      "duration_seconds": 2.97,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.35,
      "end_seconds": 155.02,
      "duration_seconds": 1.67,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.99,
      "end_seconds": 158.83,
      "duration_seconds": 2.84,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.31,
      "end_seconds": 167.98,
      "duration_seconds": 3.67,
      "text": "I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.51,
      "end_seconds": 171.92,
      "duration_seconds": 3.41,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.67,
      "end_seconds": 176.24,
      "duration_seconds": 2.57,
      "text": "Gout, for two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.07,
      "end_seconds": 177.97,
      "duration_seconds": 0.9,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.43,
      "end_seconds": 182.23,
      "duration_seconds": 2.8,
      "text": "So, I've had epilepsy, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.88,
      "end_seconds": 194.95,
      "duration_seconds": 7.07,
      "text": "Mm-hmm. Right, so gout and epilepsy are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 212.99,
      "end_seconds": 228.38,
      "duration_seconds": 15.39,
      "text": "Doctor, I've got the readings for you. Saturation 98 percent, heart rate 92, blood pressure 111 over 68. Weight 59 kilos, BMI works out to 24.6, temperature 38.7, height 155 centimetres."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.14,
      "end_seconds": 230.17,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.85,
      "end_seconds": 236.21,
      "duration_seconds": 3.36,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.96,
      "end_seconds": 240.33,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.89,
      "end_seconds": 264.45,
      "duration_seconds": 6.56,
      "text": "There are small mouth ulcers, tender neck glands and a faint pink rash on the chest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.68,
      "end_seconds": 270.45,
      "duration_seconds": 1.77,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.55,
      "end_seconds": 317.26,
      "duration_seconds": 33.71,
      "text": "Right, here's what I'm thinking. It's hard to say. An acute viral illness, possibly early HIV infection is one possibility and glandular fever another, and I'd rather not commit yet. I want a full blood count done, that's for viral illness. Let's book a fourth-generation HIV test to look into acute viral illness with rash. I'm offering an HIV test with every illness like this, it's routine, and results are confidential."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.83,
      "end_seconds": 332.42,
      "duration_seconds": 13.59,
      "text": "If it hasn't settled in a month, we'd think about a glandular fever test, but not now. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.74,
      "end_seconds": 342.13,
      "duration_seconds": 4.39,
      "text": "Yeah, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.55,
      "end_seconds": 349.2,
      "duration_seconds": 5.65,
      "text": "I'd like you back after the results. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.38,
      "end_seconds": 354.88,
      "duration_seconds": 4.5,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.1,
      "end_seconds": 357.28,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}