{
  "schema_version": "1.0",
  "encounter_id": "03515",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.22,
      "duration_seconds": 3.17,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.04,
      "end_seconds": 14.1,
      "duration_seconds": 4.06,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.63,
      "end_seconds": 18.03,
      "duration_seconds": 3.4,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.77,
      "end_seconds": 22.88,
      "duration_seconds": 4.11,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.46,
      "end_seconds": 30.42,
      "duration_seconds": 5.96,
      "text": "Actually, doctor, it's a tremor. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.43,
      "end_seconds": 37.77,
      "duration_seconds": 3.34,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.55,
      "end_seconds": 41.9,
      "duration_seconds": 3.35,
      "text": "I, I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 44.0,
      "end_seconds": 49.36,
      "duration_seconds": 5.36,
      "text": "Well, I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.65,
      "end_seconds": 55.15,
      "duration_seconds": 4.5,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.76,
      "end_seconds": 56.97,
      "duration_seconds": 1.21,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.11,
      "end_seconds": 61.07,
      "duration_seconds": 2.96,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.43,
      "end_seconds": 68.63,
      "duration_seconds": 6.2,
      "text": "Pretty severe, if I'm being honest. I've, I've been feeling agitated too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.33,
      "end_seconds": 72.01,
      "duration_seconds": 2.68,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.53,
      "end_seconds": 90.77,
      "duration_seconds": 15.24,
      "text": "Erm, I'd give it a three, out of ten. Oh, and loose stools. Um, about loose stools, it's severe, honestly. I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.0,
      "end_seconds": 108.1,
      "duration_seconds": 4.1,
      "text": "Let me check a few things. Any stiffness or seizure?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.88,
      "end_seconds": 112.46,
      "duration_seconds": 2.58,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.21,
      "end_seconds": 116.36,
      "duration_seconds": 3.15,
      "text": "Have you noticed high fever or confusion?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.32,
      "end_seconds": 122.5,
      "duration_seconds": 5.18,
      "text": "Um, I haven't had high fever or confusion, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.54,
      "end_seconds": 126.98,
      "duration_seconds": 2.44,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.48,
      "end_seconds": 130.19,
      "duration_seconds": 2.71,
      "text": "So, no, joints are fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.63,
      "end_seconds": 133.86,
      "duration_seconds": 2.23,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.9,
      "end_seconds": 142.25,
      "duration_seconds": 6.35,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.59,
      "end_seconds": 146.36,
      "duration_seconds": 2.77,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.24,
      "end_seconds": 165.79,
      "duration_seconds": 17.55,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I do a yoga class on Thursdays. I grab fast food at lunch most days. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.75,
      "end_seconds": 170.48,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 171.52,
      "end_seconds": 176.84,
      "duration_seconds": 5.32,
      "text": "Um, it's allopurinol, 100 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.85,
      "end_seconds": 183.21,
      "duration_seconds": 1.36,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 184.13,
      "end_seconds": 185.55,
      "duration_seconds": 1.42,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.51,
      "end_seconds": 192.34,
      "duration_seconds": 4.83,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.33,
      "end_seconds": 205.57,
      "duration_seconds": 11.24,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.52,
      "end_seconds": 225.95,
      "duration_seconds": 4.43,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.47,
      "end_seconds": 235.15,
      "duration_seconds": 8.68,
      "text": "I have depression, for five years. It's the not knowing that gets to me. I have gout."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.09,
      "end_seconds": 250.15,
      "duration_seconds": 14.06,
      "text": "Alright, gout, that matches what I have here. Putting together what you've described, the most likely explanation is mild serotonin syndrome from combining medicines. I'd also keep anxiety in mind."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.03,
      "end_seconds": 256.06,
      "duration_seconds": 4.03,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.56,
      "end_seconds": 267.43,
      "duration_seconds": 10.87,
      "text": "Nothing I've seen today points to an emergency. It looks like mild serotonin syndrome from combining medicines, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 318.54,
      "duration_seconds": 34.64,
      "text": "I'll request blood tests, it'll help with agitation and clonus. I'd rather check than guess, and this is the quickest way to know more. We will stop the migraine tablet and watch you for several hours. If you smoke, this is a good moment to think about stopping, and we can help you with that. Please don't wait if the symptoms get worse. That's when to be seen urgently. Book a review in one day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.8,
      "end_seconds": 322.39,
      "duration_seconds": 2.59,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.96,
      "end_seconds": 324.62,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.62,
      "end_seconds": 327.89,
      "duration_seconds": 2.27,
      "text": "Okay, have a good day."
    }
  ]
}