{
  "schema_version": "1.0",
  "encounter_id": "03566",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 4.43,
      "duration_seconds": 3.64,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.19,
      "end_seconds": 6.22,
      "duration_seconds": 1.03,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 8.96,
      "duration_seconds": 1.35,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.51,
      "end_seconds": 16.59,
      "duration_seconds": 7.08,
      "text": "Doctor, it's an itchy red rash on the chest. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.66,
      "end_seconds": 19.29,
      "duration_seconds": 1.63,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.69,
      "end_seconds": 23.99,
      "duration_seconds": 3.3,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.88,
      "end_seconds": 37.01,
      "duration_seconds": 9.13,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.76,
      "end_seconds": 51.23,
      "duration_seconds": 13.47,
      "text": "Honestly, on and off. I'd give it a three, out of ten. Oh, and spreading over a week. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.93,
      "end_seconds": 55.83,
      "duration_seconds": 3.9,
      "text": "Any mouth sores, facial swelling or breathing difficulty?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.78,
      "end_seconds": 61.15,
      "duration_seconds": 4.37,
      "text": "No, no mouth sores, facial swelling or breathing difficulty."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.9,
      "end_seconds": 65.26,
      "duration_seconds": 3.36,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.88,
      "end_seconds": 69.27,
      "duration_seconds": 2.39,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.47,
      "end_seconds": 73.2,
      "duration_seconds": 2.73,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.06,
      "end_seconds": 77.52,
      "duration_seconds": 2.46,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.86,
      "end_seconds": 84.72,
      "duration_seconds": 2.86,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.04,
      "end_seconds": 96.2,
      "duration_seconds": 10.16,
      "text": "I work in accounts at a hospital. Not much, I mostly stay in these days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.29,
      "end_seconds": 113.4,
      "duration_seconds": 4.11,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.33,
      "end_seconds": 121.3,
      "duration_seconds": 6.97,
      "text": "Sorry, what was I saying, I've had gout for about a year now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.45,
      "end_seconds": 123.79,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.32,
      "end_seconds": 127.12,
      "duration_seconds": 2.8,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.57,
      "end_seconds": 130.81,
      "duration_seconds": 2.24,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.33,
      "end_seconds": 134.5,
      "duration_seconds": 2.17,
      "text": "Febuxostat, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.36,
      "end_seconds": 138.53,
      "duration_seconds": 2.17,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.48,
      "end_seconds": 152.54,
      "duration_seconds": 9.06,
      "text": "80 milligrams, I think that's what's on the box. Allopurinol, 100 milligrams, started three weeks ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.53,
      "end_seconds": 156.81,
      "duration_seconds": 3.28,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.18,
      "end_seconds": 160.08,
      "duration_seconds": 1.9,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 166.02,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.16,
      "end_seconds": 172.22,
      "duration_seconds": 5.06,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.15,
      "end_seconds": 177.91,
      "duration_seconds": 3.76,
      "text": "Right, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.47,
      "end_seconds": 190.83,
      "duration_seconds": 3.36,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.78,
      "end_seconds": 217.46,
      "duration_seconds": 9.68,
      "text": "Okay: pulse 78, respiratory rate 18, pressure 114 over 79, SpO2 97 percent on room air, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.54,
      "end_seconds": 221.85,
      "duration_seconds": 2.31,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.14,
      "end_seconds": 227.54,
      "duration_seconds": 4.4,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.87,
      "end_seconds": 232.11,
      "duration_seconds": 3.24,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.61,
      "end_seconds": 248.51,
      "duration_seconds": 0.9,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.55,
      "end_seconds": 251.64,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.05,
      "end_seconds": 270.48,
      "duration_seconds": 8.43,
      "text": "There is a fine pink rash across the chest and arms, with no blistering and the mouth is clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.91,
      "end_seconds": 275.04,
      "duration_seconds": 2.13,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.21,
      "end_seconds": 307.76,
      "duration_seconds": 22.55,
      "text": "Let's get blood tests, for drug rash. You'll be taking cetirizine, 10 milligrams, once a day, one week. That should help with itch. Please stop the allopurinol and don't restart it until we've spoken to the clinic. Book a review in three days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.67,
      "end_seconds": 311.72,
      "duration_seconds": 3.05,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.66,
      "end_seconds": 314.84,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}