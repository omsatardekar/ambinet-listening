{
  "schema_version": "1.0",
  "encounter_id": "03576",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 3.77,
      "duration_seconds": 2.54,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.04,
      "end_seconds": 6.16,
      "duration_seconds": 1.12,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.98,
      "end_seconds": 12.67,
      "duration_seconds": 5.69,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.36,
      "end_seconds": 21.64,
      "duration_seconds": 7.28,
      "text": "Of course, please stay. It's helpful to have you here. What do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.72,
      "end_seconds": 30.23,
      "duration_seconds": 7.51,
      "text": "Uh, you know, so the thing is, I've got poor appetite for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.77,
      "end_seconds": 38.44,
      "duration_seconds": 2.67,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.74,
      "end_seconds": 46.07,
      "duration_seconds": 6.33,
      "text": "Being a bit constipated goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.67,
      "end_seconds": 49.8,
      "duration_seconds": 2.13,
      "text": "Have you been feeling off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.18,
      "end_seconds": 59.93,
      "duration_seconds": 8.75,
      "text": "Yes, I have. As for feeling off, maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 74.25,
      "end_seconds": 91.08,
      "duration_seconds": 16.83,
      "text": "Here are the numbers, doctor. Oxygen saturation is 98 percent, height 172 centimetres, weight 77 kilos. Temperature is 36.9 degrees, pressure 125 over 69, pulse is 85 beats a minute, BMI works out to 26.0."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.62,
      "end_seconds": 97.62,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.29,
      "end_seconds": 105.29,
      "duration_seconds": 5.0,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.77,
      "end_seconds": 122.5,
      "duration_seconds": 1.73,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.1,
      "end_seconds": 126.87,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.83,
      "end_seconds": 151.18,
      "duration_seconds": 9.35,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.75,
      "end_seconds": 159.34,
      "duration_seconds": 3.59,
      "text": "You can sit up now. Any sign of vomiting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.21,
      "end_seconds": 162.59,
      "duration_seconds": 1.38,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 163.3,
      "end_seconds": 169.54,
      "duration_seconds": 6.24,
      "text": "Actually, you know, doctor, I did notice vomiting. He doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.27,
      "end_seconds": 178.03,
      "duration_seconds": 7.76,
      "text": "No, uh, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.63,
      "end_seconds": 188.96,
      "duration_seconds": 9.33,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any high fever, urinary symptoms or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.16,
      "end_seconds": 196.49,
      "duration_seconds": 6.33,
      "text": "No high fever, urinary symptoms or blood in the stool, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.08,
      "end_seconds": 199.97,
      "duration_seconds": 1.89,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.9,
      "end_seconds": 202.76,
      "duration_seconds": 1.86,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.86,
      "end_seconds": 205.71,
      "duration_seconds": 1.85,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.15,
      "end_seconds": 211.47,
      "duration_seconds": 4.32,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.19,
      "end_seconds": 215.09,
      "duration_seconds": 1.9,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.42,
      "end_seconds": 220.11,
      "duration_seconds": 3.69,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 223.46,
      "duration_seconds": 2.37,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.98,
      "end_seconds": 230.7,
      "duration_seconds": 5.72,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.81,
      "end_seconds": 235.98,
      "duration_seconds": 4.17,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.57,
      "end_seconds": 247.91,
      "duration_seconds": 11.34,
      "text": "Yeah, I've had high blood pressure, yes. I've been putting this off for weeks. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.37,
      "end_seconds": 250.45,
      "duration_seconds": 1.08,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.44,
      "end_seconds": 261.04,
      "duration_seconds": 8.6,
      "text": "I have heart disease, for five years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.27,
      "end_seconds": 263.13,
      "duration_seconds": 0.86,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.14,
      "end_seconds": 268.16,
      "duration_seconds": 4.02,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.21,
      "end_seconds": 272.37,
      "duration_seconds": 2.16,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.11,
      "end_seconds": 276.84,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.61,
      "end_seconds": 281.12,
      "duration_seconds": 3.51,
      "text": "Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 281.68,
      "end_seconds": 286.66,
      "duration_seconds": 4.98,
      "text": "Doctor, our chart from the last visit lists it as 150 milligrams."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.78,
      "end_seconds": 291.76,
      "duration_seconds": 3.98,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.43,
      "end_seconds": 298.35,
      "duration_seconds": 3.92,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.27,
      "end_seconds": 306.62,
      "duration_seconds": 7.35,
      "text": "Has anything ever caused you a reaction? I mean any allergies. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.54,
      "end_seconds": 312.37,
      "duration_seconds": 4.83,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.8,
      "end_seconds": 349.08,
      "duration_seconds": 20.28,
      "text": "From what you've told me and what I found, I can't pin this down yet. We're looking at possible appendicitis, which can look mild in older people or diverticulitis. Let me just check I've got this right. You've had poor appetite for two days, and no high fever or urinary symptoms."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.31,
      "end_seconds": 352.81,
      "duration_seconds": 1.5,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.69,
      "end_seconds": 358.36,
      "duration_seconds": 3.67,
      "text": "I'm going to order blood tests, for abdominal pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.4,
      "end_seconds": 361.51,
      "duration_seconds": 1.11,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.76,
      "end_seconds": 391.91,
      "duration_seconds": 29.15,
      "text": "A CT scan of the abdomen is what I'd like next, for right iliac fossa tenderness. Even though you look fairly well, I'd like the surgeons to see you today. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you straight away."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.13,
      "end_seconds": 397.72,
      "duration_seconds": 4.59,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.03,
      "end_seconds": 401.19,
      "duration_seconds": 2.16,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.58,
      "end_seconds": 403.99,
      "duration_seconds": 1.41,
      "text": "Look after yourself."
    }
  ]
}