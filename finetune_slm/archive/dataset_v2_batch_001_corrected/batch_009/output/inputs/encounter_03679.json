{
  "schema_version": "1.0",
  "encounter_id": "03679",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.05,
      "duration_seconds": 3.19,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.69,
      "end_seconds": 9.77,
      "duration_seconds": 4.08,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.4,
      "end_seconds": 29.24,
      "duration_seconds": 16.84,
      "text": "I'm, I'm here because of a swollen calf after a long drive. A neighbour of mine said I should see someone about it. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.76,
      "end_seconds": 31.7,
      "duration_seconds": 1.94,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.4,
      "end_seconds": 34.34,
      "duration_seconds": 1.94,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.23,
      "end_seconds": 39.26,
      "duration_seconds": 3.03,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.41,
      "end_seconds": 48.68,
      "duration_seconds": 4.27,
      "text": "I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.67,
      "end_seconds": 51.46,
      "duration_seconds": 1.79,
      "text": "So, how about fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.34,
      "end_seconds": 55.16,
      "duration_seconds": 1.82,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.12,
      "end_seconds": 60.24,
      "duration_seconds": 3.12,
      "text": "Any cough or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.88,
      "end_seconds": 64.43,
      "duration_seconds": 2.55,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.74,
      "end_seconds": 68.25,
      "duration_seconds": 2.51,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.34,
      "end_seconds": 71.96,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.32,
      "end_seconds": 84.43,
      "duration_seconds": 4.11,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.64,
      "end_seconds": 87.14,
      "duration_seconds": 1.5,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.02,
      "end_seconds": 93.71,
      "duration_seconds": 4.69,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.6,
      "end_seconds": 99.8,
      "duration_seconds": 4.2,
      "text": "Escitalopram. I take it 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.61,
      "end_seconds": 103.37,
      "duration_seconds": 2.76,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.28,
      "end_seconds": 108.76,
      "duration_seconds": 4.48,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.24,
      "end_seconds": 112.93,
      "duration_seconds": 2.69,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.33,
      "end_seconds": 117.95,
      "duration_seconds": 3.62,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.05,
      "end_seconds": 129.68,
      "duration_seconds": 2.63,
      "text": "Alright, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.58,
      "end_seconds": 136.67,
      "duration_seconds": 5.09,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.64,
      "end_seconds": 140.0,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.86,
      "end_seconds": 150.82,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.51,
      "end_seconds": 183.3,
      "duration_seconds": 10.79,
      "text": "Okay: pulse is 126 beats a minute, respiratory rate 17, BP is 120 over 71, saturation 98 percent, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.48,
      "end_seconds": 188.48,
      "duration_seconds": 4.0,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.16,
      "end_seconds": 190.86,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.7,
      "end_seconds": 195.47,
      "duration_seconds": 2.77,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.85,
      "end_seconds": 220.33,
      "duration_seconds": 7.48,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.38,
      "end_seconds": 226.87,
      "duration_seconds": 2.49,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.77,
      "end_seconds": 247.85,
      "duration_seconds": 6.08,
      "text": "Okay, so my impression is this: I'd lean towards possible pulmonary embolism without chest pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.73,
      "end_seconds": 250.92,
      "duration_seconds": 2.19,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.63,
      "end_seconds": 271.92,
      "duration_seconds": 19.29,
      "text": "Nothing I've seen today points to an emergency. It looks like possible pulmonary embolism without chest pain, but I'd like to confirm. Stop me if I've got anything wrong. You've had a swollen calf after a long drive for ten days, and no cough or coughing up blood."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.11,
      "end_seconds": 276.72,
      "duration_seconds": 1.61,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.96,
      "end_seconds": 293.76,
      "duration_seconds": 9.8,
      "text": "I'm going to order a CT pulmonary angiogram, for possible embolus. A D-dimer is what I'd like next, for syncope and calf swelling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.03,
      "end_seconds": 297.4,
      "duration_seconds": 2.37,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.66,
      "end_seconds": 310.85,
      "duration_seconds": 12.19,
      "text": "Even without chest pain this needs a scan today, so please go to hospital. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.85,
      "end_seconds": 315.26,
      "duration_seconds": 2.41,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.89,
      "end_seconds": 328.61,
      "duration_seconds": 12.72,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Book a review straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.97,
      "end_seconds": 332.06,
      "duration_seconds": 2.09,
      "text": "Thank you, that's helpful."
    }
  ]
}