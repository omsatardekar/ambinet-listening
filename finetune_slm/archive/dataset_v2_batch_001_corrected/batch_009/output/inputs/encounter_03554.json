{
  "schema_version": "1.0",
  "encounter_id": "03554",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 6.24,
      "duration_seconds": 5.12,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.14,
      "end_seconds": 11.34,
      "duration_seconds": 4.2,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.27,
      "end_seconds": 17.74,
      "duration_seconds": 5.47,
      "text": "I've been feeling dizzy, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.6,
      "end_seconds": 23.5,
      "duration_seconds": 4.9,
      "text": "When did this begin? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.22,
      "end_seconds": 29.8,
      "duration_seconds": 4.58,
      "text": "Actually, it's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.29,
      "end_seconds": 35.13,
      "duration_seconds": 3.84,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.72,
      "end_seconds": 37.89,
      "duration_seconds": 1.17,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.66,
      "end_seconds": 42.25,
      "duration_seconds": 2.59,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 66.57,
      "duration_seconds": 23.56,
      "text": "I'd say once or twice a day. Well, as for whole family feeling flu-ish, I honestly can't say when that began. It might have been last month or the month before. As for whole family feeling flu-ish, about a three out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.24,
      "end_seconds": 72.49,
      "duration_seconds": 4.25,
      "text": "Have you been feeling dizzy at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.95,
      "end_seconds": 79.89,
      "duration_seconds": 5.94,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.86,
      "end_seconds": 87.23,
      "duration_seconds": 2.37,
      "text": "Did you get fever or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.62,
      "end_seconds": 95.3,
      "duration_seconds": 6.68,
      "text": "Sorry, what was I saying, I haven't had fever or rash, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.07,
      "end_seconds": 99.26,
      "duration_seconds": 3.19,
      "text": "Did you get cough or sore throat?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.35,
      "end_seconds": 105.6,
      "duration_seconds": 4.25,
      "text": "I haven't had cough or sore throat, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.87,
      "end_seconds": 109.1,
      "duration_seconds": 3.23,
      "text": "Okay, go on. Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.07,
      "end_seconds": 114.68,
      "duration_seconds": 4.61,
      "text": "Well, um, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.26,
      "end_seconds": 121.25,
      "duration_seconds": 4.99,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.89,
      "end_seconds": 128.23,
      "duration_seconds": 5.34,
      "text": "Actually, you know, I take escitalopram, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.58,
      "end_seconds": 135.04,
      "duration_seconds": 2.46,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.12,
      "end_seconds": 144.87,
      "duration_seconds": 4.75,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.67,
      "end_seconds": 148.42,
      "duration_seconds": 2.75,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.88,
      "end_seconds": 173.99,
      "duration_seconds": 19.11,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. I'm a plumber, lots of bending and kneeling. I do a yoga class on Thursdays. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.79,
      "end_seconds": 188.4,
      "duration_seconds": 4.61,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.26,
      "end_seconds": 192.57,
      "duration_seconds": 2.31,
      "text": "Anxiety, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.82,
      "end_seconds": 200.48,
      "duration_seconds": 6.66,
      "text": "Alright, anxiety, that matches what I have here. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.85,
      "end_seconds": 205.97,
      "duration_seconds": 4.12,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.29,
      "end_seconds": 221.11,
      "duration_seconds": 3.82,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.0,
      "end_seconds": 230.76,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.67,
      "end_seconds": 259.15,
      "duration_seconds": 9.48,
      "text": "Okay: temperature 36.5, pulse is 64 beats a minute, oxygen saturation is 98 percent, BP is 113 over 78."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.72,
      "end_seconds": 263.08,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.14,
      "end_seconds": 266.69,
      "duration_seconds": 2.55,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.44,
      "end_seconds": 273.26,
      "duration_seconds": 3.82,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.14,
      "end_seconds": 275.61,
      "duration_seconds": 1.47,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.23,
      "end_seconds": 296.56,
      "duration_seconds": 7.33,
      "text": "Your oxygen reading looks normal and the examination is normal, but I'm worried about the pattern."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.88,
      "end_seconds": 300.81,
      "duration_seconds": 1.93,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.4,
      "end_seconds": 333.78,
      "duration_seconds": 15.38,
      "text": "From what you've told me and what I found, this is probably possible carbon monoxide exposure at home. That's my thinking for now, and it may change as we learn more. Another possibility is a viral illness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.59,
      "end_seconds": 340.81,
      "duration_seconds": 5.22,
      "text": "Okay, so I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.94,
      "end_seconds": 355.8,
      "duration_seconds": 13.86,
      "text": "I can't promise yet, but most people with possible carbon monoxide exposure at home do well once it's treated properly. I'd like to arrange a carboxyhaemoglobin blood test for possible carbon monoxide exposure."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.59,
      "end_seconds": 359.54,
      "duration_seconds": 1.95,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.33,
      "end_seconds": 387.3,
      "duration_seconds": 25.97,
      "text": "Please don't use the boiler tonight and get it checked by an engineer, and keep a window open. The gas emergency service would be the right next step, I'll refer you. If you feel more dizzy or drowsy, that's the point to come in urgently. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.87,
      "end_seconds": 392.28,
      "duration_seconds": 3.41,
      "text": "Thank you, you know, that's helpful."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.56,
      "end_seconds": 394.98,
      "duration_seconds": 1.42,
      "text": "Look after yourself."
    }
  ]
}