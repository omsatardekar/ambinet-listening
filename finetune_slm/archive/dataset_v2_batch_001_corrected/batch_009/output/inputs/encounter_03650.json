{
  "schema_version": "1.0",
  "encounter_id": "03650",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.55,
      "duration_seconds": 4.17,
      "text": "Yeah, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.24,
      "duration_seconds": 3.89,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.16,
      "end_seconds": 24.21,
      "duration_seconds": 8.05,
      "text": "So the thing is, I've got breathlessness during sport. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.34,
      "end_seconds": 27.42,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.1,
      "end_seconds": 31.4,
      "duration_seconds": 3.3,
      "text": "I take iron tablets, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.41,
      "end_seconds": 42.65,
      "duration_seconds": 3.24,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.26,
      "end_seconds": 57.22,
      "duration_seconds": 12.96,
      "text": "About... well, three days. My family kept telling me to get it checked. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.38,
      "end_seconds": 64.01,
      "duration_seconds": 5.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.77,
      "end_seconds": 70.5,
      "duration_seconds": 5.73,
      "text": "It happens once or twice a day. Sport definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.36,
      "end_seconds": 76.53,
      "duration_seconds": 4.17,
      "text": "Alright, have you had a flutter now and then?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.02,
      "end_seconds": 81.24,
      "duration_seconds": 1.22,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 86.97,
      "duration_seconds": 5.19,
      "text": "Mm, okay. Okay, any fever, fainting or cough at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.96,
      "end_seconds": 89.96,
      "duration_seconds": 2.0,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.51,
      "end_seconds": 94.95,
      "duration_seconds": 3.44,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.95,
      "end_seconds": 98.54,
      "duration_seconds": 2.59,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.24,
      "end_seconds": 104.42,
      "duration_seconds": 4.18,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.09,
      "end_seconds": 107.08,
      "duration_seconds": 1.99,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.73,
      "end_seconds": 110.86,
      "duration_seconds": 3.13,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.41,
      "end_seconds": 122.38,
      "duration_seconds": 9.97,
      "text": "I've had low haemoglobin for five years now. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.51,
      "end_seconds": 132.56,
      "duration_seconds": 9.05,
      "text": "Alright, low haemoglobin, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.99,
      "end_seconds": 145.84,
      "duration_seconds": 11.85,
      "text": "Yes, I work in a bakery, early starts. I walk the dog every morning. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.82,
      "end_seconds": 151.44,
      "duration_seconds": 4.62,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.44,
      "end_seconds": 156.57,
      "duration_seconds": 3.13,
      "text": "Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 166.42,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.94,
      "end_seconds": 168.04,
      "duration_seconds": 1.1,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.65,
      "end_seconds": 173.02,
      "duration_seconds": 3.37,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.5,
      "end_seconds": 182.89,
      "duration_seconds": 2.39,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.91,
      "end_seconds": 211.17,
      "duration_seconds": 8.26,
      "text": "Okay: temperature is 36.5 degrees, pulse 66, oxygen saturation is 97 percent, pressure 109 over 72."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.85,
      "end_seconds": 213.46,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.23,
      "end_seconds": 216.82,
      "duration_seconds": 2.59,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.93,
      "end_seconds": 221.63,
      "duration_seconds": 2.7,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.4,
      "end_seconds": 224.73,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.28,
      "end_seconds": 248.95,
      "duration_seconds": 5.67,
      "text": "There is a harsh murmur that gets louder when you stand up."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.4,
      "end_seconds": 253.34,
      "duration_seconds": 1.94,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 273.88,
      "duration_seconds": 6.24,
      "text": "So, based on the history and the examination, this is probably possible hypertrophic cardiomyopathy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.88,
      "end_seconds": 292.02,
      "duration_seconds": 4.14,
      "text": "Let's book a heart monitor to look into palpitations."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.99,
      "end_seconds": 296.06,
      "duration_seconds": 2.07,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.69,
      "end_seconds": 316.55,
      "duration_seconds": 17.86,
      "text": "No competitive sport until the heart scan, and we will check your close family. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'll want another look after the scan."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.47,
      "end_seconds": 320.41,
      "duration_seconds": 1.94,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.9,
      "end_seconds": 324.61,
      "duration_seconds": 2.71,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.99,
      "end_seconds": 328.91,
      "duration_seconds": 2.92,
      "text": "I mean, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.04,
      "end_seconds": 331.33,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}