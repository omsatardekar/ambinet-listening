{
  "schema_version": "1.0",
  "encounter_id": "03664",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 5.1,
      "duration_seconds": 3.72,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 9.88,
      "duration_seconds": 3.82,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.54,
      "end_seconds": 14.5,
      "duration_seconds": 3.96,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.36,
      "end_seconds": 21.14,
      "duration_seconds": 3.78,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.26,
      "end_seconds": 26.0,
      "duration_seconds": 3.74,
      "text": "She's been having been feeling dizzy, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.7,
      "end_seconds": 30.19,
      "duration_seconds": 2.49,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.2,
      "end_seconds": 36.69,
      "duration_seconds": 4.49,
      "text": "Mirtazapine. I take it 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.24,
      "end_seconds": 42.81,
      "duration_seconds": 5.57,
      "text": "Mm, okay. Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.38,
      "end_seconds": 48.14,
      "duration_seconds": 3.76,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.0,
      "end_seconds": 51.98,
      "duration_seconds": 2.98,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.95,
      "end_seconds": 57.57,
      "duration_seconds": 4.62,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.53,
      "end_seconds": 61.6,
      "duration_seconds": 2.07,
      "text": "Has there been nausea too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.55,
      "end_seconds": 72.32,
      "duration_seconds": 9.77,
      "text": "Mm, yes. Oh, and the whole family feeling flu-ish. Um, with whole family feeling flu-ish, moderate, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.84,
      "end_seconds": 78.99,
      "duration_seconds": 6.15,
      "text": "Let me check a few things. Any sore throat, fever, rash or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.62,
      "end_seconds": 86.01,
      "duration_seconds": 5.39,
      "text": "No sore throat, fever, rash or cough, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.76,
      "end_seconds": 92.79,
      "duration_seconds": 2.03,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.85,
      "end_seconds": 96.92,
      "duration_seconds": 2.07,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.41,
      "end_seconds": 100.49,
      "duration_seconds": 2.08,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.95,
      "end_seconds": 107.36,
      "duration_seconds": 2.41,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.27,
      "end_seconds": 111.94,
      "duration_seconds": 2.67,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.95,
      "end_seconds": 127.21,
      "duration_seconds": 13.26,
      "text": "I'm a plumber, lots of bending and kneeling. No, I share a house with my brother. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.06,
      "end_seconds": 142.37,
      "duration_seconds": 4.31,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.18,
      "end_seconds": 147.45,
      "duration_seconds": 3.27,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.85,
      "end_seconds": 156.86,
      "duration_seconds": 4.01,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.12,
      "end_seconds": 159.27,
      "duration_seconds": 1.15,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.8,
      "end_seconds": 162.63,
      "duration_seconds": 2.83,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.35,
      "end_seconds": 169.49,
      "duration_seconds": 5.14,
      "text": "So, yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.51,
      "end_seconds": 174.35,
      "duration_seconds": 2.84,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.83,
      "end_seconds": 190.67,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.35,
      "end_seconds": 210.13,
      "duration_seconds": 7.78,
      "text": "Okay: temperature is 36.7 degrees, saturation 97 percent, heart rate 79. And pressure 117 over 79."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.47,
      "end_seconds": 215.35,
      "duration_seconds": 3.88,
      "text": "Hmm, um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.97,
      "end_seconds": 224.55,
      "duration_seconds": 3.58,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.71,
      "end_seconds": 228.97,
      "duration_seconds": 3.26,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.33,
      "end_seconds": 232.85,
      "duration_seconds": 2.52,
      "text": "Right, raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.46,
      "end_seconds": 259.41,
      "duration_seconds": 7.95,
      "text": "Your oxygen reading looks normal and the examination is normal, but I'm worried about the pattern."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.56,
      "end_seconds": 267.0,
      "duration_seconds": 2.44,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.14,
      "end_seconds": 291.44,
      "duration_seconds": 12.3,
      "text": "Putting it all together, I don't have a clear answer today: possible carbon monoxide exposure at home is possible, and so is a viral illness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.91,
      "end_seconds": 330.49,
      "duration_seconds": 22.58,
      "text": "I'm going to order a carboxyhaemoglobin blood test, for possible carbon monoxide exposure. Please don't use the boiler tonight and get it checked by an engineer, and keep a window open. Do get help quickly if you feel more dizzy or drowsy. I'd like you back tomorrow. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.23,
      "end_seconds": 332.85,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    }
  ]
}