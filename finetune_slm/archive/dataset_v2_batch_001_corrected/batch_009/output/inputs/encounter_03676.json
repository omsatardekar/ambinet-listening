{
  "schema_version": "1.0",
  "encounter_id": "03676",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 4.77,
      "duration_seconds": 4.27,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 9.81,
      "duration_seconds": 3.9,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.46,
      "end_seconds": 15.23,
      "duration_seconds": 3.77,
      "text": "So the thing is, I've got sore ankles."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.25,
      "end_seconds": 23.2,
      "duration_seconds": 2.95,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.66,
      "end_seconds": 26.95,
      "duration_seconds": 2.29,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.93,
      "end_seconds": 32.85,
      "duration_seconds": 2.92,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.0,
      "end_seconds": 36.41,
      "duration_seconds": 2.41,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.64,
      "end_seconds": 37.55,
      "duration_seconds": 0.91,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.15,
      "end_seconds": 58.67,
      "duration_seconds": 5.52,
      "text": "Have you noticed night sweats, weight loss, coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.75,
      "end_seconds": 67.23,
      "duration_seconds": 7.48,
      "text": "I haven't had night sweats, weight loss, coughing up blood or fever, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.16,
      "end_seconds": 74.61,
      "duration_seconds": 5.45,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.08,
      "end_seconds": 77.49,
      "duration_seconds": 1.41,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.27,
      "end_seconds": 81.18,
      "duration_seconds": 2.91,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 83.38,
      "duration_seconds": 1.45,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.82,
      "end_seconds": 101.81,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.45,
      "end_seconds": 107.4,
      "duration_seconds": 3.95,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.02,
      "end_seconds": 110.34,
      "duration_seconds": 1.32,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.81,
      "end_seconds": 115.66,
      "duration_seconds": 3.85,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.35,
      "end_seconds": 120.08,
      "duration_seconds": 2.73,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.67,
      "end_seconds": 124.8,
      "duration_seconds": 3.13,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.39,
      "end_seconds": 127.99,
      "duration_seconds": 2.6,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.79,
      "end_seconds": 132.97,
      "duration_seconds": 1.18,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.36,
      "end_seconds": 149.07,
      "duration_seconds": 2.71,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.71,
      "end_seconds": 156.41,
      "duration_seconds": 6.7,
      "text": "So, I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.45,
      "end_seconds": 176.16,
      "duration_seconds": 3.71,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.02,
      "end_seconds": 180.09,
      "duration_seconds": 2.07,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.67,
      "end_seconds": 183.4,
      "duration_seconds": 2.73,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.12,
      "end_seconds": 197.46,
      "duration_seconds": 2.34,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.37,
      "end_seconds": 226.88,
      "duration_seconds": 11.51,
      "text": "Okay: pulse is 81 beats a minute, oxygen saturation is 98 percent, blood pressure 120 over 82, respiratory rate 18, temperature 36.4."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.83,
      "end_seconds": 230.51,
      "duration_seconds": 1.68,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.18,
      "end_seconds": 235.71,
      "duration_seconds": 3.53,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.15,
      "end_seconds": 240.5,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.81,
      "end_seconds": 243.2,
      "duration_seconds": 1.39,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.92,
      "end_seconds": 261.6,
      "duration_seconds": 5.68,
      "text": "There are tender raised red nodules on both shins and your ankles are puffy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.57,
      "end_seconds": 272.72,
      "duration_seconds": 8.15,
      "text": "You can sit up now. So, based on the history and the examination, I'd lean towards possible sarcoidosis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.17,
      "end_seconds": 277.47,
      "duration_seconds": 3.3,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.39,
      "end_seconds": 296.91,
      "duration_seconds": 17.52,
      "text": "It's reasonable to be concerned, but right now possible sarcoidosis is my leading thought, not anything worse. Let me just check I've got this right. You've had sore ankles for one week, moderate, and no fever or coughing up blood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.1,
      "end_seconds": 300.1,
      "duration_seconds": 2.0,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.02,
      "end_seconds": 316.35,
      "duration_seconds": 14.33,
      "text": "I'd like to arrange a chest X-ray for cough and erythema nodosum. See me again after the tests. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.64,
      "end_seconds": 319.85,
      "duration_seconds": 2.21,
      "text": "Alright, thanks, take care."
    }
  ]
}