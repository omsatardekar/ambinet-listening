{
  "schema_version": "1.0",
  "encounter_id": "03559",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.36,
      "duration_seconds": 4.5,
      "text": "Well, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 11.93,
      "duration_seconds": 4.53,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.94,
      "end_seconds": 20.32,
      "duration_seconds": 6.38,
      "text": "Doctor, uh, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.41,
      "end_seconds": 37.32,
      "duration_seconds": 15.91,
      "text": "Well, I've been having a bit of stiffness in my knee replacement. I thought it would sort itself out, but it hasn't. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.49,
      "end_seconds": 41.84,
      "duration_seconds": 3.35,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.01,
      "end_seconds": 51.23,
      "duration_seconds": 8.22,
      "text": "Uh, it's been about a month now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.81,
      "end_seconds": 57.89,
      "duration_seconds": 2.08,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.07,
      "end_seconds": 69.91,
      "duration_seconds": 10.84,
      "text": "It, It usually comes with slight warmth. The slight warmth? That's been since yesterday. I've also been feeling tired, since Friday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.71,
      "end_seconds": 75.95,
      "duration_seconds": 4.24,
      "text": "Did you get severe pain, high fever or recent injury?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.9,
      "end_seconds": 83.55,
      "duration_seconds": 5.65,
      "text": "Sorry, what was I saying, no, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.8,
      "end_seconds": 85.74,
      "duration_seconds": 1.94,
      "text": "Sure. Any wound discharge?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.02,
      "end_seconds": 90.36,
      "duration_seconds": 3.34,
      "text": "Not at all, no wound discharge."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.04,
      "end_seconds": 94.98,
      "duration_seconds": 2.94,
      "text": "Okay, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.82,
      "end_seconds": 98.75,
      "duration_seconds": 1.93,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.0,
      "end_seconds": 103.46,
      "duration_seconds": 3.46,
      "text": "Right, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.3,
      "end_seconds": 109.59,
      "duration_seconds": 4.29,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.35,
      "end_seconds": 113.17,
      "duration_seconds": 2.82,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.1,
      "end_seconds": 119.3,
      "duration_seconds": 5.2,
      "text": "I've, I've had diabetes for about ten years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.05,
      "end_seconds": 137.23,
      "duration_seconds": 12.18,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today. So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.88,
      "end_seconds": 140.84,
      "duration_seconds": 2.96,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.08,
      "end_seconds": 145.26,
      "duration_seconds": 3.18,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.91,
      "end_seconds": 149.53,
      "duration_seconds": 2.62,
      "text": "Nothing regular, um, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.65,
      "end_seconds": 151.54,
      "duration_seconds": 0.89,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.33,
      "end_seconds": 157.14,
      "duration_seconds": 3.81,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.11,
      "end_seconds": 161.94,
      "duration_seconds": 2.83,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.78,
      "end_seconds": 167.2,
      "duration_seconds": 3.42,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.01,
      "end_seconds": 171.74,
      "duration_seconds": 2.73,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.75,
      "end_seconds": 176.49,
      "duration_seconds": 2.74,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.93,
      "end_seconds": 190.81,
      "duration_seconds": 2.88,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.29,
      "end_seconds": 199.77,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.5,
      "end_seconds": 219.15,
      "duration_seconds": 7.65,
      "text": "Okay: SpO2 97 percent on room air, blood pressure 122 over 81, pulse 71. And temperature 37.0."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.28,
      "end_seconds": 222.53,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.42,
      "end_seconds": 226.71,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.73,
      "end_seconds": 233.12,
      "duration_seconds": 4.39,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.62,
      "end_seconds": 237.07,
      "duration_seconds": 2.45,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.57,
      "end_seconds": 260.11,
      "duration_seconds": 6.54,
      "text": "The knee is mildly warm with a small effusion and the replacement scar is clean."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.92,
      "end_seconds": 267.95,
      "duration_seconds": 3.03,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.1,
      "end_seconds": 314.26,
      "duration_seconds": 37.16,
      "text": "Having listened and examined, I'd lean towards a possible low-grade infection of the knee replacement. Blood tests is what I'd like next, for possible prosthetic infection. The result will help us decide whether anything more is needed. I think a joint aspiration makes sense here, for warm effusion. Even without a fever, an infected replacement is serious, so the orthopaedic team will see you. Let's get you seen by the orthopaedic team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.34,
      "end_seconds": 328.53,
      "duration_seconds": 8.19,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.8,
      "end_seconds": 331.53,
      "duration_seconds": 1.73,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.2,
      "end_seconds": 339.64,
      "duration_seconds": 7.44,
      "text": "Book a review within two days. Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.77,
      "end_seconds": 343.87,
      "duration_seconds": 3.1,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.57,
      "end_seconds": 345.77,
      "duration_seconds": 1.2,
      "text": "Look after yourself."
    }
  ]
}