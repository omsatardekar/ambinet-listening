{
  "schema_version": "1.0",
  "encounter_id": "03684",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.22,
      "end_seconds": 7.02,
      "duration_seconds": 5.8,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 11.13,
      "duration_seconds": 3.36,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.75,
      "end_seconds": 18.09,
      "duration_seconds": 5.34,
      "text": "Yeah, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.48,
      "end_seconds": 23.13,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.65,
      "end_seconds": 29.6,
      "duration_seconds": 4.95,
      "text": "Doctor, it's being very thirsty. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.19,
      "end_seconds": 34.71,
      "duration_seconds": 3.52,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.44,
      "end_seconds": 40.67,
      "duration_seconds": 5.23,
      "text": "Febuxostat. I take it once a day for the gout."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.31,
      "end_seconds": 43.31,
      "duration_seconds": 2.0,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.12,
      "end_seconds": 50.35,
      "duration_seconds": 5.23,
      "text": "80 milligrams. Telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.22,
      "end_seconds": 54.25,
      "duration_seconds": 3.03,
      "text": "Right, when did you start it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.05,
      "end_seconds": 65.7,
      "duration_seconds": 9.65,
      "text": "About six months. Sorry, what was I saying, it's atorvastatin, 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.12,
      "end_seconds": 70.4,
      "duration_seconds": 3.28,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.8,
      "end_seconds": 80.54,
      "duration_seconds": 8.74,
      "text": "Not with me. I'll bring it next time. I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.28,
      "end_seconds": 85.83,
      "duration_seconds": 4.55,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 87.61,
      "end_seconds": 90.74,
      "duration_seconds": 3.13,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.89,
      "end_seconds": 95.87,
      "duration_seconds": 3.98,
      "text": "Right, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 103.14,
      "duration_seconds": 3.8,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.66,
      "end_seconds": 112.67,
      "duration_seconds": 9.01,
      "text": "Let me think, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.77,
      "end_seconds": 117.77,
      "duration_seconds": 5.0,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.16,
      "end_seconds": 123.54,
      "duration_seconds": 4.38,
      "text": "I was getting to that! Oh, and nausea."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.33,
      "end_seconds": 127.55,
      "duration_seconds": 3.22,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.34,
      "end_seconds": 129.39,
      "duration_seconds": 1.05,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.83,
      "end_seconds": 136.12,
      "duration_seconds": 5.29,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 137.92,
      "end_seconds": 139.91,
      "duration_seconds": 1.99,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.89,
      "end_seconds": 148.25,
      "duration_seconds": 6.36,
      "text": "Have you had being very thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 151.59,
      "end_seconds": 156.6,
      "duration_seconds": 5.01,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.51,
      "end_seconds": 162.3,
      "duration_seconds": 3.79,
      "text": "Have you had sore throat, by any chance?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 162.89,
      "end_seconds": 165.12,
      "duration_seconds": 2.23,
      "text": "No sore throat, thankfully."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.21,
      "end_seconds": 170.08,
      "duration_seconds": 2.87,
      "text": "Did you get diarrhoea, cough or fever?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 171.66,
      "end_seconds": 182.53,
      "duration_seconds": 10.87,
      "text": "No, no diarrhoea, no cough, no fever. I was losing weight at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.73,
      "end_seconds": 186.27,
      "duration_seconds": 2.54,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.43,
      "end_seconds": 193.43,
      "duration_seconds": 3.0,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.48,
      "end_seconds": 205.98,
      "duration_seconds": 4.5,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.61,
      "end_seconds": 212.75,
      "duration_seconds": 5.14,
      "text": "Um, um, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.89,
      "end_seconds": 215.09,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.12,
      "end_seconds": 220.9,
      "duration_seconds": 3.78,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.21,
      "end_seconds": 223.14,
      "duration_seconds": 0.93,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.51,
      "end_seconds": 227.87,
      "duration_seconds": 3.36,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.64,
      "end_seconds": 231.16,
      "duration_seconds": 2.52,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.82,
      "end_seconds": 236.61,
      "duration_seconds": 3.79,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.27,
      "end_seconds": 239.53,
      "duration_seconds": 2.26,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.53,
      "end_seconds": 245.98,
      "duration_seconds": 4.45,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 250.85,
      "duration_seconds": 4.26,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 252.56,
      "end_seconds": 254.7,
      "duration_seconds": 2.14,
      "text": "I, I have gout."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.41,
      "end_seconds": 257.93,
      "duration_seconds": 1.52,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 259.3,
      "end_seconds": 264.52,
      "duration_seconds": 5.22,
      "text": "I've had high blood pressure, yes. I've got high cholesterol."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.46,
      "end_seconds": 268.03,
      "duration_seconds": 2.57,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.76,
      "end_seconds": 270.9,
      "duration_seconds": 2.14,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.73,
      "end_seconds": 280.85,
      "duration_seconds": 9.12,
      "text": "Yes, high cholesterol is known to us, good to have that clear. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.93,
      "end_seconds": 287.42,
      "duration_seconds": 4.49,
      "text": "Uh, my grandmother had dementia. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 301.61,
      "end_seconds": 317.39,
      "duration_seconds": 15.78,
      "text": "Here are the numbers, doctor. Blood pressure 117 over 79, BMI works out to 32.0. Height 164 centimetres, temperature 36.9, oxygen saturation is 96 percent, pulse is 107 beats a minute, weight 86 kilos."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.22,
      "end_seconds": 319.2,
      "duration_seconds": 0.98,
      "text": "Alright, thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.27,
      "end_seconds": 322.87,
      "duration_seconds": 2.6,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 323.85,
      "end_seconds": 324.82,
      "duration_seconds": 0.97,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.8,
      "end_seconds": 329.44,
      "duration_seconds": 2.64,
      "text": "So, tell me if that's sore."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.23,
      "end_seconds": 345.48,
      "duration_seconds": 5.25,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.21,
      "end_seconds": 363.83,
      "duration_seconds": 15.62,
      "text": "Good, you can sit up again. Okay, so my impression is this: I'm honestly not certain yet. It could be possible new type 1 diabetes starting to turn acidic, or it might be a viral illness."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 364.48,
      "end_seconds": 367.37,
      "duration_seconds": 2.89,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.44,
      "end_seconds": 384.21,
      "duration_seconds": 15.77,
      "text": "It's reasonable to be concerned, but right now possible new type 1 diabetes starting to turn acidic is my leading thought, not anything worse. I'm going to order blood tests, for possible ketoacidosis."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 385.9,
      "end_seconds": 392.42,
      "duration_seconds": 6.52,
      "text": "Doctor, I did a finger-prick glucose and ketones before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.12,
      "end_seconds": 416.23,
      "duration_seconds": 22.11,
      "text": "Great, that's useful. This is not flu, your sugar is very high, and you need hospital insulin today. A short walk every day, even twenty minutes, will help more than you'd think. I'd like you to see the diabetes team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 418.17,
      "end_seconds": 419.98,
      "duration_seconds": 1.81,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.9,
      "end_seconds": 436.36,
      "duration_seconds": 15.46,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.94,
      "end_seconds": 441.41,
      "duration_seconds": 4.47,
      "text": "Good, you know, thanks, I'll see you then."
    }
  ]
}