{
  "schema_version": "1.0",
  "encounter_id": "03658",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 6.51,
      "duration_seconds": 5.22,
      "text": "Well, you know, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.47,
      "end_seconds": 14.06,
      "duration_seconds": 5.59,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.14,
      "end_seconds": 23.95,
      "duration_seconds": 7.81,
      "text": "Honestly, it's an ache in my jaw, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.02,
      "end_seconds": 28.45,
      "duration_seconds": 3.43,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.11,
      "end_seconds": 33.15,
      "duration_seconds": 3.04,
      "text": "It's been three weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.86,
      "end_seconds": 39.99,
      "duration_seconds": 5.13,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.13,
      "end_seconds": 61.86,
      "duration_seconds": 16.73,
      "text": "Hmm, uh, maybe a three out of ten on a bad day. I'd say a couple of times a week. Oh, and I've been sweating as well, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.58,
      "end_seconds": 68.65,
      "duration_seconds": 5.07,
      "text": "And what about crushing chest pain, fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.59,
      "end_seconds": 72.97,
      "duration_seconds": 2.38,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.9,
      "end_seconds": 76.13,
      "duration_seconds": 2.23,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.45,
      "end_seconds": 79.86,
      "duration_seconds": 2.41,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.98,
      "end_seconds": 91.85,
      "duration_seconds": 3.87,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.71,
      "end_seconds": 100.26,
      "duration_seconds": 7.55,
      "text": "Glibenclamide, 5 milligrams, before breakfast. I take antacid liquid, 10 ml, when needed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.09,
      "end_seconds": 103.03,
      "duration_seconds": 1.94,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.97,
      "end_seconds": 108.47,
      "duration_seconds": 4.5,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.55,
      "end_seconds": 113.29,
      "duration_seconds": 2.74,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.93,
      "end_seconds": 118.18,
      "duration_seconds": 3.25,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.4,
      "end_seconds": 120.62,
      "duration_seconds": 1.22,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.13,
      "end_seconds": 125.38,
      "duration_seconds": 3.25,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.58,
      "end_seconds": 142.3,
      "duration_seconds": 3.72,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.21,
      "end_seconds": 154.69,
      "duration_seconds": 10.48,
      "text": "Um, I have diabetes. I told my wife I'd come today. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.14,
      "end_seconds": 166.18,
      "duration_seconds": 10.04,
      "text": "Yes, diabetes is known to us, good to have that clear. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.03,
      "end_seconds": 169.49,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.09,
      "end_seconds": 187.96,
      "duration_seconds": 2.87,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 199.41,
      "duration_seconds": 2.18,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.99,
      "end_seconds": 223.19,
      "duration_seconds": 14.2,
      "text": "Okay: heart rate 105, BMI works out to 36.2, temp 36.6 degrees. And weight 88 kilos, oxygen saturation is 97 percent, pressure 119 over 80, height 156 centimetres."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.5,
      "end_seconds": 225.96,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.28,
      "end_seconds": 232.43,
      "duration_seconds": 2.15,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.83,
      "end_seconds": 237.6,
      "duration_seconds": 3.77,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.97,
      "end_seconds": 240.69,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.01,
      "end_seconds": 264.06,
      "duration_seconds": 7.05,
      "text": "Your heart sounds are normal and your tummy is soft, but your pulse is a little fast."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.29,
      "end_seconds": 276.81,
      "duration_seconds": 7.52,
      "text": "You can relax now. Putting it all together, it points towards possible heart attack despite no classic chest pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.6,
      "end_seconds": 282.23,
      "duration_seconds": 3.63,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.33,
      "end_seconds": 298.4,
      "duration_seconds": 15.07,
      "text": "I can't promise yet, but most people with possible heart attack despite no classic chest pain do well once it's treated properly. I want a troponin test done, that's for possible heart attack."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 299.94,
      "end_seconds": 303.98,
      "duration_seconds": 4.04,
      "text": "I can book that for Wednesday at 10 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.0,
      "end_seconds": 310.72,
      "duration_seconds": 4.72,
      "text": "We should do an ECG for jaw pain and fatigue."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.62,
      "end_seconds": 318.87,
      "duration_seconds": 2.25,
      "text": "Right, you know, understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.18,
      "end_seconds": 348.69,
      "duration_seconds": 28.51,
      "text": "I'd like you to take aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. Diabetes can hide the usual pain, so I am treating this as a heart problem until proven otherwise. Cut down on salt and fried food for now, it really does make a difference. The cardiology team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.72,
      "end_seconds": 354.59,
      "duration_seconds": 3.87,
      "text": "Um, sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.93,
      "end_seconds": 367.86,
      "duration_seconds": 11.93,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.89,
      "end_seconds": 373.01,
      "duration_seconds": 4.12,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.22,
      "end_seconds": 378.44,
      "duration_seconds": 1.22,
      "text": "Take care now."
    }
  ]
}