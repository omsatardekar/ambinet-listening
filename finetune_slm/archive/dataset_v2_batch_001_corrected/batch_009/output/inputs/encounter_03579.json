{
  "schema_version": "1.0",
  "encounter_id": "03579",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.03,
      "duration_seconds": 4.81,
      "text": "Hi, um, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 12.0,
      "duration_seconds": 3.94,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.64,
      "end_seconds": 16.4,
      "duration_seconds": 3.76,
      "text": "I'm here because of a vague tummy ache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.98,
      "end_seconds": 18.43,
      "duration_seconds": 1.45,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.7,
      "end_seconds": 23.19,
      "duration_seconds": 3.49,
      "text": "Right, I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.86,
      "end_seconds": 40.18,
      "duration_seconds": 4.32,
      "text": "Have you noticed urinary symptoms, high fever or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.59,
      "end_seconds": 47.15,
      "duration_seconds": 5.56,
      "text": "No urinary symptoms, high fever or vomiting, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.42,
      "end_seconds": 51.77,
      "duration_seconds": 4.35,
      "text": "Understood. Okay, have you had any blood in the stool?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.55,
      "end_seconds": 56.5,
      "duration_seconds": 3.95,
      "text": "Not at all, no blood in the stool."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.82,
      "end_seconds": 65.25,
      "duration_seconds": 2.43,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.59,
      "end_seconds": 68.99,
      "duration_seconds": 2.4,
      "text": "So, no problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.5,
      "end_seconds": 73.02,
      "duration_seconds": 2.52,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.78,
      "end_seconds": 74.88,
      "duration_seconds": 1.1,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.52,
      "end_seconds": 79.94,
      "duration_seconds": 4.42,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.86,
      "end_seconds": 87.88,
      "duration_seconds": 3.02,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.17,
      "end_seconds": 91.56,
      "duration_seconds": 2.39,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.44,
      "end_seconds": 96.61,
      "duration_seconds": 4.17,
      "text": "Okay, so nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.89,
      "end_seconds": 116.45,
      "duration_seconds": 3.56,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.97,
      "end_seconds": 122.7,
      "duration_seconds": 4.73,
      "text": "Um, um, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.56,
      "end_seconds": 124.94,
      "duration_seconds": 1.38,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.32,
      "end_seconds": 129.59,
      "duration_seconds": 3.27,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.53,
      "end_seconds": 135.63,
      "duration_seconds": 2.1,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.49,
      "end_seconds": 138.28,
      "duration_seconds": 1.79,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.79,
      "end_seconds": 142.09,
      "duration_seconds": 3.3,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.84,
      "end_seconds": 147.51,
      "duration_seconds": 3.67,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.74,
      "end_seconds": 150.8,
      "duration_seconds": 2.06,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.68,
      "end_seconds": 154.32,
      "duration_seconds": 2.64,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.17,
      "end_seconds": 158.83,
      "duration_seconds": 3.66,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.66,
      "end_seconds": 164.29,
      "duration_seconds": 3.63,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.96,
      "end_seconds": 168.41,
      "duration_seconds": 3.45,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.38,
      "end_seconds": 182.88,
      "duration_seconds": 2.5,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.56,
      "end_seconds": 209.39,
      "duration_seconds": 6.83,
      "text": "Okay: heart rate 81, SpO2 98 percent on room air, BP is 118 over 73."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.01,
      "end_seconds": 216.24,
      "duration_seconds": 4.23,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.93,
      "end_seconds": 220.46,
      "duration_seconds": 2.53,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.29,
      "end_seconds": 241.14,
      "duration_seconds": 8.85,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.67,
      "end_seconds": 248.35,
      "duration_seconds": 1.68,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.28,
      "end_seconds": 266.98,
      "duration_seconds": 3.7,
      "text": "We should do blood tests for abdominal pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.0,
      "end_seconds": 270.54,
      "duration_seconds": 1.54,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.3,
      "end_seconds": 288.65,
      "duration_seconds": 16.35,
      "text": "We should do a CT scan of the abdomen for right iliac fossa tenderness. Even though you look fairly well, I'd like the surgeons to see you today. I think the surgical team should see you too."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.22,
      "end_seconds": 291.92,
      "duration_seconds": 1.7,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.45,
      "end_seconds": 310.62,
      "duration_seconds": 18.17,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.31,
      "end_seconds": 317.5,
      "duration_seconds": 5.19,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.06,
      "end_seconds": 323.33,
      "duration_seconds": 4.27,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.87,
      "end_seconds": 327.77,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.51,
      "end_seconds": 330.4,
      "duration_seconds": 1.89,
      "text": "Have a good day."
    }
  ]
}