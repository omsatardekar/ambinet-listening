{
  "schema_version": "1.0",
  "encounter_id": "03553",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 6.35,
      "duration_seconds": 5.02,
      "text": "Afternoon, thanks for coming in. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.06,
      "end_seconds": 11.12,
      "duration_seconds": 4.06,
      "text": "It's a faint rash on the chest, mostly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.77,
      "end_seconds": 16.29,
      "duration_seconds": 3.52,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.64,
      "end_seconds": 20.93,
      "duration_seconds": 3.29,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.34,
      "end_seconds": 25.08,
      "duration_seconds": 2.74,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.35,
      "end_seconds": 32.59,
      "duration_seconds": 1.24,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.03,
      "end_seconds": 37.1,
      "duration_seconds": 3.07,
      "text": "Okay, have you had a sore throat?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.91,
      "end_seconds": 46.82,
      "duration_seconds": 7.91,
      "text": "Yes, about the same, three days. As for sore throat, I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.89,
      "end_seconds": 50.32,
      "duration_seconds": 2.43,
      "text": "Have you had mouth ulcers?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.15,
      "end_seconds": 53.96,
      "duration_seconds": 1.81,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.62,
      "end_seconds": 60.12,
      "duration_seconds": 5.5,
      "text": "And what about stiff neck, recent tick bite, diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.09,
      "end_seconds": 68.28,
      "duration_seconds": 6.19,
      "text": "No stiff neck, recent tick bite, diarrhoea or cough, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 75.09,
      "duration_seconds": 2.37,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.24,
      "end_seconds": 78.26,
      "duration_seconds": 2.02,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.16,
      "end_seconds": 85.24,
      "duration_seconds": 5.08,
      "text": "Okay, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.23,
      "end_seconds": 89.37,
      "duration_seconds": 2.14,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.15,
      "end_seconds": 110.7,
      "duration_seconds": 3.55,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.45,
      "end_seconds": 120.06,
      "duration_seconds": 3.61,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.36,
      "end_seconds": 136.83,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.12,
      "end_seconds": 140.95,
      "duration_seconds": 2.83,
      "text": "I take febuxostat, once a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.02,
      "end_seconds": 144.23,
      "duration_seconds": 2.21,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.69,
      "end_seconds": 147.1,
      "duration_seconds": 1.41,
      "text": "It's 80 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.62,
      "end_seconds": 149.6,
      "duration_seconds": 1.98,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.53,
      "end_seconds": 154.48,
      "duration_seconds": 3.95,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.04,
      "end_seconds": 160.59,
      "duration_seconds": 4.55,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.28,
      "end_seconds": 180.39,
      "duration_seconds": 19.11,
      "text": "I only drink at family occasions. I quit smoking around ten years ago. Lots of rice, lentils and some fruit. I hardly move around during the day. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.71,
      "end_seconds": 184.86,
      "duration_seconds": 3.15,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.73,
      "end_seconds": 192.1,
      "duration_seconds": 5.37,
      "text": "I've got arthritis in my knees. I've had gout, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 193.03,
      "end_seconds": 201.31,
      "duration_seconds": 8.28,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 95 percent, pressure 117 over 66, pulse is 96 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.27,
      "end_seconds": 202.97,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.11,
      "end_seconds": 208.65,
      "duration_seconds": 4.54,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.3,
      "end_seconds": 212.34,
      "duration_seconds": 2.04,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.09,
      "end_seconds": 232.56,
      "duration_seconds": 7.47,
      "text": "There are small mouth ulcers, tender neck glands and a faint pink rash on the chest."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 238.81,
      "duration_seconds": 2.48,
      "text": "Right, you can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.11,
      "end_seconds": 269.81,
      "duration_seconds": 19.7,
      "text": "So, based on the history and the examination, this is probably an acute viral illness, possibly early HIV infection. I want to be honest that this is an impression, not a final answer. I'm sending you for a glandular fever test because of sore throat and glands."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.42,
      "end_seconds": 274.94,
      "duration_seconds": 1.52,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.31,
      "end_seconds": 304.74,
      "duration_seconds": 24.43,
      "text": "I'm offering an HIV test with every illness like this, it's routine, and results are confidential. If it hasn't settled in two weeks, we'd think about a fourth-generation HIV test, but not now. Do get help quickly if the symptoms get worse. Let's plan a check after the results."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.65,
      "end_seconds": 306.35,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.47,
      "end_seconds": 310.43,
      "duration_seconds": 2.96,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.65,
      "end_seconds": 314.74,
      "duration_seconds": 3.09,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.4,
      "end_seconds": 317.01,
      "duration_seconds": 1.61,
      "text": "Have a good day."
    }
  ]
}