{
  "schema_version": "1.0",
  "encounter_id": "03610",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.1,
      "duration_seconds": 3.36,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 8.63,
      "duration_seconds": 3.62,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.14,
      "end_seconds": 25.32,
      "duration_seconds": 15.18,
      "text": "I've been dealing with no symptoms. I'd rather not end up on lots of tablets if I can avoid it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.99,
      "end_seconds": 28.95,
      "duration_seconds": 2.96,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.71,
      "end_seconds": 37.53,
      "duration_seconds": 7.82,
      "text": "About... well, three days. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.18,
      "end_seconds": 42.16,
      "duration_seconds": 2.98,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.23,
      "end_seconds": 49.67,
      "duration_seconds": 6.44,
      "text": "It's moderate, honestly. And there's slightly tired as well, about four days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.31,
      "end_seconds": 56.16,
      "duration_seconds": 5.85,
      "text": "Have you had no symptoms before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.56,
      "end_seconds": 63.46,
      "duration_seconds": 5.9,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 69.8,
      "duration_seconds": 5.65,
      "text": "A few quick ones: black stools, heavy periods or blood in the stool?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.31,
      "end_seconds": 76.66,
      "duration_seconds": 6.35,
      "text": "No, you know, no black stools, heavy periods or blood in the stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.39,
      "end_seconds": 80.22,
      "duration_seconds": 1.83,
      "text": "What about weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.96,
      "end_seconds": 85.38,
      "duration_seconds": 3.42,
      "text": "No, I haven't had any weight loss."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 88.59,
      "duration_seconds": 1.6,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.62,
      "end_seconds": 90.61,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.86,
      "end_seconds": 106.62,
      "duration_seconds": 2.76,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.43,
      "end_seconds": 110.62,
      "duration_seconds": 3.19,
      "text": "Mm, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.93,
      "end_seconds": 123.27,
      "duration_seconds": 4.34,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.81,
      "end_seconds": 132.8,
      "duration_seconds": 8.99,
      "text": "It's aspirin, 75 milligrams, once a day. Allopurinol. I take it 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.28,
      "end_seconds": 150.15,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.81,
      "end_seconds": 155.16,
      "duration_seconds": 4.35,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.46,
      "end_seconds": 158.42,
      "duration_seconds": 1.96,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.13,
      "end_seconds": 165.2,
      "duration_seconds": 5.07,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.01,
      "end_seconds": 167.75,
      "duration_seconds": 1.74,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.96,
      "end_seconds": 173.1,
      "duration_seconds": 4.14,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.9,
      "end_seconds": 177.43,
      "duration_seconds": 2.53,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.37,
      "end_seconds": 182.85,
      "duration_seconds": 3.48,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.69,
      "end_seconds": 186.67,
      "duration_seconds": 2.98,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.36,
      "end_seconds": 190.7,
      "duration_seconds": 3.34,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.29,
      "end_seconds": 193.57,
      "duration_seconds": 2.28,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.54,
      "end_seconds": 206.23,
      "duration_seconds": 10.69,
      "text": "Just two stents put in my heart, three years ago. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.79,
      "end_seconds": 215.41,
      "duration_seconds": 6.62,
      "text": "Do you have any chronic illnesses? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.04,
      "end_seconds": 223.82,
      "duration_seconds": 7.78,
      "text": "I've had heart disease for five years now. I have gout, for about ten years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.43,
      "end_seconds": 234.78,
      "duration_seconds": 10.35,
      "text": "Mm-hmm. Yes, gout is known to us, good to have that clear. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.8,
      "end_seconds": 250.15,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.32,
      "end_seconds": 267.72,
      "duration_seconds": 7.4,
      "text": "Okay: temperature 36.9, pulse is 80 beats a minute, BP is 112 over 73, respiratory rate 16."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.08,
      "end_seconds": 275.33,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.86,
      "end_seconds": 279.38,
      "duration_seconds": 2.52,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.19,
      "end_seconds": 284.91,
      "duration_seconds": 2.72,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.14,
      "end_seconds": 288.24,
      "duration_seconds": 2.1,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.47,
      "end_seconds": 304.61,
      "duration_seconds": 5.14,
      "text": "Your pulse and blood pressure are normal, and the eyelids are pale."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.94,
      "end_seconds": 317.26,
      "duration_seconds": 9.32,
      "text": "You can sit up now. Okay, thinking it through, the most likely explanation is iron-deficiency anaemia needing a source found."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.82,
      "end_seconds": 322.12,
      "duration_seconds": 3.3,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.42,
      "end_seconds": 358.47,
      "duration_seconds": 35.05,
      "text": "It's reasonable to be concerned, but right now iron-deficiency anaemia needing a source found is my leading thought, not anything worse. Let's book a coeliac blood test to look into anaemia. Let's book an iron study to look into anaemia. I'm going to order a camera test of the stomach and bowel, for iron-deficiency anaemia. What I'm giving you is ferrous sulfate, 200 milligrams, once a day, three months. It's for iron deficiency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.45,
      "end_seconds": 369.89,
      "duration_seconds": 9.44,
      "text": "Stop the ibuprofen and we will refer you for scopes. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.68,
      "end_seconds": 374.43,
      "duration_seconds": 2.75,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.98,
      "end_seconds": 377.44,
      "duration_seconds": 2.46,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.44,
      "end_seconds": 382.21,
      "duration_seconds": 2.77,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.07,
      "end_seconds": 386.05,
      "duration_seconds": 1.98,
      "text": "Right, see you soon."
    }
  ]
}