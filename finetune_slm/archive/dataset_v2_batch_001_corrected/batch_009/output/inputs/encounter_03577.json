{
  "schema_version": "1.0",
  "encounter_id": "03577",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 3.35,
      "duration_seconds": 2.81,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.85,
      "end_seconds": 8.51,
      "duration_seconds": 3.66,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.34,
      "end_seconds": 21.24,
      "duration_seconds": 7.9,
      "text": "I've, I've been feeling flat and slowed down, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.61,
      "end_seconds": 25.85,
      "duration_seconds": 3.24,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.67,
      "end_seconds": 29.02,
      "duration_seconds": 2.35,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.26,
      "end_seconds": 32.5,
      "duration_seconds": 3.24,
      "text": "Ah. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.26,
      "end_seconds": 36.55,
      "duration_seconds": 3.29,
      "text": "It, It feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.52,
      "end_seconds": 41.57,
      "duration_seconds": 4.05,
      "text": "Have you had any hearing voices or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.22,
      "end_seconds": 45.81,
      "duration_seconds": 2.59,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.17,
      "end_seconds": 50.03,
      "duration_seconds": 2.86,
      "text": "Any thoughts of harming myself or palpitations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.4,
      "end_seconds": 58.57,
      "duration_seconds": 7.17,
      "text": "I mean, uh, I haven't had thoughts of harming myself or palpitations, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.34,
      "end_seconds": 64.17,
      "duration_seconds": 3.83,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.16,
      "end_seconds": 67.57,
      "duration_seconds": 2.41,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.24,
      "end_seconds": 74.12,
      "duration_seconds": 3.88,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.96,
      "end_seconds": 78.34,
      "duration_seconds": 3.38,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.11,
      "end_seconds": 80.88,
      "duration_seconds": 1.77,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.5,
      "end_seconds": 84.27,
      "duration_seconds": 2.77,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.2,
      "end_seconds": 92.76,
      "duration_seconds": 6.56,
      "text": "Before we go further, any allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.95,
      "end_seconds": 102.8,
      "duration_seconds": 3.85,
      "text": "Not to my knowledge, you know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 107.8,
      "duration_seconds": 3.14,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.89,
      "end_seconds": 115.53,
      "duration_seconds": 6.64,
      "text": "I've had thin bones, yes. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.62,
      "end_seconds": 134.37,
      "duration_seconds": 4.75,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.94,
      "end_seconds": 139.0,
      "duration_seconds": 3.06,
      "text": "Alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 143.04,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.99,
      "end_seconds": 153.4,
      "duration_seconds": 2.41,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.26,
      "end_seconds": 183.23,
      "duration_seconds": 10.97,
      "text": "Okay: pulse is 83 beats a minute, pressure 116 over 73, oxygen saturation is 99 percent, respiratory rate 17, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.78,
      "end_seconds": 189.58,
      "duration_seconds": 4.8,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.82,
      "end_seconds": 192.25,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.33,
      "end_seconds": 214.5,
      "duration_seconds": 4.17,
      "text": "Your pulse is slow and your reflexes relax slowly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.43,
      "end_seconds": 220.23,
      "duration_seconds": 2.8,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.51,
      "end_seconds": 240.35,
      "duration_seconds": 7.84,
      "text": "So where does that leave us? This is probably an underactive thyroid presenting as low mood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.78,
      "end_seconds": 245.17,
      "duration_seconds": 3.39,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.79,
      "end_seconds": 254.96,
      "duration_seconds": 9.17,
      "text": "Nothing I've seen today points to an emergency. It looks like an underactive thyroid presenting as low mood, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.17,
      "end_seconds": 276.42,
      "duration_seconds": 5.25,
      "text": "I'm going to order a thyroid test, for slowing and cold intolerance."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.83,
      "end_seconds": 281.02,
      "duration_seconds": 3.19,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.9,
      "end_seconds": 287.41,
      "duration_seconds": 4.51,
      "text": "I'm going to order a blood count, for tiredness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.37,
      "end_seconds": 293.91,
      "duration_seconds": 1.54,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.82,
      "end_seconds": 301.01,
      "duration_seconds": 6.19,
      "text": "We'll check the thyroid before deciding on any antidepressant. Book a review after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.96,
      "end_seconds": 302.66,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.53,
      "end_seconds": 306.03,
      "duration_seconds": 2.5,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.48,
      "end_seconds": 312.9,
      "duration_seconds": 3.42,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.44,
      "end_seconds": 314.78,
      "duration_seconds": 1.34,
      "text": "Goodbye for now."
    }
  ]
}