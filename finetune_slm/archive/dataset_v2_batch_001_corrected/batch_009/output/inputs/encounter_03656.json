{
  "schema_version": "1.0",
  "encounter_id": "03656",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 5.43,
      "duration_seconds": 4.52,
      "text": "Welcome. Make yourself comfortable. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.21,
      "end_seconds": 14.1,
      "duration_seconds": 7.89,
      "text": "It's ringing in my left ear. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.91,
      "end_seconds": 19.4,
      "duration_seconds": 3.49,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.94,
      "end_seconds": 23.85,
      "duration_seconds": 2.91,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.92,
      "end_seconds": 30.59,
      "duration_seconds": 4.67,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.59,
      "end_seconds": 35.91,
      "duration_seconds": 4.32,
      "text": "It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.29,
      "end_seconds": 39.95,
      "duration_seconds": 3.66,
      "text": "Hm, okay. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.75,
      "end_seconds": 57.42,
      "duration_seconds": 16.67,
      "text": "Occasional unsteadiness goes along with it, most of the time. Let me think, the occasional unsteadiness? That's been for about two weeks. Okay, so with occasional unsteadiness, mostly severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.48,
      "end_seconds": 68.1,
      "duration_seconds": 3.62,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.19,
      "end_seconds": 80.96,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.26,
      "end_seconds": 110.65,
      "duration_seconds": 8.39,
      "text": "Okay: blood pressure 113 over 73, temp 36.7 degrees. And pulse is 67 beats a minute, respiratory rate 15."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.53,
      "end_seconds": 116.82,
      "duration_seconds": 4.29,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.64,
      "end_seconds": 120.85,
      "duration_seconds": 2.21,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.98,
      "end_seconds": 142.43,
      "duration_seconds": 7.45,
      "text": "Both ear drums look normal and the hearing on the left is clearly reduced with nerve-type loss."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.07,
      "end_seconds": 148.34,
      "duration_seconds": 2.27,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.55,
      "end_seconds": 159.82,
      "duration_seconds": 4.27,
      "text": "Any vertigo, facial weakness or ear pain at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 165.8,
      "duration_seconds": 5.4,
      "text": "I haven't had vertigo, facial weakness or ear pain, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.2,
      "end_seconds": 170.86,
      "duration_seconds": 4.66,
      "text": "Hm, okay. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.63,
      "end_seconds": 175.18,
      "duration_seconds": 2.55,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.75,
      "end_seconds": 180.67,
      "duration_seconds": 3.92,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.74,
      "end_seconds": 184.29,
      "duration_seconds": 1.55,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.94,
      "end_seconds": 204.9,
      "duration_seconds": 2.96,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.63,
      "end_seconds": 211.07,
      "duration_seconds": 5.44,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.28,
      "end_seconds": 216.7,
      "duration_seconds": 1.42,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.61,
      "end_seconds": 221.59,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.66,
      "end_seconds": 244.9,
      "duration_seconds": 9.24,
      "text": "Okay, what conditions have you been treated for in the past? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.4,
      "end_seconds": 248.06,
      "duration_seconds": 1.66,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.28,
      "end_seconds": 255.76,
      "duration_seconds": 6.48,
      "text": "Tell me your medicines, please. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.87,
      "end_seconds": 260.59,
      "duration_seconds": 3.72,
      "text": "I take rosuvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.18,
      "end_seconds": 263.21,
      "duration_seconds": 2.03,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.49,
      "end_seconds": 269.52,
      "duration_seconds": 5.03,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.09,
      "end_seconds": 275.38,
      "duration_seconds": 5.29,
      "text": "I follow. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.19,
      "end_seconds": 288.39,
      "duration_seconds": 11.2,
      "text": "Right, um, I had a reaction to tramadol when I was younger, feeling very drowsy, and I've avoided it since."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.03,
      "end_seconds": 290.48,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.07,
      "end_seconds": 294.08,
      "duration_seconds": 2.01,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.14,
      "end_seconds": 328.13,
      "duration_seconds": 31.99,
      "text": "Right, here's what I'm thinking. I think we're dealing with one-sided nerve hearing loss needing a scan at this stage. Let's get an MRI of the internal auditory canals, for asymmetric hearing loss. One-sided tinnitus with hearing loss always gets a scan, it's usually benign. I'm going to send a referral to the ENT clinic. I'd like you back after the scan. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.6,
      "end_seconds": 331.37,
      "duration_seconds": 1.77,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.9,
      "end_seconds": 334.36,
      "duration_seconds": 1.46,
      "text": "Take care now."
    }
  ]
}