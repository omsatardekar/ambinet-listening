{
  "schema_version": "1.0",
  "encounter_id": "03654",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.06,
      "end_seconds": 8.24,
      "duration_seconds": 7.18,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.87,
      "end_seconds": 13.78,
      "duration_seconds": 3.91,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.66,
      "end_seconds": 21.48,
      "duration_seconds": 5.82,
      "text": "Good morning, you know, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.11,
      "end_seconds": 25.89,
      "duration_seconds": 2.78,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.94,
      "end_seconds": 34.99,
      "duration_seconds": 7.05,
      "text": "Doctor, it's a sore spot on the front of my shin. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.58,
      "end_seconds": 38.39,
      "duration_seconds": 2.81,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 40.04,
      "end_seconds": 41.85,
      "duration_seconds": 1.81,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.53,
      "end_seconds": 51.49,
      "duration_seconds": 7.96,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.34,
      "end_seconds": 64.1,
      "duration_seconds": 10.76,
      "text": "I notice it more with running. Rest helps a bit. It feels moderate to me. It's a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.1,
      "end_seconds": 67.62,
      "duration_seconds": 2.52,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.72,
      "end_seconds": 74.94,
      "duration_seconds": 6.22,
      "text": "Pain at night goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.51,
      "end_seconds": 85.03,
      "duration_seconds": 9.52,
      "text": "Let me think, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 85.13,
      "end_seconds": 90.74,
      "duration_seconds": 5.61,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.96,
      "end_seconds": 95.1,
      "duration_seconds": 3.14,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.11,
      "end_seconds": 100.51,
      "duration_seconds": 4.4,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.93,
      "end_seconds": 114.25,
      "duration_seconds": 12.32,
      "text": "The pain at night? That's been for two days. And there's being told it was shin splints as well, five days now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.91,
      "end_seconds": 123.0,
      "duration_seconds": 3.09,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.31,
      "end_seconds": 130.4,
      "duration_seconds": 3.09,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.56,
      "end_seconds": 140.52,
      "duration_seconds": 8.96,
      "text": "Have you had a sore spot on the front of your shin before, or is this the first time?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.46,
      "end_seconds": 148.84,
      "duration_seconds": 6.38,
      "text": "Ah, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.5,
      "end_seconds": 165.99,
      "duration_seconds": 3.49,
      "text": "Right, did you get swelling or numbness?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.73,
      "end_seconds": 171.52,
      "duration_seconds": 3.79,
      "text": "No swelling or numbness, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.16,
      "end_seconds": 175.59,
      "duration_seconds": 2.43,
      "text": "Did you get injury or fever?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.31,
      "end_seconds": 178.9,
      "duration_seconds": 2.59,
      "text": "No, no injury or fever."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.68,
      "end_seconds": 181.46,
      "duration_seconds": 1.78,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.69,
      "end_seconds": 183.59,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.41,
      "end_seconds": 186.77,
      "duration_seconds": 1.36,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.35,
      "end_seconds": 190.43,
      "duration_seconds": 2.08,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.78,
      "end_seconds": 194.42,
      "duration_seconds": 2.64,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.45,
      "end_seconds": 201.09,
      "duration_seconds": 5.64,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 206.89,
      "duration_seconds": 5.29,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.44,
      "end_seconds": 220.15,
      "duration_seconds": 12.71,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.81,
      "end_seconds": 225.48,
      "duration_seconds": 4.67,
      "text": "So, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.17,
      "end_seconds": 235.28,
      "duration_seconds": 4.11,
      "text": "I've had thin bones, yes. Yes, heart disease."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.25,
      "end_seconds": 238.22,
      "duration_seconds": 1.97,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.02,
      "end_seconds": 242.76,
      "duration_seconds": 2.74,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.54,
      "end_seconds": 253.57,
      "duration_seconds": 10.03,
      "text": "Okay, I can see thin bones and an irregular heartbeat in your file as well. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.86,
      "end_seconds": 261.11,
      "duration_seconds": 6.25,
      "text": "Clopidogrel. I take it 75 milligrams, maybe, once a day for the stent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.04,
      "end_seconds": 265.04,
      "duration_seconds": 3.0,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.29,
      "end_seconds": 280.23,
      "duration_seconds": 13.94,
      "text": "No, it's at home. Warfarin, 3 milligrams, in the evening. Ibuprofen, 400 milligrams, when needed. I used to take aspirin, but I stopped it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.22,
      "end_seconds": 284.99,
      "duration_seconds": 3.77,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.86,
      "end_seconds": 288.62,
      "duration_seconds": 2.76,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.65,
      "end_seconds": 291.13,
      "duration_seconds": 1.48,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.68,
      "end_seconds": 294.88,
      "duration_seconds": 3.2,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 295.58,
      "end_seconds": 305.24,
      "duration_seconds": 9.66,
      "text": "Doctor, I've got the readings for you. Respiratory rate 17, pulse 75. Temperature 36.7, pressure 111 over 71, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.12,
      "end_seconds": 308.45,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.09,
      "end_seconds": 312.04,
      "duration_seconds": 1.95,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.19,
      "end_seconds": 315.2,
      "duration_seconds": 2.01,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.14,
      "end_seconds": 332.39,
      "duration_seconds": 7.25,
      "text": "There is a very localised tender spot on the bone and hopping on that leg hurts."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.19,
      "end_seconds": 349.76,
      "duration_seconds": 13.57,
      "text": "Thank you, you can get dressed. Having listened and examined, the most likely explanation is a possible stress fracture rather than shin splints. I'd also keep shin splints in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.41,
      "end_seconds": 376.51,
      "duration_seconds": 10.1,
      "text": "I want an MRI of the shin done, that's for possible stress fracture. I want a vitamin D level done, that's for stress fracture."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 377.98,
      "end_seconds": 380.22,
      "duration_seconds": 2.24,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.5,
      "end_seconds": 412.63,
      "duration_seconds": 31.13,
      "text": "Stop running, no impact exercise until the scan, swimming or cycling is fine. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back or go to emergency straight away if the symptoms get worse. I'd like you back after the scan."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.96,
      "end_seconds": 419.3,
      "duration_seconds": 5.34,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 420.98,
      "end_seconds": 423.28,
      "duration_seconds": 2.3,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.11,
      "end_seconds": 426.35,
      "duration_seconds": 1.24,
      "text": "Goodbye for now."
    }
  ]
}