{
  "schema_version": "1.0",
  "encounter_id": "03571",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 3.77,
      "duration_seconds": 2.56,
      "text": "afternoon, thanks for coming in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.14,
      "end_seconds": 8.2,
      "duration_seconds": 3.06,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.29,
      "end_seconds": 16.17,
      "duration_seconds": 2.88,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.6,
      "end_seconds": 23.82,
      "duration_seconds": 6.22,
      "text": "I've been feeling slightly dizzy, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.5,
      "end_seconds": 27.86,
      "duration_seconds": 3.36,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.32,
      "end_seconds": 34.97,
      "duration_seconds": 4.65,
      "text": "It's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.31,
      "end_seconds": 40.54,
      "duration_seconds": 5.23,
      "text": "hm, okay okay, what about a late period, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.67,
      "end_seconds": 53.75,
      "duration_seconds": 9.08,
      "text": "Yes, actually. I've also had a vague low ache. With vague low ache, honestly, a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.42,
      "end_seconds": 57.96,
      "duration_seconds": 2.54,
      "text": "Did you notice any severe pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.97,
      "end_seconds": 61.91,
      "duration_seconds": 2.94,
      "text": "Not at all, no severe pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.97,
      "end_seconds": 70.59,
      "duration_seconds": 4.62,
      "text": "have you had any heavy bleeding, shoulder tip pain or collapse?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.13,
      "end_seconds": 76.55,
      "duration_seconds": 4.42,
      "text": "No, no heavy bleeding, shoulder tip pain or collapse."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.09,
      "end_seconds": 81.42,
      "duration_seconds": 3.33,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.21,
      "end_seconds": 84.82,
      "duration_seconds": 1.61,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.38,
      "end_seconds": 89.44,
      "duration_seconds": 4.06,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.96,
      "end_seconds": 94.45,
      "duration_seconds": 3.49,
      "text": "Well, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.24,
      "end_seconds": 98.59,
      "duration_seconds": 2.35,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.31,
      "end_seconds": 106.02,
      "duration_seconds": 3.71,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.11,
      "end_seconds": 112.59,
      "duration_seconds": 2.48,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.59,
      "end_seconds": 118.19,
      "duration_seconds": 4.6,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.55,
      "end_seconds": 120.73,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.57,
      "end_seconds": 125.26,
      "duration_seconds": 2.69,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.29,
      "end_seconds": 129.54,
      "duration_seconds": 2.25,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.38,
      "end_seconds": 133.85,
      "duration_seconds": 3.47,
      "text": "I take hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.85,
      "end_seconds": 141.68,
      "duration_seconds": 2.83,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.27,
      "end_seconds": 149.39,
      "duration_seconds": 6.12,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.14,
      "end_seconds": 161.15,
      "duration_seconds": 2.01,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.18,
      "end_seconds": 171.35,
      "duration_seconds": 8.17,
      "text": "I have eczema. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.35,
      "end_seconds": 178.41,
      "duration_seconds": 5.06,
      "text": "Right, right. Okay, I can see eczema in your file as well."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.93,
      "end_seconds": 193.49,
      "duration_seconds": 6.56,
      "text": "Are there any allergies I should be aware of? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.02,
      "end_seconds": 199.43,
      "duration_seconds": 5.41,
      "text": "I'm allergic to nickel, I get a rash on my skin"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.46,
      "end_seconds": 215.08,
      "duration_seconds": 2.62,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.18,
      "end_seconds": 225.59,
      "duration_seconds": 2.41,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.68,
      "end_seconds": 252.26,
      "duration_seconds": 7.58,
      "text": "Okay: blood pressure 121 over 80, pulse 78, saturation 97 percent, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.08,
      "end_seconds": 255.56,
      "duration_seconds": 1.48,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.15,
      "end_seconds": 260.17,
      "duration_seconds": 3.02,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.86,
      "end_seconds": 265.87,
      "duration_seconds": 4.01,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.57,
      "end_seconds": 268.59,
      "duration_seconds": 1.02,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.41,
      "end_seconds": 272.9,
      "duration_seconds": 2.49,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.7,
      "end_seconds": 295.76,
      "duration_seconds": 8.06,
      "text": "Your tummy is soft with mild tenderness low on the left and the pregnancy test is positive."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.4,
      "end_seconds": 327.52,
      "duration_seconds": 27.12,
      "text": "That's the examination finished. Okay, so my impression is this: It points towards a pregnancy of unknown location, ectopic not excluded. I want to be honest that this is an impression, not a final answer. It could also be a a threatened miscarriage, so we'll keep that open. Let's book an early pregnancy scan to look into pregnancy of unknown location."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 328.03,
      "end_seconds": 332.94,
      "duration_seconds": 4.91,
      "text": "We have a slot Wednesday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.94,
      "end_seconds": 358.53,
      "duration_seconds": 23.59,
      "text": "Even with little pain this needs a scan within a day, and go to hospital if the pain gets worse. Don't skip meals, and try to eat smaller portions more often through the day. The thing that would worry me is if you get severe pain or feel faint. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.34,
      "end_seconds": 361.82,
      "duration_seconds": 1.48,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.31,
      "end_seconds": 369.82,
      "duration_seconds": 6.51,
      "text": "Let's review you tomorrow. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.6,
      "end_seconds": 374.76,
      "duration_seconds": 4.16,
      "text": "so, I come back tomorrow is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.64,
      "end_seconds": 382.55,
      "duration_seconds": 6.91,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.28,
      "end_seconds": 387.3,
      "duration_seconds": 3.02,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}