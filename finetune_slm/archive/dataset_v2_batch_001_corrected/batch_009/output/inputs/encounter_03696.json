{
  "schema_version": "1.0",
  "encounter_id": "03696",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.32,
      "end_seconds": 8.06,
      "duration_seconds": 6.74,
      "text": "Doctor, your next patient is here. I've done the the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.57,
      "end_seconds": 13.84,
      "duration_seconds": 4.27,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.84,
      "end_seconds": 19.88,
      "duration_seconds": 5.04,
      "text": "well, doctor, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.23,
      "end_seconds": 27.14,
      "duration_seconds": 5.91,
      "text": "so, So the thing is, I've got being very thirsty"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.47,
      "end_seconds": 30.33,
      "duration_seconds": 1.86,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.43,
      "end_seconds": 35.09,
      "duration_seconds": 2.66,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.16,
      "end_seconds": 40.04,
      "duration_seconds": 2.88,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 40.62,
      "end_seconds": 41.78,
      "duration_seconds": 1.16,
      "text": "Severe, really"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.73,
      "end_seconds": 50.47,
      "duration_seconds": 7.74,
      "text": "right, um, I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 50.57,
      "end_seconds": 57.85,
      "duration_seconds": 7.28,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.06,
      "end_seconds": 61.57,
      "duration_seconds": 2.51,
      "text": "later, thanks please go on"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.13,
      "end_seconds": 66.93,
      "duration_seconds": 3.8,
      "text": "I've also had nausea, since Monday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.48,
      "end_seconds": 70.59,
      "duration_seconds": 2.11,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.51,
      "end_seconds": 75.0,
      "duration_seconds": 2.49,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.67,
      "end_seconds": 81.87,
      "duration_seconds": 5.2,
      "text": "have you had being very thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.03,
      "end_seconds": 91.4,
      "duration_seconds": 8.37,
      "text": "Hmm, a bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.45,
      "end_seconds": 98.4,
      "duration_seconds": 4.95,
      "text": "Right, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.88,
      "end_seconds": 109.02,
      "duration_seconds": 7.14,
      "text": "My mother had a a stroke. Hmm, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.47,
      "end_seconds": 111.91,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.69,
      "end_seconds": 114.03,
      "duration_seconds": 1.34,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.34,
      "end_seconds": 126.75,
      "duration_seconds": 2.41,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.64,
      "end_seconds": 139.19,
      "duration_seconds": 7.55,
      "text": "Uh, it's metoprolol, 50 milligrams, maybe, twice a day for my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.14,
      "end_seconds": 145.54,
      "duration_seconds": 3.4,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.34,
      "end_seconds": 150.15,
      "duration_seconds": 2.81,
      "text": "so, no, it's at home"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 153.84,
      "duration_seconds": 3.08,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.54,
      "end_seconds": 170.58,
      "duration_seconds": 15.04,
      "text": "hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.41,
      "end_seconds": 176.12,
      "duration_seconds": 3.71,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.64,
      "end_seconds": 184.63,
      "duration_seconds": 7.99,
      "text": "I have epilepsy, for five years. Yes, heart failure. I have high cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.45,
      "end_seconds": 192.8,
      "duration_seconds": 7.35,
      "text": "Mm, okay. Okay, I can see heart failure in your file as well. Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.65,
      "end_seconds": 198.04,
      "duration_seconds": 3.39,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.74,
      "end_seconds": 203.81,
      "duration_seconds": 4.07,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.7,
      "end_seconds": 208.46,
      "duration_seconds": 3.76,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.27,
      "end_seconds": 212.35,
      "duration_seconds": 2.08,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.92,
      "end_seconds": 216.97,
      "duration_seconds": 4.05,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.91,
      "end_seconds": 231.85,
      "duration_seconds": 4.94,
      "text": "Alright, have you had any cough, sore throat, fever or diarrhoea?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.85,
      "end_seconds": 248.72,
      "duration_seconds": 15.87,
      "text": "right, uh, no, no cough, no sore throat, no fever. I was losing weight at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.15,
      "end_seconds": 254.15,
      "duration_seconds": 4.0,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 255.76,
      "end_seconds": 257.31,
      "duration_seconds": 1.55,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.93,
      "end_seconds": 261.25,
      "duration_seconds": 3.32,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 262.18,
      "end_seconds": 266.25,
      "duration_seconds": 4.07,
      "text": "Hmm, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 270.8,
      "end_seconds": 279.44,
      "duration_seconds": 8.64,
      "text": "Doctor, I've got the readings for you. Pulse 111, blood pressure 130 over 79, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.13,
      "end_seconds": 281.61,
      "duration_seconds": 1.48,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.35,
      "end_seconds": 287.62,
      "duration_seconds": 3.27,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.36,
      "end_seconds": 291.36,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.93,
      "end_seconds": 309.59,
      "duration_seconds": 5.66,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.78,
      "end_seconds": 329.01,
      "duration_seconds": 14.23,
      "text": "Good, you can sit up again. Okay, thinking it through, I'd lean towards possible new type 1 diabetes starting to turn acidic. I'd also keep a viral illness in mind."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 330.73,
      "end_seconds": 335.8,
      "duration_seconds": 5.07,
      "text": "We've already done a finger-prick glucose and ketones this morning, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.48,
      "end_seconds": 368.65,
      "duration_seconds": 32.17,
      "text": "great, that's useful. I'm going to order blood tests, for possible ketoacidosis. This is not flu, your sugar is very high, and you need hospital insulin today. A short walk every day, even twenty minutes, will help more than you'd think. I'm going to send a referral to the diabetes team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me straight away"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 370.45,
      "end_seconds": 373.0,
      "duration_seconds": 2.55,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.03,
      "end_seconds": 377.86,
      "duration_seconds": 2.83,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.96,
      "end_seconds": 384.87,
      "duration_seconds": 1.91,
      "text": "That's clear, thanks."
    }
  ]
}