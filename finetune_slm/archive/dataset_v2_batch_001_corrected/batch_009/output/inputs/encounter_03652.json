{
  "schema_version": "1.0",
  "encounter_id": "03652",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.69,
      "duration_seconds": 4.15,
      "text": "Yeah, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.51,
      "end_seconds": 9.65,
      "duration_seconds": 4.14,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.26,
      "end_seconds": 18.3,
      "duration_seconds": 7.04,
      "text": "Um, so... seen putting a coin-like object in his mouth. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 26.59,
      "duration_seconds": 6.98,
      "text": "How long has it been like this? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.55,
      "end_seconds": 31.39,
      "duration_seconds": 2.84,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.37,
      "end_seconds": 36.23,
      "duration_seconds": 2.86,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.32,
      "end_seconds": 43.82,
      "duration_seconds": 5.5,
      "text": "I'd say mild. I've also had a little drooling, for two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.36,
      "end_seconds": 46.97,
      "duration_seconds": 2.61,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.46,
      "end_seconds": 62.82,
      "duration_seconds": 2.36,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 86.44,
      "duration_seconds": 10.72,
      "text": "Okay: temperature 36.6, BP is 109 over 81. And oxygen saturation is 99 percent, respiratory rate 18, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.51,
      "end_seconds": 89.88,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.43,
      "end_seconds": 95.38,
      "duration_seconds": 3.95,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.47,
      "end_seconds": 101.03,
      "duration_seconds": 4.56,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.08,
      "end_seconds": 103.41,
      "duration_seconds": 1.33,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.65,
      "end_seconds": 122.74,
      "duration_seconds": 4.09,
      "text": "He is playful, breathing normally and the throat looks normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.43,
      "end_seconds": 129.74,
      "duration_seconds": 4.31,
      "text": "That's the examination finished. Right, have you had any fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.17,
      "end_seconds": 132.65,
      "duration_seconds": 1.48,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.74,
      "end_seconds": 138.05,
      "duration_seconds": 3.31,
      "text": "Any breathing difficulty, vomiting blood or rash?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 143.91,
      "duration_seconds": 4.94,
      "text": "No breathing difficulty, vomiting blood or rash, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.96,
      "end_seconds": 146.6,
      "duration_seconds": 1.64,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.65,
      "end_seconds": 150.24,
      "duration_seconds": 1.59,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.39,
      "end_seconds": 154.1,
      "duration_seconds": 2.71,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.01,
      "end_seconds": 160.98,
      "duration_seconds": 1.97,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.38,
      "end_seconds": 166.18,
      "duration_seconds": 3.8,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.87,
      "end_seconds": 172.3,
      "duration_seconds": 5.43,
      "text": "I take allopurinol, 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.08,
      "end_seconds": 178.73,
      "duration_seconds": 2.65,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.54,
      "end_seconds": 184.51,
      "duration_seconds": 4.97,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.24,
      "end_seconds": 189.79,
      "duration_seconds": 3.55,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.46,
      "end_seconds": 192.89,
      "duration_seconds": 1.43,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.89,
      "end_seconds": 198.34,
      "duration_seconds": 1.45,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.44,
      "end_seconds": 204.11,
      "duration_seconds": 3.67,
      "text": "I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.94,
      "end_seconds": 213.8,
      "duration_seconds": 3.86,
      "text": "Ah. Alright, gout, that matches what I have here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.85,
      "end_seconds": 234.8,
      "duration_seconds": 2.95,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.38,
      "end_seconds": 239.52,
      "duration_seconds": 4.14,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.71,
      "end_seconds": 243.12,
      "duration_seconds": 2.41,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.81,
      "end_seconds": 248.71,
      "duration_seconds": 3.9,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.49,
      "end_seconds": 253.35,
      "duration_seconds": 2.86,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.62,
      "end_seconds": 258.61,
      "duration_seconds": 3.99,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.19,
      "end_seconds": 286.1,
      "duration_seconds": 17.91,
      "text": "From what you've told me and what I found, this looks most like a possible swallowed button battery needing an urgent X-ray despite few symptoms. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.68,
      "end_seconds": 289.88,
      "duration_seconds": 3.2,
      "text": "Is this serious, uh, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.33,
      "end_seconds": 306.13,
      "duration_seconds": 14.8,
      "text": "I understand the worry. At the moment I'd say it's a possible swallowed button battery needing an urgent X-ray despite few symptoms, and we'll know more once the an urgent chest and abdominal X-ray is back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.08,
      "end_seconds": 335.56,
      "duration_seconds": 21.48,
      "text": "I think an urgent chest and abdominal X-ray makes sense here, for possible battery ingestion. A button battery can burn the gullet within hours even when a child looks well, so we scan now. Do get help quickly if the symptoms get worse. Let's review you straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.72,
      "end_seconds": 343.98,
      "duration_seconds": 3.26,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.69,
      "end_seconds": 347.06,
      "duration_seconds": 2.37,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.34,
      "end_seconds": 351.32,
      "duration_seconds": 2.98,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.27,
      "end_seconds": 354.65,
      "duration_seconds": 1.38,
      "text": "Goodbye for now."
    }
  ]
}