      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.78,
      "end_seconds": 142.32,
      "duration_seconds": 5.54,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.94,
      "end_seconds": 145.7,
      "duration_seconds": 1.76,
      "text": "So, do you smoke?"
