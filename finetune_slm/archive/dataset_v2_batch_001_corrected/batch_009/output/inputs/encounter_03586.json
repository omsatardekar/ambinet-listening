      "role": "DOCTOR",
      "start_seconds": 109.61,
      "end_seconds": 114.0,
      "duration_seconds": 4.39,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.98,
      "end_seconds": 119.0,
