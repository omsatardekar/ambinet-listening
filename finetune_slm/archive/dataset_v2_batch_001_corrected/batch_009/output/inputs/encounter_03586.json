      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.26,
      "end_seconds": 154.51,
      "duration_seconds": 2.25,
      "text": "do you live by yourself?"
