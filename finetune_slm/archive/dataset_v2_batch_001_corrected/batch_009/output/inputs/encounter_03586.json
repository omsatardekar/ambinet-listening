      "role": "DOCTOR",
      "start_seconds": 8.38,
      "end_seconds": 11.2,
      "duration_seconds": 2.82,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.14,
      "end_seconds": 17.4,
