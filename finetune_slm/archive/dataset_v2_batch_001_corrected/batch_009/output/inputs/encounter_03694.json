{
  "schema_version": "1.0",
  "encounter_id": "03694",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.82,
      "duration_seconds": 3.73,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 10.6,
      "duration_seconds": 3.75,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.03,
      "end_seconds": 16.57,
      "duration_seconds": 4.54,
      "text": "Well, I've been having a fever and sweats."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.16,
      "end_seconds": 19.86,
      "duration_seconds": 1.7,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.79,
      "end_seconds": 25.34,
      "duration_seconds": 3.55,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.07,
      "end_seconds": 29.85,
      "duration_seconds": 3.78,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.97,
      "end_seconds": 35.93,
      "duration_seconds": 0.96,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.75,
      "end_seconds": 40.23,
      "duration_seconds": 2.48,
      "text": "Have you had a sore throat?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.81,
      "end_seconds": 48.03,
      "duration_seconds": 6.22,
      "text": "Yeah, that too. With sore throat, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.21,
      "end_seconds": 67.47,
      "duration_seconds": 3.26,
      "text": "Right, did you get diarrhoea or stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.87,
      "end_seconds": 72.68,
      "duration_seconds": 3.81,
      "text": "I haven't had diarrhoea or stiff neck, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.7,
      "end_seconds": 78.25,
      "duration_seconds": 3.55,
      "text": "And what about recent tick bite or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.51,
      "end_seconds": 84.39,
      "duration_seconds": 4.88,
      "text": "No recent tick bite or cough, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.44,
      "end_seconds": 89.97,
      "duration_seconds": 4.53,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.61,
      "end_seconds": 93.08,
      "duration_seconds": 1.47,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.71,
      "end_seconds": 97.7,
      "duration_seconds": 2.99,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.67,
      "end_seconds": 101.64,
      "duration_seconds": 1.97,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.27,
      "end_seconds": 118.84,
      "duration_seconds": 3.57,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.92,
      "end_seconds": 122.77,
      "duration_seconds": 2.85,
      "text": "Yes, erythromycin. I get a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.15,
      "end_seconds": 126.72,
      "duration_seconds": 2.57,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.94,
      "end_seconds": 129.04,
      "duration_seconds": 1.1,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.96,
      "end_seconds": 136.71,
      "duration_seconds": 2.75,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.67,
      "end_seconds": 139.32,
      "duration_seconds": 1.65,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.38,
      "end_seconds": 141.7,
      "duration_seconds": 1.32,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.53,
      "end_seconds": 151.53,
      "duration_seconds": 6.0,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.53,
      "end_seconds": 153.71,
      "duration_seconds": 1.18,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.76,
      "end_seconds": 161.12,
      "duration_seconds": 4.36,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.74,
      "end_seconds": 165.27,
      "duration_seconds": 2.53,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.95,
      "end_seconds": 170.33,
      "duration_seconds": 4.38,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.88,
      "end_seconds": 173.28,
      "duration_seconds": 2.4,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.26,
      "end_seconds": 178.09,
      "duration_seconds": 3.83,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.98,
      "end_seconds": 181.57,
      "duration_seconds": 1.59,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.02,
      "end_seconds": 187.36,
      "duration_seconds": 4.34,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.6,
      "end_seconds": 192.04,
      "duration_seconds": 3.44,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.77,
      "end_seconds": 195.65,
      "duration_seconds": 2.88,
      "text": "I'm on propranolol, twice a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 199.23,
      "duration_seconds": 2.39,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.96,
      "end_seconds": 205.89,
      "duration_seconds": 4.93,
      "text": "40 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.83,
      "end_seconds": 211.97,
      "duration_seconds": 4.14,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.96,
      "end_seconds": 226.62,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.04,
      "end_seconds": 242.75,
      "duration_seconds": 5.71,
      "text": "Okay: temperature is 39.2 degrees, pulse 102, pressure 122 over 69."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.19,
      "end_seconds": 247.27,
      "duration_seconds": 3.08,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.12,
      "end_seconds": 249.56,
      "duration_seconds": 1.44,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.85,
      "end_seconds": 269.43,
      "duration_seconds": 6.58,
      "text": "There are small mouth ulcers, tender neck glands and a faint pink rash on the chest."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.89,
      "end_seconds": 288.59,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.08,
      "end_seconds": 295.0,
      "duration_seconds": 1.92,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.6,
      "end_seconds": 339.82,
      "duration_seconds": 27.22,
      "text": "Okay, thinking it through, it points towards an acute viral illness, possibly early HIV infection. Let's get a glandular fever test, for sore throat and glands. It's a routine test and it'll give us a much clearer picture. I'm offering an HIV test with every illness like this, it's routine, and results are confidential."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.21,
      "end_seconds": 348.65,
      "duration_seconds": 8.44,
      "text": "Ah. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.17,
      "end_seconds": 366.18,
      "duration_seconds": 17.01,
      "text": "Ah. I think the sexual health clinic should see you too. I'm not ordering a fourth-generation HIV test today. If things carry on in a month, we'll consider it. Please come and see me after the results."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.72,
      "end_seconds": 369.9,
      "duration_seconds": 2.18,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.28,
      "end_seconds": 378.22,
      "duration_seconds": 3.94,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.07,
      "end_seconds": 384.19,
      "duration_seconds": 4.12,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.44,
      "end_seconds": 387.23,
      "duration_seconds": 1.79,
      "text": "Okay, look after yourself."
    }
  ]
}