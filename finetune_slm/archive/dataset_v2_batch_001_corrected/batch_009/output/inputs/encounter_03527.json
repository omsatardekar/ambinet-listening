{
  "schema_version": "1.0",
  "encounter_id": "03527",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.19,
      "duration_seconds": 3.86,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.86,
      "end_seconds": 11.75,
      "duration_seconds": 4.89,
      "text": "Alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 19.16,
      "duration_seconds": 1.83,
      "text": "I've been feeling weak."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.1,
      "end_seconds": 24.02,
      "duration_seconds": 2.92,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.18,
      "end_seconds": 39.12,
      "duration_seconds": 2.94,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.42,
      "end_seconds": 68.47,
      "duration_seconds": 13.05,
      "text": "Okay: height 178 centimetres, weight 61 kilos, pulse is 114 beats a minute, blood pressure 117 over 75, respiratory rate 16, temp 37.1 degrees, BMI works out to 19.3."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.13,
      "end_seconds": 70.71,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.86,
      "end_seconds": 74.2,
      "duration_seconds": 2.34,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.34,
      "end_seconds": 94.61,
      "duration_seconds": 3.27,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.99,
      "end_seconds": 99.11,
      "duration_seconds": 3.12,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.57,
      "end_seconds": 103.53,
      "duration_seconds": 2.96,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.27,
      "end_seconds": 105.73,
      "duration_seconds": 1.46,
      "text": "Severe, I'd say"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.22,
      "end_seconds": 109.98,
      "duration_seconds": 2.76,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.97,
      "end_seconds": 124.32,
      "duration_seconds": 13.35,
      "text": "It usually comes with a poor appetite. I've been losing weight too. Oh, and an irregular heartbeat. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.74,
      "end_seconds": 129.6,
      "duration_seconds": 3.86,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.55,
      "end_seconds": 136.35,
      "duration_seconds": 4.8,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.91,
      "end_seconds": 143.87,
      "duration_seconds": 6.96,
      "text": "I see, go ahead. Have you been feeling weak at any time before this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.64,
      "end_seconds": 151.63,
      "duration_seconds": 6.99,
      "text": "a bit, a couple of years ago it settled by itself back then"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.71,
      "end_seconds": 159.06,
      "duration_seconds": 2.35,
      "text": "Did you notice any sweating?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.08,
      "end_seconds": 161.83,
      "duration_seconds": 1.75,
      "text": "nope, no sweating"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.77,
      "end_seconds": 166.72,
      "duration_seconds": 3.95,
      "text": "A few quick ones: heat intolerance, tremor or diarrhoea?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.88,
      "end_seconds": 171.66,
      "duration_seconds": 3.78,
      "text": "no, no heat intolerance, tremor or diarrhoea"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.42,
      "end_seconds": 174.83,
      "duration_seconds": 2.41,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.55,
      "end_seconds": 177.68,
      "duration_seconds": 1.13,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 184.88,
      "duration_seconds": 2.77,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.4,
      "end_seconds": 187.21,
      "duration_seconds": 1.81,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.93,
      "end_seconds": 193.18,
      "duration_seconds": 4.25,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.24,
      "end_seconds": 207.62,
      "duration_seconds": 13.38,
      "text": "I have an underactive thyroid, for five years. It's a relief to finally sit down and talk about it. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.68,
      "end_seconds": 210.38,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.32,
      "end_seconds": 219.23,
      "duration_seconds": 6.91,
      "text": "I have gout. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.23,
      "end_seconds": 235.2,
      "duration_seconds": 10.97,
      "text": "Ah. Right, so gout is already on your record. We'll keep that in mind today. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.68,
      "end_seconds": 258.2,
      "duration_seconds": 21.52,
      "text": "Okay, so it's Thyronorm, 50 micrograms, every morning for my thyroid. I do miss it now and then, to be fair. I'm, I'm on allopurinol, 100 milligrams, once a day. I had febuxostat at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.78,
      "end_seconds": 264.99,
      "duration_seconds": 5.21,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.78,
      "end_seconds": 281.67,
      "duration_seconds": 14.89,
      "text": "I drink a lot of tea and snack through the day. I'm a hairdresser, on my feet all day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.27,
      "end_seconds": 287.5,
      "duration_seconds": 5.23,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.94,
      "end_seconds": 291.66,
      "duration_seconds": 2.72,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.39,
      "end_seconds": 295.23,
      "duration_seconds": 2.84,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.31,
      "end_seconds": 304.29,
      "duration_seconds": 4.98,
      "text": "My father has Parkinson's disease. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.87,
      "end_seconds": 325.99,
      "duration_seconds": 4.12,
      "text": "I want an ECG done, that's for irregular pulse"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.32,
      "end_seconds": 330.13,
      "duration_seconds": 2.81,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.04,
      "end_seconds": 344.52,
      "duration_seconds": 12.48,
      "text": "A thyroid test is what I'd like next, for weight loss and irregular pulse. It is easy to miss in older people because they seem sleepy rather than hot and shaky."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.96,
      "end_seconds": 358.17,
      "duration_seconds": 13.21,
      "text": "ah make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest let's plan a check after the results"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.15,
      "end_seconds": 362.12,
      "duration_seconds": 1.97,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.59,
      "end_seconds": 367.53,
      "duration_seconds": 3.94,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.64,
      "end_seconds": 374.03,
      "duration_seconds": 2.39,
      "text": "Alright, thanks, take care."
    }
  ]
}