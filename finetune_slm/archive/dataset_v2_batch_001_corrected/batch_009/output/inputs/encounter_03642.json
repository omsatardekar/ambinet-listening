{
  "schema_version": "1.0",
  "encounter_id": "03642",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 7.59,
      "duration_seconds": 6.5,
      "text": "Sorry, what was I saying, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.22,
      "end_seconds": 13.87,
      "duration_seconds": 4.65,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.73,
      "end_seconds": 19.55,
      "duration_seconds": 4.82,
      "text": "Um, so... fainting once. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.3,
      "end_seconds": 23.44,
      "duration_seconds": 3.14,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.88,
      "end_seconds": 34.02,
      "duration_seconds": 9.14,
      "text": "Okay, um, so it's allopurinol, 100 milligrams, once a day. I'm on the contraceptive pill, daily."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 38.72,
      "duration_seconds": 3.68,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.14,
      "end_seconds": 43.2,
      "duration_seconds": 3.06,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.84,
      "end_seconds": 50.65,
      "duration_seconds": 2.81,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.62,
      "end_seconds": 55.72,
      "duration_seconds": 3.1,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.7,
      "end_seconds": 61.3,
      "duration_seconds": 2.6,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.95,
      "end_seconds": 85.03,
      "duration_seconds": 23.08,
      "text": "It usually comes with a swollen calf after a long drive. Actually, the swollen calf after a long drive? That's been for five days. With swollen calf after a long drive, a three out of ten, I suppose. Oh, and a bit breathless since."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.75,
      "end_seconds": 92.66,
      "duration_seconds": 5.91,
      "text": "Have you had fainting once before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.04,
      "end_seconds": 101.23,
      "duration_seconds": 7.19,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.9,
      "end_seconds": 117.65,
      "duration_seconds": 3.75,
      "text": "A few quick ones: coughing up blood or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.81,
      "end_seconds": 122.8,
      "duration_seconds": 3.99,
      "text": "Uh, um, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.58,
      "end_seconds": 127.8,
      "duration_seconds": 4.22,
      "text": "Okay, have you had any chest pain or cough?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.91,
      "end_seconds": 138.3,
      "duration_seconds": 4.39,
      "text": "No chest pain or cough, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.84,
      "end_seconds": 141.71,
      "duration_seconds": 2.87,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.6,
      "end_seconds": 144.91,
      "duration_seconds": 2.31,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.48,
      "end_seconds": 149.18,
      "duration_seconds": 3.7,
      "text": "Okay, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.25,
      "end_seconds": 151.42,
      "duration_seconds": 1.17,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.84,
      "end_seconds": 165.19,
      "duration_seconds": 2.35,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.81,
      "end_seconds": 172.39,
      "duration_seconds": 5.58,
      "text": "Um, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 178.09,
      "duration_seconds": 1.73,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.95,
      "end_seconds": 184.45,
      "duration_seconds": 4.5,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.27,
      "end_seconds": 189.58,
      "duration_seconds": 3.31,
      "text": "So, what line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.01,
      "end_seconds": 196.29,
      "duration_seconds": 5.28,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.85,
      "end_seconds": 199.9,
      "duration_seconds": 2.05,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.36,
      "end_seconds": 204.08,
      "duration_seconds": 2.72,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.84,
      "end_seconds": 208.09,
      "duration_seconds": 2.25,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.95,
      "end_seconds": 212.92,
      "duration_seconds": 3.97,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.18,
      "end_seconds": 231.9,
      "duration_seconds": 2.72,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.01,
      "end_seconds": 240.59,
      "duration_seconds": 7.58,
      "text": "Hmm, I have gout. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.39,
      "end_seconds": 246.95,
      "duration_seconds": 4.56,
      "text": "Ah. Okay, I can see gout in your file as well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.14,
      "end_seconds": 252.05,
      "duration_seconds": 3.91,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.87,
      "end_seconds": 253.88,
      "duration_seconds": 1.01,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 257.08,
      "duration_seconds": 1.44,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.78,
      "end_seconds": 272.61,
      "duration_seconds": 7.83,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.88,
      "end_seconds": 313.26,
      "duration_seconds": 36.38,
      "text": "You can sit up now. Having listened and examined, the most likely explanation is possible pulmonary embolism without chest pain. Another possibility is a simple faint. I'm sending you for a D-dimer because of syncope and calf swelling. That will help us see what's going on underneath and decide the next step. Let's book a CT pulmonary angiogram to look into possible embolus. Even without chest pain this needs a scan today, so please go to hospital."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.13,
      "end_seconds": 325.36,
      "duration_seconds": 10.23,
      "text": "I'm going to send a referral to the emergency team. I'd like to see you again straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.29,
      "end_seconds": 331.75,
      "duration_seconds": 5.46,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    }
  ]
}