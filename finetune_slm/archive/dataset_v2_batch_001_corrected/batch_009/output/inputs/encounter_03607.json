{
  "schema_version": "1.0",
  "encounter_id": "03607",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.56,
      "end_seconds": 4.47,
      "duration_seconds": 3.91,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 8.77,
      "duration_seconds": 3.33,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.29,
      "end_seconds": 15.33,
      "duration_seconds": 5.04,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.78,
      "end_seconds": 19.98,
      "duration_seconds": 3.2,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.01,
      "end_seconds": 26.22,
      "duration_seconds": 5.21,
      "text": "Doctor, it's a late period. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.37,
      "end_seconds": 31.37,
      "duration_seconds": 4.0,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.19,
      "end_seconds": 35.65,
      "duration_seconds": 3.46,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.02,
      "end_seconds": 39.76,
      "duration_seconds": 2.74,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 40.32,
      "end_seconds": 60.82,
      "duration_seconds": 20.5,
      "text": "Mostly severe. And light brown spotting, too. As for feeling slightly dizzy, I honestly can't say when that began. It might have been last month or the month before. I had a vague low ache before. That's settled now, uh, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.4,
      "end_seconds": 65.22,
      "duration_seconds": 2.82,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.62,
      "end_seconds": 72.7,
      "duration_seconds": 3.08,
      "text": "High blood pressure, for two years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.27,
      "end_seconds": 76.78,
      "duration_seconds": 1.51,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.0,
      "end_seconds": 81.69,
      "duration_seconds": 3.69,
      "text": "I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.14,
      "end_seconds": 94.88,
      "duration_seconds": 9.74,
      "text": "Yes, high blood pressure is known to us, good to have that clear. So, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.25,
      "end_seconds": 102.08,
      "duration_seconds": 5.83,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.65,
      "end_seconds": 108.39,
      "duration_seconds": 4.74,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.92,
      "end_seconds": 121.66,
      "duration_seconds": 11.74,
      "text": "I smoke roughly a pack every two days. I live with my elderly mother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.6,
      "end_seconds": 128.75,
      "duration_seconds": 5.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.97,
      "end_seconds": 143.08,
      "duration_seconds": 13.11,
      "text": "Amlodipine. I take it 5 milligrams, once a day for my pressure. I take clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.87,
      "end_seconds": 160.72,
      "duration_seconds": 2.85,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.74,
      "end_seconds": 168.12,
      "duration_seconds": 6.38,
      "text": "Yes, amoxicillin, it gives me hives. Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.81,
      "end_seconds": 173.12,
      "duration_seconds": 3.31,
      "text": "Did you notice any shoulder tip pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.87,
      "end_seconds": 177.62,
      "duration_seconds": 2.75,
      "text": "Nope, no shoulder tip pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.56,
      "end_seconds": 182.45,
      "duration_seconds": 3.89,
      "text": "Have you noticed severe pain, collapse or heavy bleeding?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.38,
      "end_seconds": 186.93,
      "duration_seconds": 2.55,
      "text": "So, none of those, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.12,
      "end_seconds": 190.58,
      "duration_seconds": 2.46,
      "text": "So, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.61,
      "end_seconds": 198.21,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 214.93,
      "end_seconds": 226.25,
      "duration_seconds": 11.32,
      "text": "Doctor, I've got the readings for you. BP is 124 over 69, oxygen saturation is 97 percent, temperature is 36.7 degrees, pulse 85."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.82,
      "end_seconds": 227.92,
      "duration_seconds": 1.1,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.4,
      "end_seconds": 233.73,
      "duration_seconds": 4.33,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.75,
      "end_seconds": 236.68,
      "duration_seconds": 1.93,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.17,
      "end_seconds": 258.91,
      "duration_seconds": 7.74,
      "text": "Your tummy is soft with mild tenderness low on the left and the pregnancy test is positive."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.47,
      "end_seconds": 267.92,
      "duration_seconds": 3.45,
      "text": "Right, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.67,
      "end_seconds": 314.68,
      "duration_seconds": 31.01,
      "text": "Putting it all together, this is probably a pregnancy of unknown location, ectopic not excluded. The reason I say that is that your story and my examination fit together. It could also be a threatened miscarriage, so we'll keep that open. The early pregnancy unit would be the right next step, I'll refer you. The thing that would worry me is if you get severe pain or feel faint. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.87,
      "end_seconds": 317.46,
      "duration_seconds": 1.59,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.51,
      "end_seconds": 324.83,
      "duration_seconds": 5.32,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.66,
      "end_seconds": 330.58,
      "duration_seconds": 3.92,
      "text": "Okay, so no, that's all. Thanks a lot."
    }
  ]
}