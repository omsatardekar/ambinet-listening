{
  "schema_version": "1.0",
  "encounter_id": "03603",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 5.92,
      "duration_seconds": 5.15,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.66,
      "end_seconds": 11.31,
      "duration_seconds": 3.65,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.11,
      "end_seconds": 22.08,
      "duration_seconds": 9.97,
      "text": "Doctor, I'm just here to help with the details. We came because of an itchy red rash on the chest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.65,
      "end_seconds": 26.08,
      "duration_seconds": 2.43,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.47,
      "end_seconds": 30.49,
      "duration_seconds": 3.02,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.37,
      "end_seconds": 35.58,
      "duration_seconds": 3.21,
      "text": "So, any a mild temperature as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.92,
      "end_seconds": 53.51,
      "duration_seconds": 16.59,
      "text": "Yeah. About a week, I'd say. Uh, as for spreading over a week, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.35,
      "end_seconds": 56.96,
      "duration_seconds": 2.61,
      "text": "Have you had any facial swelling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.75,
      "end_seconds": 60.81,
      "duration_seconds": 2.06,
      "text": "No. No facial swelling."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.4,
      "end_seconds": 65.49,
      "duration_seconds": 4.09,
      "text": "Any breathing difficulty, blistering or mouth sores at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.04,
      "end_seconds": 71.84,
      "duration_seconds": 2.8,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.47,
      "end_seconds": 74.68,
      "duration_seconds": 2.21,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.73,
      "end_seconds": 78.17,
      "duration_seconds": 1.44,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.37,
      "end_seconds": 95.53,
      "duration_seconds": 2.16,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.51,
      "end_seconds": 99.82,
      "duration_seconds": 3.31,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.32,
      "end_seconds": 101.56,
      "duration_seconds": 1.24,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.77,
      "end_seconds": 106.55,
      "duration_seconds": 3.78,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.42,
      "end_seconds": 109.48,
      "duration_seconds": 2.06,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.32,
      "end_seconds": 119.25,
      "duration_seconds": 8.93,
      "text": "I take spironolactone, 25 milligrams, once a day for my heart. I take paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 121.02,
      "end_seconds": 129.7,
      "duration_seconds": 8.68,
      "text": "Doctor, I think the last prescription for the paracetamol was 325 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.67,
      "end_seconds": 136.28,
      "duration_seconds": 4.61,
      "text": "So, hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.93,
      "end_seconds": 152.08,
      "duration_seconds": 14.15,
      "text": "I don't think I have it with me. Allopurinol, 100 milligrams, started three weeks ago. I had diclofenac at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.25,
      "end_seconds": 156.95,
      "duration_seconds": 3.7,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.77,
      "end_seconds": 163.58,
      "duration_seconds": 4.81,
      "text": "My sister had breast cancer. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.02,
      "end_seconds": 170.07,
      "duration_seconds": 5.05,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.34,
      "end_seconds": 177.52,
      "duration_seconds": 6.18,
      "text": "Not currently, but as a youngster tramadol gave me feeling very drowsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.37,
      "end_seconds": 194.24,
      "duration_seconds": 2.87,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.58,
      "end_seconds": 201.79,
      "duration_seconds": 6.21,
      "text": "I have gout. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.6,
      "end_seconds": 203.3,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.09,
      "end_seconds": 215.75,
      "duration_seconds": 10.66,
      "text": "I've, I've had heart failure for about a year now. I've had arthritis in my knees for five years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.68,
      "end_seconds": 227.93,
      "duration_seconds": 11.25,
      "text": "Yes, heart failure and arthritis in your knees are known to us, good to have that clear. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.05,
      "end_seconds": 240.99,
      "duration_seconds": 1.94,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.32,
      "end_seconds": 265.05,
      "duration_seconds": 8.73,
      "text": "Okay: pressure 112 over 82, temp 36.9 degrees. And pulse is 67 beats a minute, saturation 98 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.01,
      "end_seconds": 270.68,
      "duration_seconds": 3.67,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.2,
      "end_seconds": 272.15,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.8,
      "end_seconds": 275.76,
      "duration_seconds": 1.96,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.14,
      "end_seconds": 298.05,
      "duration_seconds": 7.91,
      "text": "There is a fine pink rash across the chest and arms, with no blistering and the mouth is clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.97,
      "end_seconds": 330.0,
      "duration_seconds": 28.03,
      "text": "You can sit up now. From what you've told me and what I found, this looks most like a drug rash probably from allopurinol. That's my thinking for now, and it may change as we learn more. A viral rash is also on my list. Stop me if I've got anything wrong. You've had an itchy red rash on the chest, and no breathing difficulty or mouth sores."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.06,
      "end_seconds": 332.58,
      "duration_seconds": 1.52,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.6,
      "end_seconds": 358.36,
      "duration_seconds": 17.76,
      "text": "I'd like you to take cetirizine, 10 milligrams, once a day, one week. That should help with itch. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.73,
      "end_seconds": 365.02,
      "duration_seconds": 3.29,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.76,
      "end_seconds": 377.69,
      "duration_seconds": 11.93,
      "text": "Come back or go to emergency straight away if you develop blisters, mouth sores or facial swelling. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.93,
      "end_seconds": 382.79,
      "duration_seconds": 3.86,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}