{
  "schema_version": "1.0",
  "encounter_id": "03594",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 2.76,
      "duration_seconds": 1.56,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.8,
      "end_seconds": 5.83,
      "duration_seconds": 1.03,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 9.85,
      "duration_seconds": 3.16,
      "text": "So, start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.46,
      "end_seconds": 17.84,
      "duration_seconds": 7.38,
      "text": "Doctor, it's poor appetite for two days. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.6,
      "end_seconds": 21.35,
      "duration_seconds": 1.75,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.13,
      "end_seconds": 29.25,
      "duration_seconds": 6.12,
      "text": "Oh, for four weeks, I'd say. I've also been feeling off."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.17,
      "end_seconds": 42.67,
      "duration_seconds": 3.5,
      "text": "Alright, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.1,
      "end_seconds": 55.61,
      "duration_seconds": 2.51,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.27,
      "end_seconds": 79.07,
      "duration_seconds": 9.8,
      "text": "Okay: SpO2 99 percent on room air, pulse is 81 beats a minute. And pressure 121 over 71, temperature 36.9."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.48,
      "end_seconds": 82.57,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.32,
      "end_seconds": 87.55,
      "duration_seconds": 3.23,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.9,
      "end_seconds": 94.01,
      "duration_seconds": 4.11,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.83,
      "end_seconds": 98.46,
      "duration_seconds": 2.63,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.95,
      "end_seconds": 122.58,
      "duration_seconds": 8.63,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.47,
      "end_seconds": 127.55,
      "duration_seconds": 2.08,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.76,
      "end_seconds": 151.39,
      "duration_seconds": 5.63,
      "text": "So, have you had any vomiting, high fever or urinary symptoms?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.57,
      "end_seconds": 157.49,
      "duration_seconds": 4.92,
      "text": "No vomiting, high fever or urinary symptoms, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.13,
      "end_seconds": 162.33,
      "duration_seconds": 3.2,
      "text": "Did you notice any blood in the stool?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.76,
      "end_seconds": 168.6,
      "duration_seconds": 2.84,
      "text": "No, no blood in the stool."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.67,
      "end_seconds": 173.53,
      "duration_seconds": 3.86,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.97,
      "end_seconds": 176.38,
      "duration_seconds": 1.41,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.61,
      "end_seconds": 182.24,
      "duration_seconds": 2.63,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.36,
      "end_seconds": 195.49,
      "duration_seconds": 12.13,
      "text": "Lots of rice, lentils and some fruit. I'm a bus driver, so I sit for long hours. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.16,
      "end_seconds": 210.46,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.57,
      "end_seconds": 216.63,
      "duration_seconds": 1.06,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 222.18,
      "duration_seconds": 3.56,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.54,
      "end_seconds": 226.53,
      "duration_seconds": 2.99,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.04,
      "end_seconds": 232.79,
      "duration_seconds": 4.75,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.24,
      "end_seconds": 236.45,
      "duration_seconds": 2.21,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.3,
      "end_seconds": 249.06,
      "duration_seconds": 2.76,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.77,
      "end_seconds": 252.58,
      "duration_seconds": 2.81,
      "text": "I'm on telmisartan, once a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.01,
      "end_seconds": 261.07,
      "duration_seconds": 3.06,
      "text": "Alright, and what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.19,
      "end_seconds": 263.21,
      "duration_seconds": 1.02,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.78,
      "end_seconds": 284.43,
      "duration_seconds": 20.65,
      "text": "Right, here's what I'm thinking. This looks most like possible appendicitis, which can look mild in older people. That's my thinking for now, and it may change as we learn more. I'm sending you for a CT scan of the abdomen because of right iliac fossa tenderness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.52,
      "end_seconds": 291.3,
      "duration_seconds": 4.78,
      "text": "Let me think, where would I go for that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.3,
      "end_seconds": 299.27,
      "duration_seconds": 6.97,
      "text": "Even though you look fairly well, I'd like the surgeons to see you today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.74,
      "end_seconds": 316.64,
      "duration_seconds": 16.9,
      "text": "Sure. Let's get you seen by the surgical team, I'll arrange the letter. If the symptoms get worse, or you feel really unwell, please come to the emergency department. I'll want another look straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.58,
      "end_seconds": 319.15,
      "duration_seconds": 1.57,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.59,
      "end_seconds": 321.77,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}