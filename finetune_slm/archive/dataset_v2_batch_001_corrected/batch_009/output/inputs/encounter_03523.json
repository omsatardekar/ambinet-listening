{
  "schema_version": "1.0",
  "encounter_id": "03523",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 6.32,
      "duration_seconds": 5.08,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.36,
      "end_seconds": 11.53,
      "duration_seconds": 3.17,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.3,
      "end_seconds": 17.9,
      "duration_seconds": 1.6,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.69,
      "end_seconds": 26.86,
      "duration_seconds": 7.17,
      "text": "Um, so... back pain that doesn't go away. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.5,
      "end_seconds": 30.25,
      "duration_seconds": 2.75,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.87,
      "end_seconds": 44.45,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.6,
      "end_seconds": 68.96,
      "duration_seconds": 10.36,
      "text": "Okay: oxygen saturation is 95 percent, temperature 39.4, heart rate 102, pressure 125 over 69. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.19,
      "end_seconds": 73.9,
      "duration_seconds": 3.71,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.99,
      "end_seconds": 78.68,
      "duration_seconds": 2.69,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.09,
      "end_seconds": 92.28,
      "duration_seconds": 12.19,
      "text": "It happens every other day. Oh, and night sweats. Had that since last Tuesday. Mm, about night sweats, mild, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.71,
      "end_seconds": 93.64,
      "duration_seconds": 0.93,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.98,
      "end_seconds": 102.13,
      "duration_seconds": 7.15,
      "text": "And I've been feeling tired and run down as well, since last Tuesday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.53,
      "end_seconds": 111.39,
      "duration_seconds": 7.86,
      "text": "Have you had back pain that doesn't go away before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.09,
      "end_seconds": 119.6,
      "duration_seconds": 7.51,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.32,
      "end_seconds": 125.05,
      "duration_seconds": 4.73,
      "text": "Let me check a few things. Any leg weakness or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.12,
      "end_seconds": 129.9,
      "duration_seconds": 3.78,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.6,
      "end_seconds": 135.14,
      "duration_seconds": 4.54,
      "text": "Let me check a few things. Any high fever or breathlessness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.53,
      "end_seconds": 140.29,
      "duration_seconds": 3.76,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.94,
      "end_seconds": 145.96,
      "duration_seconds": 4.02,
      "text": "Okay, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.99,
      "end_seconds": 148.94,
      "duration_seconds": 1.95,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.62,
      "end_seconds": 163.61,
      "duration_seconds": 2.99,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.05,
      "end_seconds": 168.6,
      "duration_seconds": 3.55,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.39,
      "end_seconds": 182.76,
      "duration_seconds": 3.37,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.61,
      "end_seconds": 194.72,
      "duration_seconds": 10.11,
      "text": "Gliclazide, 80 milligrams, twice a day for my sugar. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.51,
      "end_seconds": 199.79,
      "duration_seconds": 4.28,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.46,
      "end_seconds": 202.52,
      "duration_seconds": 2.06,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.27,
      "end_seconds": 206.74,
      "duration_seconds": 3.47,
      "text": "Hm, okay. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.24,
      "end_seconds": 210.73,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.4,
      "end_seconds": 215.34,
      "duration_seconds": 3.94,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.91,
      "end_seconds": 219.93,
      "duration_seconds": 3.02,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.15,
      "end_seconds": 231.71,
      "duration_seconds": 2.56,
      "text": "Right, do you live by yourself?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.12,
      "end_seconds": 237.08,
      "duration_seconds": 3.96,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.46,
      "end_seconds": 239.63,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.46,
      "end_seconds": 243.29,
      "duration_seconds": 2.83,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.26,
      "end_seconds": 246.72,
      "duration_seconds": 2.46,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.52,
      "end_seconds": 254.62,
      "duration_seconds": 6.1,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.15,
      "end_seconds": 258.99,
      "duration_seconds": 2.84,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 261.67,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.03,
      "end_seconds": 281.6,
      "duration_seconds": 7.57,
      "text": "There is a soft heart murmur you've not had before and a small tender spot on the fingertip."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.36,
      "end_seconds": 303.15,
      "duration_seconds": 15.79,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: I don't have a clear answer today: possible infection of the heart valve causing back and general symptoms is possible, and so is a muscle strain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.71,
      "end_seconds": 306.84,
      "duration_seconds": 3.13,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.37,
      "end_seconds": 344.54,
      "duration_seconds": 36.17,
      "text": "Nothing I've seen today points to an emergency. It looks like possible infection of the heart valve causing back and general symptoms, but I'd like to confirm. I'm going to order an MRI of the spine, for persistent back pain with systemic symptoms. The result will help us decide whether anything more is needed. I'd like to arrange an echocardiogram for new murmur. This is not an ordinary back strain, so I want tests today."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.62,
      "end_seconds": 356.19,
      "duration_seconds": 9.57,
      "text": "A short walk every day, even twenty minutes, will help more than you'd think. I think the medical admissions unit should see you too."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.09,
      "end_seconds": 357.79,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.41,
      "end_seconds": 362.78,
      "duration_seconds": 4.37,
      "text": "See me again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.18,
      "end_seconds": 366.39,
      "duration_seconds": 2.21,
      "text": "Alright, thanks, take care."
    }
  ]
}