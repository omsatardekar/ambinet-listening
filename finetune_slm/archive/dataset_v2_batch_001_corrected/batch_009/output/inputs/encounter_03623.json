{
  "schema_version": "1.0",
  "encounter_id": "03623",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 2.93,
      "duration_seconds": 1.55,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.61,
      "end_seconds": 8.75,
      "duration_seconds": 5.14,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.69,
      "end_seconds": 15.82,
      "duration_seconds": 5.13,
      "text": "Well, I've been having an ache in my jaw."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.31,
      "end_seconds": 20.83,
      "duration_seconds": 3.52,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.27,
      "end_seconds": 25.64,
      "duration_seconds": 3.37,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.23,
      "end_seconds": 35.32,
      "duration_seconds": 9.09,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.4,
      "end_seconds": 40.61,
      "duration_seconds": 4.21,
      "text": "Rest helps a bit. I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.12,
      "end_seconds": 58.17,
      "duration_seconds": 4.05,
      "text": "Have you noticed fever, leg swelling or crushing chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 64.63,
      "duration_seconds": 5.32,
      "text": "I haven't had fever, leg swelling or crushing chest pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.98,
      "end_seconds": 72.01,
      "duration_seconds": 3.03,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.89,
      "end_seconds": 79.24,
      "duration_seconds": 2.35,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.76,
      "end_seconds": 98.01,
      "duration_seconds": 5.25,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.26,
      "end_seconds": 113.3,
      "duration_seconds": 14.04,
      "text": "I walk the dog every morning. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.88,
      "end_seconds": 116.24,
      "duration_seconds": 2.36,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.49,
      "end_seconds": 120.56,
      "duration_seconds": 3.07,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.4,
      "end_seconds": 123.57,
      "duration_seconds": 2.17,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.99,
      "end_seconds": 136.79,
      "duration_seconds": 11.8,
      "text": "Telmisartan. I take it 40 milligrams, once a day for my pressure. Erm, I take glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.66,
      "end_seconds": 142.63,
      "duration_seconds": 3.97,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.47,
      "end_seconds": 149.92,
      "duration_seconds": 6.45,
      "text": "I've had high blood pressure for two years now. I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.76,
      "end_seconds": 152.97,
      "duration_seconds": 1.21,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.82,
      "end_seconds": 157.41,
      "duration_seconds": 3.59,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.48,
      "end_seconds": 161.25,
      "duration_seconds": 2.77,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.77,
      "end_seconds": 176.73,
      "duration_seconds": 2.96,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.96,
      "end_seconds": 192.47,
      "duration_seconds": 2.51,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.03,
      "end_seconds": 213.35,
      "duration_seconds": 11.32,
      "text": "Okay: pulse is 111 beats a minute, respiratory rate 19, temperature 36.9, SpO2 98 percent on room air, blood pressure 121 over 86."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.88,
      "end_seconds": 219.16,
      "duration_seconds": 4.28,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.09,
      "end_seconds": 222.44,
      "duration_seconds": 1.35,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.05,
      "end_seconds": 248.18,
      "duration_seconds": 7.13,
      "text": "Your heart sounds are normal and your tummy is soft, but your pulse is a little fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.96,
      "end_seconds": 253.6,
      "duration_seconds": 1.64,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.67,
      "end_seconds": 293.4,
      "duration_seconds": 21.73,
      "text": "So, based on the history and the examination, my working impression is possible heart attack despite no classic chest pain. Let me just check I've got this right. You've had an ache in your jaw for four weeks, moderate, and no fever or crushing chest pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.43,
      "end_seconds": 298.14,
      "duration_seconds": 1.71,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.93,
      "end_seconds": 329.21,
      "duration_seconds": 29.28,
      "text": "I'm going to order a troponin test, for possible heart attack. I'm going to put you on aspirin, 300 milligrams, once now, single dose. It's for possible heart attack. Diabetes can hide the usual pain, so I am treating this as a heart problem until proven otherwise. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'm going to send a referral to the cardiology team."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.76,
      "end_seconds": 331.42,
      "duration_seconds": 1.66,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.79,
      "end_seconds": 350.46,
      "duration_seconds": 15.67,
      "text": "Let's hold off on an ECG for now, and if there's no change next month we can revisit it. I'd like to see you again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.71,
      "end_seconds": 354.72,
      "duration_seconds": 3.01,
      "text": "So, alright, thanks, take care."
    }
  ]
}