      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.0,
      "end_seconds": 25.5,
      "duration_seconds": 7.5,
      "text": "Honestly, it's a painful ulcer that is growing quickly, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.19,
      "end_seconds": 29.7,
      "duration_seconds": 3.51,
      "text": "Can you tell me when it first started?"
