      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.08,
      "end_seconds": 51.62,
      "duration_seconds": 16.54,
      "text": "Three weeks, I think... sorry, four weeks, I got that wrong. I've had starting as a pimple too, uh, for two weeks. About starting as a pimple, it's severe, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.52,
      "end_seconds": 71.83,
      "duration_seconds": 1.31,
      "text": "What about diabetes?"
