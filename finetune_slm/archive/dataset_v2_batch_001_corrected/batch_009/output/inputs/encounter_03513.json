      "start_seconds": 0.75,
      "end_seconds": 7.55,
      "duration_seconds": 6.8,
      "text": "Doctor, um, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.56,
      "end_seconds": 14.26,
      "duration_seconds": 4.7,
      "text": "Not at all, please sit. What seems to be wrong?"
