{
  "schema_version": "1.0",
  "encounter_id": "03549",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.82,
      "duration_seconds": 4.56,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.95,
      "end_seconds": 11.11,
      "duration_seconds": 4.16,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.84,
      "end_seconds": 29.84,
      "duration_seconds": 17.0,
      "text": "Honestly, it's a vague tummy ache, and my family pushed me to come. I've been reading about it online and it worried me. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.71,
      "end_seconds": 35.02,
      "duration_seconds": 3.31,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.03,
      "end_seconds": 38.03,
      "duration_seconds": 2.0,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.6,
      "end_seconds": 39.3,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.14,
      "end_seconds": 53.46,
      "duration_seconds": 13.32,
      "text": "I've had poor appetite for two days too, for two days. There's being a bit constipated as well. With being a bit constipated, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.07,
      "end_seconds": 60.68,
      "duration_seconds": 6.61,
      "text": "Right, have you had a vague tummy ache before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.33,
      "end_seconds": 67.0,
      "duration_seconds": 5.67,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.17,
      "end_seconds": 72.11,
      "duration_seconds": 1.94,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.09,
      "end_seconds": 88.12,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.25,
      "end_seconds": 109.89,
      "duration_seconds": 12.64,
      "text": "Okay: BP is 108 over 80, temperature is 36.8 degrees. And respiratory rate 15, pulse is 81 beats a minute, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.41,
      "end_seconds": 112.6,
      "duration_seconds": 2.19,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.52,
      "end_seconds": 119.01,
      "duration_seconds": 4.49,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.4,
      "end_seconds": 124.88,
      "duration_seconds": 3.48,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.69,
      "end_seconds": 128.82,
      "duration_seconds": 2.13,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.56,
      "end_seconds": 146.46,
      "duration_seconds": 9.9,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.63,
      "end_seconds": 160.57,
      "duration_seconds": 9.94,
      "text": "Thank you, you can get dressed. Let me check a few things. Any blood in the stool, vomiting or high fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.46,
      "end_seconds": 165.76,
      "duration_seconds": 3.3,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 170.6,
      "duration_seconds": 2.75,
      "text": "Have you had any urinary symptoms?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.9,
      "end_seconds": 175.26,
      "duration_seconds": 3.36,
      "text": "I haven't noticed any urinary symptoms."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.01,
      "end_seconds": 178.18,
      "duration_seconds": 2.17,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.08,
      "end_seconds": 181.63,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.69,
      "end_seconds": 186.07,
      "duration_seconds": 3.38,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.12,
      "end_seconds": 189.08,
      "duration_seconds": 1.96,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.05,
      "end_seconds": 208.07,
      "duration_seconds": 2.02,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 211.19,
      "duration_seconds": 2.31,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.22,
      "end_seconds": 214.16,
      "duration_seconds": 1.94,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.55,
      "end_seconds": 216.64,
      "duration_seconds": 1.09,
      "text": "Yes, anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.38,
      "end_seconds": 227.58,
      "duration_seconds": 9.2,
      "text": "Yes, anxiety is known to us, good to have that clear. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.06,
      "end_seconds": 237.7,
      "duration_seconds": 6.64,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.28,
      "end_seconds": 239.51,
      "duration_seconds": 1.23,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.8,
      "end_seconds": 242.81,
      "duration_seconds": 2.01,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.52,
      "end_seconds": 244.89,
      "duration_seconds": 1.37,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.54,
      "end_seconds": 249.72,
      "duration_seconds": 3.18,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.51,
      "end_seconds": 253.11,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.06,
      "end_seconds": 257.38,
      "duration_seconds": 2.32,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.32,
      "end_seconds": 260.89,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.76,
      "end_seconds": 266.94,
      "duration_seconds": 4.18,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.63,
      "end_seconds": 284.51,
      "duration_seconds": 2.88,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.37,
      "end_seconds": 296.85,
      "duration_seconds": 7.48,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.51,
      "end_seconds": 303.81,
      "duration_seconds": 5.3,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.81,
      "end_seconds": 309.77,
      "duration_seconds": 1.96,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.04,
      "end_seconds": 322.32,
      "duration_seconds": 11.28,
      "text": "From what you've told me and what I found, the most likely explanation is possible appendicitis, which can look mild in older people."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.11,
      "end_seconds": 359.02,
      "duration_seconds": 23.91,
      "text": "I'm going to order blood tests, for abdominal pain. Let's get a CT scan of the abdomen, for right iliac fossa tenderness. Even though you look fairly well, I'd like the surgeons to see you today. I think the surgical team should see you too. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.94,
      "end_seconds": 361.54,
      "duration_seconds": 1.6,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.59,
      "end_seconds": 368.21,
      "duration_seconds": 5.62,
      "text": "We'll catch up straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.18,
      "end_seconds": 371.46,
      "duration_seconds": 2.28,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.75,
      "end_seconds": 375.21,
      "duration_seconds": 1.46,
      "text": "Look after yourself."
    }
  ]
}