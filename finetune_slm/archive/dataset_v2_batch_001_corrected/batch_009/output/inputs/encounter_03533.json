  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.84,
      "duration_seconds": 4.96,
      "text": "Hmm, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.65,
      "end_seconds": 12.12,
      "duration_seconds": 4.47,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.5,
      "end_seconds": 21.69,
      "duration_seconds": 8.19,
      "text": "Right, doctor, it's seen putting a coin-like object in his mouth. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.07,
      "end_seconds": 27.35,
      "duration_seconds": 4.28,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.03,
      "end_seconds": 34.42,
      "duration_seconds": 6.39,
      "text": "Okay, so I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.05,
      "end_seconds": 45.26,
      "duration_seconds": 1.21,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.35,
      "end_seconds": 49.04,
      "duration_seconds": 2.69,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.82,
      "end_seconds": 67.91,
      "duration_seconds": 4.09,
      "text": "Have you had any vomiting blood or breathing difficulty?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.53,
      "end_seconds": 73.25,
      "duration_seconds": 3.72,
      "text": "um, no, none of those at all"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.03,
      "end_seconds": 76.69,
      "duration_seconds": 2.66,
      "text": "And what about fever or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.54,
      "end_seconds": 83.29,
      "duration_seconds": 4.75,
      "text": "I mean, I haven't had fever or rash, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.38,
      "end_seconds": 88.24,
      "duration_seconds": 3.86,
      "text": "on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.64,
      "end_seconds": 92.53,
      "duration_seconds": 2.89,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.37,
      "end_seconds": 99.77,
      "duration_seconds": 5.4,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.82,
      "end_seconds": 104.86,
      "duration_seconds": 4.04,
      "text": "Oh, no, not that I know of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.38,
      "end_seconds": 111.51,
      "duration_seconds": 5.13,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.0,
      "end_seconds": 130.51,
      "duration_seconds": 14.51,
      "text": "I smoke roughly a pack every two days. I swim twice a week. I'm a hairdresser, on my feet all day. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.96,
      "end_seconds": 135.15,
      "duration_seconds": 3.19,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.35,
      "end_seconds": 142.09,
      "duration_seconds": 5.74,
      "text": "I've got eczema. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 149.5,
      "duration_seconds": 3.95,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.62,
      "end_seconds": 162.78,
      "duration_seconds": 2.16,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.47,
      "end_seconds": 184.64,
      "duration_seconds": 7.17,
      "text": "Okay: pulse is 82 beats a minute, pressure 121 over 73, temperature 37.0, respiratory rate 14."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.66,
      "end_seconds": 188.03,
      "duration_seconds": 1.37,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.66,
      "end_seconds": 191.77,
      "duration_seconds": 2.11,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.15,
      "end_seconds": 197.93,
      "duration_seconds": 3.78,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.9,
      "end_seconds": 200.23,
      "duration_seconds": 1.33,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.93,
      "end_seconds": 222.12,
      "duration_seconds": 4.19,
      "text": "He is playful, breathing normally and the throat looks normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.75,
      "end_seconds": 228.44,
      "duration_seconds": 2.69,
      "text": "So, you can sit up now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.25,
      "end_seconds": 247.6,
      "duration_seconds": 11.35,
      "text": "So, based on the history and the examination, this looks most like a possible swallowed button battery needing an urgent X-ray despite few symptoms."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.74,
      "end_seconds": 270.79,
      "duration_seconds": 6.05,
      "text": "I want an urgent chest and abdominal X-ray done, that's for possible battery ingestion"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.43,
      "end_seconds": 273.74,
      "duration_seconds": 2.31,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.78,
      "end_seconds": 289.1,
      "duration_seconds": 13.32,
      "text": "a button battery can burn the gullet within hours even when a child looks well, so we scan now. Come back or go to emergency straight away if the symptoms get worse"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.17,
      "end_seconds": 291.86,
      "duration_seconds": 1.69,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.4,
      "end_seconds": 299.56,
      "duration_seconds": 7.16,
      "text": "please come and see me straight away right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.91,
      "end_seconds": 303.98,
      "duration_seconds": 3.07,
      "text": "I think I understand everything. Thanks."
    }
  ]
}