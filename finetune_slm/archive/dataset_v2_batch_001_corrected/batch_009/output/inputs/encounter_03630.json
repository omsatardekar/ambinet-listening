  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 5.99,
      "duration_seconds": 5.28,
      "text": "Let me think, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.97,
      "end_seconds": 13.13,
      "duration_seconds": 4.16,
      "text": "no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.25,
      "end_seconds": 22.47,
      "duration_seconds": 6.22,
      "text": "honestly, it's light brown spotting, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.23,
      "end_seconds": 26.45,
      "duration_seconds": 3.22,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.76,
      "end_seconds": 39.9,
      "duration_seconds": 8.14,
      "text": "it's been going on for four weeks. I'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.99,
      "end_seconds": 44.2,
      "duration_seconds": 3.21,
      "text": "has there been a vague low ache too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.25,
      "end_seconds": 48.01,
      "duration_seconds": 1.76,
      "text": "yeah, that too"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.22,
      "end_seconds": 49.14,
      "duration_seconds": 0.92,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.72,
      "end_seconds": 63.82,
      "duration_seconds": 3.1,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.36,
      "end_seconds": 76.33,
      "duration_seconds": 11.97,
      "text": "I do a yoga class on Thursdays. I grab fast food at lunch most days. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.75,
      "end_seconds": 81.33,
      "duration_seconds": 3.58,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.44,
      "end_seconds": 85.9,
      "duration_seconds": 3.46,
      "text": "I've had eczema for five years now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.07,
      "end_seconds": 99.8,
      "duration_seconds": 8.73,
      "text": "So, yes, eczema is known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.84,
      "end_seconds": 104.25,
      "duration_seconds": 3.41,
      "text": "Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.12,
      "end_seconds": 120.77,
      "duration_seconds": 3.65,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.75,
      "end_seconds": 125.07,
      "duration_seconds": 3.32,
      "text": "Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.06,
      "end_seconds": 141.72,
      "duration_seconds": 4.66,
      "text": "so, have you noticed heavy bleeding, shoulder tip pain or collapse?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.58,
      "end_seconds": 149.93,
      "duration_seconds": 6.35,
      "text": "I haven't had heavy bleeding, shoulder tip pain or collapse, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.09,
      "end_seconds": 158.94,
      "duration_seconds": 2.85,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.13,
      "end_seconds": 161.92,
      "duration_seconds": 1.79,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.62,
      "end_seconds": 178.22,
      "duration_seconds": 3.6,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.46,
      "end_seconds": 189.37,
      "duration_seconds": 2.91,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.32,
      "end_seconds": 210.57,
      "duration_seconds": 8.25,
      "text": "Okay: saturation 99 percent, respiratory rate 18, pulse is 67 beats a minute. And blood pressure 122 over 76."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.42,
      "end_seconds": 214.69,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.9,
      "end_seconds": 217.87,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.56,
      "end_seconds": 236.58,
      "duration_seconds": 7.02,
      "text": "Your tummy is soft with mild tenderness low on the left and and the pregnancy test is positive."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.8,
      "end_seconds": 239.39,
      "duration_seconds": 1.59,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.62,
      "end_seconds": 254.47,
      "duration_seconds": 12.85,
      "text": "Please sit back down. Okay, so my impression is this: I think we're dealing with a pregnancy of unknown location, ectopic not excluded at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.54,
      "end_seconds": 260.73,
      "duration_seconds": 5.19,
      "text": "Sorry, what was I saying, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.34,
      "end_seconds": 286.46,
      "duration_seconds": 24.12,
      "text": "I can't promise yet, but most people with a pregnancy of unknown location, ectopic not excluded do well once it's treated properly. I want a pregnancy test done, that's for late period and spotting. Even with little pain this needs a scan within a day, and go to hospital if the pain gets worse"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.97,
      "end_seconds": 293.11,
      "duration_seconds": 6.14,
      "text": "Right, right. Let's get you seen by the early pregnancy unit, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.88,
      "end_seconds": 294.58,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.92,
      "end_seconds": 308.53,
      "duration_seconds": 12.61,
      "text": "I'm not ordering an early pregnancy scan today. If things carry on in a month, we'll consider it. Let's plan a check tomorrow. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.9,
      "end_seconds": 312.1,
      "duration_seconds": 2.2,
      "text": "thank you, doctor, goodbye"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.11,
      "end_seconds": 314.45,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}