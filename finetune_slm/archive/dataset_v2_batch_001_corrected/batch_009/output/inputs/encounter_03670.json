  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 3.76,
      "duration_seconds": 2.65,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.53,
      "end_seconds": 8.53,
      "duration_seconds": 3.0,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.4,
      "end_seconds": 14.55,
      "duration_seconds": 4.15,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.01,
      "end_seconds": 19.74,
      "duration_seconds": 3.73,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.26,
      "end_seconds": 26.32,
      "duration_seconds": 5.06,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.99,
      "end_seconds": 29.81,
      "duration_seconds": 2.82,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.73,
      "end_seconds": 38.78,
      "duration_seconds": 8.05,
      "text": "Doctor, it's a sore spot on the front of my shin. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.65,
      "end_seconds": 43.17,
      "duration_seconds": 3.52,
      "text": "Alright, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.65,
      "end_seconds": 46.69,
      "duration_seconds": 2.04,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.15,
      "end_seconds": 51.04,
      "duration_seconds": 3.89,
      "text": "Mm-hmm. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.56,
      "end_seconds": 54.99,
      "duration_seconds": 3.43,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.75,
      "end_seconds": 65.12,
      "duration_seconds": 5.37,
      "text": "What about being told it was shin splints, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.69,
      "end_seconds": 66.83,
      "duration_seconds": 1.14,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.51,
      "end_seconds": 74.74,
      "duration_seconds": 2.23,
      "text": "Right, any numbness or injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.61,
      "end_seconds": 79.98,
      "duration_seconds": 3.37,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.86,
      "end_seconds": 84.84,
      "duration_seconds": 3.98,
      "text": "Let me check a few things. Any swelling or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.54,
      "end_seconds": 89.85,
      "duration_seconds": 3.31,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.78,
      "end_seconds": 96.9,
      "duration_seconds": 2.12,
      "text": "Right, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.32,
      "end_seconds": 100.12,
      "duration_seconds": 1.8,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.6,
      "end_seconds": 106.04,
      "duration_seconds": 4.44,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.28,
      "end_seconds": 110.68,
      "duration_seconds": 3.4,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.63,
      "end_seconds": 120.27,
      "duration_seconds": 7.64,
      "text": "Alright, high blood pressure, that matches what I have here. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.39,
      "end_seconds": 125.38,
      "duration_seconds": 3.99,
      "text": "Right, uh, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.0,
      "end_seconds": 128.87,
      "duration_seconds": 2.87,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.27,
      "end_seconds": 144.37,
      "duration_seconds": 11.1,
      "text": "I walk the dog every morning. I live with my elderly mother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.81,
      "end_seconds": 162.09,
      "duration_seconds": 2.28,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 176.74,
      "duration_seconds": 13.88,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, every morning. I'd rather know what's going on than keep guessing. Sorry, what was I saying, I take ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.69,
      "end_seconds": 181.05,
      "duration_seconds": 2.36,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.25,
      "end_seconds": 184.08,
      "duration_seconds": 1.83,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.3,
      "end_seconds": 185.11,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.66,
      "end_seconds": 204.02,
      "duration_seconds": 2.36,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.8,
      "end_seconds": 219.51,
      "duration_seconds": 2.71,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.71,
      "end_seconds": 248.33,
      "duration_seconds": 8.62,
      "text": "Okay: temperature is 36.5 degrees, SpO2 97 percent on room air, pulse 70, blood pressure 120 over 76."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.61,
      "end_seconds": 252.81,
      "duration_seconds": 2.2,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.53,
      "end_seconds": 255.23,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.58,
      "end_seconds": 257.89,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.55,
      "end_seconds": 277.02,
      "duration_seconds": 7.47,
      "text": "There is a very localised tender spot on the bone and hopping on that leg hurts."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.57,
      "end_seconds": 284.94,
      "duration_seconds": 2.37,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.89,
      "end_seconds": 316.32,
      "duration_seconds": 18.43,
      "text": "A vitamin D level is what I'd like next, for stress fracture. Stop running, no impact exercise until the scan, swimming or cycling is fine. Come back after the scan. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.38,
      "end_seconds": 320.28,
      "duration_seconds": 2.9,
      "text": "Oh, thank you, that's helpful."
    }
  ]
}