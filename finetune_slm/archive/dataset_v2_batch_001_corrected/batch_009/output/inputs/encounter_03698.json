{
  "schema_version": "1.0",
  "encounter_id": "03698",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 6.36,
      "duration_seconds": 5.24,
      "text": "Let me think, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 12.3,
      "duration_seconds": 4.53,
      "text": "So, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 27.34,
      "duration_seconds": 10.01,
      "text": "Let me think, mainly tingling in my feet. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.84,
      "end_seconds": 32.0,
      "duration_seconds": 3.16,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.33,
      "end_seconds": 40.32,
      "duration_seconds": 3.99,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.83,
      "end_seconds": 46.31,
      "duration_seconds": 5.48,
      "text": "Okay, go on. Okay, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.64,
      "end_seconds": 51.33,
      "duration_seconds": 3.69,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.91,
      "end_seconds": 54.68,
      "duration_seconds": 2.77,
      "text": "Yes. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.27,
      "end_seconds": 73.99,
      "duration_seconds": 17.72,
      "text": "Mild bloating goes along with it, most of the time. Right, the mild bloating? That's been for about three months. Um, um, I've had being unsteady too, for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.05,
      "end_seconds": 81.59,
      "duration_seconds": 6.54,
      "text": "Have you had tingling in your feet before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.81,
      "end_seconds": 89.09,
      "duration_seconds": 6.28,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.87,
      "end_seconds": 93.02,
      "duration_seconds": 3.15,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.67,
      "end_seconds": 101.09,
      "duration_seconds": 6.42,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.0,
      "end_seconds": 113.53,
      "duration_seconds": 4.53,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.18,
      "end_seconds": 122.7,
      "duration_seconds": 3.52,
      "text": "Erm, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.06,
      "end_seconds": 126.57,
      "duration_seconds": 2.51,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.18,
      "end_seconds": 133.19,
      "duration_seconds": 6.01,
      "text": "Yeah, I've had high cholesterol for about ten years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.07,
      "end_seconds": 135.77,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.29,
      "end_seconds": 140.91,
      "duration_seconds": 4.62,
      "text": "I have an irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.78,
      "end_seconds": 147.35,
      "duration_seconds": 4.57,
      "text": "Alright, an irregular heartbeat, that matches what I have here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.03,
      "end_seconds": 162.16,
      "duration_seconds": 2.13,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.83,
      "end_seconds": 168.19,
      "duration_seconds": 4.36,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.42,
      "end_seconds": 176.25,
      "duration_seconds": 2.83,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.27,
      "end_seconds": 182.77,
      "duration_seconds": 5.5,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.6,
      "end_seconds": 187.61,
      "duration_seconds": 4.01,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.03,
      "end_seconds": 202.88,
      "duration_seconds": 10.85,
      "text": "Mm, I take rosuvastatin, 10 milligrams, at night. Right, uh, it's warfarin, 3 milligrams, maybe, in the evening."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.71,
      "end_seconds": 207.71,
      "duration_seconds": 3.0,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.79,
      "end_seconds": 222.63,
      "duration_seconds": 13.84,
      "text": "Sorry, what was I saying, no, it's at home. So, you know, I had atorvastatin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.34,
      "end_seconds": 228.98,
      "duration_seconds": 5.64,
      "text": "Did you get back pain, bladder problems, diarrhoea or weight loss?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.45,
      "end_seconds": 235.72,
      "duration_seconds": 5.27,
      "text": "Right, um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.62,
      "end_seconds": 238.7,
      "duration_seconds": 2.08,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.55,
      "end_seconds": 241.28,
      "duration_seconds": 1.73,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.77,
      "end_seconds": 245.38,
      "duration_seconds": 2.61,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.95,
      "end_seconds": 247.49,
      "duration_seconds": 1.54,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.57,
      "end_seconds": 267.93,
      "duration_seconds": 2.36,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.93,
      "end_seconds": 280.6,
      "duration_seconds": 2.67,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.59,
      "end_seconds": 313.89,
      "duration_seconds": 12.3,
      "text": "Okay: saturation 97 percent, heart rate 76, blood pressure 110 over 68, weight 70 kilos, height 165 centimetres, BMI works out to 25.7, respiratory rate 17."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.21,
      "end_seconds": 317.3,
      "duration_seconds": 2.09,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 323.07,
      "duration_seconds": 3.71,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.08,
      "end_seconds": 329.56,
      "duration_seconds": 4.48,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.79,
      "end_seconds": 331.49,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.69,
      "end_seconds": 335.51,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.83,
      "end_seconds": 350.3,
      "duration_seconds": 7.47,
      "text": "The feeling in your feet is reduced and your balance with the eyes closed is poor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.94,
      "end_seconds": 386.13,
      "duration_seconds": 30.19,
      "text": "Alright, that's the examination finished. I think an HbA1c makes sense here, for neuropathy. Please keep eating gluten normally until the coeliac test is done. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. A B12 level is something we might do if this doesn't improve in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.0,
      "end_seconds": 391.85,
      "duration_seconds": 1.85,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.97,
      "end_seconds": 394.22,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}