      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.49,
      "end_seconds": 306.77,
      "duration_seconds": 16.28,
      "text": "keep an eye out and if you get severe pain or feel faint call us the same day or go to emergency. Come back tomorrow. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
