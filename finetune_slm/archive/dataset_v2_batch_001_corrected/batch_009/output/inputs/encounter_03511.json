    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.43,
      "end_seconds": 225.81,
      "duration_seconds": 2.38,
      "text": "Let's move on to the examination."
