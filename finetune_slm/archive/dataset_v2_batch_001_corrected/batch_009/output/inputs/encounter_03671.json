{
  "schema_version": "1.0",
  "encounter_id": "03671",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.56,
      "duration_seconds": 4.58,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.19,
      "end_seconds": 10.8,
      "duration_seconds": 4.61,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.34,
      "end_seconds": 17.33,
      "duration_seconds": 4.99,
      "text": "I'm here because of a painful ulcer that is growing quickly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.21,
      "end_seconds": 21.38,
      "duration_seconds": 2.17,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.18,
      "end_seconds": 24.84,
      "duration_seconds": 2.66,
      "text": "it's been ten days now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.04,
      "end_seconds": 28.38,
      "duration_seconds": 3.34,
      "text": "Yes. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.89,
      "end_seconds": 31.32,
      "duration_seconds": 1.43,
      "text": "I'd say moderate"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.51,
      "end_seconds": 40.42,
      "duration_seconds": 5.91,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.5,
      "end_seconds": 55.67,
      "duration_seconds": 13.17,
      "text": "I'd say on and off. And starting as a pimple, too. I did have belly cramps and loose stools at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.73,
      "end_seconds": 62.67,
      "duration_seconds": 4.94,
      "text": "A few quick ones: recent cut, recent injury or diabetes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.43,
      "end_seconds": 66.37,
      "duration_seconds": 2.94,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.42,
      "end_seconds": 69.34,
      "duration_seconds": 0.92,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.58,
      "end_seconds": 72.4,
      "duration_seconds": 1.82,
      "text": "nope, no fever"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.91,
      "end_seconds": 78.24,
      "duration_seconds": 5.33,
      "text": "I see, go ahead. On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.5,
      "end_seconds": 81.11,
      "duration_seconds": 1.61,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.62,
      "end_seconds": 85.51,
      "duration_seconds": 2.89,
      "text": "alright, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.68,
      "end_seconds": 89.41,
      "duration_seconds": 2.73,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.56,
      "end_seconds": 105.36,
      "duration_seconds": 4.8,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.38,
      "end_seconds": 109.78,
      "duration_seconds": 3.4,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 127.02,
      "duration_seconds": 5.19,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.83,
      "end_seconds": 137.45,
      "duration_seconds": 9.62,
      "text": "No, I share a house with my brother. I walk the dog every morning. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.19,
      "end_seconds": 142.53,
      "duration_seconds": 3.34,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.39,
      "end_seconds": 153.43,
      "duration_seconds": 10.04,
      "text": "Tamsulosin. I take it 0.4 milligrams, at night. It's clopidogrel, 75 milligrams, once a day for the stent."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.63,
      "end_seconds": 157.4,
      "duration_seconds": 2.77,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.32,
      "end_seconds": 163.14,
      "duration_seconds": 4.82,
      "text": "Well, I have an enlarged prostate, for about a year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.42,
      "end_seconds": 167.71,
      "duration_seconds": 1.29,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.57,
      "end_seconds": 174.26,
      "duration_seconds": 1.69,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.01,
      "end_seconds": 183.35,
      "duration_seconds": 8.34,
      "text": "yes, an enlarged prostate is known to us, good to have that clear. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.35,
      "end_seconds": 191.93,
      "duration_seconds": 6.58,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.88,
      "end_seconds": 196.42,
      "duration_seconds": 2.54,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.6,
      "end_seconds": 212.85,
      "duration_seconds": 3.25,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.14,
      "end_seconds": 237.97,
      "duration_seconds": 5.83,
      "text": "Okay: respiratory rate 15, BP is 108 over 78, pulse 65, temperature 36.9."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.96,
      "end_seconds": 240.6,
      "duration_seconds": 1.64,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.51,
      "end_seconds": 244.32,
      "duration_seconds": 2.81,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.69,
      "end_seconds": 249.32,
      "duration_seconds": 3.63,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 254.3,
      "duration_seconds": 3.93,
      "text": "Stay as you are for a a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.96,
      "end_seconds": 274.58,
      "duration_seconds": 5.62,
      "text": "The ulcer has a ragged purple edge with a boggy base and undermined borders."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.26,
      "end_seconds": 290.56,
      "duration_seconds": 11.3,
      "text": "You can sit up now. Let me tell you where I've got to. It fits best with possible pyoderma gangrenosum linked to bowel inflammation."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 304.99,
      "duration_seconds": 3.47,
      "text": "I'm going to order blood tests, for ulcer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.68,
      "end_seconds": 308.37,
      "duration_seconds": 1.69,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.69,
      "end_seconds": 313.66,
      "duration_seconds": 3.97,
      "text": "We should do a stool test for bowel symptoms."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.1,
      "end_seconds": 316.8,
      "duration_seconds": 1.7,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.96,
      "end_seconds": 348.73,
      "duration_seconds": 30.77,
      "text": "Do not cut or scrub it, that can make it worse. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. We'll refer you to the dermatology clinic. A skin biopsy is something we might do if this doesn't improve in two weeks. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.8,
      "end_seconds": 354.08,
      "duration_seconds": 3.28,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.29,
      "end_seconds": 362.09,
      "duration_seconds": 6.8,
      "text": "I'll want another look after the biopsy. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.82,
      "end_seconds": 367.81,
      "duration_seconds": 3.99,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.35,
      "end_seconds": 370.8,
      "duration_seconds": 2.45,
      "text": "Have a a good day."
    }
  ]
}