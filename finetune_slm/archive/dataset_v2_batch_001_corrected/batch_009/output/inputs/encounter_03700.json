{
  "schema_version": "1.0",
  "encounter_id": "03700",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 5.4,
      "duration_seconds": 4.69,
      "text": "Morning, come on through. So, what's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.11,
      "end_seconds": 15.58,
      "duration_seconds": 8.47,
      "text": "Yeah, honestly, it's a vague tummy ache, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.59,
      "end_seconds": 20.51,
      "duration_seconds": 2.92,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.13,
      "end_seconds": 28.17,
      "duration_seconds": 7.04,
      "text": "Three weeks, I think... sorry, about two weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.4,
      "end_seconds": 33.36,
      "duration_seconds": 4.96,
      "text": "Sure. Okay, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.44,
      "end_seconds": 44.05,
      "duration_seconds": 9.61,
      "text": "I, I'd call it moderate. I've had being a bit constipated too, for about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.55,
      "end_seconds": 52.17,
      "duration_seconds": 7.62,
      "text": "Hm, okay. A few quick ones: urinary symptoms, blood in the stool, vomiting or high fever?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.55,
      "end_seconds": 61.45,
      "duration_seconds": 7.9,
      "text": "Erm, no urinary symptoms, blood in the stool, vomiting or high fever, none of it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.99,
      "end_seconds": 65.33,
      "duration_seconds": 2.34,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.36,
      "end_seconds": 70.93,
      "duration_seconds": 3.57,
      "text": "Right, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.9,
      "end_seconds": 77.99,
      "duration_seconds": 2.09,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.36,
      "end_seconds": 83.11,
      "duration_seconds": 3.75,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.94,
      "end_seconds": 101.48,
      "duration_seconds": 2.54,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.46,
      "end_seconds": 108.23,
      "duration_seconds": 4.77,
      "text": "I, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.58,
      "end_seconds": 111.72,
      "duration_seconds": 2.14,
      "text": "Alright, how are your meals?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.15,
      "end_seconds": 117.47,
      "duration_seconds": 4.32,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.25,
      "end_seconds": 120.28,
      "duration_seconds": 2.03,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.8,
      "end_seconds": 124.71,
      "duration_seconds": 3.91,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.63,
      "end_seconds": 131.51,
      "duration_seconds": 4.88,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.37,
      "end_seconds": 135.06,
      "duration_seconds": 2.69,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.66,
      "end_seconds": 153.97,
      "duration_seconds": 3.31,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.94,
      "end_seconds": 164.0,
      "duration_seconds": 8.06,
      "text": "Sorry, what was I saying, I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.87,
      "end_seconds": 172.16,
      "duration_seconds": 7.29,
      "text": "Alright, high blood pressure, that matches what I have here. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 185.28,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.07,
      "end_seconds": 206.06,
      "duration_seconds": 6.99,
      "text": "Okay: BP is 113 over 78, saturation 98 percent, heart rate 74, respiratory rate 17."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.5,
      "end_seconds": 209.17,
      "duration_seconds": 1.67,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.54,
      "end_seconds": 216.83,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.44,
      "end_seconds": 223.36,
      "duration_seconds": 3.92,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.69,
      "end_seconds": 226.96,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.76,
      "end_seconds": 246.07,
      "duration_seconds": 9.31,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.54,
      "end_seconds": 254.47,
      "duration_seconds": 2.93,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.19,
      "end_seconds": 277.44,
      "duration_seconds": 15.25,
      "text": "Okay, so my impression is this: I'd lean towards possible appendicitis, which can look mild in older people. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.33,
      "end_seconds": 281.68,
      "duration_seconds": 2.35,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.43,
      "end_seconds": 298.14,
      "duration_seconds": 15.71,
      "text": "It's reasonable to be concerned, but right now possible appendicitis, which can look mild in older people is my leading thought, not anything worse. Blood tests is what I'd like next, for abdominal pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 299.74,
      "end_seconds": 303.06,
      "duration_seconds": 3.32,
      "text": "I can book that for Wednesday at 10 am."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.7,
      "end_seconds": 325.89,
      "duration_seconds": 21.19,
      "text": "Let's get a CT scan of the abdomen, for right iliac fossa tenderness. Even though you look fairly well, I'd like the surgeons to see you today. Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.82,
      "end_seconds": 331.66,
      "duration_seconds": 3.84,
      "text": "Actually, good, thanks, I'll see you then."
    }
  ]
}