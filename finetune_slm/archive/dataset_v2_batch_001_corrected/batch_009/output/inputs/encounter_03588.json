{
  "schema_version": "1.0",
  "encounter_id": "03588",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.71,
      "end_seconds": 4.8,
      "duration_seconds": 4.09,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.73,
      "end_seconds": 10.04,
      "duration_seconds": 4.31,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.53,
      "end_seconds": 17.41,
      "duration_seconds": 5.88,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 18.43,
      "end_seconds": 27.98,
      "duration_seconds": 9.55,
      "text": "Doctor, it's fainting once. It's getting on my nerves now. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.73,
      "end_seconds": 31.2,
      "duration_seconds": 2.47,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.11,
      "end_seconds": 36.64,
      "duration_seconds": 3.53,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.98,
      "end_seconds": 40.32,
      "duration_seconds": 2.34,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.07,
      "end_seconds": 46.16,
      "duration_seconds": 2.09,
      "text": "Honestly, every other day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.93,
      "end_seconds": 53.21,
      "duration_seconds": 6.28,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 53.31,
      "end_seconds": 59.91,
      "duration_seconds": 6.6,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.19,
      "end_seconds": 63.45,
      "duration_seconds": 2.26,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.64,
      "end_seconds": 71.39,
      "duration_seconds": 6.75,
      "text": "Oh, and a faster heartbeat. That's been about the same, six months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.44,
      "end_seconds": 76.28,
      "duration_seconds": 2.84,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.3,
      "end_seconds": 85.34,
      "duration_seconds": 7.04,
      "text": "Severe, really. I had a bit breathless since before. That's settled now, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 86.9,
      "end_seconds": 89.84,
      "duration_seconds": 2.94,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.89,
      "end_seconds": 92.1,
      "duration_seconds": 1.21,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.58,
      "end_seconds": 95.17,
      "duration_seconds": 1.59,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.75,
      "end_seconds": 101.19,
      "duration_seconds": 5.44,
      "text": "So, have you noticed cough, coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.48,
      "end_seconds": 104.84,
      "duration_seconds": 2.36,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.7,
      "end_seconds": 108.17,
      "duration_seconds": 2.47,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.08,
      "end_seconds": 111.82,
      "duration_seconds": 2.74,
      "text": "Mm, no, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.56,
      "end_seconds": 115.57,
      "duration_seconds": 2.01,
      "text": "So, any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.35,
      "end_seconds": 118.45,
      "duration_seconds": 2.1,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.7,
      "end_seconds": 122.48,
      "duration_seconds": 2.78,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.27,
      "end_seconds": 127.75,
      "duration_seconds": 3.48,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.4,
      "end_seconds": 129.97,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.59,
      "end_seconds": 133.37,
      "duration_seconds": 2.78,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.15,
      "end_seconds": 137.81,
      "duration_seconds": 3.66,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.99,
      "end_seconds": 140.38,
      "duration_seconds": 1.39,
      "text": "I have COPD."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.55,
      "end_seconds": 146.34,
      "duration_seconds": 0.79,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.35,
      "end_seconds": 153.88,
      "duration_seconds": 5.53,
      "text": "I've had anxiety, yes. I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.99,
      "end_seconds": 155.69,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.02,
      "end_seconds": 159.28,
      "duration_seconds": 2.26,
      "text": "Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.6,
      "end_seconds": 173.83,
      "duration_seconds": 13.23,
      "text": "Right, so anxiety and arthritis in your knees are already on your record. We'll keep that in mind today. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.74,
      "end_seconds": 180.76,
      "duration_seconds": 6.02,
      "text": "Um, uh, my uncle has high cholesterol. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.66,
      "end_seconds": 192.95,
      "duration_seconds": 3.29,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.94,
      "end_seconds": 204.49,
      "duration_seconds": 9.55,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.65,
      "end_seconds": 209.71,
      "duration_seconds": 4.06,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.35,
      "end_seconds": 216.33,
      "duration_seconds": 4.98,
      "text": "Tiotropium inhaler, once a day. Escitalopram, once a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.33,
      "end_seconds": 223.61,
      "duration_seconds": 2.28,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.85,
      "end_seconds": 229.52,
      "duration_seconds": 4.67,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.41,
      "end_seconds": 234.47,
      "duration_seconds": 3.06,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.94,
      "end_seconds": 245.52,
      "duration_seconds": 6.58,
      "text": "About two months. Paracetamol, 650 milligrams, when needed. Lamotrigine, twice a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.99,
      "end_seconds": 249.24,
      "duration_seconds": 2.25,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 251.2,
      "end_seconds": 252.31,
      "duration_seconds": 1.11,
      "text": "100 milligrams."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.01,
      "end_seconds": 255.9,
      "duration_seconds": 2.89,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.45,
      "end_seconds": 258.68,
      "duration_seconds": 2.23,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 259.79,
      "end_seconds": 270.4,
      "duration_seconds": 10.61,
      "text": "Doctor, I've got the readings for you. BP is 117 over 74, pulse 117, respiratory rate 17, temperature 37.1, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.99,
      "end_seconds": 272.93,
      "duration_seconds": 0.94,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.65,
      "end_seconds": 278.54,
      "duration_seconds": 2.89,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.32,
      "end_seconds": 282.73,
      "duration_seconds": 2.41,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.78,
      "end_seconds": 307.97,
      "duration_seconds": 8.19,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.13,
      "end_seconds": 315.65,
      "duration_seconds": 2.52,
      "text": "Alright, all finished, thank you."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.52,
      "end_seconds": 338.07,
      "duration_seconds": 4.55,
      "text": "I'm going to order a CT pulmonary angiogram, for possible embolus."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 338.72,
      "end_seconds": 340.19,
      "duration_seconds": 1.47,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.86,
      "end_seconds": 359.28,
      "duration_seconds": 17.42,
      "text": "A D-dimer is what I'd like next, for syncope and calf swelling. Even without chest pain this needs a scan today, so please go to hospital. Let's plan a check straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.77,
      "end_seconds": 363.73,
      "duration_seconds": 2.96,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}