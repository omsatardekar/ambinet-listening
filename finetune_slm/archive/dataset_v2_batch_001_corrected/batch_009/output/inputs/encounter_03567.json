{
  "schema_version": "1.0",
  "encounter_id": "03567",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.29,
      "duration_seconds": 4.08,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 10.76,
      "duration_seconds": 4.48,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.6,
      "end_seconds": 25.15,
      "duration_seconds": 9.55,
      "text": "Mainly poor appetite for two days. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.66,
      "end_seconds": 26.98,
      "duration_seconds": 1.32,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.61,
      "end_seconds": 38.05,
      "duration_seconds": 9.44,
      "text": "It's been about two weeks now. I've been reading about it online and it worried me. I've been feeling off too."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.38,
      "end_seconds": 57.22,
      "duration_seconds": 3.84,
      "text": "Any urinary symptoms, blood in the stool or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.94,
      "end_seconds": 61.95,
      "duration_seconds": 3.01,
      "text": "Erm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.59,
      "end_seconds": 66.64,
      "duration_seconds": 3.05,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.61,
      "end_seconds": 70.85,
      "duration_seconds": 3.24,
      "text": "No, you know, joints are fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.56,
      "end_seconds": 75.18,
      "duration_seconds": 2.62,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.05,
      "end_seconds": 77.23,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.22,
      "end_seconds": 83.6,
      "duration_seconds": 4.38,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.22,
      "end_seconds": 87.05,
      "duration_seconds": 2.83,
      "text": "Yes, trimethoprim. I get itching."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 101.63,
      "duration_seconds": 4.21,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.18,
      "end_seconds": 116.42,
      "duration_seconds": 10.24,
      "text": "I grab fast food at lunch most days. I work in accounts at a hospital. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.51,
      "end_seconds": 120.9,
      "duration_seconds": 3.39,
      "text": "So, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.35,
      "end_seconds": 125.42,
      "duration_seconds": 3.07,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.38,
      "end_seconds": 130.74,
      "duration_seconds": 3.36,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.39,
      "end_seconds": 134.78,
      "duration_seconds": 3.39,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.48,
      "end_seconds": 150.81,
      "duration_seconds": 3.33,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.7,
      "end_seconds": 166.31,
      "duration_seconds": 2.61,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.65,
      "end_seconds": 187.5,
      "duration_seconds": 7.85,
      "text": "Okay: blood pressure 110 over 78, oxygen saturation is 97 percent. And temp 36.6 degrees, heart rate 68."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.22,
      "end_seconds": 193.47,
      "duration_seconds": 4.25,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.53,
      "end_seconds": 197.32,
      "duration_seconds": 2.79,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.32,
      "end_seconds": 225.92,
      "duration_seconds": 9.6,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.42,
      "end_seconds": 231.77,
      "duration_seconds": 2.35,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.51,
      "end_seconds": 256.86,
      "duration_seconds": 10.35,
      "text": "Putting it all together, this looks most like possible appendicitis, which can look mild in older people. We should do blood tests for abdominal pain."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 258.77,
      "end_seconds": 261.43,
      "duration_seconds": 2.66,
      "text": "The earliest is Tuesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 264.48,
      "duration_seconds": 1.13,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.2,
      "end_seconds": 292.16,
      "duration_seconds": 25.96,
      "text": "We should do a CT scan of the abdomen for right iliac fossa tenderness. Even though you look fairly well, I'd like the surgeons to see you today. The surgical team would be the right next step, I'll refer you. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.13,
      "end_seconds": 295.52,
      "duration_seconds": 2.39,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.47,
      "end_seconds": 300.98,
      "duration_seconds": 4.51,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.73,
      "end_seconds": 304.88,
      "duration_seconds": 3.15,
      "text": "I think I understand everything. Thanks."
    }
  ]
}