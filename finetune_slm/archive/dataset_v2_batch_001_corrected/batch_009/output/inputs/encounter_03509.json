{
  "schema_version": "1.0",
  "encounter_id": "03509",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.73,
      "end_seconds": 4.98,
      "duration_seconds": 4.25,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 10.57,
      "duration_seconds": 4.24,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.94,
      "end_seconds": 17.36,
      "duration_seconds": 5.42,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 17.94,
      "end_seconds": 22.27,
      "duration_seconds": 4.33,
      "text": "So the thing is, I've got fainting once."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 23.37,
      "end_seconds": 33.94,
      "duration_seconds": 10.57,
      "text": "Here are the numbers, doctor. Temp 36.8 degrees, respiratory rate 17, oxygen saturation is 99 percent. Pulse 104, blood pressure 135 over 83."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.16,
      "end_seconds": 37.64,
      "duration_seconds": 2.48,
      "text": "Good, thank you. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.28,
      "end_seconds": 41.34,
      "duration_seconds": 2.06,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.79,
      "end_seconds": 48.89,
      "duration_seconds": 3.1,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.55,
      "end_seconds": 52.03,
      "duration_seconds": 1.48,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.93,
      "end_seconds": 56.33,
      "duration_seconds": 2.4,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.33,
      "end_seconds": 72.19,
      "duration_seconds": 14.86,
      "text": "A faster heartbeat goes along with it, most of the time. The faster heartbeat? That's been for about three months. And a swollen calf after a long drive, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.6,
      "end_seconds": 75.75,
      "duration_seconds": 2.15,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.95,
      "end_seconds": 80.77,
      "duration_seconds": 3.82,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.4,
      "end_seconds": 87.84,
      "duration_seconds": 5.44,
      "text": "Have you had any cough, coughing up blood, chest pain or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.88,
      "end_seconds": 95.42,
      "duration_seconds": 6.54,
      "text": "No cough, coughing up blood, chest pain or fever, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.54,
      "end_seconds": 98.66,
      "duration_seconds": 2.12,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.36,
      "end_seconds": 104.29,
      "duration_seconds": 0.93,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.54,
      "end_seconds": 107.35,
      "duration_seconds": 1.81,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.09,
      "end_seconds": 109.86,
      "duration_seconds": 1.77,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.5,
      "end_seconds": 111.97,
      "duration_seconds": 1.47,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 113.89,
      "end_seconds": 117.03,
      "duration_seconds": 3.14,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.88,
      "end_seconds": 120.93,
      "duration_seconds": 3.05,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.34,
      "end_seconds": 125.71,
      "duration_seconds": 3.37,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.37,
      "end_seconds": 130.02,
      "duration_seconds": 1.65,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.74,
      "end_seconds": 133.18,
      "duration_seconds": 2.44,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.17,
      "end_seconds": 138.05,
      "duration_seconds": 2.88,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.11,
      "end_seconds": 142.31,
      "duration_seconds": 3.2,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.9,
      "end_seconds": 163.24,
      "duration_seconds": 3.34,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.24,
      "end_seconds": 178.23,
      "duration_seconds": 12.99,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.39,
      "end_seconds": 189.09,
      "duration_seconds": 2.7,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.1,
      "end_seconds": 201.75,
      "duration_seconds": 11.65,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety. Mirtazapine, 15 milligrams, at night for my mood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 203.16,
      "end_seconds": 213.26,
      "duration_seconds": 10.1,
      "text": "Doctor, I think the last prescription for the mirtazapine was 7.5 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 218.03,
      "duration_seconds": 3.71,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.5,
      "end_seconds": 233.81,
      "duration_seconds": 10.31,
      "text": "I don't think I have it with me. I had spironolactone at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.8,
      "end_seconds": 237.4,
      "duration_seconds": 2.6,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.26,
      "end_seconds": 241.37,
      "duration_seconds": 2.11,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 247.34,
      "duration_seconds": 3.99,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.01,
      "end_seconds": 252.92,
      "duration_seconds": 4.91,
      "text": "I've got anxiety. I've got depression. I have heart failure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.78,
      "end_seconds": 256.52,
      "duration_seconds": 1.74,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.05,
      "end_seconds": 261.7,
      "duration_seconds": 4.65,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.33,
      "end_seconds": 269.07,
      "duration_seconds": 3.74,
      "text": "My son has asthma. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.18,
      "end_seconds": 273.38,
      "duration_seconds": 3.2,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.22,
      "end_seconds": 277.31,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.26,
      "end_seconds": 302.5,
      "duration_seconds": 7.24,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.48,
      "end_seconds": 318.62,
      "duration_seconds": 13.14,
      "text": "That's all I needed to check. Okay, thinking it through, the most likely explanation is possible pulmonary embolism without chest pain. A simple faint is still possible."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.43,
      "end_seconds": 323.27,
      "duration_seconds": 3.84,
      "text": "I mean, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.81,
      "end_seconds": 335.3,
      "duration_seconds": 11.49,
      "text": "I understand the worry. At the moment I'd say it's possible pulmonary embolism without chest pain, and we'll know more once the a CT pulmonary angiogram is back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.81,
      "end_seconds": 368.91,
      "duration_seconds": 24.1,
      "text": "Let's get a CT pulmonary angiogram, for possible embolus. Let's book a D-dimer to look into syncope and calf swelling. Even without chest pain this needs a scan today, so please go to hospital. If you smoke, this is a good moment to think about stopping, and we can help you with that. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.5,
      "end_seconds": 388.18,
      "duration_seconds": 17.68,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if the symptoms get worse. That's when to be seen urgently. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.87,
      "end_seconds": 390.57,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.92,
      "end_seconds": 395.29,
      "duration_seconds": 3.37,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 396.64,
      "end_seconds": 398.6,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.69,
      "end_seconds": 400.94,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}