{
  "schema_version": "1.0",
  "encounter_id": "03618",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 4.49,
      "duration_seconds": 3.45,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.4,
      "end_seconds": 11.75,
      "duration_seconds": 5.35,
      "text": "Alright, yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.66,
      "end_seconds": 20.73,
      "duration_seconds": 7.07,
      "text": "sorry, what was I saying, so the thing is, I've got a tremor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.2,
      "end_seconds": 25.74,
      "duration_seconds": 3.54,
      "text": "Okay, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.8,
      "end_seconds": 30.54,
      "duration_seconds": 3.74,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.14,
      "end_seconds": 35.8,
      "duration_seconds": 3.66,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.09,
      "end_seconds": 47.71,
      "duration_seconds": 5.62,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.74,
      "end_seconds": 51.76,
      "duration_seconds": 3.02,
      "text": "Alright, have you been feeling agitated?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.56,
      "end_seconds": 56.86,
      "duration_seconds": 3.3,
      "text": "Yeah, yeah. Six months, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.51,
      "end_seconds": 63.32,
      "duration_seconds": 5.81,
      "text": "Have you had a tremor before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.85,
      "end_seconds": 72.72,
      "duration_seconds": 8.87,
      "text": "yes, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.01,
      "end_seconds": 89.72,
      "duration_seconds": 4.71,
      "text": "Let me get the the readings out of the way."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.7,
      "end_seconds": 100.16,
      "duration_seconds": 2.46,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.82,
      "end_seconds": 129.35,
      "duration_seconds": 14.53,
      "text": "okay: BP is 136 over 85, pulse is 109 beats a minute, BMI works out to 27.5, saturation 96 percent, height 181 centimetres, temp 37.0 degrees, weight 90 kilos"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.23,
      "end_seconds": 133.67,
      "duration_seconds": 3.44,
      "text": "Um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.93,
      "end_seconds": 137.46,
      "duration_seconds": 2.53,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.34,
      "end_seconds": 143.59,
      "duration_seconds": 4.25,
      "text": "Right, let's have a a proper look at you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.03,
      "end_seconds": 148.89,
      "duration_seconds": 3.86,
      "text": "so, stay as you are for a moment"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.64,
      "end_seconds": 170.43,
      "duration_seconds": 6.79,
      "text": "You have brisk reflexes and jerking of the ankles, and your pupils are large."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.73,
      "end_seconds": 176.02,
      "duration_seconds": 2.29,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.4,
      "end_seconds": 199.16,
      "duration_seconds": 4.76,
      "text": "a few quick ones: high fever, confusion, stiffness or seizure?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.32,
      "end_seconds": 208.16,
      "duration_seconds": 5.84,
      "text": "No high fever, confusion, stiffness or seizure, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.4,
      "end_seconds": 216.66,
      "duration_seconds": 3.26,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.64,
      "end_seconds": 220.62,
      "duration_seconds": 2.98,
      "text": "Oh, no, that's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.6,
      "end_seconds": 225.59,
      "duration_seconds": 2.99,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.53,
      "end_seconds": 229.42,
      "duration_seconds": 1.89,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.72,
      "end_seconds": 235.62,
      "duration_seconds": 2.9,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.7,
      "end_seconds": 246.95,
      "duration_seconds": 9.25,
      "text": "I mean, I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.51,
      "end_seconds": 252.74,
      "duration_seconds": 5.23,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.53,
      "end_seconds": 260.8,
      "duration_seconds": 6.27,
      "text": "Nickel i come out in... well, a rash on my skin"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.82,
      "end_seconds": 265.57,
      "duration_seconds": 2.75,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.46,
      "end_seconds": 270.81,
      "duration_seconds": 1.35,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.6,
      "end_seconds": 272.52,
      "duration_seconds": 0.92,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.19,
      "end_seconds": 278.83,
      "duration_seconds": 4.64,
      "text": "I've had an enlarged prostate for two years now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.11,
      "end_seconds": 295.84,
      "duration_seconds": 7.73,
      "text": "Are you taking anything regularly, including from the pharmacy? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.68,
      "end_seconds": 302.05,
      "duration_seconds": 4.37,
      "text": "Mirtazapine, 15 milligrams, at night for my mood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.94,
      "end_seconds": 305.28,
      "duration_seconds": 2.34,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.55,
      "end_seconds": 312.0,
      "duration_seconds": 5.45,
      "text": "About two years. It's tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.67,
      "end_seconds": 315.28,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.59,
      "end_seconds": 319.34,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.87,
      "end_seconds": 324.21,
      "duration_seconds": 3.34,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.73,
      "end_seconds": 331.95,
      "duration_seconds": 6.22,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.93,
      "end_seconds": 368.8,
      "duration_seconds": 35.87,
      "text": "from what you've told me and what I found, I think we're dealing with mild serotonin syndrome from combining medicines at this stage. I want blood tests done, that's for agitation and clonus. We will stop the migraine tablet and watch you for several hours. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please come and see me in one day"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.95,
      "end_seconds": 373.14,
      "duration_seconds": 3.19,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.71,
      "end_seconds": 378.93,
      "duration_seconds": 5.22,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    }
  ]
}