    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.2,
      "end_seconds": 97.23,
      "duration_seconds": 7.03,
      "text": "No blood in the stool, vomiting or high fever, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 100.57,
