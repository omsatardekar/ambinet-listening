      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.2,
      "end_seconds": 88.57,
      "duration_seconds": 5.37,
      "text": "Any blood in the stool, vomiting or high fever at all?"
