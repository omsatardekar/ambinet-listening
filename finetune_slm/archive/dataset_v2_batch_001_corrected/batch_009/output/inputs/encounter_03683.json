    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.47,
      "end_seconds": 160.23,
      "duration_seconds": 3.76,
      "text": "I follow. Are there any illnesses in your family?"
