    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.45,
      "end_seconds": 284.34,
      "duration_seconds": 10.89,
      "text": "so, based on the history and the examination, the most likely explanation is possible appendicitis, which can look mild in older people"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.2,
      "end_seconds": 288.5,
      "duration_seconds": 3.3,
      "text": "I'm scared it's something bad. Is it?"
    },
