      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.61,
      "end_seconds": 154.47,
      "duration_seconds": 2.86,
      "text": "I've had high blood pressure yes"
