      "role": "DOCTOR",
      "start_seconds": 165.05,
      "end_seconds": 171.71,
      "duration_seconds": 6.66,
      "text": "Have you got any known allergies? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.43,
      "end_seconds": 176.65,
      "duration_seconds": 3.22,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.6,
      "end_seconds": 192.38,
      "duration_seconds": 2.78,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.52,
      "end_seconds": 207.7,
      "duration_seconds": 11.18,
      "text": "Not much, I mostly stay in these days. I'm vegetarian and have been for years. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.96,
      "end_seconds": 214.31,
      "duration_seconds": 4.35,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.07,
      "end_seconds": 227.91,
      "duration_seconds": 1.84,
      "text": "okay you know doctor"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 231.13,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side"
    },
