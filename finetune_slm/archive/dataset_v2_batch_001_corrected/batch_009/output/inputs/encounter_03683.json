      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.56,
      "end_seconds": 64.16,
      "duration_seconds": 10.6,
      "text": "okay: pulse 80 respiratory rate 15 temperature is 36.7 degrees and pressure 118 over 70. Can you tell me when it first started?"
