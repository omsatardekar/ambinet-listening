      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.59,
      "end_seconds": 136.43,
      "duration_seconds": 2.84,
      "text": "What operations have you had, if any?"
