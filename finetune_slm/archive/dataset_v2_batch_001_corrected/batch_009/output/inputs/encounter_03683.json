      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.93,
      "end_seconds": 251.66,
      "duration_seconds": 9.73,
      "text": "your tummy is soft but tender low on the right with mild guarding and the temperature is only a little up"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.17,
      "end_seconds": 257.36,
      "duration_seconds": 2.19,
      "text": "you can sit up now"
