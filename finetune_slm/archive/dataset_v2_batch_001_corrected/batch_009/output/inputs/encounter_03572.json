{
  "schema_version": "1.0",
  "encounter_id": "03572",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.68,
      "duration_seconds": 2.41,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.67,
      "end_seconds": 8.0,
      "duration_seconds": 2.33,
      "text": "Hello, um, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.52,
      "end_seconds": 15.86,
      "duration_seconds": 6.34,
      "text": "Um, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.61,
      "end_seconds": 21.07,
      "duration_seconds": 1.46,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 22.72,
      "end_seconds": 28.47,
      "duration_seconds": 5.75,
      "text": "Doctor, it's not remembering the last hours. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.23,
      "end_seconds": 32.95,
      "duration_seconds": 2.72,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.2,
      "end_seconds": 41.34,
      "duration_seconds": 7.14,
      "text": "Uh, you know, it's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.75,
      "end_seconds": 45.68,
      "duration_seconds": 2.93,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.45,
      "end_seconds": 49.3,
      "duration_seconds": 1.85,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.0,
      "end_seconds": 57.93,
      "duration_seconds": 7.93,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 58.03,
      "end_seconds": 66.3,
      "duration_seconds": 8.27,
      "text": "Um, uh, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.7,
      "end_seconds": 73.22,
      "duration_seconds": 5.52,
      "text": "Sorry, what was I saying, I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.65,
      "end_seconds": 79.37,
      "duration_seconds": 4.72,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.49,
      "end_seconds": 93.13,
      "duration_seconds": 12.64,
      "text": "Oh, as for asking the same questions repeatedly, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.15,
      "end_seconds": 98.27,
      "duration_seconds": 4.12,
      "text": "Have you had any headache, slurred speech, weakness or seizure?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 114.64,
      "duration_seconds": 15.3,
      "text": "Hmm, uh, no, no headache, no slurred speech, no weakness. I was feeling fine otherwise at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.52,
      "end_seconds": 119.07,
      "duration_seconds": 3.55,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.14,
      "end_seconds": 127.91,
      "duration_seconds": 6.77,
      "text": "My heart's been fine, you know, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.06,
      "end_seconds": 135.42,
      "duration_seconds": 2.36,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.23,
      "end_seconds": 149.33,
      "duration_seconds": 12.1,
      "text": "I mean, uh, I had my tonsils removed as a teenager. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.01,
      "end_seconds": 153.92,
      "duration_seconds": 3.91,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.37,
      "end_seconds": 166.0,
      "duration_seconds": 7.63,
      "text": "Sertraline. I take it 50 milligrams, maybe, once a day for my mood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.23,
      "end_seconds": 171.62,
      "duration_seconds": 4.39,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.49,
      "end_seconds": 183.35,
      "duration_seconds": 9.86,
      "text": "Uh, you know, not with me. I'll bring it next time. It's tamsulosin, at night."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.39,
      "end_seconds": 186.75,
      "duration_seconds": 2.36,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.2,
      "end_seconds": 200.24,
      "duration_seconds": 12.04,
      "text": "0.4 milligrams, I think that's what's on the box. Furosemide. I take it 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.45,
      "end_seconds": 202.37,
      "duration_seconds": 0.92,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.08,
      "end_seconds": 207.11,
      "duration_seconds": 3.03,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.35,
      "end_seconds": 210.55,
      "duration_seconds": 2.2,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.89,
      "end_seconds": 214.65,
      "duration_seconds": 2.76,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.69,
      "end_seconds": 219.94,
      "duration_seconds": 3.25,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.29,
      "end_seconds": 225.41,
      "duration_seconds": 4.12,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.48,
      "end_seconds": 245.38,
      "duration_seconds": 2.9,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.05,
      "end_seconds": 248.61,
      "duration_seconds": 2.56,
      "text": "Depression, for about ten years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.94,
      "end_seconds": 250.97,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.19,
      "end_seconds": 256.54,
      "duration_seconds": 4.35,
      "text": "An enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.47,
      "end_seconds": 259.78,
      "duration_seconds": 1.31,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.79,
      "end_seconds": 266.55,
      "duration_seconds": 4.76,
      "text": "Yeah, you know, I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.31,
      "end_seconds": 273.35,
      "duration_seconds": 5.04,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.89,
      "end_seconds": 278.75,
      "duration_seconds": 3.86,
      "text": "Yeah, yes, kiwi, it gives me hives."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.8,
      "end_seconds": 283.17,
      "duration_seconds": 2.37,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.33,
      "end_seconds": 298.2,
      "duration_seconds": 2.87,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.95,
      "end_seconds": 320.75,
      "duration_seconds": 6.8,
      "text": "Okay: blood pressure 124 over 81, temp 36.4 degrees, heart rate 70, respiratory rate 14."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.72,
      "end_seconds": 327.64,
      "duration_seconds": 3.92,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.02,
      "end_seconds": 331.3,
      "duration_seconds": 2.28,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.08,
      "end_seconds": 348.22,
      "duration_seconds": 8.14,
      "text": "You know who you are but not what happened this morning, and the examination otherwise is normal."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.08,
      "end_seconds": 356.02,
      "duration_seconds": 1.94,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.72,
      "end_seconds": 395.81,
      "duration_seconds": 25.09,
      "text": "Let me tell you where I've got to. This is probably transient global amnesia. I'd also keep a seizure in mind. I'd also keep a stroke in mind. Stop me if I've got anything wrong. You've had not remembering the last hours for about two weeks, mild, and no slurred speech or headache."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 397.15,
      "end_seconds": 400.06,
      "duration_seconds": 2.91,
      "text": "That's it, you know, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.61,
      "end_seconds": 437.93,
      "duration_seconds": 36.32,
      "text": "I'm going to order a blood sugar, for confusion. The result will help us decide whether anything more is needed. A CT scan of the head is what I'd like next, for acute memory loss. This usually clears in a day with no lasting effect, but we do a scan first to be safe. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 439.67,
      "end_seconds": 453.3,
      "duration_seconds": 13.63,
      "text": "Come back or go to emergency straight away if the symptoms get worse. Let's plan a check tomorrow. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 454.67,
      "end_seconds": 457.83,
      "duration_seconds": 3.16,
      "text": "Well, thank you, that's helpful."
    }
  ]
}