{
  "schema_version": "1.0",
  "encounter_id": "03521",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.47,
      "duration_seconds": 2.96,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.11,
      "end_seconds": 9.55,
      "duration_seconds": 4.44,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.86,
      "end_seconds": 15.85,
      "duration_seconds": 4.99,
      "text": "So, I've been feeling flat and slowed down, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.94,
      "end_seconds": 21.03,
      "duration_seconds": 3.09,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.09,
      "end_seconds": 25.9,
      "duration_seconds": 3.81,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.77,
      "end_seconds": 33.27,
      "duration_seconds": 2.5,
      "text": "So, has there been constipation too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.55,
      "end_seconds": 42.7,
      "duration_seconds": 3.15,
      "text": "Yeah, I've had that since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.69,
      "end_seconds": 61.32,
      "duration_seconds": 4.63,
      "text": "Any palpitations, weight loss, thoughts of harming myself or hearing voices?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.9,
      "end_seconds": 64.48,
      "duration_seconds": 2.58,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.43,
      "end_seconds": 69.98,
      "duration_seconds": 4.55,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.37,
      "end_seconds": 73.75,
      "duration_seconds": 2.38,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.37,
      "end_seconds": 78.14,
      "duration_seconds": 3.77,
      "text": "So, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.79,
      "end_seconds": 81.72,
      "duration_seconds": 2.93,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.81,
      "end_seconds": 86.25,
      "duration_seconds": 3.44,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.84,
      "end_seconds": 98.31,
      "duration_seconds": 7.47,
      "text": "Yes, you know, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.04,
      "end_seconds": 104.93,
      "duration_seconds": 5.89,
      "text": "Let's run through your medicines. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.64,
      "end_seconds": 111.59,
      "duration_seconds": 4.95,
      "text": "Fluoxetine. I take it every morning for my mood."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.37,
      "end_seconds": 114.71,
      "duration_seconds": 2.34,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.67,
      "end_seconds": 119.9,
      "duration_seconds": 4.23,
      "text": "20 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.38,
      "end_seconds": 125.83,
      "duration_seconds": 4.45,
      "text": "Right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.35,
      "end_seconds": 129.78,
      "duration_seconds": 2.43,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.21,
      "end_seconds": 134.63,
      "duration_seconds": 3.42,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.59,
      "end_seconds": 140.1,
      "duration_seconds": 3.51,
      "text": "I have depression, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.76,
      "end_seconds": 148.62,
      "duration_seconds": 7.86,
      "text": "Ah. Okay, I can see depression in your file as well. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.82,
      "end_seconds": 161.81,
      "duration_seconds": 11.99,
      "text": "Yes, I work in a bakery, early starts. I walk the dog every morning. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.48,
      "end_seconds": 174.45,
      "duration_seconds": 2.97,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.21,
      "end_seconds": 189.12,
      "duration_seconds": 2.91,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.03,
      "end_seconds": 211.18,
      "duration_seconds": 7.15,
      "text": "Okay: temp 36.9 degrees, blood pressure 122 over 76, saturation 98 percent. And heart rate 81."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.09,
      "end_seconds": 213.61,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.64,
      "end_seconds": 218.0,
      "duration_seconds": 2.36,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.78,
      "end_seconds": 223.77,
      "duration_seconds": 3.99,
      "text": "Right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.62,
      "end_seconds": 225.87,
      "duration_seconds": 1.25,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.04,
      "end_seconds": 239.4,
      "duration_seconds": 4.36,
      "text": "Your pulse is slow and your reflexes relax slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.43,
      "end_seconds": 271.49,
      "duration_seconds": 30.06,
      "text": "Good, you can sit up again. Having listened and examined, it points towards an underactive thyroid presenting as low mood. I want to be honest that this is an impression, not a final answer. Depression is also on my list. Stop me if I've got anything wrong. You've been feeling flat and slowed down for two days, and no hearing voices or palpitations."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.65,
      "end_seconds": 277.12,
      "duration_seconds": 1.47,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.28,
      "end_seconds": 296.83,
      "duration_seconds": 4.55,
      "text": "I think a blood count makes sense here, for tiredness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.88,
      "end_seconds": 300.84,
      "duration_seconds": 1.96,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.53,
      "end_seconds": 317.77,
      "duration_seconds": 15.24,
      "text": "A thyroid test is what I'd like next, for slowing and cold intolerance. We'll check the thyroid before deciding on any antidepressant. See me again after the results. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.63,
      "end_seconds": 320.68,
      "duration_seconds": 2.05,
      "text": "Thank you, that's helpful."
    }
  ]
}