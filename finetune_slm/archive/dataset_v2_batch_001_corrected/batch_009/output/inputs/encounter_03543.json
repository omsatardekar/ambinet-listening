  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 3.97,
      "duration_seconds": 3.23,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.89,
      "end_seconds": 9.62,
      "duration_seconds": 4.73,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.6,
      "end_seconds": 24.16,
      "duration_seconds": 13.56,
      "text": "Mainly I've been feeling like I have flu. That's why I came. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.79,
      "end_seconds": 27.87,
      "duration_seconds": 2.08,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.67,
      "end_seconds": 33.03,
      "duration_seconds": 4.36,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 38.27,
      "duration_seconds": 3.42,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.05,
      "end_seconds": 40.75,
      "duration_seconds": 1.7,
      "text": "it's moderate, honestly"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.7,
      "end_seconds": 46.52,
      "duration_seconds": 2.82,
      "text": "any being very thirsty as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.24,
      "end_seconds": 52.12,
      "duration_seconds": 3.88,
      "text": "yeah, uh, I've had that since Monday"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.82,
      "end_seconds": 58.12,
      "duration_seconds": 4.3,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.58,
      "end_seconds": 70.22,
      "duration_seconds": 2.64,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.04,
      "end_seconds": 103.47,
      "duration_seconds": 11.43,
      "text": "okay: heart rate 106, weight 67 kilos. And BMI works out to 23.5, height 169 centimetres, pressure 130 over 72, saturation 99 percent, temperature 37.1."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.88,
      "end_seconds": 109.03,
      "duration_seconds": 4.15,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 112.36,
      "duration_seconds": 2.14,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.74,
      "end_seconds": 126.61,
      "duration_seconds": 5.87,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.11,
      "end_seconds": 131.07,
      "duration_seconds": 1.96,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.23,
      "end_seconds": 149.89,
      "duration_seconds": 4.66,
      "text": "Have you had any fever, sore throat, cough or diarrhoea?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.95,
      "end_seconds": 157.09,
      "duration_seconds": 5.14,
      "text": "No, you know, no fever, sore throat, cough or diarrhoea."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.52,
      "end_seconds": 160.96,
      "duration_seconds": 3.44,
      "text": "Ah. Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.21,
      "end_seconds": 165.55,
      "duration_seconds": 3.34,
      "text": "Okay, so I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.34,
      "end_seconds": 168.84,
      "duration_seconds": 2.5,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.47,
      "end_seconds": 175.66,
      "duration_seconds": 5.19,
      "text": "Okay, you know, so nothing on the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 180.29,
      "duration_seconds": 3.32,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.9,
      "end_seconds": 193.94,
      "duration_seconds": 12.04,
      "text": "I'm a bus driver, so I sit for long hours. I swim twice a week. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.72,
      "end_seconds": 209.93,
      "duration_seconds": 4.21,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.5,
      "end_seconds": 214.33,
      "duration_seconds": 3.83,
      "text": "yeah, no, not that I know of"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.8,
      "end_seconds": 220.64,
      "duration_seconds": 4.84,
      "text": "okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.97,
      "end_seconds": 227.51,
      "duration_seconds": 5.54,
      "text": "I'm on lansoprazole, 30 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.58,
      "end_seconds": 231.03,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.55,
      "end_seconds": 235.85,
      "duration_seconds": 4.3,
      "text": "no, you know, I've never been operated on"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.96,
      "end_seconds": 253.36,
      "duration_seconds": 2.4,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.62,
      "end_seconds": 283.22,
      "duration_seconds": 27.6,
      "text": "I've had an irregular heartbeat for two years now. I told my wife I'd come today. It's a relief to finally sit down and talk about it. Ah, uh, yes, acid reflux. I looked a few things up online, and that probably didn't help. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.17,
      "end_seconds": 296.06,
      "duration_seconds": 10.89,
      "text": "Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. I'm going to order blood tests, for possible ketoacidosis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.97,
      "end_seconds": 302.55,
      "duration_seconds": 1.58,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.02,
      "end_seconds": 310.23,
      "duration_seconds": 6.21,
      "text": "I'm going to order a finger-prick glucose and ketones, for thirst and weight loss"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.92,
      "end_seconds": 314.43,
      "duration_seconds": 1.51,
      "text": "that makes sense"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.06,
      "end_seconds": 332.18,
      "duration_seconds": 17.12,
      "text": "This is not flu, your sugar is very high, and you need hospital insulin today. One warning sign to remember: the symptoms get worse. In that case don't wait. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.48,
      "end_seconds": 335.51,
      "duration_seconds": 2.03,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.92,
      "end_seconds": 338.09,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
