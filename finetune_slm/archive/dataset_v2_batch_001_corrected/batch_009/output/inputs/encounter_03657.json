  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 3.3,
      "duration_seconds": 2.01,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.59,
      "end_seconds": 9.79,
      "duration_seconds": 1.2,
      "text": "hello, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.69,
      "end_seconds": 13.16,
      "duration_seconds": 1.47,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.05,
      "end_seconds": 18.88,
      "duration_seconds": 3.83,
      "text": "I'm here because of a dry cough."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.58,
      "end_seconds": 27.92,
      "duration_seconds": 3.34,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.3,
      "end_seconds": 36.2,
      "duration_seconds": 6.9,
      "text": "I've had it for ten days. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.5,
      "end_seconds": 42.59,
      "duration_seconds": 5.09,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.69,
      "end_seconds": 47.17,
      "duration_seconds": 3.48,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.75,
      "end_seconds": 52.09,
      "duration_seconds": 3.34,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.94,
      "end_seconds": 58.81,
      "duration_seconds": 5.87,
      "text": "It feels severe to me. I've also had tiredness, for ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.59,
      "end_seconds": 73.85,
      "duration_seconds": 4.26,
      "text": "Any weight loss or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.47,
      "end_seconds": 77.97,
      "duration_seconds": 2.5,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.29,
      "end_seconds": 82.9,
      "duration_seconds": 3.61,
      "text": "a few quick ones: night sweats or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 87.88,
      "duration_seconds": 4.29,
      "text": "Erm, I haven't had night sweats or fever, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.47,
      "end_seconds": 93.18,
      "duration_seconds": 3.71,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.1,
      "end_seconds": 98.69,
      "duration_seconds": 4.59,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 107.27,
      "duration_seconds": 4.31,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.82,
      "end_seconds": 111.99,
      "duration_seconds": 3.17,
      "text": "Yes, naproxen. I get a rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.28,
      "end_seconds": 120.01,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.46,
      "end_seconds": 122.6,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.15,
      "end_seconds": 139.8,
      "duration_seconds": 4.65,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.37,
      "end_seconds": 154.15,
      "duration_seconds": 12.78,
      "text": "I quit smoking around ten years ago. I hardly move around during the day. I grab fast food at lunch most days. I live with my elderly mother"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.92,
      "end_seconds": 159.7,
      "duration_seconds": 3.78,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.37,
      "end_seconds": 163.17,
      "duration_seconds": 2.8,
      "text": "no, I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.16,
      "end_seconds": 166.12,
      "duration_seconds": 1.96,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.14,
      "end_seconds": 168.29,
      "duration_seconds": 1.15,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.97,
      "end_seconds": 190.17,
      "duration_seconds": 3.2,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.14,
      "end_seconds": 199.51,
      "duration_seconds": 2.37,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.64,
      "end_seconds": 229.8,
      "duration_seconds": 12.16,
      "text": "Okay: heart rate 68, blood pressure 128 over 78, temperature is 36.6 degrees. And SpO2 98 percent on room air, respiratory rate 18."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.22,
      "end_seconds": 234.79,
      "duration_seconds": 2.57,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 239.02,
      "duration_seconds": 2.49,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.72,
      "end_seconds": 257.31,
      "duration_seconds": 5.59,
      "text": "There are tender raised red nodules on both shins and your ankles are puffy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.56,
      "end_seconds": 263.1,
      "duration_seconds": 2.54,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.38,
      "end_seconds": 287.63,
      "duration_seconds": 10.25,
      "text": "so, based on the history and the examination, it points towards possible sarcoidosis let's book a chest X-ray to look into cough and erythema nodosum"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.26,
      "end_seconds": 289.29,
      "duration_seconds": 1.03,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.64,
      "end_seconds": 316.17,
      "duration_seconds": 25.53,
      "text": "I'm sending you for blood tests because of possible sarcoidosis. Rest and elevate the legs, and I'm arranging a chest clinic review. We'll refer you to the respiratory clinic. Please don't wait if the symptoms get worse. That's when to be seen urgently. See me again after the tests. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.92,
      "end_seconds": 319.1,
      "duration_seconds": 2.18,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.16,
      "end_seconds": 321.5,
      "duration_seconds": 1.34,
      "text": "Goodbye for now."
    }
  ]
}