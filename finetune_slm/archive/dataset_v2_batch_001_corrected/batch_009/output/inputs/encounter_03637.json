{
  "schema_version": "1.0",
  "encounter_id": "03637",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.45,
      "duration_seconds": 4.34,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 9.74,
      "duration_seconds": 3.68,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 14.82,
      "duration_seconds": 4.06,
      "text": "Well, I've been having a poor appetite."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.03,
      "end_seconds": 17.87,
      "duration_seconds": 1.84,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.92,
      "end_seconds": 23.69,
      "duration_seconds": 3.77,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.17,
      "end_seconds": 24.87,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.92,
      "end_seconds": 28.99,
      "duration_seconds": 3.07,
      "text": "I've also had an irregular heartbeat."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.84,
      "end_seconds": 33.92,
      "duration_seconds": 3.08,
      "text": "Did you get diarrhoea, sweating or tremor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.35,
      "end_seconds": 41.76,
      "duration_seconds": 6.41,
      "text": "Let me think, no diarrhoea, sweating or tremor, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.7,
      "end_seconds": 45.66,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.8,
      "end_seconds": 52.19,
      "duration_seconds": 2.39,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.73,
      "end_seconds": 57.63,
      "duration_seconds": 3.9,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.59,
      "end_seconds": 60.9,
      "duration_seconds": 2.31,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.99,
      "end_seconds": 70.45,
      "duration_seconds": 4.46,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.27,
      "end_seconds": 74.2,
      "duration_seconds": 2.93,
      "text": "Right, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.14,
      "end_seconds": 93.64,
      "duration_seconds": 4.5,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.67,
      "end_seconds": 105.54,
      "duration_seconds": 9.87,
      "text": "I look after my grandchildren most days. I swim twice a week. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.65,
      "end_seconds": 120.07,
      "duration_seconds": 2.42,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.3,
      "end_seconds": 125.97,
      "duration_seconds": 4.67,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 130.29,
      "duration_seconds": 3.36,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.07,
      "end_seconds": 137.75,
      "duration_seconds": 5.68,
      "text": "Yes, um, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.12,
      "end_seconds": 146.97,
      "duration_seconds": 7.85,
      "text": "What conditions have you been treated for in the past? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.73,
      "end_seconds": 162.32,
      "duration_seconds": 13.59,
      "text": "I have heart disease. I'd rather not end up on lots of tablets if I can avoid it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.86,
      "end_seconds": 166.31,
      "duration_seconds": 2.45,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.07,
      "end_seconds": 169.64,
      "duration_seconds": 1.57,
      "text": "Naproxen, I'd say."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.36,
      "end_seconds": 191.04,
      "duration_seconds": 2.68,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.15,
      "end_seconds": 205.51,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.84,
      "end_seconds": 226.06,
      "duration_seconds": 7.22,
      "text": "Okay: saturation 96 percent, blood pressure 114 over 86, respiratory rate 17. And pulse 114."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.88,
      "end_seconds": 228.23,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.23,
      "end_seconds": 233.18,
      "duration_seconds": 2.95,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.48,
      "end_seconds": 257.16,
      "duration_seconds": 8.68,
      "text": "Listening to the whole story, my working impression is an overactive thyroid with atrial fibrillation, in an apathetic older patient."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.61,
      "end_seconds": 260.71,
      "duration_seconds": 2.1,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.22,
      "end_seconds": 286.05,
      "duration_seconds": 21.83,
      "text": "It's reasonable to be concerned, but right now an overactive thyroid with atrial fibrillation, in an apathetic older patient is my leading thought, not anything worse. Let's get a thyroid test, for weight loss and irregular pulse. I'm sending you for an ECG because of irregular pulse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.62,
      "end_seconds": 289.04,
      "duration_seconds": 2.42,
      "text": "Well, that's fine with me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.57,
      "end_seconds": 299.81,
      "duration_seconds": 9.24,
      "text": "It is easy to miss in older people because they seem sleepy rather than hot and shaky. Let's review you after the results."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.99,
      "end_seconds": 304.47,
      "duration_seconds": 3.48,
      "text": "I mean, alright, I'll be back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.75,
      "end_seconds": 310.68,
      "duration_seconds": 4.93,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.93,
      "end_seconds": 315.09,
      "duration_seconds": 3.16,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.8,
      "end_seconds": 317.97,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}