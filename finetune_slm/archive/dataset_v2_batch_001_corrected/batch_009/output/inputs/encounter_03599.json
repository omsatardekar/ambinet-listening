{
  "schema_version": "1.0",
  "encounter_id": "03599",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 4.22,
      "duration_seconds": 2.85,
      "text": "morning, doctor lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 10.85,
      "duration_seconds": 4.78,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.73,
      "end_seconds": 20.29,
      "duration_seconds": 8.56,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening. She's been having indigestion, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.18,
      "end_seconds": 22.6,
      "duration_seconds": 1.42,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.18,
      "end_seconds": 26.52,
      "duration_seconds": 3.34,
      "text": "It's been going on for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.42,
      "end_seconds": 37.21,
      "duration_seconds": 8.79,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 42.77,
      "duration_seconds": 3.97,
      "text": "I'd say severe. Antacids helps a a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.68,
      "end_seconds": 50.91,
      "duration_seconds": 3.23,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.85,
      "end_seconds": 58.66,
      "duration_seconds": 6.81,
      "text": "An ache in my jaw goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.31,
      "end_seconds": 62.65,
      "duration_seconds": 2.34,
      "text": "have you been feeling unusually tired?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.05,
      "end_seconds": 67.1,
      "duration_seconds": 3.05,
      "text": "Yes, about the same, two days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.33,
      "end_seconds": 71.15,
      "duration_seconds": 2.82,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.37,
      "end_seconds": 75.89,
      "duration_seconds": 1.52,
      "text": "Severe, I'd say"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.23,
      "end_seconds": 79.54,
      "duration_seconds": 3.31,
      "text": "Mm-hmm. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.38,
      "end_seconds": 85.47,
      "duration_seconds": 4.09,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.73,
      "end_seconds": 91.09,
      "duration_seconds": 4.36,
      "text": "alright, high blood pressure, that matches what I have here"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.76,
      "end_seconds": 111.53,
      "duration_seconds": 3.77,
      "text": "What do you take on a a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 112.13,
      "end_seconds": 118.04,
      "duration_seconds": 5.91,
      "text": "It's hydrochlorothiazide, 12.5 milligrams, every morning for my pressure, doctor."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.24,
      "end_seconds": 122.24,
      "duration_seconds": 3.0,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 123.9,
      "end_seconds": 128.87,
      "duration_seconds": 4.97,
      "text": "Nearly five years now. She takes antacid liquid, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.47,
      "end_seconds": 131.73,
      "duration_seconds": 2.26,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 133.8,
      "end_seconds": 135.09,
      "duration_seconds": 1.29,
      "text": "It's 10 ml."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.38,
      "end_seconds": 137.07,
      "duration_seconds": 1.69,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.11,
      "end_seconds": 152.48,
      "duration_seconds": 1.37,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.5,
      "end_seconds": 157.91,
      "duration_seconds": 3.41,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.69,
      "end_seconds": 160.09,
      "duration_seconds": 1.4,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.79,
      "end_seconds": 164.5,
      "duration_seconds": 2.71,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.48,
      "end_seconds": 170.63,
      "duration_seconds": 2.15,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.56,
      "end_seconds": 179.75,
      "duration_seconds": 4.19,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.84,
      "end_seconds": 189.32,
      "duration_seconds": 2.48,
      "text": "Right, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.17,
      "end_seconds": 195.52,
      "duration_seconds": 4.35,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.17,
      "end_seconds": 200.08,
      "duration_seconds": 2.91,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.58,
      "end_seconds": 204.87,
      "duration_seconds": 3.29,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.68,
      "end_seconds": 209.15,
      "duration_seconds": 2.47,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.3,
      "end_seconds": 213.66,
      "duration_seconds": 3.36,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.54,
      "end_seconds": 221.73,
      "duration_seconds": 6.19,
      "text": "So, did you get cough, leg swelling, fever or crushing chest pain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.3,
      "end_seconds": 228.05,
      "duration_seconds": 5.75,
      "text": "No, no cough, leg swelling, fever or crushing chest pain."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.27,
      "end_seconds": 232.28,
      "duration_seconds": 4.01,
      "text": "Yes, carry on. So, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.83,
      "end_seconds": 234.39,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.33,
      "end_seconds": 238.24,
      "duration_seconds": 2.91,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.98,
      "end_seconds": 252.49,
      "duration_seconds": 2.51,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.85,
      "end_seconds": 269.81,
      "duration_seconds": 7.96,
      "text": "okay: blood pressure 123 over 86, temp 36.6 degrees, oxygen saturation is 97 percent, pulse 106."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.47,
      "end_seconds": 272.09,
      "duration_seconds": 1.62,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.97,
      "end_seconds": 276.28,
      "duration_seconds": 2.31,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.83,
      "end_seconds": 282.79,
      "duration_seconds": 3.96,
      "text": "So, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.59,
      "end_seconds": 285.14,
      "duration_seconds": 1.55,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.03,
      "end_seconds": 287.32,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.03,
      "end_seconds": 308.63,
      "duration_seconds": 7.6,
      "text": "Your heart sounds are normal and your tummy is soft, but your pulse is a little fast."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.29,
      "end_seconds": 311.39,
      "duration_seconds": 1.1,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.55,
      "end_seconds": 329.46,
      "duration_seconds": 13.91,
      "text": "thank you, you can get dressed okay, so my impression is this: I think we're dealing with possible heart attack despite no classic chest pain at this stage i'd also keep reflux in mind"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.81,
      "end_seconds": 333.25,
      "duration_seconds": 2.44,
      "text": "Will it it clear up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.17,
      "end_seconds": 354.51,
      "duration_seconds": 20.34,
      "text": "nothing I've seen today points to an emergency it looks like possible heart attack despite no classic chest pain, but I'd like to confirm so, to recap quickly you've had indigestion for two weeks, severe, and no cough or crushing chest pain"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.54,
      "end_seconds": 356.24,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.31,
      "end_seconds": 363.91,
      "duration_seconds": 5.6,
      "text": "An ECG is what I'd like next, for jaw pain and fatigue."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.18,
      "end_seconds": 366.68,
      "duration_seconds": 1.5,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.46,
      "end_seconds": 388.82,
      "duration_seconds": 21.36,
      "text": "For this, aspirin, 300 milligrams, once now, single dose. You take it by mouth. It's for possible heart attack. Diabetes can hide the usual pain, so I am treating this as a heart problem until proven otherwise. Let's review you straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.53,
      "end_seconds": 392.71,
      "duration_seconds": 2.18,
      "text": "alright, thanks, take care"
    }
  ]
}