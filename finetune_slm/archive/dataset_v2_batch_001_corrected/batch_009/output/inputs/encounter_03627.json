      "role": "DOCTOR",
      "start_seconds": 87.76,
      "end_seconds": 90.33,
      "duration_seconds": 2.57,
      "text": "That's it just a little longer..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.38,
      "end_seconds": 108.22,
      "duration_seconds": 7.84,
      "text": "okay: temp 36.7 degrees heart rate 83 saturation 97 percent and blood pressure 127 over 68 respiratory rate 15."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.22,
      "end_seconds": 120.55,
      "duration_seconds": 3.33,
      "text": "Have you had any sore throat or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.65,
      "end_seconds": 125.83,
      "duration_seconds": 4.18,
      "text": "I haven't had sore throat or cough no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.25,
      "end_seconds": 129.64,
      "duration_seconds": 2.39,
      "text": "and what about fever or rash?"
    },
    {
      "segment_id": "SEG0017",
