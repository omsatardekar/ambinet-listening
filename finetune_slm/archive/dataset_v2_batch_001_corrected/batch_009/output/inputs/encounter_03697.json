{
  "schema_version": "1.0",
  "encounter_id": "03697",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 7.29,
      "duration_seconds": 6.18,
      "text": "I mean, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.81,
      "end_seconds": 13.12,
      "duration_seconds": 5.31,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.99,
      "end_seconds": 35.49,
      "duration_seconds": 20.5,
      "text": "Mainly blacking out when I stand quickly. There's a couple of other things, but that's the main one. I took the morning off to come in today. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.45,
      "end_seconds": 40.85,
      "duration_seconds": 3.4,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.86,
      "end_seconds": 50.84,
      "duration_seconds": 8.98,
      "text": "Valsartan, 80 milligrams, once a day. Glycomet. I take it twice a day for my sugar."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.32,
      "end_seconds": 54.42,
      "duration_seconds": 2.1,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.21,
      "end_seconds": 57.29,
      "duration_seconds": 1.08,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.23,
      "end_seconds": 68.99,
      "duration_seconds": 1.76,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.05,
      "end_seconds": 83.08,
      "duration_seconds": 13.03,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, uh, I really can't pin it down."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.63,
      "end_seconds": 88.03,
      "duration_seconds": 4.4,
      "text": "I see, go ahead. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.36,
      "end_seconds": 99.06,
      "duration_seconds": 9.7,
      "text": "It feels mild to me. Okay, so I've also had a new prostate tablet, for three days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.51,
      "end_seconds": 103.47,
      "duration_seconds": 2.96,
      "text": "Any blurred vision on standing as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.36,
      "end_seconds": 106.16,
      "duration_seconds": 1.8,
      "text": "Yes, since Monday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.65,
      "end_seconds": 110.66,
      "duration_seconds": 3.01,
      "text": "Have you had seizure, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 114.74,
      "duration_seconds": 3.33,
      "text": "No, um, none, no seizure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.45,
      "end_seconds": 121.22,
      "duration_seconds": 4.77,
      "text": "A few quick ones: palpitations, chest pain or head injury?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.7,
      "end_seconds": 125.43,
      "duration_seconds": 2.73,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.82,
      "end_seconds": 129.58,
      "duration_seconds": 3.76,
      "text": "I see, go ahead. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.67,
      "end_seconds": 134.09,
      "duration_seconds": 2.42,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.68,
      "end_seconds": 138.92,
      "duration_seconds": 3.24,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.0,
      "end_seconds": 141.69,
      "duration_seconds": 1.69,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.96,
      "end_seconds": 146.21,
      "duration_seconds": 3.25,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.21,
      "end_seconds": 153.86,
      "duration_seconds": 6.65,
      "text": "So, um, yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.79,
      "end_seconds": 158.78,
      "duration_seconds": 3.99,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.53,
      "end_seconds": 163.6,
      "duration_seconds": 3.07,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.4,
      "end_seconds": 174.84,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.55,
      "end_seconds": 188.99,
      "duration_seconds": 12.44,
      "text": "I drink a lot of tea and snack through the day. I hardly move around during the day. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.86,
      "end_seconds": 195.28,
      "duration_seconds": 4.42,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.32,
      "end_seconds": 204.73,
      "duration_seconds": 7.41,
      "text": "Years back I got a rash from naproxen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.64,
      "end_seconds": 209.77,
      "duration_seconds": 4.13,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.66,
      "end_seconds": 217.7,
      "duration_seconds": 7.04,
      "text": "High blood pressure, for five years. Oh, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.25,
      "end_seconds": 222.18,
      "duration_seconds": 2.93,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.06,
      "end_seconds": 236.44,
      "duration_seconds": 3.38,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.45,
      "end_seconds": 244.55,
      "duration_seconds": 2.1,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.88,
      "end_seconds": 276.7,
      "duration_seconds": 14.82,
      "text": "Okay: weight 68 kilos, oxygen saturation is 98 percent, BMI works out to 21.7, heart rate 100, height 177 centimetres, respiratory rate 16, temp 37.1 degrees, BP is 98 over 66."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.35,
      "end_seconds": 282.88,
      "duration_seconds": 4.53,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.59,
      "end_seconds": 286.95,
      "duration_seconds": 2.36,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.07,
      "end_seconds": 302.39,
      "duration_seconds": 7.32,
      "text": "Your blood pressure drops a long way when you stand and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.51,
      "end_seconds": 312.53,
      "duration_seconds": 7.02,
      "text": "That's the examination finished. Okay, thinking it through, my working impression is medicine-induced postural hypotension."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.06,
      "end_seconds": 316.43,
      "duration_seconds": 2.37,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.88,
      "end_seconds": 329.27,
      "duration_seconds": 10.39,
      "text": "Nothing I've seen today points to an emergency. It looks like medicine-induced postural hypotension, but I'd like to confirm. Let's get blood tests, for syncope."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 329.88,
      "end_seconds": 333.77,
      "duration_seconds": 3.89,
      "text": "I can book that for Tuesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.51,
      "end_seconds": 353.45,
      "duration_seconds": 18.94,
      "text": "I want an ECG done, that's for syncope. We will move the prostate tablet to bedtime and you should rise slowly. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.22,
      "end_seconds": 356.89,
      "duration_seconds": 1.67,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.69,
      "end_seconds": 361.33,
      "duration_seconds": 2.64,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.88,
      "end_seconds": 367.74,
      "duration_seconds": 4.86,
      "text": "I mean, you know, alright, thanks, take care."
    }
  ]
}