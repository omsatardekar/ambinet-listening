  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.97,
      "duration_seconds": 3.97,
      "text": "right, hello, doctor may I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.91,
      "duration_seconds": 4.09,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.71,
      "end_seconds": 26.68,
      "duration_seconds": 13.97,
      "text": "mm, I wanted to get headaches looked at. I've been putting this off for weeks. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.09,
      "end_seconds": 29.53,
      "duration_seconds": 1.44,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.21,
      "end_seconds": 33.2,
      "duration_seconds": 1.99,
      "text": "probably three weeks yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.55,
      "end_seconds": 37.95,
      "duration_seconds": 3.4,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.83,
      "end_seconds": 43.53,
      "duration_seconds": 3.7,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.32,
      "end_seconds": 48.19,
      "duration_seconds": 3.87,
      "text": "any a milky discharge from your breasts as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.94,
      "end_seconds": 55.12,
      "duration_seconds": 6.18,
      "text": "yeah, that too. Oh, and periods stopped for four months"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.49,
      "end_seconds": 64.96,
      "duration_seconds": 8.47,
      "text": "What conditions have you been treated for in the past? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.41,
      "end_seconds": 73.59,
      "duration_seconds": 7.18,
      "text": "uh, you know, yes, asthma i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.21,
      "end_seconds": 86.26,
      "duration_seconds": 11.05,
      "text": "Right, so so asthma is already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.13,
      "end_seconds": 89.74,
      "duration_seconds": 1.61,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.2,
      "end_seconds": 92.15,
      "duration_seconds": 0.95,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.34,
      "end_seconds": 97.99,
      "duration_seconds": 4.65,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.05,
      "end_seconds": 101.05,
      "duration_seconds": 2.0,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.95,
      "end_seconds": 106.22,
      "duration_seconds": 4.27,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.52,
      "end_seconds": 109.38,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.9,
      "end_seconds": 114.51,
      "duration_seconds": 3.61,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.5,
      "end_seconds": 117.75,
      "duration_seconds": 1.25,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.13,
      "end_seconds": 123.26,
      "duration_seconds": 4.13,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.45,
      "end_seconds": 126.84,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.22,
      "end_seconds": 132.51,
      "duration_seconds": 4.29,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.4,
      "end_seconds": 138.04,
      "duration_seconds": 3.64,
      "text": "which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.27,
      "end_seconds": 165.86,
      "duration_seconds": 26.59,
      "text": "Okay, you know, so I'm on Asthalin inhaler, when needed for my asthma. My neighbour said I should get it looked at. I took the morning off to come in today. Let me think, before this I was on Seretide inhaler; that's been stopped."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.1,
      "end_seconds": 172.5,
      "duration_seconds": 5.4,
      "text": "let me check a few things. Any visual changes or hot flushes?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.78,
      "end_seconds": 178.25,
      "duration_seconds": 4.47,
      "text": "No you know no visual changes or hot flushes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.05,
      "end_seconds": 185.01,
      "duration_seconds": 5.96,
      "text": "let me check a few things any weight change or positive pregnancy test?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.85,
      "end_seconds": 189.06,
      "duration_seconds": 3.21,
      "text": "yeah, no, none that I've noticed"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.41,
      "end_seconds": 193.15,
      "duration_seconds": 2.74,
      "text": "right, has your skin been okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.85,
      "end_seconds": 197.03,
      "duration_seconds": 3.18,
      "text": "Right nothing on the skin no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.8,
      "end_seconds": 202.97,
      "duration_seconds": 4.17,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.93,
      "end_seconds": 207.46,
      "duration_seconds": 3.53,
      "text": "Bowels are regular, um, nothing odd."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.28,
      "end_seconds": 220.54,
      "duration_seconds": 3.26,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.2,
      "end_seconds": 234.5,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.21,
      "end_seconds": 257.89,
      "duration_seconds": 4.68,
      "text": "okay: temperature 36.5, heart rate 82, pressure 126 over 69."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.57,
      "end_seconds": 265.15,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.08,
      "end_seconds": 270.44,
      "duration_seconds": 3.36,
      "text": "I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.19,
      "end_seconds": 276.32,
      "duration_seconds": 4.13,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.25,
      "end_seconds": 281.64,
      "duration_seconds": 3.39,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.59,
      "end_seconds": 305.77,
      "duration_seconds": 9.18,
      "text": "you are not pregnant by the urine test, the breasts express a little milk, and there is no visual field loss"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.05,
      "end_seconds": 312.91,
      "duration_seconds": 1.86,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.92,
      "end_seconds": 340.74,
      "duration_seconds": 13.82,
      "text": "Putting it all together, this looks most like raised prolactin or a thyroid problem rather than stress. It could also be polycystic ovary syndrome, so we'll keep that open."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.44,
      "end_seconds": 343.61,
      "duration_seconds": 2.17,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.58,
      "end_seconds": 358.81,
      "duration_seconds": 14.23,
      "text": "I understand the worry. At the moment I'd say it's raised prolactin or a thyroid problem rather than stress and we'll know more once the a pregnancy test is back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.22,
      "end_seconds": 380.01,
      "duration_seconds": 3.79,
      "text": "I'll request a pregnancy test, it'll help with amenorrhoea."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.63,
      "end_seconds": 388.49,
      "duration_seconds": 7.86,
      "text": "could I get a prolactin and thyroid blood test done? A friend had it"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.48,
      "end_seconds": 396.38,
      "duration_seconds": 6.9,
      "text": "so I wouldn't order it today if anything changes we'll reconsider does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.44,
      "end_seconds": 402.17,
      "duration_seconds": 4.73,
      "text": "hmm okay that makes sense thanks for explaining"
    }
  ]
