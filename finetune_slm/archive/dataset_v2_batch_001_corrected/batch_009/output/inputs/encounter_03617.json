  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 2.9,
      "duration_seconds": 1.99,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.94,
      "end_seconds": 10.41,
      "duration_seconds": 5.47,
      "text": "doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.05,
      "end_seconds": 17.5,
      "duration_seconds": 6.45,
      "text": "Right, good, that'll be useful. Pull up a chair. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.69,
      "end_seconds": 22.44,
      "duration_seconds": 3.75,
      "text": "hmm, only about ten minutes, no trouble"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.68,
      "end_seconds": 25.44,
      "duration_seconds": 1.76,
      "text": "where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.43,
      "end_seconds": 33.31,
      "duration_seconds": 5.88,
      "text": "Doctor, it's been feeling like I have flu. That's what we're worried about."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.95,
      "end_seconds": 36.96,
      "duration_seconds": 3.01,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.33,
      "end_seconds": 41.52,
      "duration_seconds": 3.19,
      "text": "I'd say about a month, maybe"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.93,
      "end_seconds": 46.71,
      "duration_seconds": 3.78,
      "text": "it was closer to about two months, doctor"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.22,
      "end_seconds": 55.92,
      "duration_seconds": 4.7,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.6,
      "end_seconds": 58.44,
      "duration_seconds": 1.84,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.01,
      "end_seconds": 62.84,
      "duration_seconds": 2.83,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.19,
      "end_seconds": 81.12,
      "duration_seconds": 13.93,
      "text": "mostly severe. I've also been losing weight, for three days. Oh, and nausea. That's been about the same, about four days. And being very thirsty, too"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.78,
      "end_seconds": 84.13,
      "duration_seconds": 1.35,
      "text": "What about diarrhoea?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.28,
      "end_seconds": 90.28,
      "duration_seconds": 3.0,
      "text": "No, I haven't had any diarrhoea."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 91.45,
      "end_seconds": 96.5,
      "duration_seconds": 5.05,
      "text": "Actually, doctor, I did notice diarrhoea. She doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.54,
      "end_seconds": 104.35,
      "duration_seconds": 6.81,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.95,
      "end_seconds": 115.0,
      "duration_seconds": 10.05,
      "text": "Alright, I'll note both what you've said and what you've noticed. Okay, any sore throat, fever or cough at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.73,
      "end_seconds": 120.01,
      "duration_seconds": 4.28,
      "text": "No sore throat, fever or cough, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 123.45,
      "duration_seconds": 3.11,
      "text": "hm, okay. Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.39,
      "end_seconds": 127.08,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.35,
      "end_seconds": 132.4,
      "duration_seconds": 4.05,
      "text": "Okay, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.33,
      "end_seconds": 135.2,
      "duration_seconds": 1.87,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.97,
      "end_seconds": 158.6,
      "duration_seconds": 6.63,
      "text": "any health conditions I should have on record? These questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.74,
      "end_seconds": 175.83,
      "duration_seconds": 13.09,
      "text": "Depression, for about a year i thought it would sort itself out, but it hasn't i've had anxiety for nearly five years now"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.39,
      "end_seconds": 189.81,
      "duration_seconds": 12.42,
      "text": "Yes, carry on. Right, so anxiety is already on your record. We'll keep that in mind today. Right, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.22,
      "end_seconds": 201.62,
      "duration_seconds": 10.4,
      "text": "Not much, I mostly stay in these days. I look after my grandchildren most days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.15,
      "end_seconds": 207.78,
      "duration_seconds": 4.63,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.5,
      "end_seconds": 212.9,
      "duration_seconds": 3.4,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 217.54,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 218.85,
      "end_seconds": 228.63,
      "duration_seconds": 9.78,
      "text": "It's sertraline, 50 milligrams, once a day, doctor. She takes escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.49,
      "end_seconds": 231.89,
      "duration_seconds": 1.4,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 233.33,
      "end_seconds": 235.38,
      "duration_seconds": 2.05,
      "text": "For about a month."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.39,
      "end_seconds": 254.77,
      "duration_seconds": 1.38,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.19,
      "end_seconds": 257.22,
      "duration_seconds": 1.03,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.5,
      "end_seconds": 261.37,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.28,
      "end_seconds": 276.74,
      "duration_seconds": 2.46,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.39,
      "end_seconds": 301.98,
      "duration_seconds": 10.59,
      "text": "Okay: height 166 centimetres, heart rate 111, blood pressure 130 over 70, saturation 98 percent, weight 87 kilos, BMI works out to 31.6."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.87,
      "end_seconds": 304.29,
      "duration_seconds": 1.42,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.55,
      "end_seconds": 308.91,
      "duration_seconds": 3.36,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.54,
      "end_seconds": 313.64,
      "duration_seconds": 3.1,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.65,
      "end_seconds": 315.99,
      "duration_seconds": 1.34,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.28,
      "end_seconds": 336.94,
      "duration_seconds": 5.66,
      "text": "you are breathing a little deeply and fast and your mouth is dry"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.13,
      "end_seconds": 358.3,
      "duration_seconds": 18.17,
      "text": "Thank you, you can get dressed. Let me tell you where I've got to. It fits best with possible new type 1 diabetes starting to turn acidic. That's my thinking for now, and it may change as we learn more. We shouldn't forget a viral illness."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.18,
      "end_seconds": 400.58,
      "duration_seconds": 28.4,
      "text": "I want blood tests done, that's for possible ketoacidosis i think a finger-prick glucose and ketones makes sense here, for thirst and weight loss this is not flu, your sugar is very high, and you need hospital insulin today cut down on salt and fried food for now, it really does make a difference i'm going to send a referral to the diabetes team"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 401.97,
      "end_seconds": 414.67,
      "duration_seconds": 12.7,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 415.46,
      "end_seconds": 419.04,
      "duration_seconds": 3.58,
      "text": "Right, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.98,
      "end_seconds": 422.34,
      "duration_seconds": 1.36,
      "text": "See you soon."
    }
  ]
}