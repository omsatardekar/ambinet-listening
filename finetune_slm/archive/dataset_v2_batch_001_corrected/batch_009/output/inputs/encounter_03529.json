  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.36,
      "duration_seconds": 2.84,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.71,
      "end_seconds": 9.94,
      "duration_seconds": 5.23,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.59,
      "end_seconds": 15.49,
      "duration_seconds": 4.9,
      "text": "I wanted to get a little drooling looked at"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.03,
      "end_seconds": 19.36,
      "duration_seconds": 2.33,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.06,
      "end_seconds": 32.69,
      "duration_seconds": 2.63,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.23,
      "end_seconds": 55.35,
      "duration_seconds": 13.12,
      "text": "Okay: temperature is 36.5 degrees, pressure 110 over 74, BMI works out to 19.3, pulse is 85 beats a minute, respiratory rate 14, height 178 centimetres, weight 61 kilos."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.13,
      "end_seconds": 58.58,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.47,
      "end_seconds": 66.15,
      "duration_seconds": 5.68,
      "text": "We'll look at it together shortly. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.84,
      "end_seconds": 74.75,
      "duration_seconds": 7.91,
      "text": "It's been two weeks, I'm fairly sure. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.39,
      "end_seconds": 79.18,
      "duration_seconds": 2.79,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.02,
      "end_seconds": 81.07,
      "duration_seconds": 1.05,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.25,
      "end_seconds": 85.11,
      "duration_seconds": 2.86,
      "text": "Right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.31,
      "end_seconds": 100.61,
      "duration_seconds": 14.3,
      "text": "Seen putting a coin-like object in his mouth goes along with it, most of the time. The Seen putting a coin-like object in his mouth? That's been since Monday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.84,
      "end_seconds": 104.91,
      "duration_seconds": 3.07,
      "text": "Any breathing difficulty, rash or vomiting blood?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.94,
      "end_seconds": 110.55,
      "duration_seconds": 4.61,
      "text": "no, no breathing difficulty, rash or vomiting blood"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.7,
      "end_seconds": 114.17,
      "duration_seconds": 2.47,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.22,
      "end_seconds": 117.92,
      "duration_seconds": 1.7,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.92,
      "end_seconds": 120.89,
      "duration_seconds": 1.97,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.6,
      "end_seconds": 124.22,
      "duration_seconds": 1.62,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.66,
      "end_seconds": 129.73,
      "duration_seconds": 4.07,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.41,
      "end_seconds": 138.87,
      "duration_seconds": 4.46,
      "text": "Let me think, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.94,
      "end_seconds": 154.79,
      "duration_seconds": 2.85,
      "text": "Right, any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.68,
      "end_seconds": 159.97,
      "duration_seconds": 3.29,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.23,
      "end_seconds": 180.86,
      "duration_seconds": 3.63,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.16,
      "end_seconds": 185.46,
      "duration_seconds": 3.3,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.25,
      "end_seconds": 189.48,
      "duration_seconds": 3.23,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.47,
      "end_seconds": 196.9,
      "duration_seconds": 5.43,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.0,
      "end_seconds": 199.81,
      "duration_seconds": 1.81,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.71,
      "end_seconds": 205.23,
      "duration_seconds": 3.52,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.62,
      "end_seconds": 210.86,
      "duration_seconds": 4.24,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.51,
      "end_seconds": 215.81,
      "duration_seconds": 3.3,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.36,
      "end_seconds": 222.64,
      "duration_seconds": 5.28,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.62,
      "end_seconds": 225.32,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.04,
      "end_seconds": 230.27,
      "duration_seconds": 3.23,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.85,
      "end_seconds": 248.23,
      "duration_seconds": 4.38,
      "text": "He is playful, breathing normally and the throat looks normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.11,
      "end_seconds": 256.67,
      "duration_seconds": 2.56,
      "text": "So, you can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.17,
      "end_seconds": 287.2,
      "duration_seconds": 20.03,
      "text": "Taking everything into account, the most likely explanation is a possible swallowed button battery needing an urgent X-ray despite few symptoms. Stop me if I've got anything wrong. You've had a little drooling for two weeks, moderate, and no breathing difficulty or rash."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.89,
      "end_seconds": 289.53,
      "duration_seconds": 1.64,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.37,
      "end_seconds": 311.15,
      "duration_seconds": 4.78,
      "text": "Let's get an urgent chest and abdominal X-ray, for possible battery ingestion."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.17,
      "end_seconds": 313.33,
      "duration_seconds": 1.16,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.85,
      "end_seconds": 326.05,
      "duration_seconds": 11.2,
      "text": "A button battery can burn the gullet within hours even when a child looks well, so we scan now. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.71,
      "end_seconds": 328.63,
      "duration_seconds": 0.92,
      "text": "I understand"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.62,
      "end_seconds": 334.97,
      "duration_seconds": 5.35,
      "text": "I'd like you back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.83,
      "end_seconds": 343.39,
      "duration_seconds": 3.56,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
