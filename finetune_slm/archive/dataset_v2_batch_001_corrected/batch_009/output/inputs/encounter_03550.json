{
  "schema_version": "1.0",
  "encounter_id": "03550",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.01,
      "end_seconds": 5.7,
      "duration_seconds": 4.69,
      "text": "afternoon, doctor. They're in and comfortable, and I have the measurements ready"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 9.93,
      "duration_seconds": 3.48,
      "text": "okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 10.67,
      "end_seconds": 23.01,
      "duration_seconds": 12.34,
      "text": "Mainly a bit of stiffness in my knee replacement. There's a couple of other things, uh, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.01,
      "end_seconds": 27.21,
      "duration_seconds": 3.2,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.95,
      "end_seconds": 32.77,
      "duration_seconds": 3.82,
      "text": "Mm, ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.48,
      "end_seconds": 37.83,
      "duration_seconds": 3.35,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.34,
      "end_seconds": 44.8,
      "duration_seconds": 5.46,
      "text": "I mean, um, it feels severe to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.43,
      "end_seconds": 48.77,
      "duration_seconds": 3.34,
      "text": "what about night sweats, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.75,
      "end_seconds": 58.35,
      "duration_seconds": 8.6,
      "text": "Mm, yes. Oh, um, and slight warmth. That's been about the same, about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.4,
      "end_seconds": 63.17,
      "duration_seconds": 3.77,
      "text": "Have you had any recent injury or severe pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.73,
      "end_seconds": 68.62,
      "duration_seconds": 4.89,
      "text": "No recent injury or severe pain, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.19,
      "end_seconds": 74.12,
      "duration_seconds": 4.93,
      "text": "Sure. Have you had any high fever or wound discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.13,
      "end_seconds": 79.74,
      "duration_seconds": 3.61,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.54,
      "end_seconds": 85.35,
      "duration_seconds": 3.81,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.33,
      "end_seconds": 94.74,
      "duration_seconds": 3.41,
      "text": "Okay, so no, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.87,
      "end_seconds": 102.88,
      "duration_seconds": 2.01,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.54,
      "end_seconds": 105.17,
      "duration_seconds": 1.63,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.84,
      "end_seconds": 108.77,
      "duration_seconds": 2.93,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.29,
      "end_seconds": 118.57,
      "duration_seconds": 4.28,
      "text": "I have diabetes. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.95,
      "end_seconds": 135.4,
      "duration_seconds": 3.45,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.94,
      "end_seconds": 139.29,
      "duration_seconds": 3.35,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.05,
      "end_seconds": 143.91,
      "duration_seconds": 2.86,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.26,
      "end_seconds": 151.75,
      "duration_seconds": 6.49,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.56,
      "end_seconds": 157.37,
      "duration_seconds": 4.81,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.04,
      "end_seconds": 175.06,
      "duration_seconds": 16.02,
      "text": "I gave up cigarettes last spring. I retired from the post office two years ago. I grab fast food at lunch most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.02,
      "end_seconds": 180.65,
      "duration_seconds": 3.63,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.89,
      "end_seconds": 189.97,
      "duration_seconds": 4.08,
      "text": "I take glibenclamide, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.58,
      "end_seconds": 193.03,
      "duration_seconds": 2.45,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.68,
      "end_seconds": 203.65,
      "duration_seconds": 8.97,
      "text": "5 milligrams, I think that's what's on the box. I'm on aspirin, 75 milligrams, once a day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 205.14,
      "end_seconds": 213.75,
      "duration_seconds": 8.61,
      "text": "Doctor, I've got the readings for you. Temperature is 36.4 degrees, saturation 98 percent, pressure 128 over 76, pulse 82."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.15,
      "end_seconds": 219.07,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.13,
      "end_seconds": 248.41,
      "duration_seconds": 14.28,
      "text": "Okay, so my impression from what you've said is this: I don't have a clear answer today: a possible low-grade infection of the knee replacement is possible, and so is wear and tear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.17,
      "end_seconds": 270.49,
      "duration_seconds": 4.32,
      "text": "I'm going to order a joint aspiration, for warm effusion"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.74,
      "end_seconds": 273.37,
      "duration_seconds": 1.63,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.56,
      "end_seconds": 278.1,
      "duration_seconds": 3.54,
      "text": "let's get blood tests, for possible prosthetic infection"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 279.32,
      "end_seconds": 280.97,
      "duration_seconds": 1.65,
      "text": "does it hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.76,
      "end_seconds": 289.01,
      "duration_seconds": 7.25,
      "text": "even without a fever, an infected replacement is serious, so the orthopaedic team will see you"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.5,
      "end_seconds": 294.46,
      "duration_seconds": 4.96,
      "text": "Yes, carry on. I'll also refer you to the orthopaedic team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.42,
      "end_seconds": 301.09,
      "duration_seconds": 4.67,
      "text": "Yeah, uh, sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.22,
      "end_seconds": 315.76,
      "duration_seconds": 13.54,
      "text": "One warning sign to remember: the symptoms get worse. In that that case don't wait. Please come and see me within two days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.26,
      "end_seconds": 320.4,
      "duration_seconds": 3.14,
      "text": "no, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.64,
      "end_seconds": 322.93,
      "duration_seconds": 1.29,
      "text": "Goodbye for now."
    }
  ]
}