{
  "schema_version": "1.0",
  "encounter_id": "03692",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 3.62,
      "duration_seconds": 2.79,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.49,
      "end_seconds": 9.7,
      "duration_seconds": 5.21,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.71,
      "end_seconds": 14.74,
      "duration_seconds": 4.03,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.14,
      "end_seconds": 18.9,
      "duration_seconds": 2.76,
      "text": "Okay, what's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.94,
      "end_seconds": 25.86,
      "duration_seconds": 5.92,
      "text": "Um, so... blacking out when I stand quickly. That's why I came."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.47,
      "end_seconds": 30.44,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.08,
      "end_seconds": 33.94,
      "duration_seconds": 2.86,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.84,
      "end_seconds": 39.25,
      "duration_seconds": 3.41,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 48.63,
      "duration_seconds": 7.47,
      "text": "Mild, I'd say. I've, I've also been feeling lightheaded. With feeling lightheaded, moderate, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.86,
      "end_seconds": 53.52,
      "duration_seconds": 4.66,
      "text": "I see, go ahead. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.0,
      "end_seconds": 65.92,
      "duration_seconds": 2.92,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.99,
      "end_seconds": 89.06,
      "duration_seconds": 8.07,
      "text": "Okay: heart rate 101, blood pressure 101 over 65, temperature 37.1, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.09,
      "end_seconds": 96.22,
      "duration_seconds": 5.13,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.61,
      "end_seconds": 98.85,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.93,
      "end_seconds": 119.33,
      "duration_seconds": 6.4,
      "text": "Your blood pressure drops a long way when you stand and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.58,
      "end_seconds": 131.98,
      "duration_seconds": 7.4,
      "text": "That's all I needed to check. Have you had any chest pain, seizure or head injury?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.86,
      "end_seconds": 136.22,
      "duration_seconds": 2.36,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.36,
      "end_seconds": 139.12,
      "duration_seconds": 1.76,
      "text": "Any sign of palpitations?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.69,
      "end_seconds": 142.84,
      "duration_seconds": 3.15,
      "text": "No, I haven't had any palpitations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.95,
      "end_seconds": 147.91,
      "duration_seconds": 3.96,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.62,
      "end_seconds": 156.08,
      "duration_seconds": 7.46,
      "text": "Sorry, what was I saying, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.15,
      "end_seconds": 159.79,
      "duration_seconds": 2.64,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.76,
      "end_seconds": 164.09,
      "duration_seconds": 2.33,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.0,
      "end_seconds": 166.23,
      "duration_seconds": 1.23,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.77,
      "end_seconds": 171.07,
      "duration_seconds": 3.3,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.94,
      "end_seconds": 178.83,
      "duration_seconds": 3.89,
      "text": "Right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.36,
      "end_seconds": 181.99,
      "duration_seconds": 2.63,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.08,
      "end_seconds": 202.84,
      "duration_seconds": 2.76,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.73,
      "end_seconds": 207.65,
      "duration_seconds": 3.92,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.05,
      "end_seconds": 211.6,
      "duration_seconds": 2.55,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.44,
      "end_seconds": 215.72,
      "duration_seconds": 3.28,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.31,
      "end_seconds": 219.39,
      "duration_seconds": 2.08,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.99,
      "end_seconds": 227.12,
      "duration_seconds": 6.13,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.51,
      "end_seconds": 245.52,
      "duration_seconds": 2.01,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 246.9,
      "end_seconds": 251.18,
      "duration_seconds": 4.28,
      "text": "She takes tamsulosin, 400 micrograms, started last week."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.03,
      "end_seconds": 269.36,
      "duration_seconds": 17.33,
      "text": "Let me tell you where I've got to. I think we're dealing with medicine-induced postural hypotension at this stage. That's my thinking for now, and it may change as we learn more. I can't rule out an arrhythmia yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.32,
      "end_seconds": 272.25,
      "duration_seconds": 1.93,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.98,
      "end_seconds": 292.91,
      "duration_seconds": 19.93,
      "text": "Nothing I've seen today points to an emergency. It looks like medicine-induced postural hypotension, but I'd like to confirm. Let me just check I've got this right. You've had blacking out when you stand quickly for one week, mild, and no palpitations or seizure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.52,
      "end_seconds": 296.53,
      "duration_seconds": 2.01,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.84,
      "end_seconds": 319.07,
      "duration_seconds": 12.23,
      "text": "I'm going to order an ECG, for syncope. We will move the prostate tablet to bedtime and you should rise slowly. I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.84,
      "end_seconds": 323.11,
      "duration_seconds": 2.27,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.82,
      "end_seconds": 326.49,
      "duration_seconds": 2.67,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.35,
      "end_seconds": 330.99,
      "duration_seconds": 3.64,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.51,
      "end_seconds": 332.7,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}