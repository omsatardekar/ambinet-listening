    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.07,
      "end_seconds": 130.66,
      "duration_seconds": 1.59,
      "text": "Yes, heart failure."
