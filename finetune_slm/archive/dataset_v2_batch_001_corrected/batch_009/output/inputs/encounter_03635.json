      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.39,
      "end_seconds": 33.69,
      "duration_seconds": 3.3,
      "text": "How strong would you say it is?"
