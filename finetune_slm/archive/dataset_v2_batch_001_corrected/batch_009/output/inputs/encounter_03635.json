    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.35,
      "end_seconds": 137.71,
      "duration_seconds": 3.36,
      "text": "I have diabetes, for about a year."
