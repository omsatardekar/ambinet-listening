    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.71,
      "end_seconds": 93.11,
      "duration_seconds": 2.4,
      "text": "my aunt has rheumatoid arthritis"
