      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.76,
      "end_seconds": 161.18,
      "duration_seconds": 3.42,
      "text": "I take furosemide, 40 milligrams, every morning"
