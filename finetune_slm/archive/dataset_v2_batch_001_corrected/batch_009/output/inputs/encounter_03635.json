    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.49,
      "end_seconds": 147.32,
      "duration_seconds": 7.83,
      "text": "alright, heart failure and diabetes, that matches what I have here have you had any previous surgeries?"
