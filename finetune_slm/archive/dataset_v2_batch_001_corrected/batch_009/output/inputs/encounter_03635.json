    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.11,
      "end_seconds": 167.48,
      "duration_seconds": 2.37,
      "text": "Let me take your readings now."
