      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.59,
      "end_seconds": 178.94,
      "duration_seconds": 2.35,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.71,
      "end_seconds": 196.1,
      "duration_seconds": 7.39,
      "text": "okay: heart rate 120, temperature 36.7, SpO2 98 percent on room air, blood pressure 121 over 71."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.05,
      "end_seconds": 202.32,
      "duration_seconds": 3.27,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.18,
      "end_seconds": 205.36,
      "duration_seconds": 1.18,
      "text": "does that hurt?"
    },
