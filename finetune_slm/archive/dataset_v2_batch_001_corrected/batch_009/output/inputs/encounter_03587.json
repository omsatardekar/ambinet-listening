{
  "schema_version": "1.0",
  "encounter_id": "03587",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.86,
      "duration_seconds": 4.18,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.9,
      "end_seconds": 10.86,
      "duration_seconds": 4.96,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.53,
      "end_seconds": 21.65,
      "duration_seconds": 10.12,
      "text": "Um, so... a bit of stiffness in my knee replacement. That's why I came. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.74,
      "end_seconds": 25.13,
      "duration_seconds": 2.39,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.19,
      "end_seconds": 32.57,
      "duration_seconds": 3.38,
      "text": "I've had it for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.78,
      "end_seconds": 38.68,
      "duration_seconds": 4.9,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.63,
      "end_seconds": 46.3,
      "duration_seconds": 5.67,
      "text": "It just comes and goes. Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.56,
      "end_seconds": 49.98,
      "duration_seconds": 2.42,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.83,
      "end_seconds": 63.57,
      "duration_seconds": 11.74,
      "text": "Slight warmth goes along with it, most of the time. Sorry, what was I saying, the slight warmth? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 64.85,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.35,
      "end_seconds": 69.16,
      "duration_seconds": 2.81,
      "text": "I've been feeling tired too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.31,
      "end_seconds": 75.6,
      "duration_seconds": 5.29,
      "text": "Have you had any severe pain, wound discharge, high fever or recent injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 84.44,
      "duration_seconds": 7.72,
      "text": "I haven't had severe pain, wound discharge, high fever or recent injury, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.83,
      "end_seconds": 87.86,
      "duration_seconds": 2.03,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.77,
      "end_seconds": 90.66,
      "duration_seconds": 0.89,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.72,
      "end_seconds": 97.87,
      "duration_seconds": 5.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.01,
      "end_seconds": 103.17,
      "duration_seconds": 4.16,
      "text": "It's Glycomet, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.15,
      "end_seconds": 107.28,
      "duration_seconds": 2.13,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.28,
      "end_seconds": 109.69,
      "duration_seconds": 1.41,
      "text": "It's 500 milligrams."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.08,
      "end_seconds": 114.79,
      "duration_seconds": 3.71,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.04,
      "end_seconds": 117.97,
      "duration_seconds": 1.93,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.64,
      "end_seconds": 130.94,
      "duration_seconds": 1.3,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.81,
      "end_seconds": 135.9,
      "duration_seconds": 4.09,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.8,
      "end_seconds": 141.11,
      "duration_seconds": 1.31,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.2,
      "end_seconds": 146.83,
      "duration_seconds": 3.63,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.83,
      "end_seconds": 150.29,
      "duration_seconds": 2.46,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.6,
      "end_seconds": 156.21,
      "duration_seconds": 4.61,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.8,
      "end_seconds": 159.12,
      "duration_seconds": 2.32,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.03,
      "end_seconds": 163.96,
      "duration_seconds": 3.93,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.06,
      "end_seconds": 170.62,
      "duration_seconds": 1.56,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.72,
      "end_seconds": 176.63,
      "duration_seconds": 3.91,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.64,
      "end_seconds": 193.47,
      "duration_seconds": 2.83,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.54,
      "end_seconds": 197.68,
      "duration_seconds": 3.14,
      "text": "I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.27,
      "end_seconds": 200.7,
      "duration_seconds": 2.43,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.85,
      "end_seconds": 204.81,
      "duration_seconds": 2.96,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.65,
      "end_seconds": 208.01,
      "duration_seconds": 2.36,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.0,
      "end_seconds": 223.41,
      "duration_seconds": 2.41,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.4,
      "end_seconds": 246.3,
      "duration_seconds": 7.9,
      "text": "Okay: oxygen saturation is 97 percent, temp 36.9 degrees, heart rate 77. And blood pressure 120 over 68."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.5,
      "end_seconds": 251.91,
      "duration_seconds": 4.41,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.3,
      "end_seconds": 255.73,
      "duration_seconds": 2.43,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.45,
      "end_seconds": 272.05,
      "duration_seconds": 6.6,
      "text": "The knee is mildly warm with a small effusion and the replacement scar is clean."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.08,
      "end_seconds": 277.64,
      "duration_seconds": 2.56,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.61,
      "end_seconds": 309.01,
      "duration_seconds": 18.4,
      "text": "So where does that leave us? It points towards a possible low-grade infection of the knee replacement. I want to be honest that this is an impression, not a final answer. It could also be wear and tear, so we'll keep that open."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.35,
      "end_seconds": 314.15,
      "duration_seconds": 3.8,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.0,
      "end_seconds": 346.45,
      "duration_seconds": 31.45,
      "text": "I understand the worry. At the moment I'd say it's a possible low-grade infection of the knee replacement, and we'll know more once the blood tests is back. I'll request blood tests, it'll help with possible prosthetic infection. That will help us see what's going on underneath and decide the next step. Even without a fever, an infected replacement is serious, so the orthopaedic team will see you. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.43,
      "end_seconds": 349.25,
      "duration_seconds": 1.82,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.98,
      "end_seconds": 358.64,
      "duration_seconds": 8.66,
      "text": "Let's plan a check within two days. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.57,
      "end_seconds": 362.81,
      "duration_seconds": 2.24,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.8,
      "end_seconds": 366.66,
      "duration_seconds": 1.86,
      "text": "Have a good day."
    }
  ]
}