{
  "schema_version": "1.0",
  "encounter_id": "03638",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 7.7,
      "duration_seconds": 6.32,
      "text": "yeah, uh, hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.4,
      "end_seconds": 13.72,
      "duration_seconds": 4.32,
      "text": "that's fine sit down. Tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.53,
      "end_seconds": 21.56,
      "duration_seconds": 6.03,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.09,
      "end_seconds": 26.51,
      "duration_seconds": 4.42,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.64,
      "end_seconds": 37.44,
      "duration_seconds": 9.8,
      "text": "yeah, it's a bit of stiffness in my knee replacement. I don't know what's causing it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.12,
      "end_seconds": 41.3,
      "duration_seconds": 3.18,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 56.79,
      "duration_seconds": 13.47,
      "text": "well, about... well, four weeks i just want to get back to normal, really it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.67,
      "end_seconds": 66.71,
      "duration_seconds": 9.04,
      "text": "Tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.06,
      "end_seconds": 78.0,
      "duration_seconds": 9.94,
      "text": "Moderate I'd say. It's all the time. And I've been feeling tired as well for about a month"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.06,
      "end_seconds": 83.36,
      "duration_seconds": 3.3,
      "text": "rate it for me mild moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.06,
      "end_seconds": 94.27,
      "duration_seconds": 9.21,
      "text": "mm, about a six out of ten. Slight warmth was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.37,
      "end_seconds": 99.67,
      "duration_seconds": 4.3,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.27,
      "end_seconds": 105.77,
      "duration_seconds": 4.5,
      "text": "Metformin. I take it 500 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 106.8,
      "end_seconds": 114.6,
      "duration_seconds": 7.8,
      "text": "he is supposed to take it twice a day, but I can't say he always does"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.46,
      "end_seconds": 127.75,
      "duration_seconds": 4.29,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.37,
      "end_seconds": 142.34,
      "duration_seconds": 13.97,
      "text": "yeah, I've had diabetes for nearly five years now hmm, I have low haemoglobin i didn't wanna make a a fuss, you know"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.8,
      "end_seconds": 147.35,
      "duration_seconds": 3.55,
      "text": "Alright diabetes that matches what I have here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.76,
      "end_seconds": 170.6,
      "duration_seconds": 4.84,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.86,
      "end_seconds": 175.57,
      "duration_seconds": 3.71,
      "text": "erm, no, I've never reacted to anything"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 177.07,
      "end_seconds": 186.77,
      "duration_seconds": 9.7,
      "text": "Well, uh, hold on, doctor, I think he reacted to trimethoprim once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.99,
      "end_seconds": 191.18,
      "duration_seconds": 3.19,
      "text": "Ah, I don't remember that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.23,
      "end_seconds": 198.9,
      "duration_seconds": 5.67,
      "text": "alright, so that's unclear i'll record what each of you said do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.06,
      "end_seconds": 204.04,
      "duration_seconds": 3.98,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.04,
      "end_seconds": 206.73,
      "duration_seconds": 1.69,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.81,
      "end_seconds": 213.36,
      "duration_seconds": 5.55,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.97,
      "end_seconds": 216.3,
      "duration_seconds": 1.33,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.87,
      "end_seconds": 221.09,
      "duration_seconds": 4.22,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.39,
      "end_seconds": 224.02,
      "duration_seconds": 1.63,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.48,
      "end_seconds": 228.05,
      "duration_seconds": 2.57,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.2,
      "end_seconds": 233.34,
      "duration_seconds": 4.14,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.88,
      "end_seconds": 237.57,
      "duration_seconds": 2.69,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.17,
      "end_seconds": 241.35,
      "duration_seconds": 3.18,
      "text": "did you get high fever or severe pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.72,
      "end_seconds": 247.2,
      "duration_seconds": 4.48,
      "text": "Well, no, nothing to to report there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.86,
      "end_seconds": 251.13,
      "duration_seconds": 3.27,
      "text": "did you get recent injury or wound discharge?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.57,
      "end_seconds": 257.49,
      "duration_seconds": 4.92,
      "text": "actually no recent injury or wound discharge none of it"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.1,
      "end_seconds": 262.66,
      "duration_seconds": 3.56,
      "text": "anything with your heart like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.58,
      "end_seconds": 266.92,
      "duration_seconds": 3.34,
      "text": "yeah, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.76,
      "end_seconds": 270.48,
      "duration_seconds": 2.72,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.0,
      "end_seconds": 273.06,
      "duration_seconds": 1.06,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.08,
      "end_seconds": 293.51,
      "duration_seconds": 3.43,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.39,
      "end_seconds": 309.38,
      "duration_seconds": 1.99,
      "text": "okay this won't take long.."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.31,
      "end_seconds": 329.5,
      "duration_seconds": 9.19,
      "text": "okay: saturation 98 percent, respiratory rate 17, temperature is 36.4 degrees. And heart rate 80, BP is 122 over 82."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.27,
      "end_seconds": 333.67,
      "duration_seconds": 3.4,
      "text": "uh is that alright doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.52,
      "end_seconds": 338.49,
      "duration_seconds": 3.97,
      "text": "they help me see the whole picture, more shortly"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.64,
      "end_seconds": 343.73,
      "duration_seconds": 4.09,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.76,
      "end_seconds": 347.42,
      "duration_seconds": 1.66,
      "text": "Yes that's fine."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.21,
      "end_seconds": 350.88,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.05,
      "end_seconds": 365.26,
      "duration_seconds": 7.21,
      "text": "The knee is mildly warm with a small effusion and the the replacement scar is clean."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.27,
      "end_seconds": 381.46,
      "duration_seconds": 13.19,
      "text": "all finished thank you. Okay so my impression is this: I don't have a clear answer today: a possible low-grade infection of the knee replacement is possible and so is wear and tear"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.58,
      "end_seconds": 389.78,
      "duration_seconds": 4.2,
      "text": "Hmm uh is it dangerous doctor?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.3,
      "end_seconds": 417.43,
      "duration_seconds": 22.13,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible low-grade infection of the knee replacement, but I'd like to confirm. Let me just check I've got this right. You've had a bit of stiffness in your knee replacement for four weeks, moderate, and no high fever or severe pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.73,
      "end_seconds": 420.64,
      "duration_seconds": 1.91,
      "text": "mm, that's right"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.83,
      "end_seconds": 443.32,
      "duration_seconds": 21.49,
      "text": "I'm sending you for blood tests because of possible prosthetic infection. I'm going to order a joint aspiration for warm effusion. Even without a fever an infected replacement is serious so the orthopaedic team will see you. I'll want another look within two days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.64,
      "end_seconds": 447.91,
      "duration_seconds": 3.27,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.72,
      "end_seconds": 450.98,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}