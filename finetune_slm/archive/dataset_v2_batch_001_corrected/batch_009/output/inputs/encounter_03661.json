  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.21,
      "end_seconds": 6.0,
      "duration_seconds": 4.79,
      "text": "afternoon, thanks for coming in what's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.98,
      "end_seconds": 15.96,
      "duration_seconds": 8.98,
      "text": "Oh, it's poor appetite for two days, mostly. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.49,
      "end_seconds": 20.19,
      "duration_seconds": 3.7,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.7,
      "end_seconds": 37.37,
      "duration_seconds": 15.67,
      "text": "Erm, it's been about a month, I'm fairly sure. I've been putting this off for weeks. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.72,
      "end_seconds": 38.46,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.25,
      "end_seconds": 46.88,
      "duration_seconds": 6.63,
      "text": "Right, um, I've had a vague tummy ache too, for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.96,
      "end_seconds": 55.92,
      "duration_seconds": 4.96,
      "text": "Right, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.26,
      "end_seconds": 59.5,
      "duration_seconds": 2.24,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.89,
      "end_seconds": 63.23,
      "duration_seconds": 2.34,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.11,
      "end_seconds": 68.92,
      "duration_seconds": 4.81,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.2,
      "end_seconds": 72.17,
      "duration_seconds": 1.97,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.5,
      "end_seconds": 78.42,
      "duration_seconds": 4.92,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.94,
      "end_seconds": 82.07,
      "duration_seconds": 3.13,
      "text": "Okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.73,
      "end_seconds": 87.54,
      "duration_seconds": 3.81,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.33,
      "end_seconds": 91.13,
      "duration_seconds": 1.8,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.33,
      "end_seconds": 97.02,
      "duration_seconds": 2.69,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.86,
      "end_seconds": 104.76,
      "duration_seconds": 5.9,
      "text": "Do you have any long-term conditions? I'm asking so that that we don't miss anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.85,
      "end_seconds": 108.99,
      "duration_seconds": 2.14,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.5,
      "end_seconds": 110.34,
      "duration_seconds": 0.84,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.76,
      "end_seconds": 128.57,
      "duration_seconds": 2.81,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.89,
      "end_seconds": 131.11,
      "duration_seconds": 1.22,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.73,
      "end_seconds": 133.95,
      "duration_seconds": 2.22,
      "text": "Did you notice any vomiting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.26,
      "end_seconds": 137.86,
      "duration_seconds": 2.6,
      "text": "Not at all, no vomiting."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.34,
      "end_seconds": 144.48,
      "duration_seconds": 6.14,
      "text": "mm-hmm have you had any high fever, blood in the stool or urinary symptoms?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.01,
      "end_seconds": 148.64,
      "duration_seconds": 2.63,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.04,
      "end_seconds": 153.19,
      "duration_seconds": 3.15,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.28,
      "end_seconds": 157.06,
      "duration_seconds": 1.78,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.63,
      "end_seconds": 160.99,
      "duration_seconds": 2.36,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.02,
      "end_seconds": 165.91,
      "duration_seconds": 2.89,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.31,
      "end_seconds": 180.75,
      "duration_seconds": 3.44,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.2,
      "end_seconds": 191.17,
      "duration_seconds": 1.97,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.01,
      "end_seconds": 209.72,
      "duration_seconds": 8.71,
      "text": "Okay: heart rate 73, temp 36.6 degrees, SpO2 98 percent on room air. And BP is 121 over 76."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.07,
      "end_seconds": 216.11,
      "duration_seconds": 5.04,
      "text": "I'll examine you in a a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.96,
      "end_seconds": 220.82,
      "duration_seconds": 2.86,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.83,
      "end_seconds": 240.16,
      "duration_seconds": 8.33,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.56,
      "end_seconds": 264.44,
      "duration_seconds": 21.88,
      "text": "All finished, thank you. So, based on the history and the examination, it fits best with possible appendicitis, which can look mild in older people. I want to be honest that this is an impression, not a final answer. I'd also keep diverticulitis in mind."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.88,
      "end_seconds": 291.94,
      "duration_seconds": 10.06,
      "text": "Let's book blood tests to look into abdominal pain. Let's get a CT scan of the abdomen, for right iliac fossa tenderness."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.74,
      "end_seconds": 295.42,
      "duration_seconds": 2.68,
      "text": "Right, you know, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.44,
      "end_seconds": 314.62,
      "duration_seconds": 18.18,
      "text": "Even though you look fairly well, I'd like the surgeons to see you today. The surgical team would be the right next step, I'll refer you. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.49,
      "end_seconds": 319.6,
      "duration_seconds": 4.11,
      "text": "Ah, um, thank you, that's clear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.23,
      "end_seconds": 326.1,
      "duration_seconds": 4.87,
      "text": "come back straight away i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.95,
      "end_seconds": 331.63,
      "duration_seconds": 4.68,
      "text": "I mean, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.04,
      "end_seconds": 334.22,
      "duration_seconds": 1.18,
      "text": "See you soon."
    }
  ]
