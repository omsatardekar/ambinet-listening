{
  "schema_version": "1.0",
  "encounter_id": "03502",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.76,
      "duration_seconds": 4.02,
      "text": "Oh, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.53,
      "end_seconds": 9.45,
      "duration_seconds": 3.92,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.16,
      "end_seconds": 14.8,
      "duration_seconds": 3.64,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.5,
      "end_seconds": 20.38,
      "duration_seconds": 3.88,
      "text": "I'm here because of a sore throat."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.96,
      "end_seconds": 23.3,
      "duration_seconds": 2.34,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.86,
      "end_seconds": 28.88,
      "duration_seconds": 5.02,
      "text": "It's escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.77,
      "end_seconds": 34.04,
      "duration_seconds": 3.27,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.85,
      "end_seconds": 37.3,
      "duration_seconds": 2.45,
      "text": "Probably about two weeks. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.25,
      "end_seconds": 40.52,
      "duration_seconds": 2.27,
      "text": "Any mouth ulcers as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.32,
      "end_seconds": 44.99,
      "duration_seconds": 2.67,
      "text": "Yeah. Ten days, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.51,
      "end_seconds": 50.61,
      "duration_seconds": 4.1,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.66,
      "end_seconds": 56.35,
      "duration_seconds": 3.69,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.63,
      "end_seconds": 58.1,
      "duration_seconds": 1.47,
      "text": "Understood. Any diarrhoea?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.92,
      "end_seconds": 62.97,
      "duration_seconds": 3.05,
      "text": "No, you know, none, no diarrhoea."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.56,
      "end_seconds": 67.68,
      "duration_seconds": 4.12,
      "text": "And what about cough, stiff neck or recent tick bite?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.97,
      "end_seconds": 72.69,
      "duration_seconds": 3.72,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.01,
      "end_seconds": 76.77,
      "duration_seconds": 2.76,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.66,
      "end_seconds": 83.9,
      "duration_seconds": 4.24,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.04,
      "end_seconds": 87.56,
      "duration_seconds": 2.52,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.33,
      "end_seconds": 102.28,
      "duration_seconds": 12.95,
      "text": "No, I share a house with my brother. I walk the dog every morning. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.26,
      "end_seconds": 106.72,
      "duration_seconds": 2.46,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.39,
      "end_seconds": 120.49,
      "duration_seconds": 12.1,
      "text": "Yes, I had a varicose vein procedure, last year. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.73,
      "end_seconds": 126.06,
      "duration_seconds": 4.33,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.87,
      "end_seconds": 128.92,
      "duration_seconds": 2.05,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.7,
      "end_seconds": 140.01,
      "duration_seconds": 2.31,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.72,
      "end_seconds": 143.26,
      "duration_seconds": 2.54,
      "text": "Anxiety, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.28,
      "end_seconds": 152.3,
      "duration_seconds": 8.02,
      "text": "Right, right. Right, so anxiety is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.04,
      "end_seconds": 168.74,
      "duration_seconds": 2.7,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.25,
      "end_seconds": 173.54,
      "duration_seconds": 3.29,
      "text": "I'm allergic to kiwi, I get hives."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.0,
      "end_seconds": 177.1,
      "duration_seconds": 2.1,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 186.63,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.27,
      "end_seconds": 208.21,
      "duration_seconds": 10.94,
      "text": "Okay: blood pressure 112 over 80, SpO2 98 percent on room air, respiratory rate 18, temp 39.2 degrees, heart rate 108."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.23,
      "end_seconds": 210.82,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.95,
      "end_seconds": 218.52,
      "duration_seconds": 2.57,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.64,
      "end_seconds": 225.28,
      "duration_seconds": 4.64,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.17,
      "end_seconds": 227.99,
      "duration_seconds": 1.82,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.53,
      "end_seconds": 248.0,
      "duration_seconds": 7.47,
      "text": "There are small mouth ulcers, tender neck glands and a faint pink rash on the chest."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.57,
      "end_seconds": 256.57,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.81,
      "end_seconds": 283.12,
      "duration_seconds": 21.31,
      "text": "You can sit up now. So, based on the history and the examination, I'd lean towards an acute viral illness, possibly early HIV infection. The reason I say that is that your story and my examination fit together. Let's book a glandular fever test to look into sore throat and glands."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.14,
      "end_seconds": 286.38,
      "duration_seconds": 1.24,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.31,
      "end_seconds": 307.08,
      "duration_seconds": 19.77,
      "text": "A fourth-generation HIV test is what I'd like next, for acute viral illness with rash. I'm offering an HIV test with every illness like this, it's routine, and results are confidential. I'm going to send a referral to the sexual health clinic."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.09,
      "end_seconds": 311.98,
      "duration_seconds": 2.89,
      "text": "Alright, you know, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.75,
      "end_seconds": 322.97,
      "duration_seconds": 9.22,
      "text": "Come back after the results. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.9,
      "end_seconds": 329.43,
      "duration_seconds": 5.53,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.04,
      "end_seconds": 335.38,
      "duration_seconds": 4.34,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.69,
      "end_seconds": 340.14,
      "duration_seconds": 3.45,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}