{
  "schema_version": "1.0",
  "encounter_id": "03655",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.58,
      "duration_seconds": 4.55,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 10.14,
      "duration_seconds": 3.94,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 19.1,
      "duration_seconds": 7.77,
      "text": "so, it's not remembering the last hours i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.63,
      "end_seconds": 25.63,
      "duration_seconds": 6.0,
      "text": "Can you tell me when it first started? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.99,
      "end_seconds": 31.33,
      "duration_seconds": 4.34,
      "text": "I've, I've had it for about three months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.61,
      "end_seconds": 35.07,
      "duration_seconds": 2.46,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.04,
      "end_seconds": 37.65,
      "duration_seconds": 1.61,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.25,
      "end_seconds": 43.31,
      "duration_seconds": 4.06,
      "text": "has there been asking the same questions repeatedly too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.31,
      "end_seconds": 46.09,
      "duration_seconds": 1.78,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.69,
      "end_seconds": 50.55,
      "duration_seconds": 2.86,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.11,
      "end_seconds": 59.05,
      "duration_seconds": 1.94,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.25,
      "end_seconds": 85.76,
      "duration_seconds": 6.51,
      "text": "okay: blood pressure 126 over 69, heart rate 75, temperature is 36.6 degrees"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.0,
      "end_seconds": 91.44,
      "duration_seconds": 1.44,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.49,
      "end_seconds": 97.85,
      "duration_seconds": 4.36,
      "text": "so, don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.97,
      "end_seconds": 102.01,
      "duration_seconds": 2.04,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.45,
      "end_seconds": 104.46,
      "duration_seconds": 1.01,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.39,
      "end_seconds": 109.31,
      "duration_seconds": 2.92,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 126.35,
      "duration_seconds": 7.24,
      "text": "You know who you are but not what happened this morning, and the examination otherwise is normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.59,
      "end_seconds": 133.09,
      "duration_seconds": 2.5,
      "text": "So, you can relax now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.89,
      "end_seconds": 151.73,
      "duration_seconds": 3.84,
      "text": "A few quick ones: seizure, slurred speech or headache?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.49,
      "end_seconds": 155.63,
      "duration_seconds": 2.14,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.91,
      "end_seconds": 160.48,
      "duration_seconds": 3.57,
      "text": "Alright, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.06,
      "end_seconds": 167.3,
      "duration_seconds": 6.24,
      "text": "okay, um, so that's normal as far as I know"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.79,
      "end_seconds": 183.31,
      "duration_seconds": 2.52,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.39,
      "end_seconds": 189.74,
      "duration_seconds": 5.35,
      "text": "Glibenclamide. I take it 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.92,
      "end_seconds": 206.31,
      "duration_seconds": 4.39,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.34,
      "end_seconds": 219.77,
      "duration_seconds": 11.43,
      "text": "My partner and our baby. I retired from the post office two years ago. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.21,
      "end_seconds": 224.89,
      "duration_seconds": 3.68,
      "text": "so, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.39,
      "end_seconds": 230.66,
      "duration_seconds": 4.27,
      "text": "I've, I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.53,
      "end_seconds": 236.91,
      "duration_seconds": 4.38,
      "text": "Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.32,
      "end_seconds": 247.91,
      "duration_seconds": 2.59,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.85,
      "end_seconds": 254.65,
      "duration_seconds": 4.8,
      "text": "um, um, no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.24,
      "end_seconds": 258.24,
      "duration_seconds": 3.0,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.57,
      "end_seconds": 265.77,
      "duration_seconds": 6.2,
      "text": "Sorry, you know, what was I saying, my son has asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.56,
      "end_seconds": 300.61,
      "duration_seconds": 34.05,
      "text": "Okay, so my impression is this: The most likely explanation is transient global amnesia. I'll request a CT scan of the head, it'll help with acute memory loss. I'd like to arrange a blood sugar for confusion. This usually clears in a day with no lasting effect, but we do a scan first to be safe. A short walk every day, even twenty minutes, will help more than you'd think. I'd like to see you again tomorrow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.57,
      "end_seconds": 306.38,
      "duration_seconds": 3.81,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.39,
      "end_seconds": 311.4,
      "duration_seconds": 4.01,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.12,
      "end_seconds": 314.5,
      "duration_seconds": 2.38,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.0,
      "end_seconds": 316.37,
      "duration_seconds": 1.37,
      "text": "Goodbye for now."
    }
  ]
}