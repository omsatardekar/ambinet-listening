{
  "schema_version": "1.0",
  "encounter_id": "03520",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.61,
      "end_seconds": 5.54,
      "duration_seconds": 4.93,
      "text": "Morning, come on through. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.21,
      "end_seconds": 11.33,
      "duration_seconds": 3.12,
      "text": "Well, I've been having no symptoms."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.69,
      "end_seconds": 16.08,
      "duration_seconds": 3.39,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.44,
      "end_seconds": 22.88,
      "duration_seconds": 3.44,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.35,
      "end_seconds": 28.26,
      "duration_seconds": 4.91,
      "text": "Okay, go on. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.98,
      "end_seconds": 39.82,
      "duration_seconds": 10.84,
      "text": "I'd say mild. A low blood count on a routine test was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.61,
      "end_seconds": 45.46,
      "duration_seconds": 3.85,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 55.32,
      "duration_seconds": 6.26,
      "text": "Metoprolol. I take it 50 milligrams, twice a day for my pressure."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.98,
      "end_seconds": 59.21,
      "duration_seconds": 3.23,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.95,
      "end_seconds": 62.73,
      "duration_seconds": 2.78,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.72,
      "end_seconds": 68.87,
      "duration_seconds": 2.15,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.33,
      "end_seconds": 72.7,
      "duration_seconds": 2.37,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.42,
      "end_seconds": 75.63,
      "duration_seconds": 2.21,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.61,
      "end_seconds": 80.56,
      "duration_seconds": 3.95,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.21,
      "end_seconds": 84.5,
      "duration_seconds": 2.29,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.46,
      "end_seconds": 87.62,
      "duration_seconds": 2.16,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.65,
      "end_seconds": 97.83,
      "duration_seconds": 9.18,
      "text": "Okay, I can see high blood pressure in your file as well. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.82,
      "end_seconds": 102.8,
      "duration_seconds": 3.98,
      "text": "Not to my knowledge, um, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.55,
      "end_seconds": 117.15,
      "duration_seconds": 2.6,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.76,
      "end_seconds": 121.66,
      "duration_seconds": 2.9,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.37,
      "end_seconds": 144.67,
      "duration_seconds": 4.3,
      "text": "A few quick ones: blood in the stool or black stools?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.32,
      "end_seconds": 151.57,
      "duration_seconds": 5.25,
      "text": "No blood in the stool or black stools, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.11,
      "end_seconds": 156.27,
      "duration_seconds": 4.16,
      "text": "A few quick ones: heavy periods or weight loss?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.73,
      "end_seconds": 164.19,
      "duration_seconds": 3.46,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.49,
      "end_seconds": 167.71,
      "duration_seconds": 2.22,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.79,
      "end_seconds": 173.58,
      "duration_seconds": 3.79,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.6,
      "end_seconds": 177.58,
      "duration_seconds": 1.98,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.34,
      "end_seconds": 180.84,
      "duration_seconds": 1.5,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 181.45,
      "end_seconds": 189.6,
      "duration_seconds": 8.15,
      "text": "Doctor, I've got the readings for you. Pressure 116 over 68, saturation 98 percent, pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.95,
      "end_seconds": 195.24,
      "duration_seconds": 1.29,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.08,
      "end_seconds": 201.34,
      "duration_seconds": 3.26,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.33,
      "end_seconds": 205.61,
      "duration_seconds": 2.28,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.07,
      "end_seconds": 222.88,
      "duration_seconds": 5.81,
      "text": "Your pulse and blood pressure are normal, and the eyelids are pale."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.86,
      "end_seconds": 231.25,
      "duration_seconds": 2.39,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.67,
      "end_seconds": 250.26,
      "duration_seconds": 7.59,
      "text": "Okay, thinking it through, the most likely explanation is iron-deficiency anaemia needing a source found."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.78,
      "end_seconds": 254.19,
      "duration_seconds": 2.41,
      "text": "so, will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.8,
      "end_seconds": 286.74,
      "duration_seconds": 30.94,
      "text": "It's reasonable to be concerned, but right now iron-deficiency anaemia needing a source found is my leading thought, not anything worse. Let's get a camera test of the stomach and bowel, for iron-deficiency anaemia. The treatment will be ferrous sulfate, 200 milligrams, once a day, three months. You take it by mouth. That should help with iron deficiency. Stop the the ibuprofen and we will refer you for scopes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.71,
      "end_seconds": 305.36,
      "duration_seconds": 17.65,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. We'll refer you to the lower GI team. Let's review you after the tests. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.19,
      "end_seconds": 308.33,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}