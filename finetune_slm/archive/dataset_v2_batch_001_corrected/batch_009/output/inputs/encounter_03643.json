{
  "schema_version": "1.0",
  "encounter_id": "03643",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.46,
      "duration_seconds": 3.41,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.14,
      "end_seconds": 10.73,
      "duration_seconds": 4.59,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.29,
      "end_seconds": 18.53,
      "duration_seconds": 6.24,
      "text": "I'm here because of seen putting a coin-like object in his mouth."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.4,
      "end_seconds": 23.97,
      "duration_seconds": 3.57,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.9,
      "end_seconds": 31.35,
      "duration_seconds": 5.45,
      "text": "One week, I think... sorry, three weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.45,
      "end_seconds": 36.85,
      "duration_seconds": 3.4,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.65,
      "end_seconds": 53.99,
      "duration_seconds": 15.34,
      "text": "About a seven out of ten. And a little drooling as well, since last Tuesday. With little drooling, it feels moderate to me. Oh, you know, and a mild cough."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.41,
      "end_seconds": 60.04,
      "duration_seconds": 2.63,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.0,
      "end_seconds": 63.52,
      "duration_seconds": 1.52,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.43,
      "end_seconds": 85.62,
      "duration_seconds": 4.19,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.49,
      "end_seconds": 87.94,
      "duration_seconds": 1.45,
      "text": "I have gout."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.4,
      "end_seconds": 91.54,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.8,
      "end_seconds": 96.99,
      "duration_seconds": 4.19,
      "text": "I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.67,
      "end_seconds": 102.54,
      "duration_seconds": 4.87,
      "text": "Right, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.08,
      "end_seconds": 105.6,
      "duration_seconds": 2.52,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.89,
      "end_seconds": 115.88,
      "duration_seconds": 1.99,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.07,
      "end_seconds": 121.41,
      "duration_seconds": 4.34,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.03,
      "end_seconds": 124.61,
      "duration_seconds": 2.58,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.18,
      "end_seconds": 130.17,
      "duration_seconds": 3.99,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.15,
      "end_seconds": 150.42,
      "duration_seconds": 2.27,
      "text": "Any breathing difficulty or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.36,
      "end_seconds": 155.64,
      "duration_seconds": 4.28,
      "text": "I haven't had breathing difficulty or fever, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.2,
      "end_seconds": 160.23,
      "duration_seconds": 3.03,
      "text": "Have you noticed rash or vomiting blood?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.31,
      "end_seconds": 166.53,
      "duration_seconds": 4.22,
      "text": "No rash or vomiting blood, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.07,
      "end_seconds": 171.6,
      "duration_seconds": 3.53,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.35,
      "end_seconds": 176.62,
      "duration_seconds": 4.27,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.8,
      "end_seconds": 180.75,
      "duration_seconds": 2.95,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.45,
      "end_seconds": 184.12,
      "duration_seconds": 1.67,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.21,
      "end_seconds": 187.41,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.84,
      "end_seconds": 199.81,
      "duration_seconds": 2.97,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.33,
      "end_seconds": 217.04,
      "duration_seconds": 3.71,
      "text": "Okay: BP is 109 over 78, heart rate 83."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.99,
      "end_seconds": 221.1,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.06,
      "end_seconds": 223.27,
      "duration_seconds": 1.21,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.13,
      "end_seconds": 245.14,
      "duration_seconds": 4.01,
      "text": "He is playful, breathing normally and the throat looks normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.33,
      "end_seconds": 269.39,
      "duration_seconds": 21.06,
      "text": "You can sit up now. Right, here's what I'm thinking. It points towards a possible swallowed button battery needing an urgent X-ray despite few symptoms. Just to be sure I understood. You've had seen putting a coin-like object in his mouth for three weeks, and no vomiting blood or breathing difficulty."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.34,
      "end_seconds": 272.33,
      "duration_seconds": 1.99,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.98,
      "end_seconds": 279.07,
      "duration_seconds": 6.09,
      "text": "I'd like to arrange an urgent chest and abdominal X-ray for possible battery ingestion."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.76,
      "end_seconds": 282.75,
      "duration_seconds": 2.99,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.56,
      "end_seconds": 292.96,
      "duration_seconds": 8.4,
      "text": "A button battery can burn the gullet within hours even when a child looks well, so we scan now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.41,
      "end_seconds": 300.96,
      "duration_seconds": 7.55,
      "text": "Mm, okay. I'll want another look straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.09,
      "end_seconds": 308.41,
      "duration_seconds": 2.32,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.44,
      "end_seconds": 310.79,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}