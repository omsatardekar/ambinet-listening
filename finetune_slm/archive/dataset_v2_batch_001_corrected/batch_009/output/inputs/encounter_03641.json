{
  "schema_version": "1.0",
  "encounter_id": "03641",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 5.43,
      "duration_seconds": 4.85,
      "text": "So, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.72,
      "end_seconds": 10.72,
      "duration_seconds": 4.0,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.33,
      "end_seconds": 18.45,
      "duration_seconds": 6.12,
      "text": "Sorry, what was I saying, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.97,
      "end_seconds": 23.1,
      "duration_seconds": 4.13,
      "text": "I've, I've been dealing with a sore throat."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.98,
      "end_seconds": 27.27,
      "duration_seconds": 3.29,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.33,
      "end_seconds": 32.08,
      "duration_seconds": 2.75,
      "text": "About... well, about a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.02,
      "end_seconds": 36.77,
      "duration_seconds": 2.75,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.59,
      "end_seconds": 48.82,
      "duration_seconds": 10.23,
      "text": "Sorry, what was I saying, it feels moderate to me. Right, I've also had mouth ulcers, for about four days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.46,
      "end_seconds": 53.92,
      "duration_seconds": 4.46,
      "text": "So, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.03,
      "end_seconds": 56.16,
      "duration_seconds": 1.13,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.59,
      "end_seconds": 57.29,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.72,
      "end_seconds": 69.75,
      "duration_seconds": 11.03,
      "text": "Okay, so I did have a faint rash on the chest at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.15,
      "end_seconds": 78.47,
      "duration_seconds": 7.32,
      "text": "So, what about your medical history? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.6,
      "end_seconds": 82.63,
      "duration_seconds": 3.03,
      "text": "Epilepsy, for nearly five years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.52,
      "end_seconds": 86.43,
      "duration_seconds": 2.91,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.4,
      "end_seconds": 104.32,
      "duration_seconds": 16.92,
      "text": "Thin bones, for about a year. I've been reading about it online and it worried me. I've never really been one for hospitals. I've, I've got heart disease."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.28,
      "end_seconds": 114.79,
      "duration_seconds": 8.51,
      "text": "Alright, epilepsy and thin bones, that matches what I have here. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.79,
      "end_seconds": 119.4,
      "duration_seconds": 3.61,
      "text": "Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.92,
      "end_seconds": 135.4,
      "duration_seconds": 3.48,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.08,
      "end_seconds": 148.41,
      "duration_seconds": 11.33,
      "text": "Hmm, I take lamotrigine, 100 milligrams, twice a day. I'm, I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 154.92,
      "duration_seconds": 3.09,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.44,
      "end_seconds": 163.17,
      "duration_seconds": 6.73,
      "text": "About a year now. Before this I was on levetiracetam; that's been stopped."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 169.0,
      "duration_seconds": 4.88,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.71,
      "end_seconds": 185.5,
      "duration_seconds": 15.79,
      "text": "I smoke roughly a pack every two days. My partner and our baby. Yes, I work in a bakery, early starts. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.46,
      "end_seconds": 190.22,
      "duration_seconds": 2.76,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.52,
      "end_seconds": 212.45,
      "duration_seconds": 20.93,
      "text": "I mean, um, I had a triple bypass eight years ago. I did try to ignore it for a while. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.32,
      "end_seconds": 225.73,
      "duration_seconds": 2.41,
      "text": "What about recent tick bite?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.72,
      "end_seconds": 229.52,
      "duration_seconds": 2.8,
      "text": "Definitely no recent tick bite."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.68,
      "end_seconds": 236.22,
      "duration_seconds": 5.54,
      "text": "Let me check a few things. Any stiff neck, diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.5,
      "end_seconds": 241.47,
      "duration_seconds": 3.97,
      "text": "Let me think, nope, nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.8,
      "end_seconds": 244.96,
      "duration_seconds": 2.16,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.16,
      "end_seconds": 247.79,
      "duration_seconds": 1.63,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.08,
      "end_seconds": 251.45,
      "duration_seconds": 2.37,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.66,
      "end_seconds": 257.82,
      "duration_seconds": 1.16,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.82,
      "end_seconds": 261.56,
      "duration_seconds": 2.74,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.53,
      "end_seconds": 273.72,
      "duration_seconds": 2.19,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.0,
      "end_seconds": 294.54,
      "duration_seconds": 8.54,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 22. And blood pressure 122 over 79, pulse 108, temperature 38.9."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.83,
      "end_seconds": 300.06,
      "duration_seconds": 3.23,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.87,
      "end_seconds": 303.8,
      "duration_seconds": 2.93,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.05,
      "end_seconds": 322.82,
      "duration_seconds": 7.77,
      "text": "There are small mouth ulcers, tender neck glands and a faint pink rash on the chest."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.55,
      "end_seconds": 326.13,
      "duration_seconds": 1.58,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.44,
      "end_seconds": 330.09,
      "duration_seconds": 1.65,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.36,
      "end_seconds": 374.34,
      "duration_seconds": 32.98,
      "text": "Okay, so my impression is this: My working impression is an acute viral illness, possibly early HIV infection. The reason I say that is that your story and my examination fit together. Let's get a fourth-generation HIV test, for acute viral illness with rash. I'm going to order a glandular fever test, for sore throat and glands. I'm offering an HIV test with every illness like this, it's routine, and results are confidential."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.65,
      "end_seconds": 382.93,
      "duration_seconds": 8.28,
      "text": "Right, right. I'll want another look after the results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.73,
      "end_seconds": 389.71,
      "duration_seconds": 4.98,
      "text": "Good, you know, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.73,
      "end_seconds": 393.02,
      "duration_seconds": 1.29,
      "text": "Goodbye for now."
    }
  ]
}