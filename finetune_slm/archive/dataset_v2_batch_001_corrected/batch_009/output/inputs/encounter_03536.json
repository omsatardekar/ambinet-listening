{
  "schema_version": "1.0",
  "encounter_id": "03536",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 6.47,
      "duration_seconds": 5.27,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.14,
      "end_seconds": 11.32,
      "duration_seconds": 3.18,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.87,
      "end_seconds": 14.64,
      "duration_seconds": 2.77,
      "text": "so what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.98,
      "end_seconds": 26.59,
      "duration_seconds": 10.61,
      "text": "mainly I've been feeling muddled and unsteady. That's why I came. I kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.33,
      "end_seconds": 32.28,
      "duration_seconds": 3.95,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.06,
      "end_seconds": 37.44,
      "duration_seconds": 3.38,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.68,
      "end_seconds": 42.14,
      "duration_seconds": 4.46,
      "text": "Sure. What about a headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.55,
      "end_seconds": 46.97,
      "duration_seconds": 3.42,
      "text": "yeah, I've had that since this morning"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 51.18,
      "duration_seconds": 2.91,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.55,
      "end_seconds": 54.85,
      "duration_seconds": 2.3,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.16,
      "end_seconds": 77.94,
      "duration_seconds": 6.78,
      "text": "let me check a few things. Any fall, weakness on one side or seizure?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.13,
      "end_seconds": 85.64,
      "duration_seconds": 6.51,
      "text": "Well, no fall, weakness on one side or seizure, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.06,
      "end_seconds": 88.25,
      "duration_seconds": 1.19,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.98,
      "end_seconds": 91.34,
      "duration_seconds": 1.36,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.87,
      "end_seconds": 95.21,
      "duration_seconds": 2.34,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.13,
      "end_seconds": 98.72,
      "duration_seconds": 1.59,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 108.16,
      "duration_seconds": 3.98,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.19,
      "end_seconds": 110.69,
      "duration_seconds": 1.5,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.69,
      "end_seconds": 129.74,
      "duration_seconds": 3.05,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.39,
      "end_seconds": 141.84,
      "duration_seconds": 10.45,
      "text": "No, I share a house with my brother. I work in accounts at a hospital. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.65,
      "end_seconds": 163.93,
      "duration_seconds": 3.28,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.96,
      "end_seconds": 170.14,
      "duration_seconds": 4.18,
      "text": "Oh, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.48,
      "end_seconds": 174.75,
      "duration_seconds": 3.27,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.97,
      "end_seconds": 178.53,
      "duration_seconds": 2.56,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.08,
      "end_seconds": 183.55,
      "duration_seconds": 4.47,
      "text": "Let me get the readings out of the the way."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.04,
      "end_seconds": 199.76,
      "duration_seconds": 2.72,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.39,
      "end_seconds": 222.16,
      "duration_seconds": 7.77,
      "text": "Okay: temperature 36.6, BP is 120 over 82, saturation 97 percent, pulse is 64 beats a minute."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.88,
      "end_seconds": 228.66,
      "duration_seconds": 4.78,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.77,
      "end_seconds": 231.09,
      "duration_seconds": 1.32,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.54,
      "end_seconds": 255.08,
      "duration_seconds": 7.54,
      "text": "You are a bit slow and unsteady, but there is no weakness and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.55,
      "end_seconds": 269.47,
      "duration_seconds": 0.92,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.96,
      "end_seconds": 290.23,
      "duration_seconds": 15.27,
      "text": "Okay, that's enough for me. So, based on the history and the examination, I think we're dealing with a low salt level, possibly from the new antidepressant at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.5,
      "end_seconds": 293.66,
      "duration_seconds": 2.16,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.61,
      "end_seconds": 310.0,
      "duration_seconds": 15.39,
      "text": "Nothing I've seen today points to an emergency. It looks like a low salt level, possibly from the new antidepressant. We will stop the new tablet and not drink excess water until we have the result."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.54,
      "end_seconds": 313.96,
      "duration_seconds": 3.42,
      "text": "Right, right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.58,
      "end_seconds": 318.6,
      "duration_seconds": 3.02,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}