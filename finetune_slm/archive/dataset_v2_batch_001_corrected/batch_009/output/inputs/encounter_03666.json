{
  "schema_version": "1.0",
  "encounter_id": "03666",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.82,
      "end_seconds": 7.52,
      "duration_seconds": 6.7,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.21,
      "end_seconds": 14.06,
      "duration_seconds": 4.85,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.7,
      "end_seconds": 26.15,
      "duration_seconds": 10.45,
      "text": "Well, I've been having a dry cough. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 27.28,
      "end_seconds": 36.82,
      "duration_seconds": 9.54,
      "text": "Okay, so the vitals from earlier. Oxygen saturation is 97 percent, respiratory rate 18, BP is 120 over 77. Pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.81,
      "end_seconds": 40.61,
      "duration_seconds": 1.8,
      "text": "Thanks. Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.26,
      "end_seconds": 48.07,
      "duration_seconds": 5.81,
      "text": "Erm, you know, it's been going on for two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.96,
      "end_seconds": 51.77,
      "duration_seconds": 2.81,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.05,
      "end_seconds": 56.52,
      "duration_seconds": 3.47,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.26,
      "end_seconds": 64.36,
      "duration_seconds": 7.1,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 64.46,
      "end_seconds": 71.0,
      "duration_seconds": 6.54,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.73,
      "end_seconds": 76.01,
      "duration_seconds": 4.28,
      "text": "Later, thanks. Please go on. Any tiredness as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.04,
      "end_seconds": 79.17,
      "duration_seconds": 1.13,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.18,
      "end_seconds": 96.52,
      "duration_seconds": 5.34,
      "text": "Let me check a few things. Any coughing up blood or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.16,
      "end_seconds": 110.27,
      "duration_seconds": 12.11,
      "text": "No, no coughing up blood, no weight loss. I did have sore ankles at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.16,
      "end_seconds": 114.67,
      "duration_seconds": 2.51,
      "text": "Okay, any fever or night sweats?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.26,
      "end_seconds": 120.49,
      "duration_seconds": 4.23,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.71,
      "end_seconds": 124.4,
      "duration_seconds": 2.69,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.23,
      "end_seconds": 127.98,
      "duration_seconds": 1.75,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.85,
      "end_seconds": 133.72,
      "duration_seconds": 3.87,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.61,
      "end_seconds": 139.52,
      "duration_seconds": 3.91,
      "text": "No, you know, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.51,
      "end_seconds": 142.73,
      "duration_seconds": 2.22,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.56,
      "end_seconds": 147.6,
      "duration_seconds": 4.04,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.16,
      "end_seconds": 152.28,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.84,
      "end_seconds": 173.45,
      "duration_seconds": 19.61,
      "text": "Um, you know, I've had high blood pressure for about a year now. An underactive thyroid, for two years. I've had heart disease, yes. I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.36,
      "end_seconds": 183.76,
      "duration_seconds": 9.4,
      "text": "Ah. Alright, arthritis in your knees, that matches what I have here. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.71,
      "end_seconds": 191.46,
      "duration_seconds": 6.75,
      "text": "Ramipril. I take it 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.53,
      "end_seconds": 201.61,
      "duration_seconds": 9.08,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.27,
      "end_seconds": 205.86,
      "duration_seconds": 2.59,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.49,
      "end_seconds": 227.0,
      "duration_seconds": 20.51,
      "text": "For my thyroid, I believe. My husband sets them out for me, I just take what I'm given. Aspirin. I take it 75 milligrams, once a day. I'm on naproxen, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.13,
      "end_seconds": 230.22,
      "duration_seconds": 2.09,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.01,
      "end_seconds": 237.58,
      "duration_seconds": 6.57,
      "text": "It's 250 milligrams. Erm, I used to take lisinopril, but I stopped it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.34,
      "end_seconds": 258.19,
      "duration_seconds": 2.85,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.71,
      "end_seconds": 263.39,
      "duration_seconds": 4.68,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.69,
      "end_seconds": 267.88,
      "duration_seconds": 3.19,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 273.4,
      "end_seconds": 275.38,
      "duration_seconds": 1.98,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.98,
      "end_seconds": 281.91,
      "duration_seconds": 3.93,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.31,
      "end_seconds": 285.04,
      "duration_seconds": 1.73,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.84,
      "end_seconds": 289.61,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.02,
      "end_seconds": 314.38,
      "duration_seconds": 6.36,
      "text": "There are tender raised red nodules on both shins and your ankles are puffy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.65,
      "end_seconds": 342.06,
      "duration_seconds": 22.41,
      "text": "So, good, you can sit up again. Okay, thinking it through, the most likely explanation is possible sarcoidosis. I want to be honest that this is an impression, not a final answer. Tuberculosis is also on my list. A viral illness is also on my list. I want blood tests done, that's for possible sarcoidosis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 343.7,
      "end_seconds": 347.12,
      "duration_seconds": 3.42,
      "text": "I can book that for Monday at 9 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.97,
      "end_seconds": 363.33,
      "duration_seconds": 14.36,
      "text": "We should do a chest X-ray for cough and erythema nodosum. Rest and elevate the legs, and I'm arranging a chest clinic review. Let's get you seen by the respiratory clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 364.18,
      "end_seconds": 367.38,
      "duration_seconds": 3.2,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.7,
      "end_seconds": 375.42,
      "duration_seconds": 6.72,
      "text": "Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 375.93,
      "end_seconds": 378.53,
      "duration_seconds": 2.6,
      "text": "Okay, um, makes sense."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.91,
      "end_seconds": 385.37,
      "duration_seconds": 5.46,
      "text": "Let's plan a check after the tests. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 386.93,
      "end_seconds": 389.12,
      "duration_seconds": 2.19,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.03,
      "end_seconds": 392.33,
      "duration_seconds": 1.3,
      "text": "Look after yourself."
    }
  ]
}