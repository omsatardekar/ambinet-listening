{
  "schema_version": "1.0",
  "encounter_id": "03651",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 3.26,
      "duration_seconds": 2.56,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.68,
      "end_seconds": 5.79,
      "duration_seconds": 1.11,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.63,
      "end_seconds": 13.57,
      "duration_seconds": 1.94,
      "text": "Cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 19.0,
      "duration_seconds": 3.98,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.95,
      "end_seconds": 24.04,
      "duration_seconds": 3.09,
      "text": "Alright, what do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.43,
      "end_seconds": 28.71,
      "duration_seconds": 3.28,
      "text": "I've been dealing with being very thirsty."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.82,
      "end_seconds": 34.36,
      "duration_seconds": 4.54,
      "text": "Alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.45,
      "end_seconds": 38.17,
      "duration_seconds": 2.72,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.93,
      "end_seconds": 42.85,
      "duration_seconds": 2.92,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.11,
      "end_seconds": 49.12,
      "duration_seconds": 5.01,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 51.15,
      "end_seconds": 64.52,
      "duration_seconds": 13.37,
      "text": "Here are the numbers, doctor. Pulse is 113 beats a minute, respiratory rate 16. BMI works out to 16.6, temperature is 36.9 degrees, weight 52 kilos, pressure 115 over 80, height 177 centimetres."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.44,
      "end_seconds": 66.4,
      "duration_seconds": 0.96,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.7,
      "end_seconds": 71.48,
      "duration_seconds": 3.78,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.8,
      "end_seconds": 80.42,
      "duration_seconds": 1.62,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.09,
      "end_seconds": 84.32,
      "duration_seconds": 2.23,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.66,
      "end_seconds": 103.02,
      "duration_seconds": 5.36,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.63,
      "end_seconds": 113.16,
      "duration_seconds": 6.53,
      "text": "That's all I needed to check. Have you had any cough, fever or diarrhoea?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.91,
      "end_seconds": 120.09,
      "duration_seconds": 5.18,
      "text": "I, I haven't had cough, fever or diarrhoea, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.73,
      "end_seconds": 123.92,
      "duration_seconds": 2.19,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.7,
      "end_seconds": 128.83,
      "duration_seconds": 3.13,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.18,
      "end_seconds": 132.26,
      "duration_seconds": 2.08,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.74,
      "end_seconds": 135.4,
      "duration_seconds": 1.66,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.05,
      "end_seconds": 141.46,
      "duration_seconds": 4.41,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.51,
      "end_seconds": 149.02,
      "duration_seconds": 5.51,
      "text": "Metformin. I take it 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.72,
      "end_seconds": 153.72,
      "duration_seconds": 4.0,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.85,
      "end_seconds": 158.09,
      "duration_seconds": 3.24,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.4,
      "end_seconds": 174.04,
      "duration_seconds": 2.64,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.7,
      "end_seconds": 179.12,
      "duration_seconds": 3.42,
      "text": "Not to my knowledge, you know, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.93,
      "end_seconds": 191.26,
      "duration_seconds": 1.33,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.17,
      "end_seconds": 195.77,
      "duration_seconds": 3.6,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.08,
      "end_seconds": 198.49,
      "duration_seconds": 1.41,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.23,
      "end_seconds": 204.83,
      "duration_seconds": 5.6,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.04,
      "end_seconds": 208.03,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.62,
      "end_seconds": 214.04,
      "duration_seconds": 4.42,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 216.86,
      "duration_seconds": 1.4,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.44,
      "end_seconds": 224.59,
      "duration_seconds": 3.15,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.3,
      "end_seconds": 234.72,
      "duration_seconds": 8.42,
      "text": "Having listened and examined, the most likely explanation is possible new type 1 diabetes starting to turn acidic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.9,
      "end_seconds": 243.44,
      "duration_seconds": 3.54,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.41,
      "end_seconds": 267.73,
      "duration_seconds": 22.32,
      "text": "I understand the worry. At the moment I'd say it's possible new type 1 diabetes starting to turn acidic, and we'll know more once the a finger-prick glucose and ketones is back. So, to recap quickly. You've had being very thirsty, since yesterday, and no fever or cough."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.2,
      "end_seconds": 270.97,
      "duration_seconds": 1.77,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 287.37,
      "end_seconds": 291.89,
      "duration_seconds": 4.52,
      "text": "We've already done a finger-prick glucose and ketones this morning, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.43,
      "end_seconds": 305.65,
      "duration_seconds": 10.22,
      "text": "Great, that's useful. This is not flu, your sugar is very high, and you need hospital insulin today. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.18,
      "end_seconds": 310.28,
      "duration_seconds": 3.1,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.44,
      "end_seconds": 314.21,
      "duration_seconds": 2.77,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.67,
      "end_seconds": 318.59,
      "duration_seconds": 2.92,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.72,
      "end_seconds": 321.66,
      "duration_seconds": 1.94,
      "text": "Have a good day."
    }
  ]
}