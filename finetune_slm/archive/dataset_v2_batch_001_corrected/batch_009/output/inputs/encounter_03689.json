  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 4.08,
      "duration_seconds": 3.16,
      "text": "hello, doctor may I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.69,
      "end_seconds": 10.62,
      "duration_seconds": 4.93,
      "text": "of course, leave it it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.76,
      "end_seconds": 21.9,
      "duration_seconds": 10.14,
      "text": "Yeah, it's fainting once. I don't know what's causing it. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.97,
      "end_seconds": 26.87,
      "duration_seconds": 3.9,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.52,
      "end_seconds": 38.85,
      "duration_seconds": 10.33,
      "text": "I'd say two weeks. Actually, no, closer to four weeks. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.16,
      "end_seconds": 49.15,
      "duration_seconds": 1.99,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.06,
      "end_seconds": 58.59,
      "duration_seconds": 2.53,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.41,
      "end_seconds": 89.94,
      "duration_seconds": 11.53,
      "text": "Okay: pulse is 125 beats a minute, SpO2 96 percent on room air, BP is 135 over 70. And temperature is 36.8 degrees, respiratory rate 19."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.13,
      "end_seconds": 94.18,
      "duration_seconds": 2.05,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.15,
      "end_seconds": 98.73,
      "duration_seconds": 2.58,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.36,
      "end_seconds": 123.03,
      "duration_seconds": 8.67,
      "text": "Your oxygen is lower than expected for someone so young and the left calf is a little swollen."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.49,
      "end_seconds": 125.64,
      "duration_seconds": 1.15,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.23,
      "end_seconds": 132.13,
      "duration_seconds": 2.9,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.49,
      "end_seconds": 152.92,
      "duration_seconds": 2.43,
      "text": "did you notice any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.47,
      "end_seconds": 156.37,
      "duration_seconds": 2.9,
      "text": "not at all, no fever"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.48,
      "end_seconds": 161.86,
      "duration_seconds": 4.38,
      "text": "any chest pain or coughing up blood at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.71,
      "end_seconds": 165.47,
      "duration_seconds": 2.76,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.3,
      "end_seconds": 169.64,
      "duration_seconds": 3.34,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.19,
      "end_seconds": 171.8,
      "duration_seconds": 1.61,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.33,
      "end_seconds": 176.63,
      "duration_seconds": 3.3,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.31,
      "end_seconds": 179.57,
      "duration_seconds": 2.26,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.53,
      "end_seconds": 185.54,
      "duration_seconds": 4.01,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.45,
      "end_seconds": 193.09,
      "duration_seconds": 3.64,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.67,
      "end_seconds": 196.47,
      "duration_seconds": 2.8,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.39,
      "end_seconds": 201.52,
      "duration_seconds": 3.13,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.14,
      "end_seconds": 205.0,
      "duration_seconds": 1.86,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.69,
      "end_seconds": 209.54,
      "duration_seconds": 3.85,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.91,
      "end_seconds": 213.65,
      "duration_seconds": 2.74,
      "text": "So, do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.34,
      "end_seconds": 218.41,
      "duration_seconds": 4.07,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.41,
      "end_seconds": 228.52,
      "duration_seconds": 2.11,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.34,
      "end_seconds": 238.25,
      "duration_seconds": 7.91,
      "text": "Diclofenac, 50 milligrams, when needed for the joint pain i'm on the contraceptive pill, daily"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 243.87,
      "duration_seconds": 4.54,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.48,
      "end_seconds": 248.31,
      "duration_seconds": 2.83,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.11,
      "end_seconds": 259.37,
      "duration_seconds": 6.26,
      "text": "So where does that leave us? I'd lean towards possible pulmonary embolism without chest pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.68,
      "end_seconds": 263.74,
      "duration_seconds": 3.06,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.75,
      "end_seconds": 276.06,
      "duration_seconds": 10.31,
      "text": "It's reasonable to be concerned, but right now possible pulmonary embolism without chest pain is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.6,
      "end_seconds": 294.78,
      "duration_seconds": 10.18,
      "text": "I'm sending you for a D-dimer because of syncope and calf swelling. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.23,
      "end_seconds": 300.56,
      "duration_seconds": 2.33,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 316.74,
      "duration_seconds": 11.58,
      "text": "Even without chest pain this needs a scan today, so please go to hospital. Come back straight away. Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.5,
      "end_seconds": 320.63,
      "duration_seconds": 3.13,
      "text": "I think I understand everything. Thanks."
    }
  ]
}