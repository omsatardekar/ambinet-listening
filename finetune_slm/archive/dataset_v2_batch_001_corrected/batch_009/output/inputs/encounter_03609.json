{
  "schema_version": "1.0",
  "encounter_id": "03609",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 5.54,
      "duration_seconds": 4.5,
      "text": "Hello, uh, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.93,
      "end_seconds": 11.51,
      "duration_seconds": 4.58,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.28,
      "end_seconds": 22.72,
      "duration_seconds": 7.44,
      "text": "I've been feeling like I have flu, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.12,
      "end_seconds": 26.56,
      "duration_seconds": 2.44,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.55,
      "end_seconds": 32.23,
      "duration_seconds": 3.68,
      "text": "So, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.92,
      "end_seconds": 46.9,
      "duration_seconds": 3.98,
      "text": "So, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.1,
      "end_seconds": 52.11,
      "duration_seconds": 4.01,
      "text": "It's been going on for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.14,
      "end_seconds": 57.42,
      "duration_seconds": 3.28,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.91,
      "end_seconds": 65.9,
      "duration_seconds": 3.99,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.33,
      "end_seconds": 68.68,
      "duration_seconds": 2.35,
      "text": "Understood. Any nausea as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.62,
      "end_seconds": 72.2,
      "duration_seconds": 1.58,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.13,
      "end_seconds": 94.69,
      "duration_seconds": 4.56,
      "text": "Let me check a few things. Any sore throat or diarrhoea?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.7,
      "end_seconds": 99.35,
      "duration_seconds": 3.65,
      "text": "Yeah, no, no sore throat or diarrhoea."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.05,
      "end_seconds": 104.49,
      "duration_seconds": 4.44,
      "text": "Let me check a few things. Any fever or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.82,
      "end_seconds": 109.49,
      "duration_seconds": 3.67,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.69,
      "end_seconds": 113.88,
      "duration_seconds": 3.19,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.54,
      "end_seconds": 117.44,
      "duration_seconds": 2.9,
      "text": "No, um, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.87,
      "end_seconds": 124.78,
      "duration_seconds": 5.91,
      "text": "Alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.86,
      "end_seconds": 133.75,
      "duration_seconds": 2.89,
      "text": "So, no weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.43,
      "end_seconds": 139.83,
      "duration_seconds": 4.4,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.95,
      "end_seconds": 144.84,
      "duration_seconds": 3.89,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 164.4,
      "duration_seconds": 3.49,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.93,
      "end_seconds": 170.85,
      "duration_seconds": 2.92,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.24,
      "end_seconds": 176.95,
      "duration_seconds": 4.71,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.93,
      "end_seconds": 187.15,
      "duration_seconds": 9.22,
      "text": "I walk the dog every morning. I'm a hairdresser, on my feet all day. My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.12,
      "end_seconds": 191.03,
      "duration_seconds": 2.91,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.08,
      "end_seconds": 201.83,
      "duration_seconds": 2.75,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.46,
      "end_seconds": 225.34,
      "duration_seconds": 12.88,
      "text": "Okay: height 168 centimetres, respiratory rate 19, SpO2 99 percent on room air, BMI works out to 23.4, BP is 137 over 87, pulse 116, weight 66 kilos."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.68,
      "end_seconds": 231.24,
      "duration_seconds": 3.56,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.98,
      "end_seconds": 235.47,
      "duration_seconds": 2.49,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.96,
      "end_seconds": 250.82,
      "duration_seconds": 5.86,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.84,
      "end_seconds": 275.74,
      "duration_seconds": 19.9,
      "text": "Good, you can sit up again. Let me tell you where I've got to. I'd lean towards possible new type 1 diabetes starting to turn acidic. So, to recap quickly. You've been feeling like you have flu for about three months, and no sore throat or diarrhoea."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.76,
      "end_seconds": 280.43,
      "duration_seconds": 2.67,
      "text": "Mm, you know, that's right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.51,
      "end_seconds": 312.67,
      "duration_seconds": 22.16,
      "text": "I want a finger-prick glucose and ketones done, that's for thirst and weight loss. This is not flu, your sugar is very high, and you need hospital insulin today. I'd like you to see the diabetes team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.26,
      "end_seconds": 316.71,
      "duration_seconds": 2.45,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.69,
      "end_seconds": 332.45,
      "duration_seconds": 14.76,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. Let's plan a check straight away. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.78,
      "end_seconds": 335.94,
      "duration_seconds": 2.16,
      "text": "Alright, thanks, take care."
    }
  ]
}