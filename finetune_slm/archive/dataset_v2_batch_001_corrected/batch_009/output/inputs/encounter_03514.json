{
  "schema_version": "1.0",
  "encounter_id": "03514",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 6.11,
      "duration_seconds": 4.86,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.9,
      "end_seconds": 12.38,
      "duration_seconds": 4.48,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.34,
      "end_seconds": 19.34,
      "duration_seconds": 6.0,
      "text": "Oh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 25.57,
      "duration_seconds": 4.4,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.61,
      "end_seconds": 35.72,
      "duration_seconds": 9.11,
      "text": "It's, It's a painful ulcer that is growing quickly, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.64,
      "end_seconds": 40.93,
      "duration_seconds": 3.29,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.52,
      "end_seconds": 43.96,
      "duration_seconds": 2.44,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.5,
      "end_seconds": 46.76,
      "duration_seconds": 2.26,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.38,
      "end_seconds": 49.81,
      "duration_seconds": 2.43,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.26,
      "end_seconds": 57.96,
      "duration_seconds": 4.7,
      "text": "What about belly cramps and loose stools, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.4,
      "end_seconds": 63.7,
      "duration_seconds": 4.3,
      "text": "Yes, uh, about the same, two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.76,
      "end_seconds": 67.71,
      "duration_seconds": 1.95,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.32,
      "end_seconds": 70.63,
      "duration_seconds": 2.31,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.67,
      "end_seconds": 91.02,
      "duration_seconds": 2.35,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.28,
      "end_seconds": 96.62,
      "duration_seconds": 4.34,
      "text": "I have thin bones, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.23,
      "end_seconds": 98.3,
      "duration_seconds": 1.07,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.96,
      "end_seconds": 102.87,
      "duration_seconds": 3.91,
      "text": "I have diabetes. I have heart disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.96,
      "end_seconds": 114.26,
      "duration_seconds": 9.3,
      "text": "Yes, thin bones is known to us, good to have that clear. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.22,
      "end_seconds": 120.04,
      "duration_seconds": 3.82,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.13,
      "end_seconds": 125.06,
      "duration_seconds": 2.93,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.4,
      "end_seconds": 129.82,
      "duration_seconds": 3.42,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 151.68,
      "duration_seconds": 2.96,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.94,
      "end_seconds": 155.98,
      "duration_seconds": 3.04,
      "text": "Mm, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.73,
      "end_seconds": 159.16,
      "duration_seconds": 2.43,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.08,
      "end_seconds": 163.92,
      "duration_seconds": 2.84,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.69,
      "end_seconds": 167.01,
      "duration_seconds": 1.32,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.4,
      "end_seconds": 172.42,
      "duration_seconds": 4.02,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.76,
      "end_seconds": 180.19,
      "duration_seconds": 6.43,
      "text": "Which medicines do you take at the moment? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 181.1,
      "end_seconds": 187.14,
      "duration_seconds": 6.04,
      "text": "She is on alendronate, once a week, I give it to her."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.74,
      "end_seconds": 190.16,
      "duration_seconds": 2.42,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 191.46,
      "end_seconds": 207.56,
      "duration_seconds": 16.1,
      "text": "It's 70 milligrams. It's, It's Glycomet, 500 milligrams, twice a day for my sugar, doctor. It's metoprolol, 50 milligrams, twice a day for my heart, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.13,
      "end_seconds": 222.03,
      "duration_seconds": 3.9,
      "text": "Did you get recent injury, recent cut or fever?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.03,
      "end_seconds": 226.9,
      "duration_seconds": 2.87,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 234.89,
      "duration_seconds": 2.52,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.58,
      "end_seconds": 241.3,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.58,
      "end_seconds": 246.58,
      "duration_seconds": 4.0,
      "text": "Right, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.39,
      "end_seconds": 252.08,
      "duration_seconds": 1.69,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.9,
      "end_seconds": 257.12,
      "duration_seconds": 4.22,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.93,
      "end_seconds": 270.15,
      "duration_seconds": 2.22,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.47,
      "end_seconds": 292.55,
      "duration_seconds": 10.08,
      "text": "Okay: saturation 99 percent, weight 88 kilos, height 176 centimetres, BP is 112 over 72, temperature is 36.9 degrees, pulse 76."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.16,
      "end_seconds": 295.82,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.47,
      "end_seconds": 300.43,
      "duration_seconds": 2.96,
      "text": "Right, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.03,
      "end_seconds": 305.18,
      "duration_seconds": 3.15,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.07,
      "end_seconds": 309.6,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.62,
      "end_seconds": 322.82,
      "duration_seconds": 6.2,
      "text": "The ulcer has a ragged purple edge with a boggy base and undermined borders."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.45,
      "end_seconds": 342.39,
      "duration_seconds": 13.94,
      "text": "All finished, thank you. Putting it all together, my working impression is possible pyoderma gangrenosum linked to bowel inflammation. We should do a stool test for bowel symptoms. Let's get blood tests, for ulcer."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.33,
      "end_seconds": 347.16,
      "duration_seconds": 2.83,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.22,
      "end_seconds": 362.1,
      "duration_seconds": 12.88,
      "text": "Do not cut or scrub it, that can make it worse. I think the dermatology clinic should see you too. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.61,
      "end_seconds": 367.47,
      "duration_seconds": 1.86,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.57,
      "end_seconds": 371.96,
      "duration_seconds": 3.39,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.74,
      "end_seconds": 377.05,
      "duration_seconds": 3.31,
      "text": "Yeah, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.77,
      "end_seconds": 379.03,
      "duration_seconds": 1.26,
      "text": "Look after yourself."
    }
  ]
}