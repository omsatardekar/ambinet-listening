{
  "schema_version": "1.0",
  "encounter_id": "03535",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 7.73,
      "duration_seconds": 6.74,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.47,
      "end_seconds": 14.63,
      "duration_seconds": 5.16,
      "text": "Okay, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.42,
      "end_seconds": 23.05,
      "duration_seconds": 7.63,
      "text": "Uh, I've been dealing with a sore spot on the front of my shin."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.55,
      "end_seconds": 28.47,
      "duration_seconds": 3.92,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.31,
      "end_seconds": 40.23,
      "duration_seconds": 10.92,
      "text": "I'm not sure when it began, you know, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.86,
      "end_seconds": 45.46,
      "duration_seconds": 3.6,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.38,
      "end_seconds": 50.9,
      "duration_seconds": 4.52,
      "text": "Well, a seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.83,
      "end_seconds": 55.21,
      "duration_seconds": 2.38,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.16,
      "end_seconds": 73.57,
      "duration_seconds": 16.41,
      "text": "It settles a little with rest. Oh, uh, and being told it was shin splints. Oh, and pain at night. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.92,
      "end_seconds": 77.74,
      "duration_seconds": 2.82,
      "text": "Right, how frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.3,
      "end_seconds": 81.76,
      "duration_seconds": 2.46,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.33,
      "end_seconds": 86.8,
      "duration_seconds": 3.47,
      "text": "Alright, have you noticed swelling, numbness or injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.61,
      "end_seconds": 93.35,
      "duration_seconds": 4.74,
      "text": "I haven't had swelling, numbness or injury, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.62,
      "end_seconds": 100.71,
      "duration_seconds": 3.09,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.85,
      "end_seconds": 104.69,
      "duration_seconds": 2.84,
      "text": "I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.43,
      "end_seconds": 108.26,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.86,
      "end_seconds": 113.53,
      "duration_seconds": 3.67,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.03,
      "end_seconds": 131.53,
      "duration_seconds": 3.5,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.94,
      "end_seconds": 144.66,
      "duration_seconds": 11.72,
      "text": "I've had thin bones, yes. Yeah, I've had heart failure, yes. Sorry, I know I'm rambling a bit. I've got gout."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.43,
      "end_seconds": 153.16,
      "duration_seconds": 6.73,
      "text": "Yes, thin bones and heart failure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.37,
      "end_seconds": 163.79,
      "duration_seconds": 2.42,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.29,
      "end_seconds": 168.28,
      "duration_seconds": 3.99,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.74,
      "end_seconds": 179.29,
      "duration_seconds": 2.55,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.21,
      "end_seconds": 183.22,
      "duration_seconds": 3.01,
      "text": "It's alendronate, once a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.8,
      "end_seconds": 186.06,
      "duration_seconds": 2.26,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.04,
      "end_seconds": 201.13,
      "duration_seconds": 14.09,
      "text": "70 milligrams. Let me think, I take metoprolol, 50 milligrams, twice a day. Febuxostat. I take it 80 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 205.75,
      "duration_seconds": 3.38,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.18,
      "end_seconds": 213.79,
      "duration_seconds": 6.61,
      "text": "Ah, no, it's at home. It's ibuprofen, 400 milligrams, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 215.25,
      "end_seconds": 220.77,
      "duration_seconds": 5.52,
      "text": "Doctor, our chart from the last visit lists it as 200 milligrams."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.83,
      "end_seconds": 227.73,
      "duration_seconds": 5.9,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.51,
      "end_seconds": 235.09,
      "duration_seconds": 5.58,
      "text": "Yeah, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.14,
      "end_seconds": 243.14,
      "duration_seconds": 4.0,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.55,
      "end_seconds": 264.12,
      "duration_seconds": 19.57,
      "text": "I only drink at family occasions. I've never touched a cigarette. I drink a lot of tea and snack through the day. I hardly move around during the day. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 267.38,
      "duration_seconds": 2.58,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.97,
      "end_seconds": 273.72,
      "duration_seconds": 4.75,
      "text": "Cat fur. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 276.44,
      "end_seconds": 285.13,
      "duration_seconds": 8.69,
      "text": "Doctor, I've got the readings for you. BP is 119 over 70, saturation 98 percent, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.63,
      "end_seconds": 287.55,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.63,
      "end_seconds": 292.35,
      "duration_seconds": 3.72,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.21,
      "end_seconds": 295.69,
      "duration_seconds": 1.48,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.59,
      "end_seconds": 297.84,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.05,
      "end_seconds": 320.32,
      "duration_seconds": 7.27,
      "text": "There is a very localised tender spot on the bone and hopping on that leg hurts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.33,
      "end_seconds": 335.97,
      "duration_seconds": 12.64,
      "text": "You can sit up now. Let me just check I've got this right. You've had a sore spot on the front of your shin, and no fever or numbness."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.51,
      "end_seconds": 339.36,
      "duration_seconds": 1.85,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.68,
      "end_seconds": 351.45,
      "duration_seconds": 10.77,
      "text": "Let's book an MRI of the shin to look into possible stress fracture. Let's book a vitamin D level to look into stress fracture."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.19,
      "end_seconds": 355.62,
      "duration_seconds": 3.43,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.98,
      "end_seconds": 389.02,
      "duration_seconds": 32.04,
      "text": "Stop running, no impact exercise until the scan, swimming or cycling is fine. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Let's review you after the scan. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.87,
      "end_seconds": 395.05,
      "duration_seconds": 4.18,
      "text": "Oh, okay, that makes sense. Thanks for explaining."
    }
  ]
}