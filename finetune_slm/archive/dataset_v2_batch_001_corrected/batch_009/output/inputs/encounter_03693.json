{
  "schema_version": "1.0",
  "encounter_id": "03693",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 5.23,
      "duration_seconds": 4.7,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.71,
      "end_seconds": 10.62,
      "duration_seconds": 3.91,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.56,
      "end_seconds": 17.48,
      "duration_seconds": 5.92,
      "text": "Um, so the thing is, I've got a dry cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 20.19,
      "duration_seconds": 1.29,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.14,
      "end_seconds": 24.88,
      "duration_seconds": 3.74,
      "text": "it's been six months, I'm fairly sure"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.24,
      "end_seconds": 32.37,
      "duration_seconds": 3.13,
      "text": "Is it it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.99,
      "end_seconds": 36.94,
      "duration_seconds": 3.95,
      "text": "I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.24,
      "end_seconds": 41.25,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.79,
      "end_seconds": 43.38,
      "duration_seconds": 1.59,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 46.7,
      "duration_seconds": 2.55,
      "text": "Right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.01,
      "end_seconds": 50.86,
      "duration_seconds": 2.85,
      "text": "Mm, it usually comes with tiredness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.9,
      "end_seconds": 58.68,
      "duration_seconds": 5.78,
      "text": "What about tender red lumps on your shins, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.19,
      "end_seconds": 63.68,
      "duration_seconds": 3.49,
      "text": "hmm, yeah. Three weeks, I'd say"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.55,
      "end_seconds": 67.67,
      "duration_seconds": 2.12,
      "text": "alright, how are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.17,
      "end_seconds": 76.69,
      "duration_seconds": 4.52,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.66,
      "end_seconds": 79.96,
      "duration_seconds": 1.3,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.55,
      "end_seconds": 88.44,
      "duration_seconds": 2.89,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.92,
      "end_seconds": 101.75,
      "duration_seconds": 3.83,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.32,
      "end_seconds": 112.84,
      "duration_seconds": 9.52,
      "text": "I've got thin bones. I'd rather know what's going on than keep guessing. High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.45,
      "end_seconds": 125.79,
      "duration_seconds": 11.34,
      "text": "right, so thin bones and high blood pressure are already on your record. We'll keep that in mind today. Let's run through your medicines"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.35,
      "end_seconds": 139.28,
      "duration_seconds": 7.93,
      "text": "Alendronate, 70 milligrams, once a week for my bones. It's losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.48,
      "end_seconds": 158.87,
      "duration_seconds": 4.39,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.39,
      "end_seconds": 164.63,
      "duration_seconds": 4.24,
      "text": "ah, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.43,
      "end_seconds": 174.78,
      "duration_seconds": 5.35,
      "text": "have you noticed coughing up blood, fever, weight loss or night sweats?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.82,
      "end_seconds": 181.47,
      "duration_seconds": 4.65,
      "text": "no, uh, I haven't had any of them"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.68,
      "end_seconds": 186.45,
      "duration_seconds": 3.77,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.48,
      "end_seconds": 191.96,
      "duration_seconds": 3.48,
      "text": "Well, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.0,
      "end_seconds": 195.58,
      "duration_seconds": 2.58,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.53,
      "end_seconds": 199.03,
      "duration_seconds": 1.5,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 200.99,
      "end_seconds": 217.19,
      "duration_seconds": 16.2,
      "text": "Doctor, I've got the readings for you. Weight 95 kilos, respiratory rate 15, blood pressure 109 over 77, temperature 36.5, height 168 centimetres, SpO2 97 percent on room air, heart rate 67, BMI works out to 33.7."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.59,
      "end_seconds": 219.99,
      "duration_seconds": 1.4,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.97,
      "end_seconds": 226.46,
      "duration_seconds": 4.49,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.41,
      "end_seconds": 230.37,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.11,
      "end_seconds": 247.01,
      "duration_seconds": 5.9,
      "text": "There are tender raised red nodules on both shins and your ankles are puffy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.36,
      "end_seconds": 255.8,
      "duration_seconds": 3.44,
      "text": "Alright, that's all I needed to check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.28,
      "end_seconds": 279.25,
      "duration_seconds": 5.97,
      "text": "Taking everything into account, I think we're dealing with possible sarcoidosis at this stage."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.89,
      "end_seconds": 283.66,
      "duration_seconds": 2.77,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.93,
      "end_seconds": 298.41,
      "duration_seconds": 13.48,
      "text": "I understand the worry. At the moment I'd say it's possible sarcoidosis, and we'll know more once the blood tests is back. I'm going to order blood tests, for possible sarcoidosis"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.14,
      "end_seconds": 302.03,
      "duration_seconds": 2.89,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.72,
      "end_seconds": 317.89,
      "duration_seconds": 14.17,
      "text": "Rest and elevate the legs, and I'm arranging a chest clinic review. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.75,
      "end_seconds": 322.95,
      "duration_seconds": 4.2,
      "text": "Yes, uh, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.43,
      "end_seconds": 330.68,
      "duration_seconds": 6.25,
      "text": "Book a review after the tests. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.68,
      "end_seconds": 334.5,
      "duration_seconds": 2.82,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.44,
      "end_seconds": 336.9,
      "duration_seconds": 1.46,
      "text": "Look after yourself."
    }
  ]
}