{
  "schema_version": "1.0",
  "encounter_id": "03592",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.51,
      "end_seconds": 6.1,
      "duration_seconds": 5.59,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.65,
      "end_seconds": 11.89,
      "duration_seconds": 4.24,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.82,
      "end_seconds": 20.44,
      "duration_seconds": 6.62,
      "text": "It's being very thirsty. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.84,
      "end_seconds": 25.91,
      "duration_seconds": 4.07,
      "text": "Right, how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.46,
      "end_seconds": 31.24,
      "duration_seconds": 3.78,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 34.99,
      "duration_seconds": 2.8,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.43,
      "end_seconds": 39.4,
      "duration_seconds": 2.97,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 40.68,
      "end_seconds": 55.51,
      "duration_seconds": 14.83,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 96 percent, weight 83 kilos, pressure 114 over 78, height 164 centimetres, BMI works out to 30.9, heart rate 116, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.58,
      "end_seconds": 57.59,
      "duration_seconds": 1.01,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 64.43,
      "duration_seconds": 4.55,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.48,
      "end_seconds": 67.94,
      "duration_seconds": 2.46,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.79,
      "end_seconds": 91.63,
      "duration_seconds": 5.84,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.99,
      "end_seconds": 97.9,
      "duration_seconds": 1.91,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.93,
      "end_seconds": 118.92,
      "duration_seconds": 3.99,
      "text": "Let me check a few things. Any diarrhoea or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.72,
      "end_seconds": 122.23,
      "duration_seconds": 2.51,
      "text": "No, no diarrhoea or cough."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.87,
      "end_seconds": 127.27,
      "duration_seconds": 3.4,
      "text": "And what about sore throat or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.59,
      "end_seconds": 135.14,
      "duration_seconds": 4.55,
      "text": "I haven't had sore throat or fever, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.19,
      "end_seconds": 140.52,
      "duration_seconds": 3.33,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.79,
      "end_seconds": 144.71,
      "duration_seconds": 2.92,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.4,
      "end_seconds": 148.44,
      "duration_seconds": 2.04,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.99,
      "end_seconds": 150.96,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.34,
      "end_seconds": 156.08,
      "duration_seconds": 3.74,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 157.02,
      "end_seconds": 158.6,
      "duration_seconds": 1.58,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.68,
      "end_seconds": 171.16,
      "duration_seconds": 2.48,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.41,
      "end_seconds": 179.29,
      "duration_seconds": 2.88,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.35,
      "end_seconds": 184.12,
      "duration_seconds": 2.77,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 190.41,
      "duration_seconds": 4.59,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.21,
      "end_seconds": 192.8,
      "duration_seconds": 1.59,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.16,
      "end_seconds": 196.9,
      "duration_seconds": 2.74,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.45,
      "end_seconds": 204.66,
      "duration_seconds": 3.21,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.0,
      "end_seconds": 209.21,
      "duration_seconds": 3.21,
      "text": "Okay, so my grandmother had dementia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.28,
      "end_seconds": 230.22,
      "duration_seconds": 3.94,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.31,
      "end_seconds": 233.97,
      "duration_seconds": 2.66,
      "text": "I'm on lansoprazole, before breakfast."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.3,
      "end_seconds": 237.65,
      "duration_seconds": 2.35,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.89,
      "end_seconds": 240.35,
      "duration_seconds": 1.46,
      "text": "It's 30 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.69,
      "end_seconds": 242.59,
      "duration_seconds": 1.9,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.83,
      "end_seconds": 261.52,
      "duration_seconds": 2.69,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.57,
      "end_seconds": 267.46,
      "duration_seconds": 4.89,
      "text": "I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.12,
      "end_seconds": 296.7,
      "duration_seconds": 28.58,
      "text": "So, based on the history and the examination, this looks most like possible new type 1 diabetes starting to turn acidic. I'd like to arrange a finger-prick glucose and ketones for thirst and weight loss. This is not flu, your sugar is very high, and you need hospital insulin today. Let's get you seen by the diabetes team, I'll arrange the letter. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.06,
      "end_seconds": 302.86,
      "duration_seconds": 4.8,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.77,
      "end_seconds": 308.53,
      "duration_seconds": 3.76,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.62,
      "end_seconds": 310.92,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}