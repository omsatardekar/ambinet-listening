{
  "schema_version": "1.0",
  "encounter_id": "03659",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.69,
      "duration_seconds": 4.8,
      "text": "Oh, um, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.11,
      "end_seconds": 11.08,
      "duration_seconds": 3.97,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 17.89,
      "duration_seconds": 5.07,
      "text": "It's an itchy red rash on the chest, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.41,
      "end_seconds": 21.5,
      "duration_seconds": 2.09,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.2,
      "end_seconds": 26.42,
      "duration_seconds": 3.22,
      "text": "Ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.92,
      "end_seconds": 35.74,
      "duration_seconds": 3.82,
      "text": "So, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.04,
      "end_seconds": 40.89,
      "duration_seconds": 3.85,
      "text": "Mostly moderate. And a mild temperature, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.31,
      "end_seconds": 45.32,
      "duration_seconds": 3.01,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.91,
      "end_seconds": 48.38,
      "duration_seconds": 1.47,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 55.63,
      "duration_seconds": 7.01,
      "text": "Ah. Let me check a few things. Any mouth sores, breathing difficulty or blistering?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.14,
      "end_seconds": 62.05,
      "duration_seconds": 4.91,
      "text": "No, you know, no mouth sores, breathing difficulty or blistering."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.12,
      "end_seconds": 67.07,
      "duration_seconds": 1.95,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.65,
      "end_seconds": 71.1,
      "duration_seconds": 2.45,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.28,
      "end_seconds": 90.7,
      "duration_seconds": 2.42,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.43,
      "end_seconds": 97.57,
      "duration_seconds": 5.14,
      "text": "Allopurinol. I take it 100 milligrams, started three weeks ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.21,
      "end_seconds": 102.15,
      "duration_seconds": 2.94,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.79,
      "end_seconds": 118.95,
      "duration_seconds": 16.16,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. I grab fast food at lunch most days. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.13,
      "end_seconds": 124.17,
      "duration_seconds": 4.04,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.22,
      "end_seconds": 128.84,
      "duration_seconds": 2.62,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.11,
      "end_seconds": 149.36,
      "duration_seconds": 4.25,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.28,
      "end_seconds": 153.33,
      "duration_seconds": 3.05,
      "text": "No, um, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.59,
      "end_seconds": 157.45,
      "duration_seconds": 2.86,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.87,
      "end_seconds": 170.14,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.12,
      "end_seconds": 196.3,
      "duration_seconds": 6.18,
      "text": "Okay: BP is 121 over 70, temperature is 36.5 degrees, heart rate 85."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.83,
      "end_seconds": 200.03,
      "duration_seconds": 2.2,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.8,
      "end_seconds": 205.44,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.32,
      "end_seconds": 208.57,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.65,
      "end_seconds": 224.5,
      "duration_seconds": 7.85,
      "text": "There is a fine pink rash across the chest and arms, with no blistering and the mouth is clear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.58,
      "end_seconds": 230.52,
      "duration_seconds": 2.94,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.95,
      "end_seconds": 251.38,
      "duration_seconds": 8.43,
      "text": "So where does that leave us? I think we're dealing with a drug rash probably from allopurinol at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.7,
      "end_seconds": 266.73,
      "duration_seconds": 5.03,
      "text": "Blood tests is what I'd like next, for drug rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.62,
      "end_seconds": 271.54,
      "duration_seconds": 3.92,
      "text": "Well, you know, when would that take place?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.23,
      "end_seconds": 306.85,
      "duration_seconds": 33.62,
      "text": "What I'm giving you is cetirizine, 10 milligrams, once a day, one week. You take it by mouth. That should help with itch. Please stop the allopurinol and don't restart it until we've spoken to the clinic. Come back or go to emergency straight away if you develop blisters, mouth sores or facial swelling. I'd like to see you again in three days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.01,
      "end_seconds": 311.05,
      "duration_seconds": 3.04,
      "text": "Alright, um, thanks, take care."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.29,
      "end_seconds": 313.46,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}