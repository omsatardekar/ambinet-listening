{
  "schema_version": "1.0",
  "encounter_id": "03568",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 4.08,
      "duration_seconds": 2.91,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.81,
      "end_seconds": 9.37,
      "duration_seconds": 3.56,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.91,
      "end_seconds": 15.83,
      "duration_seconds": 5.92,
      "text": "That's fine, sit down. We'll go through it together. Was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.88,
      "end_seconds": 21.36,
      "duration_seconds": 4.48,
      "text": "Not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.33,
      "end_seconds": 25.05,
      "duration_seconds": 1.72,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.05,
      "end_seconds": 32.77,
      "duration_seconds": 5.72,
      "text": "It's a headache. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.66,
      "end_seconds": 38.06,
      "duration_seconds": 3.4,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.92,
      "end_seconds": 42.17,
      "duration_seconds": 2.25,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.5,
      "end_seconds": 47.3,
      "duration_seconds": 4.8,
      "text": "I follow. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.12,
      "end_seconds": 50.9,
      "duration_seconds": 1.78,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.5,
      "end_seconds": 57.49,
      "duration_seconds": 5.99,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 57.59,
      "end_seconds": 63.66,
      "duration_seconds": 6.07,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.0,
      "end_seconds": 67.14,
      "duration_seconds": 2.14,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.62,
      "end_seconds": 73.79,
      "duration_seconds": 5.17,
      "text": "And I've been feeling muddled and unsteady as well, since Friday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 86.93,
      "end_seconds": 99.48,
      "duration_seconds": 12.55,
      "text": "Doctor, I've got the readings for you. Pulse is 75 beats a minute, respiratory rate 16, SpO2 99 percent on room air, BP is 111 over 82."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.05,
      "end_seconds": 102.44,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.19,
      "end_seconds": 107.96,
      "duration_seconds": 3.77,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.85,
      "end_seconds": 110.05,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.89,
      "end_seconds": 134.28,
      "duration_seconds": 7.39,
      "text": "You are a bit slow and unsteady, but there is no weakness and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.29,
      "end_seconds": 147.85,
      "duration_seconds": 8.56,
      "text": "Good, you can sit up again. Did you get weakness on one side, fall, seizure or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.38,
      "end_seconds": 161.18,
      "duration_seconds": 12.8,
      "text": "No, no weakness on one side, no fall, no seizure. I did have cramps at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.58,
      "end_seconds": 170.04,
      "duration_seconds": 3.46,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.83,
      "end_seconds": 173.41,
      "duration_seconds": 2.58,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.15,
      "end_seconds": 177.75,
      "duration_seconds": 2.6,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.74,
      "end_seconds": 181.27,
      "duration_seconds": 2.53,
      "text": "Oh, no, that's all fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.16,
      "end_seconds": 187.54,
      "duration_seconds": 4.38,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.53,
      "end_seconds": 192.99,
      "duration_seconds": 4.46,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 193.68,
      "end_seconds": 202.34,
      "duration_seconds": 8.66,
      "text": "Actually, I remember she had some kind of reaction to tramadol before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.04,
      "end_seconds": 206.55,
      "duration_seconds": 2.51,
      "text": "Right, I don't remember that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.2,
      "end_seconds": 216.98,
      "duration_seconds": 8.78,
      "text": "Alright, so that's unclear. I'll record what each of you said. What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.67,
      "end_seconds": 226.29,
      "duration_seconds": 8.62,
      "text": "I have depression, for two years. I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.85,
      "end_seconds": 233.55,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.42,
      "end_seconds": 241.65,
      "duration_seconds": 6.23,
      "text": "I've had arthritis in my knees for about a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.53,
      "end_seconds": 250.24,
      "duration_seconds": 7.71,
      "text": "Alright, depression and high blood pressure, that matches what I have here. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.99,
      "end_seconds": 253.92,
      "duration_seconds": 1.93,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.24,
      "end_seconds": 258.54,
      "duration_seconds": 3.3,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 260.05,
      "end_seconds": 275.05,
      "duration_seconds": 15.0,
      "text": "I take sertraline, 50 milligrams, once a day for my mood. I take something called losa... losartan, 50 milligrams, maybe, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.8,
      "end_seconds": 280.6,
      "duration_seconds": 4.8,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 282.66,
      "end_seconds": 286.34,
      "duration_seconds": 3.68,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 288.48,
      "end_seconds": 295.6,
      "duration_seconds": 7.12,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.81,
      "end_seconds": 299.43,
      "duration_seconds": 2.62,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.02,
      "end_seconds": 315.42,
      "duration_seconds": 14.4,
      "text": "For the joint pain, I believe. My daughter sets them out for me, I just take what I'm given. I, I used to take valsartan, but I stopped it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.15,
      "end_seconds": 319.97,
      "duration_seconds": 3.82,
      "text": "So, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.54,
      "end_seconds": 322.52,
      "duration_seconds": 1.98,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.41,
      "end_seconds": 335.62,
      "duration_seconds": 5.21,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 337.42,
      "end_seconds": 348.83,
      "duration_seconds": 11.41,
      "text": "I'll have a glass of wine with dinner. I smoke roughly a pack every two days. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.51,
      "end_seconds": 368.61,
      "duration_seconds": 18.1,
      "text": "Okay, thinking it through, it fits best with a low salt level, possibly from the new antidepressant. The reason I say that is that your story and my examination fit together. I'd also keep a urine infection in mind. Dehydration is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 369.13,
      "end_seconds": 371.45,
      "duration_seconds": 2.32,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.27,
      "end_seconds": 392.29,
      "duration_seconds": 19.02,
      "text": "I can't promise yet, but most people with a low salt level, possibly from the new antidepressant do well once it's treated properly. Just to be sure I understood. You've had a headache, since yesterday, mild, and no weakness on one side or fever."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.02,
      "end_seconds": 393.72,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.52,
      "end_seconds": 402.36,
      "duration_seconds": 7.84,
      "text": "Let's book blood tests to look into confusion. A urine test is what I'd like next, for confusion."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 403.27,
      "end_seconds": 404.41,
      "duration_seconds": 1.14,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 405.07,
      "end_seconds": 439.66,
      "duration_seconds": 34.59,
      "text": "We will stop the new tablet and not drink excess water until we have the result. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. The older people's clinic would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 440.83,
      "end_seconds": 444.1,
      "duration_seconds": 3.27,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 446.02,
      "end_seconds": 451.24,
      "duration_seconds": 5.22,
      "text": "If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 453.19,
      "end_seconds": 456.36,
      "duration_seconds": 3.17,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 457.8,
      "end_seconds": 463.29,
      "duration_seconds": 5.49,
      "text": "See me again in two days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 464.8,
      "end_seconds": 466.71,
      "duration_seconds": 1.91,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 467.4,
      "end_seconds": 468.96,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}