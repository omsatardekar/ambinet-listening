{
  "schema_version": "1.0",
  "encounter_id": "03519",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 3.35,
      "duration_seconds": 2.6,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.47,
      "end_seconds": 5.74,
      "duration_seconds": 1.27,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 7.13,
      "end_seconds": 14.8,
      "duration_seconds": 7.67,
      "text": "So, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.57,
      "end_seconds": 19.03,
      "duration_seconds": 2.46,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.04,
      "end_seconds": 32.12,
      "duration_seconds": 11.08,
      "text": "Mainly headaches in the evenings at home. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.18,
      "end_seconds": 38.08,
      "duration_seconds": 3.9,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.05,
      "end_seconds": 52.85,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.45,
      "end_seconds": 74.3,
      "duration_seconds": 11.85,
      "text": "Okay: temp 36.7 degrees, SpO2 99 percent on room air. And BP is 126 over 77, weight 60 kilos, height 151 centimetres, heart rate 80."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.3,
      "end_seconds": 78.68,
      "duration_seconds": 3.38,
      "text": "Um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.36,
      "end_seconds": 82.79,
      "duration_seconds": 3.43,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.12,
      "end_seconds": 88.59,
      "duration_seconds": 5.47,
      "text": "Hm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.0,
      "end_seconds": 106.78,
      "duration_seconds": 16.78,
      "text": "Yeah, um, it happens a couple of times a week. I'd give it a four, out of ten. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.81,
      "end_seconds": 110.78,
      "duration_seconds": 1.97,
      "text": "Has there been nausea too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.45,
      "end_seconds": 129.16,
      "duration_seconds": 17.71,
      "text": "Yes, um, about the same, about three months. Yeah, uh, I've been feeling dizzy too. Oh, about feeling dizzy, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.25,
      "end_seconds": 149.68,
      "duration_seconds": 6.43,
      "text": "Let me check a few things. Any rash, cough, sore throat or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.98,
      "end_seconds": 154.57,
      "duration_seconds": 3.59,
      "text": "No, uh, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.27,
      "end_seconds": 159.64,
      "duration_seconds": 3.37,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.57,
      "end_seconds": 166.09,
      "duration_seconds": 2.52,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.54,
      "end_seconds": 171.78,
      "duration_seconds": 2.24,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.05,
      "end_seconds": 175.66,
      "duration_seconds": 2.61,
      "text": "Erm, no problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.17,
      "end_seconds": 179.54,
      "duration_seconds": 3.37,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 180.38,
      "end_seconds": 184.96,
      "duration_seconds": 4.58,
      "text": "Yeah, it's Foracort inhaler, twice a day, doctor."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.54,
      "end_seconds": 186.44,
      "duration_seconds": 0.9,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 187.56,
      "end_seconds": 193.7,
      "duration_seconds": 6.14,
      "text": "He takes iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.54,
      "end_seconds": 200.59,
      "duration_seconds": 6.05,
      "text": "I'd been on Seretide inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.79,
      "end_seconds": 205.08,
      "duration_seconds": 3.29,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.18,
      "end_seconds": 208.98,
      "duration_seconds": 2.8,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.44,
      "end_seconds": 214.42,
      "duration_seconds": 3.98,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.22,
      "end_seconds": 222.72,
      "duration_seconds": 4.5,
      "text": "I'm allergic to kiwi, I get an itchy mouth."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.11,
      "end_seconds": 226.97,
      "duration_seconds": 2.86,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.65,
      "end_seconds": 230.3,
      "duration_seconds": 1.65,
      "text": "I have asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.24,
      "end_seconds": 232.2,
      "duration_seconds": 0.96,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.55,
      "end_seconds": 239.39,
      "duration_seconds": 5.84,
      "text": "Let me think, I have low haemoglobin, for two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.48,
      "end_seconds": 250.35,
      "duration_seconds": 8.87,
      "text": "Right, so asthma and low haemoglobin are already on your record. We'll keep that in mind today. Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.04,
      "end_seconds": 259.32,
      "duration_seconds": 4.28,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.26,
      "end_seconds": 262.06,
      "duration_seconds": 1.8,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.58,
      "end_seconds": 267.93,
      "duration_seconds": 5.35,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.53,
      "end_seconds": 273.28,
      "duration_seconds": 2.75,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.32,
      "end_seconds": 275.69,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.54,
      "end_seconds": 291.99,
      "duration_seconds": 6.45,
      "text": "Your oxygen reading looks normal and the examination is normal, but I'm worried about the pattern."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.14,
      "end_seconds": 295.94,
      "duration_seconds": 1.8,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.68,
      "end_seconds": 344.48,
      "duration_seconds": 31.8,
      "text": "Having listened and examined, this is probably possible carbon monoxide exposure at home. It could also be a viral illness, so we'll keep that open. I'll request a carboxyhaemoglobin blood test, it'll help with possible carbon monoxide exposure. Please don't use the boiler tonight and get it checked by an engineer, and keep a window open. Let's get you seen by the gas emergency service, I'll arrange the letter. Let's plan a check tomorrow."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.32,
      "end_seconds": 347.9,
      "duration_seconds": 2.58,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.47,
      "end_seconds": 352.5,
      "duration_seconds": 4.03,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.51,
      "end_seconds": 359.82,
      "duration_seconds": 4.31,
      "text": "I mean, uh, alright, thanks, take care."
    }
  ]
}