{
  "schema_version": "1.0",
  "encounter_id": "03542",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.92,
      "duration_seconds": 6.05,
      "text": "Sorry, what was I saying, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.26,
      "end_seconds": 12.89,
      "duration_seconds": 4.63,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.73,
      "end_seconds": 18.63,
      "duration_seconds": 4.9,
      "text": "So, I've been feeling like I have flu, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.36,
      "end_seconds": 22.43,
      "duration_seconds": 3.07,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.07,
      "end_seconds": 25.9,
      "duration_seconds": 2.83,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.75,
      "end_seconds": 30.65,
      "duration_seconds": 2.9,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.4,
      "end_seconds": 40.88,
      "duration_seconds": 9.48,
      "text": "Maybe a five out of ten on a bad day. And I've been losing weight as well, for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.44,
      "end_seconds": 42.14,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.0,
      "end_seconds": 55.86,
      "duration_seconds": 3.86,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.99,
      "end_seconds": 58.89,
      "duration_seconds": 1.9,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.36,
      "end_seconds": 74.16,
      "duration_seconds": 1.8,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.25,
      "end_seconds": 77.06,
      "duration_seconds": 1.81,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.4,
      "end_seconds": 99.91,
      "duration_seconds": 4.51,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.88,
      "end_seconds": 103.93,
      "duration_seconds": 2.05,
      "text": "Yes, an irregular heartbeat."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.36,
      "end_seconds": 106.56,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.38,
      "end_seconds": 111.79,
      "duration_seconds": 3.41,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.05,
      "end_seconds": 114.34,
      "duration_seconds": 1.29,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.06,
      "end_seconds": 118.92,
      "duration_seconds": 3.86,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.79,
      "end_seconds": 123.32,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.29,
      "end_seconds": 129.04,
      "duration_seconds": 3.75,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.55,
      "end_seconds": 132.25,
      "duration_seconds": 1.7,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.22,
      "end_seconds": 136.76,
      "duration_seconds": 2.54,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.32,
      "end_seconds": 140.06,
      "duration_seconds": 2.74,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.05,
      "end_seconds": 145.93,
      "duration_seconds": 3.88,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.41,
      "end_seconds": 149.82,
      "duration_seconds": 2.41,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.78,
      "end_seconds": 155.37,
      "duration_seconds": 4.59,
      "text": "I'm on apixaban, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.69,
      "end_seconds": 159.12,
      "duration_seconds": 2.43,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.98,
      "end_seconds": 167.13,
      "duration_seconds": 4.15,
      "text": "5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.0,
      "end_seconds": 171.19,
      "duration_seconds": 2.19,
      "text": "Did you notice any diarrhoea?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.24,
      "end_seconds": 173.82,
      "duration_seconds": 1.58,
      "text": "No. No diarrhoea."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.4,
      "end_seconds": 182.15,
      "duration_seconds": 3.75,
      "text": "A few quick ones: fever, cough or sore throat?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.94,
      "end_seconds": 186.32,
      "duration_seconds": 3.38,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.19,
      "end_seconds": 192.02,
      "duration_seconds": 3.83,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.51,
      "end_seconds": 198.13,
      "duration_seconds": 4.62,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.91,
      "end_seconds": 204.36,
      "duration_seconds": 4.45,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.59,
      "end_seconds": 216.75,
      "duration_seconds": 2.16,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.7,
      "end_seconds": 240.15,
      "duration_seconds": 13.45,
      "text": "Okay: weight 70 kilos, height 180 centimetres. And saturation 98 percent, pulse is 120 beats a minute, BMI works out to 21.6, pressure 121 over 72, temperature 36.6."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.24,
      "end_seconds": 245.01,
      "duration_seconds": 3.77,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.2,
      "end_seconds": 247.21,
      "duration_seconds": 1.01,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.89,
      "end_seconds": 250.2,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.88,
      "end_seconds": 267.08,
      "duration_seconds": 6.2,
      "text": "You are breathing a little deeply and fast and your mouth is dry."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.51,
      "end_seconds": 274.19,
      "duration_seconds": 1.68,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.65,
      "end_seconds": 315.3,
      "duration_seconds": 27.65,
      "text": "Putting it all together, it's hard to say. Possible new type 1 diabetes starting to turn acidic is one possibility and a viral illness another, and I'd rather not commit yet. I'm going to order a finger-prick glucose and ketones, for thirst and weight loss. I'd like to arrange blood tests for possible ketoacidosis. This is not flu, your sugar is very high, and you need hospital insulin today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.16,
      "end_seconds": 331.93,
      "duration_seconds": 14.77,
      "text": "The diabetes team would be the right next step, I'll refer you. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.87,
      "end_seconds": 334.77,
      "duration_seconds": 0.9,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.83,
      "end_seconds": 344.28,
      "duration_seconds": 4.45,
      "text": "We'll catch up straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.16,
      "end_seconds": 349.59,
      "duration_seconds": 3.43,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}