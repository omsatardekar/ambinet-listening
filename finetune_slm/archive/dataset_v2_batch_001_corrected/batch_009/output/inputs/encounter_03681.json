{
  "schema_version": "1.0",
  "encounter_id": "03681",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 4.32,
      "duration_seconds": 3.34,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.86,
      "end_seconds": 6.88,
      "duration_seconds": 1.02,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.76,
      "end_seconds": 11.82,
      "duration_seconds": 3.06,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.64,
      "end_seconds": 16.58,
      "duration_seconds": 3.94,
      "text": "I'm here because of being very stressed."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.77,
      "end_seconds": 20.98,
      "duration_seconds": 3.21,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.56,
      "end_seconds": 26.29,
      "duration_seconds": 3.73,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.49,
      "end_seconds": 33.77,
      "duration_seconds": 6.28,
      "text": "Alright, what about shaking when you try to walk, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.43,
      "end_seconds": 46.81,
      "duration_seconds": 11.38,
      "text": "Yeah. Six months, I'd say. About shaking when I try to walk, it's moderate, honestly. There was tingling, yes, but that went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 53.89,
      "duration_seconds": 5.47,
      "text": "Have you had being very stressed before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.29,
      "end_seconds": 61.47,
      "duration_seconds": 6.18,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.09,
      "end_seconds": 74.48,
      "duration_seconds": 2.39,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.45,
      "end_seconds": 81.73,
      "duration_seconds": 5.28,
      "text": "I have arthritis in my knees, for about a year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.56,
      "end_seconds": 104.62,
      "duration_seconds": 4.06,
      "text": "Right, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.33,
      "end_seconds": 108.55,
      "duration_seconds": 3.22,
      "text": "I take naproxen, twice a day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.85,
      "end_seconds": 111.96,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.6,
      "end_seconds": 115.01,
      "duration_seconds": 1.41,
      "text": "It's 250 milligrams."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.99,
      "end_seconds": 118.51,
      "duration_seconds": 2.52,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.74,
      "end_seconds": 123.38,
      "duration_seconds": 3.64,
      "text": "Ah, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.76,
      "end_seconds": 128.51,
      "duration_seconds": 3.75,
      "text": "Okay, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.29,
      "end_seconds": 132.08,
      "duration_seconds": 2.79,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.33,
      "end_seconds": 134.18,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.98,
      "end_seconds": 137.5,
      "duration_seconds": 2.52,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.14,
      "end_seconds": 141.12,
      "duration_seconds": 1.98,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.96,
      "end_seconds": 148.96,
      "duration_seconds": 6.0,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.71,
      "end_seconds": 154.15,
      "duration_seconds": 3.44,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.0,
      "end_seconds": 159.97,
      "duration_seconds": 3.97,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.83,
      "end_seconds": 163.55,
      "duration_seconds": 2.72,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.1,
      "end_seconds": 168.37,
      "duration_seconds": 3.27,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.81,
      "end_seconds": 186.68,
      "duration_seconds": 6.87,
      "text": "Okay, have you had any loss of bladder control, visual loss, back pain or headache?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.21,
      "end_seconds": 189.61,
      "duration_seconds": 2.4,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.58,
      "end_seconds": 192.56,
      "duration_seconds": 1.98,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.21,
      "end_seconds": 195.05,
      "duration_seconds": 1.84,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.41,
      "end_seconds": 199.72,
      "duration_seconds": 3.31,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.95,
      "end_seconds": 209.92,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.46,
      "end_seconds": 232.33,
      "duration_seconds": 7.87,
      "text": "Okay: blood pressure 126 over 75, temp 36.5 degrees. And pulse 64, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.94,
      "end_seconds": 235.33,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 241.44,
      "duration_seconds": 4.33,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.82,
      "end_seconds": 245.24,
      "duration_seconds": 2.42,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.21,
      "end_seconds": 248.28,
      "duration_seconds": 1.07,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.07,
      "end_seconds": 252.37,
      "duration_seconds": 2.3,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.02,
      "end_seconds": 270.26,
      "duration_seconds": 9.24,
      "text": "The leg gives way on testing but the strength returns when you are distracted, and the reflexes are normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.84,
      "end_seconds": 281.13,
      "duration_seconds": 8.29,
      "text": "That's all I needed to check. Okay, so my impression is this: This looks most like a likely functional neurological disorder."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.53,
      "end_seconds": 285.33,
      "duration_seconds": 2.8,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.33,
      "end_seconds": 302.53,
      "duration_seconds": 16.2,
      "text": "It's reasonable to be concerned, but right now a likely functional neurological disorder is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had being very stressed, and no headache or loss of bladder control."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.62,
      "end_seconds": 305.32,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.28,
      "end_seconds": 313.47,
      "duration_seconds": 7.19,
      "text": "I'll request an MRI scan, it'll help with leg weakness. Let's get blood tests, for neurological symptoms."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.47,
      "end_seconds": 315.58,
      "duration_seconds": 1.11,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.28,
      "end_seconds": 330.98,
      "duration_seconds": 14.7,
      "text": "This is real and treatable, the nervous system is working differently, not damaged. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.39,
      "end_seconds": 337.0,
      "duration_seconds": 5.61,
      "text": "Yes. We'll refer you to the neurology clinic. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.62,
      "end_seconds": 339.72,
      "duration_seconds": 2.1,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.26,
      "end_seconds": 341.54,
      "duration_seconds": 1.28,
      "text": "All the best."
    }
  ]
}