{
  "schema_version": "1.0",
  "encounter_id": "03611",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 3.9,
      "duration_seconds": 3.37,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 9.57,
      "duration_seconds": 3.63,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.37,
      "end_seconds": 14.38,
      "duration_seconds": 3.01,
      "text": "I've been dealing with night sweats."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.57,
      "end_seconds": 18.44,
      "duration_seconds": 2.87,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.54,
      "end_seconds": 29.69,
      "duration_seconds": 8.15,
      "text": "It's been going on for two days. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.19,
      "end_seconds": 40.69,
      "duration_seconds": 10.5,
      "text": "Yes, carry on. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.96,
      "end_seconds": 50.03,
      "duration_seconds": 5.07,
      "text": "About a seven out of ten. It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 55.07,
      "duration_seconds": 3.54,
      "text": "Any back pain that doesn't go away as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.99,
      "end_seconds": 60.01,
      "duration_seconds": 4.02,
      "text": "Yeah, you know, I've had that since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.86,
      "end_seconds": 66.92,
      "duration_seconds": 5.06,
      "text": "Alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.5,
      "end_seconds": 70.71,
      "duration_seconds": 3.21,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.06,
      "end_seconds": 80.7,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.36,
      "end_seconds": 85.47,
      "duration_seconds": 4.11,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.09,
      "end_seconds": 87.49,
      "duration_seconds": 1.4,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.43,
      "end_seconds": 91.41,
      "duration_seconds": 2.98,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.58,
      "end_seconds": 96.88,
      "duration_seconds": 4.3,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.49,
      "end_seconds": 104.58,
      "duration_seconds": 3.09,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.14,
      "end_seconds": 108.8,
      "duration_seconds": 2.66,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.54,
      "end_seconds": 118.65,
      "duration_seconds": 8.11,
      "text": "Sorry, you know, what was I saying, just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.72,
      "end_seconds": 132.02,
      "duration_seconds": 2.3,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.36,
      "end_seconds": 135.81,
      "duration_seconds": 2.45,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.97,
      "end_seconds": 151.97,
      "duration_seconds": 4.0,
      "text": "Have you noticed chest pain, leg weakness or breathlessness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.84,
      "end_seconds": 158.0,
      "duration_seconds": 4.16,
      "text": "Okay, so no, nothing to report there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.64,
      "end_seconds": 161.64,
      "duration_seconds": 3.0,
      "text": "And high fever, any of that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.2,
      "end_seconds": 167.85,
      "duration_seconds": 4.65,
      "text": "Okay, so not that I've noticed, no high fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.44,
      "end_seconds": 171.54,
      "duration_seconds": 3.1,
      "text": "Alright, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.89,
      "end_seconds": 175.38,
      "duration_seconds": 2.49,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.41,
      "end_seconds": 193.79,
      "duration_seconds": 4.38,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.11,
      "end_seconds": 208.64,
      "duration_seconds": 2.53,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.57,
      "end_seconds": 236.42,
      "duration_seconds": 9.85,
      "text": "Okay: heart rate 98, temp 38.4 degrees, SpO2 97 percent on room air, blood pressure 107 over 74, respiratory rate 22."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.79,
      "end_seconds": 240.25,
      "duration_seconds": 2.46,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.47,
      "end_seconds": 242.17,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.38,
      "end_seconds": 245.59,
      "duration_seconds": 2.21,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 264.35,
      "duration_seconds": 8.71,
      "text": "There is a soft heart murmur you've not had before and a small tender spot on the fingertip."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.63,
      "end_seconds": 297.2,
      "duration_seconds": 27.57,
      "text": "Please sit back down. Okay, thinking it through, it fits best with possible infection of the heart valve causing back and general symptoms. I'd like to arrange an MRI of the spine for persistent back pain with systemic symptoms. This is not an ordinary back strain, so I want tests today. We'll refer you to the medical admissions unit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.96,
      "end_seconds": 299.69,
      "duration_seconds": 1.73,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.56,
      "end_seconds": 313.58,
      "duration_seconds": 13.02,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.22,
      "end_seconds": 319.47,
      "duration_seconds": 4.25,
      "text": "No, uh, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.1,
      "end_seconds": 321.99,
      "duration_seconds": 1.89,
      "text": "Alright, see you soon."
    }
  ]
}