  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 5.18,
      "duration_seconds": 4.57,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.92,
      "end_seconds": 11.68,
      "duration_seconds": 4.76,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.18,
      "end_seconds": 18.26,
      "duration_seconds": 5.08,
      "text": "I'm here because of poor appetite for two days"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.74,
      "end_seconds": 22.59,
      "duration_seconds": 2.85,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.67,
      "end_seconds": 27.07,
      "duration_seconds": 2.4,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.47,
      "end_seconds": 41.91,
      "duration_seconds": 3.44,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.28,
      "end_seconds": 58.57,
      "duration_seconds": 15.29,
      "text": "About... well, three weeks. Oh, and a vague tummy ache. As for vague tummy ache, it comes and goes. I've been feeling off too, for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.77,
      "end_seconds": 62.56,
      "duration_seconds": 2.79,
      "text": "And high fever, any of that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.96,
      "end_seconds": 67.44,
      "duration_seconds": 3.48,
      "text": "No, I haven't had any high fever."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.04,
      "end_seconds": 72.51,
      "duration_seconds": 4.47,
      "text": "Have you noticed urinary symptoms, blood in the stool or vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.65,
      "end_seconds": 77.03,
      "duration_seconds": 3.38,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.71,
      "end_seconds": 80.64,
      "duration_seconds": 2.93,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 84.3,
      "duration_seconds": 2.29,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.9,
      "end_seconds": 90.69,
      "duration_seconds": 4.79,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.33,
      "end_seconds": 94.35,
      "duration_seconds": 3.02,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 112.56,
      "duration_seconds": 4.81,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.14,
      "end_seconds": 115.27,
      "duration_seconds": 2.13,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.44,
      "end_seconds": 121.68,
      "duration_seconds": 5.24,
      "text": "tell me about your routine, work, habits, that that sort of thing"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.74,
      "end_seconds": 143.64,
      "duration_seconds": 19.9,
      "text": "I gave up cigarettes last spring. Nothing, I'm teetotal. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.77,
      "end_seconds": 146.88,
      "duration_seconds": 2.11,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.15,
      "end_seconds": 152.03,
      "duration_seconds": 3.88,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.7,
      "end_seconds": 155.99,
      "duration_seconds": 2.29,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.28,
      "end_seconds": 165.63,
      "duration_seconds": 2.35,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.01,
      "end_seconds": 201.61,
      "duration_seconds": 14.6,
      "text": "Okay: blood pressure 111 over 78, oxygen saturation is 98 percent, weight 68 kilos, height 184 centimetres, BMI works out to 20.1, temp 36.6 degrees, pulse 68."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.13,
      "end_seconds": 204.51,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.32,
      "end_seconds": 208.12,
      "duration_seconds": 2.8,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.45,
      "end_seconds": 213.5,
      "duration_seconds": 3.05,
      "text": "Let's move on to to the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 216.71,
      "duration_seconds": 1.25,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.16,
      "end_seconds": 235.09,
      "duration_seconds": 8.93,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.74,
      "end_seconds": 252.83,
      "duration_seconds": 13.09,
      "text": "Good, you can sit up again. So, based on the history and the examination, my working impression is possible appendicitis, which can look mild in older people. We shouldn't forget diverticulitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.65,
      "end_seconds": 256.46,
      "duration_seconds": 1.81,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.79,
      "end_seconds": 270.18,
      "duration_seconds": 12.39,
      "text": "Nothing I've seen today points to an emergency. It looks like possible appendicitis, which can look mild in older people, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.76,
      "end_seconds": 306.26,
      "duration_seconds": 26.5,
      "text": "Let's book blood tests to look into abdominal pain. We should do a CT scan of the abdomen for right iliac fossa tenderness. Even though you look fairly well, I'd like the surgeons to see you today. The surgical team would be the right next step, I'll refer you. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.92,
      "end_seconds": 312.86,
      "duration_seconds": 5.94,
      "text": "Sorry, what was I saying, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.21,
      "end_seconds": 316.88,
      "duration_seconds": 2.67,
      "text": "I'll want another look straight away"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.05,
      "end_seconds": 321.27,
      "duration_seconds": 3.22,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.92,
      "end_seconds": 325.83,
      "duration_seconds": 2.91,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.91,
      "end_seconds": 330.31,
      "duration_seconds": 2.4,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}