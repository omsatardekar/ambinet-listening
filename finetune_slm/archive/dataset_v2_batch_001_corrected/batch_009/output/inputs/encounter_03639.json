{
  "schema_version": "1.0",
  "encounter_id": "03639",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 6.18,
      "duration_seconds": 5.47,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.13,
      "end_seconds": 12.78,
      "duration_seconds": 4.65,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.65,
      "end_seconds": 19.62,
      "duration_seconds": 5.97,
      "text": "Please do. Extra information is always welcome. Alright, what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.6,
      "end_seconds": 25.87,
      "duration_seconds": 4.27,
      "text": "Well, I've been having poor appetite for two days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.77,
      "end_seconds": 30.99,
      "duration_seconds": 3.22,
      "text": "Has there been a vague tummy ache too?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.86,
      "end_seconds": 51.13,
      "duration_seconds": 18.27,
      "text": "Yeah. Four weeks, I'd say. About vague tummy ache, it's moderate, honestly. As for being a bit constipated, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.48,
      "end_seconds": 58.61,
      "duration_seconds": 7.13,
      "text": "Mm, okay. Have you had poor appetite for two days before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.54,
      "end_seconds": 67.81,
      "duration_seconds": 7.27,
      "text": "So, uh, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.61,
      "end_seconds": 72.26,
      "duration_seconds": 3.65,
      "text": "Any high fever, urinary symptoms or vomiting at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.73,
      "end_seconds": 76.19,
      "duration_seconds": 2.46,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 81.95,
      "duration_seconds": 3.91,
      "text": "Did you notice any blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.86,
      "end_seconds": 86.99,
      "duration_seconds": 3.13,
      "text": "Definitely no blood in the stool."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.36,
      "end_seconds": 91.66,
      "duration_seconds": 3.3,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.68,
      "end_seconds": 95.14,
      "duration_seconds": 2.46,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.26,
      "end_seconds": 100.41,
      "duration_seconds": 4.15,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.65,
      "end_seconds": 114.33,
      "duration_seconds": 12.68,
      "text": "I've had high blood pressure for two years now. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.42,
      "end_seconds": 117.84,
      "duration_seconds": 1.42,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 120.69,
      "duration_seconds": 1.02,
      "text": "Yes, depression."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.68,
      "end_seconds": 128.28,
      "duration_seconds": 5.6,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.84,
      "end_seconds": 144.29,
      "duration_seconds": 2.45,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.59,
      "end_seconds": 147.39,
      "duration_seconds": 1.8,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 148.92,
      "end_seconds": 157.68,
      "duration_seconds": 8.76,
      "text": "Actually, I remember she had some kind of reaction to amoxicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.43,
      "end_seconds": 160.22,
      "duration_seconds": 1.79,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.18,
      "end_seconds": 168.64,
      "duration_seconds": 6.46,
      "text": "Fair enough, I'll write down both versions. Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.82,
      "end_seconds": 186.13,
      "duration_seconds": 13.31,
      "text": "I quit smoking around ten years ago. My partner and our baby. I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.89,
      "end_seconds": 190.12,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 191.57,
      "end_seconds": 195.58,
      "duration_seconds": 4.01,
      "text": "She takes telmisartan, once a day for my pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.65,
      "end_seconds": 200.01,
      "duration_seconds": 2.36,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 201.53,
      "end_seconds": 209.34,
      "duration_seconds": 7.81,
      "text": "40 milligrams, I think that's what's on the box. She takes fluoxetine, 20 milligrams, every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.46,
      "end_seconds": 213.49,
      "duration_seconds": 3.03,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 215.45,
      "end_seconds": 216.96,
      "duration_seconds": 1.51,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.91,
      "end_seconds": 224.43,
      "duration_seconds": 3.52,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.15,
      "end_seconds": 234.68,
      "duration_seconds": 2.53,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.91,
      "end_seconds": 259.01,
      "duration_seconds": 7.1,
      "text": "Okay: pulse 66, pressure 121 over 68. And temperature is 36.5 degrees, saturation 98 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 259.85,
      "end_seconds": 261.36,
      "duration_seconds": 1.51,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.35,
      "end_seconds": 268.08,
      "duration_seconds": 2.73,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.72,
      "end_seconds": 274.04,
      "duration_seconds": 4.32,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.81,
      "end_seconds": 278.05,
      "duration_seconds": 2.24,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.08,
      "end_seconds": 302.76,
      "duration_seconds": 8.68,
      "text": "Your tummy is soft but tender low on the right with mild guarding, and the temperature is only a little up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.64,
      "end_seconds": 307.97,
      "duration_seconds": 2.33,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.58,
      "end_seconds": 331.68,
      "duration_seconds": 12.1,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be possible appendicitis, which can look mild in older people, or it might be diverticulitis."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 333.06,
      "end_seconds": 336.11,
      "duration_seconds": 3.05,
      "text": "Uh, will it clear up?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.68,
      "end_seconds": 359.04,
      "duration_seconds": 21.36,
      "text": "Nothing I've seen today points to an emergency. It looks like possible appendicitis, which can look mild in older people, but I'd like to confirm. Let me repeat that back to make sure. You've had poor appetite for two days, and no blood in the stool or urinary symptoms."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 360.61,
      "end_seconds": 363.94,
      "duration_seconds": 3.33,
      "text": "Yes, um, you've got it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.97,
      "end_seconds": 387.72,
      "duration_seconds": 6.75,
      "text": "We should do a CT scan of the abdomen for right iliac fossa tenderness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 391.19,
      "end_seconds": 393.22,
      "duration_seconds": 2.03,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.0,
      "end_seconds": 399.45,
      "duration_seconds": 5.45,
      "text": "I'd like you back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 400.84,
      "end_seconds": 402.5,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 403.05,
      "end_seconds": 405.13,
      "duration_seconds": 2.08,
      "text": "Right, look after yourself."
    }
  ]
}