{
  "schema_version": "1.0",
  "encounter_id": "03645",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 4.56,
      "duration_seconds": 3.88,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 10.2,
      "duration_seconds": 3.92,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.93,
      "end_seconds": 17.1,
      "duration_seconds": 5.17,
      "text": "Yeah, it's no symptoms. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.08,
      "end_seconds": 21.19,
      "duration_seconds": 3.11,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.23,
      "end_seconds": 25.99,
      "duration_seconds": 2.76,
      "text": "Ibuprofen, 400 milligrams, most days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.28,
      "end_seconds": 30.41,
      "duration_seconds": 3.13,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.09,
      "end_seconds": 46.68,
      "duration_seconds": 14.59,
      "text": "I've had it for about a week i'm not great at remembering details, so bear with me i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.16,
      "end_seconds": 53.41,
      "duration_seconds": 6.25,
      "text": "Okay, go on. Have you had a low blood count on a routine test?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.21,
      "end_seconds": 56.31,
      "duration_seconds": 2.1,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.07,
      "end_seconds": 61.07,
      "duration_seconds": 4.0,
      "text": "Did you get black stools, heavy periods or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.94,
      "end_seconds": 64.86,
      "duration_seconds": 2.92,
      "text": "Nope, uh, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.48,
      "end_seconds": 69.92,
      "duration_seconds": 4.44,
      "text": "Have you had blood in the stool, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.5,
      "end_seconds": 74.8,
      "duration_seconds": 3.3,
      "text": "No blood in the stool, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.83,
      "end_seconds": 83.05,
      "duration_seconds": 3.22,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.67,
      "end_seconds": 84.72,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.22,
      "end_seconds": 89.53,
      "duration_seconds": 3.31,
      "text": "Right, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.44,
      "end_seconds": 92.73,
      "duration_seconds": 2.29,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.12,
      "end_seconds": 107.5,
      "duration_seconds": 4.38,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.34,
      "end_seconds": 111.67,
      "duration_seconds": 2.33,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 120.79,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.43,
      "end_seconds": 124.66,
      "duration_seconds": 3.23,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.53,
      "end_seconds": 131.23,
      "duration_seconds": 1.7,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.72,
      "end_seconds": 135.28,
      "duration_seconds": 2.56,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.24,
      "end_seconds": 138.02,
      "duration_seconds": 1.78,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.79,
      "end_seconds": 144.1,
      "duration_seconds": 4.31,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.1,
      "end_seconds": 150.01,
      "duration_seconds": 4.91,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.9,
      "end_seconds": 154.68,
      "duration_seconds": 3.78,
      "text": "I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.69,
      "end_seconds": 175.27,
      "duration_seconds": 3.58,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.76,
      "end_seconds": 191.56,
      "duration_seconds": 2.8,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.63,
      "end_seconds": 215.97,
      "duration_seconds": 10.34,
      "text": "Okay: blood pressure 119 over 75, temp 36.8 degrees, pulse is 72 beats a a minute, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.21,
      "end_seconds": 223.1,
      "duration_seconds": 4.89,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.91,
      "end_seconds": 226.22,
      "duration_seconds": 1.31,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.95,
      "end_seconds": 247.82,
      "duration_seconds": 4.87,
      "text": "Your pulse and blood pressure are normal, and the eyelids are pale."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.18,
      "end_seconds": 255.54,
      "duration_seconds": 2.36,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.41,
      "end_seconds": 277.71,
      "duration_seconds": 6.3,
      "text": "Taking everything into account, this looks most like iron-deficiency anaemia needing a source found."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.48,
      "end_seconds": 281.45,
      "duration_seconds": 2.97,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.92,
      "end_seconds": 297.76,
      "duration_seconds": 14.84,
      "text": "I can't promise yet, but most people with iron-deficiency anaemia needing a source found do well once it's treated properly. A camera test of the stomach and bowel is what I'd like next, for iron-deficiency anaemia."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 299.19,
      "end_seconds": 302.75,
      "duration_seconds": 3.56,
      "text": "I can book that for Friday at 2 pm"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.64,
      "end_seconds": 321.07,
      "duration_seconds": 17.43,
      "text": "we should do a coeliac blood test for anaemia i'd like you to take ferrous sulfate, 200 milligrams, once a day, three months you take it by mouth that's for iron deficiency stop the ibuprofen and we will refer you for scopes"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.28,
      "end_seconds": 329.2,
      "duration_seconds": 7.92,
      "text": "Yes, carry on. Please don't wait if the symptoms get worse. That's when to to be seen urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.82,
      "end_seconds": 334.74,
      "duration_seconds": 3.92,
      "text": "Yes, I'll bear that that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.57,
      "end_seconds": 340.42,
      "duration_seconds": 3.85,
      "text": "I'd like to see you again after the tests."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.8,
      "end_seconds": 343.53,
      "duration_seconds": 1.73,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.75,
      "end_seconds": 348.59,
      "duration_seconds": 3.84,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.04,
      "end_seconds": 351.59,
      "duration_seconds": 1.55,
      "text": "That's clear, thanks."
    }
  ]
}