{
  "schema_version": "1.0",
  "encounter_id": "03518",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.83,
      "duration_seconds": 3.07,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.58,
      "end_seconds": 13.13,
      "duration_seconds": 7.55,
      "text": "Hello, uh, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.01,
      "end_seconds": 17.03,
      "duration_seconds": 2.02,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.08,
      "end_seconds": 25.81,
      "duration_seconds": 3.73,
      "text": "it's daily headaches worse lying down, mostly"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.84,
      "end_seconds": 29.03,
      "duration_seconds": 1.19,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.37,
      "end_seconds": 38.01,
      "duration_seconds": 3.64,
      "text": "It's been going on for about a week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.9,
      "end_seconds": 44.49,
      "duration_seconds": 5.59,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.6,
      "end_seconds": 63.63,
      "duration_seconds": 18.03,
      "text": "It settles a little with sitting up. Pretty moderate, if I'm being honest. And a whooshing noise in my ears, too. Oh, and brief blackouts of vision on standing. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.75,
      "end_seconds": 67.35,
      "duration_seconds": 2.6,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.04,
      "end_seconds": 72.42,
      "duration_seconds": 4.38,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.61,
      "end_seconds": 76.07,
      "duration_seconds": 2.46,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.77,
      "end_seconds": 80.37,
      "duration_seconds": 2.6,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.6,
      "end_seconds": 88.28,
      "duration_seconds": 4.68,
      "text": "let's talk a little about your daily life and and habits"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.02,
      "end_seconds": 101.35,
      "duration_seconds": 12.33,
      "text": "I walk the dog every morning. Lots of rice, lentils and some fruit. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.82,
      "end_seconds": 121.59,
      "duration_seconds": 2.77,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.06,
      "end_seconds": 126.67,
      "duration_seconds": 3.61,
      "text": "I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.08,
      "end_seconds": 132.57,
      "duration_seconds": 4.49,
      "text": "Okay, go on. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.86,
      "end_seconds": 138.29,
      "duration_seconds": 4.43,
      "text": "Sitagliptin. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.38,
      "end_seconds": 159.85,
      "duration_seconds": 4.47,
      "text": "Have you noticed stiff neck, head injury, fever or weakness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.48,
      "end_seconds": 165.2,
      "duration_seconds": 4.72,
      "text": "No, no stiff neck, head injury, fever or weakness."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.63,
      "end_seconds": 169.61,
      "duration_seconds": 3.98,
      "text": "Yes, carry on. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.66,
      "end_seconds": 172.59,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.23,
      "end_seconds": 175.77,
      "duration_seconds": 2.54,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.82,
      "end_seconds": 178.44,
      "duration_seconds": 1.62,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.64,
      "end_seconds": 182.4,
      "duration_seconds": 2.76,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.83,
      "end_seconds": 197.04,
      "duration_seconds": 2.21,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 219.94,
      "duration_seconds": 5.62,
      "text": "okay: heart rate 83, BP is 114 over 74, temp 36.9 degrees"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.5,
      "end_seconds": 222.78,
      "duration_seconds": 2.28,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.43,
      "end_seconds": 227.11,
      "duration_seconds": 2.68,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.49,
      "end_seconds": 233.51,
      "duration_seconds": 5.02,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.5,
      "end_seconds": 237.86,
      "duration_seconds": 2.36,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.87,
      "end_seconds": 252.09,
      "duration_seconds": 7.22,
      "text": "The back of both eyes shows swollen optic discs and the visual fields are slightly constricted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.56,
      "end_seconds": 257.21,
      "duration_seconds": 2.65,
      "text": "Alright, you can sit up now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.41,
      "end_seconds": 294.88,
      "duration_seconds": 27.47,
      "text": "Let me tell you where I've got to. I think we're dealing with raised pressure inside the head, possibly idiopathic intracranial hypertension at this stage. I'd like you to take acetazolamide, 250 milligrams, twice a day, until review. That's for raised pressure. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 296.75,
      "end_seconds": 299.63,
      "duration_seconds": 2.88,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.44,
      "end_seconds": 307.03,
      "duration_seconds": 5.59,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.78,
      "end_seconds": 318.04,
      "duration_seconds": 7.26,
      "text": "So, you know, I take the acetazolamide, 250 milligrams, twice a day. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.08,
      "end_seconds": 322.86,
      "duration_seconds": 3.78,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.43,
      "end_seconds": 327.5,
      "duration_seconds": 3.07,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}