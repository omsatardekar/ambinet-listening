  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.92,
      "duration_seconds": 4.36,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 9.98,
      "duration_seconds": 3.74,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.99,
      "end_seconds": 24.54,
      "duration_seconds": 12.55,
      "text": "hello, doctor i hope it's alright if I stay in for this uh, doctor, it's back pain that doesn't go away that's what we're worried about"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.07,
      "end_seconds": 27.76,
      "duration_seconds": 2.69,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 33.14,
      "duration_seconds": 3.86,
      "text": "it's been about a week, I'm fairly sure"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.06,
      "end_seconds": 36.42,
      "duration_seconds": 2.36,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.45,
      "end_seconds": 39.43,
      "duration_seconds": 1.98,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.75,
      "end_seconds": 43.92,
      "duration_seconds": 4.17,
      "text": "I follow have you been feeling tired and run down?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.42,
      "end_seconds": 58.71,
      "duration_seconds": 13.29,
      "text": "okay, so yes, about the same, about a week. I was losing a bit of weight at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.62,
      "end_seconds": 63.64,
      "duration_seconds": 2.02,
      "text": "any breathlessness or high fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.66,
      "end_seconds": 67.97,
      "duration_seconds": 2.31,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.86,
      "end_seconds": 71.31,
      "duration_seconds": 2.45,
      "text": "Any leg weakness or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.72,
      "end_seconds": 75.7,
      "duration_seconds": 2.98,
      "text": "Right, none of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.94,
      "end_seconds": 81.53,
      "duration_seconds": 4.59,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.34,
      "end_seconds": 84.78,
      "duration_seconds": 2.44,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.41,
      "end_seconds": 91.29,
      "duration_seconds": 5.88,
      "text": "So, tell me your medicines, please. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 92.96,
      "end_seconds": 96.36,
      "duration_seconds": 3.4,
      "text": "It's telmisartan, once a day, doctor."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.94,
      "end_seconds": 100.63,
      "duration_seconds": 2.69,
      "text": "Alright, how much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.35,
      "end_seconds": 108.58,
      "duration_seconds": 6.23,
      "text": "it's 40 milligrams she takes Eltroxin, 100 micrograms, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.08,
      "end_seconds": 112.52,
      "duration_seconds": 2.44,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.54,
      "end_seconds": 124.9,
      "duration_seconds": 11.36,
      "text": "Mm, I've got high blood pressure. I didn't want to make a fuss, you know. An underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.64,
      "end_seconds": 135.71,
      "duration_seconds": 9.07,
      "text": "Okay, I can see an underactive thyroid in your file as well. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.36,
      "end_seconds": 141.7,
      "duration_seconds": 4.34,
      "text": "Grass pollen. I come out in... well, itchy eyes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 149.48,
      "duration_seconds": 3.2,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.9,
      "end_seconds": 176.62,
      "duration_seconds": 21.72,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. I do a yoga class on Thursdays. I grab fast food at lunch most days. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.69,
      "end_seconds": 195.16,
      "duration_seconds": 2.47,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.96,
      "end_seconds": 200.82,
      "duration_seconds": 4.86,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.26,
      "end_seconds": 219.66,
      "duration_seconds": 2.4,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.33,
      "end_seconds": 228.68,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.51,
      "end_seconds": 252.86,
      "duration_seconds": 9.35,
      "text": "Okay: SpO2 97 percent on room air, blood pressure 107 over 76, temp 38.8 degrees, pulse is 90 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.33,
      "end_seconds": 255.69,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.78,
      "end_seconds": 261.29,
      "duration_seconds": 3.51,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.69,
      "end_seconds": 265.39,
      "duration_seconds": 2.7,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.78,
      "end_seconds": 267.93,
      "duration_seconds": 1.15,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.51,
      "end_seconds": 271.93,
      "duration_seconds": 2.42,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.63,
      "end_seconds": 297.06,
      "duration_seconds": 8.43,
      "text": "there is a soft heart murmur you've not had before and a small tender spot on the fingertip"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.05,
      "end_seconds": 303.74,
      "duration_seconds": 2.69,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.1,
      "end_seconds": 346.86,
      "duration_seconds": 29.76,
      "text": "So, based on the history and the examination, it points towards possible infection of the heart valve causing back and general symptoms. Let's book blood cultures to look into possible endocarditis. I'd like to arrange an echocardiogram for new murmur. This is not an ordinary back strain, so I want tests today. Do get help quickly if the symptoms get worse. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.57,
      "end_seconds": 351.16,
      "duration_seconds": 3.59,
      "text": "Actually, no, that's all. Thanks a lot."
    }
  ]
}