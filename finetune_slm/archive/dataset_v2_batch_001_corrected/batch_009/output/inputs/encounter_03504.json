{
  "schema_version": "1.0",
  "encounter_id": "03504",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.79,
      "duration_seconds": 3.49,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.86,
      "end_seconds": 12.12,
      "duration_seconds": 4.26,
      "text": "Okay, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 21.11,
      "duration_seconds": 8.29,
      "text": "It's tingling in my feet. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.91,
      "end_seconds": 25.18,
      "duration_seconds": 3.27,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.22,
      "end_seconds": 29.14,
      "duration_seconds": 2.92,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.96,
      "end_seconds": 35.55,
      "duration_seconds": 5.59,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.87,
      "end_seconds": 48.27,
      "duration_seconds": 11.4,
      "text": "It happens all the time. I'd say moderate. There's mild bloating as well. With mild bloating, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.31,
      "end_seconds": 53.88,
      "duration_seconds": 3.57,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.81,
      "end_seconds": 70.45,
      "duration_seconds": 2.64,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.83,
      "end_seconds": 88.62,
      "duration_seconds": 7.79,
      "text": "Okay: pulse 82, temperature 36.5, oxygen saturation is 98 percent, BP is 115 over 68."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.1,
      "end_seconds": 91.59,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.04,
      "end_seconds": 95.48,
      "duration_seconds": 2.44,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.28,
      "end_seconds": 101.88,
      "duration_seconds": 4.6,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.82,
      "end_seconds": 106.09,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.95,
      "end_seconds": 126.62,
      "duration_seconds": 6.67,
      "text": "The feeling in your feet is reduced and your balance with the eyes closed is poor."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.27,
      "end_seconds": 136.42,
      "duration_seconds": 6.15,
      "text": "That's the examination finished. Have you had any weight loss, bladder problems or back pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.7,
      "end_seconds": 146.22,
      "duration_seconds": 5.52,
      "text": "No weight loss, bladder problems or back pain, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.53,
      "end_seconds": 151.63,
      "duration_seconds": 4.1,
      "text": "Alright, have you had diarrhoea, by any chance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.12,
      "end_seconds": 154.82,
      "duration_seconds": 1.7,
      "text": "No diarrhoea, thankfully."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 158.67,
      "duration_seconds": 2.35,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.03,
      "end_seconds": 160.97,
      "duration_seconds": 0.94,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.83,
      "end_seconds": 166.36,
      "duration_seconds": 3.53,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.25,
      "end_seconds": 170.34,
      "duration_seconds": 2.09,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.36,
      "end_seconds": 173.6,
      "duration_seconds": 2.24,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.76,
      "end_seconds": 184.09,
      "duration_seconds": 4.33,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.09,
      "end_seconds": 194.25,
      "duration_seconds": 2.16,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.4,
      "end_seconds": 203.39,
      "duration_seconds": 7.99,
      "text": "I have anxiety, for nearly five years. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.1,
      "end_seconds": 212.97,
      "duration_seconds": 8.87,
      "text": "Yes, anxiety is known to us, good to have that clear. So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.81,
      "end_seconds": 226.54,
      "duration_seconds": 12.73,
      "text": "I quit smoking around ten years ago. My partner and our baby. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.24,
      "end_seconds": 246.43,
      "duration_seconds": 2.19,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.04,
      "end_seconds": 252.15,
      "duration_seconds": 5.11,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.86,
      "end_seconds": 257.97,
      "duration_seconds": 4.11,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.05,
      "end_seconds": 264.86,
      "duration_seconds": 3.81,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.75,
      "end_seconds": 280.84,
      "duration_seconds": 14.09,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be a possible gut-related cause of nerve symptoms, or it might be a vitamin B12 deficiency."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.32,
      "end_seconds": 298.37,
      "duration_seconds": 4.05,
      "text": "I'd like to arrange a coeliac blood test for neuropathy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 300.02,
      "end_seconds": 304.55,
      "duration_seconds": 4.53,
      "text": "We have a slot Wednesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.58,
      "end_seconds": 309.02,
      "duration_seconds": 2.44,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.84,
      "end_seconds": 329.22,
      "duration_seconds": 18.38,
      "text": "Please keep eating gluten normally until the coeliac test is done. If it hasn't settled in a month, we'd think about a B12 level, but not now. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.57,
      "end_seconds": 332.13,
      "duration_seconds": 1.56,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.41,
      "end_seconds": 335.51,
      "duration_seconds": 2.1,
      "text": "Come back after the results."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.13,
      "end_seconds": 339.12,
      "duration_seconds": 1.99,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.34,
      "end_seconds": 346.58,
      "duration_seconds": 6.24,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.38,
      "end_seconds": 353.0,
      "duration_seconds": 5.62,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.32,
      "end_seconds": 358.58,
      "duration_seconds": 4.26,
      "text": "Alright, yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.1,
      "end_seconds": 366.38,
      "duration_seconds": 3.28,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.26,
      "end_seconds": 368.69,
      "duration_seconds": 1.43,
      "text": "Take care now."
    }
  ]
}