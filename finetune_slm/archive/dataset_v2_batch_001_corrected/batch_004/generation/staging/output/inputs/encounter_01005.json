{
  "schema_version": "1.0",
  "encounter_id": "01005",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 10.67,
      "duration_seconds": 9.44,
      "text": "Good morning. Before we start, Mr Mehta, or Arjun, or what would you like me to call you? ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 22.75,
      "duration_seconds": 9.85,
      "text": "Arjun is fine, sir. Doctor. And this is my mother, she insisted, because the academy sent a letter. ~"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.69,
      "end_seconds": 39.31,
      "duration_seconds": 14.62,
      "text": "The ECG at the football academy was abnormal, doctor, they said I must see a heart doctor before he trains again, I haven't slept."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.83,
      "end_seconds": 50.15,
      "duration_seconds": 8.32,
      "text": "I understand, that letter would worry any parent. Arjun, tell me what you've noticed. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.8,
      "end_seconds": 60.29,
      "duration_seconds": 8.49,
      "text": "A bit dizzy, sometimes, after training. I have to sit down for a minute."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.66,
      "end_seconds": 65.29,
      "duration_seconds": 2.63,
      "text": "When did that start?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.79,
      "end_seconds": 69.21,
      "duration_seconds": 2.42,
      "text": "About a month ago."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.04,
      "end_seconds": 78.16,
      "duration_seconds": 6.12,
      "text": "Since March, doctor. That's three months. He didn't tell me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.59,
      "end_seconds": 86.17,
      "duration_seconds": 5.58,
      "text": "Between one and three months, then. Anything else after training?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.86,
      "end_seconds": 94.49,
      "duration_seconds": 5.63,
      "text": "My heart races. Like it's beating in my throat."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.59,
      "end_seconds": 99.45,
      "duration_seconds": 2.86,
      "text": "Does it settle quickly? ~"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.81,
      "end_seconds": 104.72,
      "duration_seconds": 2.91,
      "text": "A few minutes. ~"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.1,
      "end_seconds": 107.91,
      "duration_seconds": 1.81,
      "text": "And breath?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.41,
      "end_seconds": 116.76,
      "duration_seconds": 7.35,
      "text": "At the end of sprints I'm sort of gasping more than the others."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 119.04,
      "end_seconds": 125.37,
      "duration_seconds": 6.33,
      "text": "And he's tired all the time, doctor, he sleeps on the bus."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.7,
      "end_seconds": 129.92,
      "duration_seconds": 3.22,
      "text": "Has he had chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.8,
      "end_seconds": 133.99,
      "duration_seconds": 2.19,
      "text": "No chest pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.66,
      "end_seconds": 139.92,
      "duration_seconds": 4.26,
      "text": "Have you ever fainted or nearly fainted?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.93,
      "end_seconds": 144.21,
      "duration_seconds": 2.28,
      "text": "No, never fainted."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.26,
      "end_seconds": 150.56,
      "duration_seconds": 4.3,
      "text": "Any blackouts at all, loss of memory?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.66,
      "end_seconds": 154.61,
      "duration_seconds": 1.95,
      "text": "No blackouts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.33,
      "end_seconds": 160.24,
      "duration_seconds": 2.91,
      "text": "Any breathlessness at rest?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.53,
      "end_seconds": 165.49,
      "duration_seconds": 3.96,
      "text": "No, only when I'm pushing hard."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.16,
      "end_seconds": 171.2,
      "duration_seconds": 3.04,
      "text": "Any swelling in your legs?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.42,
      "end_seconds": 175.18,
      "duration_seconds": 1.76,
      "text": "No swelling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.3,
      "end_seconds": 179.53,
      "duration_seconds": 3.23,
      "text": "What do you take, Arjun?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.82,
      "end_seconds": 195.16,
      "duration_seconds": 13.34,
      "text": "Ibuprofen, 400 mg, after matches, if my knee aches. And a protein powder, I buy it online, I can't remember the brand, it's the green tub."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.45,
      "end_seconds": 201.79,
      "duration_seconds": 5.34,
      "text": "We'll look at the tub next time. Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.21,
      "end_seconds": 215.24,
      "duration_seconds": 11.03,
      "text": "Wasp stings. I'm meant to be allergic. But I don't know what actually happened, I was a baby."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 217.31,
      "end_seconds": 221.86,
      "duration_seconds": 4.55,
      "text": "Nobody told us the details either. ~"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.78,
      "end_seconds": 229.4,
      "duration_seconds": 4.62,
      "text": "I'll note wasp stings, reaction unknown. Medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.1,
      "end_seconds": 237.45,
      "duration_seconds": 5.35,
      "text": "Asthma as a child. Hay fever. And low iron once."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 241.38,
      "duration_seconds": 2.05,
      "text": "Any operations?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.28,
      "end_seconds": 249.68,
      "duration_seconds": 5.4,
      "text": "A knee scope on the left, when I was seventeen."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.69,
      "end_seconds": 256.86,
      "duration_seconds": 5.17,
      "text": "Any heart problems or sudden deaths in the family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 257.76,
      "end_seconds": 264.87,
      "duration_seconds": 7.11,
      "text": "My father's father had a heart attack at fifty. That's all we know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.34,
      "end_seconds": 295.01,
      "duration_seconds": 12.67,
      "text": "Let me check you. Pulse 48, blood pressure 118 over 70, temperature 36.5, oxygen 99 percent, breathing 12, weight 74 kilos."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 295.72,
      "end_seconds": 298.88,
      "duration_seconds": 3.16,
      "text": "Forty-eight? Is that dangerous? ~"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.56,
      "end_seconds": 318.96,
      "duration_seconds": 8.4,
      "text": "In a trained athlete it can be normal. Let me listen to his heart."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.88,
      "end_seconds": 324.35,
      "duration_seconds": 4.47,
      "text": "Do I take my shirt off? ~"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.92,
      "end_seconds": 332.49,
      "duration_seconds": 6.57,
      "text": "Please. Heart sounds are normal, and the rhythm is regular, though slow."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 333.42,
      "end_seconds": 335.01,
      "duration_seconds": 1.59,
      "text": "Slow? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.83,
      "end_seconds": 347.01,
      "duration_seconds": 9.18,
      "text": "And I can hear a soft murmur, the sort that is often harmless in people who are fit."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.88,
      "end_seconds": 351.64,
      "duration_seconds": 1.76,
      "text": "A murmur? ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.79,
      "end_seconds": 357.56,
      "duration_seconds": 3.77,
      "text": "Any wheeze at the moment, Arjun?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.42,
      "end_seconds": 360.27,
      "duration_seconds": 1.85,
      "text": "No, nothing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.69,
      "end_seconds": 368.74,
      "duration_seconds": 6.05,
      "text": "Any weakness or numbness in your arms or legs?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.62,
      "end_seconds": 374.58,
      "duration_seconds": 2.96,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.89,
      "end_seconds": 394.4,
      "duration_seconds": 17.51,
      "text": "Here is my thinking. The slow pulse and the ECG pattern are very often athlete's heart, a normal adaptation to training. I think that is the most likely explanation."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 396.68,
      "end_seconds": 399.15,
      "duration_seconds": 2.47,
      "text": "Most likely? ~"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.13,
      "end_seconds": 415.84,
      "duration_seconds": 14.71,
      "text": "Yes, but some conditions can look the same on an ECG, and with the dizziness, I won't take chances. For now, no hard training until a sports cardiologist has seen him."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 416.63,
      "end_seconds": 418.65,
      "duration_seconds": 2.02,
      "text": "How long? ~"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.26,
      "end_seconds": 430.94,
      "duration_seconds": 10.68,
      "text": "I'll write to the cardiologist today and ask for the earliest appointment. They'll decide what's needed. ~"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 433.53,
      "end_seconds": 435.99,
      "duration_seconds": 2.46,
      "text": "Thank God. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.21,
      "end_seconds": 448.15,
      "duration_seconds": 9.94,
      "text": "Walking and gentle jogging are fine. If he faints or has chest pain, go to the emergency department at once."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 450.21,
      "end_seconds": 452.26,
      "duration_seconds": 2.05,
      "text": "We will. ~"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.64,
      "end_seconds": 461.59,
      "duration_seconds": 6.95,
      "text": "I'd like to see you again in two weeks, whatever the cardiologist says."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 464.46,
      "end_seconds": 467.3,
      "duration_seconds": 2.84,
      "text": "Two weeks. Thanks, doctor. ~"
    }
  ]
}
