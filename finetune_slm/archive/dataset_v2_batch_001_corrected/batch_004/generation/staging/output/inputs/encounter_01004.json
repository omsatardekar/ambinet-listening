{
  "schema_version": "1.0",
  "encounter_id": "01004",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 7.06,
      "duration_seconds": 6.46,
      "text": "My tummy hurts. Every day. Well, not every day. Mostly school days."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.38,
      "end_seconds": 21.21,
      "duration_seconds": 11.83,
      "text": "Hi, doctor, I'm Dana, Leo's mum. It's been about a month, and it's always before school, he's fine at the weekend."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.44,
      "end_seconds": 37.88,
      "duration_seconds": 15.44,
      "text": "Hey Leo. Imagine your tummy and your brain share one phone line. When the brain is busy, the tummy picks up the call. Does that sound silly? ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.73,
      "end_seconds": 43.42,
      "duration_seconds": 3.69,
      "text": "A bit. But kind of true. ~"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.76,
      "end_seconds": 49.36,
      "duration_seconds": 4.6,
      "text": "Where on your tummy does it hurt?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.11,
      "end_seconds": 57.16,
      "duration_seconds": 5.05,
      "text": "Here. Around the middle. Or maybe lower. It moves."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.73,
      "end_seconds": 61.96,
      "duration_seconds": 3.23,
      "text": "Do you feel sick?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.72,
      "end_seconds": 68.45,
      "duration_seconds": 3.73,
      "text": "Yeah. Not sick sick. Sort of sick."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 70.64,
      "end_seconds": 74.46,
      "duration_seconds": 3.82,
      "text": "He's never actually thrown up."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.21,
      "end_seconds": 79.89,
      "duration_seconds": 2.68,
      "text": "Mum, you're saying no vomiting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 80.66,
      "end_seconds": 82.44,
      "duration_seconds": 1.78,
      "text": "Right, no vomiting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.31,
      "end_seconds": 84.92,
      "duration_seconds": 1.61,
      "text": "Any fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 85.77,
      "end_seconds": 87.63,
      "duration_seconds": 1.86,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.42,
      "end_seconds": 91.33,
      "duration_seconds": 2.91,
      "text": "Any blood in his poo?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 93.71,
      "end_seconds": 96.25,
      "duration_seconds": 2.54,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.25,
      "end_seconds": 102.95,
      "duration_seconds": 3.7,
      "text": "Leo, do you get headaches too?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.63,
      "end_seconds": 110.71,
      "duration_seconds": 6.08,
      "text": "Sometimes. No, wait, yes. A lot. In the afternoon."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.5,
      "end_seconds": 114.06,
      "duration_seconds": 2.56,
      "text": "And are you tired?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.73,
      "end_seconds": 120.12,
      "duration_seconds": 4.39,
      "text": "Not really. Okay, a bit, after football."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.86,
      "end_seconds": 127.7,
      "duration_seconds": 4.84,
      "text": "Is there anything about school that's on your mind?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.56,
      "end_seconds": 137.11,
      "duration_seconds": 6.55,
      "text": "No. Well. Maths, with the timed tests. They make my tummy go funny."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 139.48,
      "end_seconds": 147.15,
      "duration_seconds": 7.67,
      "text": "He said that to me in the car for the first time this morning. ~"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.91,
      "end_seconds": 154.98,
      "duration_seconds": 7.07,
      "text": "Thank you for telling me, Leo. Mum, what is he taking at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 156.84,
      "end_seconds": 170.55,
      "duration_seconds": 13.71,
      "text": "1 sachet of Movicol, once a day, for the constipation. Cetirizine, 5 mg, in the evenings for hay fever. And vitamin D drops, 400 units, daily."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.64,
      "end_seconds": 173.24,
      "duration_seconds": 1.6,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 174.15,
      "end_seconds": 183.72,
      "duration_seconds": 9.57,
      "text": "Maybe nuts. At nursery, he came up in a rash after a snack. They never worked out which one."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.23,
      "end_seconds": 191.72,
      "duration_seconds": 5.49,
      "text": "I'll note that as possible and unconfirmed. Any other history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 194.6,
      "end_seconds": 200.5,
      "duration_seconds": 5.9,
      "text": "The constipation, the hay fever, and eczema when he was little."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.28,
      "end_seconds": 206.64,
      "duration_seconds": 3.36,
      "text": "Has he had any operations?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 208.6,
      "end_seconds": 213.39,
      "duration_seconds": 4.79,
      "text": "Grommets at three. And his tonsils at six."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.36,
      "end_seconds": 221.86,
      "duration_seconds": 5.5,
      "text": "Anyone in the family get headaches or tummy troubles?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 224.7,
      "end_seconds": 228.0,
      "duration_seconds": 3.3,
      "text": "His mum, me, I get migraines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.47,
      "end_seconds": 233.19,
      "duration_seconds": 3.72,
      "text": "What year are you in, Leo?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.74,
      "end_seconds": 236.08,
      "duration_seconds": 1.34,
      "text": "Year four."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.94,
      "end_seconds": 239.72,
      "duration_seconds": 2.78,
      "text": "Do you play anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.29,
      "end_seconds": 245.68,
      "duration_seconds": 3.39,
      "text": "Football, Saturdays. I'm a goalie."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.65,
      "end_seconds": 249.42,
      "duration_seconds": 2.77,
      "text": "And who's at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.42,
      "end_seconds": 256.1,
      "duration_seconds": 4.68,
      "text": "Mum, dad and Max, my brother. He's annoying."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.92,
      "end_seconds": 263.45,
      "duration_seconds": 4.53,
      "text": "What do you drink during the day?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.47,
      "end_seconds": 267.74,
      "duration_seconds": 3.27,
      "text": "Squash. Not much water."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.67,
      "end_seconds": 286.07,
      "duration_seconds": 5.4,
      "text": "Let me check you. Temperature 36.7, pulse 88, weight 30 kilos."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 287.94,
      "end_seconds": 290.48,
      "duration_seconds": 2.54,
      "text": "Is that okay? ~"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 310.93,
      "duration_seconds": 9.41,
      "text": "Perfect. Leo, lie on the couch and I'll press your tummy. Tell me if it hurts."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.78,
      "end_seconds": 314.15,
      "duration_seconds": 1.37,
      "text": "Tickles. ~"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.03,
      "end_seconds": 323.21,
      "duration_seconds": 8.18,
      "text": "The tummy is soft and not tender anywhere, even when I press deeply."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 324.27,
      "end_seconds": 326.78,
      "duration_seconds": 2.51,
      "text": "He never flinches. ~"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.06,
      "end_seconds": 331.49,
      "duration_seconds": 3.43,
      "text": "And there's no swelling or lumps."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.24,
      "end_seconds": 336.6,
      "duration_seconds": 3.36,
      "text": "Can I get up? ~"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.36,
      "end_seconds": 341.99,
      "duration_seconds": 4.63,
      "text": "In a second. Any cough or wheeze?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 344.51,
      "end_seconds": 347.72,
      "duration_seconds": 3.21,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.9,
      "end_seconds": 351.76,
      "duration_seconds": 2.86,
      "text": "Any trouble when he wees?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 354.06,
      "end_seconds": 356.75,
      "duration_seconds": 2.69,
      "text": "No, nothing, it's all normal."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.73,
      "end_seconds": 374.61,
      "duration_seconds": 16.88,
      "text": "I'm not going to give this a name today. What I'd like to try is a plan. First, drink water, at least four glasses a day, and keep the Movicol going."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 376.52,
      "end_seconds": 378.87,
      "duration_seconds": 2.35,
      "text": "He hates water. ~"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.81,
      "end_seconds": 385.4,
      "duration_seconds": 5.59,
      "text": "I don't hate it. I just forget it. ~"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.44,
      "end_seconds": 394.31,
      "duration_seconds": 6.87,
      "text": "Put a bottle in his bag, with a sticker he picks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 395.65,
      "end_seconds": 397.94,
      "duration_seconds": 2.29,
      "text": "Good idea. ~"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.26,
      "end_seconds": 408.45,
      "duration_seconds": 8.19,
      "text": "Second, we talk to school about the timed maths tests, so Leo isn't dreading Monday mornings."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 409.75,
      "end_seconds": 413.4,
      "duration_seconds": 3.65,
      "text": "I'll email the teacher tonight. ~"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.62,
      "end_seconds": 419.97,
      "duration_seconds": 5.35,
      "text": "Third, a small breakfast, even toast, before school."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.19,
      "end_seconds": 422.63,
      "duration_seconds": 1.44,
      "text": "Okay. ~"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.47,
      "end_seconds": 434.17,
      "duration_seconds": 8.7,
      "text": "If the aches are still there after two weeks of this plan, come back and we'll look again."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 436.33,
      "end_seconds": 440.36,
      "duration_seconds": 4.03,
      "text": "Two weeks. Thank you, doctor. ~"
    }
  ]
}
