{
  "schema_version": "1.0",
  "encounter_id": "01006",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 0.45,
      "end_seconds": 6.13,
      "duration_seconds": 5.68,
      "text": "Hello, you're Mrs Doherty, and the booking says left wrist. ~"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 7.89,
      "end_seconds": 47.95,
      "duration_seconds": 40.06,
      "text": "Oh no, doctor, it's the right, I told the girl on the phone, I wrote it in the app and all, but sure, it's no matter. It's the right. It's been two weeks now, I'd say, since Aoibhe started the feeding every three hours, and honestly I'd the left one sore at the start but that's gone, and Maura here is holding the baby, that's Maura, she's a night nurse, no, a maternity carer, I always say that wrong."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 49.92,
      "end_seconds": 55.8,
      "duration_seconds": 5.88,
      "text": "Maura. Pleased to meet you, doctor. Aoibhe's three months. ~"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.54,
      "end_seconds": 63.09,
      "duration_seconds": 6.55,
      "text": "Lovely. So the right wrist, for two weeks. Where does it hurt?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.15,
      "end_seconds": 77.12,
      "duration_seconds": 12.97,
      "text": "At the thumb side. Right at the base of the thumb, and up along. It's sharp when I lift her out of the cot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 79.44,
      "duration_seconds": 1.44,
      "text": "Any swelling?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.02,
      "end_seconds": 86.58,
      "duration_seconds": 5.56,
      "text": "A bit, on that side. Like a little bump."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.62,
      "end_seconds": 93.03,
      "duration_seconds": 4.41,
      "text": "Any numbness or tingling in the fingers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.89,
      "end_seconds": 104.51,
      "duration_seconds": 8.62,
      "text": "No, no numbness. I had that in the pregnancy, in both hands, but it's gone."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.38,
      "end_seconds": 109.81,
      "duration_seconds": 3.43,
      "text": "Any knock or fall on it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.0,
      "end_seconds": 114.9,
      "duration_seconds": 2.9,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.17,
      "end_seconds": 118.43,
      "duration_seconds": 2.26,
      "text": "Any fever or redness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.15,
      "end_seconds": 120.76,
      "duration_seconds": 1.61,
      "text": "No fever."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.48,
      "end_seconds": 125.99,
      "duration_seconds": 4.51,
      "text": "What are you taking at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.81,
      "end_seconds": 140.28,
      "duration_seconds": 13.47,
      "text": "Ibuprofen, 400 mg, a few times a day. Paracetamol, 1 gram, the same. Iron tablets, ferrous sulfate, 200 mg, once a day. And vitamin D, 1000 units."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.23,
      "end_seconds": 143.99,
      "duration_seconds": 1.76,
      "text": "Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.35,
      "end_seconds": 156.88,
      "duration_seconds": 11.53,
      "text": "I've a feeling I'm allergic to something in plasters, the glue maybe, I'm not sure. I came up in a rash on my arm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.26,
      "end_seconds": 164.08,
      "duration_seconds": 5.82,
      "text": "I'll record it as possible, unconfirmed. Your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.47,
      "end_seconds": 172.37,
      "duration_seconds": 5.9,
      "text": "Anaemia after the birth. The carpal tunnel in pregnancy. And migraines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.33,
      "end_seconds": 176.28,
      "duration_seconds": 0.95,
      "text": "Operations?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.18,
      "end_seconds": 184.2,
      "duration_seconds": 6.02,
      "text": "The caesarean, three months ago. And my wisdom teeth, in 2018."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.97,
      "end_seconds": 192.46,
      "duration_seconds": 5.49,
      "text": "Anyone in the family with hand or joint trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.27,
      "end_seconds": 203.71,
      "duration_seconds": 8.44,
      "text": "My mother has arthritis in her hands. And my sister has a thyroid problem."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.25,
      "end_seconds": 222.21,
      "duration_seconds": 5.96,
      "text": "Let me check two numbers. Blood pressure 110 over 70, pulse 78."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.48,
      "end_seconds": 229.57,
      "duration_seconds": 5.09,
      "text": "Good for a woman who hasn't slept. ~"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.73,
      "end_seconds": 244.07,
      "duration_seconds": 5.34,
      "text": "Show me your hand, palm down on the table."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.93,
      "end_seconds": 248.75,
      "duration_seconds": 1.82,
      "text": "There. ~"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.69,
      "end_seconds": 257.45,
      "duration_seconds": 7.76,
      "text": "There's tenderness over the thumb side of the wrist, right along the tendon."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.12,
      "end_seconds": 262.86,
      "duration_seconds": 2.74,
      "text": "That's the spot. ~"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.13,
      "end_seconds": 270.74,
      "duration_seconds": 5.61,
      "text": "And a small firm swelling over the same tendons."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 273.72,
      "end_seconds": 278.54,
      "duration_seconds": 4.82,
      "text": "She's been favouring that hand all week. ~"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.57,
      "end_seconds": 295.96,
      "duration_seconds": 8.39,
      "text": "Now tuck your thumb in your fist and bend the wrist towards your little finger."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.43,
      "end_seconds": 301.0,
      "duration_seconds": 2.57,
      "text": "Ow! Ow, doctor. ~"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.62,
      "end_seconds": 308.41,
      "duration_seconds": 4.79,
      "text": "That reproduces the sharp pain, a classic test."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.17,
      "end_seconds": 312.37,
      "duration_seconds": 3.2,
      "text": "What does that mean? ~"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.01,
      "end_seconds": 319.55,
      "duration_seconds": 5.54,
      "text": "The wrist moves fully, though, when you're not doing that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.11,
      "end_seconds": 324.61,
      "duration_seconds": 2.5,
      "text": "It does. ~"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.47,
      "end_seconds": 342.21,
      "duration_seconds": 14.74,
      "text": "Here's what I think. This looks like irritation of the two tendons that move the thumb, common in new parents from repeated lifting. I'd call it de Quervain's tenosynovitis, provisionally."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.96,
      "end_seconds": 347.11,
      "duration_seconds": 4.15,
      "text": "Is it from lifting her? ~"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.58,
      "end_seconds": 362.44,
      "duration_seconds": 12.86,
      "text": "Lifting with the thumb out, and the feeding positions. I'd like to arrange an ultrasound of the wrist, and an X-ray to rule out other causes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 364.63,
      "end_seconds": 367.85,
      "duration_seconds": 3.22,
      "text": "Will she need a splint? ~"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.66,
      "end_seconds": 375.04,
      "duration_seconds": 6.38,
      "text": "Good thought, Maura. I'd like to arrange occupational therapy for a thumb splint."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.59,
      "end_seconds": 379.93,
      "duration_seconds": 2.34,
      "text": "And the baby? ~"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.52,
      "end_seconds": 393.16,
      "duration_seconds": 10.64,
      "text": "Lift her with both hands under her, palms up, not by the thumbs. Maura can help show you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 395.81,
      "end_seconds": 398.49,
      "duration_seconds": 2.68,
      "text": "I'll show her. ~"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.53,
      "end_seconds": 408.71,
      "duration_seconds": 8.18,
      "text": "Please carry on with the ibuprofen with food. I'd like to see you again in three weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.14,
      "end_seconds": 417.36,
      "duration_seconds": 6.22,
      "text": "Three weeks. Thanks, doctor, you've made it all sound manageable. ~"
    }
  ]
}
