  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Me, if that's okay. Ellis's older sister was diagnosed with coeliac disease in March, and since then I can't stop noticing how often Ellis complains about her stomach.",
      "start_timestamp": "00:15",
      "end_timestamp": "00:28",
      "supports": [
        "chief_complaint"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let's find out. Ellis, how long have the stomach aches been around?",
      "start_timestamp": "00:35",
      "end_timestamp": "00:40",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Since the summer holidays. About three months.",
      "start_timestamp": "00:43",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "Longer than that. It was Easter, I remember because she missed the egg hunt. That's eight months.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So somewhere between three and eight months. We don't need to settle it. What are they like?",
      "start_timestamp": "00:58",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Like a crampy feeling, around my belly button, after lunch mostly.",
      "start_timestamp": "01:10",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Anything else going on with your tummy?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I get bloated. My jeans feel tight even when I haven't eaten much.",
      "start_timestamp": "01:22",
      "end_timestamp": "01:29",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "And she's tired, she's always asleep on the sofa by seven.",
      "start_timestamp": "01:31",
      "end_timestamp": "01:37",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about your poos?",
      "start_timestamp": "01:43",
      "end_timestamp": "01:46",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Loose, sometimes. Pale. Gross.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
