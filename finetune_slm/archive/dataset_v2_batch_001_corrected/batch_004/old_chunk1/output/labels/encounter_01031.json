    {
      "evidence_id": "EV_020",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, that's enough for me. From what you've told me and what I found, I think we're dealing with seasonal hay fever causing the cough at this stage. It could also be early asthma, so we'll keep that open.",
      "start_timestamp": "04:24",
      "end_timestamp": "04:40",
