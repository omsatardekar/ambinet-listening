      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's every other day.",
      "start_timestamp": "00:30",
      "end_timestamp": "00:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What about very little urine, have you noticed that?",
      "start_timestamp": "00:34",
      "end_timestamp": "00:37",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Yes, about the same, three days.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:42",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it a lot or only a little?",
