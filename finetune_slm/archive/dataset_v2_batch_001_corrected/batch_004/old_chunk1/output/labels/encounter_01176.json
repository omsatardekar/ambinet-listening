      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I only drink at family occasions. I'm vegetarian and have been for years. My partner and our baby.",
      "start_timestamp": "03:44",
      "end_timestamp": "03:52",
      "supports": [
        "medical_history.social_history[0]",
