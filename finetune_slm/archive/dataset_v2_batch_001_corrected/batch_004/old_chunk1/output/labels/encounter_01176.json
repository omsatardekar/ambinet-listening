        "medical_history.past_medical_history[1]"
      ]
    },
    {
      "evidence_id": "EV_023",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had arthritis in my knees, yes. I told my wife I'd come today. I've never really been one for hospitals.",
