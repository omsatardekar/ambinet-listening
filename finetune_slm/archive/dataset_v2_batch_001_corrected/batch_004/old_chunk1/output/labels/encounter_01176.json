      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Moderate, really.",
      "start_timestamp": "00:48",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had shaking chills and a high temperature before, or is this the first time?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:57",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A bit, a couple of years ago. It settled by itself back then.",
      "start_timestamp": "00:59",
      "end_timestamp": "01:06",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: heart rate 97, respiratory rate 18, temp 39.3 degrees. And blood pressure 124 over 75.",
