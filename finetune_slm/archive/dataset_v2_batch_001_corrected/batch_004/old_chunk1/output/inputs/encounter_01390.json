{
  "schema_version": "1.0",
  "encounter_id": "01390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 4.77,
      "duration_seconds": 3.84,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.56,
      "end_seconds": 10.51,
      "duration_seconds": 3.95,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 14.83,
      "duration_seconds": 3.15,
      "text": "I'm here because of a severe headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.54,
      "end_seconds": 18.27,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.07,
      "end_seconds": 22.65,
      "duration_seconds": 3.58,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.17,
      "end_seconds": 25.59,
      "duration_seconds": 2.42,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.69,
      "end_seconds": 29.77,
      "duration_seconds": 3.08,
      "text": "Yes, light. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.57,
      "end_seconds": 36.35,
      "duration_seconds": 2.78,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.18,
      "end_seconds": 39.22,
      "duration_seconds": 1.04,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 43.55,
      "duration_seconds": 2.46,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.3,
      "end_seconds": 48.84,
      "duration_seconds": 3.54,
      "text": "It, It sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.63,
      "end_seconds": 54.26,
      "duration_seconds": 3.63,
      "text": "What about hating the light, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.94,
      "end_seconds": 59.33,
      "duration_seconds": 3.39,
      "text": "Yes, about the same, about two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.42,
      "end_seconds": 64.7,
      "duration_seconds": 3.28,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.95,
      "end_seconds": 75.9,
      "duration_seconds": 9.95,
      "text": "Maybe a four out of ten on a bad day. And there's a high fever as well, one week now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.78,
      "end_seconds": 81.63,
      "duration_seconds": 3.85,
      "text": "What about a stiff neck, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.47,
      "end_seconds": 86.61,
      "duration_seconds": 3.14,
      "text": "Yes, about the same, ten days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.43,
      "end_seconds": 90.24,
      "duration_seconds": 2.81,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.56,
      "end_seconds": 92.47,
      "duration_seconds": 0.91,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.27,
      "end_seconds": 108.05,
      "duration_seconds": 3.78,
      "text": "And what about cough or recent head injury?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.57,
      "end_seconds": 113.37,
      "duration_seconds": 4.8,
      "text": "No cough or recent head injury, none of it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.51,
      "end_seconds": 118.1,
      "duration_seconds": 3.59,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.54,
      "end_seconds": 122.34,
      "duration_seconds": 2.8,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.58,
      "end_seconds": 128.06,
      "duration_seconds": 4.48,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.59,
      "end_seconds": 142.26,
      "duration_seconds": 12.67,
      "text": "Hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.83,
      "end_seconds": 147.9,
      "duration_seconds": 4.07,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.54,
      "end_seconds": 152.32,
      "duration_seconds": 2.78,
      "text": "Eczema, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 165.45,
      "duration_seconds": 4.78,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.24,
      "end_seconds": 179.12,
      "duration_seconds": 12.88,
      "text": "I walk the dog every morning. I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.26,
      "end_seconds": 184.25,
      "duration_seconds": 3.99,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.44,
      "end_seconds": 193.62,
      "duration_seconds": 8.18,
      "text": "I take hydrocortisone cream, when needed. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.5,
      "end_seconds": 199.19,
      "duration_seconds": 4.69,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.05,
      "end_seconds": 212.99,
      "duration_seconds": 1.94,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.25,
      "end_seconds": 230.1,
      "duration_seconds": 3.85,
      "text": "Okay: BP is 124 over 72, heart rate 88."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.28,
      "end_seconds": 236.65,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.56,
      "end_seconds": 240.27,
      "duration_seconds": 2.71,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.82,
      "end_seconds": 247.7,
      "duration_seconds": 4.88,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.73,
      "end_seconds": 250.02,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.18,
      "end_seconds": 269.5,
      "duration_seconds": 7.32,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.66,
      "end_seconds": 275.58,
      "duration_seconds": 1.92,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.43,
      "end_seconds": 295.62,
      "duration_seconds": 7.19,
      "text": "Putting it all together, it fits best with possible bacterial meningitis. I'd also keep meningococcal septicaemia in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.49,
      "end_seconds": 299.0,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.69,
      "end_seconds": 318.51,
      "duration_seconds": 18.82,
      "text": "Nothing I've seen today points to an emergency. It looks like possible bacterial meningitis, but I'd like to confirm. So, to recap quickly. You've had a severe headache, since last weekend, mild, and no cough or recent head injury."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.92,
      "end_seconds": 324.15,
      "duration_seconds": 2.23,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.81,
      "end_seconds": 334.42,
      "duration_seconds": 9.61,
      "text": "I'm going to order blood cultures, for possible meningitis. I want a lumbar puncture done, that's for possible meningitis."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.07,
      "end_seconds": 337.34,
      "duration_seconds": 2.27,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.8,
      "end_seconds": 355.41,
      "duration_seconds": 16.61,
      "text": "We'll begin with benzylpenicillin, 1.2 grams, once now, single dose. That's for possible meningitis. Call an ambulance now, this is an emergency. See me again straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.73,
      "end_seconds": 359.9,
      "duration_seconds": 3.17,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}