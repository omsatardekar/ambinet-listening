{
  "schema_version": "1.0",
  "encounter_id": "01070",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 6.2,
      "duration_seconds": 5.06,
      "text": "Well, you know, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 10.36,
      "duration_seconds": 3.63,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.27,
      "end_seconds": 17.88,
      "duration_seconds": 5.61,
      "text": "Hmm, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.89,
      "end_seconds": 29.36,
      "duration_seconds": 10.47,
      "text": "So, um, I've been wanting contraception, doctor. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.33,
      "end_seconds": 35.18,
      "duration_seconds": 3.85,
      "text": "Okay, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.26,
      "end_seconds": 41.9,
      "duration_seconds": 5.64,
      "text": "Um, I've had it since yesterday. Oh, and slightly heavy periods."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.19,
      "end_seconds": 56.2,
      "duration_seconds": 4.01,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.37,
      "end_seconds": 64.92,
      "duration_seconds": 2.55,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.42,
      "end_seconds": 84.99,
      "duration_seconds": 7.57,
      "text": "Okay: blood pressure 113 over 77, pulse is 67 beats a minute, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.75,
      "end_seconds": 91.53,
      "duration_seconds": 4.78,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.65,
      "end_seconds": 94.0,
      "duration_seconds": 1.35,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.24,
      "end_seconds": 104.27,
      "duration_seconds": 2.03,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.25,
      "end_seconds": 110.1,
      "duration_seconds": 2.85,
      "text": "Okay, you can sit up now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.64,
      "end_seconds": 121.98,
      "duration_seconds": 3.34,
      "text": "And what about breast lumps or smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.06,
      "end_seconds": 125.52,
      "duration_seconds": 2.46,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.5,
      "end_seconds": 129.54,
      "duration_seconds": 2.04,
      "text": "What about migraine with aura?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.05,
      "end_seconds": 138.71,
      "duration_seconds": 4.66,
      "text": "Not that I've noticed, no migraine with aura."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.0,
      "end_seconds": 143.32,
      "duration_seconds": 4.32,
      "text": "Understood. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.95,
      "end_seconds": 146.59,
      "duration_seconds": 1.64,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.85,
      "end_seconds": 150.36,
      "duration_seconds": 2.51,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.65,
      "end_seconds": 154.63,
      "duration_seconds": 2.98,
      "text": "Well, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.6,
      "end_seconds": 160.06,
      "duration_seconds": 3.46,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.87,
      "end_seconds": 169.24,
      "duration_seconds": 7.37,
      "text": "I'm on paracetamol, 650 milligrams, when needed. So, it's simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.56,
      "end_seconds": 188.26,
      "duration_seconds": 2.7,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.83,
      "end_seconds": 204.69,
      "duration_seconds": 11.86,
      "text": "No, I share a house with my brother. I walk the dog every morning. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.98,
      "end_seconds": 208.33,
      "duration_seconds": 2.35,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.37,
      "end_seconds": 215.73,
      "duration_seconds": 6.36,
      "text": "Uh, I've had arthritis in my knees, yes. Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.63,
      "end_seconds": 226.87,
      "duration_seconds": 9.24,
      "text": "Understood. Right, so high cholesterol is already on your record. We'll keep that in mind today. Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.12,
      "end_seconds": 231.96,
      "duration_seconds": 3.84,
      "text": "Okay, so no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.06,
      "end_seconds": 245.86,
      "duration_seconds": 9.8,
      "text": "From what you've told me and what I found, I'd lean towards suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.54,
      "end_seconds": 249.72,
      "duration_seconds": 2.18,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.24,
      "end_seconds": 281.73,
      "duration_seconds": 31.49,
      "text": "Nothing I've seen today points to an emergency. It looks like suitable for hormonal contraception with no risk factors. I'll start you on levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. It's for contraception. Take the pill at the same time each day and use condoms if you miss two. One warning sign to remember: you get leg swelling or severe headaches. In that case don't wait."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.49,
      "end_seconds": 284.26,
      "duration_seconds": 1.77,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.19,
      "end_seconds": 291.35,
      "duration_seconds": 6.16,
      "text": "Let's plan a check in three months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.91,
      "end_seconds": 299.2,
      "duration_seconds": 4.29,
      "text": "Erm, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.16,
      "end_seconds": 301.48,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}