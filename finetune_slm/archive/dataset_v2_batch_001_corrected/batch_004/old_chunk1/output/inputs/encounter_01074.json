{
  "schema_version": "1.0",
  "encounter_id": "01074",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 9.03,
      "duration_seconds": 8.51,
      "text": "Hello doctor, uh, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.64,
      "end_seconds": 15.06,
      "duration_seconds": 5.42,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.41,
      "end_seconds": 25.25,
      "duration_seconds": 8.84,
      "text": "Yeah, it's a red hot swelling on my leg. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.68,
      "end_seconds": 32.81,
      "duration_seconds": 2.13,
      "text": "Right, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.52,
      "end_seconds": 40.91,
      "duration_seconds": 4.39,
      "text": "Yeah, you know, for five days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.87,
      "end_seconds": 46.77,
      "duration_seconds": 3.9,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.92,
      "end_seconds": 53.65,
      "duration_seconds": 1.73,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.22,
      "end_seconds": 57.94,
      "duration_seconds": 2.72,
      "text": "Right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.68,
      "end_seconds": 78.26,
      "duration_seconds": 19.58,
      "text": "It usually comes with a high fever. Sorry, you know, what was I saying, the high fever? That's been for about four days. Oh, um, and dark blisters. That's been about the same, ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 87.21,
      "duration_seconds": 3.66,
      "text": "A few quick ones: insect bite or cut?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.89,
      "end_seconds": 94.01,
      "duration_seconds": 5.12,
      "text": "Ah, no insect bite or cut, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.38,
      "end_seconds": 98.62,
      "duration_seconds": 4.24,
      "text": "Mm-hmm. How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.27,
      "end_seconds": 103.15,
      "duration_seconds": 2.88,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.28,
      "end_seconds": 119.12,
      "duration_seconds": 2.84,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 121.19,
      "duration_seconds": 1.52,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.8,
      "end_seconds": 123.62,
      "duration_seconds": 0.82,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.63,
      "end_seconds": 127.39,
      "duration_seconds": 2.76,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.84,
      "end_seconds": 133.15,
      "duration_seconds": 1.31,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.66,
      "end_seconds": 135.41,
      "duration_seconds": 1.75,
      "text": "Alright, what about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.21,
      "end_seconds": 139.51,
      "duration_seconds": 3.3,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.48,
      "end_seconds": 141.35,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.22,
      "end_seconds": 145.8,
      "duration_seconds": 2.58,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.88,
      "end_seconds": 149.91,
      "duration_seconds": 3.03,
      "text": "Okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.11,
      "end_seconds": 155.38,
      "duration_seconds": 4.27,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.03,
      "end_seconds": 159.09,
      "duration_seconds": 2.06,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.02,
      "end_seconds": 167.49,
      "duration_seconds": 4.47,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.23,
      "end_seconds": 182.63,
      "duration_seconds": 2.4,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.54,
      "end_seconds": 185.12,
      "duration_seconds": 1.58,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 189.98,
      "duration_seconds": 3.5,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.34,
      "end_seconds": 195.59,
      "duration_seconds": 4.25,
      "text": "Yes, naproxen, it gives me a rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.91,
      "end_seconds": 202.28,
      "duration_seconds": 2.37,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.59,
      "end_seconds": 210.29,
      "duration_seconds": 6.7,
      "text": "Hmm, yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.13,
      "end_seconds": 230.54,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.17,
      "end_seconds": 243.73,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.12,
      "end_seconds": 262.21,
      "duration_seconds": 9.09,
      "text": "Okay: respiratory rate 19, pulse is 95 beats a minute, temp 38.3 degrees. And pressure 113 over 72."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.13,
      "end_seconds": 266.71,
      "duration_seconds": 2.58,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.55,
      "end_seconds": 270.18,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.15,
      "end_seconds": 287.99,
      "duration_seconds": 6.84,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.62,
      "end_seconds": 306.53,
      "duration_seconds": 15.91,
      "text": "That's all I needed to check. Okay, thinking it through, the most likely explanation is a severe deep skin infection needing urgent surgery review. Let's get urgent blood tests, for severe skin infection."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 307.26,
      "end_seconds": 311.12,
      "duration_seconds": 3.86,
      "text": "I can book that for Thursday at 3:30 pm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.63,
      "end_seconds": 315.38,
      "duration_seconds": 2.75,
      "text": "Thursday, that works for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.11,
      "end_seconds": 321.79,
      "duration_seconds": 5.68,
      "text": "Let's book an urgent surgical review to look into possible necrotising infection."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.84,
      "end_seconds": 325.11,
      "duration_seconds": 2.27,
      "text": "Mm, you know, alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.98,
      "end_seconds": 336.92,
      "duration_seconds": 9.94,
      "text": "I am sending you to hospital now, do not wait. Please don't wait if you cannot go now. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.13,
      "end_seconds": 341.99,
      "duration_seconds": 3.86,
      "text": "I, I know what to watch for."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.63,
      "end_seconds": 349.42,
      "duration_seconds": 6.79,
      "text": "Let's review you straight away. So, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.46,
      "end_seconds": 356.12,
      "duration_seconds": 3.66,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.85,
      "end_seconds": 358.08,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
