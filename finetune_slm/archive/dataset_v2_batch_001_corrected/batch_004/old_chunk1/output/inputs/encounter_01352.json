{
  "schema_version": "1.0",
  "encounter_id": "01352",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 7.11,
      "duration_seconds": 6.59,
      "text": "Uh, uh, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.93,
      "end_seconds": 13.36,
      "duration_seconds": 4.43,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.36,
      "end_seconds": 27.97,
      "duration_seconds": 13.61,
      "text": "Mainly shoulder tip pain. There's a couple of other things, but that's the main one. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.94,
      "end_seconds": 32.69,
      "duration_seconds": 3.75,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.66,
      "end_seconds": 41.95,
      "duration_seconds": 8.29,
      "text": "It's been one week, I'm fairly sure. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.51,
      "end_seconds": 47.76,
      "duration_seconds": 5.25,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.62,
      "end_seconds": 72.21,
      "duration_seconds": 22.59,
      "text": "Erm, it comes and goes. Mild, really. I've never really been one for hospitals. I just want to get back to normal, really. And there's sharp pain low on one side as well, six months now. I've, I've been feeling faint too, since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.62,
      "end_seconds": 87.12,
      "duration_seconds": 2.5,
      "text": "So, any surgery in the past?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.2,
      "end_seconds": 92.49,
      "duration_seconds": 4.29,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.18,
      "end_seconds": 94.05,
      "duration_seconds": 0.87,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.78,
      "end_seconds": 99.65,
      "duration_seconds": 3.87,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.43,
      "end_seconds": 103.65,
      "duration_seconds": 3.22,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.94,
      "end_seconds": 108.14,
      "duration_seconds": 3.2,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.81,
      "end_seconds": 113.93,
      "duration_seconds": 4.12,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.31,
      "end_seconds": 118.73,
      "duration_seconds": 3.42,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.79,
      "end_seconds": 122.48,
      "duration_seconds": 1.69,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.25,
      "end_seconds": 127.55,
      "duration_seconds": 3.3,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.31,
      "end_seconds": 131.38,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.35,
      "end_seconds": 134.98,
      "duration_seconds": 1.63,
      "text": "I have epilepsy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.92,
      "end_seconds": 138.46,
      "duration_seconds": 1.54,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.11,
      "end_seconds": 144.02,
      "duration_seconds": 1.91,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.81,
      "end_seconds": 147.51,
      "duration_seconds": 2.7,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.93,
      "end_seconds": 158.19,
      "duration_seconds": 7.26,
      "text": "Sorry, what was I saying, yes, diabetes. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.21,
      "end_seconds": 169.39,
      "duration_seconds": 9.18,
      "text": "Alright, epilepsy and an underactive thyroid, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.82,
      "end_seconds": 187.3,
      "duration_seconds": 16.48,
      "text": "It's carbamazepine, 200 milligrams, twice a day for the seizures. I'm on Thyronorm, 50 micrograms, every morning for my thyroid. Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.97,
      "end_seconds": 192.48,
      "duration_seconds": 4.51,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.2,
      "end_seconds": 196.73,
      "duration_seconds": 2.53,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.87,
      "end_seconds": 201.17,
      "duration_seconds": 3.3,
      "text": "So, and what about vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.84,
      "end_seconds": 205.39,
      "duration_seconds": 2.55,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.36,
      "end_seconds": 209.21,
      "duration_seconds": 2.85,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.83,
      "end_seconds": 211.53,
      "duration_seconds": 1.7,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.91,
      "end_seconds": 215.22,
      "duration_seconds": 2.31,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.79,
      "end_seconds": 218.6,
      "duration_seconds": 2.81,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.76,
      "end_seconds": 223.11,
      "duration_seconds": 3.35,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.38,
      "end_seconds": 238.92,
      "duration_seconds": 2.54,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.54,
      "end_seconds": 260.96,
      "duration_seconds": 8.42,
      "text": "Okay: BP is 113 over 85, heart rate 117. And temp 36.8 degrees, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.61,
      "end_seconds": 264.56,
      "duration_seconds": 1.95,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 268.59,
      "duration_seconds": 2.33,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.89,
      "end_seconds": 292.12,
      "duration_seconds": 5.23,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.92,
      "end_seconds": 299.84,
      "duration_seconds": 1.92,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.73,
      "end_seconds": 322.53,
      "duration_seconds": 5.8,
      "text": "Okay, thinking it through, the most likely explanation is a possible ectopic pregnancy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.19,
      "end_seconds": 327.18,
      "duration_seconds": 2.99,
      "text": "Yeah, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.05,
      "end_seconds": 340.69,
      "duration_seconds": 11.64,
      "text": "I understand the worry. At the moment I'd say it's a possible ectopic pregnancy, and we'll know more once the a pregnancy test is back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.24,
      "end_seconds": 361.53,
      "duration_seconds": 6.29,
      "text": "A pregnancy test is what I'd like next, for pelvic pain and bleeding."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 362.98,
      "end_seconds": 365.79,
      "duration_seconds": 2.81,
      "text": "The earliest is Monday, 2 pm."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.63,
      "end_seconds": 386.83,
      "duration_seconds": 20.2,
      "text": "You need to go to the hospital now for an emergency scan. The thing that would worry me is if the pain gets worse or you faint. If that happens, go to emergency. See me again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.49,
      "end_seconds": 389.45,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    }
  ]
}