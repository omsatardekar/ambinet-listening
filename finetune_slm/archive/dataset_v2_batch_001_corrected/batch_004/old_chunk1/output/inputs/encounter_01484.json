  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 2.83,
      "duration_seconds": 2.07,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.47,
      "end_seconds": 7.96,
      "duration_seconds": 3.49,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.97,
      "end_seconds": 13.07,
      "duration_seconds": 4.1,
      "text": "Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.9,
      "end_seconds": 19.94,
      "duration_seconds": 5.04,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.74,
      "end_seconds": 23.36,
      "duration_seconds": 1.62,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.38,
      "end_seconds": 31.55,
      "duration_seconds": 7.17,
      "text": "Honestly, it's severe lower back pain, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.16,
      "end_seconds": 35.66,
      "duration_seconds": 3.5,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.79,
      "end_seconds": 39.44,
      "duration_seconds": 2.65,
      "text": "It's been six months now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.49,
      "end_seconds": 44.34,
      "duration_seconds": 3.85,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.94,
      "end_seconds": 58.39,
      "duration_seconds": 12.45,
      "text": "I'd say mild. I've also had numbness between my legs, for about a week. With numbness between my legs, it happens on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.13,
      "end_seconds": 62.97,
      "duration_seconds": 2.84,
      "text": "Has there been trouble passing urine too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.05,
      "end_seconds": 73.03,
      "duration_seconds": 8.98,
      "text": "Ah, yeah. About a month, I'd say. With trouble passing urine, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.8,
      "end_seconds": 76.88,
      "duration_seconds": 3.08,
      "text": "Any recent fall or fever at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.33,
      "end_seconds": 82.4,
      "duration_seconds": 4.07,
      "text": "No recent fall or fever, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.85,
      "end_seconds": 87.12,
      "duration_seconds": 3.27,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.1,
      "end_seconds": 90.1,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.21,
      "end_seconds": 93.93,
      "duration_seconds": 2.72,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.5,
      "end_seconds": 97.1,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.09,
      "end_seconds": 110.97,
      "duration_seconds": 2.88,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.57,
      "end_seconds": 124.72,
      "duration_seconds": 13.15,
      "text": "I only drink at family occasions. No, I share a house with my brother. I swim twice a week. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.46,
      "end_seconds": 129.33,
      "duration_seconds": 2.87,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.34,
      "end_seconds": 135.78,
      "duration_seconds": 2.44,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.57,
      "end_seconds": 139.38,
      "duration_seconds": 2.81,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.44,
      "end_seconds": 142.73,
      "duration_seconds": 2.29,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.97,
      "end_seconds": 162.23,
      "duration_seconds": 4.26,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.16,
      "end_seconds": 165.52,
      "duration_seconds": 2.36,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.81,
      "end_seconds": 171.96,
      "duration_seconds": 5.15,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.41,
      "end_seconds": 178.79,
      "duration_seconds": 3.38,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.92,
      "end_seconds": 182.7,
      "duration_seconds": 2.78,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.12,
      "end_seconds": 197.87,
      "duration_seconds": 2.75,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.91,
      "end_seconds": 218.28,
      "duration_seconds": 11.37,
      "text": "Okay: weight 86 kilos, height 156 centimetres, BMI works out to 35.3. And respiratory rate 17, BP is 122 over 70, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.33,
      "end_seconds": 222.46,
      "duration_seconds": 2.13,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.56,
      "end_seconds": 226.72,
      "duration_seconds": 1.16,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.3,
      "end_seconds": 230.27,
      "duration_seconds": 1.97,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.16,
      "end_seconds": 255.29,
      "duration_seconds": 6.13,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.25,
      "end_seconds": 272.78,
      "duration_seconds": 13.53,
      "text": "Good, you can sit up again. Let me tell you where I've got to. This looks most like possible cauda equina syndrome needing an urgent scan. We shouldn't forget a large disc prolapse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.8,
      "end_seconds": 300.25,
      "duration_seconds": 17.45,
      "text": "I'm sending you for an urgent MRI of the spine because of possible cauda equina. You need to go to hospital now for an emergency scan. Let's get you seen by the spinal team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.1,
      "end_seconds": 301.8,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.69,
      "end_seconds": 307.68,
      "duration_seconds": 4.99,
      "text": "If the numbness spreads, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.83,
      "end_seconds": 311.04,
      "duration_seconds": 2.21,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.61,
      "end_seconds": 313.63,
      "duration_seconds": 2.02,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.52,
      "end_seconds": 319.28,
      "duration_seconds": 3.76,
      "text": "Oh, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.34,
      "end_seconds": 326.61,
      "duration_seconds": 5.27,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.36,
      "end_seconds": 330.71,
      "duration_seconds": 2.35,
      "text": "Thank you, that's helpful."
    }
  ]
