{
  "schema_version": "1.0",
  "encounter_id": "01441",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 3.69,
      "duration_seconds": 2.97,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.23,
      "end_seconds": 11.88,
      "duration_seconds": 3.65,
      "text": "Well, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.65,
      "end_seconds": 18.16,
      "duration_seconds": 4.51,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.08,
      "end_seconds": 26.76,
      "duration_seconds": 6.68,
      "text": "Of course, please stay. It's helpful to have you here. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.78,
      "end_seconds": 33.92,
      "duration_seconds": 5.14,
      "text": "Well, I've been having sharp pain low on one side."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.18,
      "end_seconds": 41.18,
      "duration_seconds": 3.0,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.97,
      "end_seconds": 46.34,
      "duration_seconds": 4.37,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.98,
      "end_seconds": 52.66,
      "duration_seconds": 2.68,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.02,
      "end_seconds": 59.3,
      "duration_seconds": 5.28,
      "text": "Shoulder tip pain goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.97,
      "end_seconds": 67.26,
      "duration_seconds": 7.29,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 67.36,
      "end_seconds": 72.33,
      "duration_seconds": 4.97,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.18,
      "end_seconds": 75.81,
      "duration_seconds": 2.63,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.34,
      "end_seconds": 79.25,
      "duration_seconds": 2.91,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.88,
      "end_seconds": 86.71,
      "duration_seconds": 5.83,
      "text": "It just comes and goes. There's light vaginal bleeding as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 87.25,
      "end_seconds": 98.89,
      "duration_seconds": 11.64,
      "text": "Okay, so the vitals from earlier. SpO2 99 percent on room air, respiratory rate 19, heart rate 121. Temperature 37.0, blood pressure 134 over 78."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.84,
      "end_seconds": 101.54,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.85,
      "end_seconds": 106.62,
      "duration_seconds": 3.77,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.15,
      "end_seconds": 124.14,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.22,
      "end_seconds": 127.81,
      "duration_seconds": 2.59,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.23,
      "end_seconds": 141.54,
      "duration_seconds": 5.31,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.95,
      "end_seconds": 150.82,
      "duration_seconds": 6.87,
      "text": "Okay, that's enough for me. Let me check a few things. Any fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.84,
      "end_seconds": 164.34,
      "duration_seconds": 11.5,
      "text": "Well, no, no fever, no vaginal discharge. I was feeling faint at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.17,
      "end_seconds": 168.92,
      "duration_seconds": 3.75,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.65,
      "end_seconds": 172.76,
      "duration_seconds": 3.11,
      "text": "Actually, no, that side's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.31,
      "end_seconds": 176.28,
      "duration_seconds": 1.97,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.29,
      "end_seconds": 179.29,
      "duration_seconds": 1.0,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.37,
      "end_seconds": 184.74,
      "duration_seconds": 4.37,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.39,
      "end_seconds": 198.33,
      "duration_seconds": 9.94,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.99,
      "end_seconds": 203.64,
      "duration_seconds": 3.65,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 205.02,
      "end_seconds": 212.88,
      "duration_seconds": 7.86,
      "text": "Actually, you know, she is on simvastatin, 20 milligrams, at night, I give it to her."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.54,
      "end_seconds": 215.79,
      "duration_seconds": 2.25,
      "text": "Glimepiride I don't take anymore."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.85,
      "end_seconds": 220.58,
      "duration_seconds": 2.73,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.23,
      "end_seconds": 228.58,
      "duration_seconds": 6.35,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.96,
      "end_seconds": 248.91,
      "duration_seconds": 3.95,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.42,
      "end_seconds": 253.41,
      "duration_seconds": 3.99,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.05,
      "end_seconds": 255.37,
      "duration_seconds": 1.32,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.92,
      "end_seconds": 260.49,
      "duration_seconds": 4.57,
      "text": "Um, I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.09,
      "end_seconds": 263.41,
      "duration_seconds": 1.32,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.45,
      "end_seconds": 269.6,
      "duration_seconds": 5.15,
      "text": "Alright, diabetes, that matches what I have here. Who lives with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.14,
      "end_seconds": 272.71,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.34,
      "end_seconds": 276.26,
      "duration_seconds": 2.92,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.85,
      "end_seconds": 281.87,
      "duration_seconds": 4.02,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 282.87,
      "end_seconds": 286.21,
      "duration_seconds": 3.34,
      "text": "We've already done a pregnancy test this morning, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.73,
      "end_seconds": 292.54,
      "duration_seconds": 5.81,
      "text": "Thanks, that helps. I want an urgent pelvic scan done, that's for possible ectopic."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.11,
      "end_seconds": 296.05,
      "duration_seconds": 2.94,
      "text": "Mm, that's fine with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.96,
      "end_seconds": 311.26,
      "duration_seconds": 13.3,
      "text": "You need to go to the hospital now for an emergency scan. Come back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.44,
      "end_seconds": 317.62,
      "duration_seconds": 3.18,
      "text": "Great, thank you for your help."
    }
  ]
}