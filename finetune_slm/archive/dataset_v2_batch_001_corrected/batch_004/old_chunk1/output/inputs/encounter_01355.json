{
  "schema_version": "1.0",
  "encounter_id": "01355",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.06,
      "duration_seconds": 3.05,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 9.45,
      "duration_seconds": 4.44,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.66,
      "end_seconds": 17.29,
      "duration_seconds": 6.63,
      "text": "So the thing is, I've got my face drooping on one side."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.44,
      "end_seconds": 20.86,
      "duration_seconds": 2.42,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.94,
      "end_seconds": 25.31,
      "duration_seconds": 2.37,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.02,
      "end_seconds": 29.84,
      "duration_seconds": 2.82,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.41,
      "end_seconds": 44.28,
      "duration_seconds": 13.87,
      "text": "It feels moderate to me. Oh, and weakness in my right arm. Actually, about weakness in my right arm, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.74,
      "end_seconds": 58.26,
      "duration_seconds": 4.52,
      "text": "Have you had any loss of consciousness, fever or seizure?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.76,
      "end_seconds": 64.72,
      "duration_seconds": 4.96,
      "text": "No loss of consciousness, fever or seizure, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.36,
      "end_seconds": 68.86,
      "duration_seconds": 2.5,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.1,
      "end_seconds": 72.93,
      "duration_seconds": 2.83,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.22,
      "end_seconds": 76.99,
      "duration_seconds": 2.77,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.63,
      "end_seconds": 81.29,
      "duration_seconds": 2.66,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.82,
      "end_seconds": 84.56,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.69,
      "end_seconds": 88.67,
      "duration_seconds": 2.98,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.12,
      "end_seconds": 103.94,
      "duration_seconds": 4.82,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.0,
      "end_seconds": 112.54,
      "duration_seconds": 6.54,
      "text": "Apixaban. I take it 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.83,
      "end_seconds": 113.53,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.93,
      "end_seconds": 129.36,
      "duration_seconds": 2.43,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.1,
      "end_seconds": 133.63,
      "duration_seconds": 3.53,
      "text": "Uh, I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.21,
      "end_seconds": 137.65,
      "duration_seconds": 3.44,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.74,
      "end_seconds": 141.47,
      "duration_seconds": 2.73,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.26,
      "end_seconds": 149.31,
      "duration_seconds": 4.05,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.32,
      "end_seconds": 160.92,
      "duration_seconds": 10.6,
      "text": "My partner and our baby. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.51,
      "end_seconds": 166.44,
      "duration_seconds": 3.93,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.01,
      "end_seconds": 172.2,
      "duration_seconds": 4.19,
      "text": "I have an irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.51,
      "end_seconds": 178.22,
      "duration_seconds": 4.71,
      "text": "Understood. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.68,
      "end_seconds": 187.02,
      "duration_seconds": 2.34,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.54,
      "end_seconds": 213.4,
      "duration_seconds": 10.86,
      "text": "Okay: SpO2 98 percent on room air, pulse is 90 beats a minute. And temperature is 37.0 degrees, blood pressure 157 over 90."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 218.7,
      "duration_seconds": 3.79,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.83,
      "end_seconds": 231.62,
      "duration_seconds": 1.79,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.98,
      "end_seconds": 235.57,
      "duration_seconds": 2.59,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.14,
      "end_seconds": 258.22,
      "duration_seconds": 6.08,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.2,
      "end_seconds": 272.11,
      "duration_seconds": 8.91,
      "text": "Okay, that's enough for me. Okay, so my impression is this: It points towards a possible stroke, within the treatment window."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.04,
      "end_seconds": 276.03,
      "duration_seconds": 1.99,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.97,
      "end_seconds": 307.61,
      "duration_seconds": 29.64,
      "text": "It's reasonable to be concerned, but right now a possible stroke, within the treatment window is my leading thought, not anything worse. Let's book a blood sugar test to look into stroke symptoms. The result will help us decide whether anything more is needed. Call an ambulance now, you need hospital immediately. An urgent CT scan of the head is something we might do if this doesn't improve next month."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.17,
      "end_seconds": 314.83,
      "duration_seconds": 5.66,
      "text": "Please don't wait if the symptoms change. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.9,
      "end_seconds": 317.53,
      "duration_seconds": 1.63,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.53,
      "end_seconds": 325.37,
      "duration_seconds": 5.84,
      "text": "I'd like you back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.03,
      "end_seconds": 329.81,
      "duration_seconds": 3.78,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}