{
  "schema_version": "1.0",
  "encounter_id": "01420",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.57,
      "end_seconds": 5.5,
      "duration_seconds": 4.93,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.5,
      "end_seconds": 10.08,
      "duration_seconds": 3.58,
      "text": "okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.5,
      "end_seconds": 21.0,
      "duration_seconds": 9.5,
      "text": "Actually, good morning, doctor. I came along to help out. She's been having a severe headache, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.7,
      "end_seconds": 26.11,
      "duration_seconds": 3.41,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.98,
      "end_seconds": 32.11,
      "duration_seconds": 4.13,
      "text": "I mean, I'd say three weeks, maybe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 34.2,
      "end_seconds": 37.73,
      "duration_seconds": 3.53,
      "text": "it was closer to a month, doctor"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.26,
      "end_seconds": 43.15,
      "duration_seconds": 4.89,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.11,
      "end_seconds": 50.07,
      "duration_seconds": 4.96,
      "text": "Sorry, what was I saying, I suppose so, yes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.89,
      "end_seconds": 59.21,
      "duration_seconds": 5.32,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.77,
      "end_seconds": 68.41,
      "duration_seconds": 8.64,
      "text": "Yeah, uh, I notice it more with light. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.31,
      "end_seconds": 76.63,
      "duration_seconds": 7.32,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 76.73,
      "end_seconds": 82.2,
      "duration_seconds": 5.47,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.95,
      "end_seconds": 85.89,
      "duration_seconds": 2.94,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.86,
      "end_seconds": 94.56,
      "duration_seconds": 7.7,
      "text": "that's fine, one at a time i'll ask about everything has there been a high fever too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.14,
      "end_seconds": 107.33,
      "duration_seconds": 11.19,
      "text": "Ah, um, yeah. Four weeks, I'd say. Actually, as for high fever, it happens all the time."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 107.95,
      "end_seconds": 110.7,
      "duration_seconds": 2.75,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.6,
      "end_seconds": 123.45,
      "duration_seconds": 3.85,
      "text": "Have you noticed cough or recent head injury?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.9,
      "end_seconds": 136.71,
      "duration_seconds": 11.81,
      "text": "no, no cough, no recent head injury i did have hating the light at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.21,
      "end_seconds": 143.44,
      "duration_seconds": 2.23,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 144.99,
      "end_seconds": 147.77,
      "duration_seconds": 2.78,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.31,
      "end_seconds": 150.76,
      "duration_seconds": 1.45,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.24,
      "end_seconds": 156.05,
      "duration_seconds": 3.81,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.29,
      "end_seconds": 160.04,
      "duration_seconds": 2.75,
      "text": "alright, do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.45,
      "end_seconds": 164.15,
      "duration_seconds": 2.7,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.61,
      "end_seconds": 168.07,
      "duration_seconds": 2.46,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.68,
      "end_seconds": 175.19,
      "duration_seconds": 5.51,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.07,
      "end_seconds": 178.62,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.92,
      "end_seconds": 194.83,
      "duration_seconds": 14.91,
      "text": "Metoprolol, 50 milligrams, twice a day. Escitalopram, 10 milligrams, once a day for the anxiety. Asthalin inhaler. I take it when needed. Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 196.17,
      "end_seconds": 204.75,
      "duration_seconds": 8.58,
      "text": "She is supposed to take it when needed, but I can't say she always does."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.33,
      "end_seconds": 210.2,
      "duration_seconds": 4.87,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.2,
      "end_seconds": 221.42,
      "duration_seconds": 9.22,
      "text": "I've had heart failure for two years now. Erm, uh, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.36,
      "end_seconds": 224.3,
      "duration_seconds": 0.94,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.38,
      "end_seconds": 226.84,
      "duration_seconds": 1.46,
      "text": "I've got asthma"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.67,
      "end_seconds": 233.38,
      "duration_seconds": 1.71,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.64,
      "end_seconds": 240.58,
      "duration_seconds": 5.94,
      "text": "Um, um, I have eczema, for about a year."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.47,
      "end_seconds": 250.22,
      "duration_seconds": 7.75,
      "text": "Right, right. Alright, asthma, that that matches what I have here. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 251.37,
      "end_seconds": 258.42,
      "duration_seconds": 7.05,
      "text": "okay, so my aunt has rheumatoid arthritis my uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.79,
      "end_seconds": 264.14,
      "duration_seconds": 4.35,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.34,
      "end_seconds": 267.15,
      "duration_seconds": 1.81,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 268.65,
      "end_seconds": 276.4,
      "duration_seconds": 7.75,
      "text": "actually, I remember she had some kinda reaction to naproxen before i couldn't swear to it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 277.59,
      "end_seconds": 280.44,
      "duration_seconds": 2.85,
      "text": "Erm, I don't remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.8,
      "end_seconds": 289.5,
      "duration_seconds": 7.7,
      "text": "Alright, so so that's unclear. I'll record what each of you said. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.22,
      "end_seconds": 295.63,
      "duration_seconds": 5.41,
      "text": "just keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 296.91,
      "end_seconds": 305.14,
      "duration_seconds": 8.23,
      "text": "here are the numbers, doctor. Oxygen saturation is 95 percent, temperature is 38.2 degrees, pulse 90, pressure 105 over 68."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.22,
      "end_seconds": 308.62,
      "duration_seconds": 1.4,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.27,
      "end_seconds": 315.38,
      "duration_seconds": 4.11,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.59,
      "end_seconds": 318.84,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.23,
      "end_seconds": 342.43,
      "duration_seconds": 9.2,
      "text": "Your neck is stiff, you are feverish, and and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.61,
      "end_seconds": 346.78,
      "duration_seconds": 2.17,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.67,
      "end_seconds": 362.78,
      "duration_seconds": 7.11,
      "text": "Taking everything into account, I'd lean towards possible bacterial meningitis. Meningococcal septicaemia is also on my list."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.44,
      "end_seconds": 365.0,
      "duration_seconds": 1.56,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.67,
      "end_seconds": 376.71,
      "duration_seconds": 11.04,
      "text": "it's reasonable to be concerned, but right now possible bacterial meningitis is my leading thought, not anything worse. I'd like to arrange blood cultures for possible meningitis"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 380.1,
      "end_seconds": 383.73,
      "duration_seconds": 3.63,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.27,
      "end_seconds": 411.58,
      "duration_seconds": 26.31,
      "text": "I'm going to order a lumbar puncture, for possible meningitis you'll be taking benzylpenicillin, 1.2 grams, once now, single dose that's for possible meningitis call an ambulance now, this is an emergency we'll refer you to the emergency team the thing that would worry me is if you cannot go now if that happens, go to emergency"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 413.28,
      "end_seconds": 414.96,
      "duration_seconds": 1.68,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 416.62,
      "end_seconds": 423.19,
      "duration_seconds": 6.57,
      "text": "See me again straight away. Is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 424.18,
      "end_seconds": 429.4,
      "duration_seconds": 5.22,
      "text": "Good, you know, thanks, I'll see you then."
    }
  ]
}