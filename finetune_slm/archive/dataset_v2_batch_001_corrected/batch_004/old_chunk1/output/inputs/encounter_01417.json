{
  "schema_version": "1.0",
  "encounter_id": "01417",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.8,
      "end_seconds": 7.87,
      "duration_seconds": 7.07,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.4,
      "end_seconds": 13.73,
      "duration_seconds": 5.33,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.86,
      "end_seconds": 23.09,
      "duration_seconds": 8.23,
      "text": "Mainly being very thirsty. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.85,
      "end_seconds": 26.11,
      "duration_seconds": 2.26,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.94,
      "end_seconds": 30.05,
      "duration_seconds": 3.11,
      "text": "It's been like this since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.54,
      "end_seconds": 40.69,
      "duration_seconds": 10.15,
      "text": "Hm, okay. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.3,
      "end_seconds": 48.17,
      "duration_seconds": 6.87,
      "text": "About a five out of ten. It settles a little with water. And vomiting, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 56.7,
      "end_seconds": 69.37,
      "duration_seconds": 12.67,
      "text": "okay, so the the vitals from earlier temperature is 37.1 degrees, height 174 centimetres, weight 69 kilos, pulse is 112 beats a minute, pressure 137 over 86."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.13,
      "end_seconds": 72.04,
      "duration_seconds": 0.91,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.44,
      "end_seconds": 78.52,
      "duration_seconds": 4.08,
      "text": "Could you come over to the the couch, please?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.0,
      "end_seconds": 82.24,
      "duration_seconds": 2.24,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 102.3,
      "duration_seconds": 4.17,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.61,
      "end_seconds": 109.25,
      "duration_seconds": 2.64,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.66,
      "end_seconds": 124.09,
      "duration_seconds": 3.43,
      "text": "did you get chest pain or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.65,
      "end_seconds": 127.52,
      "duration_seconds": 2.87,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.86,
      "end_seconds": 131.33,
      "duration_seconds": 2.47,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.38,
      "end_seconds": 134.17,
      "duration_seconds": 1.79,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.38,
      "end_seconds": 136.89,
      "duration_seconds": 1.51,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.13,
      "end_seconds": 140.28,
      "duration_seconds": 2.15,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.59,
      "end_seconds": 145.1,
      "duration_seconds": 3.51,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.18,
      "end_seconds": 159.25,
      "duration_seconds": 12.07,
      "text": "I'm on Glycomet, 500 milligrams, twice a day for my sugar i'm on alendronate, 70 milligrams, once a week for my bones"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.62,
      "end_seconds": 163.92,
      "duration_seconds": 1.3,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.18,
      "end_seconds": 167.27,
      "duration_seconds": 2.09,
      "text": "about about a month"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.66,
      "end_seconds": 171.8,
      "duration_seconds": 3.14,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.42,
      "end_seconds": 194.28,
      "duration_seconds": 20.86,
      "text": "I've had diabetes for about ten years now a neighbour of mine said I should see someone about it i have thin bones, for about a year i did try to ignore it for a while i took the morning off to come in today"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.96,
      "end_seconds": 205.57,
      "duration_seconds": 9.61,
      "text": "Right, so diabetes and thin bones are already on your record. We'll keep that in mind today. Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.39,
      "end_seconds": 208.03,
      "duration_seconds": 1.64,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.72,
      "end_seconds": 211.05,
      "duration_seconds": 1.33,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 212.43,
      "end_seconds": 215.27,
      "duration_seconds": 2.84,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.94,
      "end_seconds": 217.91,
      "duration_seconds": 1.97,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.6,
      "end_seconds": 223.32,
      "duration_seconds": 3.72,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.07,
      "end_seconds": 227.44,
      "duration_seconds": 2.37,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.37,
      "end_seconds": 234.28,
      "duration_seconds": 5.91,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.8,
      "end_seconds": 237.61,
      "duration_seconds": 1.81,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.77,
      "end_seconds": 243.34,
      "duration_seconds": 4.57,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.63,
      "end_seconds": 249.4,
      "duration_seconds": 4.77,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.4,
      "end_seconds": 256.16,
      "duration_seconds": 3.76,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.73,
      "end_seconds": 261.19,
      "duration_seconds": 4.46,
      "text": "so, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.38,
      "end_seconds": 264.88,
      "duration_seconds": 2.5,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.75,
      "end_seconds": 274.67,
      "duration_seconds": 8.92,
      "text": "Putting it all together, this looks most like diabetic ketoacidosis. I'd also keep a severe infection in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 290.77,
      "end_seconds": 298.05,
      "duration_seconds": 7.28,
      "text": "Doctor, I did a blood sugar and ketone test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.93,
      "end_seconds": 307.38,
      "duration_seconds": 8.45,
      "text": "great, that's useful you need to go to hospital now for insulin and fluids i'll want another look straight away"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.49,
      "end_seconds": 310.84,
      "duration_seconds": 2.35,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.05,
      "end_seconds": 314.82,
      "duration_seconds": 2.77,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.94,
      "end_seconds": 319.11,
      "duration_seconds": 3.17,
      "text": "I think I understand everything. Thanks."
    }
  ]
}