    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.55,
      "end_seconds": 86.91,
      "duration_seconds": 3.36,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.92,
      "end_seconds": 94.44,
      "duration_seconds": 1.52,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.56,
      "end_seconds": 101.16,
      "duration_seconds": 5.6,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.87,
      "end_seconds": 111.85,
      "duration_seconds": 9.98,
      "text": "Not much, I mostly stay in these days. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.3,
      "end_seconds": 131.5,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.63,
      "end_seconds": 134.13,
      "duration_seconds": 1.5,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.38,
      "end_seconds": 140.24,
      "duration_seconds": 4.86,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.54,
      "end_seconds": 153.67,
      "duration_seconds": 2.13,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.31,
      "end_seconds": 189.77,
      "duration_seconds": 14.46,
      "text": "Okay: pulse 83, BP is 114 over 70, oxygen saturation is 98 percent. And BMI works out to 41.9, respiratory rate 17, weight 98 kilos, height 153 centimetres."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.03,
      "end_seconds": 192.59,
      "duration_seconds": 1.56,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.57,
      "end_seconds": 196.38,
      "duration_seconds": 2.81,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.75,
      "end_seconds": 202.53,
      "duration_seconds": 3.78,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.47,
      "end_seconds": 206.94,
      "duration_seconds": 2.47,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.31,
      "end_seconds": 229.99,
      "duration_seconds": 4.68,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.97,
      "end_seconds": 248.9,
      "duration_seconds": 1.93,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.46,
      "end_seconds": 253.84,
      "duration_seconds": 2.38,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.8,
      "end_seconds": 280.49,
      "duration_seconds": 11.69,
      "text": "Having listened and examined, I can't pin this down yet. We're looking at harmless extra heartbeats or an anxiety-related palpitation. Let's book an ECG to look into palpitations."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 281.52,
      "end_seconds": 285.77,
      "duration_seconds": 4.25,
      "text": "I can book that for Monday at 11:30 am"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.21,
      "end_seconds": 294.62,
      "duration_seconds": 7.41,
      "text": "Cut back on coffee and energy drinks and keep a diary of when it happens."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.07,
      "end_seconds": 299.53,
      "duration_seconds": 4.46,
      "text": "hm, okay i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.07,
      "end_seconds": 303.53,
