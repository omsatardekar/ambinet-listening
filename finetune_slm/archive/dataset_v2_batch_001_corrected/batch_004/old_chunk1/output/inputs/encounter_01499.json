      "start_seconds": 0.53,
      "end_seconds": 4.8,
      "duration_seconds": 4.27,
      "text": "Evening. Let's get started. What's the main thing today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.49,
      "end_seconds": 10.89,
      "duration_seconds": 4.4,
      "text": "I wanted to get skipped beats looked at."
