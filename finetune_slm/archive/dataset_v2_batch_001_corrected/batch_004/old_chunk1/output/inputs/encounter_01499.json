      "role": "DOCTOR",
      "start_seconds": 23.12,
      "end_seconds": 28.37,
      "duration_seconds": 5.25,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.52,
      "end_seconds": 38.64,
      "duration_seconds": 9.12,
      "text": "Caffeine definitely sets it off. I'd give it a three, out of ten. I get some relief from deep breaths."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.9,
      "end_seconds": 44.92,
      "duration_seconds": 5.02,
      "text": "Did you get fainting, dizziness, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.36,
      "end_seconds": 49.7,
      "duration_seconds": 3.34,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.73,
      "end_seconds": 53.4,
      "duration_seconds": 2.67,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.57,
      "end_seconds": 56.1,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.06,
      "end_seconds": 59.94,
      "duration_seconds": 2.88,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.82,
      "end_seconds": 62.3,
      "duration_seconds": 1.48,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.65,
      "end_seconds": 67.86,
      "duration_seconds": 4.21,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.41,
      "end_seconds": 71.49,
      "duration_seconds": 2.08,
      "text": "No allergies at all."
