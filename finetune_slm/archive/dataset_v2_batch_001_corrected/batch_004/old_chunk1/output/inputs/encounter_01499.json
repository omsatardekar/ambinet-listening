    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.88,
      "end_seconds": 16.91,
      "duration_seconds": 4.03,
      "text": "Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.49,
      "end_seconds": 22.47,
      "duration_seconds": 1.98,
      "text": "about... well, one week"
