{
  "schema_version": "1.0",
  "encounter_id": "01320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 4.45,
      "duration_seconds": 3.26,
      "text": "Okay, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.65,
      "end_seconds": 6.69,
      "duration_seconds": 1.04,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.19,
      "end_seconds": 9.93,
      "duration_seconds": 1.74,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.46,
      "end_seconds": 22.08,
      "duration_seconds": 10.62,
      "text": "Um, so... a severe headache. That's why I came. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.27,
      "end_seconds": 30.19,
      "duration_seconds": 6.92,
      "text": "How many days or weeks has it been? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.38,
      "end_seconds": 34.42,
      "duration_seconds": 3.04,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.0,
      "end_seconds": 40.41,
      "duration_seconds": 5.41,
      "text": "Right, right. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.87,
      "end_seconds": 56.94,
      "duration_seconds": 15.07,
      "text": "Light definitely sets it off. Moderate, I'd say. Honestly, once or twice a day. And there's a rash that does not fade as well, about four days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.48,
      "end_seconds": 61.35,
      "duration_seconds": 3.87,
      "text": "Mm-hmm. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.96,
      "end_seconds": 71.15,
      "duration_seconds": 9.19,
      "text": "It's sitagliptin, 100 milligrams, once a day. I take apixaban, 5 milligrams, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.64,
      "end_seconds": 74.95,
      "duration_seconds": 2.31,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.56,
      "end_seconds": 79.86,
      "duration_seconds": 4.3,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.72,
      "end_seconds": 83.07,
      "duration_seconds": 2.35,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.93,
      "end_seconds": 87.59,
      "duration_seconds": 3.66,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.81,
      "end_seconds": 107.47,
      "duration_seconds": 2.66,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.44,
      "end_seconds": 113.73,
      "duration_seconds": 4.29,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.26,
      "end_seconds": 118.61,
      "duration_seconds": 3.35,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.57,
      "end_seconds": 124.32,
      "duration_seconds": 3.75,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.49,
      "end_seconds": 126.73,
      "duration_seconds": 1.24,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.76,
      "end_seconds": 131.88,
      "duration_seconds": 4.12,
      "text": "I have an irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.5,
      "end_seconds": 145.82,
      "duration_seconds": 4.32,
      "text": "A few quick ones: recent head injury or cough?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.54,
      "end_seconds": 150.12,
      "duration_seconds": 3.58,
      "text": "No, um, not a single one."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.64,
      "end_seconds": 153.15,
      "duration_seconds": 2.51,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.9,
      "end_seconds": 156.35,
      "duration_seconds": 1.45,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.62,
      "end_seconds": 160.05,
      "duration_seconds": 2.43,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.61,
      "end_seconds": 171.08,
      "duration_seconds": 2.47,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.59,
      "end_seconds": 190.6,
      "duration_seconds": 7.01,
      "text": "Okay: saturation 97 percent, blood pressure 107 over 69, temp 38.3 degrees, heart rate 99."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.34,
      "end_seconds": 193.98,
      "duration_seconds": 1.64,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.45,
      "end_seconds": 202.04,
      "duration_seconds": 2.59,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.2,
      "end_seconds": 209.07,
      "duration_seconds": 4.87,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.08,
      "end_seconds": 213.43,
      "duration_seconds": 3.35,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.2,
      "end_seconds": 235.58,
      "duration_seconds": 7.38,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.61,
      "end_seconds": 242.32,
      "duration_seconds": 2.71,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.2,
      "end_seconds": 255.77,
      "duration_seconds": 5.57,
      "text": "Right, here's what I'm thinking. My working impression is possible bacterial meningitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.37,
      "end_seconds": 259.69,
      "duration_seconds": 2.32,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.28,
      "end_seconds": 269.17,
      "duration_seconds": 8.89,
      "text": "Nothing I've seen today points to an emergency. It looks like possible bacterial meningitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.54,
      "end_seconds": 313.23,
      "duration_seconds": 27.69,
      "text": "We should do blood cultures for possible meningitis. We should do a lumbar puncture for possible meningitis. I'd like you to take benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. Call an ambulance now, this is an emergency. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.27,
      "end_seconds": 315.97,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.28,
      "end_seconds": 320.59,
      "duration_seconds": 3.31,
      "text": "Please come and see me straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.44,
      "end_seconds": 322.9,
      "duration_seconds": 1.46,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.3,
      "end_seconds": 328.23,
      "duration_seconds": 3.93,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.72,
      "end_seconds": 336.11,
      "duration_seconds": 3.39,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 337.33,
      "end_seconds": 338.77,
      "duration_seconds": 1.44,
      "text": "All the best."
    }
  ]
}