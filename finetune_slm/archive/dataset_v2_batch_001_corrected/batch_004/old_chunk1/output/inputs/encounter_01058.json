{
  "schema_version": "1.0",
  "encounter_id": "01058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 6.03,
      "duration_seconds": 5.4,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.07,
      "end_seconds": 12.03,
      "duration_seconds": 3.96,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.95,
      "end_seconds": 20.93,
      "duration_seconds": 6.98,
      "text": "Honestly, it's shaking chills and a high temperature, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.06,
      "end_seconds": 23.86,
      "duration_seconds": 1.8,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.62,
      "end_seconds": 32.99,
      "duration_seconds": 8.37,
      "text": "I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 39.62,
      "duration_seconds": 4.79,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.38,
      "end_seconds": 48.74,
      "duration_seconds": 8.36,
      "text": "Honestly, on and off. Only blankets, and it's not much. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.36,
      "end_seconds": 52.49,
      "duration_seconds": 3.13,
      "text": "has there been a racing heart too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.61,
      "end_seconds": 55.66,
      "duration_seconds": 2.05,
      "text": "Yes, for two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.59,
      "end_seconds": 61.27,
      "duration_seconds": 3.68,
      "text": "Did you get chest pain, stiff neck or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.03,
      "end_seconds": 64.27,
      "duration_seconds": 2.24,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.99,
      "end_seconds": 68.02,
      "duration_seconds": 3.03,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.22,
      "end_seconds": 70.76,
      "duration_seconds": 1.54,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.8,
      "end_seconds": 88.28,
      "duration_seconds": 3.48,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.89,
      "end_seconds": 91.5,
      "duration_seconds": 1.61,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.67,
      "end_seconds": 97.14,
      "duration_seconds": 4.47,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.75,
      "end_seconds": 99.3,
      "duration_seconds": 1.55,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.41,
      "end_seconds": 109.94,
      "duration_seconds": 2.53,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.44,
      "end_seconds": 113.94,
      "duration_seconds": 2.5,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.58,
      "end_seconds": 116.77,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.81,
      "end_seconds": 121.48,
      "duration_seconds": 3.67,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.61,
      "end_seconds": 123.82,
      "duration_seconds": 1.21,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.23,
      "end_seconds": 128.38,
      "duration_seconds": 3.15,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.22,
      "end_seconds": 132.1,
      "duration_seconds": 2.88,
      "text": "So, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.16,
      "end_seconds": 137.13,
      "duration_seconds": 3.97,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.87,
      "end_seconds": 139.04,
      "duration_seconds": 1.17,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.94,
      "end_seconds": 146.36,
      "duration_seconds": 3.42,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.44,
      "end_seconds": 150.58,
      "duration_seconds": 2.14,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.18,
      "end_seconds": 156.11,
      "duration_seconds": 3.93,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.91,
      "end_seconds": 160.23,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 164.32,
      "duration_seconds": 3.27,
      "text": "Yes, milk. I get a rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.28,
      "end_seconds": 169.14,
      "duration_seconds": 2.86,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.88,
      "end_seconds": 172.05,
      "duration_seconds": 2.17,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.84,
      "end_seconds": 177.14,
      "duration_seconds": 4.3,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.21,
      "end_seconds": 188.46,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.53,
      "end_seconds": 211.04,
      "duration_seconds": 10.51,
      "text": "Okay: SpO2 95 percent on room air, temperature is 38.9 degrees, BP is 124 over 80, pulse is 92 beats a minute."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.51,
      "end_seconds": 217.23,
      "duration_seconds": 3.72,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.89,
      "end_seconds": 221.19,
      "duration_seconds": 2.3,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.63,
      "end_seconds": 235.85,
      "duration_seconds": 7.22,
      "text": "you are hot, your heart is racing and your blood pressure is low, which worries me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.62,
      "end_seconds": 243.09,
      "duration_seconds": 2.47,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.88,
      "end_seconds": 287.91,
      "duration_seconds": 28.03,
      "text": "so, based on the history and the examination, my working impression is possible sepsis needing urgent treatment a severe urine or chest infection is also on my list i'm sending you for a chest X-ray cos of fever i wanna admit you to hospital now for fluids and antibiotics if you cannot be brought in today, that's the point to come in urgently"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.02,
      "end_seconds": 295.62,
      "duration_seconds": 1.6,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.66,
      "end_seconds": 300.91,
      "duration_seconds": 4.25,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.82,
      "end_seconds": 305.0,
      "duration_seconds": 2.18,
      "text": "alright, thanks, take care"
    }
  ]
