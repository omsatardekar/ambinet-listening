{
  "schema_version": "1.0",
  "encounter_id": "01030",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 3.88,
      "duration_seconds": 2.84,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.69,
      "end_seconds": 10.09,
      "duration_seconds": 5.4,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.01,
      "end_seconds": 23.43,
      "duration_seconds": 8.42,
      "text": "It's severe lower back pain, mostly. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.61,
      "end_seconds": 28.0,
      "duration_seconds": 3.39,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.09,
      "end_seconds": 33.14,
      "duration_seconds": 4.05,
      "text": "Okay, so it's been like this since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.16,
      "end_seconds": 40.34,
      "duration_seconds": 5.18,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.82,
      "end_seconds": 49.38,
      "duration_seconds": 7.56,
      "text": "It feels severe to me. It's every other day. Bending definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.32,
      "end_seconds": 54.09,
      "duration_seconds": 2.77,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.98,
      "end_seconds": 69.12,
      "duration_seconds": 14.14,
      "text": "Weakness in both legs goes along with it, you know, most of the time. Right, the weakness in both legs? That's been for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.41,
      "end_seconds": 74.31,
      "duration_seconds": 3.9,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.55,
      "end_seconds": 80.67,
      "duration_seconds": 3.12,
      "text": "Hmm, no, nothing at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.21,
      "end_seconds": 93.41,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.2,
      "end_seconds": 95.4,
      "duration_seconds": 1.2,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.02,
      "end_seconds": 112.7,
      "duration_seconds": 1.68,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.97,
      "end_seconds": 118.16,
      "duration_seconds": 4.19,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.25,
      "end_seconds": 122.66,
      "duration_seconds": 2.41,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.05,
      "end_seconds": 129.53,
      "duration_seconds": 5.48,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.78,
      "end_seconds": 133.65,
      "duration_seconds": 2.87,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.54,
      "end_seconds": 137.95,
      "duration_seconds": 3.41,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.58,
      "end_seconds": 160.48,
      "duration_seconds": 3.9,
      "text": "Alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.58,
      "end_seconds": 163.86,
      "duration_seconds": 2.28,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 169.47,
      "duration_seconds": 4.03,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.94,
      "end_seconds": 175.49,
      "duration_seconds": 4.55,
      "text": "Um, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.5,
      "end_seconds": 179.4,
      "duration_seconds": 2.9,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.69,
      "end_seconds": 182.25,
      "duration_seconds": 1.56,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.77,
      "end_seconds": 186.06,
      "duration_seconds": 3.29,
      "text": "Any fever or recent fall at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.73,
      "end_seconds": 194.49,
      "duration_seconds": 3.76,
      "text": "I haven't had fever or recent fall, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.02,
      "end_seconds": 197.53,
      "duration_seconds": 2.51,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.5,
      "end_seconds": 201.88,
      "duration_seconds": 2.38,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.29,
      "end_seconds": 207.7,
      "duration_seconds": 4.41,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.7,
      "end_seconds": 211.41,
      "duration_seconds": 2.71,
      "text": "Yeah, um, no problem."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.46,
      "end_seconds": 213.66,
      "duration_seconds": 1.2,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.81,
      "end_seconds": 231.04,
      "duration_seconds": 5.23,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.21,
      "end_seconds": 243.63,
      "duration_seconds": 10.42,
      "text": "Okay, that's enough for me. So, based on the history and the examination, it fits best with possible cauda equina syndrome needing an urgent scan."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.12,
      "end_seconds": 247.83,
      "duration_seconds": 2.71,
      "text": "Oh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.58,
      "end_seconds": 270.28,
      "duration_seconds": 20.7,
      "text": "It's reasonable to be concerned, but right now possible cauda equina syndrome needing an urgent scan is my leading thought, not anything worse. So, to recap quickly. You've had severe lower back pain, since Monday, severe, and no fever or recent fall."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.0,
      "end_seconds": 273.13,
      "duration_seconds": 2.13,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.65,
      "end_seconds": 287.22,
      "duration_seconds": 5.57,
      "text": "I'm going to order an urgent MRI of the spine, for possible cauda equina."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.77,
      "end_seconds": 290.3,
      "duration_seconds": 2.53,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.06,
      "end_seconds": 299.6,
      "duration_seconds": 8.54,
      "text": "You need to go to hospital now for an emergency scan. I'll also refer you to the spinal team."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.93,
      "end_seconds": 301.63,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.75,
      "end_seconds": 308.04,
      "duration_seconds": 5.29,
      "text": "I'd like you back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.24,
      "end_seconds": 312.97,
      "duration_seconds": 3.73,
      "text": "Actually, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.01,
      "end_seconds": 315.19,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}