{
  "schema_version": "1.0",
  "encounter_id": "01284",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 5.08,
      "duration_seconds": 4.48,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.37,
      "end_seconds": 13.72,
      "duration_seconds": 5.35,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.58,
      "end_seconds": 18.67,
      "duration_seconds": 3.09,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.72,
      "end_seconds": 25.06,
      "duration_seconds": 3.34,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.57,
      "end_seconds": 29.66,
      "duration_seconds": 4.09,
      "text": "I wanted to get a severe headache looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.81,
      "end_seconds": 35.93,
      "duration_seconds": 5.12,
      "text": "When did this begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.16,
      "end_seconds": 45.99,
      "duration_seconds": 8.83,
      "text": "It's been going on for five days. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.18,
      "end_seconds": 50.12,
      "duration_seconds": 2.94,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.01,
      "end_seconds": 54.2,
      "duration_seconds": 3.19,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.08,
      "end_seconds": 61.47,
      "duration_seconds": 6.39,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 61.57,
      "end_seconds": 67.9,
      "duration_seconds": 6.33,
      "text": "Ah, um, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.62,
      "end_seconds": 77.66,
      "duration_seconds": 8.04,
      "text": "I was getting to that! I've also had a high fever, for three days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 79.58,
      "end_seconds": 85.95,
      "duration_seconds": 6.37,
      "text": "Doctor, I've got the readings for you. Temperature 38.4, pressure 118 over 78, pulse 91."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.78,
      "end_seconds": 88.78,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.62,
      "end_seconds": 93.13,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.15,
      "end_seconds": 96.7,
      "duration_seconds": 2.55,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.32,
      "end_seconds": 113.57,
      "duration_seconds": 7.25,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.27,
      "end_seconds": 118.83,
      "duration_seconds": 2.56,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.41,
      "end_seconds": 137.53,
      "duration_seconds": 4.12,
      "text": "Alright, have you had any cough or recent head injury?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.77,
      "end_seconds": 152.59,
      "duration_seconds": 13.82,
      "text": "Um, no, no cough, no recent head injury. I did have a stiff neck at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.63,
      "end_seconds": 156.72,
      "duration_seconds": 2.09,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.39,
      "end_seconds": 159.13,
      "duration_seconds": 1.74,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.1,
      "end_seconds": 169.14,
      "duration_seconds": 9.04,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.89,
      "end_seconds": 181.69,
      "duration_seconds": 10.8,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.2,
      "end_seconds": 195.37,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.26,
      "end_seconds": 199.14,
      "duration_seconds": 2.88,
      "text": "Hmm, no, not at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.84,
      "end_seconds": 204.84,
      "duration_seconds": 4.0,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.74,
      "end_seconds": 207.97,
      "duration_seconds": 2.23,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.89,
      "end_seconds": 213.6,
      "duration_seconds": 4.71,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.4,
      "end_seconds": 225.97,
      "duration_seconds": 11.57,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.4,
      "end_seconds": 231.96,
      "duration_seconds": 4.56,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.68,
      "end_seconds": 236.08,
      "duration_seconds": 2.4,
      "text": "Eczema, for about ten years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.76,
      "end_seconds": 239.67,
      "duration_seconds": 2.91,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.21,
      "end_seconds": 245.41,
      "duration_seconds": 4.2,
      "text": "I've had low haemoglobin for about ten years now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.85,
      "end_seconds": 248.73,
      "duration_seconds": 1.88,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.47,
      "end_seconds": 251.5,
      "duration_seconds": 2.03,
      "text": "I have heart failure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.61,
      "end_seconds": 261.63,
      "duration_seconds": 9.02,
      "text": "Okay, I can see eczema and low haemoglobin in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.15,
      "end_seconds": 281.99,
      "duration_seconds": 14.84,
      "text": "I'm on hydrocortisone cream, when needed. I take iron tablets, once a day. I'm not great at remembering details, so bear with me. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.05,
      "end_seconds": 286.39,
      "duration_seconds": 2.34,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.17,
      "end_seconds": 294.19,
      "duration_seconds": 6.02,
      "text": "Two months now. Metoprolol, 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.04,
      "end_seconds": 299.98,
      "duration_seconds": 3.94,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.71,
      "end_seconds": 305.91,
      "duration_seconds": 4.2,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.92,
      "end_seconds": 318.6,
      "duration_seconds": 10.68,
      "text": "Okay, thinking it through, I'd lean towards possible bacterial meningitis. Another possibility is meningococcal septicaemia. Let's get a lumbar puncture, for possible meningitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.32,
      "end_seconds": 322.83,
      "duration_seconds": 2.51,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.94,
      "end_seconds": 334.5,
      "duration_seconds": 10.56,
      "text": "Let's get blood cultures, for possible meningitis. I'd like you to take benzylpenicillin, 1.2 grams, once now, single dose. That's for possible meningitis."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.51,
      "end_seconds": 340.7,
      "duration_seconds": 4.19,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.78,
      "end_seconds": 356.05,
      "duration_seconds": 11.27,
      "text": "Call an ambulance now, this is an emergency. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.65,
      "end_seconds": 358.29,
      "duration_seconds": 1.64,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.92,
      "end_seconds": 364.72,
      "duration_seconds": 1.8,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.28,
      "end_seconds": 374.1,
      "duration_seconds": 3.82,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.37,
      "end_seconds": 377.77,
      "duration_seconds": 2.4,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.78,
      "end_seconds": 383.47,
      "duration_seconds": 3.69,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.97,
      "end_seconds": 386.85,
      "duration_seconds": 1.88,
      "text": "Right, goodbye for now."
    }
  ]
}