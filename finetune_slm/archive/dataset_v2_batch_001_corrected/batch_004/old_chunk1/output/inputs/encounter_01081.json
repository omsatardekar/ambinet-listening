{
  "schema_version": "1.0",
  "encounter_id": "01081",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 3.86,
      "duration_seconds": 3.21,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.97,
      "end_seconds": 9.45,
      "duration_seconds": 4.48,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.67,
      "end_seconds": 17.72,
      "duration_seconds": 5.05,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.87,
      "end_seconds": 26.35,
      "duration_seconds": 7.48,
      "text": "Um, you know, she's been having an itchy patch on my wrist, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.64,
      "end_seconds": 31.88,
      "duration_seconds": 3.24,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.9,
      "end_seconds": 38.01,
      "duration_seconds": 4.11,
      "text": "I'd say three days, um, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.41,
      "end_seconds": 42.96,
      "duration_seconds": 3.55,
      "text": "Hm, I'd say more like five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.71,
      "end_seconds": 48.34,
      "duration_seconds": 4.63,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.01,
      "end_seconds": 57.56,
      "duration_seconds": 3.55,
      "text": "I suppose so, you know, yes"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.29,
      "end_seconds": 61.18,
      "duration_seconds": 2.89,
      "text": "how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.23,
      "end_seconds": 67.77,
      "duration_seconds": 5.54,
      "text": "I'd give it a three, you know, out of ten"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.4,
      "end_seconds": 71.92,
      "duration_seconds": 2.52,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.84,
      "end_seconds": 76.76,
      "duration_seconds": 3.92,
      "text": "erm, it settles a little with moisturiser"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.37,
      "end_seconds": 83.25,
      "duration_seconds": 4.88,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.34,
      "end_seconds": 89.18,
      "duration_seconds": 3.84,
      "text": "actually, it sort of comes and goes"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.74,
      "end_seconds": 90.66,
      "duration_seconds": 0.92,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.44,
      "end_seconds": 99.02,
      "duration_seconds": 7.58,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 99.12,
      "end_seconds": 104.38,
      "duration_seconds": 5.26,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.18,
      "end_seconds": 117.16,
      "duration_seconds": 11.98,
      "text": "Erm, um, I was getting to that! Oh, you know, and dry flaky skin. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 122.3,
      "end_seconds": 126.14,
      "duration_seconds": 3.84,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.8,
      "end_seconds": 131.0,
      "duration_seconds": 3.2,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.01,
      "end_seconds": 138.97,
      "duration_seconds": 5.96,
      "text": "My sister had breast cancer. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.53,
      "end_seconds": 144.68,
      "duration_seconds": 4.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.02,
      "end_seconds": 149.22,
      "duration_seconds": 3.2,
      "text": "Thyroxine, 75 micrograms, every morning"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 149.79,
      "end_seconds": 157.72,
      "duration_seconds": 7.93,
      "text": "It's, It's meant to be every morning, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.97,
      "end_seconds": 162.57,
      "duration_seconds": 3.6,
      "text": "it's a plain moisturiser, twice a day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.9,
      "end_seconds": 166.86,
      "duration_seconds": 2.96,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.23,
      "end_seconds": 170.05,
      "duration_seconds": 1.82,
      "text": "about six months"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.88,
      "end_seconds": 174.13,
      "duration_seconds": 2.25,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.53,
      "end_seconds": 180.29,
      "duration_seconds": 4.76,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.18,
      "end_seconds": 201.8,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.16,
      "end_seconds": 205.54,
      "duration_seconds": 2.38,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.27,
      "end_seconds": 210.31,
      "duration_seconds": 1.04,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.89,
      "end_seconds": 234.93,
      "duration_seconds": 23.04,
      "text": "I have an underactive thyroid. I didn't want to bother you but it keeps coming back. I've got acid reflux. It's a relief to finally sit down and talk about it. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.9,
      "end_seconds": 237.29,
      "duration_seconds": 1.39,
      "text": "is that everything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.42,
      "end_seconds": 245.17,
      "duration_seconds": 6.75,
      "text": "Alright, gout, that matches what I have here. Okay, and what about spreading or blisters?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.38,
      "end_seconds": 258.83,
      "duration_seconds": 12.45,
      "text": "no, um, no spreading, no blisters i did have a bit of redness at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.42,
      "end_seconds": 263.68,
      "duration_seconds": 1.26,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.62,
      "end_seconds": 269.25,
      "duration_seconds": 3.63,
      "text": "Right, I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 269.85,
      "end_seconds": 275.65,
      "duration_seconds": 5.8,
      "text": "actually, um, doctor, I did notice fever. She doesn't always say"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.83,
      "end_seconds": 284.2,
      "duration_seconds": 7.37,
      "text": "No, you know, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.77,
      "end_seconds": 294.05,
      "duration_seconds": 9.28,
      "text": "Alright, I'll note both what you've said and and what you've noticed. Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.05,
      "end_seconds": 297.63,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.52,
      "end_seconds": 316.69,
      "duration_seconds": 4.17,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.19,
      "end_seconds": 331.18,
      "duration_seconds": 1.99,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.86,
      "end_seconds": 356.64,
      "duration_seconds": 7.78,
      "text": "okay: pulse 71, pressure 114 over 76, temperature is 36.8 degrees, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.6,
      "end_seconds": 361.98,
      "duration_seconds": 2.38,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.07,
      "end_seconds": 366.18,
      "duration_seconds": 2.11,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.82,
      "end_seconds": 371.46,
      "duration_seconds": 2.64,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.13,
      "end_seconds": 374.52,
      "duration_seconds": 1.39,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.24,
      "end_seconds": 388.69,
      "duration_seconds": 6.45,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.89,
      "end_seconds": 423.05,
      "duration_seconds": 30.16,
      "text": "Right, thank you, you can get dressed. From what you've told me and what I found, it fits best with mild contact dermatitis from the watch strap. Eczema is also on my list. Let's use hydrocortisone cream, 1%, once a day, one week. That's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. If it spreads or blisters, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.37,
      "end_seconds": 431.18,
      "duration_seconds": 1.81,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.31,
      "end_seconds": 441.06,
      "duration_seconds": 8.75,
      "text": "I'll want another look if it has not cleared in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.38,
      "end_seconds": 444.15,
      "duration_seconds": 1.77,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 445.6,
      "end_seconds": 446.81,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}