{
  "schema_version": "1.0",
  "encounter_id": "01410",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.79,
      "duration_seconds": 4.71,
      "text": "Mm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 11.91,
      "duration_seconds": 4.76,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.57,
      "end_seconds": 19.45,
      "duration_seconds": 5.88,
      "text": "Okay, so hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.82,
      "end_seconds": 24.88,
      "duration_seconds": 4.06,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.87,
      "end_seconds": 30.01,
      "duration_seconds": 4.14,
      "text": "Erm, he's been having been feeling well, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.42,
      "end_seconds": 35.71,
      "duration_seconds": 4.29,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.38,
      "end_seconds": 45.78,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.18,
      "end_seconds": 69.59,
      "duration_seconds": 12.41,
      "text": "Okay: height 155 centimetres, pressure 126 over 73, temperature 37.0, respiratory rate 14, heart rate 65, SpO2 99 percent on room air, weight 98 kilos."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.31,
      "end_seconds": 71.87,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.29,
      "end_seconds": 80.85,
      "duration_seconds": 7.56,
      "text": "They help me see the whole picture, more shortly. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.17,
      "end_seconds": 84.68,
      "duration_seconds": 2.51,
      "text": "For one week, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.35,
      "end_seconds": 89.15,
      "duration_seconds": 2.8,
      "text": "Alright, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.97,
      "end_seconds": 100.87,
      "duration_seconds": 10.9,
      "text": "Actually, it usually comes with slightly dry skin. Sorry, what was I saying, the slightly dry skin? That's been for four weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.91,
      "end_seconds": 105.88,
      "duration_seconds": 0.97,
      "text": "Any constipation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.05,
      "end_seconds": 108.85,
      "duration_seconds": 1.8,
      "text": "No, no constipation."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 110.84,
      "end_seconds": 115.96,
      "duration_seconds": 5.12,
      "text": "Actually, doctor, I did notice constipation. He doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.88,
      "end_seconds": 124.76,
      "duration_seconds": 6.88,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.22,
      "end_seconds": 136.23,
      "duration_seconds": 8.01,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about palpitations, feeling cold or weight change?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.88,
      "end_seconds": 141.11,
      "duration_seconds": 4.23,
      "text": "No, no palpitations, feeling cold or weight change."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.66,
      "end_seconds": 144.56,
      "duration_seconds": 2.9,
      "text": "I follow. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.13,
      "end_seconds": 147.94,
      "duration_seconds": 2.81,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 151.6,
      "duration_seconds": 2.88,
      "text": "Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.17,
      "end_seconds": 162.75,
      "duration_seconds": 5.58,
      "text": "I take Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.96,
      "end_seconds": 168.33,
      "duration_seconds": 4.37,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.56,
      "end_seconds": 178.45,
      "duration_seconds": 8.89,
      "text": "Not with me. I'll bring it next time. I'm on hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.31,
      "end_seconds": 186.39,
      "duration_seconds": 7.08,
      "text": "Are there any allergies I should be aware of? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.76,
      "end_seconds": 189.8,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.19,
      "end_seconds": 192.83,
      "duration_seconds": 1.64,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.15,
      "end_seconds": 200.98,
      "duration_seconds": 3.83,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.79,
      "end_seconds": 204.87,
      "duration_seconds": 3.08,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.71,
      "end_seconds": 210.63,
      "duration_seconds": 4.92,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.02,
      "end_seconds": 225.68,
      "duration_seconds": 3.66,
      "text": "Right, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.68,
      "end_seconds": 240.46,
      "duration_seconds": 9.78,
      "text": "An underactive thyroid, for five years. I've never really been one for hospitals. I have high blood pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.69,
      "end_seconds": 244.55,
      "duration_seconds": 2.86,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.47,
      "end_seconds": 248.23,
      "duration_seconds": 2.76,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.47,
      "end_seconds": 267.46,
      "duration_seconds": 4.99,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.85,
      "end_seconds": 274.79,
      "duration_seconds": 1.94,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.77,
      "end_seconds": 290.05,
      "duration_seconds": 7.28,
      "text": "Stop me if I've got anything wrong. You've been feeling well for one week, and no feeling cold."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.56,
      "end_seconds": 294.42,
      "duration_seconds": 2.86,
      "text": "That's it, uh, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.12,
      "end_seconds": 307.57,
      "duration_seconds": 11.45,
      "text": "A thyroid blood test is what I'd like next, for annual review. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.82,
      "end_seconds": 309.91,
      "duration_seconds": 1.09,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.64,
      "end_seconds": 333.87,
      "duration_seconds": 23.23,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up in twelve months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.28,
      "end_seconds": 338.01,
      "duration_seconds": 2.73,
      "text": "That's clear, you know, thanks."
    }
  ]
}