{
  "schema_version": "1.0",
  "encounter_id": "01186",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 3.78,
      "duration_seconds": 2.46,
      "text": "Good afternoon, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.78,
      "end_seconds": 9.5,
      "duration_seconds": 4.72,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.91,
      "end_seconds": 16.16,
      "duration_seconds": 5.25,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.84,
      "end_seconds": 21.86,
      "duration_seconds": 3.02,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.14,
      "end_seconds": 29.45,
      "duration_seconds": 6.31,
      "text": "It's been wanting contraception, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.33,
      "end_seconds": 34.43,
      "duration_seconds": 4.1,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.4,
      "end_seconds": 49.98,
      "duration_seconds": 2.58,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.46,
      "end_seconds": 80.42,
      "duration_seconds": 8.96,
      "text": "Okay: blood pressure 108 over 79, pulse is 82 beats a minute, temp 36.5 degrees. And oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.44,
      "end_seconds": 84.42,
      "duration_seconds": 1.98,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.41,
      "end_seconds": 88.9,
      "duration_seconds": 2.49,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.04,
      "end_seconds": 106.81,
      "duration_seconds": 2.77,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.04,
      "end_seconds": 111.19,
      "duration_seconds": 3.15,
      "text": "Oh, for two months, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.12,
      "end_seconds": 116.27,
      "duration_seconds": 3.15,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 134.63,
      "duration_seconds": 16.56,
      "text": "I'd give it a three, out of ten. As for slightly heavy periods, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.92,
      "end_seconds": 141.56,
      "duration_seconds": 5.64,
      "text": "Did you get breast lumps, blood clots, smoking or migraine with aura?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.36,
      "end_seconds": 149.85,
      "duration_seconds": 6.49,
      "text": "No breast lumps, blood clots, smoking or migraine with aura, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.94,
      "end_seconds": 155.34,
      "duration_seconds": 3.4,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.44,
      "end_seconds": 159.0,
      "duration_seconds": 1.56,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.36,
      "end_seconds": 163.31,
      "duration_seconds": 2.95,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.47,
      "end_seconds": 168.22,
      "duration_seconds": 3.75,
      "text": "Diclofenac. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.7,
      "end_seconds": 172.64,
      "duration_seconds": 2.94,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.74,
      "end_seconds": 185.23,
      "duration_seconds": 10.49,
      "text": "I had my septum straightened in my thirties. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.25,
      "end_seconds": 188.17,
      "duration_seconds": 0.92,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.8,
      "end_seconds": 195.12,
      "duration_seconds": 2.32,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.97,
      "end_seconds": 201.23,
      "duration_seconds": 4.26,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.24,
      "end_seconds": 207.11,
      "duration_seconds": 3.87,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.3,
      "end_seconds": 212.75,
      "duration_seconds": 2.45,
      "text": "Alright, do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.56,
      "end_seconds": 217.15,
      "duration_seconds": 2.59,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.68,
      "end_seconds": 235.66,
      "duration_seconds": 3.98,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.7,
      "end_seconds": 239.34,
      "duration_seconds": 2.64,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.35,
      "end_seconds": 242.33,
      "duration_seconds": 1.98,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.42,
      "end_seconds": 246.11,
      "duration_seconds": 2.69,
      "text": "I've, I've got heart failure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.86,
      "end_seconds": 249.37,
      "duration_seconds": 2.51,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 255.51,
      "end_seconds": 261.15,
      "duration_seconds": 5.64,
      "text": "Um, it's furosemide, 40 milligrams, every morning for the fluid, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.79,
      "end_seconds": 290.81,
      "duration_seconds": 19.02,
      "text": "Right, here's what I'm thinking. My working impression is suitable for hormonal contraception with no risk factors. The treatment will be levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That should help with contraception."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.32,
      "end_seconds": 296.11,
      "duration_seconds": 3.79,
      "text": "Erm, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.73,
      "end_seconds": 313.88,
      "duration_seconds": 17.15,
      "text": "Take the pill at the same time each day and use condoms if you miss two. If you get leg swelling or severe headaches, that's the point to come in urgently. Let's review you in three months."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.0,
      "end_seconds": 320.29,
      "duration_seconds": 3.29,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.08,
      "end_seconds": 325.51,
      "duration_seconds": 4.43,
      "text": "Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.47,
      "end_seconds": 330.18,
      "duration_seconds": 2.71,
      "text": "Well, alright, thanks, take care."
    }
  ]
}