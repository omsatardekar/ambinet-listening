{
  "schema_version": "1.0",
  "encounter_id": "01077",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 6.74,
      "duration_seconds": 5.51,
      "text": "Hi, um, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.15,
      "end_seconds": 12.57,
      "duration_seconds": 4.42,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.57,
      "end_seconds": 20.18,
      "duration_seconds": 6.61,
      "text": "It's a high fever. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.92,
      "end_seconds": 25.34,
      "duration_seconds": 3.42,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.86,
      "end_seconds": 33.23,
      "duration_seconds": 3.37,
      "text": "it's been like this since Monday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.95,
      "end_seconds": 39.12,
      "duration_seconds": 5.17,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 42.96,
      "duration_seconds": 1.8,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.3,
      "end_seconds": 47.82,
      "duration_seconds": 3.52,
      "text": "Have you had any cough or recent head injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.11,
      "end_seconds": 54.45,
      "duration_seconds": 3.34,
      "text": "Actually, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.51,
      "end_seconds": 58.2,
      "duration_seconds": 2.69,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.92,
      "end_seconds": 60.85,
      "duration_seconds": 0.93,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.55,
      "end_seconds": 65.0,
      "duration_seconds": 2.45,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.96,
      "end_seconds": 69.78,
      "duration_seconds": 3.82,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.93,
      "end_seconds": 72.61,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.67,
      "end_seconds": 77.04,
      "duration_seconds": 3.37,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.93,
      "end_seconds": 82.3,
      "duration_seconds": 4.37,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.35,
      "end_seconds": 87.14,
      "duration_seconds": 2.79,
      "text": "mm, no allergies at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.81,
      "end_seconds": 100.07,
      "duration_seconds": 4.26,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.66,
      "end_seconds": 104.88,
      "duration_seconds": 3.22,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.59,
      "end_seconds": 110.31,
      "duration_seconds": 3.72,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.08,
      "end_seconds": 114.8,
      "duration_seconds": 2.72,
      "text": "Yeah, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.47,
      "end_seconds": 133.48,
      "duration_seconds": 3.01,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.48,
      "end_seconds": 136.23,
      "duration_seconds": 1.75,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.22,
      "end_seconds": 141.61,
      "duration_seconds": 4.39,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.51,
      "end_seconds": 152.61,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 169.12,
      "duration_seconds": 6.96,
      "text": "okay: temp 38.6 degrees, pressure 106 over 66, pulse 106. And oxygen saturation is 96 percent"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.65,
      "end_seconds": 175.4,
      "duration_seconds": 3.75,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.78,
      "end_seconds": 194.89,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.59,
      "end_seconds": 198.03,
      "duration_seconds": 1.44,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.41,
      "end_seconds": 223.95,
      "duration_seconds": 8.54,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.41,
      "end_seconds": 231.33,
      "duration_seconds": 1.92,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.76,
      "end_seconds": 246.79,
      "duration_seconds": 6.03,
      "text": "From what you've told me and what I found, it points towards possible bacterial meningitis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.63,
      "end_seconds": 249.73,
      "duration_seconds": 2.1,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.11,
      "end_seconds": 283.74,
      "duration_seconds": 32.63,
      "text": "I understand the worry. At the moment I'd say it's possible bacterial meningitis, and we'll know more once the blood cultures is back. I'll request blood cultures, it'll help with possible meningitis. I'll start you on benzylpenicillin, 1.2 grams, once now, single dose. That's for possible meningitis. Call an ambulance now, this is an emergency. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.55,
      "end_seconds": 294.87,
      "duration_seconds": 9.32,
      "text": "Please don't wait if you cannot go now. That's when to be seen urgently. See me again straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.77,
      "end_seconds": 298.02,
      "duration_seconds": 2.25,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.2,
      "end_seconds": 303.74,
      "duration_seconds": 4.54,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.39,
      "end_seconds": 307.47,
      "duration_seconds": 3.08,
      "text": "Thank you, uh, doctor, goodbye."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.49,
      "end_seconds": 310.82,
      "duration_seconds": 2.33,
      "text": "Have a a good day."
    }
  ]
}