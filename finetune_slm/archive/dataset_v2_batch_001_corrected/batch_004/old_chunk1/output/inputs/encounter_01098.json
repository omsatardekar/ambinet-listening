{
  "schema_version": "1.0",
  "encounter_id": "01098",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.79,
      "end_seconds": 8.23,
      "duration_seconds": 7.44,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.46,
      "end_seconds": 14.23,
      "duration_seconds": 4.77,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.83,
      "end_seconds": 22.68,
      "duration_seconds": 7.85,
      "text": "So, you know, I've been sweating, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.22,
      "end_seconds": 27.38,
      "duration_seconds": 3.16,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.13,
      "end_seconds": 41.25,
      "duration_seconds": 12.12,
      "text": "I've had it for about three months. I've been putting this off for weeks. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.32,
      "end_seconds": 45.31,
      "duration_seconds": 1.99,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.3,
      "end_seconds": 49.84,
      "duration_seconds": 2.54,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.25,
      "end_seconds": 51.35,
      "duration_seconds": 1.1,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.46,
      "end_seconds": 65.54,
      "duration_seconds": 13.08,
      "text": "And crushing chest pain, too. Oh, and pain going into my left arm. That's been about the same, about a month."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.04,
      "end_seconds": 74.05,
      "duration_seconds": 2.01,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.99,
      "end_seconds": 78.1,
      "duration_seconds": 2.11,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.02,
      "end_seconds": 82.59,
      "duration_seconds": 3.57,
      "text": "Have you been sweating at any time before this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.95,
      "end_seconds": 90.13,
      "duration_seconds": 6.18,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 91.56,
      "end_seconds": 105.18,
      "duration_seconds": 13.62,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 96 percent, pulse is 106 beats a minute, respiratory rate 16. Temp 36.6 degrees, blood pressure 135 over 81."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.07,
      "end_seconds": 106.77,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.72,
      "end_seconds": 113.56,
      "duration_seconds": 3.84,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.85,
      "end_seconds": 117.06,
      "duration_seconds": 2.21,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.22,
      "end_seconds": 128.31,
      "duration_seconds": 4.09,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.66,
      "end_seconds": 135.33,
      "duration_seconds": 2.67,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.94,
      "end_seconds": 152.39,
      "duration_seconds": 4.45,
      "text": "Have you had any leg swelling, fever or cough?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.91,
      "end_seconds": 156.13,
      "duration_seconds": 3.22,
      "text": "Uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.23,
      "end_seconds": 159.99,
      "duration_seconds": 2.76,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.44,
      "end_seconds": 164.8,
      "duration_seconds": 3.36,
      "text": "Yeah, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.4,
      "end_seconds": 169.55,
      "duration_seconds": 4.15,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.43,
      "end_seconds": 177.06,
      "duration_seconds": 4.63,
      "text": "Let me think, no, that side's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.94,
      "end_seconds": 181.84,
      "duration_seconds": 2.9,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.93,
      "end_seconds": 187.7,
      "duration_seconds": 3.77,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.04,
      "end_seconds": 208.71,
      "duration_seconds": 4.67,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 210.37,
      "end_seconds": 212.65,
      "duration_seconds": 2.28,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.65,
      "end_seconds": 218.96,
      "duration_seconds": 4.31,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.87,
      "end_seconds": 224.32,
      "duration_seconds": 3.45,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.66,
      "end_seconds": 229.84,
      "duration_seconds": 4.18,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.64,
      "end_seconds": 235.42,
      "duration_seconds": 3.78,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.43,
      "end_seconds": 239.56,
      "duration_seconds": 2.13,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.19,
      "end_seconds": 245.42,
      "duration_seconds": 4.23,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 249.74,
      "duration_seconds": 3.15,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.09,
      "end_seconds": 257.32,
      "duration_seconds": 6.23,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.14,
      "end_seconds": 262.45,
      "duration_seconds": 3.31,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 264.39,
      "end_seconds": 267.09,
      "duration_seconds": 2.7,
      "text": "I've, I've got high cholesterol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.68,
      "end_seconds": 270.01,
      "duration_seconds": 1.33,
      "text": "So, anything else?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.15,
      "end_seconds": 276.46,
      "duration_seconds": 5.31,
      "text": "I mean, you know, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.46,
      "end_seconds": 282.58,
      "duration_seconds": 4.12,
      "text": "Mm-hmm. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.89,
      "end_seconds": 293.36,
      "duration_seconds": 9.47,
      "text": "I'm on rosuvastatin, 10 milligrams, at night. It's metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.67,
      "end_seconds": 296.94,
      "duration_seconds": 2.27,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.84,
      "end_seconds": 304.69,
      "duration_seconds": 6.85,
      "text": "About about three months. I was on atorvastatin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.95,
      "end_seconds": 323.97,
      "duration_seconds": 8.02,
      "text": "Okay, thinking it through, I can't pin this down yet. We're looking at a possible heart attack or unstable angina."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 326.0,
      "end_seconds": 332.09,
      "duration_seconds": 6.09,
      "text": "Well, um, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.25,
      "end_seconds": 364.44,
      "duration_seconds": 29.19,
      "text": "I can't promise yet, but most people with a possible heart attack do well once it's treated properly. We should do a troponin blood test for chest pain. That will help us see what's going on underneath and decide the next step. For this, aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 366.29,
      "end_seconds": 367.47,
      "duration_seconds": 1.18,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.76,
      "end_seconds": 386.91,
      "duration_seconds": 15.15,
      "text": "Stay lying down and do not eat or drink. Let's get you seen by the cardiac team, I'll arrange the letter. I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 387.81,
      "end_seconds": 392.82,
      "duration_seconds": 5.01,
      "text": "Okay, so okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.85,
      "end_seconds": 396.17,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}