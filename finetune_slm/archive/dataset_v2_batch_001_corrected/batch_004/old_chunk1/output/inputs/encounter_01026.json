{
  "schema_version": "1.0",
  "encounter_id": "01026",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 2.47,
      "duration_seconds": 1.6,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.21,
      "end_seconds": 4.27,
      "duration_seconds": 1.06,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.11,
      "end_seconds": 12.84,
      "duration_seconds": 2.73,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.82,
      "end_seconds": 21.36,
      "duration_seconds": 6.54,
      "text": "Honestly, it's a cut on my finger, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.79,
      "end_seconds": 22.72,
      "duration_seconds": 0.93,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.75,
      "end_seconds": 28.4,
      "duration_seconds": 4.65,
      "text": "I've had a little bleeding too, for two months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.83,
      "end_seconds": 37.89,
      "duration_seconds": 2.06,
      "text": "Any numbness or dirty blade?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.6,
      "end_seconds": 44.29,
      "duration_seconds": 5.69,
      "text": "Hmm, I haven't had numbness or dirty blade, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.73,
      "end_seconds": 49.16,
      "duration_seconds": 4.43,
      "text": "Hm, okay. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.29,
      "end_seconds": 51.9,
      "duration_seconds": 1.61,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.94,
      "end_seconds": 55.25,
      "duration_seconds": 2.31,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.23,
      "end_seconds": 57.24,
      "duration_seconds": 1.01,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.88,
      "end_seconds": 61.34,
      "duration_seconds": 2.46,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.76,
      "end_seconds": 67.77,
      "duration_seconds": 5.01,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.84,
      "end_seconds": 75.58,
      "duration_seconds": 5.74,
      "text": "Alright, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.9,
      "end_seconds": 82.27,
      "duration_seconds": 5.37,
      "text": "I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.75,
      "end_seconds": 87.61,
      "duration_seconds": 3.86,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.53,
      "end_seconds": 106.56,
      "duration_seconds": 18.03,
      "text": "I used to drink heavily but I stopped four years ago. I retired from the post office two years ago. I drink a lot of tea and snack through the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.96,
      "end_seconds": 111.53,
      "duration_seconds": 3.57,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.64,
      "end_seconds": 117.09,
      "duration_seconds": 4.45,
      "text": "I have an enlarged prostate, for about ten years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 126.75,
      "duration_seconds": 8.02,
      "text": "Right, which medicines do you take at the moment? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.78,
      "end_seconds": 131.61,
      "duration_seconds": 2.83,
      "text": "Tamsulosin, at night for the prostate."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.59,
      "end_seconds": 136.01,
      "duration_seconds": 2.42,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.83,
      "end_seconds": 138.27,
      "duration_seconds": 1.44,
      "text": "0.4 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.32,
      "end_seconds": 160.25,
      "duration_seconds": 3.93,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.97,
      "end_seconds": 164.29,
      "duration_seconds": 2.32,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.22,
      "end_seconds": 167.63,
      "duration_seconds": 2.41,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.85,
      "end_seconds": 176.78,
      "duration_seconds": 2.93,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.74,
      "end_seconds": 197.04,
      "duration_seconds": 3.3,
      "text": "Okay: pulse 70, BP is 111 over 71."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.75,
      "end_seconds": 201.27,
      "duration_seconds": 2.52,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.14,
      "end_seconds": 217.08,
      "duration_seconds": 0.94,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.73,
      "end_seconds": 221.1,
      "duration_seconds": 2.37,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.51,
      "end_seconds": 244.99,
      "duration_seconds": 6.48,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.45,
      "end_seconds": 261.18,
      "duration_seconds": 10.73,
      "text": "That's the examination finished. Let me tell you where I've got to. My working impression is a minor clean wound that needs only dressing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.66,
      "end_seconds": 265.67,
      "duration_seconds": 3.01,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.15,
      "end_seconds": 290.94,
      "duration_seconds": 23.79,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor clean wound that needs only dressing. I'll close it with adhesive strips and keep it dry for two days. Come back if it looks red or swollen. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.97,
      "end_seconds": 299.92,
      "duration_seconds": 6.95,
      "text": "So, I come back if it looks red or swollen. Is that right?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.63,
      "end_seconds": 307.36,
      "duration_seconds": 5.73,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.12,
      "end_seconds": 311.93,
      "duration_seconds": 2.81,
      "text": "Great, thank you for your help."
    }
  ]
}