{
  "schema_version": "1.0",
  "encounter_id": "01010",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 6.81,
      "duration_seconds": 6.24,
      "text": "Erm, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.42,
      "end_seconds": 11.39,
      "duration_seconds": 3.97,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.8,
      "end_seconds": 33.5,
      "duration_seconds": 16.7,
      "text": "So, um, I've been sweating, doctor. I wasn't sure whether to come in at all, to be honest. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.8,
      "end_seconds": 41.75,
      "duration_seconds": 2.95,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.47,
      "end_seconds": 45.24,
      "duration_seconds": 1.77,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.3,
      "end_seconds": 50.62,
      "duration_seconds": 3.32,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 54.76,
      "duration_seconds": 2.44,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.27,
      "end_seconds": 59.17,
      "duration_seconds": 3.9,
      "text": "Mm, okay. Okay, how often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.4,
      "end_seconds": 62.73,
      "duration_seconds": 2.33,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.49,
      "end_seconds": 66.79,
      "duration_seconds": 3.3,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.94,
      "end_seconds": 70.89,
      "duration_seconds": 1.95,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.13,
      "end_seconds": 77.51,
      "duration_seconds": 5.38,
      "text": "What about pain going into your left arm, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.84,
      "end_seconds": 97.37,
      "duration_seconds": 18.53,
      "text": "Yes, about the same, about two weeks. With pain going into my left arm, I'd say mild. And I've been feeling sick as well, since yesterday. With feeling sick, I'd say moderate."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.23,
      "end_seconds": 101.87,
      "duration_seconds": 3.64,
      "text": "Have you been sweating at any time before this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.46,
      "end_seconds": 112.12,
      "duration_seconds": 9.66,
      "text": "Sorry, what was I saying, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.51,
      "end_seconds": 122.37,
      "duration_seconds": 0.86,
      "text": "Any cough?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.97,
      "end_seconds": 125.86,
      "duration_seconds": 1.89,
      "text": "Nope, no cough."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.38,
      "end_seconds": 128.97,
      "duration_seconds": 2.59,
      "text": "Alright, any leg swelling or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.31,
      "end_seconds": 134.37,
      "duration_seconds": 4.06,
      "text": "I haven't had leg swelling or fever, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.17,
      "end_seconds": 138.69,
      "duration_seconds": 2.52,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.62,
      "end_seconds": 143.42,
      "duration_seconds": 2.8,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.47,
      "end_seconds": 157.01,
      "duration_seconds": 3.54,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.04,
      "end_seconds": 169.57,
      "duration_seconds": 11.53,
      "text": "Erm, you know, yes, high blood pressure. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.48,
      "end_seconds": 171.87,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.68,
      "end_seconds": 181.35,
      "duration_seconds": 4.67,
      "text": "No, um, I've never been operated on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.54,
      "end_seconds": 186.52,
      "duration_seconds": 3.98,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.54,
      "end_seconds": 202.95,
      "duration_seconds": 15.41,
      "text": "I retired from the post office two years ago. I swim twice a week. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.82,
      "end_seconds": 207.76,
      "duration_seconds": 3.94,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.83,
      "end_seconds": 215.59,
      "duration_seconds": 5.76,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.15,
      "end_seconds": 221.05,
      "duration_seconds": 2.9,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.53,
      "end_seconds": 223.82,
      "duration_seconds": 1.29,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.39,
      "end_seconds": 240.44,
      "duration_seconds": 4.05,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.45,
      "end_seconds": 258.56,
      "duration_seconds": 2.11,
      "text": "Okay, um, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.71,
      "end_seconds": 271.94,
      "duration_seconds": 11.23,
      "text": "Thank you, you can get dressed. Let me just check I've got this right. You've been sweating, since yesterday, moderate, and no leg swelling or fever."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.85,
      "end_seconds": 274.81,
      "duration_seconds": 1.96,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.34,
      "end_seconds": 281.67,
      "duration_seconds": 5.33,
      "text": "I'll request a troponin blood test, it'll help with chest pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.7,
      "end_seconds": 286.34,
      "duration_seconds": 2.64,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.39,
      "end_seconds": 314.89,
      "duration_seconds": 23.5,
      "text": "Let's get an ECG, for chest pain. The treatment will be aspirin, 300 milligrams, once now, single dose. That's for possible heart attack. Stay lying down and do not eat or drink. The cardiac team would be the right next step, I'll refer you. We'll catch up straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.88,
      "end_seconds": 321.75,
      "duration_seconds": 4.87,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}