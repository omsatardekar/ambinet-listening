{
  "schema_version": "1.0",
  "encounter_id": "01491",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 7.41,
      "duration_seconds": 6.72,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.49,
      "end_seconds": 13.47,
      "duration_seconds": 3.98,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.03,
      "end_seconds": 19.75,
      "duration_seconds": 5.72,
      "text": "Yeah, it's a severe sore throat. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.05,
      "end_seconds": 25.0,
      "duration_seconds": 3.95,
      "text": "Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.72,
      "end_seconds": 41.24,
      "duration_seconds": 15.52,
      "text": "Erm, it's been like this since yesterday. I didn't want to make a fuss, you know. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.81,
      "end_seconds": 44.02,
      "duration_seconds": 2.21,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.77,
      "end_seconds": 48.53,
      "duration_seconds": 2.76,
      "text": "Swallowing definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.14,
      "end_seconds": 53.05,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.63,
      "end_seconds": 55.42,
      "duration_seconds": 1.79,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.79,
      "end_seconds": 59.21,
      "duration_seconds": 2.42,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.44,
      "end_seconds": 69.95,
      "duration_seconds": 6.51,
      "text": "When it starts I tend to get a muffled voice as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.96,
      "end_seconds": 72.82,
      "duration_seconds": 1.86,
      "text": "Any drooling as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.32,
      "end_seconds": 82.35,
      "duration_seconds": 9.03,
      "text": "Yes, about the same, three weeks. Well, the muffled voice? That's been for about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.54,
      "end_seconds": 86.9,
      "duration_seconds": 3.36,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.4,
      "end_seconds": 96.92,
      "duration_seconds": 2.52,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.73,
      "end_seconds": 116.36,
      "duration_seconds": 7.63,
      "text": "Okay: respiratory rate 22, saturation 89 percent. And pulse 95, blood pressure 118 over 78, temperature 36.7."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.04,
      "end_seconds": 119.19,
      "duration_seconds": 2.15,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.53,
      "end_seconds": 125.08,
      "duration_seconds": 4.55,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.82,
      "end_seconds": 130.09,
      "duration_seconds": 3.27,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.76,
      "end_seconds": 141.49,
      "duration_seconds": 1.73,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.2,
      "end_seconds": 145.18,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.31,
      "end_seconds": 158.5,
      "duration_seconds": 4.19,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.46,
      "end_seconds": 167.28,
      "duration_seconds": 4.82,
      "text": "Alright, you can relax now. And what about rash or cough?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.43,
      "end_seconds": 171.84,
      "duration_seconds": 3.41,
      "text": "No rash or cough, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.22,
      "end_seconds": 178.06,
      "duration_seconds": 2.84,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.67,
      "end_seconds": 181.09,
      "duration_seconds": 1.42,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.3,
      "end_seconds": 184.92,
      "duration_seconds": 2.62,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.62,
      "end_seconds": 187.17,
      "duration_seconds": 1.55,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.69,
      "end_seconds": 207.7,
      "duration_seconds": 5.01,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.78,
      "end_seconds": 210.27,
      "duration_seconds": 1.49,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.41,
      "end_seconds": 217.82,
      "duration_seconds": 2.41,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.62,
      "end_seconds": 224.58,
      "duration_seconds": 4.96,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.5,
      "end_seconds": 230.47,
      "duration_seconds": 3.97,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.7,
      "end_seconds": 239.14,
      "duration_seconds": 3.44,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.94,
      "end_seconds": 242.68,
      "duration_seconds": 1.74,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.44,
      "end_seconds": 248.32,
      "duration_seconds": 3.88,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.57,
      "end_seconds": 251.4,
      "duration_seconds": 1.83,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.11,
      "end_seconds": 255.33,
      "duration_seconds": 3.22,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.01,
      "end_seconds": 257.73,
      "duration_seconds": 1.72,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.82,
      "end_seconds": 261.18,
      "duration_seconds": 2.36,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.12,
      "end_seconds": 282.8,
      "duration_seconds": 2.68,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.6,
      "end_seconds": 288.01,
      "duration_seconds": 4.41,
      "text": "Um, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.21,
      "end_seconds": 308.21,
      "duration_seconds": 19.0,
      "text": "Taking everything into account, it fits best with a possible airway infection that needs emergency care. Severe tonsillitis is also on my list. I'm going to order an urgent airway assessment, for stridor and drooling. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.0,
      "end_seconds": 314.06,
      "duration_seconds": 4.06,
      "text": "Ah, um, how long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.09,
      "end_seconds": 325.57,
      "duration_seconds": 9.48,
      "text": "Do not lie flat, I am calling an ambulance now. I think the emergency ENT team should see you too."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.0,
      "end_seconds": 328.67,
      "duration_seconds": 1.67,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.17,
      "end_seconds": 335.89,
      "duration_seconds": 5.72,
      "text": "Let's review you straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.73,
      "end_seconds": 341.8,
      "duration_seconds": 4.07,
      "text": "Um, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.34,
      "end_seconds": 344.71,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
}