{
  "schema_version": "1.0",
  "encounter_id": "01163",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 8.21,
      "duration_seconds": 6.9,
      "text": "Good morning, grab a seat. Right, is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.41,
      "end_seconds": 18.69,
      "duration_seconds": 5.28,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.9,
      "end_seconds": 22.34,
      "duration_seconds": 2.44,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.12,
      "end_seconds": 28.94,
      "duration_seconds": 5.82,
      "text": "I wanted to get sharp pain when I breathe in looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.57,
      "end_seconds": 32.82,
      "duration_seconds": 3.25,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.92,
      "end_seconds": 39.49,
      "duration_seconds": 5.57,
      "text": "Escitalopram. I take it 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.56,
      "end_seconds": 45.34,
      "duration_seconds": 4.78,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.9,
      "end_seconds": 61.13,
      "duration_seconds": 14.23,
      "text": "Oh, no, it's at home. Tiotropium inhaler. I take it once a day for my chest. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.27,
      "end_seconds": 71.26,
      "duration_seconds": 2.99,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.35,
      "end_seconds": 94.6,
      "duration_seconds": 21.25,
      "text": "I'd say severe. I've also been coughing up a little blood, for three days. With coughing up a little blood, it happens every other day. I've had a swollen painful calf too, for about four days. As for swollen painful calf, walking definitely sets it off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.64,
      "end_seconds": 100.09,
      "duration_seconds": 4.45,
      "text": "A few quick ones: chest tightness, wheeze or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.16,
      "end_seconds": 105.53,
      "duration_seconds": 3.37,
      "text": "No, no chest tightness, wheeze or fever."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.12,
      "end_seconds": 108.72,
      "duration_seconds": 2.6,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.51,
      "end_seconds": 110.56,
      "duration_seconds": 1.05,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.74,
      "end_seconds": 114.95,
      "duration_seconds": 3.21,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.39,
      "end_seconds": 121.46,
      "duration_seconds": 5.07,
      "text": "My mother has an underactive thyroid. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.77,
      "end_seconds": 125.98,
      "duration_seconds": 3.21,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 130.22,
      "duration_seconds": 2.83,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.02,
      "end_seconds": 134.01,
      "duration_seconds": 1.99,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.39,
      "end_seconds": 142.09,
      "duration_seconds": 3.7,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.84,
      "end_seconds": 147.63,
      "duration_seconds": 3.79,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.28,
      "end_seconds": 150.62,
      "duration_seconds": 2.34,
      "text": "Yes, anxiety. Yes, COPD."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.9,
      "end_seconds": 169.43,
      "duration_seconds": 2.53,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.15,
      "end_seconds": 174.2,
      "duration_seconds": 3.05,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.15,
      "end_seconds": 187.45,
      "duration_seconds": 5.3,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.33,
      "end_seconds": 197.72,
      "duration_seconds": 9.39,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.92,
      "end_seconds": 201.78,
      "duration_seconds": 2.86,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.4,
      "end_seconds": 208.1,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.09,
      "end_seconds": 211.07,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.06,
      "end_seconds": 232.06,
      "duration_seconds": 7.0,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.36,
      "end_seconds": 234.52,
      "duration_seconds": 1.16,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.38,
      "end_seconds": 256.34,
      "duration_seconds": 16.96,
      "text": "You can relax now. Taking everything into account, it fits best with a possible blood clot in the lung. A chest infection is still possible. I'm sending you for a D-dimer blood test because of possible clot."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 257.89,
      "end_seconds": 261.12,
      "duration_seconds": 3.23,
      "text": "I can book that for Thursday at 9 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.27,
      "end_seconds": 264.34,
      "duration_seconds": 2.07,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.53,
      "end_seconds": 279.43,
      "duration_seconds": 13.9,
      "text": "I'm sending you for a CT scan of the chest because of breathlessness. You need to go to hospital now for a scan. I think the medical team should see you too."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.51,
      "end_seconds": 282.21,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.61,
      "end_seconds": 291.96,
      "duration_seconds": 8.35,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.42,
      "end_seconds": 295.01,
      "duration_seconds": 1.59,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.54,
      "end_seconds": 304.99,
      "duration_seconds": 9.45,
      "text": "Please don't wait if you feel faint. That's when to be seen urgently. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.56,
      "end_seconds": 311.63,
      "duration_seconds": 5.07,
      "text": "Sorry, what was I saying, alright, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.32,
      "end_seconds": 315.46,
      "duration_seconds": 3.14,
      "text": "Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.29,
      "end_seconds": 320.67,
      "duration_seconds": 3.38,
      "text": "Oh, great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.92,
      "end_seconds": 323.39,
      "duration_seconds": 1.47,
      "text": "Look after yourself."
    }
  ]
}