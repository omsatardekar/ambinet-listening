      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.79,
      "end_seconds": 171.14,
      "duration_seconds": 4.35,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.44,
      "end_seconds": 174.54,
      "duration_seconds": 2.1,
      "text": "is there someone at home?"
    },
