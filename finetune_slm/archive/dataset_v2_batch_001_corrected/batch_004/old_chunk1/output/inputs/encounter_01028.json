      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.15,
      "end_seconds": 178.79,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.95,
      "end_seconds": 182.63,
      "duration_seconds": 2.68,
      "text": "Have you had any previous surgeries?"
