    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.13,
      "end_seconds": 221.64,
      "duration_seconds": 2.51,
      "text": "yeah, you know, no problem"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.59,
      "end_seconds": 225.55,
      "duration_seconds": 1.96,
      "text": "alright, breathe out slowly"
