    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.32,
      "end_seconds": 242.38,
      "duration_seconds": 5.06,
      "text": "your pulse is steady and and your thyroid feels normal in size"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.66,
      "end_seconds": 252.97,
      "duration_seconds": 7.31,
      "text": "Good you can sit up again. Right here's what I'm thinking. It It points towards well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.69,
      "end_seconds": 257.89,
      "duration_seconds": 3.2,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.75,
      "end_seconds": 268.98,
      "duration_seconds": 9.23,
      "text": "nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement, but I'd like to confirm"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.14,
      "end_seconds": 297.27,
      "duration_seconds": 17.13,
      "text": "I think a thyroid blood test makes sense here for annual review. Keep taking the tablet on an empty stomach apart from coffee. I'll want another look in twelve months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.89,
      "end_seconds": 301.0,
