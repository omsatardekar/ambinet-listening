      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.29,
      "end_seconds": 209.85,
      "duration_seconds": 4.56,
      "text": "Alright over here please and I'll take a a look."
