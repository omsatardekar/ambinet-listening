      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.59,
      "end_seconds": 187.56,
      "duration_seconds": 2.97,
      "text": "nothing I haven't had any operations"
