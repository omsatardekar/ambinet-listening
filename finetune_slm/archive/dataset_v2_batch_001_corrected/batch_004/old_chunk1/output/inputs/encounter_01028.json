    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 188.42,
      "end_seconds": 200.49,
      "duration_seconds": 12.07,
      "text": "here are the numbers, doctor. Temp 36.6 degrees, SpO2 97 percent on room air, blood pressure 117 over 82, respiratory rate 14, pulse is 74 beats a a minute"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.94,
      "end_seconds": 202.64,
      "duration_seconds": 0.7,
      "text": "Thanks."
