      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.31,
      "end_seconds": 93.75,
      "duration_seconds": 3.44,
      "text": "right what line of work are you in?"
