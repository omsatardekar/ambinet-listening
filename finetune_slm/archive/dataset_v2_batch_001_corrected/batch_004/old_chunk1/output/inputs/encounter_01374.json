    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.04,
      "end_seconds": 144.02,
      "duration_seconds": 4.98,
      "text": "I'm allergic to diclofenac, I get swelling of my lips."
