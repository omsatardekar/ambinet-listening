      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.49,
      "end_seconds": 184.37,
      "duration_seconds": 2.88,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 213.42,
      "duration_seconds": 10.42,
      "text": "okay: pulse is 118 beats a a minute pressure 118 over 78 temperature is 36.7 degrees oxygen saturation is 98 percent"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.58,
      "end_seconds": 220.09,
      "duration_seconds": 4.51,
      "text": "I'll need to examine you for this it won't take long"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.54,
      "end_seconds": 223.93,
      "duration_seconds": 2.39,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.73,
      "end_seconds": 246.51,
      "duration_seconds": 6.78,
      "text": "you look pale your pulse is fast and your tummy is tender at the top"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.92,
      "end_seconds": 252.52,
      "duration_seconds": 1.6,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.61,
      "end_seconds": 282.7,
      "duration_seconds": 18.09,
      "text": "putting it all together, it points towards a possible bleeding stomach ulcer. The reason I say that is that your story and my examination fit together. I'd like to arrange urgent blood tests for bleeding. I'd like to arrange an endoscopy for bleeding"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.38,
      "end_seconds": 286.2,
      "duration_seconds": 1.82,
      "text": "okay I'll do it"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.83,
      "end_seconds": 312.8,
      "duration_seconds": 24.97,
      "text": "Please stop the ibuprofen and do not eat or drink. The emergency team would be the right next step, I'll refer you. One warning sign to remember: you vomit again. In that case don't wait. Please come and see me straight away. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.8,
      "end_seconds": 318.71,
      "duration_seconds": 4.91,
      "text": "so, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.49,
      "end_seconds": 323.54,
      "duration_seconds": 4.05,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
