    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.11,
      "end_seconds": 149.1,
      "duration_seconds": 3.99,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.06,
      "end_seconds": 153.39,
      "duration_seconds": 3.33,
      "text": "no I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.91,
      "end_seconds": 170.41,
      "duration_seconds": 2.5,
      "text": "Let me quickly check your readings."
