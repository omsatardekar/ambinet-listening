{
  "schema_version": "1.0",
  "encounter_id": "01307",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 5.61,
      "duration_seconds": 4.58,
      "text": "Hi, is it okay to to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.61,
      "end_seconds": 14.39,
      "duration_seconds": 3.78,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 19.39,
      "end_seconds": 24.72,
      "duration_seconds": 5.33,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.48,
      "end_seconds": 28.35,
      "duration_seconds": 2.87,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.26,
      "end_seconds": 35.53,
      "duration_seconds": 5.27,
      "text": "we came because of a dry cough in the evenings"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.63,
      "end_seconds": 38.4,
      "duration_seconds": 1.77,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.99,
      "end_seconds": 42.48,
      "duration_seconds": 3.49,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.59,
      "end_seconds": 52.74,
      "duration_seconds": 9.15,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.99,
      "end_seconds": 74.8,
      "duration_seconds": 20.81,
      "text": "it happens once or twice a day it's worse with pollen season i didn't want to make a fuss, you know mm, and there's sneezing fits as well, three weeks now there was itchy eyes, yes, but that that went away"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.67,
      "end_seconds": 82.07,
      "duration_seconds": 6.4,
      "text": "Have you had a dry cough in the evenings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.58,
      "end_seconds": 92.28,
      "duration_seconds": 8.7,
      "text": "yes, something like this happened last winter, and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.8,
      "end_seconds": 96.3,
      "duration_seconds": 3.5,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.39,
      "end_seconds": 99.49,
      "duration_seconds": 1.1,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.28,
      "end_seconds": 102.75,
      "duration_seconds": 1.47,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.47,
      "end_seconds": 107.21,
      "duration_seconds": 2.74,
      "text": "I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.06,
      "end_seconds": 116.41,
      "duration_seconds": 8.35,
      "text": "Okay, I can see heart failure in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.16,
      "end_seconds": 132.57,
      "duration_seconds": 15.41,
      "text": "I have about eight cigarettes in a day. I'll have a glass of wine with dinner. I swim twice a week. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.68,
      "end_seconds": 139.06,
      "duration_seconds": 4.38,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.71,
      "end_seconds": 148.8,
      "duration_seconds": 4.09,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.81,
      "end_seconds": 167.32,
      "duration_seconds": 4.51,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.84,
      "end_seconds": 181.66,
      "duration_seconds": 12.82,
      "text": "She takes febuxostat, 80 milligrams, once a day for the gout. Let me think, it's carvedilol, 6.25 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.69,
      "end_seconds": 186.45,
      "duration_seconds": 3.76,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.34,
      "end_seconds": 189.75,
      "duration_seconds": 2.41,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.32,
      "end_seconds": 194.75,
      "duration_seconds": 3.43,
      "text": "So, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.51,
      "end_seconds": 202.17,
      "duration_seconds": 5.66,
      "text": "Yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.98,
      "end_seconds": 207.68,
      "duration_seconds": 3.7,
      "text": "Alright, a few quick ones: fever or wheeze?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.26,
      "end_seconds": 213.51,
      "duration_seconds": 4.25,
      "text": "I haven't had fever or wheeze, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.26,
      "end_seconds": 217.35,
      "duration_seconds": 2.09,
      "text": "How about shortness of breath?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.69,
      "end_seconds": 222.55,
      "duration_seconds": 3.86,
      "text": "Not at all, no shortness of breath."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.42,
      "end_seconds": 227.36,
      "duration_seconds": 3.94,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.0,
      "end_seconds": 233.58,
      "duration_seconds": 5.58,
      "text": "well, my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.0,
      "end_seconds": 238.67,
      "duration_seconds": 3.67,
      "text": "Right, and and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.01,
      "end_seconds": 246.63,
      "duration_seconds": 3.62,
      "text": "Oh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.28,
      "end_seconds": 266.46,
      "duration_seconds": 3.18,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.12,
      "end_seconds": 276.54,
      "duration_seconds": 2.42,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.04,
      "end_seconds": 311.17,
      "duration_seconds": 13.13,
      "text": "okay: saturation 97 percent, BP is 116 over 71, pulse 83, weight 55 kilos, BMI works out to 23.8, height 152 centimetres, respiratory rate 18."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.85,
      "end_seconds": 314.43,
      "duration_seconds": 2.58,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.2,
      "end_seconds": 319.42,
      "duration_seconds": 3.22,
      "text": "So, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.44,
      "end_seconds": 324.07,
      "duration_seconds": 3.63,
      "text": "Now I'm gonna to do a short physical check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.68,
      "end_seconds": 327.26,
      "duration_seconds": 1.58,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.67,
      "end_seconds": 344.17,
      "duration_seconds": 5.5,
      "text": "your chest is clear and your nose looks a little swollen inside"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.42,
      "end_seconds": 358.53,
      "duration_seconds": 1.11,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.8,
      "end_seconds": 369.95,
      "duration_seconds": 9.15,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. It points towards seasonal hay fever causing the cough."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.58,
      "end_seconds": 372.37,
      "duration_seconds": 1.79,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.3,
      "end_seconds": 400.33,
      "duration_seconds": 22.03,
      "text": "I understand the worry. At the moment I'd say it's seasonal hay fever causing the cough, and we'll watch how it goes. You'll be taking fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.01,
      "end_seconds": 405.71,
      "duration_seconds": 4.7,
      "text": "Uh, you know, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.89,
      "end_seconds": 408.63,
      "duration_seconds": 1.74,
      "text": "Alright, goodbye for now."
    }
  ]
}