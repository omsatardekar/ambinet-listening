{
  "schema_version": "1.0",
  "encounter_id": "01145",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 2.9,
      "duration_seconds": 1.55,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.03,
      "end_seconds": 8.31,
      "duration_seconds": 4.28,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.21,
      "end_seconds": 12.77,
      "duration_seconds": 3.56,
      "text": "So, I've been wanting contraception, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.51,
      "end_seconds": 16.25,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.97,
      "end_seconds": 20.27,
      "duration_seconds": 2.3,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.08,
      "end_seconds": 25.04,
      "duration_seconds": 2.96,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.06,
      "end_seconds": 28.12,
      "duration_seconds": 1.06,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.84,
      "end_seconds": 46.05,
      "duration_seconds": 1.21,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.69,
      "end_seconds": 49.65,
      "duration_seconds": 2.96,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 54.02,
      "duration_seconds": 2.45,
      "text": "Alright, who lives with you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.92,
      "end_seconds": 58.53,
      "duration_seconds": 2.61,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.21,
      "end_seconds": 64.01,
      "duration_seconds": 3.8,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.04,
      "end_seconds": 70.8,
      "duration_seconds": 4.76,
      "text": "I don't think I have any, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.47,
      "end_seconds": 78.56,
      "duration_seconds": 2.09,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.96,
      "end_seconds": 87.2,
      "duration_seconds": 7.24,
      "text": "I take metoprolol, 50 milligrams, twice a day. It's iron tablets, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.28,
      "end_seconds": 92.86,
      "duration_seconds": 3.58,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.48,
      "end_seconds": 101.24,
      "duration_seconds": 6.76,
      "text": "I have heart disease. I have low haemoglobin, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.91,
      "end_seconds": 109.25,
      "duration_seconds": 7.34,
      "text": "Okay, go on. Yes, heart disease is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.22,
      "end_seconds": 131.43,
      "duration_seconds": 4.21,
      "text": "And what about breast lumps or migraine with aura?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.31,
      "end_seconds": 134.74,
      "duration_seconds": 2.43,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.48,
      "end_seconds": 137.62,
      "duration_seconds": 2.14,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.02,
      "end_seconds": 141.01,
      "duration_seconds": 1.99,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.04,
      "end_seconds": 145.15,
      "duration_seconds": 2.11,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.45,
      "end_seconds": 156.29,
      "duration_seconds": 2.84,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.43,
      "end_seconds": 173.23,
      "duration_seconds": 6.8,
      "text": "Okay: pressure 120 over 81, temperature is 37.0 degrees, saturation 99 percent, heart rate 66."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.76,
      "end_seconds": 175.27,
      "duration_seconds": 1.51,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.08,
      "end_seconds": 179.96,
      "duration_seconds": 2.88,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.22,
      "end_seconds": 187.1,
      "duration_seconds": 4.88,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.14,
      "end_seconds": 203.76,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.87,
      "end_seconds": 206.88,
      "duration_seconds": 2.01,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.92,
      "end_seconds": 224.93,
      "duration_seconds": 2.01,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.24,
      "end_seconds": 245.68,
      "duration_seconds": 15.44,
      "text": "All finished, thank you. Okay, so my impression is this: This is probably suitable for hormonal contraception with no risk factors. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.86,
      "end_seconds": 291.38,
      "duration_seconds": 35.52,
      "text": "I'll start you on levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. You take it by mouth. It's for contraception. It's a commonly used medicine and most people tolerate it well. Take the pill at the same time each day and use condoms if you miss two. The thing that would worry me is if you get leg swelling or severe headaches. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.81,
      "end_seconds": 299.06,
      "duration_seconds": 6.25,
      "text": "Please come and see me in three months. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.57,
      "end_seconds": 303.71,
      "duration_seconds": 3.14,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.69,
      "end_seconds": 307.83,
      "duration_seconds": 2.14,
      "text": "Okay, have a good day."
    }
  ]
}