{
  "schema_version": "1.0",
  "encounter_id": "01270",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 6.89,
      "duration_seconds": 5.85,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.67,
      "end_seconds": 11.5,
      "duration_seconds": 3.83,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.77,
      "end_seconds": 25.48,
      "duration_seconds": 7.71,
      "text": "Yeah, um, it's a severe sore throat. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.18,
      "end_seconds": 31.53,
      "duration_seconds": 4.35,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.23,
      "end_seconds": 39.54,
      "duration_seconds": 4.31,
      "text": "Ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 43.15,
      "duration_seconds": 2.06,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.3,
      "end_seconds": 48.75,
      "duration_seconds": 4.45,
      "text": "I mean, uh, I've had it since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.08,
      "end_seconds": 52.46,
      "duration_seconds": 2.38,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.54,
      "end_seconds": 62.31,
      "duration_seconds": 8.77,
      "text": "Ah, swallowing definitely sets it off. I did have drooling at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.82,
      "end_seconds": 69.08,
      "duration_seconds": 6.26,
      "text": "Have you had a severe sore throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.85,
      "end_seconds": 75.63,
      "duration_seconds": 5.78,
      "text": "Well, I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.69,
      "end_seconds": 79.45,
      "duration_seconds": 2.76,
      "text": "Any rash or cough at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.77,
      "end_seconds": 83.3,
      "duration_seconds": 2.53,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.78,
      "end_seconds": 88.11,
      "duration_seconds": 3.33,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.26,
      "end_seconds": 92.81,
      "duration_seconds": 1.55,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.48,
      "end_seconds": 101.43,
      "duration_seconds": 4.95,
      "text": "Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.67,
      "end_seconds": 105.15,
      "duration_seconds": 2.48,
      "text": "So, no, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.48,
      "end_seconds": 109.86,
      "duration_seconds": 3.38,
      "text": "So, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.47,
      "end_seconds": 115.6,
      "duration_seconds": 4.13,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.38,
      "end_seconds": 119.18,
      "duration_seconds": 1.8,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.86,
      "end_seconds": 124.94,
      "duration_seconds": 4.08,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.94,
      "end_seconds": 133.13,
      "duration_seconds": 2.19,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.91,
      "end_seconds": 141.03,
      "duration_seconds": 4.12,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.58,
      "end_seconds": 144.29,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.51,
      "end_seconds": 148.92,
      "duration_seconds": 3.41,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.96,
      "end_seconds": 166.35,
      "duration_seconds": 2.39,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.41,
      "end_seconds": 172.72,
      "duration_seconds": 5.31,
      "text": "I've had an irregular heartbeat, yes. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.09,
      "end_seconds": 177.01,
      "duration_seconds": 2.92,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.27,
      "end_seconds": 181.1,
      "duration_seconds": 2.83,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.0,
      "end_seconds": 190.41,
      "duration_seconds": 7.41,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.09,
      "end_seconds": 197.75,
      "duration_seconds": 5.66,
      "text": "Not currently, but as a youngster diclofenac gave me wheezing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.92,
      "end_seconds": 201.71,
      "duration_seconds": 2.79,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.48,
      "end_seconds": 217.65,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.34,
      "end_seconds": 244.75,
      "duration_seconds": 11.41,
      "text": "Okay: weight 91 kilos, pulse 92, temp 37.2 degrees. And height 176 centimetres, pressure 128 over 74, BMI works out to 29.4."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.05,
      "end_seconds": 250.22,
      "duration_seconds": 3.17,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.75,
      "end_seconds": 259.8,
      "duration_seconds": 1.05,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.76,
      "end_seconds": 264.32,
      "duration_seconds": 2.56,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.95,
      "end_seconds": 279.49,
      "duration_seconds": 4.54,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.24,
      "end_seconds": 285.72,
      "duration_seconds": 2.48,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.88,
      "end_seconds": 323.57,
      "duration_seconds": 29.69,
      "text": "Okay, so my impression is this: It points towards a possible airway infection that needs emergency care. I'd also keep severe tonsillitis in mind. I'm going to order an urgent airway assessment, for stridor and drooling. I'd rather check than guess, and this is the quickest way to know more. Do not lie flat, I am calling an ambulance now. I'd like you back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.02,
      "end_seconds": 328.82,
      "duration_seconds": 3.8,
      "text": "Ah, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.4,
      "end_seconds": 330.64,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}