{
  "schema_version": "1.0",
  "encounter_id": "01281",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 4.7,
      "duration_seconds": 3.38,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.21,
      "duration_seconds": 4.15,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.93,
      "end_seconds": 19.84,
      "duration_seconds": 6.91,
      "text": "It's a severe headache. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.25,
      "end_seconds": 24.33,
      "duration_seconds": 3.08,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.49,
      "end_seconds": 33.24,
      "duration_seconds": 4.75,
      "text": "Hmm, it's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.79,
      "end_seconds": 37.12,
      "duration_seconds": 2.33,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.38,
      "end_seconds": 40.29,
      "duration_seconds": 1.91,
      "text": "honestly, all the time"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.37,
      "end_seconds": 45.73,
      "duration_seconds": 3.36,
      "text": "has there been hating the light too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.37,
      "end_seconds": 55.86,
      "duration_seconds": 9.49,
      "text": "yeah, I've had that since last Tuesday as for hating the light, about a a three out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.71,
      "end_seconds": 62.02,
      "duration_seconds": 4.31,
      "text": "what about a stiff neck, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.54,
      "end_seconds": 71.63,
      "duration_seconds": 9.09,
      "text": "yes, um, for about a month with stiff neck, it's once or twice a day"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.46,
      "end_seconds": 79.81,
      "duration_seconds": 6.35,
      "text": "Alright, have you had a severe headache before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.68,
      "end_seconds": 87.4,
      "duration_seconds": 6.72,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.11,
      "end_seconds": 92.4,
      "duration_seconds": 4.29,
      "text": "a few quick ones: cough or recent head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.75,
      "end_seconds": 97.79,
      "duration_seconds": 4.04,
      "text": "No, no cough or recent head injury."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.21,
      "end_seconds": 103.27,
      "duration_seconds": 4.06,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.26,
      "end_seconds": 107.4,
      "duration_seconds": 2.14,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.5,
      "end_seconds": 112.33,
      "duration_seconds": 3.83,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.49,
      "end_seconds": 116.43,
      "duration_seconds": 2.94,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.44,
      "end_seconds": 120.48,
      "duration_seconds": 2.04,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.54,
      "end_seconds": 126.16,
      "duration_seconds": 4.62,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.37,
      "end_seconds": 129.2,
      "duration_seconds": 1.83,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 134.13,
      "duration_seconds": 3.79,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.5,
      "end_seconds": 139.34,
      "duration_seconds": 3.84,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.36,
      "end_seconds": 143.85,
      "duration_seconds": 3.49,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.91,
      "end_seconds": 153.84,
      "duration_seconds": 4.93,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.08,
      "end_seconds": 156.87,
      "duration_seconds": 1.79,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.69,
      "end_seconds": 160.43,
      "duration_seconds": 2.74,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.54,
      "end_seconds": 168.21,
      "duration_seconds": 6.67,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.96,
      "end_seconds": 181.87,
      "duration_seconds": 3.91,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.5,
      "end_seconds": 192.3,
      "duration_seconds": 9.8,
      "text": "Lamotrigine, 100 milligrams, twice a day. It's the the not knowing that gets to me. I'm on metformin, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.28,
      "end_seconds": 195.29,
      "duration_seconds": 2.01,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.01,
      "end_seconds": 200.07,
      "duration_seconds": 4.06,
      "text": "500 milligrams i'm on naproxen, twice a day"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.78,
      "end_seconds": 203.97,
      "duration_seconds": 2.19,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.96,
      "end_seconds": 205.87,
      "duration_seconds": 0.91,
      "text": "250 milligrams"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.3,
      "end_seconds": 223.86,
      "duration_seconds": 3.56,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.48,
      "end_seconds": 228.91,
      "duration_seconds": 4.43,
      "text": "I've had epilepsy for two years now. Yes, diabetes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.99,
      "end_seconds": 232.53,
      "duration_seconds": 1.54,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.13,
      "end_seconds": 236.65,
      "duration_seconds": 3.52,
      "text": "Arthritis in my knees, for two years"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.24,
      "end_seconds": 240.89,
      "duration_seconds": 2.65,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.72,
      "end_seconds": 243.57,
      "duration_seconds": 1.85,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.6,
      "end_seconds": 261.74,
      "duration_seconds": 13.14,
      "text": "I see, go ahead. Right, so diabetes and arthritis in your knees are already on your record. We'll keep that in mind today. I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.81,
      "end_seconds": 272.27,
      "duration_seconds": 2.46,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.73,
      "end_seconds": 298.96,
      "duration_seconds": 7.23,
      "text": "Okay: pulse 106, blood pressure 110 over 80, respiratory rate 21, temperature is 38.1 degrees."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.89,
      "end_seconds": 301.38,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.51,
      "end_seconds": 305.19,
      "duration_seconds": 2.68,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.27,
      "end_seconds": 308.96,
      "duration_seconds": 2.69,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.03,
      "end_seconds": 312.38,
      "duration_seconds": 2.35,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.13,
      "end_seconds": 327.56,
      "duration_seconds": 7.43,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.06,
      "end_seconds": 333.97,
      "duration_seconds": 1.91,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.48,
      "end_seconds": 363.42,
      "duration_seconds": 14.94,
      "text": "So, based on the history and the examination, I think we're dealing with possible bacterial meningitis at this stage. I'd also keep meningococcal septicaemia in mind. I'm going to order a lumbar puncture, for possible meningitis."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.27,
      "end_seconds": 366.36,
      "duration_seconds": 1.09,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.29,
      "end_seconds": 405.53,
      "duration_seconds": 37.24,
      "text": "I'm going to order blood cultures, for possible meningitis. The result will help us decide whether anything more is needed. You'll be taking benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. Call an ambulance now, this is an emergency. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Let's plan a check straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.0,
      "end_seconds": 408.64,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.7,
      "end_seconds": 411.16,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}