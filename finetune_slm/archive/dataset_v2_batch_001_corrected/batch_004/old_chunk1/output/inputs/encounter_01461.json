{
  "schema_version": "1.0",
  "encounter_id": "01461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 6.86,
      "duration_seconds": 6.33,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.67,
      "end_seconds": 11.48,
      "duration_seconds": 3.81,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.4,
      "end_seconds": 17.51,
      "duration_seconds": 4.11,
      "text": "I've been dealing with severe lower back pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.69,
      "end_seconds": 26.69,
      "duration_seconds": 8.0,
      "text": "Are you taking anything regularly, including from the pharmacy? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.69,
      "end_seconds": 32.18,
      "duration_seconds": 4.49,
      "text": "I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.52,
      "end_seconds": 35.81,
      "duration_seconds": 2.29,
      "text": "Alright, when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.69,
      "end_seconds": 38.54,
      "duration_seconds": 1.85,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.79,
      "end_seconds": 42.07,
      "duration_seconds": 3.28,
      "text": "Hm, okay. What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.73,
      "end_seconds": 50.77,
      "duration_seconds": 8.04,
      "text": "Yes, bending. That makes it worse. I've also had numbness between my legs, since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.75,
      "end_seconds": 54.72,
      "duration_seconds": 2.97,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.89,
      "end_seconds": 57.6,
      "duration_seconds": 1.71,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.48,
      "end_seconds": 62.02,
      "duration_seconds": 3.54,
      "text": "Have you had any recent fall or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.65,
      "end_seconds": 67.18,
      "duration_seconds": 4.53,
      "text": "No recent fall or fever, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.14,
      "end_seconds": 73.87,
      "duration_seconds": 2.73,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.78,
      "end_seconds": 77.01,
      "duration_seconds": 2.23,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.65,
      "end_seconds": 80.22,
      "duration_seconds": 1.57,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.99,
      "end_seconds": 83.83,
      "duration_seconds": 1.84,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.19,
      "end_seconds": 88.09,
      "duration_seconds": 2.9,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.41,
      "end_seconds": 91.64,
      "duration_seconds": 2.23,
      "text": "No, uh, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.29,
      "end_seconds": 95.77,
      "duration_seconds": 2.48,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.4,
      "end_seconds": 116.01,
      "duration_seconds": 14.61,
      "text": "No, I've never smoked in my life. Nothing, I'm teetotal. I walk the dog every morning. My husband and I live above the shop. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.62,
      "end_seconds": 121.79,
      "duration_seconds": 5.17,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.4,
      "end_seconds": 126.23,
      "duration_seconds": 2.83,
      "text": "Okay, so my grandmother had dementia."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.71,
      "end_seconds": 147.26,
      "duration_seconds": 3.55,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.86,
      "end_seconds": 150.67,
      "duration_seconds": 1.81,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.36,
      "end_seconds": 155.55,
      "duration_seconds": 4.19,
      "text": "Understood. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.17,
      "end_seconds": 164.99,
      "duration_seconds": 7.82,
      "text": "I was told I'm allergic to erythromycin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.18,
      "end_seconds": 172.23,
      "duration_seconds": 6.05,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.33,
      "end_seconds": 191.44,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.37,
      "end_seconds": 194.51,
      "duration_seconds": 2.14,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.77,
      "end_seconds": 218.09,
      "duration_seconds": 5.32,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.74,
      "end_seconds": 219.77,
      "duration_seconds": 1.03,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.9,
      "end_seconds": 235.85,
      "duration_seconds": 10.95,
      "text": "You can sit up now. Taking everything into account, the most likely explanation is possible cauda equina syndrome needing an urgent scan."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.19,
      "end_seconds": 239.22,
      "duration_seconds": 2.03,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.42,
      "end_seconds": 263.99,
      "duration_seconds": 23.57,
      "text": "I understand the worry. At the moment I'd say it's possible cauda equina syndrome needing an urgent scan, and we'll know more once the an urgent MRI of the spine is back. So, to recap quickly. You've had severe lower back pain for two weeks, and no recent fall or fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.11,
      "end_seconds": 266.8,
      "duration_seconds": 1.69,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.48,
      "end_seconds": 300.2,
      "duration_seconds": 20.72,
      "text": "We should do an urgent MRI of the spine for possible cauda equina. You need to go to hospital now for an emergency scan. I'll also refer you to the spinal team. One warning sign to remember: the numbness spreads. In that case don't wait. Come back straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.73,
      "end_seconds": 305.43,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.89,
      "end_seconds": 311.52,
      "duration_seconds": 4.63,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.29,
      "end_seconds": 313.97,
      "duration_seconds": 1.68,
      "text": "That's clear, thanks."
    }
  ]
}