{
  "schema_version": "1.0",
  "encounter_id": "01481",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.84,
      "duration_seconds": 3.62,
      "text": "good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.63,
      "end_seconds": 10.47,
      "duration_seconds": 4.84,
      "text": "Yes, come in and and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.0,
      "end_seconds": 19.48,
      "duration_seconds": 7.48,
      "text": "I've been passing a lot of urine, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 24.07,
      "duration_seconds": 2.58,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.37,
      "end_seconds": 34.81,
      "duration_seconds": 2.44,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.89,
      "end_seconds": 59.06,
      "duration_seconds": 14.17,
      "text": "Okay: pressure 125 over 82, height 178 centimetres, BMI works out to 24.3. And oxygen saturation is 98 percent, weight 77 kilos, pulse is 112 beats a minute, temperature is 37.1 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.07,
      "end_seconds": 62.33,
      "duration_seconds": 2.26,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.29,
      "end_seconds": 70.0,
      "duration_seconds": 5.71,
      "text": "I'll come back to the numbers. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.98,
      "end_seconds": 72.06,
      "duration_seconds": 1.08,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.48,
      "end_seconds": 75.71,
      "duration_seconds": 2.23,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.43,
      "end_seconds": 88.58,
      "duration_seconds": 12.15,
      "text": "when it starts I tend to get being very thirsty as well. As for being very thirsty, it feels severe to me. Water helps a bit"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.83,
      "end_seconds": 95.37,
      "duration_seconds": 2.54,
      "text": "alright, any cough or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.18,
      "end_seconds": 99.12,
      "duration_seconds": 2.94,
      "text": "No, no cough or chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.92,
      "end_seconds": 103.2,
      "duration_seconds": 2.28,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.73,
      "end_seconds": 105.38,
      "duration_seconds": 1.65,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.37,
      "end_seconds": 111.15,
      "duration_seconds": 3.78,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.63,
      "end_seconds": 114.06,
      "duration_seconds": 1.43,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.99,
      "end_seconds": 132.23,
      "duration_seconds": 5.24,
      "text": "Right, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.63,
      "end_seconds": 140.04,
      "duration_seconds": 6.41,
      "text": "I'm on sitagliptin, 100 milligrams, once a day for my sugar."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.22,
      "end_seconds": 144.17,
      "duration_seconds": 2.95,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.24,
      "end_seconds": 154.79,
      "duration_seconds": 5.55,
      "text": "for about a year i'm on Seretide inhaler, twice a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.0,
      "end_seconds": 164.01,
      "duration_seconds": 5.01,
      "text": "Alright, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.2,
      "end_seconds": 166.37,
      "duration_seconds": 1.17,
      "text": "yes, diabetes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.17,
      "end_seconds": 168.14,
      "duration_seconds": 0.97,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.05,
      "end_seconds": 173.01,
      "duration_seconds": 3.96,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.0,
      "end_seconds": 178.86,
      "duration_seconds": 4.86,
      "text": "yes, asthma is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.93,
      "end_seconds": 195.61,
      "duration_seconds": 2.68,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.6,
      "end_seconds": 209.11,
      "duration_seconds": 12.51,
      "text": "I had a cataract operation in my left eye about a year ago. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.79,
      "end_seconds": 230.92,
      "duration_seconds": 3.13,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.59,
      "end_seconds": 234.51,
      "duration_seconds": 1.92,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.51,
      "end_seconds": 237.89,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.53,
      "end_seconds": 242.41,
      "duration_seconds": 3.88,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.61,
      "end_seconds": 250.01,
      "duration_seconds": 3.4,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.96,
      "end_seconds": 254.06,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.28,
      "end_seconds": 258.59,
      "duration_seconds": 3.31,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.91,
      "end_seconds": 262.24,
      "duration_seconds": 2.33,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.07,
      "end_seconds": 284.15,
      "duration_seconds": 4.08,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.33,
      "end_seconds": 294.84,
      "duration_seconds": 8.51,
      "text": "you can sit up now. Right, here's what I'm thinking. I think we're dealing with diabetic ketoacidosis at this stage"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.42,
      "end_seconds": 297.81,
      "duration_seconds": 2.39,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.78,
      "end_seconds": 318.15,
      "duration_seconds": 18.37,
      "text": "nothing I've seen today points to an emergency. It looks like diabetic ketoacidosis, but I'd like to confirm. Let me just check I've got this right. You've been passing a lot of urine, severe, and no chest pain or cough"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.99,
      "end_seconds": 319.69,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.4,
      "end_seconds": 336.77,
      "duration_seconds": 16.37,
      "text": "I'm going to order blood gas and electrolytes, for DKA you need to go to hospital now for insulin and fluids one warning sign to remember: you cannot get there now in that case don't wait"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.61,
      "end_seconds": 341.25,
      "duration_seconds": 1.64,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.3,
      "end_seconds": 348.84,
      "duration_seconds": 5.54,
      "text": "I'd like you back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.65,
      "end_seconds": 353.04,
      "duration_seconds": 2.39,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.75,
      "end_seconds": 356.15,
      "duration_seconds": 1.4,
      "text": "Take care now."
    }
  ]
}