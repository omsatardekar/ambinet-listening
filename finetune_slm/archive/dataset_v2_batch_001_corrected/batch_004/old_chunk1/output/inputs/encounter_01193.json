{
  "schema_version": "1.0",
  "encounter_id": "01193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 4.91,
      "duration_seconds": 4.19,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.52,
      "end_seconds": 10.43,
      "duration_seconds": 3.91,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.45,
      "end_seconds": 19.68,
      "duration_seconds": 8.23,
      "text": "Okay, uh, so hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 24.75,
      "duration_seconds": 3.07,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.38,
      "end_seconds": 30.02,
      "duration_seconds": 4.64,
      "text": "We came because of a cut on my finger."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.98,
      "end_seconds": 35.75,
      "duration_seconds": 3.77,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.82,
      "end_seconds": 40.74,
      "duration_seconds": 3.92,
      "text": "Erm, around three weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 42.84,
      "end_seconds": 48.38,
      "duration_seconds": 5.54,
      "text": "I think it's been nearer a month, um, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.7,
      "end_seconds": 53.95,
      "duration_seconds": 4.25,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.04,
      "end_seconds": 59.38,
      "duration_seconds": 4.34,
      "text": "Yeah, roughly. I've also had a little bleeding."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.43,
      "end_seconds": 68.29,
      "duration_seconds": 6.86,
      "text": "Have you had a cut on your finger before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.38,
      "end_seconds": 77.62,
      "duration_seconds": 7.24,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.48,
      "end_seconds": 91.6,
      "duration_seconds": 3.12,
      "text": "And what about dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.45,
      "end_seconds": 97.65,
      "duration_seconds": 4.2,
      "text": "I haven't had dirty blade or numbness, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.52,
      "end_seconds": 101.09,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.72,
      "end_seconds": 105.78,
      "duration_seconds": 2.06,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 110.19,
      "duration_seconds": 3.14,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 113.31,
      "end_seconds": 127.21,
      "duration_seconds": 13.9,
      "text": "She takes spironolactone, 25 milligrams, once a day for my heart. She is on febuxostat, 80 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.68,
      "end_seconds": 131.66,
      "duration_seconds": 2.98,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.38,
      "end_seconds": 138.91,
      "duration_seconds": 5.53,
      "text": "Let me think, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.07,
      "end_seconds": 145.4,
      "duration_seconds": 2.33,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.94,
      "end_seconds": 153.93,
      "duration_seconds": 3.99,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.35,
      "end_seconds": 159.21,
      "duration_seconds": 3.86,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.94,
      "end_seconds": 165.6,
      "duration_seconds": 5.66,
      "text": "My mother had a stroke. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.27,
      "end_seconds": 170.16,
      "duration_seconds": 3.89,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.94,
      "end_seconds": 187.36,
      "duration_seconds": 15.42,
      "text": "I quit smoking around ten years ago. I live with my elderly mother. Yes, I work in a bakery, early starts. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.83,
      "end_seconds": 200.71,
      "duration_seconds": 2.88,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.64,
      "end_seconds": 210.54,
      "duration_seconds": 7.9,
      "text": "I, I have heart failure, for nearly five years. I've had gout, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.25,
      "end_seconds": 223.95,
      "duration_seconds": 11.7,
      "text": "I follow. Right, so heart failure and gout are already on your record. We'll keep that in mind today. Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.61,
      "end_seconds": 233.51,
      "duration_seconds": 2.9,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.86,
      "end_seconds": 251.46,
      "duration_seconds": 8.6,
      "text": "Okay: BP is 112 over 80, heart rate 75, SpO2 98 percent on room air. And temperature 36.7."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.9,
      "end_seconds": 258.03,
      "duration_seconds": 4.13,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.66,
      "end_seconds": 260.89,
      "duration_seconds": 1.23,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.76,
      "end_seconds": 264.73,
      "duration_seconds": 1.97,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.47,
      "end_seconds": 288.14,
      "duration_seconds": 5.67,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.01,
      "end_seconds": 296.42,
      "duration_seconds": 2.41,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.11,
      "end_seconds": 325.54,
      "duration_seconds": 18.43,
      "text": "Okay, so my impression is this: I think we're dealing with a minor clean wound that needs only dressing at this stage. I'll close it with adhesive strips and keep it dry for two days. Let's plan a check if it looks red or swollen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.34,
      "end_seconds": 328.04,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.94,
      "end_seconds": 332.39,
      "duration_seconds": 2.45,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.02,
      "end_seconds": 339.35,
      "duration_seconds": 3.33,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.38,
      "end_seconds": 341.82,
      "duration_seconds": 1.44,
      "text": "Take care now."
    }
  ]
}