{
  "schema_version": "1.0",
  "encounter_id": "01225",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.66,
      "duration_seconds": 3.4,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 10.05,
      "duration_seconds": 4.83,
      "text": "Okay, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.45,
      "end_seconds": 15.95,
      "duration_seconds": 4.5,
      "text": "So the thing is, I've got vomiting blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.49,
      "end_seconds": 19.91,
      "duration_seconds": 3.42,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.52,
      "end_seconds": 24.09,
      "duration_seconds": 2.57,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.09,
      "end_seconds": 29.28,
      "duration_seconds": 3.19,
      "text": "Alright, is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.99,
      "end_seconds": 37.42,
      "duration_seconds": 7.43,
      "text": "It usually comes with stomach pain. Um, the stomach pain? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.44,
      "end_seconds": 42.16,
      "duration_seconds": 3.72,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.14,
      "end_seconds": 49.48,
      "duration_seconds": 5.34,
      "text": "Right, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.01,
      "end_seconds": 53.74,
      "duration_seconds": 3.73,
      "text": "Mm-hmm. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.58,
      "end_seconds": 64.15,
      "duration_seconds": 2.57,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.45,
      "end_seconds": 83.75,
      "duration_seconds": 5.3,
      "text": "Okay: BP is 132 over 81, pulse is 124 beats a minute."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.44,
      "end_seconds": 88.39,
      "duration_seconds": 1.95,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.91,
      "end_seconds": 91.66,
      "duration_seconds": 1.75,
      "text": "Right, look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.61,
      "end_seconds": 110.74,
      "duration_seconds": 7.13,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.71,
      "end_seconds": 117.47,
      "duration_seconds": 1.76,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.48,
      "end_seconds": 127.8,
      "duration_seconds": 3.32,
      "text": "Any fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.9,
      "end_seconds": 133.27,
      "duration_seconds": 4.37,
      "text": "No fever or chest pain, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.62,
      "end_seconds": 142.69,
      "duration_seconds": 4.07,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.46,
      "end_seconds": 146.76,
      "duration_seconds": 2.3,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.47,
      "end_seconds": 150.57,
      "duration_seconds": 3.1,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.02,
      "end_seconds": 154.43,
      "duration_seconds": 2.41,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.47,
      "end_seconds": 157.25,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.21,
      "end_seconds": 162.07,
      "duration_seconds": 2.86,
      "text": "I have migraines, for two years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.13,
      "end_seconds": 164.83,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.85,
      "end_seconds": 167.89,
      "duration_seconds": 2.04,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.88,
      "end_seconds": 178.0,
      "duration_seconds": 8.12,
      "text": "Mm, okay. Right, so migraines is already on your record. We'll keep that in mind today. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.61,
      "end_seconds": 183.7,
      "duration_seconds": 5.09,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.12,
      "end_seconds": 186.49,
      "duration_seconds": 1.37,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.52,
      "end_seconds": 192.34,
      "duration_seconds": 3.82,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.09,
      "end_seconds": 197.68,
      "duration_seconds": 3.59,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.91,
      "end_seconds": 205.36,
      "duration_seconds": 3.45,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.2,
      "end_seconds": 210.19,
      "duration_seconds": 2.99,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.82,
      "end_seconds": 215.57,
      "duration_seconds": 3.75,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.44,
      "end_seconds": 218.73,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.2,
      "end_seconds": 223.59,
      "duration_seconds": 3.39,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.89,
      "end_seconds": 227.55,
      "duration_seconds": 2.66,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.59,
      "end_seconds": 234.44,
      "duration_seconds": 4.85,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.84,
      "end_seconds": 244.14,
      "duration_seconds": 2.3,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.75,
      "end_seconds": 249.61,
      "duration_seconds": 3.86,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.99,
      "end_seconds": 273.02,
      "duration_seconds": 5.03,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.75,
      "end_seconds": 292.98,
      "duration_seconds": 19.23,
      "text": "I, I take naproxen, 250 milligrams, twice a day. Actually, I'm on propranolol, 40 milligrams, twice a day. Though honestly, some days I forget to take it. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.96,
      "end_seconds": 310.92,
      "duration_seconds": 15.96,
      "text": "From what you've told me and what I found, this looks most like a possible bleeding stomach ulcer. Let me just check I've got this right. You've had vomiting blood, severe, and no chest pain or fever."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.3,
      "end_seconds": 314.48,
      "duration_seconds": 2.18,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.81,
      "end_seconds": 329.58,
      "duration_seconds": 13.77,
      "text": "I'm sending you for an endoscopy because of bleeding. I'm sending you for urgent blood tests because of bleeding. Please stop the ibuprofen and do not eat or drink."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.89,
      "end_seconds": 337.65,
      "duration_seconds": 7.76,
      "text": "I follow. We'll refer you to the emergency team. Do get help quickly if you vomit again."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.15,
      "end_seconds": 340.13,
      "duration_seconds": 0.98,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.87,
      "end_seconds": 342.75,
      "duration_seconds": 1.88,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.41,
      "end_seconds": 346.34,
      "duration_seconds": 1.93,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.76,
      "end_seconds": 352.06,
      "duration_seconds": 4.3,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.38,
      "end_seconds": 355.46,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}