{
  "schema_version": "1.0",
  "encounter_id": "01246",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 4.04,
      "duration_seconds": 3.42,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 8.86,
      "duration_seconds": 3.65,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.74,
      "end_seconds": 16.13,
      "duration_seconds": 5.39,
      "text": "doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.63,
      "end_seconds": 22.11,
      "duration_seconds": 4.48,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.84,
      "end_seconds": 34.03,
      "duration_seconds": 11.19,
      "text": "Doctor, it's numbness between my legs. It's getting on my nerves now. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.95,
      "end_seconds": 37.92,
      "duration_seconds": 2.97,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.58,
      "end_seconds": 41.7,
      "duration_seconds": 2.12,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.58,
      "end_seconds": 45.97,
      "duration_seconds": 3.39,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.67,
      "end_seconds": 62.82,
      "duration_seconds": 15.15,
      "text": "Mild, I'd say i've also had severe lower back pain, for about a month about severe lower back pain, it feels Mild to me honestly, every other day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.66,
      "end_seconds": 68.49,
      "duration_seconds": 3.83,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.47,
      "end_seconds": 73.38,
      "duration_seconds": 2.91,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.41,
      "end_seconds": 90.73,
      "duration_seconds": 4.32,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.57,
      "end_seconds": 94.78,
      "duration_seconds": 2.21,
      "text": "I've got high cholesterol"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.63,
      "end_seconds": 100.08,
      "duration_seconds": 4.45,
      "text": "alright, high cholesterol, that matches what I have here"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.94,
      "end_seconds": 109.22,
      "duration_seconds": 1.28,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.92,
      "end_seconds": 115.76,
      "duration_seconds": 5.84,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.09,
      "end_seconds": 120.26,
      "duration_seconds": 3.17,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.38,
      "end_seconds": 126.59,
      "duration_seconds": 5.21,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.19,
      "end_seconds": 129.0,
      "duration_seconds": 1.81,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.47,
      "end_seconds": 133.19,
      "duration_seconds": 2.72,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.98,
      "end_seconds": 140.04,
      "duration_seconds": 2.06,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.73,
      "end_seconds": 144.2,
      "duration_seconds": 2.47,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.12,
      "end_seconds": 148.96,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 150.13,
      "end_seconds": 155.61,
      "duration_seconds": 5.48,
      "text": "She takes simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.13,
      "end_seconds": 161.43,
      "duration_seconds": 2.3,
      "text": "when did you start it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 163.13,
      "end_seconds": 164.85,
      "duration_seconds": 1.72,
      "text": "Nearly five years now"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.9,
      "end_seconds": 171.73,
      "duration_seconds": 4.83,
      "text": "I'd been on rosuvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.69,
      "end_seconds": 191.73,
      "duration_seconds": 5.04,
      "text": "Let me check a few things. Any fever or recent fall?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.46,
      "end_seconds": 197.03,
      "duration_seconds": 4.57,
      "text": "No fever or recent fall, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.64,
      "end_seconds": 200.57,
      "duration_seconds": 1.93,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.94,
      "end_seconds": 202.84,
      "duration_seconds": 0.9,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.57,
      "end_seconds": 207.14,
      "duration_seconds": 2.57,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.21,
      "end_seconds": 219.45,
      "duration_seconds": 2.24,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.24,
      "end_seconds": 243.26,
      "duration_seconds": 7.02,
      "text": "Okay: pulse 71, BP is 117 over 78, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.52,
      "end_seconds": 245.91,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.89,
      "end_seconds": 249.25,
      "duration_seconds": 2.36,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 253.97,
      "duration_seconds": 2.71,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.89,
      "end_seconds": 258.05,
      "duration_seconds": 2.16,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.78,
      "end_seconds": 279.21,
      "duration_seconds": 5.43,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.14,
      "end_seconds": 301.3,
      "duration_seconds": 17.16,
      "text": "you can sit up now from what you've told me and what I found, I think we're dealing with possible cauda equina syndrome needing an urgent scan at this stage it could also be a large disc prolapse, so we'll keep that open"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.99,
      "end_seconds": 305.2,
      "duration_seconds": 2.21,
      "text": "is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.71,
      "end_seconds": 324.51,
      "duration_seconds": 17.8,
      "text": "Nothing I've seen today points to an emergency. It looks like possible cauda equina syndrome needing an urgent scan, but I'd like to confirm. I'd like to arrange an urgent MRI of the spine for possible cauda equina."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.16,
      "end_seconds": 326.21,
      "duration_seconds": 1.05,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.67,
      "end_seconds": 339.0,
      "duration_seconds": 11.33,
      "text": "You need to go to hospital now for an emergency scan. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.34,
      "end_seconds": 349.83,
      "duration_seconds": 10.49,
      "text": "Mm, okay. I think the spinal team should see you too. Please don't wait if the numbness spreads. That's when to to be seen urgently."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.61,
      "end_seconds": 352.07,
      "duration_seconds": 1.46,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.63,
      "end_seconds": 360.61,
      "duration_seconds": 6.98,
      "text": "book a review straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.65,
      "end_seconds": 363.64,
      "duration_seconds": 1.99,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.05,
      "end_seconds": 366.3,
      "duration_seconds": 1.25,
      "text": "take care now"
    }
  ]
}