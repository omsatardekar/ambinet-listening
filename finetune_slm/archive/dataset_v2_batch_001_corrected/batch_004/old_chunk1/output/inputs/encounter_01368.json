  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 5.73,
      "duration_seconds": 5.11,
      "text": "Well, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.99,
      "end_seconds": 11.48,
      "duration_seconds": 4.49,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.82,
      "end_seconds": 27.91,
      "duration_seconds": 15.09,
      "text": "So, mainly sharp pain low on one side. There's a couple of other things, but that's the main one. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.43,
      "end_seconds": 33.19,
      "duration_seconds": 3.76,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.23,
      "end_seconds": 39.1,
      "duration_seconds": 3.87,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.59,
      "end_seconds": 40.36,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.84,
      "end_seconds": 55.58,
      "duration_seconds": 13.74,
      "text": "Let me think, as for feeling faint, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.56,
      "end_seconds": 71.45,
      "duration_seconds": 2.89,
      "text": "Any fever or vaginal discharge at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.0,
      "end_seconds": 75.55,
      "duration_seconds": 3.55,
      "text": "Oh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.48,
      "end_seconds": 80.84,
      "duration_seconds": 3.36,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.98,
      "end_seconds": 84.46,
      "duration_seconds": 2.48,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.43,
      "end_seconds": 89.69,
      "duration_seconds": 3.26,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.78,
      "end_seconds": 93.5,
      "duration_seconds": 2.72,
      "text": "Ah, no, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.48,
      "end_seconds": 97.01,
      "duration_seconds": 2.53,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.38,
      "end_seconds": 102.15,
      "duration_seconds": 3.77,
      "text": "Well, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.71,
      "end_seconds": 107.56,
      "duration_seconds": 3.85,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.68,
      "end_seconds": 120.01,
      "duration_seconds": 11.33,
      "text": "Hydrocortisone cream. I take it when needed. I do miss it now and then, uh, to be fair."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.96,
      "end_seconds": 126.17,
      "duration_seconds": 5.21,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.78,
      "end_seconds": 130.39,
      "duration_seconds": 2.61,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.11,
      "end_seconds": 134.69,
      "duration_seconds": 3.58,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.04,
      "end_seconds": 139.6,
      "duration_seconds": 3.56,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.81,
      "end_seconds": 143.56,
      "duration_seconds": 2.75,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.73,
      "end_seconds": 149.03,
      "duration_seconds": 4.3,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.92,
      "end_seconds": 154.36,
      "duration_seconds": 4.44,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.01,
      "end_seconds": 157.18,
      "duration_seconds": 2.17,
      "text": "I've, I've got eczema."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.2,
      "end_seconds": 164.87,
      "duration_seconds": 6.67,
      "text": "Okay, I can see eczema in your file as well. I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.35,
      "end_seconds": 177.06,
      "duration_seconds": 2.71,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.6,
      "end_seconds": 203.29,
      "duration_seconds": 9.69,
      "text": "Okay: respiratory rate 18, pulse 113. And temperature is 37.0 degrees, BP is 116 over 76, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 210.93,
      "duration_seconds": 5.31,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.82,
      "end_seconds": 214.11,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.3,
      "end_seconds": 228.86,
      "duration_seconds": 5.56,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.52,
      "end_seconds": 235.41,
      "duration_seconds": 1.89,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.28,
      "end_seconds": 257.98,
      "duration_seconds": 12.7,
      "text": "Okay, so my impression is this: It points towards a possible ectopic pregnancy. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.54,
      "end_seconds": 263.59,
      "duration_seconds": 4.05,
      "text": "Actually, uh, will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.23,
      "end_seconds": 276.14,
      "duration_seconds": 10.91,
      "text": "I understand the worry. At the moment I'd say it's a possible ectopic pregnancy, and we'll know more once the a pregnancy test is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.82,
      "end_seconds": 309.68,
      "duration_seconds": 16.86,
      "text": "We should do a pregnancy test for pelvic pain and bleeding. I'll request an urgent pelvic scan, it'll help with possible ectopic. You need to go to the hospital now for an emergency scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.61,
      "end_seconds": 314.93,
      "duration_seconds": 3.32,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.97,
      "end_seconds": 318.15,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}