{
  "schema_version": "1.0",
  "encounter_id": "01345",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 6.86,
      "duration_seconds": 6.23,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 12.17,
      "duration_seconds": 4.41,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.14,
      "end_seconds": 19.1,
      "duration_seconds": 4.96,
      "text": "So the thing is, I've got a scratchy throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.0,
      "end_seconds": 23.17,
      "duration_seconds": 3.17,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.07,
      "end_seconds": 27.93,
      "duration_seconds": 2.86,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.51,
      "end_seconds": 38.32,
      "duration_seconds": 9.81,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.08,
      "end_seconds": 52.73,
      "duration_seconds": 13.65,
      "text": "Oh, uh, yes, swallowing. That makes it worse. Pretty moderate, if I'm being honest. And a mild cough as well, since this morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.54,
      "end_seconds": 57.59,
      "duration_seconds": 4.05,
      "text": "What about a runny nose, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.24,
      "end_seconds": 68.59,
      "duration_seconds": 6.35,
      "text": "Yeah, that too. As for runny nose, I get some relief from tissues."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.91,
      "end_seconds": 69.94,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.64,
      "end_seconds": 87.25,
      "duration_seconds": 2.61,
      "text": "Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.93,
      "end_seconds": 92.53,
      "duration_seconds": 3.6,
      "text": "Not that I've noticed, no chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.07,
      "end_seconds": 99.61,
      "duration_seconds": 3.54,
      "text": "Any fever, ear pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 107.08,
      "duration_seconds": 5.79,
      "text": "Um, no, no fever, ear pain or shortness of breath."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.55,
      "end_seconds": 110.39,
      "duration_seconds": 2.84,
      "text": "Understood. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.92,
      "end_seconds": 115.09,
      "duration_seconds": 3.17,
      "text": "I mean, no, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.67,
      "end_seconds": 122.56,
      "duration_seconds": 3.89,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.64,
      "end_seconds": 126.13,
      "duration_seconds": 1.49,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.85,
      "end_seconds": 128.88,
      "duration_seconds": 1.03,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.9,
      "end_seconds": 131.4,
      "duration_seconds": 1.5,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.08,
      "end_seconds": 136.59,
      "duration_seconds": 3.51,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.12,
      "end_seconds": 141.8,
      "duration_seconds": 4.68,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.86,
      "end_seconds": 153.09,
      "duration_seconds": 3.23,
      "text": "Right, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.75,
      "end_seconds": 163.61,
      "duration_seconds": 9.86,
      "text": "I live with my elderly mother. I do a yoga class on Thursdays. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.24,
      "end_seconds": 166.55,
      "duration_seconds": 2.31,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.65,
      "end_seconds": 176.72,
      "duration_seconds": 9.07,
      "text": "I'm, I'm on aspirin, 75 milligrams, once a day. Let me think, I'm on throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.79,
      "end_seconds": 180.79,
      "duration_seconds": 3.0,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.85,
      "end_seconds": 186.47,
      "duration_seconds": 4.62,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.38,
      "end_seconds": 191.21,
      "duration_seconds": 2.83,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.66,
      "end_seconds": 199.92,
      "duration_seconds": 2.26,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.43,
      "end_seconds": 217.79,
      "duration_seconds": 5.36,
      "text": "Okay: pulse 81, respiratory rate 14, BP is 128 over 79."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.34,
      "end_seconds": 219.72,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.8,
      "end_seconds": 223.4,
      "duration_seconds": 2.6,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.06,
      "end_seconds": 228.51,
      "duration_seconds": 3.45,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.03,
      "end_seconds": 232.96,
      "duration_seconds": 2.93,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.49,
      "end_seconds": 245.53,
      "duration_seconds": 5.04,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.04,
      "end_seconds": 249.85,
      "duration_seconds": 1.81,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.62,
      "end_seconds": 271.0,
      "duration_seconds": 12.38,
      "text": "Putting it all together, this looks most like a simple viral cold. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.8,
      "end_seconds": 274.81,
      "duration_seconds": 3.01,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.34,
      "end_seconds": 291.54,
      "duration_seconds": 15.2,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold. Rest, plenty of fluids, and paracetamol if you ache. I'll want another look if it is not better in ten days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.28,
      "end_seconds": 299.03,
      "duration_seconds": 3.75,
      "text": "So, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.82,
      "end_seconds": 304.43,
      "duration_seconds": 4.61,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.39,
      "end_seconds": 308.75,
      "duration_seconds": 2.36,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.62,
      "end_seconds": 311.81,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}