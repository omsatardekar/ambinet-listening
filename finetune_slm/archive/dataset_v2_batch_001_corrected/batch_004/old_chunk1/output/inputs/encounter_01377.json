{
  "schema_version": "1.0",
  "encounter_id": "01377",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.11,
      "end_seconds": 8.28,
      "duration_seconds": 7.17,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.02,
      "end_seconds": 12.5,
      "duration_seconds": 3.48,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.36,
      "end_seconds": 17.21,
      "duration_seconds": 3.85,
      "text": "thank you for fitting us in, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.83,
      "end_seconds": 20.45,
      "duration_seconds": 2.62,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.6,
      "end_seconds": 29.71,
      "duration_seconds": 8.11,
      "text": "It's sharp pain low on one side, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.01,
      "end_seconds": 34.19,
      "duration_seconds": 3.18,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.46,
      "end_seconds": 37.74,
      "duration_seconds": 2.28,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.72,
      "end_seconds": 41.42,
      "duration_seconds": 2.7,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.23,
      "end_seconds": 44.31,
      "duration_seconds": 2.08,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.92,
      "end_seconds": 49.35,
      "duration_seconds": 3.43,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.88,
      "end_seconds": 57.63,
      "duration_seconds": 6.75,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.54,
      "end_seconds": 67.26,
      "duration_seconds": 5.72,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.9,
      "end_seconds": 68.97,
      "duration_seconds": 1.07,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.41,
      "end_seconds": 77.69,
      "duration_seconds": 8.28,
      "text": "Well, you know, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 77.79,
      "end_seconds": 84.87,
      "duration_seconds": 7.08,
      "text": "Hmm, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.37,
      "end_seconds": 88.1,
      "duration_seconds": 2.73,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.91,
      "end_seconds": 96.68,
      "duration_seconds": 7.77,
      "text": "So, that's fine, one at a time. I'll ask about everything. Any light vaginal bleeding as well?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 98.49,
      "end_seconds": 100.52,
      "duration_seconds": 2.03,
      "text": "yes, for one week"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.87,
      "end_seconds": 119.44,
      "duration_seconds": 2.57,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.95,
      "end_seconds": 123.97,
      "duration_seconds": 4.02,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.82,
      "end_seconds": 128.41,
      "duration_seconds": 2.59,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.84,
      "end_seconds": 140.68,
      "duration_seconds": 6.84,
      "text": "For nearly five years. It's, It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 146.23,
      "end_seconds": 156.87,
      "duration_seconds": 10.64,
      "text": "erm, doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.73,
      "end_seconds": 161.54,
      "duration_seconds": 3.81,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.2,
      "end_seconds": 172.14,
      "duration_seconds": 8.94,
      "text": "Mm, not with me. I'll bring it next time. Spironolactone, once a day for my heart."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.07,
      "end_seconds": 176.02,
      "duration_seconds": 1.95,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.49,
      "end_seconds": 178.46,
      "duration_seconds": 0.97,
      "text": "25 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.98,
      "end_seconds": 183.28,
      "duration_seconds": 3.3,
      "text": "right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.09,
      "end_seconds": 188.51,
      "duration_seconds": 3.42,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 189.1,
      "end_seconds": 196.1,
      "duration_seconds": 7.0,
      "text": "Hold on, doctor, I think she reacted to amoxicillin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.7,
      "end_seconds": 199.93,
      "duration_seconds": 3.23,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.69,
      "end_seconds": 208.58,
      "duration_seconds": 7.89,
      "text": "Fair enough, I'll write down both versions. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.31,
      "end_seconds": 213.15,
      "duration_seconds": 2.84,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.79,
      "end_seconds": 216.57,
      "duration_seconds": 2.78,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.3,
      "end_seconds": 239.42,
      "duration_seconds": 21.12,
      "text": "I've had an irregular heartbeat for five years now. Sorry, what was I saying, I have anxiety, for two years. Heart failure, for nearly five years. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.5,
      "end_seconds": 246.99,
      "duration_seconds": 5.49,
      "text": "Sure. Right, yes, anxiety is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.79,
      "end_seconds": 264.21,
      "duration_seconds": 1.42,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 265.39,
      "end_seconds": 267.1,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.97,
      "end_seconds": 274.32,
      "duration_seconds": 1.35,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.51,
      "end_seconds": 278.76,
      "duration_seconds": 3.25,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.02,
      "end_seconds": 282.14,
      "duration_seconds": 2.12,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.12,
      "end_seconds": 289.59,
      "duration_seconds": 5.47,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.68,
      "end_seconds": 293.53,
      "duration_seconds": 2.85,
      "text": "Did you get vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 294.3,
      "end_seconds": 303.76,
      "duration_seconds": 9.46,
      "text": "no, no vaginal discharge, no fever. I was feeling faint at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.17,
      "end_seconds": 308.2,
      "duration_seconds": 3.03,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 310.23,
      "end_seconds": 311.88,
      "duration_seconds": 1.65,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.11,
      "end_seconds": 320.07,
      "duration_seconds": 2.96,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 321.04,
      "end_seconds": 322.46,
      "duration_seconds": 1.42,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 324.49,
      "end_seconds": 333.38,
      "duration_seconds": 8.89,
      "text": "Here are the numbers, doctor. Respiratory rate 16, heart rate 118. Saturation 97 percent, temp 36.9 degrees, blood pressure 118 over 84."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.44,
      "end_seconds": 336.14,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.31,
      "end_seconds": 343.19,
      "duration_seconds": 4.88,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.17,
      "end_seconds": 347.63,
      "duration_seconds": 3.46,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.68,
      "end_seconds": 369.66,
      "duration_seconds": 4.98,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.77,
      "end_seconds": 381.63,
      "duration_seconds": 8.86,
      "text": "That's all I needed to check. An urgent pelvic scan is what I'd like next, for possible ectopic."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.85,
      "end_seconds": 385.94,
      "duration_seconds": 3.09,
      "text": "Do I need to to prepare?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.08,
      "end_seconds": 414.6,
      "duration_seconds": 27.52,
      "text": "I'm going to order a pregnancy test, for pelvic pain and bleeding. You need to go to the hospital now for an emergency scan. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 416.05,
      "end_seconds": 417.52,
      "duration_seconds": 1.47,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.53,
      "end_seconds": 429.87,
      "duration_seconds": 10.34,
      "text": "The thing that would worry me is if the pain gets worse or you faint. If that happens, go to emergency. Come back straight away."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 431.06,
      "end_seconds": 433.21,
      "duration_seconds": 2.15,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.77,
      "end_seconds": 441.58,
      "duration_seconds": 2.81,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 442.37,
      "end_seconds": 445.72,
      "duration_seconds": 3.35,
      "text": "Great, thank you for your help."
    }
  ]
}