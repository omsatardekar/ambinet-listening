{
  "schema_version": "1.0",
  "encounter_id": "01437",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.26,
      "duration_seconds": 3.42,
      "text": "hello, doctor may I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.87,
      "end_seconds": 10.67,
      "duration_seconds": 4.8,
      "text": "Yes, come in and and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 13.31,
      "duration_seconds": 1.58,
      "text": "I've been sweating."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.81,
      "end_seconds": 18.84,
      "duration_seconds": 4.03,
      "text": "right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.45,
      "end_seconds": 23.77,
      "duration_seconds": 4.32,
      "text": "It's been about four days I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.75,
      "end_seconds": 35.24,
      "duration_seconds": 10.49,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.85,
      "end_seconds": 42.97,
      "duration_seconds": 6.12,
      "text": "pretty mild if I'm being honest. It sort of comes and goes"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.75,
      "end_seconds": 46.94,
      "duration_seconds": 2.19,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.48,
      "end_seconds": 68.11,
      "duration_seconds": 20.63,
      "text": "Crushing chest pain goes along with it, most of the time. Oh, uh, and pain going into my left arm. That's been about the same, ten days. The Crushing chest pain? That's been since last Tuesday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.77,
      "end_seconds": 70.37,
      "duration_seconds": 1.6,
      "text": "anything that improves it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.63,
      "end_seconds": 74.42,
      "duration_seconds": 2.79,
      "text": "it settles a little with rest"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.18,
      "end_seconds": 77.57,
      "duration_seconds": 2.39,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.66,
      "end_seconds": 89.19,
      "duration_seconds": 2.53,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.76,
      "end_seconds": 123.1,
      "duration_seconds": 12.34,
      "text": "Okay: SpO2 96 percent on room air, temp 36.9 degrees, pressure 138 over 71. And respiratory rate 17, pulse is 113 beats a minute."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.34,
      "end_seconds": 126.36,
      "duration_seconds": 2.02,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.76,
      "end_seconds": 132.18,
      "duration_seconds": 4.42,
      "text": "okay, I'll explain what these mean in a moment"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.64,
      "end_seconds": 138.41,
      "duration_seconds": 3.77,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.77,
      "end_seconds": 142.99,
      "duration_seconds": 3.22,
      "text": "right stay as you are for a moment"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.5,
      "end_seconds": 155.69,
      "duration_seconds": 4.19,
      "text": "You are pale and sweaty and your pulse is fast."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 168.73,
      "duration_seconds": 0.94,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.63,
      "end_seconds": 182.43,
      "duration_seconds": 7.8,
      "text": "You can sit up now. Let me check a few things. Any cough fever or leg swelling?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.84,
      "end_seconds": 188.24,
      "duration_seconds": 4.4,
      "text": "I haven't had cough, fever or leg swelling, no"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.75,
      "end_seconds": 191.74,
      "duration_seconds": 1.99,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.16,
      "end_seconds": 194.85,
      "duration_seconds": 1.69,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.1,
      "end_seconds": 198.07,
      "duration_seconds": 1.97,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.0,
      "end_seconds": 201.53,
      "duration_seconds": 2.53,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.02,
      "end_seconds": 204.65,
      "duration_seconds": 1.63,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.2,
      "end_seconds": 207.95,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.87,
      "end_seconds": 226.37,
      "duration_seconds": 2.5,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.15,
      "end_seconds": 230.48,
      "duration_seconds": 2.33,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.15,
      "end_seconds": 234.3,
      "duration_seconds": 3.15,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.97,
      "end_seconds": 237.92,
      "duration_seconds": 2.95,
      "text": "Lisinopril 10 milligrams once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.12,
      "end_seconds": 238.95,
      "duration_seconds": 0.83,
      "text": "hm okay"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.0,
      "end_seconds": 243.66,
      "duration_seconds": 3.66,
      "text": "I'm on simvastatin, 20 milligrams, at night"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.4,
      "end_seconds": 247.06,
      "duration_seconds": 2.66,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.81,
      "end_seconds": 255.98,
      "duration_seconds": 8.17,
      "text": "About a year now i take metformin, 500 milligrams, twice a day for my sugar"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.55,
      "end_seconds": 260.08,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.68,
      "end_seconds": 264.03,
      "duration_seconds": 3.35,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.31,
      "end_seconds": 280.08,
      "duration_seconds": 2.77,
      "text": "right, what about your medical history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.06,
      "end_seconds": 289.26,
      "duration_seconds": 8.2,
      "text": "I have high blood pressure. Yes, high cholesterol. I have diabetes, for about a year."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.66,
      "end_seconds": 299.07,
      "duration_seconds": 8.41,
      "text": "let me just check I've got this right. You've been sweating for about four days, mild, and no cough or fever"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.25,
      "end_seconds": 301.87,
      "duration_seconds": 1.62,
      "text": "that's it, yes"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.25,
      "end_seconds": 313.84,
      "duration_seconds": 10.59,
      "text": "I'd like to arrange a troponin blood test for chest pain the the result will help us decide whether anything more is needed"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 314.65,
      "end_seconds": 318.37,
      "duration_seconds": 3.72,
      "text": "I can book that for Thursday at 9 am."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.1,
      "end_seconds": 331.64,
      "duration_seconds": 11.54,
      "text": "I think an ECG makes sense here, for chest pain. For this, aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.55,
      "end_seconds": 334.25,
      "duration_seconds": 1.7,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.03,
      "end_seconds": 353.1,
      "duration_seconds": 18.07,
      "text": "Stay lying down and do not eat or drink. I'd like you to see the cardiac team as well, and I'll write the referral. We'll catch up straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.02,
      "end_seconds": 356.59,
      "duration_seconds": 1.57,
      "text": "That's clear, thanks."
    }
  ]
}