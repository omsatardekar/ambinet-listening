{
  "schema_version": "1.0",
  "encounter_id": "01022",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 6.4,
      "duration_seconds": 5.71,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.01,
      "end_seconds": 11.57,
      "duration_seconds": 4.56,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.5,
      "end_seconds": 17.29,
      "duration_seconds": 4.79,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.57,
      "end_seconds": 22.42,
      "duration_seconds": 3.85,
      "text": "Right, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.04,
      "end_seconds": 29.67,
      "duration_seconds": 5.63,
      "text": "Okay, so doctor, it's been feeling confused. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 33.21,
      "duration_seconds": 1.68,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.93,
      "end_seconds": 37.24,
      "duration_seconds": 3.31,
      "text": "I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.39,
      "end_seconds": 41.93,
      "duration_seconds": 3.54,
      "text": "Hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 47.31,
      "duration_seconds": 4.72,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.8,
      "end_seconds": 51.19,
      "duration_seconds": 2.39,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.29,
      "end_seconds": 56.38,
      "duration_seconds": 3.09,
      "text": "Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.38,
      "end_seconds": 59.63,
      "duration_seconds": 1.25,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.74,
      "end_seconds": 64.17,
      "duration_seconds": 3.43,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.12,
      "end_seconds": 73.89,
      "duration_seconds": 7.77,
      "text": "It usually comes with a racing heart. The racing heart? That's been for two days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.44,
      "end_seconds": 80.37,
      "duration_seconds": 4.93,
      "text": "A few quick ones: rash, stiff neck or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.86,
      "end_seconds": 87.03,
      "duration_seconds": 5.17,
      "text": "No rash, stiff neck or chest pain, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.71,
      "end_seconds": 89.66,
      "duration_seconds": 1.95,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.52,
      "end_seconds": 96.68,
      "duration_seconds": 5.16,
      "text": "Sorry, what was I saying, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.29,
      "end_seconds": 110.04,
      "duration_seconds": 4.75,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.5,
      "end_seconds": 117.63,
      "duration_seconds": 6.13,
      "text": "Uh, I'm allergic to erythromycin, I get bad stomach cramps."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.77,
      "end_seconds": 122.11,
      "duration_seconds": 3.34,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 122.88,
      "end_seconds": 130.1,
      "duration_seconds": 7.22,
      "text": "She is on Thyronorm, 50 micrograms, every morning for my thyroid, I give it to her."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.53,
      "end_seconds": 140.33,
      "duration_seconds": 2.8,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.14,
      "end_seconds": 145.11,
      "duration_seconds": 3.97,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.13,
      "end_seconds": 148.05,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.53,
      "end_seconds": 153.18,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.78,
      "end_seconds": 158.01,
      "duration_seconds": 4.23,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.63,
      "end_seconds": 162.44,
      "duration_seconds": 2.81,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.78,
      "end_seconds": 166.86,
      "duration_seconds": 3.08,
      "text": "So, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.87,
      "end_seconds": 172.97,
      "duration_seconds": 5.1,
      "text": "Uh, I had my womb taken out fifteen years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.46,
      "end_seconds": 177.29,
      "duration_seconds": 2.83,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.47,
      "end_seconds": 192.84,
      "duration_seconds": 2.37,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.12,
      "end_seconds": 214.5,
      "duration_seconds": 8.38,
      "text": "Okay: blood pressure 124 over 68, temp 39.1 degrees. And saturation 97 percent, pulse is 99 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.73,
      "end_seconds": 220.65,
      "duration_seconds": 3.92,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.54,
      "end_seconds": 222.46,
      "duration_seconds": 0.92,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.36,
      "end_seconds": 225.69,
      "duration_seconds": 2.33,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.66,
      "end_seconds": 250.24,
      "duration_seconds": 6.58,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.92,
      "end_seconds": 263.94,
      "duration_seconds": 9.02,
      "text": "All finished, thank you. Okay, so my impression is this: This is probably possible sepsis needing urgent treatment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.59,
      "end_seconds": 269.64,
      "duration_seconds": 4.05,
      "text": "Um, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.78,
      "end_seconds": 279.21,
      "duration_seconds": 8.43,
      "text": "It's reasonable to be concerned, but right now possible sepsis needing urgent treatment is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.89,
      "end_seconds": 305.51,
      "duration_seconds": 15.62,
      "text": "I'd like to arrange blood cultures for fever with low blood pressure. I want to admit you to hospital now for fluids and antibiotics. I'd like to see you again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.12,
      "end_seconds": 308.25,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}