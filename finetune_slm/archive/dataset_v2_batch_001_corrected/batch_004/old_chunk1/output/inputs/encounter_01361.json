{
  "schema_version": "1.0",
  "encounter_id": "01361",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 6.87,
      "duration_seconds": 5.61,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.48,
      "end_seconds": 8.73,
      "duration_seconds": 1.25,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.5,
      "end_seconds": 12.02,
      "duration_seconds": 2.52,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.99,
      "end_seconds": 20.11,
      "duration_seconds": 6.12,
      "text": "Honestly, it's no real problems, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.5,
      "end_seconds": 28.62,
      "duration_seconds": 3.12,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.7,
      "end_seconds": 42.24,
      "duration_seconds": 8.54,
      "text": "It's been going on for about two weeks. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.77,
      "end_seconds": 47.0,
      "duration_seconds": 3.23,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.31,
      "end_seconds": 53.09,
      "duration_seconds": 4.78,
      "text": "Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.52,
      "end_seconds": 67.28,
      "duration_seconds": 4.76,
      "text": "And what about weight loss, chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.36,
      "end_seconds": 74.35,
      "duration_seconds": 4.99,
      "text": "Okay, so no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.32,
      "end_seconds": 80.03,
      "duration_seconds": 3.71,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.79,
      "end_seconds": 86.9,
      "duration_seconds": 5.11,
      "text": "Uh, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.77,
      "end_seconds": 90.75,
      "duration_seconds": 2.98,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.74,
      "end_seconds": 93.71,
      "duration_seconds": 1.97,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.62,
      "end_seconds": 115.48,
      "duration_seconds": 4.86,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.18,
      "end_seconds": 125.5,
      "duration_seconds": 8.32,
      "text": "I walk the dog every morning. I look after my grandchildren most days. My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.19,
      "end_seconds": 129.97,
      "duration_seconds": 2.78,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.22,
      "end_seconds": 135.92,
      "duration_seconds": 4.7,
      "text": "Nothing, you know, I haven't had any operations."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.31,
      "end_seconds": 148.13,
      "duration_seconds": 3.82,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.8,
      "end_seconds": 152.64,
      "duration_seconds": 3.84,
      "text": "I'm on rosuvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.5,
      "end_seconds": 156.64,
      "duration_seconds": 2.14,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.24,
      "end_seconds": 159.59,
      "duration_seconds": 1.35,
      "text": "It's 10 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.58,
      "end_seconds": 165.97,
      "duration_seconds": 4.39,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.37,
      "end_seconds": 170.18,
      "duration_seconds": 2.81,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.91,
      "end_seconds": 179.85,
      "duration_seconds": 4.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.62,
      "end_seconds": 193.57,
      "duration_seconds": 11.95,
      "text": "I've got high cholesterol. I've been putting this off for weeks. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.67,
      "end_seconds": 198.45,
      "duration_seconds": 3.78,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.39,
      "end_seconds": 202.66,
      "duration_seconds": 2.27,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.25,
      "end_seconds": 211.12,
      "duration_seconds": 5.87,
      "text": "Right, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.38,
      "end_seconds": 213.79,
      "duration_seconds": 1.41,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.57,
      "end_seconds": 235.33,
      "duration_seconds": 2.76,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.2,
      "end_seconds": 241.7,
      "duration_seconds": 3.5,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.12,
      "end_seconds": 274.34,
      "duration_seconds": 18.22,
      "text": "Let me tell you where I've got to. The most likely explanation is a healthy adult with no worrying findings. The reason I say that is that your story and my examination fit together. I'm going to order a cholesterol blood test, for routine check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.71,
      "end_seconds": 277.21,
      "duration_seconds": 1.5,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.11,
      "end_seconds": 303.74,
      "duration_seconds": 25.63,
      "text": "Keep up regular exercise and a balanced diet. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. If new symptoms appear, or you feel really unwell, please come to the emergency department. Come back in twelve months. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.71,
      "end_seconds": 307.71,
      "duration_seconds": 3.0,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.01,
      "end_seconds": 310.22,
      "duration_seconds": 1.21,
      "text": "Goodbye for now."
    }
  ]
}