{
  "schema_version": "1.0",
  "encounter_id": "01409",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 5.85,
      "duration_seconds": 4.62,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 12.28,
      "duration_seconds": 5.52,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.34,
      "end_seconds": 19.08,
      "duration_seconds": 4.74,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 20.64,
      "end_seconds": 25.76,
      "duration_seconds": 5.12,
      "text": "It's skipped beats. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.73,
      "end_seconds": 29.93,
      "duration_seconds": 3.2,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 30.97,
      "end_seconds": 34.94,
      "duration_seconds": 3.97,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.75,
      "end_seconds": 39.81,
      "duration_seconds": 3.06,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.69,
      "end_seconds": 46.4,
      "duration_seconds": 4.71,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.95,
      "end_seconds": 50.17,
      "duration_seconds": 2.22,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.22,
      "end_seconds": 56.7,
      "duration_seconds": 4.48,
      "text": "I notice it more with lying down and caffeine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.56,
      "end_seconds": 60.28,
      "duration_seconds": 1.72,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.32,
      "end_seconds": 65.33,
      "duration_seconds": 4.01,
      "text": "Only deep breaths, and it's not much."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.9,
      "end_seconds": 66.88,
      "duration_seconds": 0.98,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.59,
      "end_seconds": 78.81,
      "duration_seconds": 11.22,
      "text": "I've also had being a bit anxious. A flutter in my chest was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.77,
      "end_seconds": 81.11,
      "duration_seconds": 1.34,
      "text": "What about dizziness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.38,
      "end_seconds": 85.15,
      "duration_seconds": 2.77,
      "text": "Not at all, no dizziness."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.58,
      "end_seconds": 95.59,
      "duration_seconds": 4.01,
      "text": "Did you get chest pain, shortness of breath or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 97.03,
      "end_seconds": 102.69,
      "duration_seconds": 5.66,
      "text": "I haven't had chest pain, shortness of breath or fainting, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 106.63,
      "duration_seconds": 1.97,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.68,
      "end_seconds": 111.0,
      "duration_seconds": 3.32,
      "text": "Mm, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.83,
      "end_seconds": 116.85,
      "duration_seconds": 2.02,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.94,
      "end_seconds": 120.48,
      "duration_seconds": 2.54,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.63,
      "end_seconds": 124.59,
      "duration_seconds": 2.96,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.51,
      "end_seconds": 131.07,
      "duration_seconds": 4.56,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.86,
      "end_seconds": 136.92,
      "duration_seconds": 5.06,
      "text": "Let's run through your medicines. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 140.49,
      "end_seconds": 143.71,
      "duration_seconds": 3.22,
      "text": "She takes Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.76,
      "end_seconds": 148.89,
      "duration_seconds": 3.13,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.03,
      "end_seconds": 155.33,
      "duration_seconds": 5.3,
      "text": "Uh, my grandfather had a stroke. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.08,
      "end_seconds": 161.97,
      "duration_seconds": 4.89,
      "text": "Right, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.69,
      "end_seconds": 171.0,
      "duration_seconds": 7.31,
      "text": "Years back I got vomiting from tramadol, so I stay away from it now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.59,
      "end_seconds": 174.85,
      "duration_seconds": 2.26,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.15,
      "end_seconds": 181.21,
      "duration_seconds": 5.06,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.25,
      "end_seconds": 184.91,
      "duration_seconds": 2.66,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.49,
      "end_seconds": 189.25,
      "duration_seconds": 3.76,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.71,
      "end_seconds": 210.58,
      "duration_seconds": 3.87,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.45,
      "end_seconds": 215.91,
      "duration_seconds": 3.46,
      "text": "I have COPD, for nearly five years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.84,
      "end_seconds": 217.54,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 229.59,
      "end_seconds": 238.04,
      "duration_seconds": 8.45,
      "text": "Here are the numbers, doctor. Temp 36.9 degrees, SpO2 97 percent on room air, pressure 119 over 79. Pulse 68."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.83,
      "end_seconds": 239.9,
      "duration_seconds": 1.07,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.39,
      "end_seconds": 245.6,
      "duration_seconds": 4.21,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.25,
      "end_seconds": 249.35,
      "duration_seconds": 2.1,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.14,
      "end_seconds": 264.31,
      "duration_seconds": 4.17,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.4,
      "end_seconds": 281.07,
      "duration_seconds": 11.67,
      "text": "Thank you, you can get dressed. So where does that leave us? This looks most like harmless extra heartbeats. We shouldn't forget an anxiety-related palpitation."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.31,
      "end_seconds": 286.27,
      "duration_seconds": 1.96,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.21,
      "end_seconds": 302.94,
      "duration_seconds": 15.73,
      "text": "It's reasonable to be concerned, but right now harmless extra heartbeats is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had skipped beats, since last weekend, and no fainting or shortness of breath."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.9,
      "end_seconds": 308.6,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.49,
      "end_seconds": 313.98,
      "duration_seconds": 3.49,
      "text": "Let's book an ECG to look into palpitations."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 315.35,
      "end_seconds": 319.45,
      "duration_seconds": 4.1,
      "text": "I can book that for Wednesday at 11:30 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.08,
      "end_seconds": 339.12,
      "duration_seconds": 19.04,
      "text": "Cut back on coffee and energy drinks and keep a diary of when it happens. If you faint or have chest pain, that's the point to come in urgently. See me again if it carries on after a month."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 340.47,
      "end_seconds": 342.43,
      "duration_seconds": 1.96,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.29,
      "end_seconds": 348.34,
      "duration_seconds": 4.05,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.49,
      "end_seconds": 352.23,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks."
    }
  ]
}