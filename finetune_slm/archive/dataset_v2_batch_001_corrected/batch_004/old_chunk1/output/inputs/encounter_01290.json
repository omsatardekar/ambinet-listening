{
  "schema_version": "1.0",
  "encounter_id": "01290",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.33,
      "duration_seconds": 4.49,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.26,
      "end_seconds": 11.29,
      "duration_seconds": 5.03,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.14,
      "end_seconds": 15.57,
      "duration_seconds": 3.43,
      "text": "I've been dealing with a sore ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.1,
      "end_seconds": 20.66,
      "duration_seconds": 4.56,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.81,
      "end_seconds": 45.3,
      "duration_seconds": 23.49,
      "text": "I, I'd say on and off. I'd give it a seven, out of ten. Yes, walking. That makes it worse. I looked a few things up online, and that probably didn't help. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.04,
      "end_seconds": 50.42,
      "duration_seconds": 3.38,
      "text": "Has there been a little swelling too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.18,
      "end_seconds": 57.86,
      "duration_seconds": 6.68,
      "text": "Yes, for six months. About little swelling, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.0,
      "end_seconds": 67.07,
      "duration_seconds": 6.07,
      "text": "Have you had a sore ankle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.42,
      "end_seconds": 74.98,
      "duration_seconds": 6.56,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.52,
      "end_seconds": 84.81,
      "duration_seconds": 3.29,
      "text": "And crack or pop, any of that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.06,
      "end_seconds": 89.64,
      "duration_seconds": 3.58,
      "text": "I haven't noticed any crack or pop."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.36,
      "end_seconds": 95.19,
      "duration_seconds": 4.83,
      "text": "A few quick ones: numbness or pain in the foot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.81,
      "end_seconds": 98.74,
      "duration_seconds": 1.93,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.09,
      "end_seconds": 105.05,
      "duration_seconds": 4.96,
      "text": "Okay, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.82,
      "end_seconds": 108.92,
      "duration_seconds": 2.1,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.51,
      "end_seconds": 114.39,
      "duration_seconds": 3.88,
      "text": "Alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.04,
      "end_seconds": 118.03,
      "duration_seconds": 1.99,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.55,
      "end_seconds": 129.63,
      "duration_seconds": 4.08,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.97,
      "end_seconds": 134.29,
      "duration_seconds": 3.32,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.4,
      "end_seconds": 138.4,
      "duration_seconds": 3.0,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.81,
      "end_seconds": 144.44,
      "duration_seconds": 1.63,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.27,
      "end_seconds": 147.93,
      "duration_seconds": 1.66,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.91,
      "end_seconds": 153.05,
      "duration_seconds": 3.14,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.19,
      "end_seconds": 156.34,
      "duration_seconds": 2.15,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.19,
      "end_seconds": 160.92,
      "duration_seconds": 3.73,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.95,
      "end_seconds": 166.34,
      "duration_seconds": 3.39,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.05,
      "end_seconds": 171.23,
      "duration_seconds": 4.18,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.55,
      "end_seconds": 175.56,
      "duration_seconds": 3.01,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.48,
      "end_seconds": 181.66,
      "duration_seconds": 5.18,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.9,
      "end_seconds": 186.57,
      "duration_seconds": 3.67,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.01,
      "end_seconds": 202.22,
      "duration_seconds": 2.21,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.62,
      "end_seconds": 233.81,
      "duration_seconds": 10.19,
      "text": "Okay: pulse is 73 beats a minute, blood pressure 109 over 76. And oxygen saturation is 97 percent, temperature 36.8."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 239.81,
      "duration_seconds": 4.55,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.71,
      "end_seconds": 243.11,
      "duration_seconds": 2.4,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.77,
      "end_seconds": 261.02,
      "duration_seconds": 8.25,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.98,
      "end_seconds": 268.66,
      "duration_seconds": 1.68,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.93,
      "end_seconds": 290.38,
      "duration_seconds": 8.45,
      "text": "Having listened and examined, this is probably a mild ankle sprain. Another possibility is a minor fracture."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.43,
      "end_seconds": 294.97,
      "duration_seconds": 2.54,
      "text": "Actually, will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.98,
      "end_seconds": 305.48,
      "duration_seconds": 9.5,
      "text": "I understand the worry. At the moment I'd say it's a mild ankle sprain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.55,
      "end_seconds": 327.14,
      "duration_seconds": 11.59,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. Come back or go to emergency straight away if you cannot put weight on it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.1,
      "end_seconds": 330.16,
      "duration_seconds": 2.06,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.92,
      "end_seconds": 345.08,
      "duration_seconds": 9.16,
      "text": "I'll want another look if it is not better in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.65,
      "end_seconds": 350.76,
      "duration_seconds": 2.11,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.3,
      "end_seconds": 353.6,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}