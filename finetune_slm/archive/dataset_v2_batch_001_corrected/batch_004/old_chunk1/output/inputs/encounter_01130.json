{
  "schema_version": "1.0",
  "encounter_id": "01130",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 4.47,
      "duration_seconds": 3.88,
      "text": "Um, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.01,
      "end_seconds": 10.14,
      "duration_seconds": 4.13,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 16.98,
      "duration_seconds": 5.3,
      "text": "doctor, it's a runny nose. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.43,
      "end_seconds": 23.45,
      "duration_seconds": 3.02,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.66,
      "end_seconds": 34.14,
      "duration_seconds": 9.48,
      "text": "Severe, I'd say. I've, I've also had a scratchy throat, for ten days. With scratchy throat, it's worse with swallowing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.16,
      "end_seconds": 40.33,
      "duration_seconds": 4.17,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.55,
      "end_seconds": 51.32,
      "duration_seconds": 9.77,
      "text": "I take tamsulosin, 0.4 milligrams, at night for the prostate. Alendronate, 70 milligrams, maybe, once a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.01,
      "end_seconds": 57.41,
      "duration_seconds": 4.4,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.48,
      "end_seconds": 70.15,
      "duration_seconds": 7.67,
      "text": "Not with me. I'll bring it next time. I take throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.9,
      "end_seconds": 72.9,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.69,
      "end_seconds": 78.61,
      "duration_seconds": 4.92,
      "text": "I have an enlarged prostate i've had thin bones, yes"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.14,
      "end_seconds": 90.24,
      "duration_seconds": 10.1,
      "text": "Alright, thin bones, that matches what I have here. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.15,
      "end_seconds": 104.1,
      "duration_seconds": 12.95,
      "text": "I'll have a glass of wine with dinner. I've never touched a cigarette. My partner and our baby. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.03,
      "end_seconds": 113.38,
      "duration_seconds": 4.35,
      "text": "right, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.16,
      "end_seconds": 117.64,
      "duration_seconds": 2.48,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.76,
      "end_seconds": 121.7,
      "duration_seconds": 2.94,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.45,
      "end_seconds": 126.6,
      "duration_seconds": 4.15,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.33,
      "end_seconds": 132.59,
      "duration_seconds": 5.26,
      "text": "Let me check a few things. Any fever or ear pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.65,
      "end_seconds": 137.32,
      "duration_seconds": 2.67,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.46,
      "end_seconds": 143.26,
      "duration_seconds": 4.8,
      "text": "Have you had any shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.79,
      "end_seconds": 149.27,
      "duration_seconds": 2.48,
      "text": "mm, nope, nothing like that"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.16,
      "end_seconds": 153.26,
      "duration_seconds": 2.1,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.45,
      "end_seconds": 156.15,
      "duration_seconds": 1.7,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.59,
      "end_seconds": 159.36,
      "duration_seconds": 1.77,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.34,
      "end_seconds": 167.01,
      "duration_seconds": 2.67,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.69,
      "end_seconds": 182.71,
      "duration_seconds": 3.02,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.03,
      "end_seconds": 192.21,
      "duration_seconds": 2.18,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.93,
      "end_seconds": 210.74,
      "duration_seconds": 7.81,
      "text": "okay: pulse 85, SpO2 97 percent on room air, BP is 114 over 75. And temp 36.8 degrees"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.86,
      "end_seconds": 216.36,
      "duration_seconds": 3.5,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.23,
      "end_seconds": 220.0,
      "duration_seconds": 1.77,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.68,
      "end_seconds": 224.65,
      "duration_seconds": 2.97,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.23,
      "end_seconds": 244.58,
      "duration_seconds": 5.35,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.01,
      "end_seconds": 247.0,
      "duration_seconds": 0.99,
      "text": "of course"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.11,
      "end_seconds": 251.93,
      "duration_seconds": 2.82,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.86,
      "end_seconds": 271.19,
      "duration_seconds": 6.33,
      "text": "So, based on the history and the examination, I'd lean towards a simple viral cold."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.36,
      "end_seconds": 273.75,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.47,
      "end_seconds": 282.63,
      "duration_seconds": 7.16,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.17,
      "end_seconds": 303.48,
      "duration_seconds": 12.31,
      "text": "rest, plenty of fluids, and paracetamol if you ache and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.57,
      "end_seconds": 307.36,
      "duration_seconds": 2.79,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.81,
      "end_seconds": 317.8,
      "duration_seconds": 8.99,
      "text": "Let's plan a check if it is not better in ten days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.69,
      "end_seconds": 321.43,
      "duration_seconds": 2.74,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.78,
      "end_seconds": 324.15,
      "duration_seconds": 1.37,
      "text": "see you soon"
    }
  ]
}