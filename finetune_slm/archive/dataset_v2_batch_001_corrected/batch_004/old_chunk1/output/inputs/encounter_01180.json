{
  "schema_version": "1.0",
  "encounter_id": "01180",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 3.84,
      "duration_seconds": 3.12,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.16,
      "end_seconds": 7.88,
      "duration_seconds": 2.72,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.52,
      "end_seconds": 12.02,
      "duration_seconds": 2.5,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.13,
      "end_seconds": 20.06,
      "duration_seconds": 2.93,
      "text": "It's a blocked ear, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.37,
      "end_seconds": 25.07,
      "duration_seconds": 3.7,
      "text": "So, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.35,
      "end_seconds": 34.93,
      "duration_seconds": 8.58,
      "text": "About... well, about three months. Oh, and a feeling of fullness. Had that since Monday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.16,
      "end_seconds": 51.1,
      "duration_seconds": 4.94,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.49,
      "end_seconds": 54.13,
      "duration_seconds": 1.64,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.03,
      "end_seconds": 57.41,
      "duration_seconds": 2.38,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.18,
      "end_seconds": 66.97,
      "duration_seconds": 3.79,
      "text": "No, you know, I'm not on anything."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.67,
      "end_seconds": 81.7,
      "duration_seconds": 4.03,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.97,
      "end_seconds": 84.47,
      "duration_seconds": 1.5,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.96,
      "end_seconds": 99.81,
      "duration_seconds": 1.85,
      "text": "Okay, do you smoke?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.11,
      "end_seconds": 106.65,
      "duration_seconds": 3.54,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.33,
      "end_seconds": 108.69,
      "duration_seconds": 1.36,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 113.15,
      "duration_seconds": 2.82,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.84,
      "end_seconds": 117.73,
      "duration_seconds": 2.89,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.82,
      "end_seconds": 122.11,
      "duration_seconds": 3.29,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 125.5,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.31,
      "end_seconds": 129.91,
      "duration_seconds": 2.6,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.87,
      "end_seconds": 134.72,
      "duration_seconds": 3.85,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.31,
      "end_seconds": 137.23,
      "duration_seconds": 1.92,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.92,
      "end_seconds": 142.15,
      "duration_seconds": 3.23,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.19,
      "end_seconds": 146.99,
      "duration_seconds": 2.8,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.65,
      "end_seconds": 166.95,
      "duration_seconds": 2.3,
      "text": "Has there been any dizziness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.69,
      "end_seconds": 169.3,
      "duration_seconds": 1.61,
      "text": "No, no dizziness."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.29,
      "end_seconds": 172.52,
      "duration_seconds": 2.23,
      "text": "Any ear pain or discharge?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.34,
      "end_seconds": 176.6,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.43,
      "end_seconds": 181.41,
      "duration_seconds": 3.98,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.39,
      "end_seconds": 183.73,
      "duration_seconds": 1.34,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.61,
      "end_seconds": 189.65,
      "duration_seconds": 5.04,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.7,
      "end_seconds": 192.65,
      "duration_seconds": 1.95,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.88,
      "end_seconds": 197.85,
      "duration_seconds": 3.97,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.46,
      "end_seconds": 211.77,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 235.24,
      "duration_seconds": 6.27,
      "text": "Okay: pulse is 80 beats a minute, blood pressure 117 over 76, saturation 97 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.91,
      "end_seconds": 237.35,
      "duration_seconds": 1.44,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.38,
      "end_seconds": 242.68,
      "duration_seconds": 3.3,
      "text": "Alright, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.1,
      "end_seconds": 247.75,
      "duration_seconds": 3.65,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.03,
      "end_seconds": 251.16,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.68,
      "end_seconds": 263.77,
      "duration_seconds": 4.09,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.35,
      "end_seconds": 279.2,
      "duration_seconds": 9.85,
      "text": "You can relax now. Let me tell you where I've got to. I think we're dealing with earwax blocking the ear at this stage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.81,
      "end_seconds": 283.99,
      "duration_seconds": 3.18,
      "text": "Um, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.44,
      "end_seconds": 302.99,
      "duration_seconds": 17.55,
      "text": "Nothing I've seen today points to an emergency. It looks like earwax blocking the ear, but I'd like to confirm. Just to be sure I understood. You've had a blocked ear for about three months, and no ear pain or dizziness."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.65,
      "end_seconds": 306.41,
      "duration_seconds": 2.76,
      "text": "So, that's what happened, yes."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.53,
      "end_seconds": 311.24,
      "duration_seconds": 3.71,
      "text": "Ear irrigation is what I'd like next, for wax."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 312.19,
      "end_seconds": 315.48,
      "duration_seconds": 3.29,
      "text": "I can book that for Friday at 9 am."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.36,
      "end_seconds": 321.99,
      "duration_seconds": 2.63,
      "text": "Well, okay, I'll be there."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.05,
      "end_seconds": 331.27,
      "duration_seconds": 8.22,
      "text": "Use the olive oil drops for a week and then we'll syringe the ear. I'd like you back in one week."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.2,
      "end_seconds": 334.31,
      "duration_seconds": 2.11,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.88,
      "end_seconds": 339.17,
      "duration_seconds": 3.29,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.48,
      "end_seconds": 344.55,
      "duration_seconds": 4.07,
      "text": "Um, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.17,
      "end_seconds": 347.49,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}