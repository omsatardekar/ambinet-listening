{
  "schema_version": "1.0",
  "encounter_id": "01083",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 6.58,
      "duration_seconds": 5.51,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 8.68,
      "end_seconds": 11.87,
      "duration_seconds": 3.19,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.59,
      "end_seconds": 19.34,
      "duration_seconds": 5.75,
      "text": "that's fine, sit down we'll go through it together have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 21.32,
      "end_seconds": 26.41,
      "duration_seconds": 5.09,
      "text": "Uh, a couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.6,
      "end_seconds": 29.78,
      "duration_seconds": 2.18,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.65,
      "end_seconds": 37.85,
      "duration_seconds": 7.2,
      "text": "Honestly, it's an itchy patch on my wrist, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.1,
      "end_seconds": 45.11,
      "duration_seconds": 3.01,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.72,
      "end_seconds": 50.22,
      "duration_seconds": 3.5,
      "text": "Well, I've had it since last weekend."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.95,
      "end_seconds": 59.87,
      "duration_seconds": 8.92,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.59,
      "end_seconds": 68.21,
      "duration_seconds": 7.62,
      "text": "About a seven out of ten. Moisturiser helps a bit. It's a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.82,
      "end_seconds": 71.4,
      "duration_seconds": 2.58,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.22,
      "end_seconds": 79.88,
      "duration_seconds": 6.66,
      "text": "A bit of redness goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.95,
      "end_seconds": 83.91,
      "duration_seconds": 2.96,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.54,
      "end_seconds": 92.64,
      "duration_seconds": 2.1,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.35,
      "end_seconds": 120.45,
      "duration_seconds": 6.1,
      "text": "okay: temp 36.6 degrees, pulse 78, BP is 118 over 77."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.97,
      "end_seconds": 127.51,
      "duration_seconds": 4.54,
      "text": "I'll examine you in a a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.11,
      "end_seconds": 132.39,
      "duration_seconds": 3.28,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.12,
      "end_seconds": 153.47,
      "duration_seconds": 7.35,
      "text": "There's a neat red patch where the watch strap sits, with a a little scaling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.22,
      "end_seconds": 159.35,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.34,
      "end_seconds": 176.8,
      "duration_seconds": 3.46,
      "text": "And what about fever, blisters or spreading?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.9,
      "end_seconds": 181.07,
      "duration_seconds": 3.17,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.64,
      "end_seconds": 186.4,
      "duration_seconds": 3.76,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.18,
      "end_seconds": 189.48,
      "duration_seconds": 2.3,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.14,
      "end_seconds": 203.75,
      "duration_seconds": 2.61,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.29,
      "end_seconds": 205.83,
      "duration_seconds": 1.54,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.36,
      "end_seconds": 217.95,
      "duration_seconds": 3.59,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.19,
      "end_seconds": 225.56,
      "duration_seconds": 4.37,
      "text": "Yes, heart disease. Migraines, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.51,
      "end_seconds": 236.43,
      "duration_seconds": 8.92,
      "text": "Okay, I can see migraines in your file as well. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 237.01,
      "end_seconds": 241.09,
      "duration_seconds": 4.08,
      "text": "Kiwi. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.28,
      "end_seconds": 247.22,
      "duration_seconds": 4.94,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 247.88,
      "end_seconds": 267.94,
      "duration_seconds": 20.06,
      "text": "I used to drink heavily but I stopped four years ago. I quit smoking around ten years ago. I work in accounts at a hospital. I swim twice a week. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.82,
      "end_seconds": 276.86,
      "duration_seconds": 7.04,
      "text": "Do you take any prescribed or over-the-counter medicines? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 277.48,
      "end_seconds": 285.68,
      "duration_seconds": 8.2,
      "text": "It's metoprolol, 50 milligrams, twice a day, doctor. It's propranolol, 40 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.35,
      "end_seconds": 295.2,
      "duration_seconds": 6.85,
      "text": "Okay, thinking it through, this is probably mild contact dermatitis from the watch strap."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.83,
      "end_seconds": 297.25,
      "duration_seconds": 1.42,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.53,
      "end_seconds": 325.0,
      "duration_seconds": 26.47,
      "text": "Nothing I've seen today points to an emergency. It looks like mild contact dermatitis from the watch strap. You'll be taking hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. We'll catch up if it has not cleared in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.34,
      "end_seconds": 334.94,
      "duration_seconds": 3.6,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.05,
      "end_seconds": 337.24,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
}