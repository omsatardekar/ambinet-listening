{
  "schema_version": "1.0",
  "encounter_id": "01272",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.5,
      "end_seconds": 4.39,
      "duration_seconds": 3.89,
      "text": "Um, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.32,
      "end_seconds": 9.2,
      "duration_seconds": 3.88,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.15,
      "end_seconds": 20.44,
      "duration_seconds": 9.29,
      "text": "Hello, doctor. I'm here with them in case I can help. He's been having a dry cough in the evenings, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.82,
      "end_seconds": 25.05,
      "duration_seconds": 3.23,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.77,
      "end_seconds": 29.2,
      "duration_seconds": 2.43,
      "text": "It's been two days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.82,
      "end_seconds": 33.76,
      "duration_seconds": 2.94,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.32,
      "end_seconds": 38.14,
      "duration_seconds": 3.82,
      "text": "Hmm, pollen season definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.52,
      "end_seconds": 43.32,
      "duration_seconds": 3.8,
      "text": "So, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.68,
      "end_seconds": 46.2,
      "duration_seconds": 1.52,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 53.53,
      "duration_seconds": 5.26,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.79,
      "end_seconds": 61.33,
      "duration_seconds": 6.54,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.16,
      "end_seconds": 70.04,
      "duration_seconds": 5.88,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.96,
      "end_seconds": 73.77,
      "duration_seconds": 2.81,
      "text": "It's a few times a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.38,
      "end_seconds": 81.27,
      "duration_seconds": 6.89,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.37,
      "end_seconds": 86.68,
      "duration_seconds": 5.31,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.04,
      "end_seconds": 103.33,
      "duration_seconds": 15.29,
      "text": "I was getting to that! Okay, so as for sneezing fits, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.34,
      "end_seconds": 107.42,
      "duration_seconds": 3.08,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.25,
      "end_seconds": 113.51,
      "duration_seconds": 4.26,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.92,
      "end_seconds": 114.74,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 116.06,
      "end_seconds": 118.02,
      "duration_seconds": 1.96,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.73,
      "end_seconds": 120.75,
      "duration_seconds": 2.02,
      "text": "How about shortness of breath?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.59,
      "end_seconds": 124.16,
      "duration_seconds": 2.57,
      "text": "Nope, no shortness of breath."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.33,
      "end_seconds": 127.98,
      "duration_seconds": 2.65,
      "text": "Have you noticed fever or wheeze?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.62,
      "end_seconds": 139.68,
      "duration_seconds": 11.06,
      "text": "No, no fever, no wheeze. I did have itchy eyes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.75,
      "end_seconds": 144.03,
      "duration_seconds": 3.28,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.07,
      "end_seconds": 147.13,
      "duration_seconds": 1.06,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.08,
      "end_seconds": 152.03,
      "duration_seconds": 3.95,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.65,
      "end_seconds": 156.16,
      "duration_seconds": 2.51,
      "text": "Actually, no weakness or anything."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.32,
      "end_seconds": 161.46,
      "duration_seconds": 4.14,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.31,
      "end_seconds": 170.16,
      "duration_seconds": 7.85,
      "text": "It's glibenclamide, 5 milligrams, before breakfast. Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.78,
      "end_seconds": 178.73,
      "duration_seconds": 7.95,
      "text": "It's meant to be at night, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.26,
      "end_seconds": 185.24,
      "duration_seconds": 4.98,
      "text": "Clopidogrel. I take it 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.21,
      "end_seconds": 194.18,
      "duration_seconds": 6.97,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.09,
      "end_seconds": 198.9,
      "duration_seconds": 2.81,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.75,
      "end_seconds": 209.6,
      "duration_seconds": 8.85,
      "text": "For the migraine prevention, I believe. My son sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.01,
      "end_seconds": 215.5,
      "duration_seconds": 4.49,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.67,
      "end_seconds": 222.79,
      "duration_seconds": 6.12,
      "text": "My brother has epilepsy. Actually, you know, my mother had a stroke."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.18,
      "end_seconds": 226.41,
      "duration_seconds": 2.23,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.72,
      "end_seconds": 230.17,
      "duration_seconds": 2.45,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.87,
      "end_seconds": 234.07,
      "duration_seconds": 2.2,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.08,
      "end_seconds": 242.77,
      "duration_seconds": 5.69,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.44,
      "end_seconds": 250.88,
      "duration_seconds": 6.44,
      "text": "Let me ask about allergies, anything at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.03,
      "end_seconds": 255.14,
      "duration_seconds": 3.11,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.8,
      "end_seconds": 270.12,
      "duration_seconds": 4.32,
      "text": "Right, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.68,
      "end_seconds": 273.3,
      "duration_seconds": 2.62,
      "text": "Diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.03,
      "end_seconds": 275.37,
      "duration_seconds": 1.34,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.44,
      "end_seconds": 283.91,
      "duration_seconds": 6.47,
      "text": "I have high cholesterol, for about ten years. Heart disease, for two years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.84,
      "end_seconds": 286.28,
      "duration_seconds": 1.44,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.01,
      "end_seconds": 295.75,
      "duration_seconds": 8.74,
      "text": "I've, I've had migraines for nearly five years now. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.39,
      "end_seconds": 306.45,
      "duration_seconds": 7.06,
      "text": "Right, so diabetes and high cholesterol are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.41,
      "end_seconds": 330.82,
      "duration_seconds": 11.41,
      "text": "Going by what you've described, it fits best with seasonal hay fever causing the cough. It could also be early asthma, so we'll keep that open."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.41,
      "end_seconds": 334.06,
      "duration_seconds": 1.65,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.71,
      "end_seconds": 366.35,
      "duration_seconds": 30.64,
      "text": "I understand the worry. At the moment I'd say it's seasonal hay fever causing the cough, and we'll watch how it goes. We'll begin with fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever. Keep windows closed on high-pollen days and wash your hair at night. Please don't wait if you start wheezing. That's when to be seen urgently. Book a review in a month."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.27,
      "end_seconds": 370.13,
      "duration_seconds": 2.86,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.41,
      "end_seconds": 374.27,
      "duration_seconds": 2.86,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.83,
      "end_seconds": 379.57,
      "duration_seconds": 3.74,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}