{
  "schema_version": "1.0",
  "encounter_id": "01011",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 3.76,
      "duration_seconds": 2.88,
      "text": "Good afternoon, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.83,
      "end_seconds": 10.08,
      "duration_seconds": 4.25,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.86,
      "end_seconds": 15.4,
      "duration_seconds": 3.54,
      "text": "so, I've been feeling well, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.46,
      "end_seconds": 19.85,
      "duration_seconds": 3.39,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.29,
      "end_seconds": 30.89,
      "duration_seconds": 6.6,
      "text": "it's mild, honestly. I've also had slightly dry skin, for about two weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.88,
      "end_seconds": 36.25,
      "duration_seconds": 4.37,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.8,
      "end_seconds": 44.53,
      "duration_seconds": 6.73,
      "text": "I have an underactive thyroid. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.47,
      "end_seconds": 46.95,
      "duration_seconds": 1.48,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.57,
      "end_seconds": 56.71,
      "duration_seconds": 8.14,
      "text": "I have thin bones, for two years. Oh, I've had low haemoglobin for five years now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.72,
      "end_seconds": 64.36,
      "duration_seconds": 2.64,
      "text": "Ah. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.99,
      "end_seconds": 73.04,
      "duration_seconds": 7.05,
      "text": "it's something called thyr... thyroxine, 75 micrograms, maybe, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.1,
      "end_seconds": 79.02,
      "duration_seconds": 4.92,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.46,
      "end_seconds": 89.02,
      "duration_seconds": 8.56,
      "text": "No, it's at home. Alendronate, 70 milligrams, once a week. Iron tablets. I take it once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.39,
      "end_seconds": 92.3,
      "duration_seconds": 2.91,
      "text": "Sure. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.58,
      "end_seconds": 95.98,
      "duration_seconds": 2.4,
      "text": "yes, walnuts. I get hives"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.87,
      "end_seconds": 99.81,
      "duration_seconds": 2.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.86,
      "end_seconds": 103.02,
      "duration_seconds": 1.16,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.29,
      "end_seconds": 108.5,
      "duration_seconds": 4.21,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.01,
      "end_seconds": 116.4,
      "duration_seconds": 4.39,
      "text": "Um, uh, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.85,
      "end_seconds": 122.62,
      "duration_seconds": 4.77,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.93,
      "end_seconds": 133.34,
      "duration_seconds": 9.41,
      "text": "I walk the dog every morning. Yes, I work in a bakery, early starts. My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.42,
      "end_seconds": 157.41,
      "duration_seconds": 6.99,
      "text": "let me check a few things any weight change, feeling cold, constipation or palpitations?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.58,
      "end_seconds": 165.54,
      "duration_seconds": 1.96,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.3,
      "end_seconds": 169.92,
      "duration_seconds": 2.62,
      "text": "Okay, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.99,
      "end_seconds": 173.13,
      "duration_seconds": 2.14,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.18,
      "end_seconds": 191.67,
      "duration_seconds": 2.49,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.27,
      "end_seconds": 207.33,
      "duration_seconds": 3.06,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 240.35,
      "duration_seconds": 15.65,
      "text": "Okay: temp 36.9 degrees, BP is 123 over 76. And heart rate 82, height 185 centimetres, saturation 99 percent, respiratory rate 15, weight 52 kilos, BMI works out to 15.2."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.2,
      "end_seconds": 246.07,
      "duration_seconds": 1.87,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.53,
      "end_seconds": 249.93,
      "duration_seconds": 2.4,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.11,
      "end_seconds": 255.05,
      "duration_seconds": 2.94,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.72,
      "end_seconds": 267.77,
      "duration_seconds": 1.05,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.15,
      "end_seconds": 271.96,
      "duration_seconds": 2.81,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.02,
      "end_seconds": 290.36,
      "duration_seconds": 5.34,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.76,
      "end_seconds": 303.8,
      "duration_seconds": 10.04,
      "text": "okay, that's enough for me having listened and examined, I think we're dealing with well-controlled thyroid replacement at this stage"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.87,
      "end_seconds": 307.71,
      "duration_seconds": 2.84,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.74,
      "end_seconds": 340.34,
      "duration_seconds": 31.6,
      "text": "I can't promise yet, but most people with well-controlled thyroid replacement do well once it's treated properly. A thyroid blood test is what I'd like next, for annual review. The result will help us decide whether anything more is needed. Keep taking the tablet on an empty stomach, apart from coffee. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.84,
      "end_seconds": 350.23,
      "duration_seconds": 9.39,
      "text": "sure and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.31,
      "end_seconds": 354.64,
      "duration_seconds": 2.33,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.84,
      "end_seconds": 373.11,
      "duration_seconds": 17.27,
      "text": "If you notice palpitations or weight change, or you feel really unwell, please come to the emergency department. I'd like to see you again in twelve months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.59,
      "end_seconds": 377.99,
      "duration_seconds": 3.4,
      "text": "I think I understand everything. Thanks."
    }
  ]
}