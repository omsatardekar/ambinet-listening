{
  "schema_version": "1.0",
  "encounter_id": "01364",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 7.33,
      "duration_seconds": 6.04,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.0,
      "end_seconds": 11.82,
      "duration_seconds": 3.82,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.79,
      "end_seconds": 17.27,
      "duration_seconds": 4.48,
      "text": "Mainly I've been wanting contraception. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.98,
      "end_seconds": 22.16,
      "duration_seconds": 3.18,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.03,
      "end_seconds": 30.7,
      "duration_seconds": 6.67,
      "text": "About a month, I think... sorry, six months, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.51,
      "end_seconds": 34.45,
      "duration_seconds": 2.94,
      "text": "So, is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.29,
      "end_seconds": 45.63,
      "duration_seconds": 10.34,
      "text": "When it starts I tend to get slightly heavy periods as well. The slightly heavy periods? That's been for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.66,
      "end_seconds": 51.84,
      "duration_seconds": 4.18,
      "text": "Have you had any migraine with aura or smoking?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.02,
      "end_seconds": 56.0,
      "duration_seconds": 2.98,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.11,
      "end_seconds": 60.39,
      "duration_seconds": 3.28,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.43,
      "end_seconds": 66.84,
      "duration_seconds": 4.41,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.86,
      "end_seconds": 70.59,
      "duration_seconds": 2.73,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.46,
      "end_seconds": 75.93,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.15,
      "end_seconds": 84.63,
      "duration_seconds": 3.48,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.73,
      "end_seconds": 89.65,
      "duration_seconds": 3.92,
      "text": "I'm allergic to grass pollen, I get sneezing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.38,
      "end_seconds": 94.2,
      "duration_seconds": 3.82,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.32,
      "end_seconds": 98.63,
      "duration_seconds": 3.31,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.68,
      "end_seconds": 116.69,
      "duration_seconds": 2.01,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.16,
      "end_seconds": 120.67,
      "duration_seconds": 2.51,
      "text": "Simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.66,
      "end_seconds": 124.03,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.65,
      "end_seconds": 128.44,
      "duration_seconds": 2.79,
      "text": "I've had high cholesterol, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.61,
      "end_seconds": 132.02,
      "duration_seconds": 2.41,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.59,
      "end_seconds": 136.35,
      "duration_seconds": 2.76,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.21,
      "end_seconds": 141.65,
      "duration_seconds": 3.44,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.05,
      "end_seconds": 148.24,
      "duration_seconds": 5.19,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.19,
      "end_seconds": 154.27,
      "duration_seconds": 2.08,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.12,
      "end_seconds": 161.22,
      "duration_seconds": 6.1,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.03,
      "end_seconds": 164.91,
      "duration_seconds": 2.88,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.94,
      "end_seconds": 175.63,
      "duration_seconds": 2.69,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.18,
      "end_seconds": 199.19,
      "duration_seconds": 7.01,
      "text": "Okay: heart rate 78, respiratory rate 14, blood pressure 115 over 81, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.3,
      "end_seconds": 206.75,
      "duration_seconds": 1.45,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.06,
      "end_seconds": 210.56,
      "duration_seconds": 2.5,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.92,
      "end_seconds": 216.9,
      "duration_seconds": 3.98,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.92,
      "end_seconds": 220.81,
      "duration_seconds": 2.89,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.45,
      "end_seconds": 240.62,
      "duration_seconds": 2.17,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.8,
      "end_seconds": 245.99,
      "duration_seconds": 2.19,
      "text": "Right, please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.62,
      "end_seconds": 261.12,
      "duration_seconds": 6.5,
      "text": "Putting it all together, this looks most like suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.71,
      "end_seconds": 297.67,
      "duration_seconds": 20.96,
      "text": "I'll start you on levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. You take it by mouth. It's for contraception. Take the pill at the same time each day and use condoms if you miss two. I'll want another look in three months."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.56,
      "end_seconds": 302.84,
      "duration_seconds": 3.28,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.05,
      "end_seconds": 307.19,
      "duration_seconds": 3.14,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.76,
      "end_seconds": 316.46,
      "duration_seconds": 3.7,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}