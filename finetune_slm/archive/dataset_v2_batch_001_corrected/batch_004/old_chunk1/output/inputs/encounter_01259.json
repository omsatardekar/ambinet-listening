{
  "schema_version": "1.0",
  "encounter_id": "01259",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.67,
      "end_seconds": 6.61,
      "duration_seconds": 5.94,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.55,
      "end_seconds": 15.91,
      "duration_seconds": 3.36,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.33,
      "end_seconds": 26.9,
      "duration_seconds": 9.57,
      "text": "I'm, I'm here because of severe lower back pain. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.41,
      "end_seconds": 31.83,
      "duration_seconds": 3.42,
      "text": "Okay, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 32.37,
      "end_seconds": 34.11,
      "duration_seconds": 1.74,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.33,
      "end_seconds": 49.54,
      "duration_seconds": 3.21,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.76,
      "end_seconds": 58.51,
      "duration_seconds": 7.75,
      "text": "So, ever since... since last Tuesday, really. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.62,
      "end_seconds": 66.45,
      "duration_seconds": 2.83,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 69.92,
      "end_seconds": 71.89,
      "duration_seconds": 1.97,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.65,
      "end_seconds": 76.62,
      "duration_seconds": 2.97,
      "text": "So, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.23,
      "end_seconds": 80.53,
      "duration_seconds": 2.3,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.61,
      "end_seconds": 83.46,
      "duration_seconds": 1.85,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.09,
      "end_seconds": 91.94,
      "duration_seconds": 2.85,
      "text": "Yes, bending. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.19,
      "end_seconds": 98.47,
      "duration_seconds": 3.28,
      "text": "And what about recent fall or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.31,
      "end_seconds": 105.38,
      "duration_seconds": 4.07,
      "text": "No recent fall or fever, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.82,
      "end_seconds": 109.5,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.04,
      "end_seconds": 112.63,
      "duration_seconds": 2.59,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.53,
      "end_seconds": 127.51,
      "duration_seconds": 2.98,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.55,
      "end_seconds": 134.02,
      "duration_seconds": 4.47,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.73,
      "end_seconds": 138.09,
      "duration_seconds": 3.36,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.43,
      "end_seconds": 141.63,
      "duration_seconds": 2.2,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.26,
      "end_seconds": 147.12,
      "duration_seconds": 4.86,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.27,
      "end_seconds": 156.27,
      "duration_seconds": 3.0,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.15,
      "end_seconds": 160.54,
      "duration_seconds": 2.39,
      "text": "So, how active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.27,
      "end_seconds": 165.09,
      "duration_seconds": 3.82,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.84,
      "end_seconds": 169.77,
      "duration_seconds": 2.93,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.81,
      "end_seconds": 176.07,
      "duration_seconds": 4.26,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.73,
      "end_seconds": 178.67,
      "duration_seconds": 1.94,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.8,
      "end_seconds": 183.87,
      "duration_seconds": 4.07,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 185.25,
      "end_seconds": 196.04,
      "duration_seconds": 10.79,
      "text": "Okay, so the vitals from earlier. BP is 111 over 74, SpO2 99 percent on room air, temperature 36.9. Pulse is 70 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.77,
      "end_seconds": 197.8,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.86,
      "end_seconds": 201.82,
      "duration_seconds": 1.96,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.93,
      "end_seconds": 204.96,
      "duration_seconds": 2.03,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.19,
      "end_seconds": 219.18,
      "duration_seconds": 5.99,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.07,
      "end_seconds": 226.67,
      "duration_seconds": 2.6,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.14,
      "end_seconds": 255.42,
      "duration_seconds": 14.28,
      "text": "Putting it all together, the most likely explanation is possible cauda equina syndrome needing an urgent scan. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.65,
      "end_seconds": 287.69,
      "duration_seconds": 16.04,
      "text": "I'd like to arrange an urgent MRI of the spine for possible cauda equina. You need to go to hospital now for an emergency scan. I'm going to send a referral to the spinal team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 289.0,
      "end_seconds": 289.7,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.08,
      "end_seconds": 293.94,
      "duration_seconds": 2.86,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.25,
      "end_seconds": 300.44,
      "duration_seconds": 3.19,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.65,
      "end_seconds": 304.91,
      "duration_seconds": 3.26,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.05,
      "end_seconds": 311.14,
      "duration_seconds": 5.09,
      "text": "Right, uh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.09,
      "end_seconds": 313.27,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}