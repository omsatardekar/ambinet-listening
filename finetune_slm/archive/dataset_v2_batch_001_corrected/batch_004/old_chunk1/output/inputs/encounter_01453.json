  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 2.93,
      "duration_seconds": 1.96,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.58,
      "end_seconds": 5.63,
      "duration_seconds": 1.05,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.49,
      "end_seconds": 10.45,
      "duration_seconds": 2.96,
      "text": "start wherever you like, I'm listening"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 17.76,
      "duration_seconds": 5.87,
      "text": "doctor, it's bloating after meals. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.69,
      "end_seconds": 22.49,
      "duration_seconds": 3.8,
      "text": "right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.66,
      "end_seconds": 33.19,
      "duration_seconds": 2.53,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.27,
      "end_seconds": 58.2,
      "duration_seconds": 8.93,
      "text": "Okay: blood pressure 121 over 79, pulse is 66 beats a minute. And temperature 37.0, respiratory rate 15."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.94,
      "end_seconds": 61.55,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.31,
      "end_seconds": 68.5,
      "duration_seconds": 6.19,
      "text": "we'll look at it it together shortly can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.95,
      "end_seconds": 78.68,
      "duration_seconds": 8.73,
      "text": "It's been going on for about a week. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.2,
      "end_seconds": 90.31,
      "duration_seconds": 10.11,
      "text": "Okay, give me more detail on it, whatever comes to mind. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.99,
      "end_seconds": 97.29,
      "duration_seconds": 5.3,
      "text": "Yes, large meals. That makes it worse. Moderate, really."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.58,
      "end_seconds": 100.93,
      "duration_seconds": 2.35,
      "text": "does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.82,
      "end_seconds": 108.26,
      "duration_seconds": 6.44,
      "text": "Loose stools now and then goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.64,
      "end_seconds": 118.21,
      "duration_seconds": 1.57,
      "text": "how about night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.26,
      "end_seconds": 122.4,
      "duration_seconds": 2.14,
      "text": "definitely no night-time diarrhoea"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.24,
      "end_seconds": 127.05,
      "duration_seconds": 2.81,
      "text": "Any vomiting or blood in the stool?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.98,
      "end_seconds": 133.52,
      "duration_seconds": 3.54,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.55,
      "end_seconds": 137.0,
      "duration_seconds": 2.45,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.65,
      "end_seconds": 139.52,
      "duration_seconds": 1.87,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.84,
      "end_seconds": 162.34,
      "duration_seconds": 7.5,
      "text": "do you have any medical conditions I should know about? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.24,
      "end_seconds": 165.86,
      "duration_seconds": 1.62,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.4,
      "end_seconds": 177.84,
      "duration_seconds": 4.44,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.71,
      "end_seconds": 188.54,
      "duration_seconds": 9.83,
      "text": "Lots of rice, lentils and some fruit. My partner and our baby. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.26,
      "end_seconds": 205.42,
      "duration_seconds": 2.16,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.19,
      "end_seconds": 209.2,
      "duration_seconds": 2.01,
      "text": "Peppermint capsules, after meals."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.77,
      "end_seconds": 215.41,
      "duration_seconds": 3.64,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.38,
      "end_seconds": 218.35,
      "duration_seconds": 1.97,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.3,
      "end_seconds": 239.5,
      "duration_seconds": 6.2,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.98,
      "end_seconds": 242.13,
      "duration_seconds": 1.15,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.45,
      "end_seconds": 263.61,
      "duration_seconds": 17.16,
      "text": "Okay, that's enough for me. Taking everything into account, I think we're dealing with a functional bowel pattern, with no alarm features at this stage. Let's book a coeliac blood test to look into bloating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.54,
      "end_seconds": 268.64,
      "duration_seconds": 3.1,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.69,
      "end_seconds": 286.2,
      "duration_seconds": 15.51,
      "text": "try smaller meals and keep a food and symptom diary for four weeks please take the tablets with food so they don't upset your stomach do get help quickly if you see blood in the stool or lose weight"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.01,
      "end_seconds": 292.6,
      "duration_seconds": 3.59,
      "text": "Yes, I'll bear that that in mind."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.16,
      "end_seconds": 301.21,
      "duration_seconds": 7.05,
      "text": "please come and see me in six weeks that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.94,
      "end_seconds": 304.17,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    }
  ]
}