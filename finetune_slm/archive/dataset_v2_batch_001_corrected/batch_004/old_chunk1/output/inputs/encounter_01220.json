{
  "schema_version": "1.0",
  "encounter_id": "01220",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 4.26,
      "duration_seconds": 3.69,
      "text": "So, hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.69,
      "end_seconds": 11.2,
      "duration_seconds": 5.51,
      "text": "Let me think, you know, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.22,
      "end_seconds": 15.09,
      "duration_seconds": 1.87,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.0,
      "end_seconds": 21.32,
      "duration_seconds": 5.32,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.56,
      "end_seconds": 23.8,
      "duration_seconds": 1.24,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.89,
      "end_seconds": 42.42,
      "duration_seconds": 17.53,
      "text": "Mainly I've been feeling well. That's why I came. I didn't want to bother you but it keeps coming back. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.53,
      "end_seconds": 47.2,
      "duration_seconds": 3.67,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.4,
      "end_seconds": 56.83,
      "duration_seconds": 3.43,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.54,
      "end_seconds": 61.08,
      "duration_seconds": 3.54,
      "text": "Okay, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.44,
      "end_seconds": 65.08,
      "duration_seconds": 2.64,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.89,
      "end_seconds": 80.98,
      "duration_seconds": 5.09,
      "text": "Let me check a few things. Any constipation or feeling cold?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.66,
      "end_seconds": 86.2,
      "duration_seconds": 4.54,
      "text": "Mm, I haven't had constipation or feeling cold, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.91,
      "end_seconds": 90.14,
      "duration_seconds": 3.23,
      "text": "And what about weight change or palpitations?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.86,
      "end_seconds": 96.4,
      "duration_seconds": 4.54,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.17,
      "end_seconds": 99.13,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.16,
      "end_seconds": 105.79,
      "duration_seconds": 4.63,
      "text": "Hmm, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 109.79,
      "duration_seconds": 2.04,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.79,
      "end_seconds": 117.82,
      "duration_seconds": 2.03,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.44,
      "end_seconds": 121.08,
      "duration_seconds": 2.64,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.59,
      "end_seconds": 125.38,
      "duration_seconds": 2.79,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.92,
      "end_seconds": 142.76,
      "duration_seconds": 2.84,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.72,
      "end_seconds": 148.67,
      "duration_seconds": 3.95,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.14,
      "end_seconds": 152.15,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.1,
      "end_seconds": 157.69,
      "duration_seconds": 3.59,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.19,
      "end_seconds": 178.31,
      "duration_seconds": 4.12,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.69,
      "end_seconds": 186.0,
      "duration_seconds": 2.31,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.37,
      "end_seconds": 206.56,
      "duration_seconds": 5.19,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.27,
      "end_seconds": 211.5,
      "duration_seconds": 4.23,
      "text": "I'm allergic to cat fur, I get wheezing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.24,
      "end_seconds": 220.57,
      "duration_seconds": 3.33,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.5,
      "end_seconds": 236.1,
      "duration_seconds": 2.6,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.43,
      "end_seconds": 259.89,
      "duration_seconds": 14.46,
      "text": "Okay: weight 93 kilos, blood pressure 110 over 71, height 169 centimetres. And BMI works out to 32.6, temperature is 36.5 degrees, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.25,
      "end_seconds": 264.9,
      "duration_seconds": 2.65,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.44,
      "end_seconds": 267.02,
      "duration_seconds": 1.58,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.1,
      "end_seconds": 269.58,
      "duration_seconds": 1.48,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.74,
      "end_seconds": 283.08,
      "duration_seconds": 4.34,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.0,
      "end_seconds": 296.02,
      "duration_seconds": 7.02,
      "text": "Please sit back down. Putting it all together, I'd lean towards well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.16,
      "end_seconds": 298.6,
      "duration_seconds": 1.44,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.98,
      "end_seconds": 324.37,
      "duration_seconds": 21.39,
      "text": "Nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement, but I'd like to confirm. A thyroid blood test is what I'd like next, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.71,
      "end_seconds": 329.19,
      "duration_seconds": 3.48,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.81,
      "end_seconds": 331.67,
      "duration_seconds": 1.86,
      "text": "Have a good day."
    }
  ]
}