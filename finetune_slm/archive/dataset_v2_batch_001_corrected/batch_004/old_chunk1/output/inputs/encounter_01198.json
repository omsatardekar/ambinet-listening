{
  "schema_version": "1.0",
  "encounter_id": "01198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.96,
      "duration_seconds": 3.8,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.64,
      "end_seconds": 11.92,
      "duration_seconds": 5.28,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.5,
      "end_seconds": 17.95,
      "duration_seconds": 5.45,
      "text": "Doctor, it's bloating after meals. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.47,
      "end_seconds": 21.48,
      "duration_seconds": 3.01,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.56,
      "end_seconds": 25.87,
      "duration_seconds": 3.31,
      "text": "I've had it for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.0,
      "end_seconds": 33.75,
      "duration_seconds": 3.75,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.34,
      "end_seconds": 63.28,
      "duration_seconds": 28.94,
      "text": "It settles a little with walking. I've also had a lot of wind, for about a month. Okay, so as for lot of wind, about a eight out of ten. As for loose stools now and then, I honestly can't say when that began. It might have been last month or the month before. With loose stools now and then, mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.48,
      "end_seconds": 77.8,
      "duration_seconds": 4.32,
      "text": "Have you had any vomiting, weight loss or night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.23,
      "end_seconds": 84.42,
      "duration_seconds": 2.19,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.82,
      "end_seconds": 90.43,
      "duration_seconds": 4.61,
      "text": "Have you had blood in the stool, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.02,
      "end_seconds": 95.14,
      "duration_seconds": 3.12,
      "text": "Definitely no blood in the stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.58,
      "end_seconds": 99.03,
      "duration_seconds": 2.45,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.0,
      "end_seconds": 103.2,
      "duration_seconds": 2.2,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.98,
      "end_seconds": 107.34,
      "duration_seconds": 3.36,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.46,
      "end_seconds": 113.41,
      "duration_seconds": 4.95,
      "text": "Oh, I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.55,
      "end_seconds": 137.25,
      "duration_seconds": 7.7,
      "text": "Has anything ever caused you a reaction? I mean any allergies. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.33,
      "end_seconds": 143.6,
      "duration_seconds": 5.27,
      "text": "Actually, you know, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.42,
      "end_seconds": 146.6,
      "duration_seconds": 2.18,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.35,
      "end_seconds": 150.73,
      "duration_seconds": 2.38,
      "text": "I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.64,
      "end_seconds": 157.98,
      "duration_seconds": 4.34,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.82,
      "end_seconds": 166.56,
      "duration_seconds": 6.74,
      "text": "I take something called esci... escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.44,
      "end_seconds": 172.75,
      "duration_seconds": 4.31,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.45,
      "end_seconds": 176.82,
      "duration_seconds": 2.37,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.14,
      "end_seconds": 182.49,
      "duration_seconds": 4.35,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.56,
      "end_seconds": 188.62,
      "duration_seconds": 5.06,
      "text": "My cousin has psoriasis. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.44,
      "end_seconds": 193.14,
      "duration_seconds": 2.7,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.7,
      "end_seconds": 207.96,
      "duration_seconds": 14.26,
      "text": "I've never touched a cigarette. Yes, I work in a bakery, early starts. Not much, I mostly stay in these days. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.16,
      "end_seconds": 211.8,
      "duration_seconds": 2.64,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.97,
      "end_seconds": 227.29,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.77,
      "end_seconds": 250.7,
      "duration_seconds": 7.93,
      "text": "Okay: oxygen saturation is 98 percent, pressure 109 over 73, heart rate 70. And temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.54,
      "end_seconds": 253.98,
      "duration_seconds": 1.44,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.31,
      "end_seconds": 260.83,
      "duration_seconds": 2.52,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.85,
      "end_seconds": 265.55,
      "duration_seconds": 2.7,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.58,
      "end_seconds": 267.53,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.7,
      "end_seconds": 270.18,
      "duration_seconds": 1.48,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.41,
      "end_seconds": 284.69,
      "duration_seconds": 6.28,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.43,
      "end_seconds": 287.96,
      "duration_seconds": 1.53,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.6,
      "end_seconds": 310.36,
      "duration_seconds": 16.76,
      "text": "All finished, thank you. So, based on the history and the examination, I think we're dealing with a functional bowel pattern, with no alarm features at this stage. I'd also keep irritable bowel syndrome in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.03,
      "end_seconds": 313.03,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.3,
      "end_seconds": 328.31,
      "duration_seconds": 14.01,
      "text": "I understand the worry. At the moment I'd say it's a functional bowel pattern, with no alarm features, and we'll know more once the a coeliac blood test is back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.45,
      "end_seconds": 341.73,
      "duration_seconds": 4.28,
      "text": "I'm going to order a coeliac blood test, for bloating."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 343.59,
      "end_seconds": 346.27,
      "duration_seconds": 2.68,
      "text": "The earliest is Friday, 3:30 pm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.35,
      "end_seconds": 372.34,
      "duration_seconds": 21.99,
      "text": "Try smaller meals and keep a food and symptom diary for four weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if you see blood in the stool or lose weight. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.74,
      "end_seconds": 375.3,
      "duration_seconds": 1.56,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.64,
      "end_seconds": 379.03,
      "duration_seconds": 2.39,
      "text": "Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.5,
      "end_seconds": 381.2,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.86,
      "end_seconds": 385.28,
      "duration_seconds": 3.42,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.28,
      "end_seconds": 390.72,
      "duration_seconds": 3.44,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.34,
      "end_seconds": 392.53,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
}