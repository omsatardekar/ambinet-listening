{
  "schema_version": "1.0",
  "encounter_id": "01179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 4.71,
      "duration_seconds": 3.79,
      "text": "Mm, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 10.03,
      "duration_seconds": 4.06,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.64,
      "end_seconds": 17.32,
      "duration_seconds": 6.68,
      "text": "Honestly, um, it's wheezing, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.36,
      "end_seconds": 26.32,
      "duration_seconds": 3.96,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.49,
      "end_seconds": 41.45,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.55,
      "end_seconds": 67.21,
      "duration_seconds": 5.66,
      "text": "Okay: pulse 93, oxygen saturation is 97 percent, pressure 104 over 58."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.71,
      "end_seconds": 70.17,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.19,
      "end_seconds": 82.05,
      "duration_seconds": 6.86,
      "text": "Okay, they help me see the whole picture, more shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.95,
      "end_seconds": 86.04,
      "duration_seconds": 3.09,
      "text": "Yeah, it's been three weeks now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.41,
      "end_seconds": 89.81,
      "duration_seconds": 3.4,
      "text": "Right, right. How often do you get it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.22,
      "end_seconds": 97.28,
      "duration_seconds": 6.06,
      "text": "It's once or twice a day. And, And my throat closing up, too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.78,
      "end_seconds": 98.77,
      "duration_seconds": 0.99,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.02,
      "end_seconds": 114.25,
      "duration_seconds": 3.23,
      "text": "And what about chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.04,
      "end_seconds": 123.17,
      "duration_seconds": 3.13,
      "text": "So, no, not a single one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.52,
      "end_seconds": 128.37,
      "duration_seconds": 3.85,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.44,
      "end_seconds": 130.42,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.22,
      "end_seconds": 134.24,
      "duration_seconds": 2.02,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.46,
      "end_seconds": 137.04,
      "duration_seconds": 1.58,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.89,
      "end_seconds": 141.77,
      "duration_seconds": 2.88,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.54,
      "end_seconds": 155.22,
      "duration_seconds": 10.68,
      "text": "I live with my elderly mother. I look after my grandchildren most days. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.68,
      "end_seconds": 162.08,
      "duration_seconds": 3.4,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.0,
      "end_seconds": 164.53,
      "duration_seconds": 1.53,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.51,
      "end_seconds": 176.46,
      "duration_seconds": 1.95,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.3,
      "end_seconds": 180.48,
      "duration_seconds": 2.18,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.89,
      "end_seconds": 185.54,
      "duration_seconds": 3.65,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.24,
      "end_seconds": 192.01,
      "duration_seconds": 4.77,
      "text": "Actually, I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.01,
      "end_seconds": 197.13,
      "duration_seconds": 3.12,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.81,
      "end_seconds": 200.81,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.85,
      "end_seconds": 219.48,
      "duration_seconds": 7.63,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.24,
      "end_seconds": 225.86,
      "duration_seconds": 1.62,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.28,
      "end_seconds": 248.65,
      "duration_seconds": 5.37,
      "text": "So, based on the history and the examination, it points towards anaphylaxis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.39,
      "end_seconds": 250.95,
      "duration_seconds": 1.56,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.75,
      "end_seconds": 270.95,
      "duration_seconds": 15.2,
      "text": "Nothing I've seen today points to an emergency. It looks like anaphylaxis, but I'd like to confirm. Stop me if I've got anything wrong. You've had wheezing for three weeks, and no chest pain or recent illness."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.31,
      "end_seconds": 276.94,
      "duration_seconds": 1.63,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.15,
      "end_seconds": 288.54,
      "duration_seconds": 2.39,
      "text": "Let's get monitoring, for anaphylaxis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.63,
      "end_seconds": 292.83,
      "duration_seconds": 2.2,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.67,
      "end_seconds": 315.28,
      "duration_seconds": 20.61,
      "text": "Let's use adrenaline, 0.5 milligrams, once now, single dose. That's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. Let's get you seen by the emergency team, I'll arrange the letter. Come back or go to emergency straight away if the symptoms return."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.75,
      "end_seconds": 321.22,
      "duration_seconds": 1.47,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.89,
      "end_seconds": 325.68,
      "duration_seconds": 2.79,
      "text": "Please come and see me straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.73,
      "end_seconds": 328.92,
      "duration_seconds": 2.19,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.45,
      "end_seconds": 331.9,
      "duration_seconds": 2.45,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.28,
      "end_seconds": 338.73,
      "duration_seconds": 3.45,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}