{
  "schema_version": "1.0",
  "encounter_id": "01339",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 4.67,
      "duration_seconds": 4.04,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.95,
      "end_seconds": 10.26,
      "duration_seconds": 4.31,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.85,
      "end_seconds": 19.13,
      "duration_seconds": 4.28,
      "text": "So the thing is, I've got crushing chest pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.1,
      "end_seconds": 23.93,
      "duration_seconds": 3.83,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.69,
      "end_seconds": 28.6,
      "duration_seconds": 3.91,
      "text": "It's, It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.2,
      "end_seconds": 40.83,
      "duration_seconds": 11.63,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.83,
      "end_seconds": 49.75,
      "duration_seconds": 7.92,
      "text": "It's, It's moderate, honestly. Honestly, on and off. Yes, exertion. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.65,
      "end_seconds": 53.79,
      "duration_seconds": 2.14,
      "text": "Have you been feeling sick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.22,
      "end_seconds": 66.15,
      "duration_seconds": 10.93,
      "text": "Yes, since this morning. Pain going into my left arm was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.18,
      "end_seconds": 72.28,
      "duration_seconds": 4.1,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.96,
      "end_seconds": 85.81,
      "duration_seconds": 2.85,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.15,
      "end_seconds": 109.12,
      "duration_seconds": 8.97,
      "text": "Okay: pressure 134 over 88, oxygen saturation is 99 percent, temperature 36.9, pulse 109, respiratory rate 19."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.76,
      "end_seconds": 125.36,
      "duration_seconds": 3.6,
      "text": "Have you noticed cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.24,
      "end_seconds": 131.89,
      "duration_seconds": 5.65,
      "text": "Oh, I haven't had cough, leg swelling or fever, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.94,
      "end_seconds": 136.03,
      "duration_seconds": 3.09,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.43,
      "end_seconds": 139.34,
      "duration_seconds": 1.91,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.35,
      "end_seconds": 143.6,
      "duration_seconds": 3.25,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.4,
      "end_seconds": 149.0,
      "duration_seconds": 3.6,
      "text": "Hmm, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.81,
      "end_seconds": 152.87,
      "duration_seconds": 2.06,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.3,
      "end_seconds": 160.04,
      "duration_seconds": 5.74,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.72,
      "end_seconds": 164.95,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.97,
      "end_seconds": 169.26,
      "duration_seconds": 3.29,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.96,
      "end_seconds": 172.79,
      "duration_seconds": 1.83,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.65,
      "end_seconds": 177.07,
      "duration_seconds": 3.42,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.45,
      "end_seconds": 181.73,
      "duration_seconds": 3.28,
      "text": "So, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.54,
      "end_seconds": 187.1,
      "duration_seconds": 3.56,
      "text": "Ah, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.18,
      "end_seconds": 193.33,
      "duration_seconds": 5.15,
      "text": "Right, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.06,
      "end_seconds": 197.55,
      "duration_seconds": 2.49,
      "text": "Right, no, nothing at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.86,
      "end_seconds": 213.34,
      "duration_seconds": 8.48,
      "text": "Going by what you've described, this looks most like a possible heart attack. Another possibility is unstable angina."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.19,
      "end_seconds": 217.2,
      "duration_seconds": 3.01,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.08,
      "end_seconds": 231.73,
      "duration_seconds": 9.65,
      "text": "I understand the worry. At the moment I'd say it's a possible heart attack, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.88,
      "end_seconds": 245.94,
      "duration_seconds": 5.06,
      "text": "I think an ECG makes sense here, for chest pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.73,
      "end_seconds": 250.73,
      "duration_seconds": 3.0,
      "text": "Oh, okay, I'll do it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.39,
      "end_seconds": 269.53,
      "duration_seconds": 18.14,
      "text": "I think a troponin blood test makes sense here, for chest pain. Let's use aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.43,
      "end_seconds": 274.33,
      "duration_seconds": 2.9,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.12,
      "end_seconds": 291.42,
      "duration_seconds": 12.3,
      "text": "Stay lying down and do not eat or drink. The cardiac team would be the right next step, I'll refer you. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.49,
      "end_seconds": 296.17,
      "duration_seconds": 2.68,
      "text": "Mm, alright, I'll be back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.75,
      "end_seconds": 301.73,
      "duration_seconds": 3.98,
      "text": "So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.06,
      "end_seconds": 307.49,
      "duration_seconds": 4.43,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.6,
      "end_seconds": 310.18,
      "duration_seconds": 1.58,
      "text": "Have a good day."
    }
  ]
}