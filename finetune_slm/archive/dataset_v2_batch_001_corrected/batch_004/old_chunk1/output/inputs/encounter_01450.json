{
  "schema_version": "1.0",
  "encounter_id": "01450",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 8.22,
      "duration_seconds": 6.88,
      "text": "Sorry, what was I saying, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.11,
      "end_seconds": 13.86,
      "duration_seconds": 4.75,
      "text": "right, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.7,
      "end_seconds": 25.12,
      "duration_seconds": 9.42,
      "text": "I'm here because of a cut on my finger i've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.16,
      "end_seconds": 29.28,
      "duration_seconds": 2.12,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.29,
      "end_seconds": 34.38,
      "duration_seconds": 4.09,
      "text": "I'm on Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.04,
      "end_seconds": 37.69,
      "duration_seconds": 1.65,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.23,
      "end_seconds": 47.5,
      "duration_seconds": 8.27,
      "text": "I've had it for two days. I've had a little bleeding too, for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.8,
      "end_seconds": 51.93,
      "duration_seconds": 3.13,
      "text": "did you get numbness or dirty blade?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.67,
      "end_seconds": 57.1,
      "duration_seconds": 3.43,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.47,
      "end_seconds": 60.5,
      "duration_seconds": 3.03,
      "text": "Mm-hmm. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.21,
      "end_seconds": 65.54,
      "duration_seconds": 3.33,
      "text": "uh, no, all normal there"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.84,
      "end_seconds": 80.66,
      "duration_seconds": 2.82,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.93,
      "end_seconds": 86.43,
      "duration_seconds": 4.5,
      "text": "oh, I'm allergic to wheat, I get bloating"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.26,
      "end_seconds": 90.0,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.67,
      "end_seconds": 95.67,
      "duration_seconds": 5.0,
      "text": "Erm, I have an underactive thyroid, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.84,
      "end_seconds": 109.31,
      "duration_seconds": 1.47,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.14,
      "end_seconds": 111.32,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.42,
      "end_seconds": 117.37,
      "duration_seconds": 4.95,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.03,
      "end_seconds": 127.68,
      "duration_seconds": 8.65,
      "text": "I swim twice a week. I'm vegetarian and have been for years. I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.94,
      "end_seconds": 148.95,
      "duration_seconds": 3.01,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.86,
      "end_seconds": 160.08,
      "duration_seconds": 2.22,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.41,
      "end_seconds": 191.66,
      "duration_seconds": 19.25,
      "text": "okay: BP is 116 over 80, BMI works out to 39.4. And weight 91 kilos, height 152 centimetres, temp 36.5 degrees, SpO2 97 percent on room air, respiratory rate 18, pulse is 77 beats a minute"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.71,
      "end_seconds": 194.24,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.86,
      "end_seconds": 201.73,
      "duration_seconds": 2.87,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.63,
      "end_seconds": 207.62,
      "duration_seconds": 2.99,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.92,
      "end_seconds": 211.97,
      "duration_seconds": 3.05,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.3,
      "end_seconds": 226.75,
      "duration_seconds": 5.45,
      "text": "it's a clean shallow cut, no longer bleeding, and the finger moves normally"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.94,
      "end_seconds": 242.74,
      "duration_seconds": 10.8,
      "text": "All finished, thank you. So, based on the history and the examination, it points towards a minor clean wound that needs only dressing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.05,
      "end_seconds": 285.42,
      "duration_seconds": 24.37,
      "text": "I'll close it with adhesive strips and keep it dry for two days. Try to to get to bed and wake up at the same time each day, and keep your phone away from the bed. Please don't wait if the finger turns red, hot or swollen. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.03,
      "end_seconds": 287.99,
      "duration_seconds": 1.96,
      "text": "thank you, that's clear"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.56,
      "end_seconds": 292.52,
      "duration_seconds": 3.96,
      "text": "See me again if it looks red or swollen."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 293.86,
      "end_seconds": 297.43,
      "duration_seconds": 3.57,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.77,
      "end_seconds": 302.55,
      "duration_seconds": 3.78,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.73,
      "end_seconds": 307.53,
      "duration_seconds": 3.8,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.07,
      "end_seconds": 309.49,
      "duration_seconds": 1.42,
      "text": "Look after yourself."
    }
  ]
}