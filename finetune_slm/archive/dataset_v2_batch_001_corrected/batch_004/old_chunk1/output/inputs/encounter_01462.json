{
  "schema_version": "1.0",
  "encounter_id": "01462",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.37,
      "end_seconds": 3.9,
      "duration_seconds": 2.53,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.52,
      "end_seconds": 8.28,
      "duration_seconds": 2.76,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.42,
      "end_seconds": 10.72,
      "duration_seconds": 1.3,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.88,
      "end_seconds": 17.5,
      "duration_seconds": 5.62,
      "text": "I wanted to get sharp pain low on one side looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.82,
      "end_seconds": 26.61,
      "duration_seconds": 3.79,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.25,
      "end_seconds": 34.16,
      "duration_seconds": 5.91,
      "text": "Erm, I take hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.11,
      "end_seconds": 37.75,
      "duration_seconds": 2.64,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.55,
      "end_seconds": 44.57,
      "duration_seconds": 2.02,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.17,
      "end_seconds": 48.38,
      "duration_seconds": 3.21,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.53,
      "end_seconds": 55.67,
      "duration_seconds": 3.14,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.04,
      "end_seconds": 61.2,
      "duration_seconds": 5.16,
      "text": "I follow. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.93,
      "end_seconds": 64.82,
      "duration_seconds": 1.89,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.22,
      "end_seconds": 68.85,
      "duration_seconds": 3.63,
      "text": "Okay, go on. Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.1,
      "end_seconds": 71.85,
      "duration_seconds": 1.75,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.68,
      "end_seconds": 76.62,
      "duration_seconds": 2.94,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.39,
      "end_seconds": 81.77,
      "duration_seconds": 3.38,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.81,
      "end_seconds": 90.06,
      "duration_seconds": 7.25,
      "text": "Have you had sharp pain low on one side before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.62,
      "end_seconds": 97.36,
      "duration_seconds": 5.74,
      "text": "Actually, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.93,
      "end_seconds": 102.38,
      "duration_seconds": 3.45,
      "text": "And what about fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.59,
      "end_seconds": 107.51,
      "duration_seconds": 3.92,
      "text": "No, you know, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.23,
      "end_seconds": 111.09,
      "duration_seconds": 2.86,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.96,
      "end_seconds": 114.34,
      "duration_seconds": 1.38,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.11,
      "end_seconds": 118.95,
      "duration_seconds": 2.84,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.23,
      "end_seconds": 125.26,
      "duration_seconds": 1.03,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 130.5,
      "duration_seconds": 4.43,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.07,
      "end_seconds": 135.4,
      "duration_seconds": 3.33,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 140.32,
      "duration_seconds": 3.45,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.97,
      "end_seconds": 145.09,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.42,
      "end_seconds": 160.35,
      "duration_seconds": 2.93,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.9,
      "end_seconds": 165.68,
      "duration_seconds": 4.78,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.47,
      "end_seconds": 183.87,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.76,
      "end_seconds": 186.87,
      "duration_seconds": 1.11,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.87,
      "end_seconds": 191.17,
      "duration_seconds": 3.3,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.09,
      "end_seconds": 203.55,
      "duration_seconds": 11.46,
      "text": "I've had eczema for about ten years now. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.73,
      "end_seconds": 223.59,
      "duration_seconds": 2.86,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.85,
      "end_seconds": 238.38,
      "duration_seconds": 2.53,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.45,
      "end_seconds": 265.74,
      "duration_seconds": 8.29,
      "text": "Okay: saturation 96 percent, pulse 105, temperature is 36.5 degrees. And blood pressure 136 over 72."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.6,
      "end_seconds": 273.53,
      "duration_seconds": 4.93,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.14,
      "end_seconds": 276.82,
      "duration_seconds": 1.68,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.32,
      "end_seconds": 279.68,
      "duration_seconds": 1.36,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.08,
      "end_seconds": 296.77,
      "duration_seconds": 4.69,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.39,
      "end_seconds": 299.86,
      "duration_seconds": 1.47,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.67,
      "end_seconds": 334.1,
      "duration_seconds": 30.43,
      "text": "That's the examination finished. Taking everything into account, it fits best with a possible ectopic pregnancy. I'd also keep a ruptured ovarian cyst in mind. I want a pregnancy test done, that's for pelvic pain and bleeding. You need to go to the hospital now for an emergency scan. I think the gynaecology team should see you too. Please come and see me straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.19,
      "end_seconds": 338.35,
      "duration_seconds": 2.16,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.4,
      "end_seconds": 341.0,
      "duration_seconds": 1.6,
      "text": "Have a good day."
    }
  ]
}