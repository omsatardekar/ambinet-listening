{
  "schema_version": "1.0",
  "encounter_id": "01454",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 6.1,
      "duration_seconds": 5.0,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.28,
      "end_seconds": 11.57,
      "duration_seconds": 4.29,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.31,
      "end_seconds": 20.39,
      "duration_seconds": 7.08,
      "text": "So, I've been feeling confused, doctor. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 21.02,
      "end_seconds": 29.47,
      "duration_seconds": 8.45,
      "text": "Okay, so the vitals from earlier. Blood pressure 122 over 70, temp 39.0 degrees, pulse 100, respiratory rate 22."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.48,
      "end_seconds": 33.87,
      "duration_seconds": 3.39,
      "text": "Good, thank you. When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.73,
      "end_seconds": 38.07,
      "duration_seconds": 2.34,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.66,
      "end_seconds": 42.42,
      "duration_seconds": 2.76,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.95,
      "end_seconds": 45.67,
      "duration_seconds": 1.72,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.5,
      "end_seconds": 50.92,
      "duration_seconds": 4.42,
      "text": "Any shaking chills and a high temperature as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.49,
      "end_seconds": 53.72,
      "duration_seconds": 1.23,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.58,
      "end_seconds": 59.23,
      "duration_seconds": 4.65,
      "text": "A few quick ones: rash, stiff neck or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.81,
      "end_seconds": 64.29,
      "duration_seconds": 3.48,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.38,
      "end_seconds": 68.38,
      "duration_seconds": 2.0,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.5,
      "end_seconds": 71.02,
      "duration_seconds": 1.52,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.32,
      "end_seconds": 76.71,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.73,
      "end_seconds": 98.55,
      "duration_seconds": 19.82,
      "text": "Alendronate, 70 milligrams, once a week for my bones. I told my wife I'd come today. Work has been very busy so I kept ignoring it. I'm, I'm on warfarin, 3 milligrams, in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.34,
      "end_seconds": 103.74,
      "duration_seconds": 4.4,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.13,
      "end_seconds": 108.97,
      "duration_seconds": 3.84,
      "text": "I've had thin bones for two years now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.91,
      "end_seconds": 112.36,
      "duration_seconds": 1.45,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.19,
      "end_seconds": 119.16,
      "duration_seconds": 4.97,
      "text": "I have an irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.67,
      "end_seconds": 124.11,
      "duration_seconds": 4.44,
      "text": "Alright, thin bones, that matches what I have here."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.44,
      "end_seconds": 135.24,
      "duration_seconds": 2.8,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.32,
      "end_seconds": 137.69,
      "duration_seconds": 1.37,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.26,
      "end_seconds": 144.16,
      "duration_seconds": 2.9,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.77,
      "end_seconds": 152.69,
      "duration_seconds": 6.92,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.36,
      "end_seconds": 159.48,
      "duration_seconds": 5.12,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.99,
      "end_seconds": 175.3,
      "duration_seconds": 14.31,
      "text": "I grab fast food at lunch most days. I hardly move around during the day. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.4,
      "end_seconds": 195.93,
      "duration_seconds": 4.53,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.17,
      "end_seconds": 204.87,
      "duration_seconds": 2.7,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.59,
      "end_seconds": 210.45,
      "duration_seconds": 3.86,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.94,
      "end_seconds": 225.97,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 229.62,
      "duration_seconds": 2.82,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.85,
      "end_seconds": 247.43,
      "duration_seconds": 7.58,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.72,
      "end_seconds": 263.85,
      "duration_seconds": 11.13,
      "text": "All finished, thank you. Okay, thinking it through, this looks most like possible sepsis needing urgent treatment. Another possibility is a severe urine or chest infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.85,
      "end_seconds": 268.14,
      "duration_seconds": 2.29,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.66,
      "end_seconds": 294.48,
      "duration_seconds": 22.82,
      "text": "I can't promise yet, but most people with possible sepsis needing urgent treatment do well once it's treated properly. Let's get lactate and blood tests, for sepsis. Let's book a chest X-ray to look into fever. I want to admit you to hospital now for fluids and antibiotics."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.93,
      "end_seconds": 297.36,
      "duration_seconds": 2.43,
      "text": "Yes. We'll catch up straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.81,
      "end_seconds": 305.18,
      "duration_seconds": 3.37,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.32,
      "end_seconds": 308.79,
      "duration_seconds": 2.47,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.71,
      "end_seconds": 315.2,
      "duration_seconds": 1.49,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.1,
      "end_seconds": 318.27,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}