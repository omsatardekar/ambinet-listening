{
  "schema_version": "1.0",
  "encounter_id": "01493",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 3.93,
      "duration_seconds": 3.16,
      "text": "come in have a seat by the desk"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.85,
      "end_seconds": 6.9,
      "duration_seconds": 1.05,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.07,
      "end_seconds": 9.64,
      "duration_seconds": 1.57,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.55,
      "end_seconds": 27.3,
      "duration_seconds": 15.75,
      "text": "Honestly, it's wheezing, and my family pushed me to come. I'm hoping you can tell me something definite. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.92,
      "end_seconds": 31.75,
      "duration_seconds": 3.83,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.15,
      "end_seconds": 39.13,
      "duration_seconds": 2.98,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.59,
      "end_seconds": 43.99,
      "duration_seconds": 3.4,
      "text": "How troublesome is it it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.34,
      "end_seconds": 50.07,
      "duration_seconds": 4.73,
      "text": "Erm, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.72,
      "end_seconds": 53.97,
      "duration_seconds": 2.25,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.32,
      "end_seconds": 64.93,
      "duration_seconds": 9.61,
      "text": "it's a couple of times a week. Oh and hives all over. That's been about the same six months"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 65.46,
      "end_seconds": 81.41,
      "duration_seconds": 15.95,
      "text": "Okay, so the vitals from earlier. Temperature is 37.0 degrees, SpO2 96 percent on room air. Height 163 centimetres, heart rate 92, pressure 103 over 64, BMI works out to to 29.7, weight 79 kilos."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.67,
      "end_seconds": 83.58,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.03,
      "end_seconds": 88.58,
      "duration_seconds": 3.55,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.36,
      "end_seconds": 91.26,
      "duration_seconds": 0.9,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.14,
      "end_seconds": 95.1,
      "duration_seconds": 1.96,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.17,
      "end_seconds": 117.3,
      "duration_seconds": 7.13,
      "text": "your lips are swollen, you have hives, you are wheezing and your pressure is low"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.88,
      "end_seconds": 126.62,
      "duration_seconds": 4.74,
      "text": "so, that's the examination finished any chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.94,
      "end_seconds": 131.09,
      "duration_seconds": 3.15,
      "text": "right, no, nothing to report there"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.82,
      "end_seconds": 135.25,
      "duration_seconds": 2.43,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.91,
      "end_seconds": 137.61,
      "duration_seconds": 1.7,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.23,
      "end_seconds": 141.23,
      "duration_seconds": 3.0,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.16,
      "end_seconds": 145.65,
      "duration_seconds": 2.49,
      "text": "oh, no, all normal there"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.36,
      "end_seconds": 158.19,
      "duration_seconds": 4.83,
      "text": "what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.04,
      "end_seconds": 178.34,
      "duration_seconds": 19.3,
      "text": "I have asthma for about ten years it's a relief to finally sit down and talk about it let me think I've had heart failure for two years now let me think um I have thin bones for nearly five years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.31,
      "end_seconds": 189.78,
      "duration_seconds": 9.47,
      "text": "Right, so asthma and thin bones are already on your record. We'll keep that in mind today. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.8,
      "end_seconds": 199.09,
      "duration_seconds": 7.29,
      "text": "yes I had a cataract operation in my left eye about a year ago"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.51,
      "end_seconds": 211.3,
      "duration_seconds": 2.79,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.9,
      "end_seconds": 216.5,
      "duration_seconds": 3.6,
      "text": "okay so my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.55,
      "end_seconds": 224.41,
      "duration_seconds": 5.86,
      "text": "Are you allergic to anything? Any allergies to to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.12,
      "end_seconds": 229.59,
      "duration_seconds": 3.47,
      "text": "well no not that I know of"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.15,
      "end_seconds": 234.35,
      "duration_seconds": 3.2,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.98,
      "end_seconds": 239.19,
      "duration_seconds": 3.21,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.67,
      "end_seconds": 243.52,
      "duration_seconds": 2.85,
      "text": "Alright, do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.37,
      "end_seconds": 248.47,
      "duration_seconds": 4.1,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.15,
      "end_seconds": 250.36,
      "duration_seconds": 1.21,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.91,
      "end_seconds": 259.44,
      "duration_seconds": 3.53,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.0,
      "end_seconds": 263.63,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.66,
      "end_seconds": 284.71,
      "duration_seconds": 19.05,
      "text": "I'm, I'm on Foracort inhaler, twice a day. I take spironolactone, 25 milligrams, once a day for my heart. I thought it would sort itself out, but it hasn't. I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.8,
      "end_seconds": 298.71,
      "duration_seconds": 12.91,
      "text": "having listened and examined this is probably anaphylaxis i want to be honest that this is an impression not a final answer a severe allergic reaction is also on my list"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.44,
      "end_seconds": 340.43,
      "duration_seconds": 24.99,
      "text": "I'm sending you for monitoring because of anaphylaxis i'll start you on adrenaline, 0.5 milligrams, once now, single dose that should help with anaphylaxis lie flat with your legs raised, I am giving the injection now we'll refer you to the emergency team please don't wait if the symptoms return that's when to be seen urgently"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.48,
      "end_seconds": 345.79,
      "duration_seconds": 3.31,
      "text": "yeah, um, that's fine by me"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.55,
      "end_seconds": 352.82,
      "duration_seconds": 5.27,
      "text": "see me again straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.55,
      "end_seconds": 356.73,
      "duration_seconds": 2.18,
      "text": "Alright thanks take care."
    }
  ]
}