    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.39,
      "end_seconds": 93.34,
      "duration_seconds": 1.95,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.38,
      "end_seconds": 118.43,
      "duration_seconds": 7.05,
      "text": "you look pale your pulse is fast and your tummy is tender at the top"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.44,
      "end_seconds": 126.0,
      "duration_seconds": 5.56,
      "text": "thank you, you can get dressed did you get fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.54,
      "end_seconds": 132.17,
      "duration_seconds": 4.63,
      "text": "actually, no fever or chest pain, none of it"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.67,
      "end_seconds": 136.72,
      "duration_seconds": 3.05,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.58,
      "end_seconds": 140.21,
      "duration_seconds": 1.63,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.07,
      "end_seconds": 145.47,
      "duration_seconds": 4.4,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.82,
      "end_seconds": 151.18,
      "duration_seconds": 1.36,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.01,
      "end_seconds": 154.86,
      "duration_seconds": 2.85,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.03,
      "end_seconds": 161.22,
      "duration_seconds": 5.19,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.94,
      "end_seconds": 164.51,
      "duration_seconds": 1.57,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.5,
      "end_seconds": 170.17,
      "duration_seconds": 3.67,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.98,
      "end_seconds": 184.28,
      "duration_seconds": 3.3,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.9,
      "end_seconds": 197.2,
      "duration_seconds": 12.3,
      "text": "it's mirtazapine, 15 milligrams, at night. Pantoprazole, 40 milligrams, before breakfast for my acidity it's ibuprofen, 400 milligrams, maybe, three times a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.81,
      "end_seconds": 201.83,
      "duration_seconds": 4.02,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.92,
      "end_seconds": 207.57,
      "duration_seconds": 4.65,
      "text": "Ah, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.28,
      "end_seconds": 210.53,
      "duration_seconds": 1.25,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.4,
      "end_seconds": 213.04,
      "duration_seconds": 1.64,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.38,
      "end_seconds": 229.16,
      "duration_seconds": 3.78,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.32,
      "end_seconds": 239.54,
      "duration_seconds": 9.22,
      "text": "okay, so yes, depression. I'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.75,
      "end_seconds": 241.45,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.3,
      "end_seconds": 253.19,
      "duration_seconds": 9.89,
      "text": "I've had acid reflux, yes. I've been putting this off for weeks. I just wanna get back to normal, really."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.99,
      "end_seconds": 271.64,
      "duration_seconds": 16.65,
      "text": "yes depression is known to us good to have that clear taking everything into account it's hard to say a possible bleeding stomach ulcer is one possibility and a bleed from the gullet another and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.96,
      "end_seconds": 295.82,
      "duration_seconds": 6.86,
      "text": "Let's book an endoscopy to look into bleeding. Let's book urgent blood tests to look into bleeding."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.51,
      "end_seconds": 298.76,
      "duration_seconds": 2.25,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.28,
      "end_seconds": 323.53,
      "duration_seconds": 23.25,
      "text": "Please stop the ibuprofen and do not eat or drink. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and if you vomit again, call us the same day or go to emergency. Come back straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.83,
      "end_seconds": 327.88,
      "duration_seconds": 3.05,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.69,
      "end_seconds": 332.06,
      "duration_seconds": 2.37,
      "text": "that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.46,
      "end_seconds": 336.51,
      "duration_seconds": 3.05,
      "text": "thank you, uh, that's helpful"
