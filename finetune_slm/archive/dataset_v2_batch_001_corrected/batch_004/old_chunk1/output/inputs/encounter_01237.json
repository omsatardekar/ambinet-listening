      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.31,
      "end_seconds": 83.75,
      "duration_seconds": 9.44,
      "text": "okay: respiratory rate 17, pressure 127 over 73. And temperature is 37.1 degrees, pulse is 123 beats a minute"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.61,
      "end_seconds": 89.85,
      "duration_seconds": 3.24,
      "text": "right let's have a proper look at you"
