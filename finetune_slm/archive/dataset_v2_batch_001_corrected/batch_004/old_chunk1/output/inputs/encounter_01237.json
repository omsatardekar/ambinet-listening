      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.29,
      "end_seconds": 33.62,
      "duration_seconds": 3.33,
      "text": "pretty moderate if I'm being honest"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 37.37,
      "duration_seconds": 2.54,
      "text": "Has there been stomach pain too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.35,
      "end_seconds": 45.47,
      "duration_seconds": 6.12,
      "text": "Yes, actually. With stomach pain, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.56,
      "end_seconds": 51.47,
      "duration_seconds": 3.91,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.49,
      "end_seconds": 62.74,
      "duration_seconds": 2.25,
      "text": "Nearly done with the readings..."
    },
