{
  "schema_version": "1.0",
  "encounter_id": "01155",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 6.15,
      "duration_seconds": 4.76,
      "text": "Um, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 11.01,
      "duration_seconds": 4.35,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.93,
      "end_seconds": 17.57,
      "duration_seconds": 4.64,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.2,
      "end_seconds": 24.79,
      "duration_seconds": 6.59,
      "text": "Yeah, it's being very thirsty. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.34,
      "end_seconds": 28.33,
      "duration_seconds": 2.99,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.33,
      "end_seconds": 42.63,
      "duration_seconds": 2.3,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.51,
      "end_seconds": 70.32,
      "duration_seconds": 17.81,
      "text": "Okay: BMI works out to 16.5, weight 56 kilos. And pressure 134 over 70, height 184 centimetres, oxygen saturation is 99 percent, pulse is 126 beats a minute, temperature is 36.6 degrees. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.31,
      "end_seconds": 73.41,
      "duration_seconds": 2.1,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.68,
      "end_seconds": 78.04,
      "duration_seconds": 3.36,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.04,
      "end_seconds": 90.7,
      "duration_seconds": 10.66,
      "text": "Erm, I'd call it moderate. Deep fast breathing was there, um, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.34,
      "end_seconds": 96.19,
      "duration_seconds": 3.85,
      "text": "Have you had any chest pain or cough?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.05,
      "end_seconds": 102.27,
      "duration_seconds": 4.22,
      "text": "Mm, um, none of those, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.03,
      "end_seconds": 106.5,
      "duration_seconds": 2.47,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.69,
      "end_seconds": 108.8,
      "duration_seconds": 1.11,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.16,
      "end_seconds": 120.25,
      "duration_seconds": 4.09,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.8,
      "end_seconds": 123.53,
      "duration_seconds": 1.73,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.15,
      "end_seconds": 130.32,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.32,
      "end_seconds": 135.77,
      "duration_seconds": 3.45,
      "text": "No, um, not at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.22,
      "end_seconds": 142.26,
      "duration_seconds": 4.04,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.64,
      "end_seconds": 158.44,
      "duration_seconds": 14.8,
      "text": "I smoke roughly a pack every two days. I do a yoga class on Thursdays. I work in accounts at a hospital. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.81,
      "end_seconds": 171.78,
      "duration_seconds": 2.97,
      "text": "So, any regular medication at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.6,
      "end_seconds": 177.94,
      "duration_seconds": 4.34,
      "text": "I mean, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.01,
      "end_seconds": 181.78,
      "duration_seconds": 2.77,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 186.28,
      "duration_seconds": 2.52,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.4,
      "end_seconds": 207.96,
      "duration_seconds": 4.56,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 212.87,
      "duration_seconds": 1.7,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.47,
      "end_seconds": 241.61,
      "duration_seconds": 17.14,
      "text": "Putting it all together, I think we're dealing with diabetic ketoacidosis at this stage. I want to be honest that this is an impression, not a final answer. I'd also keep a severe infection in mind."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.98,
      "end_seconds": 244.54,
      "duration_seconds": 1.56,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 264.85,
      "duration_seconds": 18.69,
      "text": "I can't promise yet, but most people with diabetic ketoacidosis do well once it's treated properly. Blood gas and electrolytes is what I'd like next, for DKA. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.13,
      "end_seconds": 267.63,
      "duration_seconds": 1.5,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.43,
      "end_seconds": 279.65,
      "duration_seconds": 10.22,
      "text": "You need to go to hospital now for insulin and fluids. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.37,
      "end_seconds": 284.32,
      "duration_seconds": 3.95,
      "text": "Sure, um, where do I go?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.42,
      "end_seconds": 291.9,
      "duration_seconds": 6.48,
      "text": "Book a review straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.41,
      "end_seconds": 300.47,
      "duration_seconds": 8.06,
      "text": "Sorry, uh, what was I saying, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.92,
      "end_seconds": 303.36,
      "duration_seconds": 1.44,
      "text": "Take care now."
    }
  ]
}