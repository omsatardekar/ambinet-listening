{
  "schema_version": "1.0",
  "encounter_id": "01195",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.76,
      "duration_seconds": 4.02,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 10.83,
      "duration_seconds": 4.23,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.32,
      "end_seconds": 17.61,
      "duration_seconds": 5.29,
      "text": "I've been wanting contraception, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.12,
      "end_seconds": 23.67,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.74,
      "end_seconds": 28.5,
      "duration_seconds": 3.76,
      "text": "I take sumatriptan, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.84,
      "end_seconds": 46.07,
      "duration_seconds": 3.23,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.53,
      "end_seconds": 51.08,
      "duration_seconds": 3.55,
      "text": "I've had it for about three months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.3,
      "end_seconds": 54.95,
      "duration_seconds": 2.65,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.46,
      "end_seconds": 57.57,
      "duration_seconds": 1.11,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.88,
      "end_seconds": 58.58,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.9,
      "end_seconds": 69.12,
      "duration_seconds": 1.22,
      "text": "What about smoking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.07,
      "end_seconds": 73.69,
      "duration_seconds": 2.62,
      "text": "Actually, no, none, no smoking."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.94,
      "end_seconds": 78.38,
      "duration_seconds": 3.44,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.15,
      "end_seconds": 81.41,
      "duration_seconds": 2.26,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.9,
      "end_seconds": 86.23,
      "duration_seconds": 1.33,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.99,
      "end_seconds": 90.51,
      "duration_seconds": 3.52,
      "text": "Ah, um, no, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.15,
      "end_seconds": 94.71,
      "duration_seconds": 3.56,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.06,
      "end_seconds": 100.03,
      "duration_seconds": 3.97,
      "text": "No, uh, I've never been operated on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.43,
      "end_seconds": 114.37,
      "duration_seconds": 3.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.2,
      "end_seconds": 119.26,
      "duration_seconds": 4.06,
      "text": "I have migraines, for about ten years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.35,
      "end_seconds": 124.99,
      "duration_seconds": 4.64,
      "text": "Okay, go on. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.67,
      "end_seconds": 129.88,
      "duration_seconds": 4.21,
      "text": "Um, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.29,
      "end_seconds": 133.24,
      "duration_seconds": 1.95,
      "text": "Right, what about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.93,
      "end_seconds": 136.65,
      "duration_seconds": 1.72,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.31,
      "end_seconds": 144.58,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.59,
      "end_seconds": 151.28,
      "duration_seconds": 5.69,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.06,
      "end_seconds": 157.11,
      "duration_seconds": 4.05,
      "text": "Alright, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.9,
      "end_seconds": 161.89,
      "duration_seconds": 3.99,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.54,
      "end_seconds": 163.82,
      "duration_seconds": 1.28,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.05,
      "end_seconds": 167.98,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.94,
      "end_seconds": 173.15,
      "duration_seconds": 4.21,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.09,
      "end_seconds": 187.49,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 207.86,
      "duration_seconds": 9.35,
      "text": "Okay: heart rate 72, pressure 113 over 77, temperature is 36.8 degrees. And SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.82,
      "end_seconds": 214.61,
      "duration_seconds": 3.79,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.2,
      "end_seconds": 218.85,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.67,
      "end_seconds": 228.66,
      "duration_seconds": 1.99,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.49,
      "end_seconds": 236.45,
      "duration_seconds": 2.96,
      "text": "Okay, you can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.03,
      "end_seconds": 287.22,
      "duration_seconds": 33.19,
      "text": "Putting it all together, this is probably suitable for hormonal contraception with no risk factors. What I'm giving you is levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That should help with contraception. Take the pill at the same time each day and use condoms if you miss two. The thing that would worry me is if you get leg swelling or severe headaches. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.86,
      "end_seconds": 297.35,
      "duration_seconds": 8.49,
      "text": "I'd like to see you again in three months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.91,
      "end_seconds": 301.22,
      "duration_seconds": 2.31,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.74,
      "end_seconds": 303.2,
      "duration_seconds": 1.46,
      "text": "Look after yourself."
    }
  ]
}