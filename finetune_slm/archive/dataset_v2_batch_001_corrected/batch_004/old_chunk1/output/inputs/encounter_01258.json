{
  "schema_version": "1.0",
  "encounter_id": "01258",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 6.12,
      "duration_seconds": 4.89,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 10.46,
      "duration_seconds": 3.73,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.04,
      "end_seconds": 18.12,
      "duration_seconds": 6.08,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.9,
      "end_seconds": 21.73,
      "duration_seconds": 2.83,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.0,
      "end_seconds": 26.65,
      "duration_seconds": 3.65,
      "text": "She's been having a severe headache, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.29,
      "end_seconds": 32.15,
      "duration_seconds": 3.86,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.01,
      "end_seconds": 38.02,
      "duration_seconds": 4.01,
      "text": "Mm, I take Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.58,
      "end_seconds": 43.16,
      "duration_seconds": 4.58,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.91,
      "end_seconds": 52.44,
      "duration_seconds": 7.53,
      "text": "Yeah, uh, I'd give it a three, out of ten. I'd say on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.06,
      "end_seconds": 55.35,
      "duration_seconds": 2.29,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.94,
      "end_seconds": 72.97,
      "duration_seconds": 17.03,
      "text": "Hating the light goes along with it, um, most of the time. The hating the light? That's been for about four days. Okay, you know, so I've also had a high fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.65,
      "end_seconds": 85.99,
      "duration_seconds": 1.34,
      "text": "Nothing like cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.5,
      "end_seconds": 88.06,
      "duration_seconds": 1.56,
      "text": "No cough, thankfully."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 90.04,
      "end_seconds": 95.28,
      "duration_seconds": 5.24,
      "text": "Actually, doctor, I did notice cough. She doesn't always say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.31,
      "end_seconds": 104.04,
      "duration_seconds": 6.73,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.78,
      "end_seconds": 110.17,
      "duration_seconds": 5.39,
      "text": "Alright, I'll note both what you've said and what you've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.45,
      "end_seconds": 113.91,
      "duration_seconds": 3.46,
      "text": "Okay, go on. What about recent head injury?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.62,
      "end_seconds": 118.51,
      "duration_seconds": 3.89,
      "text": "Not that I've noticed, no recent head injury."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.17,
      "end_seconds": 121.47,
      "duration_seconds": 2.3,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.19,
      "end_seconds": 123.69,
      "duration_seconds": 1.5,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.64,
      "end_seconds": 128.53,
      "duration_seconds": 3.89,
      "text": "Alright, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.54,
      "end_seconds": 134.02,
      "duration_seconds": 1.48,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.87,
      "end_seconds": 149.31,
      "duration_seconds": 4.44,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.67,
      "end_seconds": 155.6,
      "duration_seconds": 4.93,
      "text": "My aunt has rheumatoid arthritis. My son has asthma."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.95,
      "end_seconds": 160.81,
      "duration_seconds": 3.86,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.11,
      "end_seconds": 170.04,
      "duration_seconds": 2.93,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.53,
      "end_seconds": 173.93,
      "duration_seconds": 2.4,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.98,
      "end_seconds": 178.73,
      "duration_seconds": 3.75,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.19,
      "end_seconds": 182.24,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.37,
      "end_seconds": 187.83,
      "duration_seconds": 4.46,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.54,
      "end_seconds": 191.6,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.81,
      "end_seconds": 208.87,
      "duration_seconds": 16.06,
      "text": "I've, I've got asthma. I kept putting it off, you know, which I know isn't sensible. I've had diabetes, yes. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.11,
      "end_seconds": 217.97,
      "duration_seconds": 7.86,
      "text": "Yes, carry on. Alright, diabetes, that matches what I have here. Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 229.39,
      "duration_seconds": 2.23,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.05,
      "end_seconds": 252.22,
      "duration_seconds": 13.17,
      "text": "Okay: weight 97 kilos, BMI works out to 37.4. And height 161 centimetres, pulse 99, blood pressure 124 over 78, SpO2 96 percent on room air, temperature 38.6."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.16,
      "end_seconds": 256.26,
      "duration_seconds": 2.1,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.81,
      "end_seconds": 260.23,
      "duration_seconds": 2.42,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.16,
      "end_seconds": 277.19,
      "duration_seconds": 8.03,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.5,
      "end_seconds": 304.22,
      "duration_seconds": 23.72,
      "text": "All finished, thank you. Putting it all together, this looks most like possible bacterial meningitis. That's my thinking for now, and it may change as we learn more. I'd also keep meningococcal septicaemia in mind. Let me repeat that back to make sure. You've had a severe headache, and no recent head injury."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.79,
      "end_seconds": 306.48,
      "duration_seconds": 1.69,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.79,
      "end_seconds": 328.23,
      "duration_seconds": 14.44,
      "text": "Let's get blood cultures, for possible meningitis. I'm going to order a lumbar puncture, for possible meningitis. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.99,
      "end_seconds": 331.25,
      "duration_seconds": 2.26,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.89,
      "end_seconds": 346.95,
      "duration_seconds": 15.06,
      "text": "What I'm giving you is benzylpenicillin, 1.2 grams, once now, single dose. It's for possible meningitis. Call an ambulance now, this is an emergency. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.72,
      "end_seconds": 348.42,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.07,
      "end_seconds": 355.42,
      "duration_seconds": 6.35,
      "text": "I'd like to see you again straight away. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.82,
      "end_seconds": 360.75,
      "duration_seconds": 3.93,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}