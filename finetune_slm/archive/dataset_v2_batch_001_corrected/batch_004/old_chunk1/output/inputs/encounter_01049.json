{
  "schema_version": "1.0",
  "encounter_id": "01049",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 4.92,
      "duration_seconds": 3.89,
      "text": "morning, doctor is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.57,
      "end_seconds": 10.35,
      "duration_seconds": 3.78,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.56,
      "end_seconds": 24.39,
      "duration_seconds": 12.83,
      "text": "Hmm, I'm here because of bloating after meals. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.29,
      "end_seconds": 27.24,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.64,
      "end_seconds": 34.35,
      "duration_seconds": 5.71,
      "text": "Right, uh, I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.26,
      "end_seconds": 37.59,
      "duration_seconds": 1.33,
      "text": "is that long-standing?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.85,
      "end_seconds": 46.0,
      "duration_seconds": 5.15,
      "text": "About about a month. I take peppermint capsules, after meals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.61,
      "end_seconds": 50.91,
      "duration_seconds": 3.3,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.77,
      "end_seconds": 54.16,
      "duration_seconds": 2.39,
      "text": "probably three weeks yeah"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.3,
      "end_seconds": 58.61,
      "duration_seconds": 3.31,
      "text": "have you had loose stools now and then?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.72,
      "end_seconds": 72.98,
      "duration_seconds": 9.26,
      "text": "Mm, yes. Okay, so and there's a lot of wind as well, two weeks now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.76,
      "end_seconds": 85.4,
      "duration_seconds": 4.64,
      "text": "A A few quick ones: vomiting or blood in the stool?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.28,
      "end_seconds": 89.32,
      "duration_seconds": 3.04,
      "text": "Oh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 94.07,
      "duration_seconds": 3.66,
      "text": "Did you get night-time diarrhoea or weight loss?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.19,
      "end_seconds": 102.08,
      "duration_seconds": 6.89,
      "text": "ah, uh, no night-time diarrhoea or weight loss, none of it"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.08,
      "end_seconds": 106.26,
      "duration_seconds": 3.18,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.41,
      "end_seconds": 108.44,
      "duration_seconds": 1.03,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.12,
      "end_seconds": 117.22,
      "duration_seconds": 3.1,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.94,
      "end_seconds": 120.31,
      "duration_seconds": 2.37,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.12,
      "end_seconds": 125.49,
      "duration_seconds": 3.37,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.51,
      "end_seconds": 132.59,
      "duration_seconds": 3.08,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.42,
      "end_seconds": 138.69,
      "duration_seconds": 5.27,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.21,
      "end_seconds": 153.01,
      "duration_seconds": 12.8,
      "text": "I drink a lot of tea and snack through the day. No, I share a house with my brother. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.1,
      "end_seconds": 169.92,
      "duration_seconds": 3.82,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.07,
      "end_seconds": 177.0,
      "duration_seconds": 2.93,
      "text": "Anxiety, for about ten years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.89,
      "end_seconds": 180.62,
      "duration_seconds": 2.73,
      "text": "right, and anything else to add?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.73,
      "end_seconds": 187.34,
      "duration_seconds": 5.61,
      "text": "let me think, I have an underactive thyroid, for two years"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.31,
      "end_seconds": 192.36,
      "duration_seconds": 3.05,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.24,
      "end_seconds": 199.0,
      "duration_seconds": 5.76,
      "text": "so, I had keyhole surgery on my gallbladder two years back"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.78,
      "end_seconds": 204.75,
      "duration_seconds": 4.97,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.97,
      "end_seconds": 214.26,
      "duration_seconds": 4.29,
      "text": "Mm, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.12,
      "end_seconds": 219.36,
      "duration_seconds": 4.24,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.78,
      "end_seconds": 229.62,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.75,
      "end_seconds": 247.4,
      "duration_seconds": 6.65,
      "text": "Okay: temp 36.7 degrees, pressure 108 over 74, pulse 72, respiratory rate 18."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.98,
      "end_seconds": 250.54,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.36,
      "end_seconds": 253.39,
      "duration_seconds": 2.03,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.32,
      "end_seconds": 260.11,
      "duration_seconds": 3.79,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.56,
      "end_seconds": 264.45,
      "duration_seconds": 2.89,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.7,
      "end_seconds": 283.32,
      "duration_seconds": 5.62,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.31,
      "end_seconds": 292.67,
      "duration_seconds": 3.36,
      "text": "so, good, you can sit up again"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.16,
      "end_seconds": 318.72,
      "duration_seconds": 13.56,
      "text": "Right, here's what I'm thinking. It's hard to say. A functional bowel pattern, with no alarm features is one possibility and irritable bowel syndrome another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.41,
      "end_seconds": 325.01,
      "duration_seconds": 5.6,
      "text": "ah, can you send me for a coeliac blood test?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.59,
      "end_seconds": 339.24,
      "duration_seconds": 12.65,
      "text": "Not at this point, no. It isn't indicated yet. For now, no new medicines or tests are needed. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.35,
      "end_seconds": 347.4,
      "duration_seconds": 4.05,
      "text": "Ah, good, thanks, I'll see you then."
    }
  ]
}