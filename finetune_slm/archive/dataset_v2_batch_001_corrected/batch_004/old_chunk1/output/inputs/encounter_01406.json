{
  "schema_version": "1.0",
  "encounter_id": "01406",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 3.23,
      "duration_seconds": 2.38,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.34,
      "end_seconds": 8.32,
      "duration_seconds": 3.98,
      "text": "Hmm, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.53,
      "end_seconds": 11.91,
      "duration_seconds": 2.38,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 18.91,
      "duration_seconds": 5.97,
      "text": "honestly, it's no real problems, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.44,
      "end_seconds": 26.59,
      "duration_seconds": 6.15,
      "text": "Did it come on recently? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.23,
      "end_seconds": 30.75,
      "duration_seconds": 2.52,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.66,
      "end_seconds": 35.89,
      "duration_seconds": 3.23,
      "text": "is it it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.93,
      "end_seconds": 41.51,
      "duration_seconds": 2.58,
      "text": "it feels severe to me"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.1,
      "end_seconds": 45.11,
      "duration_seconds": 2.01,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.43,
      "end_seconds": 60.93,
      "duration_seconds": 14.5,
      "text": "A bit of back stiffness goes along with it, most of the time. The bit of back stiffness? That's been for one week. I've also had an occasional headache, since yesterday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.7,
      "end_seconds": 67.73,
      "duration_seconds": 6.03,
      "text": "have you had no real problems before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.12,
      "end_seconds": 77.74,
      "duration_seconds": 8.62,
      "text": "Yes, you know, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.58,
      "end_seconds": 83.09,
      "duration_seconds": 3.51,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.08,
      "end_seconds": 94.43,
      "duration_seconds": 10.35,
      "text": "I have high cholesterol. I've never really been one for hospitals. I have thin bones, for about a year."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.58,
      "end_seconds": 96.63,
      "duration_seconds": 1.05,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.94,
      "end_seconds": 109.24,
      "duration_seconds": 1.3,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.28,
      "end_seconds": 114.02,
      "duration_seconds": 3.74,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.48,
      "end_seconds": 117.44,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.13,
      "end_seconds": 121.94,
      "duration_seconds": 2.81,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.23,
      "end_seconds": 126.04,
      "duration_seconds": 2.81,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.7,
      "end_seconds": 131.57,
      "duration_seconds": 3.87,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.38,
      "end_seconds": 137.6,
      "duration_seconds": 4.22,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.19,
      "end_seconds": 142.19,
      "duration_seconds": 4.0,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.03,
      "end_seconds": 145.62,
      "duration_seconds": 2.59,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.38,
      "end_seconds": 151.1,
      "duration_seconds": 4.72,
      "text": "yes, I had part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.28,
      "end_seconds": 156.0,
      "duration_seconds": 3.72,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.85,
      "end_seconds": 161.95,
      "duration_seconds": 4.1,
      "text": "I'm on atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.2,
      "end_seconds": 167.22,
      "duration_seconds": 5.02,
      "text": "okay, go on any weight loss, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.21,
      "end_seconds": 172.08,
      "duration_seconds": 2.87,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.0,
      "end_seconds": 176.01,
      "duration_seconds": 2.01,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.14,
      "end_seconds": 178.91,
      "duration_seconds": 1.77,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.95,
      "end_seconds": 184.81,
      "duration_seconds": 3.86,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.08,
      "end_seconds": 187.55,
      "duration_seconds": 1.47,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 189.57,
      "end_seconds": 195.65,
      "duration_seconds": 6.08,
      "text": "Doctor, I've got the readings for you. Pressure 117 over 79, pulse 79, respiratory rate 15."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.3,
      "end_seconds": 198.0,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.14,
      "end_seconds": 202.26,
      "duration_seconds": 2.12,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.57,
      "end_seconds": 206.94,
      "duration_seconds": 3.37,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.27,
      "end_seconds": 227.14,
      "duration_seconds": 2.87,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.79,
      "end_seconds": 234.57,
      "duration_seconds": 1.78,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.37,
      "end_seconds": 260.21,
      "duration_seconds": 8.84,
      "text": "Taking everything into account, I think we're dealing with a healthy adult with no worrying findings at this stage."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.57,
      "end_seconds": 264.66,
      "duration_seconds": 3.09,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.16,
      "end_seconds": 278.43,
      "duration_seconds": 12.27,
      "text": "I understand the worry. At the moment I'd say it's a healthy adult with no worrying findings, and we'll know more once the a fasting sugar test is back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.71,
      "end_seconds": 299.77,
      "duration_seconds": 8.06,
      "text": "I think a fasting sugar test makes sense here, for routine check. Do get help quickly if new symptoms appear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.8,
      "end_seconds": 303.99,
      "duration_seconds": 3.19,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.78,
      "end_seconds": 307.87,
      "duration_seconds": 3.09,
      "text": "Let's plan a check in twelve months."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.42,
      "end_seconds": 310.44,
      "duration_seconds": 2.02,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.42,
      "end_seconds": 315.46,
      "duration_seconds": 4.04,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.33,
      "end_seconds": 321.32,
      "duration_seconds": 3.99,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}