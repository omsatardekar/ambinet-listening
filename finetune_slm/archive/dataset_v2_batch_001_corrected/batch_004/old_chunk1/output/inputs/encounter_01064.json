{
  "schema_version": "1.0",
  "encounter_id": "01064",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.4,
      "duration_seconds": 4.56,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.24,
      "end_seconds": 11.17,
      "duration_seconds": 3.93,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.24,
      "end_seconds": 19.55,
      "duration_seconds": 7.31,
      "text": "Honestly, um, it's a severe sore throat, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.61,
      "end_seconds": 27.24,
      "duration_seconds": 5.63,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.38,
      "end_seconds": 45.6,
      "duration_seconds": 17.22,
      "text": "Severe, I'd say. It's worse with swallowing. I'd rather not end up on lots of tablets if I can avoid it. Oh, and noisy breathing. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.74,
      "end_seconds": 50.02,
      "duration_seconds": 3.28,
      "text": "Okay, have you had a muffled voice?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.58,
      "end_seconds": 58.43,
      "duration_seconds": 6.85,
      "text": "Yes, I have. Right, with muffled voice, it feels mild to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.56,
      "end_seconds": 65.86,
      "duration_seconds": 6.3,
      "text": "Have you had a severe sore throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.63,
      "end_seconds": 73.42,
      "duration_seconds": 6.79,
      "text": "I, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.69,
      "end_seconds": 81.3,
      "duration_seconds": 2.61,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.01,
      "end_seconds": 96.57,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.41,
      "end_seconds": 126.06,
      "duration_seconds": 9.65,
      "text": "Okay: respiratory rate 23, blood pressure 137 over 83, heart rate 99. And temp 36.9 degrees, saturation 90 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.0,
      "end_seconds": 129.44,
      "duration_seconds": 1.44,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.93,
      "end_seconds": 132.98,
      "duration_seconds": 2.05,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.97,
      "end_seconds": 138.18,
      "duration_seconds": 3.21,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.64,
      "end_seconds": 141.91,
      "duration_seconds": 2.27,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.99,
      "end_seconds": 155.9,
      "duration_seconds": 4.91,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.95,
      "end_seconds": 161.56,
      "duration_seconds": 2.61,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.24,
      "end_seconds": 178.47,
      "duration_seconds": 4.23,
      "text": "Let me check a few things. Any cough or rash?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.91,
      "end_seconds": 183.47,
      "duration_seconds": 3.56,
      "text": "No cough or rash, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.42,
      "end_seconds": 187.4,
      "duration_seconds": 2.98,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.42,
      "end_seconds": 190.11,
      "duration_seconds": 1.69,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.29,
      "end_seconds": 194.33,
      "duration_seconds": 3.04,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.43,
      "end_seconds": 197.05,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.7,
      "end_seconds": 206.03,
      "duration_seconds": 5.33,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.82,
      "end_seconds": 222.42,
      "duration_seconds": 15.6,
      "text": "I used to drink heavily but I stopped four years ago. I swim twice a week. I retired from the post office two years ago. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.05,
      "end_seconds": 229.17,
      "duration_seconds": 5.12,
      "text": "So, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.09,
      "end_seconds": 233.97,
      "duration_seconds": 3.88,
      "text": "Okay, so no, not that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.06,
      "end_seconds": 241.95,
      "duration_seconds": 3.89,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.94,
      "end_seconds": 247.5,
      "duration_seconds": 4.56,
      "text": "I've had heart failure for about a year now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.74,
      "end_seconds": 257.2,
      "duration_seconds": 5.46,
      "text": "I follow. Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.18,
      "end_seconds": 272.92,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.46,
      "end_seconds": 275.57,
      "duration_seconds": 1.11,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.14,
      "end_seconds": 284.06,
      "duration_seconds": 2.92,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.9,
      "end_seconds": 291.3,
      "duration_seconds": 2.4,
      "text": "So, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.36,
      "end_seconds": 295.74,
      "duration_seconds": 2.38,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.55,
      "end_seconds": 302.01,
      "duration_seconds": 4.46,
      "text": "Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.28,
      "end_seconds": 322.39,
      "duration_seconds": 11.11,
      "text": "Putting it all together, I'd lean towards a possible airway infection that needs emergency care. Let's get an urgent airway assessment, for stridor and drooling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.18,
      "end_seconds": 325.77,
      "duration_seconds": 1.59,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.39,
      "end_seconds": 336.44,
      "duration_seconds": 10.05,
      "text": "Do not lie flat, I am calling an ambulance now. I'm going to send a referral to the emergency ENT team."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.6,
      "end_seconds": 338.3,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.05,
      "end_seconds": 350.57,
      "duration_seconds": 10.52,
      "text": "Do get help quickly if the breathing gets harder. I'd like to see you again straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.11,
      "end_seconds": 354.94,
      "duration_seconds": 3.83,
      "text": "Well, okay, that makes sense. Thanks for explaining."
    }
  ]
}