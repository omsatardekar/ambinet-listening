{
  "schema_version": "1.0",
  "encounter_id": "01304",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 3.8,
      "duration_seconds": 3.27,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.41,
      "end_seconds": 8.66,
      "duration_seconds": 4.25,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.8,
      "end_seconds": 12.62,
      "duration_seconds": 2.82,
      "text": "I've been dealing with vomiting blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.54,
      "end_seconds": 18.28,
      "duration_seconds": 3.74,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.06,
      "end_seconds": 24.12,
      "duration_seconds": 5.06,
      "text": "I mean, it's been two months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.52,
      "end_seconds": 35.44,
      "duration_seconds": 9.92,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.75,
      "end_seconds": 55.07,
      "duration_seconds": 18.32,
      "text": "Honestly, a few times a day. A six out of ten, I suppose. I've been feeling faint too, for five days. Erm, about feeling faint, about a three out of ten. It happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.91,
      "end_seconds": 60.23,
      "duration_seconds": 3.32,
      "text": "What about stomach pain, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.15,
      "end_seconds": 65.41,
      "duration_seconds": 3.26,
      "text": "Yeah, I've had that since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.3,
      "end_seconds": 69.71,
      "duration_seconds": 3.41,
      "text": "Have you noticed fever or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.32,
      "end_seconds": 73.35,
      "duration_seconds": 2.03,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.33,
      "end_seconds": 77.47,
      "duration_seconds": 3.14,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.79,
      "end_seconds": 82.23,
      "duration_seconds": 1.44,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.85,
      "end_seconds": 87.29,
      "duration_seconds": 3.44,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.27,
      "end_seconds": 94.38,
      "duration_seconds": 5.11,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.41,
      "end_seconds": 100.85,
      "duration_seconds": 5.44,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.6,
      "end_seconds": 111.17,
      "duration_seconds": 9.57,
      "text": "I only drink at family occasions. No, I share a house with my brother. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.58,
      "end_seconds": 131.49,
      "duration_seconds": 2.91,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.14,
      "end_seconds": 137.06,
      "duration_seconds": 3.92,
      "text": "It's sodium valproate, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.19,
      "end_seconds": 140.48,
      "duration_seconds": 2.29,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.98,
      "end_seconds": 147.06,
      "duration_seconds": 5.08,
      "text": "About six months. It's, It's Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.82,
      "end_seconds": 149.96,
      "duration_seconds": 2.14,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.85,
      "end_seconds": 152.79,
      "duration_seconds": 1.94,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.3,
      "end_seconds": 157.21,
      "duration_seconds": 2.91,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.98,
      "end_seconds": 160.76,
      "duration_seconds": 1.78,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.2,
      "end_seconds": 166.67,
      "duration_seconds": 4.47,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.13,
      "end_seconds": 170.67,
      "duration_seconds": 2.54,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 176.85,
      "duration_seconds": 4.1,
      "text": "So, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.71,
      "end_seconds": 186.16,
      "duration_seconds": 5.45,
      "text": "I have epilepsy, for nearly five years. I've got COPD."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.9,
      "end_seconds": 191.46,
      "duration_seconds": 3.56,
      "text": "Sure. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.95,
      "end_seconds": 194.94,
      "duration_seconds": 1.99,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.47,
      "end_seconds": 200.01,
      "duration_seconds": 3.54,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.33,
      "end_seconds": 209.47,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.3,
      "end_seconds": 235.57,
      "duration_seconds": 9.27,
      "text": "Okay: respiratory rate 18, oxygen saturation is 97 percent, heart rate 112, temperature 36.6, blood pressure 124 over 73."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.97,
      "end_seconds": 240.86,
      "duration_seconds": 3.89,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.8,
      "end_seconds": 255.47,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.32,
      "end_seconds": 258.5,
      "duration_seconds": 2.18,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.46,
      "end_seconds": 273.68,
      "duration_seconds": 6.22,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.3,
      "end_seconds": 292.57,
      "duration_seconds": 13.27,
      "text": "You can sit up now. Putting it all together, I think we're dealing with a possible bleeding stomach ulcer at this stage. A bleed from the gullet is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.91,
      "end_seconds": 311.81,
      "duration_seconds": 3.9,
      "text": "I'm sending you for urgent blood tests because of bleeding."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.65,
      "end_seconds": 315.38,
      "duration_seconds": 2.73,
      "text": "Well, that's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.67,
      "end_seconds": 339.65,
      "duration_seconds": 19.98,
      "text": "Please stop the ibuprofen and do not eat or drink. I'll also refer you to the emergency team. The thing that would worry me is if you vomit again. If that happens, go to emergency. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.65,
      "end_seconds": 344.88,
      "duration_seconds": 2.23,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.06,
      "end_seconds": 351.45,
      "duration_seconds": 5.39,
      "text": "Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.13,
      "end_seconds": 353.92,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    }
  ]
}