      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.47,
      "end_seconds": 102.46,
      "duration_seconds": 2.99,
      "text": "no, I've never reacted to anything"
