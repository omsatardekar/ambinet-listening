    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.13,
      "end_seconds": 130.17,
      "duration_seconds": 4.04,
      "text": "mm, okay okay, now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.75,
      "end_seconds": 146.8,
      "duration_seconds": 15.05,
      "text": "I've never touched a cigarette. I only drink at family occasions. Lots of rice, lentils and some fruit. I look after my grandchildren most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 151.13,
      "duration_seconds": 2.79,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.43,
      "end_seconds": 161.36,
      "duration_seconds": 2.93,
      "text": "that's it just a little longer.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.98,
      "end_seconds": 193.96,
      "duration_seconds": 12.98,
      "text": "okay: respiratory rate 20 saturation 96 percent height 177 centimetres blood pressure 130 over 73 temp 36.8 degrees heart rate 106 weight 92 kilos BMI works out to 29.4."
