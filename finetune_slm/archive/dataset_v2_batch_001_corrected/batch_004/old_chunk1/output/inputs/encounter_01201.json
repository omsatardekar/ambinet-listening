      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.37,
      "end_seconds": 122.12,
      "duration_seconds": 2.75,
      "text": "has anyone ever diagnosed you with something?"
