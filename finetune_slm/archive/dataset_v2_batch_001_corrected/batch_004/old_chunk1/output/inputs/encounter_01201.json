      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.78,
      "end_seconds": 253.47,
      "duration_seconds": 11.69,
      "text": "alright, good, you can sit up again so where does that leave us? I can't pin this down yet we're looking at diabetic ketoacidosis or a severe infection"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.5,
      "end_seconds": 257.15,
      "duration_seconds": 1.65,
      "text": "is this permanent?"
    },
