      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.66,
      "end_seconds": 201.08,
      "duration_seconds": 5.42,
      "text": "I'll need to to examine you for this it won't take long"
