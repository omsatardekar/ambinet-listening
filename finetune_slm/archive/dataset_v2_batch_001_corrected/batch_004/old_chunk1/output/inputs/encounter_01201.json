      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.34,
      "end_seconds": 237.1,
      "duration_seconds": 4.76,
      "text": "you are dry, breathing deeply and your breath smells fruity"
