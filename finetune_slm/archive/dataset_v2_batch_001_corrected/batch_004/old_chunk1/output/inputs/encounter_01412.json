      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.84,
      "end_seconds": 123.01,
      "duration_seconds": 4.17,
      "text": "alright, migraines, that matches what I have here"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.44,
      "end_seconds": 133.55,
      "duration_seconds": 2.11,
      "text": "any breast lumps or smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.0,
      "end_seconds": 137.93,
      "duration_seconds": 2.93,
      "text": "No, no breast lumps or smoking."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.8,
      "end_seconds": 144.43,
      "duration_seconds": 1.63,
      "text": "How's your breathing otherwise?"
