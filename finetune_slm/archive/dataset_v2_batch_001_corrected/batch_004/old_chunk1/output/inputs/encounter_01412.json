      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.88,
      "end_seconds": 96.97,
      "duration_seconds": 2.09,
      "text": "No, um, never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.61,
      "end_seconds": 112.66,
      "duration_seconds": 2.05,
      "text": "What about your medical history?"
