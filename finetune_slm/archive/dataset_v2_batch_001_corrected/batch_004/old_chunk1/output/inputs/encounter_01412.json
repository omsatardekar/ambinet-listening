    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.25,
      "end_seconds": 73.55,
      "duration_seconds": 5.3,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.4,
      "end_seconds": 90.45,
      "duration_seconds": 15.05,
      "text": "I only drink at family occasions. I've never touched a cigarette. I hardly move around during the day. I'm a plumber, lots of bending and kneeling. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.19,
      "end_seconds": 94.01,
      "duration_seconds": 2.82,
      "text": "have you had any previous surgeries?"
