      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.64,
      "end_seconds": 290.97,
      "duration_seconds": 9.33,
      "text": "Take the pill at the same time each day and use condoms if you miss two. I'll want another look in three months."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 292.49,
      "end_seconds": 296.55,
      "duration_seconds": 4.06,
      "text": "I can put that appointment in for you now."
