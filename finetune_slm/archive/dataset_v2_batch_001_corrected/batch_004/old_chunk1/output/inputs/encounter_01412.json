      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.65,
      "end_seconds": 148.26,
      "duration_seconds": 2.61,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.53,
      "end_seconds": 162.91,
      "duration_seconds": 3.38,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.85,
      "end_seconds": 178.46,
      "duration_seconds": 2.61,
      "text": "sit still for a a moment.."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.95,
      "end_seconds": 202.98,
      "duration_seconds": 5.03,
      "text": "Okay: pulse 75, blood pressure 121 over 71, temperature 36.8."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.82,
      "end_seconds": 209.3,
      "duration_seconds": 4.48,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0025",
