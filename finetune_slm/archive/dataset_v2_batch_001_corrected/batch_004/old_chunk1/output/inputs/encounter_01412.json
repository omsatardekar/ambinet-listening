    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.88,
      "end_seconds": 247.39,
      "duration_seconds": 8.51,
      "text": "that's the examination finished having listened and examined, it fits best with suitable for hormonal contraception with no risk factors"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.07,
      "end_seconds": 251.66,
      "duration_seconds": 3.59,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.4,
      "end_seconds": 276.88,
      "duration_seconds": 23.48,
      "text": "nothing I've seen today points to an emergency it looks like suitable for hormonal contraception with no risk factors i'm prescribing levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term you take it by mouth that should help with contraception it's a commonly used medicine and most people tolerate it well"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.91,
      "end_seconds": 280.46,
      "duration_seconds": 1.55,
      "text": "Okay, I understand."
    },
