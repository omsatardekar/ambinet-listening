  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.1,
      "end_seconds": 4.34,
      "duration_seconds": 3.24,
      "text": "Right, hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.0,
      "end_seconds": 8.11,
      "duration_seconds": 2.11,
      "text": "evening, um, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.39,
      "end_seconds": 15.35,
      "duration_seconds": 5.96,
      "text": "Hello, uh, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.25,
      "end_seconds": 19.75,
      "duration_seconds": 2.5,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.86,
      "end_seconds": 28.56,
      "duration_seconds": 7.7,
      "text": "um, um, so... my face drooping on one side. That's why I came"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.41,
      "end_seconds": 32.4,
      "duration_seconds": 2.99,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.24,
      "end_seconds": 36.57,
      "duration_seconds": 3.33,
      "text": "Yeah for one week I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.6,
      "end_seconds": 41.41,
      "duration_seconds": 3.81,
      "text": "rate it it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.31,
      "end_seconds": 49.02,
      "duration_seconds": 5.71,
      "text": "I'd call it moderate. There's a sudden headache as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.56,
      "end_seconds": 50.56,
      "duration_seconds": 1.0,
      "text": "mm, okay"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 53.19,
      "end_seconds": 56.57,
      "duration_seconds": 3.38,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.54,
      "end_seconds": 62.94,
      "duration_seconds": 4.4,
      "text": "any seizure, fever or loss of consciousness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.9,
      "end_seconds": 80.09,
      "duration_seconds": 15.19,
      "text": "No, no seizure, no fever, no loss of consciousness. I did have slurred speech at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.84,
      "end_seconds": 84.25,
      "duration_seconds": 2.41,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.03,
      "end_seconds": 87.56,
      "duration_seconds": 1.53,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.03,
      "end_seconds": 91.63,
      "duration_seconds": 2.6,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.94,
      "end_seconds": 94.0,
      "duration_seconds": 1.06,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.64,
      "end_seconds": 97.05,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.7,
      "end_seconds": 100.68,
      "duration_seconds": 1.98,
      "text": "no not at all"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.3,
      "end_seconds": 105.18,
      "duration_seconds": 2.88,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.15,
      "end_seconds": 112.07,
      "duration_seconds": 4.92,
      "text": "Yeah you know my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.13,
      "end_seconds": 117.64,
      "duration_seconds": 3.51,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.2,
      "end_seconds": 127.3,
      "duration_seconds": 9.1,
      "text": "Okay, you know, so I have an irregular heartbeat, for two years. Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.8,
      "end_seconds": 130.08,
      "duration_seconds": 1.28,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.61,
      "end_seconds": 133.71,
      "duration_seconds": 3.1,
      "text": "Gout, for about a year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.3,
      "end_seconds": 135.55,
      "duration_seconds": 1.25,
      "text": "any other things?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.87,
      "end_seconds": 156.62,
      "duration_seconds": 4.75,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.46,
      "end_seconds": 176.46,
      "duration_seconds": 14.0,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.38,
      "end_seconds": 180.77,
      "duration_seconds": 2.39,
      "text": "Before we go further any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.96,
      "end_seconds": 196.3,
      "duration_seconds": 14.34,
      "text": "hmm, there was some antibiotic, I was told I was allergic but I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.62,
      "end_seconds": 201.45,
      "duration_seconds": 3.83,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.24,
      "end_seconds": 208.1,
      "duration_seconds": 5.86,
      "text": "Right, I'm on apixaban, 5 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_5",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.16,
      "end_seconds": 220.32,
      "duration_seconds": 10.16,
      "text": "doctor, I think the last prescription for the apixaban was 10 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.5,
      "end_seconds": 225.45,
      "duration_seconds": 3.95,
      "text": "I see is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.14,
      "end_seconds": 230.33,
      "duration_seconds": 3.19,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.38,
      "end_seconds": 239.73,
      "duration_seconds": 8.35,
      "text": "It's a... um I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.76,
      "end_seconds": 244.49,
      "duration_seconds": 2.73,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.11,
      "end_seconds": 256.78,
      "duration_seconds": 10.67,
      "text": "For the gout, I believe. My husband sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.82,
      "end_seconds": 262.26,
      "duration_seconds": 4.44,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.49,
      "end_seconds": 273.25,
      "duration_seconds": 2.76,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.71,
      "end_seconds": 292.28,
      "duration_seconds": 7.57,
      "text": "Okay: temperature 36.9, pressure 152 over 94, pulse is 87 beats a a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.51,
      "end_seconds": 295.61,
      "duration_seconds": 2.1,
      "text": "is that that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.03,
      "end_seconds": 299.59,
      "duration_seconds": 2.56,
      "text": "we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.35,
      "end_seconds": 304.72,
      "duration_seconds": 3.37,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.15,
      "end_seconds": 307.47,
      "duration_seconds": 1.32,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.7,
      "end_seconds": 324.7,
      "duration_seconds": 7.0,
      "text": "your right face droops, your right arm is weak and your speech is slurred"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.87,
      "end_seconds": 344.08,
      "duration_seconds": 1.21,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 348.3,
      "end_seconds": 363.38,
      "duration_seconds": 15.08,
      "text": "good you can sit up again. So based on the history and and the examination this looks most like a possible stroke, within the treatment window. A migraine with aura is still possible"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.0,
      "end_seconds": 368.85,
      "duration_seconds": 4.85,
      "text": "Mm, um, is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.63,
      "end_seconds": 388.97,
      "duration_seconds": 19.34,
      "text": "it's reasonable to be concerned, but right now a possible stroke, within the treatment window is my leading thought, not anything worse so, to recap quickly you've had your face drooping on one side for one week, moderate, and no seizure or fever"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.88,
      "end_seconds": 394.96,
      "duration_seconds": 4.08,
      "text": "yeah, um, yes, you've got it"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.53,
      "end_seconds": 401.14,
      "duration_seconds": 4.61,
      "text": "I'd like to arrange a blood sugar test for stroke symptoms."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.24,
      "end_seconds": 406.91,
      "duration_seconds": 3.67,
      "text": "Ah how long will it take?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.78,
      "end_seconds": 445.05,
      "duration_seconds": 37.27,
      "text": "I'm sending you for an urgent CT scan of the head cos of possible stroke it's a routine test and it'll give us a much clearer picture call an ambulance now, you need hospital immediately i think the stroke team should see you too and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose i'll want another look straight away that's all from me any questions?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 446.87,
      "end_seconds": 451.5,
      "duration_seconds": 4.63,
      "text": "good you know thanks I'll see you then"
    }
  ]
}