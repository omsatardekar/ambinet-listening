{
  "schema_version": "1.0",
  "encounter_id": "01395",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 6.77,
      "duration_seconds": 5.39,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.53,
      "end_seconds": 13.36,
      "duration_seconds": 4.83,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.22,
      "end_seconds": 23.47,
      "duration_seconds": 8.25,
      "text": "actually, mainly vomiting blood there's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.6,
      "end_seconds": 29.51,
      "duration_seconds": 4.91,
      "text": "When did this begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.09,
      "end_seconds": 33.1,
      "duration_seconds": 3.01,
      "text": "it's been like this since Monday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.99,
      "end_seconds": 43.94,
      "duration_seconds": 8.95,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.01,
      "end_seconds": 60.97,
      "duration_seconds": 14.96,
      "text": "Moderate, I'd say honestly, on and off and I've been feeling faint as well, for one week as for feeling faint, honestly, every other day yes, standing that makes it worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.67,
      "end_seconds": 64.71,
      "duration_seconds": 3.04,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.4,
      "end_seconds": 82.4,
      "duration_seconds": 16.0,
      "text": "I only drink at family occasions. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.86,
      "end_seconds": 87.52,
      "duration_seconds": 3.66,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.34,
      "end_seconds": 91.49,
      "duration_seconds": 3.15,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.77,
      "end_seconds": 109.6,
      "duration_seconds": 3.83,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.6,
      "end_seconds": 113.66,
      "duration_seconds": 3.06,
      "text": "Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.64,
      "end_seconds": 130.58,
      "duration_seconds": 2.94,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.14,
      "end_seconds": 132.72,
      "duration_seconds": 1.58,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.92,
      "end_seconds": 147.31,
      "duration_seconds": 3.39,
      "text": "A few quick ones: chest pain or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.24,
      "end_seconds": 156.06,
      "duration_seconds": 2.82,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.1,
      "end_seconds": 160.92,
      "duration_seconds": 2.82,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.61,
      "end_seconds": 163.63,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.81,
      "end_seconds": 167.21,
      "duration_seconds": 2.4,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.03,
      "end_seconds": 169.81,
      "duration_seconds": 1.78,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.24,
      "end_seconds": 173.66,
      "duration_seconds": 2.42,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.18,
      "end_seconds": 187.08,
      "duration_seconds": 2.9,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.42,
      "end_seconds": 210.47,
      "duration_seconds": 8.05,
      "text": "Okay: heart rate 122, respiratory rate 20, BP is 123 over 86. And temperature 36.5."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.02,
      "end_seconds": 212.7,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.59,
      "end_seconds": 218.97,
      "duration_seconds": 4.38,
      "text": "Right, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.76,
      "end_seconds": 225.09,
      "duration_seconds": 4.33,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.27,
      "end_seconds": 227.5,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.92,
      "end_seconds": 249.26,
      "duration_seconds": 7.34,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.85,
      "end_seconds": 255.74,
      "duration_seconds": 1.89,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.84,
      "end_seconds": 280.34,
      "duration_seconds": 6.5,
      "text": "Let me tell you where I've got to. I'd lean towards a possible bleeding stomach ulcer."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.42,
      "end_seconds": 284.55,
      "duration_seconds": 3.13,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.5,
      "end_seconds": 317.24,
      "duration_seconds": 30.74,
      "text": "I understand the worry. At the moment I'd say it's a possible bleeding stomach ulcer, and we'll know more once the an endoscopy is back. I want an endoscopy done, that's for bleeding. That will help us see what's going on underneath and decide the next step. Please stop the ibuprofen and do not eat or drink. The emergency team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.0,
      "end_seconds": 333.06,
      "duration_seconds": 15.06,
      "text": "I'm not ordering urgent blood tests today. If things carry on next month, we'll consider it. Keep an eye out, and if you vomit again, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.78,
      "end_seconds": 338.24,
      "duration_seconds": 3.46,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.91,
      "end_seconds": 344.91,
      "duration_seconds": 5.0,
      "text": "We'll catch up straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.53,
      "end_seconds": 348.64,
      "duration_seconds": 3.11,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.42,
      "end_seconds": 350.7,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}