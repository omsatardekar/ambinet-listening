      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.56,
      "end_seconds": 286.41,
      "duration_seconds": 8.85,
      "text": "Do get help quickly if you get leg swelling or severe headaches. Let's plan a check in three months."
    },
    {
