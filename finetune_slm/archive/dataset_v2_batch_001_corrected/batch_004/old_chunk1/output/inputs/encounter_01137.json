{
  "schema_version": "1.0",
  "encounter_id": "01137",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 3.63,
      "duration_seconds": 2.98,
      "text": "Alright, good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.5,
      "end_seconds": 5.66,
      "duration_seconds": 1.16,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 6.89,
      "end_seconds": 13.86,
      "duration_seconds": 6.97,
      "text": "Doctor, you know, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.92,
      "end_seconds": 20.67,
      "duration_seconds": 5.75,
      "text": "Absolutely, come and sit beside them. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.9,
      "end_seconds": 33.34,
      "duration_seconds": 11.44,
      "text": "Erm, I'm here because of a tight band around my head. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 42.22,
      "duration_seconds": 8.07,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.7,
      "end_seconds": 47.84,
      "duration_seconds": 4.14,
      "text": "I'd say mild. It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.03,
      "end_seconds": 55.37,
      "duration_seconds": 2.34,
      "text": "Have you had a stiff neck?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.87,
      "end_seconds": 59.07,
      "duration_seconds": 2.2,
      "text": "Yes, since this morning."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.53,
      "end_seconds": 63.91,
      "duration_seconds": 3.38,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.59,
      "end_seconds": 69.61,
      "duration_seconds": 4.02,
      "text": "I'd call it severe. Oh, and tired eyes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.44,
      "end_seconds": 77.1,
      "duration_seconds": 5.66,
      "text": "Let me check a few things. Any blurred vision, sensitivity to light or weakness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.86,
      "end_seconds": 80.96,
      "duration_seconds": 2.1,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.25,
      "end_seconds": 83.98,
      "duration_seconds": 1.73,
      "text": "Any sign of sickness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.97,
      "end_seconds": 88.87,
      "duration_seconds": 3.9,
      "text": "Okay, so not at all, no sickness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.37,
      "end_seconds": 91.81,
      "duration_seconds": 2.44,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.46,
      "end_seconds": 99.46,
      "duration_seconds": 6.0,
      "text": "Right, um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.97,
      "end_seconds": 121.02,
      "duration_seconds": 3.05,
      "text": "Okay, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.58,
      "end_seconds": 128.75,
      "duration_seconds": 6.17,
      "text": "So, uh, I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.39,
      "end_seconds": 131.98,
      "duration_seconds": 2.59,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.72,
      "end_seconds": 135.54,
      "duration_seconds": 2.82,
      "text": "I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.47,
      "end_seconds": 138.25,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.28,
      "end_seconds": 144.21,
      "duration_seconds": 3.93,
      "text": "Yes, depression. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.58,
      "end_seconds": 162.16,
      "duration_seconds": 12.58,
      "text": "Mm, okay. Alright, depression, that matches what I have here. Are there any allergies I should be aware of? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.18,
      "end_seconds": 178.44,
      "duration_seconds": 14.26,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.46,
      "end_seconds": 182.85,
      "duration_seconds": 3.39,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.35,
      "end_seconds": 187.57,
      "duration_seconds": 3.22,
      "text": "Thyronorm. I take it every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.81,
      "end_seconds": 191.32,
      "duration_seconds": 2.51,
      "text": "So, how much do you take?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.62,
      "end_seconds": 203.22,
      "duration_seconds": 6.6,
      "text": "It's, It's 50 micrograms. I take mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.41,
      "end_seconds": 206.46,
      "duration_seconds": 2.05,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.07,
      "end_seconds": 216.76,
      "duration_seconds": 6.69,
      "text": "About about a month. I take metoprolol, 50 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.26,
      "end_seconds": 225.22,
      "duration_seconds": 2.96,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.17,
      "end_seconds": 232.32,
      "duration_seconds": 6.15,
      "text": "So, no, it's at home. Fluoxetine I don't take anymore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.09,
      "end_seconds": 234.37,
      "duration_seconds": 1.28,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.91,
      "end_seconds": 239.77,
      "duration_seconds": 4.86,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.34,
      "end_seconds": 243.18,
      "duration_seconds": 1.84,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.96,
      "end_seconds": 249.37,
      "duration_seconds": 5.41,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.73,
      "end_seconds": 254.68,
      "duration_seconds": 3.95,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.28,
      "end_seconds": 259.01,
      "duration_seconds": 3.73,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.08,
      "end_seconds": 264.25,
      "duration_seconds": 3.17,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 265.31,
      "end_seconds": 270.46,
      "duration_seconds": 5.15,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.94,
      "end_seconds": 273.78,
      "duration_seconds": 1.84,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.57,
      "end_seconds": 279.09,
      "duration_seconds": 3.52,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 288.37,
      "end_seconds": 299.7,
      "duration_seconds": 11.33,
      "text": "Doctor, I've got the readings for you. Pulse is 64 beats a minute, pressure 112 over 73, SpO2 98 percent on room air, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.46,
      "end_seconds": 302.41,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.63,
      "end_seconds": 307.13,
      "duration_seconds": 2.5,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.28,
      "end_seconds": 310.24,
      "duration_seconds": 1.96,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.9,
      "end_seconds": 323.1,
      "duration_seconds": 5.2,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.97,
      "end_seconds": 327.79,
      "duration_seconds": 1.82,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.78,
      "end_seconds": 353.51,
      "duration_seconds": 8.73,
      "text": "Let me tell you where I've got to. It fits best with tension-type headache. We shouldn't forget eye strain."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.18,
      "end_seconds": 359.66,
      "duration_seconds": 4.48,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.05,
      "end_seconds": 375.91,
      "duration_seconds": 14.86,
      "text": "I can't promise yet, but most people with tension-type headache do well once it's treated properly. Stop me if I've got anything wrong. You've had a tight band around your head, mild, and no sickness or weakness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.18,
      "end_seconds": 378.77,
      "duration_seconds": 1.59,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.45,
      "end_seconds": 404.1,
      "duration_seconds": 24.65,
      "text": "Let's book an eye test to look into eye strain. Take screen breaks every hour and try regular neck stretches. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.07,
      "end_seconds": 408.81,
      "duration_seconds": 3.74,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.53,
      "end_seconds": 417.26,
      "duration_seconds": 6.73,
      "text": "If the headache becomes sudden and severe, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 418.41,
      "end_seconds": 423.2,
      "duration_seconds": 4.79,
      "text": "Okay, uh, I'll look out for that."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.78,
      "end_seconds": 429.92,
      "duration_seconds": 5.14,
      "text": "I'll want another look in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 434.57,
      "end_seconds": 438.36,
      "duration_seconds": 3.79,
      "text": "Well, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 439.0,
      "end_seconds": 440.95,
      "duration_seconds": 1.95,
      "text": "Right, see you soon."
    }
  ]
}