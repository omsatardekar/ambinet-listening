{
  "schema_version": "1.0",
  "encounter_id": "01133",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.27,
      "duration_seconds": 2.34,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.73,
      "end_seconds": 7.7,
      "duration_seconds": 2.97,
      "text": "Mm, afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.3,
      "end_seconds": 9.65,
      "duration_seconds": 1.35,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 15.91,
      "duration_seconds": 4.2,
      "text": "So the thing is, I've got a severe headache."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.47,
      "end_seconds": 19.49,
      "duration_seconds": 3.02,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.4,
      "end_seconds": 29.48,
      "duration_seconds": 8.08,
      "text": "It's been three days, I'm fairly sure. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 33.72,
      "duration_seconds": 2.36,
      "text": "Any recent head injury or cough?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.29,
      "end_seconds": 40.64,
      "duration_seconds": 6.35,
      "text": "Right, um, I haven't had recent head injury or cough, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.76,
      "end_seconds": 44.74,
      "duration_seconds": 2.98,
      "text": "Alright, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.91,
      "end_seconds": 50.19,
      "duration_seconds": 4.28,
      "text": "Erm, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.07,
      "end_seconds": 66.0,
      "duration_seconds": 2.93,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.56,
      "end_seconds": 77.74,
      "duration_seconds": 10.18,
      "text": "I've had depression for five years now. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.96,
      "end_seconds": 80.56,
      "duration_seconds": 1.6,
      "text": "Sure. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.35,
      "end_seconds": 83.59,
      "duration_seconds": 2.24,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.34,
      "end_seconds": 90.28,
      "duration_seconds": 4.94,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.21,
      "end_seconds": 95.07,
      "duration_seconds": 3.86,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.44,
      "end_seconds": 99.24,
      "duration_seconds": 2.8,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.38,
      "end_seconds": 109.95,
      "duration_seconds": 9.57,
      "text": "I look after my grandchildren most days. I'm vegetarian and have been for years. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.21,
      "end_seconds": 123.8,
      "duration_seconds": 2.59,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.14,
      "end_seconds": 129.08,
      "duration_seconds": 3.94,
      "text": "Fluoxetine, 20 milligrams, every morning for my mood."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.31,
      "end_seconds": 132.49,
      "duration_seconds": 3.18,
      "text": "Sure. So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.63,
      "end_seconds": 145.22,
      "duration_seconds": 2.59,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.48,
      "end_seconds": 164.87,
      "duration_seconds": 4.39,
      "text": "Okay: pulse 98, pressure 106 over 77, temperature 38.2."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.9,
      "end_seconds": 169.06,
      "duration_seconds": 3.16,
      "text": "I mean, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.42,
      "end_seconds": 177.02,
      "duration_seconds": 2.6,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.31,
      "end_seconds": 181.66,
      "duration_seconds": 2.35,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.93,
      "end_seconds": 185.08,
      "duration_seconds": 2.15,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.52,
      "end_seconds": 205.85,
      "duration_seconds": 7.33,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.35,
      "end_seconds": 212.39,
      "duration_seconds": 2.04,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.41,
      "end_seconds": 231.57,
      "duration_seconds": 6.16,
      "text": "So, based on the history and the examination, this looks most like possible bacterial meningitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.58,
      "end_seconds": 235.65,
      "duration_seconds": 3.07,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 249.07,
      "duration_seconds": 11.96,
      "text": "I understand the worry. At the moment I'd say it's possible bacterial meningitis, and we'll know more once the a lumbar puncture is back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.39,
      "end_seconds": 295.89,
      "duration_seconds": 29.5,
      "text": "I'm sending you for a lumbar puncture because of possible meningitis. We'll begin with benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. Call an ambulance now, this is an emergency. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'd like you back straight away. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.48,
      "end_seconds": 300.14,
      "duration_seconds": 3.66,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.13,
      "end_seconds": 303.43,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}