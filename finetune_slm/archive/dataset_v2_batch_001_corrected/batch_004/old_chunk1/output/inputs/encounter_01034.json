    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.79,
      "end_seconds": 17.94,
      "duration_seconds": 6.15,
      "text": "So the thing is, I've got a tight band around my head."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.19,
      "end_seconds": 20.5,
      "duration_seconds": 1.31,
      "text": "Since when exactly?"
