{
  "schema_version": "1.0",
  "encounter_id": "01085",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 4.85,
      "duration_seconds": 3.51,
      "text": "Morning, come on through. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.4,
      "end_seconds": 11.29,
      "duration_seconds": 5.89,
      "text": "Doctor, it's no real problems. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.84,
      "end_seconds": 14.2,
      "duration_seconds": 1.36,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.98,
      "end_seconds": 17.88,
      "duration_seconds": 2.9,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.01,
      "end_seconds": 22.18,
      "duration_seconds": 3.17,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.36,
      "end_seconds": 26.72,
      "duration_seconds": 3.36,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.26,
      "end_seconds": 32.85,
      "duration_seconds": 4.59,
      "text": "What about a bit of back stiffness, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.85,
      "end_seconds": 36.4,
      "duration_seconds": 1.55,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.36,
      "end_seconds": 49.19,
      "duration_seconds": 4.83,
      "text": "Did you get weight loss, chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.11,
      "end_seconds": 54.99,
      "duration_seconds": 4.88,
      "text": "No, no weight loss, chest pain or shortness of breath."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.84,
      "end_seconds": 59.66,
      "duration_seconds": 2.82,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.36,
      "end_seconds": 61.7,
      "duration_seconds": 1.34,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.54,
      "end_seconds": 65.91,
      "duration_seconds": 3.37,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.59,
      "end_seconds": 68.42,
      "duration_seconds": 1.83,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.12,
      "end_seconds": 73.32,
      "duration_seconds": 3.2,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.45,
      "end_seconds": 80.78,
      "duration_seconds": 6.33,
      "text": "Uh, you know, I'm on simvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.8,
      "end_seconds": 84.92,
      "duration_seconds": 2.12,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.0,
      "end_seconds": 88.65,
      "duration_seconds": 1.65,
      "text": "It's 20 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.7,
      "end_seconds": 91.66,
      "duration_seconds": 1.96,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.69,
      "end_seconds": 96.57,
      "duration_seconds": 2.88,
      "text": "I've, I've got high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.72,
      "end_seconds": 108.37,
      "duration_seconds": 10.65,
      "text": "Mm, okay. Alright, high cholesterol, that matches what I have here. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.41,
      "end_seconds": 120.66,
      "duration_seconds": 11.25,
      "text": "My partner and our baby. I grab fast food at lunch most days. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.67,
      "end_seconds": 135.32,
      "duration_seconds": 2.65,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.27,
      "end_seconds": 144.75,
      "duration_seconds": 7.48,
      "text": "Sorry, what was I saying, I'm allergic to naproxen, I get stomach pain."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.68,
      "end_seconds": 149.77,
      "duration_seconds": 3.09,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.36,
      "end_seconds": 159.97,
      "duration_seconds": 2.61,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.86,
      "end_seconds": 184.89,
      "duration_seconds": 9.03,
      "text": "Okay: respiratory rate 16, blood pressure 125 over 73. And SpO2 99 percent on room air, pulse 70, temperature 36.7."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.92,
      "end_seconds": 192.95,
      "duration_seconds": 2.03,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.69,
      "end_seconds": 196.7,
      "duration_seconds": 3.01,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.04,
      "end_seconds": 200.76,
      "duration_seconds": 2.72,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.91,
      "end_seconds": 218.68,
      "duration_seconds": 1.77,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.32,
      "end_seconds": 222.77,
      "duration_seconds": 2.45,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.79,
      "end_seconds": 233.71,
      "duration_seconds": 2.92,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.44,
      "end_seconds": 237.18,
      "duration_seconds": 1.74,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.8,
      "end_seconds": 243.27,
      "duration_seconds": 2.47,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 276.4,
      "duration_seconds": 16.99,
      "text": "So where does that leave us? It fits best with a healthy adult with no worrying findings. Let me repeat that back to make sure. You've had no real problems for about a week, and no weight loss or shortness of breath."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.41,
      "end_seconds": 278.11,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.68,
      "end_seconds": 315.03,
      "duration_seconds": 35.35,
      "text": "I'm going to order a cholesterol blood test, for routine check. A fasting sugar test is what I'd like next, for routine check. Keep up regular exercise and a balanced diet. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. If new symptoms appear, or you feel really unwell, please come to the emergency department. Come back in twelve months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.06,
      "end_seconds": 323.64,
      "duration_seconds": 3.58,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.49,
      "end_seconds": 326.96,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}