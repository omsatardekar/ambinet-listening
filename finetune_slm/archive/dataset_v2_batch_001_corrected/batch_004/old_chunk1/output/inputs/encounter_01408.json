{
  "schema_version": "1.0",
  "encounter_id": "01408",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 7.05,
      "duration_seconds": 5.89,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.02,
      "end_seconds": 12.31,
      "duration_seconds": 4.29,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.37,
      "end_seconds": 18.92,
      "duration_seconds": 4.55,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.98,
      "end_seconds": 25.71,
      "duration_seconds": 4.73,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.9,
      "end_seconds": 30.76,
      "duration_seconds": 3.86,
      "text": "I wanted to get wheezing looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.79,
      "end_seconds": 34.86,
      "duration_seconds": 3.07,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.97,
      "end_seconds": 42.25,
      "duration_seconds": 6.28,
      "text": "Mostly mild. Oh, and swollen lips. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.11,
      "end_seconds": 48.09,
      "duration_seconds": 4.98,
      "text": "What about your throat closing up, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.26,
      "end_seconds": 63.86,
      "duration_seconds": 10.6,
      "text": "Yeah, that too. Erm, uh, as for my throat closing up, I'd call it mild. It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.69,
      "end_seconds": 76.43,
      "duration_seconds": 1.74,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.6,
      "end_seconds": 80.55,
      "duration_seconds": 2.95,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.67,
      "end_seconds": 84.05,
      "duration_seconds": 2.38,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.74,
      "end_seconds": 89.54,
      "duration_seconds": 3.8,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.92,
      "end_seconds": 94.63,
      "duration_seconds": 3.71,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.56,
      "end_seconds": 98.41,
      "duration_seconds": 2.85,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.49,
      "end_seconds": 115.9,
      "duration_seconds": 3.41,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.04,
      "end_seconds": 121.09,
      "duration_seconds": 4.05,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.83,
      "end_seconds": 127.33,
      "duration_seconds": 4.5,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.51,
      "end_seconds": 131.02,
      "duration_seconds": 2.51,
      "text": "Yes, walnuts. I get hives."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.72,
      "end_seconds": 135.13,
      "duration_seconds": 2.41,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 137.22,
      "end_seconds": 142.63,
      "duration_seconds": 5.41,
      "text": "Let me think, she takes Asthalin inhaler, when needed for my asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.37,
      "end_seconds": 146.98,
      "duration_seconds": 3.61,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.73,
      "end_seconds": 154.08,
      "duration_seconds": 6.35,
      "text": "Yes, asthma. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.88,
      "end_seconds": 165.79,
      "duration_seconds": 10.91,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. Did you get chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.42,
      "end_seconds": 171.29,
      "duration_seconds": 3.87,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.19,
      "end_seconds": 173.61,
      "duration_seconds": 1.42,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.34,
      "end_seconds": 177.33,
      "duration_seconds": 1.99,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.11,
      "end_seconds": 182.15,
      "duration_seconds": 3.04,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.53,
      "end_seconds": 196.45,
      "duration_seconds": 2.92,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.64,
      "end_seconds": 232.79,
      "duration_seconds": 16.15,
      "text": "Okay: temperature is 36.7 degrees, height 183 centimetres, BMI works out to 26.6, oxygen saturation is 96 percent, weight 89 kilos, pressure 102 over 66, heart rate 100, respiratory rate 19."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.74,
      "end_seconds": 235.2,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.23,
      "end_seconds": 241.52,
      "duration_seconds": 2.29,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.92,
      "end_seconds": 248.96,
      "duration_seconds": 5.04,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.22,
      "end_seconds": 255.26,
      "duration_seconds": 1.04,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.86,
      "end_seconds": 258.85,
      "duration_seconds": 1.99,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.49,
      "end_seconds": 278.03,
      "duration_seconds": 7.54,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.43,
      "end_seconds": 289.4,
      "duration_seconds": 6.97,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. This looks most like anaphylaxis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.02,
      "end_seconds": 324.54,
      "duration_seconds": 25.52,
      "text": "I'm sending you for monitoring because of anaphylaxis. What I'm giving you is adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.36,
      "end_seconds": 332.97,
      "duration_seconds": 3.61,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.7,
      "end_seconds": 338.95,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}