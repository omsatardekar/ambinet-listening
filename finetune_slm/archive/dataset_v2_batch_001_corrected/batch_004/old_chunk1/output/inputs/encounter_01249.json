{
  "schema_version": "1.0",
  "encounter_id": "01249",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 3.71,
      "duration_seconds": 2.8,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.47,
      "end_seconds": 8.45,
      "duration_seconds": 2.98,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.26,
      "end_seconds": 12.76,
      "duration_seconds": 2.5,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.49,
      "end_seconds": 17.46,
      "duration_seconds": 2.97,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.5,
      "end_seconds": 21.41,
      "duration_seconds": 2.91,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.33,
      "end_seconds": 32.4,
      "duration_seconds": 10.07,
      "text": "Yeah, it's a racing heart. I don't know what's causing it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.82,
      "end_seconds": 36.76,
      "duration_seconds": 2.94,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.79,
      "end_seconds": 47.94,
      "duration_seconds": 10.15,
      "text": "Probably about two weeks. Yeah. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 51.7,
      "duration_seconds": 3.08,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.32,
      "end_seconds": 53.36,
      "duration_seconds": 1.04,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.59,
      "end_seconds": 56.64,
      "duration_seconds": 2.05,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.04,
      "end_seconds": 73.81,
      "duration_seconds": 15.77,
      "text": "Mm, it usually comes with very little urine. As for shaking chills and a high temperature, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.83,
      "end_seconds": 77.07,
      "duration_seconds": 2.24,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.74,
      "end_seconds": 79.56,
      "duration_seconds": 1.82,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.21,
      "end_seconds": 86.47,
      "duration_seconds": 5.26,
      "text": "Let me check a few things. Any chest pain or stiff neck?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.39,
      "end_seconds": 89.73,
      "duration_seconds": 2.34,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.09,
      "end_seconds": 95.55,
      "duration_seconds": 1.46,
      "text": "How about rash?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.61,
      "end_seconds": 100.14,
      "duration_seconds": 3.53,
      "text": "Okay, so I haven't noticed any rash."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.33,
      "end_seconds": 103.52,
      "duration_seconds": 2.19,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.34,
      "end_seconds": 106.97,
      "duration_seconds": 2.63,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.89,
      "end_seconds": 113.41,
      "duration_seconds": 4.52,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.26,
      "end_seconds": 121.02,
      "duration_seconds": 5.76,
      "text": "I've got high cholesterol. An irregular heartbeat, for five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.68,
      "end_seconds": 126.52,
      "duration_seconds": 0.84,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.06,
      "end_seconds": 136.79,
      "duration_seconds": 2.73,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.68,
      "end_seconds": 149.85,
      "duration_seconds": 11.17,
      "text": "My partner and our baby. I grab fast food at lunch most days. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.09,
      "end_seconds": 165.31,
      "duration_seconds": 7.22,
      "text": "Let me ask about allergies, anything at all? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.86,
      "end_seconds": 168.91,
      "duration_seconds": 3.05,
      "text": "Yeah, I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.61,
      "end_seconds": 174.96,
      "duration_seconds": 4.35,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.89,
      "end_seconds": 181.03,
      "duration_seconds": 4.14,
      "text": "I take atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.62,
      "end_seconds": 183.45,
      "duration_seconds": 1.83,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.28,
      "end_seconds": 191.73,
      "duration_seconds": 7.45,
      "text": "Bisoprolol. I take it 2.5 milligrams, once a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.56,
      "end_seconds": 195.61,
      "duration_seconds": 2.05,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.7,
      "end_seconds": 201.7,
      "duration_seconds": 5.0,
      "text": "About about three months. Metoprolol I don't take anymore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.64,
      "end_seconds": 221.78,
      "duration_seconds": 4.14,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.91,
      "end_seconds": 227.99,
      "duration_seconds": 5.08,
      "text": "My father has Parkinson's disease. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 231.34,
      "duration_seconds": 2.37,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.68,
      "end_seconds": 237.94,
      "duration_seconds": 5.26,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.55,
      "end_seconds": 241.31,
      "duration_seconds": 2.76,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.46,
      "end_seconds": 250.21,
      "duration_seconds": 2.75,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.35,
      "end_seconds": 274.19,
      "duration_seconds": 10.84,
      "text": "Okay: SpO2 95 percent on room air, pressure 118 over 69, temperature 39.4, pulse is 96 beats a minute, respiratory rate 18."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.36,
      "end_seconds": 280.23,
      "duration_seconds": 4.87,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.38,
      "end_seconds": 282.92,
      "duration_seconds": 1.54,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.17,
      "end_seconds": 285.83,
      "duration_seconds": 1.66,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.51,
      "end_seconds": 300.37,
      "duration_seconds": 6.86,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.84,
      "end_seconds": 318.08,
      "duration_seconds": 13.24,
      "text": "You can relax now. Let me tell you where I've got to. This is probably possible sepsis needing urgent treatment. I can't rule out a severe urine or chest infection yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.82,
      "end_seconds": 321.03,
      "duration_seconds": 2.21,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.13,
      "end_seconds": 359.0,
      "duration_seconds": 35.87,
      "text": "I can't promise yet, but most people with possible sepsis needing urgent treatment do well once it's treated properly. We should do a chest X-ray for fever. That will help us see what's going on underneath and decide the next step. I'll request blood cultures, it'll help with fever with low blood pressure. We should do lactate and blood tests for sepsis. I want to admit you to hospital now for fluids and antibiotics."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.95,
      "end_seconds": 366.05,
      "duration_seconds": 5.1,
      "text": "Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.57,
      "end_seconds": 368.27,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.14,
      "end_seconds": 377.96,
      "duration_seconds": 8.82,
      "text": "The thing that would worry me is if you cannot be brought in today. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.06,
      "end_seconds": 380.61,
      "duration_seconds": 1.55,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.16,
      "end_seconds": 384.63,
      "duration_seconds": 3.47,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.76,
      "end_seconds": 386.46,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.93,
      "end_seconds": 391.64,
      "duration_seconds": 3.71,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.16,
      "end_seconds": 397.02,
      "duration_seconds": 4.86,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.73,
      "end_seconds": 402.92,
      "duration_seconds": 4.19,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 403.75,
      "end_seconds": 408.68,
      "duration_seconds": 4.93,
      "text": "Let me think, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.2,
      "end_seconds": 410.81,
      "duration_seconds": 1.61,
      "text": "Have a good day."
    }
  ]
}