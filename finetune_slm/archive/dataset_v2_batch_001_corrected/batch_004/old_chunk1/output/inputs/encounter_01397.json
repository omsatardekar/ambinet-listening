{
  "schema_version": "1.0",
  "encounter_id": "01397",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 3.55,
      "duration_seconds": 2.89,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.32,
      "end_seconds": 12.28,
      "duration_seconds": 6.96,
      "text": "Ah, uh, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.11,
      "end_seconds": 17.34,
      "duration_seconds": 3.23,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.09,
      "end_seconds": 27.04,
      "duration_seconds": 7.95,
      "text": "Mainly a blocked ear. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.56,
      "end_seconds": 32.05,
      "duration_seconds": 3.49,
      "text": "Alright, has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.06,
      "end_seconds": 37.85,
      "duration_seconds": 3.79,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.58,
      "end_seconds": 43.39,
      "duration_seconds": 3.81,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.02,
      "end_seconds": 48.34,
      "duration_seconds": 3.32,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.32,
      "end_seconds": 51.64,
      "duration_seconds": 2.32,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.19,
      "end_seconds": 84.15,
      "duration_seconds": 31.96,
      "text": "A feeling of fullness goes along with it, um, most of the time. Right, the feeling of fullness? That's been for two months. As for muffled hearing on one side, I honestly can't say when that began. It might have been last month or the month before. With muffled hearing on one side, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.52,
      "end_seconds": 95.81,
      "duration_seconds": 3.29,
      "text": "Did you get discharge, dizziness or ringing?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.54,
      "end_seconds": 103.59,
      "duration_seconds": 7.05,
      "text": "Sorry, what was I saying, no discharge, dizziness or ringing, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.98,
      "end_seconds": 107.87,
      "duration_seconds": 1.89,
      "text": "How about ear pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.42,
      "end_seconds": 111.85,
      "duration_seconds": 2.43,
      "text": "Definitely no ear pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.05,
      "end_seconds": 116.69,
      "duration_seconds": 3.64,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.25,
      "end_seconds": 120.43,
      "duration_seconds": 3.18,
      "text": "Okay, so no, that's all normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.94,
      "end_seconds": 126.14,
      "duration_seconds": 4.2,
      "text": "Alright, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.17,
      "end_seconds": 134.25,
      "duration_seconds": 7.08,
      "text": "It's hydrocortisone cream, when needed. Olive oil drops. I take it twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.95,
      "end_seconds": 139.63,
      "duration_seconds": 2.68,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.3,
      "end_seconds": 146.93,
      "duration_seconds": 6.63,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.2,
      "end_seconds": 155.93,
      "duration_seconds": 7.73,
      "text": "What conditions have you been treated for in the past? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.93,
      "end_seconds": 168.14,
      "duration_seconds": 11.21,
      "text": "Heart failure, for two years. I've got eczema. I looked a few things up online, you know, and that probably didn't help."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.55,
      "end_seconds": 170.99,
      "duration_seconds": 1.44,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.74,
      "end_seconds": 189.08,
      "duration_seconds": 5.34,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.66,
      "end_seconds": 195.22,
      "duration_seconds": 3.56,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.32,
      "end_seconds": 197.55,
      "duration_seconds": 1.23,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.11,
      "end_seconds": 203.25,
      "duration_seconds": 4.14,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.34,
      "end_seconds": 206.04,
      "duration_seconds": 1.7,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.86,
      "end_seconds": 212.53,
      "duration_seconds": 4.67,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.33,
      "end_seconds": 217.52,
      "duration_seconds": 4.19,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.85,
      "end_seconds": 222.87,
      "duration_seconds": 4.02,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.04,
      "end_seconds": 229.76,
      "duration_seconds": 2.72,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.7,
      "end_seconds": 234.44,
      "duration_seconds": 3.74,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.39,
      "end_seconds": 239.19,
      "duration_seconds": 2.8,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.76,
      "end_seconds": 243.73,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.68,
      "end_seconds": 250.4,
      "duration_seconds": 3.72,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.37,
      "end_seconds": 261.13,
      "duration_seconds": 1.76,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.99,
      "end_seconds": 264.92,
      "duration_seconds": 1.93,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.0,
      "end_seconds": 281.89,
      "duration_seconds": 3.89,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 283.35,
      "end_seconds": 284.57,
      "duration_seconds": 1.22,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.7,
      "end_seconds": 304.03,
      "duration_seconds": 15.33,
      "text": "So, good, you can sit up again. Putting it all together, this is probably earwax blocking the ear. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.91,
      "end_seconds": 307.96,
      "duration_seconds": 3.05,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.91,
      "end_seconds": 338.56,
      "duration_seconds": 29.65,
      "text": "It's reasonable to be concerned, but right now earwax blocking the ear is my leading thought, not anything worse. Ear irrigation is what I'd like next, for wax. Use the olive oil drops for a week and then we'll syringe the ear. If you get ear pain or dizziness, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.27,
      "end_seconds": 342.03,
      "duration_seconds": 2.76,
      "text": "Alright, um, I follow."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.05,
      "end_seconds": 346.55,
      "duration_seconds": 2.5,
      "text": "Let's review you in one week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.09,
      "end_seconds": 349.66,
      "duration_seconds": 2.57,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.01,
      "end_seconds": 359.78,
      "duration_seconds": 3.77,
      "text": "So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.71,
      "end_seconds": 364.38,
      "duration_seconds": 3.67,
      "text": "Yeah, great, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.15,
      "end_seconds": 367.39,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}