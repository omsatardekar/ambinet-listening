  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 2.31,
      "duration_seconds": 1.78,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.3,
      "end_seconds": 8.24,
      "duration_seconds": 4.94,
      "text": "Okay, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.08,
      "end_seconds": 17.85,
      "duration_seconds": 6.77,
      "text": "I mean, doctor, it's bloating after meals it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.83,
      "end_seconds": 22.31,
      "duration_seconds": 3.48,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.85,
      "end_seconds": 27.92,
      "duration_seconds": 2.07,
      "text": "probably ten days yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.96,
      "end_seconds": 33.75,
      "duration_seconds": 4.79,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.6,
      "end_seconds": 58.97,
      "duration_seconds": 23.37,
      "text": "Only walking, and it's not much. I'd call it moderate. I've had a lot of wind too, for two months. Oh, with lot of wind, maybe a four out of ten on a bad day. I did have loose stools now and then at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.78,
      "end_seconds": 66.7,
      "duration_seconds": 5.92,
      "text": "Have you had bloating after meals before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.0,
      "end_seconds": 76.96,
      "duration_seconds": 5.96,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.62,
      "end_seconds": 90.52,
      "duration_seconds": 4.9,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.16,
      "end_seconds": 105.12,
      "duration_seconds": 1.96,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.03,
      "end_seconds": 128.7,
      "duration_seconds": 8.67,
      "text": "okay: oxygen saturation is 99 percent, temperature is 36.6 degrees, pulse 73. And BP is 111 over 76."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.69,
      "end_seconds": 131.62,
      "duration_seconds": 1.93,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.65,
      "end_seconds": 135.04,
      "duration_seconds": 2.39,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.97,
      "end_seconds": 142.03,
      "duration_seconds": 4.06,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.9,
      "end_seconds": 144.3,
      "duration_seconds": 1.4,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.96,
      "end_seconds": 159.46,
      "duration_seconds": 6.5,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.56,
      "end_seconds": 177.32,
      "duration_seconds": 1.76,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.06,
      "end_seconds": 187.42,
      "duration_seconds": 5.36,
      "text": "That's the examination finished. Did you get vomiting or blood in the stool?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.3,
      "end_seconds": 191.8,
      "duration_seconds": 2.5,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.29,
      "end_seconds": 196.87,
      "duration_seconds": 3.58,
      "text": "Have you had any weight loss or night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.45,
      "end_seconds": 204.3,
      "duration_seconds": 4.85,
      "text": "I haven't had weight loss or night-time diarrhoea, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.24,
      "end_seconds": 210.64,
      "duration_seconds": 2.4,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.67,
      "end_seconds": 214.43,
      "duration_seconds": 1.76,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.51,
      "end_seconds": 218.27,
      "duration_seconds": 2.76,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.15,
      "end_seconds": 221.5,
      "duration_seconds": 2.35,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.47,
      "end_seconds": 224.66,
      "duration_seconds": 2.19,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.2,
      "end_seconds": 232.92,
      "duration_seconds": 6.72,
      "text": "Yes, uh, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.77,
      "end_seconds": 239.12,
      "duration_seconds": 4.35,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.02,
      "end_seconds": 242.01,
      "duration_seconds": 1.99,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.83,
      "end_seconds": 251.99,
      "duration_seconds": 4.16,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.03,
      "end_seconds": 270.71,
      "duration_seconds": 16.68,
      "text": "I quit smoking around ten years ago. Not much, I mostly stay in these days. My husband and I live above the shop. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.57,
      "end_seconds": 275.71,
      "duration_seconds": 4.14,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.86,
      "end_seconds": 279.24,
      "duration_seconds": 2.38,
      "text": "yes, amoxicillin i get hives"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.69,
      "end_seconds": 286.59,
      "duration_seconds": 2.9,
      "text": "do you take any regular medication?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.27,
      "end_seconds": 291.2,
      "duration_seconds": 2.93,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.29,
      "end_seconds": 308.02,
      "duration_seconds": 14.73,
      "text": "Okay, so my impression is this: It points towards a functional bowel pattern, with no alarm features. The The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.98,
      "end_seconds": 312.23,
      "duration_seconds": 2.25,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.09,
      "end_seconds": 324.7,
      "duration_seconds": 11.61,
      "text": "Nothing I've seen today points to an emergency. It looks like a functional bowel pattern, with no alarm features, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.79,
      "end_seconds": 347.53,
      "duration_seconds": 4.74,
      "text": "Let's book a coeliac blood test to look into bloating."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.63,
      "end_seconds": 352.17,
      "duration_seconds": 2.54,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.35,
      "end_seconds": 362.18,
      "duration_seconds": 8.83,
      "text": "Try smaller meals and and keep a food and symptom diary for four weeks. Let's plan a check in six weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.16,
      "end_seconds": 365.34,
      "duration_seconds": 2.18,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.9,
      "end_seconds": 369.12,
      "duration_seconds": 3.22,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.02,
      "end_seconds": 372.77,
      "duration_seconds": 2.75,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.13,
      "end_seconds": 376.08,
      "duration_seconds": 1.95,
      "text": "so, take care now"
    }
  ]
