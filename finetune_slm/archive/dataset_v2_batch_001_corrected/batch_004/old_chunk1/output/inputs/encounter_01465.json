      "role": "PATIENT",
      "start_seconds": 6.72,
      "end_seconds": 13.18,
      "duration_seconds": 6.46,
      "text": "Sorry, what was I saying, hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.91,
      "end_seconds": 18.06,
      "duration_seconds": 3.15,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.63,
      "end_seconds": 23.58,
      "duration_seconds": 4.95,
      "text": "Um, so... bloating after meals. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.28,
      "end_seconds": 28.55,
      "duration_seconds": 3.27,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.77,
      "end_seconds": 33.86,
      "duration_seconds": 4.09,
      "text": "it's been two days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.98,
      "end_seconds": 38.36,
      "duration_seconds": 3.38,
      "text": "How strong would you say it is?"
