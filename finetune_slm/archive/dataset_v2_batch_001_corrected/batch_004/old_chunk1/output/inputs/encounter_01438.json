{
  "schema_version": "1.0",
  "encounter_id": "01438",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.63,
      "duration_seconds": 5.37,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 12.13,
      "duration_seconds": 4.66,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.73,
      "end_seconds": 15.86,
      "duration_seconds": 3.13,
      "text": "I've been dealing with hives all over."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.85,
      "end_seconds": 20.68,
      "duration_seconds": 3.83,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.49,
      "end_seconds": 24.33,
      "duration_seconds": 1.84,
      "text": "Probably two days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.84,
      "end_seconds": 29.01,
      "duration_seconds": 3.17,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.58,
      "end_seconds": 35.16,
      "duration_seconds": 5.58,
      "text": "It's moderate, honestly. I've also had swollen lips, since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.51,
      "end_seconds": 36.21,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.85,
      "end_seconds": 57.74,
      "duration_seconds": 2.89,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.49,
      "end_seconds": 63.72,
      "duration_seconds": 4.23,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.7,
      "end_seconds": 67.48,
      "duration_seconds": 2.78,
      "text": "Alright, tell me about your eating."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.21,
      "end_seconds": 73.52,
      "duration_seconds": 5.31,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.22,
      "end_seconds": 78.05,
      "duration_seconds": 2.83,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.85,
      "end_seconds": 86.74,
      "duration_seconds": 6.89,
      "text": "Asthma, for two years. I've had heart failure for five years now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.75,
      "end_seconds": 99.29,
      "duration_seconds": 10.54,
      "text": "Hm, okay. Okay, I can see heart failure in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.22,
      "end_seconds": 108.03,
      "duration_seconds": 7.81,
      "text": "It's Seretide inhaler, twice a day. Furosemide, 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.96,
      "end_seconds": 114.19,
      "duration_seconds": 4.23,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.0,
      "end_seconds": 116.34,
      "duration_seconds": 1.34,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.06,
      "end_seconds": 135.97,
      "duration_seconds": 2.91,
      "text": "Any recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.92,
      "end_seconds": 142.52,
      "duration_seconds": 4.6,
      "text": "No, you know, no recent illness or chest pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.13,
      "end_seconds": 151.37,
      "duration_seconds": 3.24,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.11,
      "end_seconds": 155.12,
      "duration_seconds": 2.01,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.1,
      "end_seconds": 158.87,
      "duration_seconds": 2.77,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.44,
      "end_seconds": 175.11,
      "duration_seconds": 2.67,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.76,
      "end_seconds": 203.84,
      "duration_seconds": 8.08,
      "text": "Okay: pulse is 94 beats a minute, BP is 100 over 59, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.35,
      "end_seconds": 205.83,
      "duration_seconds": 1.48,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.15,
      "end_seconds": 212.3,
      "duration_seconds": 5.15,
      "text": "Alright, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.02,
      "end_seconds": 226.97,
      "duration_seconds": 3.95,
      "text": "Listening to the whole story, it points towards anaphylaxis."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.56,
      "end_seconds": 231.94,
      "duration_seconds": 4.38,
      "text": "Well, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.0,
      "end_seconds": 247.73,
      "duration_seconds": 13.73,
      "text": "I understand the worry. At the moment I'd say it's anaphylaxis, and we'll know more once the monitoring is back. I think monitoring makes sense here, for anaphylaxis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 249.32,
      "end_seconds": 252.96,
      "duration_seconds": 3.64,
      "text": "I can book that for Wednesday at 9 am."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.63,
      "end_seconds": 284.8,
      "duration_seconds": 31.17,
      "text": "What I'm giving you is adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. I'm going to send a referral to the emergency team. The thing that would worry me is if the symptoms return. If that happens, go to emergency. I'd like you back straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.87,
      "end_seconds": 300.36,
      "duration_seconds": 9.49,
      "text": "So, I take the adrenaline, 0.5 milligrams, once now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.42,
      "end_seconds": 305.71,
      "duration_seconds": 4.29,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.66,
      "end_seconds": 308.17,
      "duration_seconds": 1.51,
      "text": "That's clear, thanks."
    }
  ]
}