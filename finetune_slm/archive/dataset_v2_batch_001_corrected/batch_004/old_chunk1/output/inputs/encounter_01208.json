{
  "schema_version": "1.0",
  "encounter_id": "01208",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 3.3,
      "duration_seconds": 2.29,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.46,
      "end_seconds": 13.38,
      "duration_seconds": 4.92,
      "text": "Erm, uh, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.44,
      "end_seconds": 16.69,
      "duration_seconds": 1.25,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.64,
      "end_seconds": 26.85,
      "duration_seconds": 8.21,
      "text": "Well, so the thing is, I've got sharp pain low on one side."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.88,
      "end_seconds": 31.2,
      "duration_seconds": 3.32,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.73,
      "end_seconds": 46.78,
      "duration_seconds": 3.05,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.92,
      "end_seconds": 68.82,
      "duration_seconds": 6.9,
      "text": "Okay: heart rate 108, respiratory rate 20, pressure 123 over 80, temperature 37.1."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.85,
      "end_seconds": 72.34,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.47,
      "end_seconds": 79.32,
      "duration_seconds": 5.85,
      "text": "I'll come back to the numbers. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.63,
      "end_seconds": 88.11,
      "duration_seconds": 7.48,
      "text": "It's been about four days now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.76,
      "end_seconds": 92.12,
      "duration_seconds": 2.36,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.36,
      "end_seconds": 97.64,
      "duration_seconds": 4.28,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.6,
      "end_seconds": 101.8,
      "duration_seconds": 2.2,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.49,
      "end_seconds": 118.69,
      "duration_seconds": 11.2,
      "text": "Shoulder tip pain goes along with it, most of the time. The shoulder tip pain? That's been since yesterday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.37,
      "end_seconds": 123.51,
      "duration_seconds": 3.14,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.46,
      "end_seconds": 126.75,
      "duration_seconds": 1.29,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.16,
      "end_seconds": 131.12,
      "duration_seconds": 2.96,
      "text": "And what about vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 138.21,
      "duration_seconds": 5.08,
      "text": "Actually, you know, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.12,
      "end_seconds": 143.17,
      "duration_seconds": 4.05,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.67,
      "end_seconds": 147.69,
      "duration_seconds": 3.02,
      "text": "Uh, no, that's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 149.51,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.58,
      "end_seconds": 153.21,
      "duration_seconds": 1.63,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.1,
      "end_seconds": 159.28,
      "duration_seconds": 4.18,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.86,
      "end_seconds": 170.43,
      "duration_seconds": 7.57,
      "text": "Okay, um, so it's allopurinol, 100 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.38,
      "end_seconds": 175.0,
      "duration_seconds": 2.62,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.49,
      "end_seconds": 183.56,
      "duration_seconds": 7.07,
      "text": "About three months now. Right, I was on febuxostat before. I stopped taking it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.14,
      "end_seconds": 187.2,
      "duration_seconds": 2.06,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.21,
      "end_seconds": 195.99,
      "duration_seconds": 4.78,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.2,
      "end_seconds": 199.59,
      "duration_seconds": 2.39,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.11,
      "end_seconds": 206.66,
      "duration_seconds": 5.55,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.81,
      "end_seconds": 210.16,
      "duration_seconds": 2.35,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.42,
      "end_seconds": 214.21,
      "duration_seconds": 2.79,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.08,
      "end_seconds": 220.69,
      "duration_seconds": 4.61,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.38,
      "end_seconds": 223.89,
      "duration_seconds": 2.51,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.48,
      "end_seconds": 228.41,
      "duration_seconds": 2.93,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.86,
      "end_seconds": 242.08,
      "duration_seconds": 8.22,
      "text": "I've got thin bones. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.76,
      "end_seconds": 254.65,
      "duration_seconds": 10.89,
      "text": "Right, so gout and thin bones are already on your record. We'll keep that in mind today. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.59,
      "end_seconds": 260.28,
      "duration_seconds": 3.69,
      "text": "Um, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.75,
      "end_seconds": 277.47,
      "duration_seconds": 2.72,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.07,
      "end_seconds": 280.8,
      "duration_seconds": 2.73,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.34,
      "end_seconds": 288.25,
      "duration_seconds": 4.91,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.38,
      "end_seconds": 291.25,
      "duration_seconds": 1.87,
      "text": "So, look straight ahead."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 314.61,
      "duration_seconds": 5.05,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.33,
      "end_seconds": 319.62,
      "duration_seconds": 2.29,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.38,
      "end_seconds": 346.08,
      "duration_seconds": 14.7,
      "text": "Right, here's what I'm thinking. My working impression is a possible ectopic pregnancy. I want to be honest that this is an impression, not a final answer. I can't rule out a ruptured ovarian cyst yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.1,
      "end_seconds": 374.63,
      "duration_seconds": 15.53,
      "text": "I think a pregnancy test makes sense here, for pelvic pain and bleeding. That will help us see what's going on underneath and decide the next step. I want an urgent pelvic scan done, that's for possible ectopic."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.65,
      "end_seconds": 378.95,
      "duration_seconds": 2.3,
      "text": "Right, you know, understood."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.0,
      "end_seconds": 398.89,
      "duration_seconds": 18.89,
      "text": "You need to go to the hospital now for an emergency scan. The gynaecology team would be the right next step, I'll refer you. I'll want another look straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.41,
      "end_seconds": 403.08,
      "duration_seconds": 3.67,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}