{
  "schema_version": "1.0",
  "encounter_id": "01140",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 7.53,
      "duration_seconds": 6.69,
      "text": "Let me think, you know, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.33,
      "end_seconds": 14.84,
      "duration_seconds": 5.51,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.87,
      "end_seconds": 21.98,
      "duration_seconds": 5.11,
      "text": "doctor, it's skipped beats. It's getting on my nerves now"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.27,
      "end_seconds": 26.21,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.13,
      "end_seconds": 31.15,
      "duration_seconds": 3.02,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.02,
      "end_seconds": 35.44,
      "duration_seconds": 2.42,
      "text": "have you tried anything for it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.32,
      "end_seconds": 40.93,
      "duration_seconds": 3.61,
      "text": "I mean, deep breaths helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.45,
      "end_seconds": 45.68,
      "duration_seconds": 2.23,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.58,
      "end_seconds": 57.96,
      "duration_seconds": 10.38,
      "text": "It usually comes with being a bit anxious. The being a bit anxious? That's been for six months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.1,
      "end_seconds": 63.85,
      "duration_seconds": 3.75,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.2,
      "end_seconds": 83.84,
      "duration_seconds": 1.64,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.2,
      "end_seconds": 86.46,
      "duration_seconds": 1.26,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.15,
      "end_seconds": 101.84,
      "duration_seconds": 4.69,
      "text": "Your pulse is regular and and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.62,
      "end_seconds": 109.38,
      "duration_seconds": 4.76,
      "text": "Please sit back down. Right, any sign of shortness of breath?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.12,
      "end_seconds": 114.15,
      "duration_seconds": 3.03,
      "text": "No. No shortness of breath."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.69,
      "end_seconds": 118.65,
      "duration_seconds": 3.96,
      "text": "Any chest pain, fainting or dizziness at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.23,
      "end_seconds": 124.73,
      "duration_seconds": 4.5,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.44,
      "end_seconds": 131.64,
      "duration_seconds": 3.2,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.94,
      "end_seconds": 134.78,
      "duration_seconds": 1.84,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.69,
      "end_seconds": 139.08,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.99,
      "end_seconds": 145.17,
      "duration_seconds": 4.18,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.5,
      "end_seconds": 148.21,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.91,
      "end_seconds": 152.98,
      "duration_seconds": 4.07,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.82,
      "end_seconds": 155.14,
      "duration_seconds": 1.32,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.31,
      "end_seconds": 160.37,
      "duration_seconds": 4.06,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.29,
      "end_seconds": 180.11,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.55,
      "end_seconds": 184.66,
      "duration_seconds": 3.11,
      "text": "Um, no allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.6,
      "end_seconds": 192.98,
      "duration_seconds": 7.38,
      "text": "Has anyone ever diagnosed you with something? I ask because it it helps me narrow things down."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.02,
      "end_seconds": 210.98,
      "duration_seconds": 15.96,
      "text": "I, I have COPD. I've had eczema for nearly five years now. I just want to to get back to normal, really. I've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.32,
      "end_seconds": 214.87,
      "duration_seconds": 2.55,
      "text": "right, and anything else to add?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.91,
      "end_seconds": 223.24,
      "duration_seconds": 7.33,
      "text": "So, yes, eczema is known to us, good to have that clear. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.31,
      "end_seconds": 226.73,
      "duration_seconds": 2.42,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.42,
      "end_seconds": 232.8,
      "duration_seconds": 4.38,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.67,
      "end_seconds": 246.71,
      "duration_seconds": 11.04,
      "text": "I mean, um, I take Tiotropium inhaler, once a day. It's hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.18,
      "end_seconds": 249.96,
      "duration_seconds": 1.78,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.77,
      "end_seconds": 257.19,
      "duration_seconds": 5.42,
      "text": "about about three months. Herbal calming tea, in the evening"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.83,
      "end_seconds": 260.4,
      "duration_seconds": 1.57,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.46,
      "end_seconds": 263.25,
      "duration_seconds": 1.79,
      "text": "For two months."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.16,
      "end_seconds": 270.49,
      "duration_seconds": 5.33,
      "text": "Okay, so my impression is this: This looks most like harmless extra heartbeats."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.56,
      "end_seconds": 276.08,
      "duration_seconds": 3.52,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.31,
      "end_seconds": 284.42,
      "duration_seconds": 7.11,
      "text": "I can't promise yet, but most people with harmless extra heartbeats do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.09,
      "end_seconds": 300.94,
      "duration_seconds": 3.85,
      "text": "An ECG is what I'd like next, for palpitations."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.0,
      "end_seconds": 303.65,
      "duration_seconds": 1.65,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.46,
      "end_seconds": 324.28,
      "duration_seconds": 19.82,
      "text": "cut back on coffee and energy drinks and keep a diary of when it happens. Don't skip meals, and try to eat smaller portions more often through the day. Come back if it carries on after a month. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.79,
      "end_seconds": 328.06,
      "duration_seconds": 3.27,
      "text": "Great, thank you for your help."
    }
  ]
}