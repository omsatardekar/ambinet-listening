{
  "schema_version": "1.0",
  "encounter_id": "01219",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.13,
      "end_seconds": 10.13,
      "duration_seconds": 9.0,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.0,
      "end_seconds": 15.63,
      "duration_seconds": 3.63,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.54,
      "end_seconds": 25.47,
      "duration_seconds": 7.93,
      "text": "Um, um, so... sharp pain low on one side. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.91,
      "end_seconds": 33.13,
      "duration_seconds": 6.22,
      "text": "How long has it been like this? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.07,
      "end_seconds": 39.74,
      "duration_seconds": 4.67,
      "text": "Um, uh, it's been ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.33,
      "end_seconds": 45.89,
      "duration_seconds": 4.56,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 54.25,
      "duration_seconds": 7.25,
      "text": "Oh, pretty severe, if I'm being honest. It happens a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.99,
      "end_seconds": 59.18,
      "duration_seconds": 3.19,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.15,
      "end_seconds": 83.21,
      "duration_seconds": 22.06,
      "text": "Light vaginal bleeding goes along with it, most of the time. The light vaginal bleeding? That's been since Friday. Oh, and shoulder tip pain. Uh, as for shoulder tip pain, it happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.14,
      "end_seconds": 102.59,
      "duration_seconds": 3.45,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.25,
      "end_seconds": 113.37,
      "duration_seconds": 5.12,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.96,
      "end_seconds": 116.5,
      "duration_seconds": 2.54,
      "text": "Okay, who lives with you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.23,
      "end_seconds": 120.08,
      "duration_seconds": 2.85,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.73,
      "end_seconds": 122.79,
      "duration_seconds": 2.06,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.41,
      "end_seconds": 128.87,
      "duration_seconds": 2.46,
      "text": "I've had migraines, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.41,
      "end_seconds": 131.17,
      "duration_seconds": 1.76,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.8,
      "end_seconds": 138.15,
      "duration_seconds": 2.35,
      "text": "I have heart failure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.98,
      "end_seconds": 148.95,
      "duration_seconds": 9.97,
      "text": "Yes, migraines and heart failure are known to us, good to have that clear. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.46,
      "end_seconds": 154.11,
      "duration_seconds": 3.65,
      "text": "I take spironolactone, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.6,
      "end_seconds": 157.83,
      "duration_seconds": 2.23,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.09,
      "end_seconds": 164.53,
      "duration_seconds": 5.44,
      "text": "25 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.94,
      "end_seconds": 169.51,
      "duration_seconds": 3.57,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.36,
      "end_seconds": 178.31,
      "duration_seconds": 3.95,
      "text": "So, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.29,
      "end_seconds": 182.89,
      "duration_seconds": 2.6,
      "text": "Okay, any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.69,
      "end_seconds": 192.13,
      "duration_seconds": 8.44,
      "text": "Well, yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.95,
      "end_seconds": 196.97,
      "duration_seconds": 3.02,
      "text": "Any vaginal discharge or fever at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.34,
      "end_seconds": 202.3,
      "duration_seconds": 3.96,
      "text": "Yeah, no, no vaginal discharge or fever."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.38,
      "end_seconds": 206.42,
      "duration_seconds": 3.04,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.45,
      "end_seconds": 210.2,
      "duration_seconds": 2.75,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.55,
      "end_seconds": 213.68,
      "duration_seconds": 2.13,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.5,
      "end_seconds": 218.42,
      "duration_seconds": 3.92,
      "text": "Erm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 233.19,
      "end_seconds": 241.06,
      "duration_seconds": 7.87,
      "text": "Here are the numbers, doctor. Saturation 99 percent, temperature 37.1. Pulse 114, pressure 129 over 81."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.3,
      "end_seconds": 246.3,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.2,
      "end_seconds": 252.22,
      "duration_seconds": 3.02,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.41,
      "end_seconds": 255.56,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.94,
      "end_seconds": 272.09,
      "duration_seconds": 5.15,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.21,
      "end_seconds": 279.19,
      "duration_seconds": 2.98,
      "text": "Yeah, you know, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.72,
      "end_seconds": 302.27,
      "duration_seconds": 20.55,
      "text": "So, you can sit up now. Taking everything into account, I think we're dealing with a possible ectopic pregnancy at this stage. Stop me if I've got anything wrong. You've had sharp pain low on one side for ten days, severe, and no fever or vaginal discharge."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.88,
      "end_seconds": 305.78,
      "duration_seconds": 2.9,
      "text": "Mm, uh, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.7,
      "end_seconds": 328.93,
      "duration_seconds": 10.23,
      "text": "An urgent pelvic scan is what I'd like next, for possible ectopic. A pregnancy test is what I'd like next, for pelvic pain and bleeding."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 330.33,
      "end_seconds": 332.45,
      "duration_seconds": 2.12,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.5,
      "end_seconds": 345.82,
      "duration_seconds": 11.32,
      "text": "You need to go to the hospital now for an emergency scan. We'll refer you to the gynaecology team. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 347.07,
      "end_seconds": 347.77,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.62,
      "end_seconds": 354.13,
      "duration_seconds": 4.51,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 355.3,
      "end_seconds": 357.09,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.76,
      "end_seconds": 360.05,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}