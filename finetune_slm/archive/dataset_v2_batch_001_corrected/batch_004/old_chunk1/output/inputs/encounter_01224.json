{
  "schema_version": "1.0",
  "encounter_id": "01224",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 8.86,
      "duration_seconds": 7.53,
      "text": "Hello doctor, um, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.36,
      "end_seconds": 14.81,
      "duration_seconds": 4.45,
      "text": "alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.31,
      "end_seconds": 28.67,
      "duration_seconds": 12.36,
      "text": "Hmm, uh, honestly, it's being very thirsty, and my family pushed me to come. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.7,
      "end_seconds": 33.72,
      "duration_seconds": 3.02,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.33,
      "end_seconds": 42.19,
      "duration_seconds": 6.86,
      "text": "I mean, I'd say about four days. Actually, no, closer to five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.51,
      "end_seconds": 48.53,
      "duration_seconds": 3.02,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.28,
      "end_seconds": 51.75,
      "duration_seconds": 1.47,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.77,
      "end_seconds": 56.92,
      "duration_seconds": 3.15,
      "text": "Has there been deep fast breathing too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.2,
      "end_seconds": 61.47,
      "duration_seconds": 3.27,
      "text": "Yes, you know, since last weekend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.24,
      "end_seconds": 65.42,
      "duration_seconds": 3.18,
      "text": "And what about chest pain or cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.13,
      "end_seconds": 70.92,
      "duration_seconds": 3.79,
      "text": "I haven't had chest pain or cough, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.02,
      "end_seconds": 76.71,
      "duration_seconds": 4.69,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.76,
      "end_seconds": 80.21,
      "duration_seconds": 2.45,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.12,
      "end_seconds": 86.67,
      "duration_seconds": 5.55,
      "text": "Any allergies to tablets, food or anything in the the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.74,
      "end_seconds": 90.17,
      "duration_seconds": 2.43,
      "text": "Yes, I'm allergic to tramadol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.47,
      "end_seconds": 98.66,
      "duration_seconds": 4.19,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.47,
      "end_seconds": 100.96,
      "duration_seconds": 1.49,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.96,
      "end_seconds": 104.4,
      "duration_seconds": 1.44,
      "text": "Right, any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.11,
      "end_seconds": 109.76,
      "duration_seconds": 3.65,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.21,
      "end_seconds": 113.29,
      "duration_seconds": 2.08,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.97,
      "end_seconds": 117.92,
      "duration_seconds": 2.95,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.78,
      "end_seconds": 121.01,
      "duration_seconds": 1.23,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 125.17,
      "duration_seconds": 2.99,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.96,
      "end_seconds": 130.26,
      "duration_seconds": 3.3,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.54,
      "end_seconds": 137.65,
      "duration_seconds": 3.11,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.85,
      "end_seconds": 152.45,
      "duration_seconds": 2.6,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.28,
      "end_seconds": 157.79,
      "duration_seconds": 3.51,
      "text": "Hmm, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.67,
      "end_seconds": 172.57,
      "duration_seconds": 2.9,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.19,
      "end_seconds": 187.89,
      "duration_seconds": 2.7,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.43,
      "end_seconds": 204.3,
      "duration_seconds": 6.87,
      "text": "Okay: oxygen saturation is 97 percent, pressure 119 over 71, temperature 36.9. And heart rate 105."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.35,
      "end_seconds": 206.72,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.63,
      "end_seconds": 211.48,
      "duration_seconds": 3.85,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.52,
      "end_seconds": 217.76,
      "duration_seconds": 4.24,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.99,
      "end_seconds": 220.48,
      "duration_seconds": 1.49,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.32,
      "end_seconds": 225.06,
      "duration_seconds": 2.74,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.28,
      "end_seconds": 239.29,
      "duration_seconds": 4.01,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.14,
      "end_seconds": 245.59,
      "duration_seconds": 2.45,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.23,
      "end_seconds": 271.72,
      "duration_seconds": 18.49,
      "text": "Having listened and examined, this looks most like diabetic ketoacidosis. I want to be honest that this is an impression, not a final answer. So, to recap quickly. You've had being very thirsty for five days, severe, and no cough or chest pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.37,
      "end_seconds": 275.06,
      "duration_seconds": 2.69,
      "text": "Yes, um, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.57,
      "end_seconds": 307.06,
      "duration_seconds": 24.49,
      "text": "We should do blood gas and electrolytes for DKA. You need to go to hospital now for insulin and fluids. If you cannot get there now, or you feel really unwell, please come to the emergency department. Book a review straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.68,
      "end_seconds": 311.62,
      "duration_seconds": 3.94,
      "text": "Right, great, thank you for your help."
    }
  ]
}