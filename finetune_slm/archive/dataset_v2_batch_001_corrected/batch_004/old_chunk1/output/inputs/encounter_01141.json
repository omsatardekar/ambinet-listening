{
  "schema_version": "1.0",
  "encounter_id": "01141",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 8.66,
      "duration_seconds": 7.55,
      "text": "Hello doctor, you know, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.52,
      "end_seconds": 15.45,
      "duration_seconds": 4.93,
      "text": "not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.06,
      "end_seconds": 18.92,
      "duration_seconds": 1.86,
      "text": "I've been feeling faint"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.56,
      "end_seconds": 23.88,
      "duration_seconds": 4.32,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.62,
      "end_seconds": 43.3,
      "duration_seconds": 18.68,
      "text": "Hydrocortisone cream. I take it when needed for the eczema. Though honestly, some days I forget to take it. Allopurinol. I take it 100 milligrams, once a day. I'm on ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.02,
      "end_seconds": 47.3,
      "duration_seconds": 3.28,
      "text": "what's the timeline when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.32,
      "end_seconds": 51.43,
      "duration_seconds": 2.11,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.68,
      "end_seconds": 55.08,
      "duration_seconds": 3.4,
      "text": "mm, okay is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.89,
      "end_seconds": 60.51,
      "duration_seconds": 3.62,
      "text": "it happens once or twice a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.21,
      "end_seconds": 65.77,
      "duration_seconds": 2.56,
      "text": "have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.25,
      "end_seconds": 72.98,
      "duration_seconds": 2.73,
      "text": "Lying down helps a a bit"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.14,
      "end_seconds": 76.79,
      "duration_seconds": 2.65,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.31,
      "end_seconds": 81.26,
      "duration_seconds": 2.95,
      "text": "Yes, standing. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.55,
      "end_seconds": 89.94,
      "duration_seconds": 4.39,
      "text": "right, is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.59,
      "end_seconds": 97.45,
      "duration_seconds": 5.86,
      "text": "Pretty severe, if I'm being honest. There's black tarry stools as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.09,
      "end_seconds": 103.04,
      "duration_seconds": 1.95,
      "text": "Any stomach pain as well?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.3,
      "end_seconds": 107.67,
      "duration_seconds": 3.37,
      "text": "Yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.68,
      "end_seconds": 120.05,
      "duration_seconds": 3.37,
      "text": "right, any fever or chest pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.46,
      "end_seconds": 125.46,
      "duration_seconds": 4.0,
      "text": "I haven't had fever or chest pain, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.61,
      "end_seconds": 128.93,
      "duration_seconds": 2.32,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.98,
      "end_seconds": 134.94,
      "duration_seconds": 3.96,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.86,
      "end_seconds": 139.8,
      "duration_seconds": 2.94,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.53,
      "end_seconds": 146.74,
      "duration_seconds": 6.21,
      "text": "I've had eczema for about a year now i've had gout yes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.75,
      "end_seconds": 151.51,
      "duration_seconds": 3.76,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.74,
      "end_seconds": 156.15,
      "duration_seconds": 2.41,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.26,
      "end_seconds": 160.43,
      "duration_seconds": 3.17,
      "text": "alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.45,
      "end_seconds": 170.9,
      "duration_seconds": 9.45,
      "text": "Mm I had a reaction to erythromycin when I was younger bad stomach cramps and I've avoided it since."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.99,
      "end_seconds": 182.82,
      "duration_seconds": 0.83,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.21,
      "end_seconds": 186.98,
      "duration_seconds": 2.77,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.93,
      "end_seconds": 189.77,
      "duration_seconds": 1.84,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.86,
      "end_seconds": 193.5,
      "duration_seconds": 1.64,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.45,
      "end_seconds": 198.89,
      "duration_seconds": 3.44,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.82,
      "end_seconds": 203.83,
      "duration_seconds": 3.01,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.42,
      "end_seconds": 207.51,
      "duration_seconds": 2.09,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.6,
      "end_seconds": 212.97,
      "duration_seconds": 4.37,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.23,
      "end_seconds": 216.46,
      "duration_seconds": 2.23,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.4,
      "end_seconds": 225.92,
      "duration_seconds": 5.52,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 227.04,
      "end_seconds": 236.02,
      "duration_seconds": 8.98,
      "text": "Doctor, I've got the readings for you. Pressure 124 over 73, pulse 112, respiratory rate 18, SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.26,
      "end_seconds": 238.49,
      "duration_seconds": 1.23,
      "text": "good thank you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.09,
      "end_seconds": 242.15,
      "duration_seconds": 2.06,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.74,
      "end_seconds": 246.03,
      "duration_seconds": 2.29,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.84,
      "end_seconds": 261.79,
      "duration_seconds": 5.95,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.4,
      "end_seconds": 266.77,
      "duration_seconds": 2.37,
      "text": "good you can sit up again"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.51,
      "end_seconds": 287.19,
      "duration_seconds": 5.68,
      "text": "okay thinking it through it points towards a possible bleeding stomach ulcer"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.38,
      "end_seconds": 294.27,
      "duration_seconds": 2.89,
      "text": "is it dangerous, uh, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.01,
      "end_seconds": 326.97,
      "duration_seconds": 31.96,
      "text": "nothing I've seen today points to an emergency it looks like a possible bleeding stomach ulcer but I'd like to confirm let's get urgent blood tests for bleeding i'd rather check than guess and this is the quickest way to know more please stop the ibuprofen and do not eat or drink i think the emergency team should see you too. An endoscopy is something we might do if this doesn't improve in a month"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.61,
      "end_seconds": 333.54,
      "duration_seconds": 4.93,
      "text": "I'll want another look straight away that's all from me any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.62,
      "end_seconds": 338.81,
      "duration_seconds": 3.19,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}