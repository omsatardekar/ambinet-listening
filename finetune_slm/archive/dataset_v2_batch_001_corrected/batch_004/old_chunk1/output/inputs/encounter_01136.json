  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.85,
      "duration_seconds": 4.18,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.53,
      "end_seconds": 11.55,
      "duration_seconds": 5.02,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.68,
      "end_seconds": 18.48,
      "duration_seconds": 5.8,
      "text": "I've been dealing with an itchy patch on my wrist"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.24,
      "end_seconds": 22.77,
      "duration_seconds": 3.53,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.2,
      "end_seconds": 30.71,
      "duration_seconds": 3.51,
      "text": "I've had it for two months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.01,
      "end_seconds": 44.78,
      "duration_seconds": 8.77,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.26,
      "end_seconds": 61.72,
      "duration_seconds": 15.46,
      "text": "um um maybe a three out of ten on a bad day i'd say once or twice a day it settles a little with moisturiser"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.67,
      "end_seconds": 67.56,
      "duration_seconds": 3.89,
      "text": "What about dry flaky skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.07,
      "end_seconds": 75.69,
      "duration_seconds": 7.62,
      "text": "Yeah. Five days, I'd say. About dry flaky skin, it feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.59,
      "end_seconds": 83.87,
      "duration_seconds": 6.28,
      "text": "have you had an itchy patch on your wrist before or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.54,
      "end_seconds": 92.93,
      "duration_seconds": 7.39,
      "text": "let me think um a bit last year. It settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.67,
      "end_seconds": 111.23,
      "duration_seconds": 2.56,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.8,
      "end_seconds": 125.02,
      "duration_seconds": 2.22,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.8,
      "end_seconds": 146.33,
      "duration_seconds": 10.53,
      "text": "okay: weight 57 kilos, BMI works out to 16.8, pulse is 68 beats a minute, height 184 centimetres, pressure 108 over 73."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.06,
      "end_seconds": 151.3,
      "duration_seconds": 2.24,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.18,
      "end_seconds": 153.47,
      "duration_seconds": 1.29,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.26,
      "end_seconds": 177.7,
      "duration_seconds": 5.44,
      "text": "There's a neat red patch where the watch strap sits with a little scaling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.87,
      "end_seconds": 184.62,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.32,
      "end_seconds": 199.47,
      "duration_seconds": 3.15,
      "text": "Did you get spreading blisters or fever?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.54,
      "end_seconds": 205.71,
      "duration_seconds": 5.17,
      "text": "No spreading, blisters or fever, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.99,
      "end_seconds": 210.35,
      "duration_seconds": 4.36,
      "text": "hm okay. What about your tummy and bowels anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.68,
      "end_seconds": 214.27,
      "duration_seconds": 2.59,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.75,
      "end_seconds": 219.26,
      "duration_seconds": 3.51,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.19,
      "end_seconds": 224.87,
      "duration_seconds": 3.68,
      "text": "Okay, so my father had bowel cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.7,
      "end_seconds": 229.59,
      "duration_seconds": 2.89,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.17,
      "end_seconds": 244.0,
      "duration_seconds": 10.83,
      "text": "My husband and I live above the shop. I look after my grandchildren most days. I hardly move around during the day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.51,
      "end_seconds": 249.38,
      "duration_seconds": 3.87,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.51,
      "end_seconds": 254.88,
      "duration_seconds": 4.37,
      "text": "I take Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.12,
      "end_seconds": 260.47,
      "duration_seconds": 4.35,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.41,
      "end_seconds": 265.74,
      "duration_seconds": 4.33,
      "text": "um I have COPD for about a year"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.63,
      "end_seconds": 274.93,
      "duration_seconds": 8.3,
      "text": "Yes COPD is known to us good to have that clear. What operations have you had if any?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.78,
      "end_seconds": 282.87,
      "duration_seconds": 6.09,
      "text": "I had keyhole surgery on my gallbladder two years back"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.36,
      "end_seconds": 289.09,
      "duration_seconds": 4.73,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.3,
      "end_seconds": 295.59,
      "duration_seconds": 5.29,
      "text": "well, I'm allergic to grass pollen, I get itchy eyes"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.15,
      "end_seconds": 319.41,
      "duration_seconds": 9.26,
      "text": "so where does that leave us? It fits best with mild contact dermatitis from the watch strap. I'd also keep eczema in mind"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.31,
      "end_seconds": 325.35,
      "duration_seconds": 5.04,
      "text": "I mean, is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.11,
      "end_seconds": 347.98,
      "duration_seconds": 21.87,
      "text": "nothing I've seen today points to an emergency it looks like mild contact dermatitis from the watch strap i'm prescribing hydrocortisone cream, 1%, once a day, one week it's for contact dermatitis stop wearing that strap and keep the skin moisturised okay, that's all from me any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.56,
      "end_seconds": 352.49,
      "duration_seconds": 3.93,
      "text": "well, no, that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.22,
      "end_seconds": 354.67,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
