{
  "schema_version": "1.0",
  "encounter_id": "01479",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 7.91,
      "duration_seconds": 7.16,
      "text": "hmm, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.91,
      "end_seconds": 14.84,
      "duration_seconds": 5.93,
      "text": "Yes, come in and and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.93,
      "end_seconds": 22.44,
      "duration_seconds": 6.51,
      "text": "Um, so... a tight band around my head. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.05,
      "end_seconds": 26.43,
      "duration_seconds": 3.38,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.26,
      "end_seconds": 34.92,
      "duration_seconds": 6.66,
      "text": "About a week, I think... sorry, about two weeks, I got that wrong"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.76,
      "end_seconds": 39.1,
      "duration_seconds": 2.34,
      "text": "is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.83,
      "end_seconds": 48.75,
      "duration_seconds": 7.92,
      "text": "let me think, you know, I notice it more with stress and long screen days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.75,
      "end_seconds": 55.35,
      "duration_seconds": 2.6,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.64,
      "end_seconds": 60.08,
      "duration_seconds": 3.44,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.97,
      "end_seconds": 64.18,
      "duration_seconds": 3.21,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.07,
      "end_seconds": 69.86,
      "duration_seconds": 3.79,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.62,
      "end_seconds": 73.05,
      "duration_seconds": 2.43,
      "text": "Have you had tired eyes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.7,
      "end_seconds": 80.85,
      "duration_seconds": 7.15,
      "text": "yes, about the same, about four days about tired eyes, screens definitely sets it off"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.93,
      "end_seconds": 84.13,
      "duration_seconds": 1.2,
      "text": "What about weakness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.3,
      "end_seconds": 87.1,
      "duration_seconds": 1.8,
      "text": "No weakness, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.2,
      "end_seconds": 91.56,
      "duration_seconds": 3.36,
      "text": "any blurred vision, sensitivity to light or sickness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.28,
      "end_seconds": 97.7,
      "duration_seconds": 5.42,
      "text": "I haven't had blurred vision, sensitivity to light or sickness, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.46,
      "end_seconds": 101.69,
      "duration_seconds": 2.23,
      "text": "has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.63,
      "end_seconds": 104.59,
      "duration_seconds": 0.96,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.55,
      "end_seconds": 112.61,
      "duration_seconds": 2.06,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.1,
      "end_seconds": 115.66,
      "duration_seconds": 1.56,
      "text": "no, nothing there"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.37,
      "end_seconds": 119.71,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.89,
      "end_seconds": 124.52,
      "duration_seconds": 3.63,
      "text": "I had a triple bypass eight years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.69,
      "end_seconds": 132.96,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.62,
      "end_seconds": 135.39,
      "duration_seconds": 1.77,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.37,
      "end_seconds": 137.67,
      "duration_seconds": 1.3,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.62,
      "end_seconds": 143.43,
      "duration_seconds": 3.81,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.15,
      "end_seconds": 147.88,
      "duration_seconds": 2.73,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.86,
      "end_seconds": 152.35,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.08,
      "end_seconds": 156.73,
      "duration_seconds": 3.65,
      "text": "Right, are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.3,
      "end_seconds": 160.01,
      "duration_seconds": 2.71,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.1,
      "end_seconds": 164.88,
      "duration_seconds": 2.78,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.13,
      "end_seconds": 171.42,
      "duration_seconds": 5.29,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.19,
      "end_seconds": 183.0,
      "duration_seconds": 3.81,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.15,
      "end_seconds": 187.98,
      "duration_seconds": 3.83,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.08,
      "end_seconds": 192.92,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.02,
      "end_seconds": 205.69,
      "duration_seconds": 10.67,
      "text": "I'm on metoprolol, 50 milligrams, twice a day it's, It's aspirin, 75 milligrams, once a day i take paracetamol, when needed"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.42,
      "end_seconds": 209.81,
      "duration_seconds": 2.39,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.56,
      "end_seconds": 215.78,
      "duration_seconds": 4.22,
      "text": "1 gram, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.57,
      "end_seconds": 229.07,
      "duration_seconds": 4.5,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.82,
      "end_seconds": 238.84,
      "duration_seconds": 6.02,
      "text": "I have an irregular heartbeat, for five years. I have high blood pressure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.53,
      "end_seconds": 240.89,
      "duration_seconds": 1.36,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.53,
      "end_seconds": 244.43,
      "duration_seconds": 1.9,
      "text": "I've got heart disease"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.59,
      "end_seconds": 260.79,
      "duration_seconds": 13.2,
      "text": "right, yes, an irregular heartbeat and high blood pressure are known to us, good to to have that clear. Time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.94,
      "end_seconds": 270.27,
      "duration_seconds": 2.33,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.61,
      "end_seconds": 299.22,
      "duration_seconds": 9.61,
      "text": "Okay: respiratory rate 14, temp 36.8 degrees, blood pressure 118 over 75. And saturation 98 percent, heart rate 73."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.63,
      "end_seconds": 304.06,
      "duration_seconds": 3.43,
      "text": "Right, shall I start the the examination?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.32,
      "end_seconds": 306.61,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.0,
      "end_seconds": 321.69,
      "duration_seconds": 5.69,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 338.08,
      "duration_seconds": 10.81,
      "text": "Good, you can sit up again. So, based on the history and the examination, it points towards tension-type headache. Eye strain is still possible."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.53,
      "end_seconds": 342.4,
      "duration_seconds": 2.87,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.12,
      "end_seconds": 362.72,
      "duration_seconds": 19.6,
      "text": "I can't promise yet, but most people with tension-type headache do well once it's treated properly i'll request an eye test, it'll help with eye strain see me again in four weeks i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.2,
      "end_seconds": 366.64,
      "duration_seconds": 2.44,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}