{
  "schema_version": "1.0",
  "encounter_id": "01488",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 3.23,
      "duration_seconds": 2.57,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.09,
      "end_seconds": 10.04,
      "duration_seconds": 4.95,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.82,
      "end_seconds": 16.32,
      "duration_seconds": 3.5,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 17.36,
      "end_seconds": 20.03,
      "duration_seconds": 2.67,
      "text": "We came because of vomiting blood."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.66,
      "end_seconds": 25.29,
      "duration_seconds": 3.63,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.99,
      "end_seconds": 35.08,
      "duration_seconds": 8.09,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.36,
      "end_seconds": 38.82,
      "duration_seconds": 2.46,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 55.65,
      "duration_seconds": 14.94,
      "text": "Yeah, for the anxiety, I believe. My husband sets them out for me, I just take what I'm given. I, I take ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 56.17,
      "end_seconds": 64.62,
      "duration_seconds": 8.45,
      "text": "Doctor, I think the last prescription for the ibuprofen was 200 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.44,
      "end_seconds": 72.33,
      "duration_seconds": 4.89,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.87,
      "end_seconds": 78.05,
      "duration_seconds": 4.18,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.75,
      "end_seconds": 85.79,
      "duration_seconds": 7.04,
      "text": "How many days or weeks has it been? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.13,
      "end_seconds": 94.24,
      "duration_seconds": 7.11,
      "text": "It's, It's been ten days now. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.96,
      "end_seconds": 98.77,
      "duration_seconds": 2.81,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.81,
      "end_seconds": 106.49,
      "duration_seconds": 5.68,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.03,
      "end_seconds": 113.3,
      "duration_seconds": 6.27,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.02,
      "end_seconds": 116.83,
      "duration_seconds": 2.81,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.57,
      "end_seconds": 124.98,
      "duration_seconds": 7.41,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 125.08,
      "end_seconds": 130.16,
      "duration_seconds": 5.08,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.22,
      "end_seconds": 133.51,
      "duration_seconds": 2.29,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.78,
      "end_seconds": 139.21,
      "duration_seconds": 4.43,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.39,
      "end_seconds": 144.05,
      "duration_seconds": 3.66,
      "text": "And I've been feeling faint as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.77,
      "end_seconds": 150.52,
      "duration_seconds": 4.75,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.4,
      "end_seconds": 158.66,
      "duration_seconds": 6.26,
      "text": "It's, um... not exactly... well, hard to explain, I mean—"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.5,
      "end_seconds": 166.27,
      "duration_seconds": 6.77,
      "text": "Let me put it another way: how many times in a typical day or week?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.97,
      "end_seconds": 169.75,
      "duration_seconds": 2.78,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.85,
      "end_seconds": 174.13,
      "duration_seconds": 2.28,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.66,
      "end_seconds": 179.19,
      "duration_seconds": 1.53,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 180.93,
      "end_seconds": 185.85,
      "duration_seconds": 4.92,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.56,
      "end_seconds": 194.08,
      "duration_seconds": 6.52,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.06,
      "end_seconds": 202.93,
      "duration_seconds": 6.87,
      "text": "Alright, I'll note both what you've said and what you've noticed. How about chest pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.81,
      "end_seconds": 212.31,
      "duration_seconds": 8.5,
      "text": "Not that I've noticed, no chest pain. There was stomach pain, yes, but that went away."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.94,
      "end_seconds": 217.13,
      "duration_seconds": 3.19,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.84,
      "end_seconds": 221.45,
      "duration_seconds": 2.61,
      "text": "Erm, no, joints are fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.91,
      "end_seconds": 225.13,
      "duration_seconds": 2.22,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.96,
      "end_seconds": 228.06,
      "duration_seconds": 1.1,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.85,
      "end_seconds": 232.85,
      "duration_seconds": 3.0,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.83,
      "end_seconds": 243.13,
      "duration_seconds": 9.3,
      "text": "I'm allergic to nickel, I get a rash on my skin. Yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.12,
      "end_seconds": 250.66,
      "duration_seconds": 5.54,
      "text": "Alright, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 252.67,
      "end_seconds": 263.78,
      "duration_seconds": 11.11,
      "text": "I have anxiety. I'm hoping you can tell me something definite. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.23,
      "end_seconds": 267.89,
      "duration_seconds": 2.66,
      "text": "I follow. And alcohol, how much?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 269.37,
      "end_seconds": 273.09,
      "duration_seconds": 3.72,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.51,
      "end_seconds": 275.41,
      "duration_seconds": 0.9,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 276.66,
      "end_seconds": 280.6,
      "duration_seconds": 3.94,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.86,
      "end_seconds": 283.05,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.13,
      "end_seconds": 287.52,
      "duration_seconds": 3.39,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 292.98,
      "end_seconds": 306.52,
      "duration_seconds": 13.54,
      "text": "Okay, so the vitals from earlier. Weight 71 kilos, respiratory rate 20, height 182 centimetres. Heart rate 114, BP is 135 over 79, temp 36.8 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.07,
      "end_seconds": 308.98,
      "duration_seconds": 0.91,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.24,
      "end_seconds": 314.75,
      "duration_seconds": 3.51,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.81,
      "end_seconds": 316.83,
      "duration_seconds": 1.02,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.54,
      "end_seconds": 321.73,
      "duration_seconds": 3.19,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.38,
      "end_seconds": 337.56,
      "duration_seconds": 6.18,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.58,
      "end_seconds": 344.12,
      "duration_seconds": 2.54,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.6,
      "end_seconds": 369.36,
      "duration_seconds": 8.76,
      "text": "Stop me if I've got anything wrong. You've had vomiting blood for ten days, and no chest pain."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 370.86,
      "end_seconds": 373.1,
      "duration_seconds": 2.24,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 391.78,
      "end_seconds": 415.17,
      "duration_seconds": 23.39,
      "text": "Let's get urgent blood tests, for bleeding. I think an endoscopy makes sense here, for bleeding. Please stop the ibuprofen and do not eat or drink. Let's get you seen by the emergency team, I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 415.81,
      "end_seconds": 417.6,
      "duration_seconds": 1.79,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.58,
      "end_seconds": 421.72,
      "duration_seconds": 2.14,
      "text": "See me again straight away."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 423.38,
      "end_seconds": 425.47,
      "duration_seconds": 2.09,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.77,
      "end_seconds": 430.72,
      "duration_seconds": 3.95,
      "text": "So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 431.77,
      "end_seconds": 435.48,
      "duration_seconds": 3.71,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 436.82,
      "end_seconds": 438.63,
      "duration_seconds": 1.81,
      "text": "Have a good day."
    }
  ]
}