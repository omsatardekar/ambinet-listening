{
  "schema_version": "1.0",
  "encounter_id": "01349",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.1,
      "end_seconds": 2.67,
      "duration_seconds": 1.57,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.91,
      "end_seconds": 6.57,
      "duration_seconds": 2.66,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.82,
      "end_seconds": 10.27,
      "duration_seconds": 2.45,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.1,
      "end_seconds": 19.55,
      "duration_seconds": 8.45,
      "text": "Mainly sharp pain low on one side. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 21.57,
      "end_seconds": 32.33,
      "duration_seconds": 10.76,
      "text": "Okay, so the vitals from earlier. Pulse is 113 beats a minute, SpO2 99 percent on room air, temperature is 36.7 degrees, BP is 137 over 73."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.78,
      "end_seconds": 37.01,
      "duration_seconds": 3.23,
      "text": "Thanks. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.98,
      "end_seconds": 43.81,
      "duration_seconds": 4.83,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.57,
      "end_seconds": 48.78,
      "duration_seconds": 3.21,
      "text": "Okay, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.84,
      "end_seconds": 59.32,
      "duration_seconds": 9.48,
      "text": "When it starts I tend to get light vaginal bleeding as well. I've also been feeling faint, for four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.29,
      "end_seconds": 64.42,
      "duration_seconds": 3.13,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.55,
      "end_seconds": 84.34,
      "duration_seconds": 18.79,
      "text": "A five out of ten, I suppose. The light vaginal bleeding? That's been for about three months. And shoulder tip pain, too. About shoulder tip pain, it happens a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.32,
      "end_seconds": 93.66,
      "duration_seconds": 7.34,
      "text": "Have you had sharp pain low on one side before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.6,
      "end_seconds": 101.84,
      "duration_seconds": 6.24,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.54,
      "end_seconds": 118.63,
      "duration_seconds": 3.09,
      "text": "Have you noticed fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.41,
      "end_seconds": 127.55,
      "duration_seconds": 3.14,
      "text": "No, no fever or vaginal discharge."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.19,
      "end_seconds": 131.54,
      "duration_seconds": 2.35,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.71,
      "end_seconds": 134.21,
      "duration_seconds": 1.5,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.43,
      "end_seconds": 137.85,
      "duration_seconds": 2.42,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.67,
      "end_seconds": 141.49,
      "duration_seconds": 2.82,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.07,
      "end_seconds": 153.25,
      "duration_seconds": 3.18,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.03,
      "end_seconds": 166.37,
      "duration_seconds": 11.34,
      "text": "Seretide inhaler. I take it twice a day for my asthma. I take furosemide, 40 milligrams, maybe, every morning for the fluid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.2,
      "end_seconds": 175.54,
      "duration_seconds": 4.34,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.62,
      "end_seconds": 180.37,
      "duration_seconds": 3.75,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 200.6,
      "duration_seconds": 3.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.65,
      "end_seconds": 210.42,
      "duration_seconds": 8.77,
      "text": "I have asthma. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 212.44,
      "duration_seconds": 1.03,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.93,
      "end_seconds": 221.07,
      "duration_seconds": 7.14,
      "text": "Heart failure, for nearly five years. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.82,
      "end_seconds": 224.41,
      "duration_seconds": 1.59,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.08,
      "end_seconds": 227.89,
      "duration_seconds": 2.81,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.57,
      "end_seconds": 236.56,
      "duration_seconds": 6.99,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.65,
      "end_seconds": 240.57,
      "duration_seconds": 1.92,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.6,
      "end_seconds": 245.5,
      "duration_seconds": 3.9,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.1,
      "end_seconds": 248.35,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.3,
      "end_seconds": 254.2,
      "duration_seconds": 3.9,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.91,
      "end_seconds": 256.57,
      "duration_seconds": 1.66,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.16,
      "end_seconds": 261.41,
      "duration_seconds": 3.25,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.5,
      "end_seconds": 266.96,
      "duration_seconds": 3.46,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.21,
      "end_seconds": 270.52,
      "duration_seconds": 2.31,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.03,
      "end_seconds": 289.07,
      "duration_seconds": 5.04,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 291.71,
      "end_seconds": 292.76,
      "duration_seconds": 1.05,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.68,
      "end_seconds": 298.34,
      "duration_seconds": 1.66,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 299.29,
      "end_seconds": 302.9,
      "duration_seconds": 3.61,
      "text": "We've already done a pregnancy test this morning, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.62,
      "end_seconds": 316.68,
      "duration_seconds": 12.06,
      "text": "Right, thank you. I'm sending you for an urgent pelvic scan because of possible ectopic. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.14,
      "end_seconds": 321.79,
      "duration_seconds": 1.65,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.79,
      "end_seconds": 346.1,
      "duration_seconds": 23.31,
      "text": "You need to go to the hospital now for an emergency scan. I think the gynaecology team should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'll want another look straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 347.17,
      "end_seconds": 349.44,
      "duration_seconds": 2.27,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.46,
      "end_seconds": 352.83,
      "duration_seconds": 1.37,
      "text": "Look after yourself."
    }
  ]
}