{
  "schema_version": "1.0",
  "encounter_id": "01426",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 3.36,
      "duration_seconds": 2.79,
      "text": "Morning doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.04,
      "end_seconds": 9.83,
      "duration_seconds": 4.79,
      "text": "not at all, please sit what seems to to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.67,
      "end_seconds": 13.42,
      "duration_seconds": 2.75,
      "text": "I've been dealing with skipped beats"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.66,
      "end_seconds": 17.82,
      "duration_seconds": 3.16,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.33,
      "end_seconds": 21.73,
      "duration_seconds": 3.4,
      "text": "it's been like this since this morning"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.03,
      "end_seconds": 27.97,
      "duration_seconds": 4.94,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.8,
      "end_seconds": 39.4,
      "duration_seconds": 9.6,
      "text": "I'd give it a four, out of ten. Only deep breaths, and it's not much. It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.03,
      "end_seconds": 43.16,
      "duration_seconds": 2.13,
      "text": "How about shortness of breath?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.59,
      "end_seconds": 48.09,
      "duration_seconds": 3.5,
      "text": "I haven't noticed any shortness of breath."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.72,
      "end_seconds": 53.33,
      "duration_seconds": 3.61,
      "text": "And what about fainting, dizziness or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.1,
      "end_seconds": 59.44,
      "duration_seconds": 5.34,
      "text": "no fainting, dizziness or chest pain, none of it"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.21,
      "end_seconds": 64.92,
      "duration_seconds": 4.71,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.43,
      "end_seconds": 66.96,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.26,
      "end_seconds": 83.24,
      "duration_seconds": 2.98,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.48,
      "end_seconds": 89.49,
      "duration_seconds": 5.01,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.65,
      "end_seconds": 92.71,
      "duration_seconds": 2.06,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.54,
      "end_seconds": 97.61,
      "duration_seconds": 4.07,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 100.71,
      "duration_seconds": 1.63,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.85,
      "end_seconds": 105.53,
      "duration_seconds": 3.68,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.88,
      "end_seconds": 110.21,
      "duration_seconds": 3.33,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.31,
      "end_seconds": 113.55,
      "duration_seconds": 2.24,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.8,
      "end_seconds": 117.46,
      "duration_seconds": 2.66,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.55,
      "end_seconds": 120.92,
      "duration_seconds": 2.37,
      "text": "no, not at all"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.71,
      "end_seconds": 126.27,
      "duration_seconds": 3.56,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.85,
      "end_seconds": 132.67,
      "duration_seconds": 4.82,
      "text": "Naproxen, 250 milligrams, twice a day for the knee pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.63,
      "end_seconds": 152.8,
      "duration_seconds": 4.17,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.48,
      "end_seconds": 157.79,
      "duration_seconds": 4.31,
      "text": "I'm allergic to naproxen, I get stomach pain"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.7,
      "end_seconds": 172.59,
      "duration_seconds": 4.89,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.16,
      "end_seconds": 177.14,
      "duration_seconds": 2.98,
      "text": "I've got arthritis in my knees"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.53,
      "end_seconds": 195.29,
      "duration_seconds": 4.76,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.55,
      "end_seconds": 204.02,
      "duration_seconds": 2.47,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.32,
      "end_seconds": 221.4,
      "duration_seconds": 5.08,
      "text": "Okay: saturation 98 percent heart rate 82 BP is 125 over 70."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.81,
      "end_seconds": 224.35,
      "duration_seconds": 1.54,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.46,
      "end_seconds": 228.75,
      "duration_seconds": 3.29,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.05,
      "end_seconds": 232.72,
      "duration_seconds": 2.67,
      "text": "alright, may I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.49,
      "end_seconds": 236.61,
      "duration_seconds": 2.12,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.94,
      "end_seconds": 259.32,
      "duration_seconds": 4.38,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.22,
      "end_seconds": 270.03,
      "duration_seconds": 7.81,
      "text": "thank you, you can get dressed. So where does that leave us? It fits best with harmless extra heartbeats"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.16,
      "end_seconds": 274.82,
      "duration_seconds": 3.66,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.58,
      "end_seconds": 297.11,
      "duration_seconds": 17.53,
      "text": "Nothing I've seen today points to an emergency. It looks like harmless extra heartbeats but I'd like to confirm. Let's get an ECG for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.44,
      "end_seconds": 306.68,
      "duration_seconds": 9.24,
      "text": "Right, right. If you faint or have chest pain, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.92,
      "end_seconds": 310.64,
      "duration_seconds": 2.72,
      "text": "okay I'll look out for that"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.69,
      "end_seconds": 316.04,
      "duration_seconds": 4.35,
      "text": "Let's plan a check if it carries on after a month."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.12,
      "end_seconds": 320.14,
      "duration_seconds": 2.02,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.68,
      "end_seconds": 324.6,
      "duration_seconds": 2.92,
      "text": "that's all from me any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.12,
      "end_seconds": 329.97,
      "duration_seconds": 3.85,
      "text": "right, I'll do that thank you, doctor"
    }
  ]
}