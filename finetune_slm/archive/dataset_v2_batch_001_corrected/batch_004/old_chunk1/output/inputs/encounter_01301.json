    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.37,
      "end_seconds": 116.22,
      "duration_seconds": 3.85,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.64,
      "end_seconds": 138.44,
      "duration_seconds": 4.8,
      "text": "did you get back pain, vaginal discharge or blood in the urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.43,
      "end_seconds": 142.57,
      "duration_seconds": 3.14,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.09,
      "end_seconds": 145.96,
      "duration_seconds": 2.87,
      "text": "Right right. Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.98,
      "end_seconds": 150.71,
      "duration_seconds": 2.73,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.8,
      "end_seconds": 155.78,
      "duration_seconds": 2.98,
      "text": "let's start with the the basic checks"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.39,
      "end_seconds": 172.38,
      "duration_seconds": 2.99,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.0,
      "end_seconds": 196.65,
      "duration_seconds": 13.65,
      "text": "Okay: height 155 centimetres, heart rate 66. And temperature is 36.9 degrees, BMI works out to 36.6, blood pressure 126 over 74, saturation 98 percent, weight 88 kilos, respiratory rate 16."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.5,
      "end_seconds": 201.62,
      "duration_seconds": 2.12,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.6,
      "end_seconds": 204.8,
      "duration_seconds": 2.2,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.59,
      "end_seconds": 228.71,
      "duration_seconds": 5.12,
      "text": "your tummy is soft with slight tenderness just above the pubic bone"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.8,
      "end_seconds": 235.42,
      "duration_seconds": 2.62,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.54,
      "end_seconds": 258.26,
      "duration_seconds": 6.72,
      "text": "from what you've told me and what I found, I'd lean towards an uncomplicated urinary infection"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.21,
      "end_seconds": 262.14,
      "duration_seconds": 1.93,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.08,
      "end_seconds": 299.5,
      "duration_seconds": 35.42,
      "text": "I understand the worry. At the moment I'd say it's an uncomplicated urinary infection, and we'll know more once the a urine dipstick is back. I'm going to order a urine dipstick, for burning urine. That will help us see what's going on underneath and decide the next step. I'll start you on nitrofurantoin, 100 milligrams, twice a day, three days. You take it by mouth. That should help with urinary infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.21,
      "end_seconds": 302.82,
      "duration_seconds": 1.61,
      "text": "Okay I understand."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.65,
      "end_seconds": 334.65,
      "duration_seconds": 30.0,
      "text": "Drink plenty of water and avoid holding urine. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please don't wait if you get a fever or back pain. That's when to be seen urgently. Come back if it is not better in three days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.28,
      "end_seconds": 340.56,
      "duration_seconds": 4.28,
      "text": "I mean I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.41,
      "end_seconds": 347.65,
      "duration_seconds": 1.24,
      "text": "take care now"
    }
  ]
