      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.03,
      "end_seconds": 94.64,
      "duration_seconds": 2.61,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.68,
      "end_seconds": 102.44,
      "duration_seconds": 1.76,
      "text": "so, and your job?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.48,
      "end_seconds": 107.02,
      "duration_seconds": 3.54,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.03,
      "end_seconds": 111.4,
      "duration_seconds": 2.37,
      "text": "do you follow any particular diet?"
