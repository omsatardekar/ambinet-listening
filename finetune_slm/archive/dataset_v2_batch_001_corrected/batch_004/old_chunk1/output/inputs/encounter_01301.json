    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.03,
      "end_seconds": 68.21,
      "duration_seconds": 3.18,
      "text": "I've had eczema for two years now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.96,
      "end_seconds": 80.48,
      "duration_seconds": 3.52,
      "text": "are you taking anything regularly including from the pharmacy?"
