      "role": "PATIENT",
      "start_seconds": 81.89,
      "end_seconds": 87.51,
      "duration_seconds": 5.62,
      "text": "Hydrocortisone cream when needed for the eczema. Cranberry juice daily."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.17,
      "end_seconds": 91.46,
      "duration_seconds": 2.29,
      "text": "Do you do any exercise?"
    },
