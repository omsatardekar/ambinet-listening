      "role": "DOCTOR",
      "start_seconds": 11.46,
      "end_seconds": 16.21,
      "duration_seconds": 4.75,
      "text": "right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.34,
      "end_seconds": 21.44,
      "duration_seconds": 4.1,
      "text": "Thyronorm. I take it 50 micrograms, every morning"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.03,
      "end_seconds": 29.2,
      "duration_seconds": 4.17,
      "text": "Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.76,
      "end_seconds": 33.02,
      "duration_seconds": 2.26,
      "text": "It's been four weeks now."
