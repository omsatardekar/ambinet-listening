    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.43,
      "end_seconds": 72.33,
      "duration_seconds": 2.9,
      "text": "anything different when you pass water?"
