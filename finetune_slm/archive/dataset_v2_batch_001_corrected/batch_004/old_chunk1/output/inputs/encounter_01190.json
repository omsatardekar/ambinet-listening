    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 82.93,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 88.05,
      "duration_seconds": 4.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 93.85,
      "duration_seconds": 4.54,
      "text": "No, you know, I'm not allergic to to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.4,
      "end_seconds": 99.83,
      "duration_seconds": 4.43,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.92,
      "end_seconds": 103.57,
      "duration_seconds": 2.65,
      "text": "My sister had breast cancer."
