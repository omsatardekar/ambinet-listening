    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.43,
      "end_seconds": 37.87,
      "duration_seconds": 3.44,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.45,
      "end_seconds": 48.05,
      "duration_seconds": 9.6,
      "text": "Okay, so it usually comes with slightly dry skin. The slightly dry skin? That's been for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.74,
      "end_seconds": 53.45,
      "duration_seconds": 3.71,
      "text": "A few quick ones: palpitations, constipation or weight change?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.11,
      "end_seconds": 59.48,
      "duration_seconds": 4.37,
      "text": "No palpitations, constipation or weight change, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.74,
      "end_seconds": 63.6,
      "duration_seconds": 3.86,
      "text": "Okay, go on. Has there been any feeling cold?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.5,
      "end_seconds": 67.73,
      "duration_seconds": 2.23,
      "text": "no no feeling cold"
