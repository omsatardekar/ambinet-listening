    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.89,
      "end_seconds": 77.65,
      "duration_seconds": 4.76,
      "text": "Um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.08,
      "end_seconds": 81.37,
      "duration_seconds": 2.29,
      "text": "is your chest okay generally?"
