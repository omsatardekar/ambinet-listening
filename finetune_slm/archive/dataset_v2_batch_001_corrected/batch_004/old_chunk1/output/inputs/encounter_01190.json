    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 107.73,
      "duration_seconds": 2.69,
      "text": "Have you had any previous surgeries?"
