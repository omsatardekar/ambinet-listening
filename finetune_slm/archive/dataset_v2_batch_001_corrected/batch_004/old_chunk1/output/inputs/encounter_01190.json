    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.34,
      "end_seconds": 112.66,
      "duration_seconds": 3.32,
      "text": "No, I've never been operated on."
