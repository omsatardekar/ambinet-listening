{
  "schema_version": "1.0",
  "encounter_id": "01013",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 5.22,
      "duration_seconds": 4.59,
      "text": "Hello, uh, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 10.32,
      "duration_seconds": 4.35,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.2,
      "end_seconds": 19.37,
      "duration_seconds": 7.17,
      "text": "Hello, um, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.29,
      "end_seconds": 24.84,
      "duration_seconds": 4.55,
      "text": "Alright, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.6,
      "end_seconds": 29.84,
      "duration_seconds": 4.24,
      "text": "Erm, we came because of shoulder tip pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.76,
      "end_seconds": 33.98,
      "duration_seconds": 3.22,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.73,
      "end_seconds": 41.47,
      "duration_seconds": 5.74,
      "text": "I take alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.5,
      "end_seconds": 49.64,
      "duration_seconds": 3.14,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.55,
      "end_seconds": 58.42,
      "duration_seconds": 7.87,
      "text": "For two years. I'm, I'm on aspirin, 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.13,
      "end_seconds": 61.96,
      "duration_seconds": 2.83,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.91,
      "end_seconds": 82.77,
      "duration_seconds": 15.86,
      "text": "Okay, uh, so pretty moderate, if I'm being honest. As for feeling faint, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.14,
      "end_seconds": 87.38,
      "duration_seconds": 4.24,
      "text": "Okay, go on. Has there been light vaginal bleeding too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.25,
      "end_seconds": 92.21,
      "duration_seconds": 2.96,
      "text": "Yes, uh, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.51,
      "end_seconds": 94.27,
      "duration_seconds": 1.76,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.41,
      "end_seconds": 118.92,
      "duration_seconds": 23.51,
      "text": "And there's sharp pain low on one side as well, about four days now. As for sharp pain low on one side, maybe a four out of ten on a bad day. It happens a few times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.62,
      "end_seconds": 123.76,
      "duration_seconds": 3.14,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.35,
      "end_seconds": 128.17,
      "duration_seconds": 3.82,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 129.43,
      "end_seconds": 134.89,
      "duration_seconds": 5.46,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.51,
      "end_seconds": 143.2,
      "duration_seconds": 7.69,
      "text": "Okay, so no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.85,
      "end_seconds": 153.0,
      "duration_seconds": 9.15,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you had vaginal discharge, by any chance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.54,
      "end_seconds": 157.72,
      "duration_seconds": 4.18,
      "text": "No, you know, none, no vaginal discharge."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.47,
      "end_seconds": 161.88,
      "duration_seconds": 2.41,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.56,
      "end_seconds": 164.67,
      "duration_seconds": 1.11,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.53,
      "end_seconds": 169.31,
      "duration_seconds": 2.78,
      "text": "Alright, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.95,
      "end_seconds": 172.98,
      "duration_seconds": 2.03,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.74,
      "end_seconds": 178.4,
      "duration_seconds": 3.66,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.67,
      "end_seconds": 186.51,
      "duration_seconds": 6.84,
      "text": "Right, my grandmother had dementia. Okay, so my sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.05,
      "end_seconds": 191.65,
      "duration_seconds": 4.6,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.36,
      "end_seconds": 204.16,
      "duration_seconds": 10.8,
      "text": "Yes, I work in a bakery, early starts. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.02,
      "end_seconds": 209.93,
      "duration_seconds": 3.91,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.77,
      "end_seconds": 214.81,
      "duration_seconds": 3.04,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 216.12,
      "end_seconds": 222.84,
      "duration_seconds": 6.72,
      "text": "I'm not sure that's right. I seem to recall a problem with diclofenac."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.63,
      "end_seconds": 226.55,
      "duration_seconds": 2.92,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.19,
      "end_seconds": 231.95,
      "duration_seconds": 4.76,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.7,
      "end_seconds": 247.61,
      "duration_seconds": 2.91,
      "text": "Alright, what about your medical history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.14,
      "end_seconds": 267.78,
      "duration_seconds": 18.64,
      "text": "Hmm, I've had thin bones for about ten years now. I've had heart disease, yes. I'm not great at remembering details, so bear with me. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.29,
      "end_seconds": 272.04,
      "duration_seconds": 3.75,
      "text": "Ah. Okay, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.87,
      "end_seconds": 278.32,
      "duration_seconds": 5.45,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.42,
      "end_seconds": 283.26,
      "duration_seconds": 3.84,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.61,
      "end_seconds": 294.09,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.31,
      "end_seconds": 313.65,
      "duration_seconds": 8.34,
      "text": "Okay: pulse is 121 beats a minute, blood pressure 137 over 79, temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.05,
      "end_seconds": 318.21,
      "duration_seconds": 3.16,
      "text": "Mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.76,
      "end_seconds": 322.53,
      "duration_seconds": 2.77,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.2,
      "end_seconds": 327.04,
      "duration_seconds": 2.84,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.23,
      "end_seconds": 330.03,
      "duration_seconds": 1.8,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.35,
      "end_seconds": 345.22,
      "duration_seconds": 5.87,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.57,
      "end_seconds": 353.48,
      "duration_seconds": 2.91,
      "text": "Right, you can sit up now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.98,
      "end_seconds": 381.69,
      "duration_seconds": 10.71,
      "text": "So where does that leave us? The most likely explanation is a possible ectopic pregnancy. A ruptured ovarian cyst is still possible."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.67,
      "end_seconds": 386.09,
      "duration_seconds": 2.42,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.78,
      "end_seconds": 398.1,
      "duration_seconds": 7.32,
      "text": "I can't promise yet, but most people with a possible ectopic pregnancy do well once it's treated properly."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.53,
      "end_seconds": 436.24,
      "duration_seconds": 28.71,
      "text": "I'm going to order an urgent pelvic scan, for possible ectopic. I'll request a pregnancy test, it'll help with pelvic pain and bleeding. You need to go to the hospital now for an emergency scan. Do get help quickly if the pain gets worse or you faint. I'd like you back straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 437.72,
      "end_seconds": 441.4,
      "duration_seconds": 3.68,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.92,
      "end_seconds": 443.1,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}