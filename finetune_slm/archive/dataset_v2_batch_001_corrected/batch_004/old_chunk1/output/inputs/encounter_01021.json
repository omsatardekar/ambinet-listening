{
  "schema_version": "1.0",
  "encounter_id": "01021",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 7.74,
      "duration_seconds": 6.53,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.63,
      "end_seconds": 12.84,
      "duration_seconds": 4.21,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.54,
      "end_seconds": 27.19,
      "duration_seconds": 12.65,
      "text": "It's crushing chest pain. I thought I'd wait, but it hasn't gone. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.4,
      "end_seconds": 30.35,
      "duration_seconds": 1.95,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.84,
      "end_seconds": 34.62,
      "duration_seconds": 2.78,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.11,
      "end_seconds": 39.47,
      "duration_seconds": 3.36,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.72,
      "end_seconds": 42.49,
      "duration_seconds": 1.77,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.51,
      "end_seconds": 47.61,
      "duration_seconds": 4.1,
      "text": "Have you had any fever, leg swelling or cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.62,
      "end_seconds": 53.2,
      "duration_seconds": 3.58,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.9,
      "end_seconds": 60.26,
      "duration_seconds": 5.36,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.39,
      "end_seconds": 63.34,
      "duration_seconds": 1.95,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.84,
      "end_seconds": 72.9,
      "duration_seconds": 4.06,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.31,
      "end_seconds": 78.09,
      "duration_seconds": 3.78,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.61,
      "end_seconds": 84.94,
      "duration_seconds": 6.33,
      "text": "Right, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.24,
      "end_seconds": 102.37,
      "duration_seconds": 16.13,
      "text": "I used to drink heavily but I stopped four years ago. My husband and I live above the shop. Not much, I mostly stay in these days. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.62,
      "end_seconds": 122.09,
      "duration_seconds": 2.47,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.48,
      "end_seconds": 129.71,
      "duration_seconds": 6.23,
      "text": "I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.56,
      "end_seconds": 133.77,
      "duration_seconds": 3.21,
      "text": "So, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.01,
      "end_seconds": 136.48,
      "duration_seconds": 1.47,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.0,
      "end_seconds": 146.13,
      "duration_seconds": 6.13,
      "text": "Do you have any long-term conditions? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.74,
      "end_seconds": 148.87,
      "duration_seconds": 2.13,
      "text": "I've got heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.2,
      "end_seconds": 151.01,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.66,
      "end_seconds": 165.26,
      "duration_seconds": 2.6,
      "text": "Okay, I'll do your observations first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.34,
      "end_seconds": 173.64,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.65,
      "end_seconds": 199.08,
      "duration_seconds": 8.43,
      "text": "Okay: pressure 115 over 85, temp 36.7 degrees, pulse is 106 beats a minute. And oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.8,
      "end_seconds": 204.19,
      "duration_seconds": 3.39,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.08,
      "end_seconds": 208.17,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.49,
      "end_seconds": 227.08,
      "duration_seconds": 4.59,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.04,
      "end_seconds": 233.08,
      "duration_seconds": 3.04,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 253.49,
      "duration_seconds": 11.89,
      "text": "Having listened and examined, it's hard to say. A possible heart attack is one possibility and unstable angina another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.49,
      "end_seconds": 257.42,
      "duration_seconds": 2.93,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.56,
      "end_seconds": 266.23,
      "duration_seconds": 7.67,
      "text": "I can't promise yet, but most people with a possible heart attack do well once it's treated properly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.46,
      "end_seconds": 306.21,
      "duration_seconds": 24.75,
      "text": "I'll request an ECG, it'll help with chest pain. I'm prescribing aspirin, 300 milligrams, once now, single dose. You take it by mouth. That should help with possible heart attack. Stay lying down and do not eat or drink. A troponin blood test is something we might do if this doesn't improve next month. Let's review you straight away."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.81,
      "end_seconds": 309.62,
      "duration_seconds": 1.81,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.05,
      "end_seconds": 316.37,
      "duration_seconds": 5.32,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.44,
      "end_seconds": 319.08,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.46,
      "end_seconds": 321.87,
      "duration_seconds": 1.41,
      "text": "See you soon."
    }
  ]
}