{
  "schema_version": "1.0",
  "encounter_id": "01138",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.56,
      "end_seconds": 6.33,
      "duration_seconds": 5.77,
      "text": "Right, thanks for waiting, come in. Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.41,
      "end_seconds": 18.95,
      "duration_seconds": 6.54,
      "text": "honestly, it's a sore ankle, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.8,
      "end_seconds": 23.96,
      "duration_seconds": 3.16,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.76,
      "end_seconds": 36.6,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.92,
      "end_seconds": 64.64,
      "duration_seconds": 13.72,
      "text": "okay: height 175 centimetres, pulse 71. And SpO2 97 percent on room air, pressure 116 over 78, temp 36.7 degrees, BMI works out to 29.7, weight 91 kilos"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.84,
      "end_seconds": 82.29,
      "duration_seconds": 3.45,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.34,
      "end_seconds": 90.22,
      "duration_seconds": 5.88,
      "text": "Probably about two weeks. Yeah. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.12,
      "end_seconds": 99.99,
      "duration_seconds": 8.87,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.67,
      "end_seconds": 111.46,
      "duration_seconds": 10.79,
      "text": "Pretty severe, if I'm being honest. Yes, walking. That makes it worse. Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.5,
      "end_seconds": 126.29,
      "duration_seconds": 5.79,
      "text": "Have you had any numbness, pain in the foot or crack or pop?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.13,
      "end_seconds": 133.7,
      "duration_seconds": 6.57,
      "text": "I haven't had numbness, pain in the foot or crack or pop, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.59,
      "end_seconds": 137.15,
      "duration_seconds": 2.56,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.01,
      "end_seconds": 144.39,
      "duration_seconds": 2.38,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.12,
      "end_seconds": 160.67,
      "duration_seconds": 2.55,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.06,
      "end_seconds": 166.46,
      "duration_seconds": 3.4,
      "text": "Ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.3,
      "end_seconds": 171.84,
      "duration_seconds": 3.54,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.93,
      "end_seconds": 177.0,
      "duration_seconds": 3.07,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.64,
      "end_seconds": 188.42,
      "duration_seconds": 3.78,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.98,
      "end_seconds": 191.78,
      "duration_seconds": 2.8,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.08,
      "end_seconds": 194.53,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.81,
      "end_seconds": 198.75,
      "duration_seconds": 2.94,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.76,
      "end_seconds": 204.55,
      "duration_seconds": 4.79,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.32,
      "end_seconds": 219.13,
      "duration_seconds": 13.81,
      "text": "I used to drink heavily but I stopped four years ago. My husband and I live above the shop. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.5,
      "end_seconds": 225.66,
      "duration_seconds": 4.16,
      "text": "Alright, over here please and and I'll take a look."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.36,
      "end_seconds": 228.53,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.37,
      "end_seconds": 255.58,
      "duration_seconds": 8.21,
      "text": "there's mild swelling over the outside of the ankle, and you can put your weight on it"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.65,
      "end_seconds": 284.32,
      "duration_seconds": 26.67,
      "text": "That's the examination finished. Okay, thinking it through, it fits best with a mild ankle sprain. I want to be honest that this is an impression, not a final answer. Rest, ice, a compression bandage and keep it raised for two days. Do get help quickly if you cannot put weight on it. See me again if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.08,
      "end_seconds": 298.07,
      "duration_seconds": 7.99,
      "text": "Tell me what you've taken from all that, so so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.68,
      "end_seconds": 307.04,
      "duration_seconds": 8.36,
      "text": "So, I come back if it is not better in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.84,
      "end_seconds": 312.17,
      "duration_seconds": 4.33,
      "text": "Yes, exactly right. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.9,
      "end_seconds": 316.68,
      "duration_seconds": 2.78,
      "text": "I think I understand everything. Thanks."
    }
  ]
}