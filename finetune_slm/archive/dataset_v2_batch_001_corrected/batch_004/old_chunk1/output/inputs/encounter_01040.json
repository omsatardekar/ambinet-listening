{
  "schema_version": "1.0",
  "encounter_id": "01040",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.9,
      "end_seconds": 2.53,
      "duration_seconds": 1.63,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.01,
      "end_seconds": 8.75,
      "duration_seconds": 4.74,
      "text": "of course, leave it it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.53,
      "end_seconds": 16.85,
      "duration_seconds": 6.32,
      "text": "So, honestly, it's a muffled voice, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.77,
      "end_seconds": 22.48,
      "duration_seconds": 3.71,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.01,
      "end_seconds": 25.95,
      "duration_seconds": 2.94,
      "text": "for about three months, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.61,
      "end_seconds": 30.39,
      "duration_seconds": 2.78,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.1,
      "end_seconds": 45.95,
      "duration_seconds": 14.85,
      "text": "Mostly severe. I've also had noisy breathing, for six months. As for noisy breathing, I notice it more with lying flat. It settles a little with sitting forward."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.02,
      "end_seconds": 50.42,
      "duration_seconds": 2.4,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.05,
      "end_seconds": 53.35,
      "duration_seconds": 2.3,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.92,
      "end_seconds": 56.84,
      "duration_seconds": 2.92,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.64,
      "end_seconds": 68.61,
      "duration_seconds": 10.97,
      "text": "No, I share a house with my brother. I grab fast food at lunch most days. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.67,
      "end_seconds": 74.56,
      "duration_seconds": 3.89,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.29,
      "end_seconds": 78.9,
      "duration_seconds": 3.61,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.16,
      "end_seconds": 84.88,
      "duration_seconds": 4.72,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.76,
      "end_seconds": 90.49,
      "duration_seconds": 3.73,
      "text": "Hmm, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.3,
      "end_seconds": 102.73,
      "duration_seconds": 2.43,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.78,
      "end_seconds": 106.0,
      "duration_seconds": 1.22,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.34,
      "end_seconds": 118.05,
      "duration_seconds": 2.71,
      "text": "did you get cough or rash?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.89,
      "end_seconds": 122.78,
      "duration_seconds": 2.89,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.16,
      "end_seconds": 127.73,
      "duration_seconds": 4.57,
      "text": "right, right. Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.92,
      "end_seconds": 130.6,
      "duration_seconds": 1.68,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 134.53,
      "duration_seconds": 2.48,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.04,
      "end_seconds": 140.75,
      "duration_seconds": 4.71,
      "text": "Okay, so that's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.81,
      "end_seconds": 153.98,
      "duration_seconds": 4.17,
      "text": "okay, time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.23,
      "end_seconds": 164.29,
      "duration_seconds": 2.06,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.16,
      "end_seconds": 189.83,
      "duration_seconds": 5.67,
      "text": "okay: oxygen saturation is 89 percent, pressure 123 over 78, heart rate 102."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.84,
      "end_seconds": 193.39,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.61,
      "end_seconds": 198.52,
      "duration_seconds": 3.91,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.22,
      "end_seconds": 204.9,
      "duration_seconds": 4.68,
      "text": "alright, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.37,
      "end_seconds": 209.3,
      "duration_seconds": 2.93,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.71,
      "end_seconds": 228.01,
      "duration_seconds": 4.3,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.46,
      "end_seconds": 235.31,
      "duration_seconds": 1.85,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.87,
      "end_seconds": 281.47,
      "duration_seconds": 32.6,
      "text": "From what you've told me and what I found, this looks most like a possible airway infection that needs emergency care. An urgent airway assessment is what I'd like next, for stridor and drooling. Do not lie flat, I am calling an ambulance now. We'll refer you to the emergency ENT team. Keep an eye out, and if the breathing gets harder, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.33,
      "end_seconds": 285.25,
      "duration_seconds": 1.92,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.02,
      "end_seconds": 288.78,
      "duration_seconds": 1.76,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.49,
      "end_seconds": 291.77,
      "duration_seconds": 2.28,
      "text": "good, I'll return then"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.4,
      "end_seconds": 297.6,
      "duration_seconds": 5.2,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.87,
      "end_seconds": 303.15,
      "duration_seconds": 4.28,
      "text": "so, I come back straight away is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.05,
      "end_seconds": 309.23,
      "duration_seconds": 4.18,
      "text": "yes, exactly right that's all from me any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.15,
      "end_seconds": 313.49,
      "duration_seconds": 3.34,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.48,
      "end_seconds": 315.92,
      "duration_seconds": 1.44,
      "text": "goodbye for now"
    }
  ]
}