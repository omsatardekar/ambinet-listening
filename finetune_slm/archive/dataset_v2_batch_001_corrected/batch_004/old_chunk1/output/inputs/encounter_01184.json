{
  "schema_version": "1.0",
  "encounter_id": "01184",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.96,
      "duration_seconds": 4.17,
      "text": "Morning, uh, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.87,
      "end_seconds": 11.78,
      "duration_seconds": 4.91,
      "text": "okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.38,
      "end_seconds": 21.58,
      "duration_seconds": 8.2,
      "text": "Um, so... skipped beats. That's why I came. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.43,
      "end_seconds": 25.58,
      "duration_seconds": 3.15,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.54,
      "end_seconds": 34.15,
      "duration_seconds": 6.61,
      "text": "Um, I take febuxostat, 80 milligrams, once a day for the gout."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.01,
      "end_seconds": 42.2,
      "duration_seconds": 3.19,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.56,
      "end_seconds": 46.9,
      "duration_seconds": 3.34,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.51,
      "end_seconds": 51.61,
      "duration_seconds": 3.1,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.37,
      "end_seconds": 55.65,
      "duration_seconds": 3.28,
      "text": "a six out of ten, I suppose"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.98,
      "end_seconds": 56.78,
      "duration_seconds": 0.8,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.32,
      "end_seconds": 63.76,
      "duration_seconds": 6.44,
      "text": "Mm, and there's being a bit anxious as well, two days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.89,
      "end_seconds": 80.28,
      "duration_seconds": 3.39,
      "text": "Any fainting, chest pain or dizziness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.59,
      "end_seconds": 85.95,
      "duration_seconds": 4.36,
      "text": "I haven't had fainting, chest pain or dizziness, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.21,
      "end_seconds": 89.79,
      "duration_seconds": 3.58,
      "text": "hm, okay any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.32,
      "end_seconds": 94.1,
      "duration_seconds": 2.78,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.1,
      "end_seconds": 99.02,
      "duration_seconds": 2.92,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.96,
      "end_seconds": 103.13,
      "duration_seconds": 2.17,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.0,
      "end_seconds": 107.73,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.04,
      "end_seconds": 111.07,
      "duration_seconds": 2.03,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.69,
      "end_seconds": 127.78,
      "duration_seconds": 3.09,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.61,
      "end_seconds": 132.67,
      "duration_seconds": 4.06,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.05,
      "end_seconds": 136.37,
      "duration_seconds": 2.32,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.09,
      "end_seconds": 140.78,
      "duration_seconds": 3.69,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.86,
      "end_seconds": 147.38,
      "duration_seconds": 4.52,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.77,
      "end_seconds": 156.93,
      "duration_seconds": 8.16,
      "text": "yeah, I was told I'm allergic to grass pollen, but I don't remember what reaction I had"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.46,
      "end_seconds": 160.14,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.15,
      "end_seconds": 163.86,
      "duration_seconds": 2.71,
      "text": "Well, I've had gout, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.05,
      "end_seconds": 168.51,
      "duration_seconds": 3.46,
      "text": "Ah. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.78,
      "end_seconds": 180.37,
      "duration_seconds": 2.59,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.8,
      "end_seconds": 211.61,
      "duration_seconds": 9.81,
      "text": "Okay: respiratory rate 18, temp 36.6 degrees, SpO2 97 percent on room air, pulse 64, pressure 128 over 82."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.43,
      "end_seconds": 216.39,
      "duration_seconds": 1.96,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.87,
      "end_seconds": 219.5,
      "duration_seconds": 1.63,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.24,
      "end_seconds": 222.54,
      "duration_seconds": 1.3,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.79,
      "end_seconds": 241.39,
      "duration_seconds": 4.6,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.23,
      "end_seconds": 243.17,
      "duration_seconds": 0.94,
      "text": "of course"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.11,
      "end_seconds": 249.52,
      "duration_seconds": 2.41,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.84,
      "end_seconds": 268.01,
      "duration_seconds": 4.17,
      "text": "Okay, thinking it through, this is probably harmless extra heartbeats."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.49,
      "end_seconds": 273.28,
      "duration_seconds": 3.79,
      "text": "Um, you know, will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.37,
      "end_seconds": 282.75,
      "duration_seconds": 8.38,
      "text": "Nothing I've seen today points to an emergency. It looks like harmless extra heartbeats, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.5,
      "end_seconds": 301.0,
      "duration_seconds": 3.5,
      "text": "Let's book an ECG to look into palpitations."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.52,
      "end_seconds": 303.87,
      "duration_seconds": 2.35,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.39,
      "end_seconds": 331.74,
      "duration_seconds": 27.35,
      "text": "Cut back on coffee and energy drinks and keep a diary of when it happens. Cut down on salt and fried food for now, it really does make a difference. If you faint or have chest pain, or you feel really unwell, please come to the emergency department. Let's plan a check if it carries on after a month."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.32,
      "end_seconds": 334.38,
      "duration_seconds": 2.06,
      "text": "okay, I'll arrange it"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.09,
      "end_seconds": 342.68,
      "duration_seconds": 7.59,
      "text": "can you tell me the plan back in your own words, so so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.74,
      "end_seconds": 350.24,
      "duration_seconds": 6.5,
      "text": "So, I come back if it carries on after a month. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.12,
      "end_seconds": 357.84,
      "duration_seconds": 5.72,
      "text": "yes, exactly right that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.54,
      "end_seconds": 362.69,
      "duration_seconds": 3.15,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.41,
      "end_seconds": 366.08,
      "duration_seconds": 1.67,
      "text": "alright, goodbye for now"
    }
  ]
}