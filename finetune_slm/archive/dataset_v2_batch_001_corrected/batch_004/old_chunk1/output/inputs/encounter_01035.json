{
  "schema_version": "1.0",
  "encounter_id": "01035",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 5.78,
      "duration_seconds": 5.12,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.58,
      "end_seconds": 10.53,
      "duration_seconds": 3.95,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 15.68,
      "duration_seconds": 1.93,
      "text": "It's skipped beats, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.24,
      "end_seconds": 18.41,
      "duration_seconds": 1.17,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.89,
      "end_seconds": 22.12,
      "duration_seconds": 2.23,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.96,
      "end_seconds": 28.08,
      "duration_seconds": 4.12,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 31.14,
      "duration_seconds": 0.97,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.06,
      "end_seconds": 38.05,
      "duration_seconds": 4.99,
      "text": "A few quick ones: shortness of breath, fainting, dizziness or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.71,
      "end_seconds": 41.56,
      "duration_seconds": 2.85,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.23,
      "end_seconds": 44.36,
      "duration_seconds": 2.13,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.83,
      "end_seconds": 48.16,
      "duration_seconds": 2.33,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.14,
      "end_seconds": 53.91,
      "duration_seconds": 3.77,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.62,
      "end_seconds": 59.35,
      "duration_seconds": 3.73,
      "text": "Milk. I come out in... well, stomach cramps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.23,
      "end_seconds": 75.5,
      "duration_seconds": 2.27,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.33,
      "end_seconds": 80.27,
      "duration_seconds": 2.94,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.09,
      "end_seconds": 85.31,
      "duration_seconds": 4.22,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 87.68,
      "duration_seconds": 1.55,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.54,
      "end_seconds": 94.25,
      "duration_seconds": 1.71,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.04,
      "end_seconds": 99.54,
      "duration_seconds": 3.5,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.55,
      "end_seconds": 109.73,
      "duration_seconds": 2.18,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.75,
      "end_seconds": 116.56,
      "duration_seconds": 2.81,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.52,
      "end_seconds": 119.41,
      "duration_seconds": 1.89,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.94,
      "end_seconds": 123.7,
      "duration_seconds": 3.76,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.93,
      "end_seconds": 134.64,
      "duration_seconds": 3.71,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.28,
      "end_seconds": 146.08,
      "duration_seconds": 2.8,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.68,
      "end_seconds": 174.1,
      "duration_seconds": 11.42,
      "text": "Okay: pulse is 64 beats a minute, BP is 120 over 75, SpO2 99 percent on room air, temperature 36.8, respiratory rate 14."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 179.66,
      "duration_seconds": 3.3,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.66,
      "end_seconds": 183.15,
      "duration_seconds": 2.49,
      "text": "So, tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 201.91,
      "duration_seconds": 4.09,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.6,
      "end_seconds": 214.94,
      "duration_seconds": 7.34,
      "text": "You can relax now. Okay, thinking it through, this looks most like harmless extra heartbeats."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.82,
      "end_seconds": 219.97,
      "duration_seconds": 3.15,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.85,
      "end_seconds": 243.2,
      "duration_seconds": 21.35,
      "text": "I understand the worry. At the moment I'd say it's harmless extra heartbeats, and we'll know more once the an ECG is back. Stop me if I've got anything wrong. You've had skipped beats for five days, mild, and no fainting or dizziness."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.01,
      "end_seconds": 248.98,
      "duration_seconds": 1.97,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.91,
      "end_seconds": 289.31,
      "duration_seconds": 32.4,
      "text": "An ECG is what I'd like next, for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please don't wait if you faint or have chest pain. That's when to be seen urgently. I'll want another look if it carries on after a month."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.09,
      "end_seconds": 297.97,
      "duration_seconds": 2.88,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.91,
      "end_seconds": 302.04,
      "duration_seconds": 3.13,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}