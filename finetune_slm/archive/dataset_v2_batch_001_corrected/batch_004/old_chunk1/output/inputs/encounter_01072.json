{
  "schema_version": "1.0",
  "encounter_id": "01072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.98,
      "end_seconds": 5.32,
      "duration_seconds": 4.34,
      "text": "morning, doctor. I've settled them in, ready when you are"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.58,
      "end_seconds": 13.06,
      "duration_seconds": 3.48,
      "text": "okay, thanks hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.96,
      "end_seconds": 20.19,
      "duration_seconds": 5.23,
      "text": "Yeah, it's bloating after meals. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.16,
      "end_seconds": 24.6,
      "duration_seconds": 3.44,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.67,
      "end_seconds": 29.27,
      "duration_seconds": 2.6,
      "text": "for two weeks, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.12,
      "end_seconds": 39.5,
      "duration_seconds": 8.38,
      "text": "can you describe it a bit more for me? How strong it is what the pattern is what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.7,
      "end_seconds": 53.2,
      "duration_seconds": 7.5,
      "text": "A four out of ten I suppose. It's worse with fizzy drinks and large meals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.48,
      "end_seconds": 59.0,
      "duration_seconds": 4.52,
      "text": "What about loose stools now and then, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.55,
      "end_seconds": 73.51,
      "duration_seconds": 13.96,
      "text": "Yes, for about three months. Ah, I've also had a lot of wind, since last Tuesday. As for lot of wind, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.98,
      "end_seconds": 80.84,
      "duration_seconds": 5.86,
      "text": "So, have you had bloating after meals before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.41,
      "end_seconds": 86.51,
      "duration_seconds": 5.1,
      "text": "a a bit, last year. It settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.28,
      "end_seconds": 103.64,
      "duration_seconds": 5.36,
      "text": "have you noticed weight loss vomiting or blood in the stool?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.53,
      "end_seconds": 108.29,
      "duration_seconds": 2.76,
      "text": "No I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.85,
      "end_seconds": 111.84,
      "duration_seconds": 2.99,
      "text": "alright, any sign of night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.51,
      "end_seconds": 116.19,
      "duration_seconds": 2.68,
      "text": "I haven't noticed any night-time diarrhoea"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.17,
      "end_seconds": 120.66,
      "duration_seconds": 2.49,
      "text": "is your urine normal no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.48,
      "end_seconds": 126.4,
      "duration_seconds": 3.92,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.38,
      "end_seconds": 131.77,
      "duration_seconds": 3.39,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.86,
      "end_seconds": 136.18,
      "duration_seconds": 2.32,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.59,
      "end_seconds": 141.18,
      "duration_seconds": 3.59,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.82,
      "end_seconds": 148.21,
      "duration_seconds": 5.39,
      "text": "Yes anxiety. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.34,
      "end_seconds": 153.05,
      "duration_seconds": 3.71,
      "text": "Alright, anxiety, that matches what I have here."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.43,
      "end_seconds": 165.11,
      "duration_seconds": 3.68,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.63,
      "end_seconds": 168.6,
      "duration_seconds": 2.97,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.36,
      "end_seconds": 175.71,
      "duration_seconds": 2.35,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.75,
      "end_seconds": 192.4,
      "duration_seconds": 11.65,
      "text": "No, I share a house with my brother. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.45,
      "end_seconds": 198.51,
      "duration_seconds": 4.06,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 200.25,
      "end_seconds": 203.26,
      "duration_seconds": 3.01,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.54,
      "end_seconds": 208.1,
      "duration_seconds": 3.56,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.44,
      "end_seconds": 212.98,
      "duration_seconds": 3.54,
      "text": "Escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.06,
      "end_seconds": 219.83,
      "duration_seconds": 4.77,
      "text": "have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.9,
      "end_seconds": 224.52,
      "duration_seconds": 3.62,
      "text": "not with me. I'll bring it next time"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 228.5,
      "end_seconds": 239.34,
      "duration_seconds": 10.84,
      "text": "okay so the vitals from earlier. Weight 81 kilos pulse 69. BMI works out to 23.4 pressure 118 over 68 height 186 centimetres saturation 97 percent"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.08,
      "end_seconds": 241.06,
      "duration_seconds": 0.98,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.56,
      "end_seconds": 246.01,
      "duration_seconds": 2.45,
      "text": "Right, shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.76,
      "end_seconds": 250.08,
      "duration_seconds": 2.32,
      "text": "okay, does that that hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.82,
      "end_seconds": 267.34,
      "duration_seconds": 5.52,
      "text": "your tummy is soft and not tender, and I can't feel any lumps"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.52,
      "end_seconds": 272.31,
      "duration_seconds": 1.79,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.13,
      "end_seconds": 288.4,
      "duration_seconds": 7.27,
      "text": "putting it all together this is probably a functional bowel pattern, with no alarm features"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 289.39,
      "end_seconds": 292.51,
      "duration_seconds": 3.12,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.33,
      "end_seconds": 316.56,
      "duration_seconds": 22.23,
      "text": "nothing I've seen today points to an emergency. It looks like a functional bowel pattern, with no alarm features. Try smaller meals and keep a food and symptom diary for four weeks. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 318.56,
      "end_seconds": 321.78,
      "duration_seconds": 3.22,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.68,
      "end_seconds": 326.85,
      "duration_seconds": 3.17,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.9,
      "end_seconds": 332.89,
      "duration_seconds": 2.99,
      "text": "I think I understand everything. Thanks."
    }
  ]
}