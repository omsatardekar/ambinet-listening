{
  "schema_version": "1.0",
  "encounter_id": "01131",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.77,
      "duration_seconds": 3.95,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.26,
      "end_seconds": 10.23,
      "duration_seconds": 3.97,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.73,
      "end_seconds": 20.64,
      "duration_seconds": 9.91,
      "text": "It's burning when I pass urine. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.75,
      "end_seconds": 24.73,
      "duration_seconds": 2.98,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.63,
      "end_seconds": 33.22,
      "duration_seconds": 6.59,
      "text": "So, around four weeks... no wait, it's more like two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.75,
      "end_seconds": 35.89,
      "duration_seconds": 2.14,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.07,
      "end_seconds": 42.02,
      "duration_seconds": 2.95,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.55,
      "end_seconds": 47.36,
      "duration_seconds": 3.81,
      "text": "Have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.74,
      "end_seconds": 56.19,
      "duration_seconds": 4.45,
      "text": "Yes, you know, about the same, four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.79,
      "end_seconds": 60.9,
      "duration_seconds": 3.11,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.88,
      "end_seconds": 77.35,
      "duration_seconds": 15.47,
      "text": "Right, about a eight out of ten. I've also had a dull ache low in my tummy. With dull ache low in my tummy, it's once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 97.89,
      "duration_seconds": 4.0,
      "text": "And what about back pain, fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.66,
      "end_seconds": 104.13,
      "duration_seconds": 5.47,
      "text": "No, uh, no back pain, fever or vaginal discharge."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.71,
      "end_seconds": 109.26,
      "duration_seconds": 4.55,
      "text": "Hm, okay. Has there been any blood in the urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.06,
      "end_seconds": 114.69,
      "duration_seconds": 3.63,
      "text": "Definitely no blood in the urine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.62,
      "end_seconds": 117.83,
      "duration_seconds": 2.21,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.76,
      "end_seconds": 122.03,
      "duration_seconds": 2.27,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.71,
      "end_seconds": 128.46,
      "duration_seconds": 3.75,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.24,
      "end_seconds": 131.81,
      "duration_seconds": 2.57,
      "text": "Heart failure, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.71,
      "end_seconds": 138.76,
      "duration_seconds": 5.05,
      "text": "Okay, I can see heart failure in your file as well."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.79,
      "end_seconds": 155.98,
      "duration_seconds": 5.19,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.16,
      "end_seconds": 160.91,
      "duration_seconds": 3.75,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.06,
      "end_seconds": 164.4,
      "duration_seconds": 2.34,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.34,
      "end_seconds": 187.43,
      "duration_seconds": 22.09,
      "text": "I gave up cigarettes last spring. I only drink at family occasions. Not much, I mostly stay in these days. I grab fast food at lunch most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.12,
      "end_seconds": 192.74,
      "duration_seconds": 4.62,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.35,
      "end_seconds": 196.58,
      "duration_seconds": 3.23,
      "text": "Furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.08,
      "end_seconds": 200.78,
      "duration_seconds": 3.7,
      "text": "Right, right. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.38,
      "end_seconds": 206.67,
      "duration_seconds": 4.29,
      "text": "Just my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.76,
      "end_seconds": 226.85,
      "duration_seconds": 3.09,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.96,
      "end_seconds": 239.91,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.29,
      "end_seconds": 266.14,
      "duration_seconds": 8.85,
      "text": "Okay: respiratory rate 17, temperature is 36.6 degrees, saturation 97 percent, BP is 124 over 81, heart rate 82."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.75,
      "end_seconds": 268.28,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.96,
      "end_seconds": 272.31,
      "duration_seconds": 2.35,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.6,
      "end_seconds": 276.33,
      "duration_seconds": 2.73,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.83,
      "end_seconds": 278.96,
      "duration_seconds": 1.13,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.79,
      "end_seconds": 282.98,
      "duration_seconds": 2.19,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.65,
      "end_seconds": 305.51,
      "duration_seconds": 4.86,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.05,
      "end_seconds": 309.3,
      "duration_seconds": 3.25,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.07,
      "end_seconds": 321.36,
      "duration_seconds": 8.29,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. This looks most like an uncomplicated urinary infection."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.19,
      "end_seconds": 327.17,
      "duration_seconds": 3.98,
      "text": "Erm, you know, will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.87,
      "end_seconds": 339.47,
      "duration_seconds": 10.6,
      "text": "Nothing I've seen today points to an emergency. It looks like an uncomplicated urinary infection. Drink plenty of water and avoid holding urine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.84,
      "end_seconds": 346.96,
      "duration_seconds": 6.12,
      "text": "Do I need a urine dipstick? I read it might help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.15,
      "end_seconds": 359.5,
      "duration_seconds": 6.35,
      "text": "Not right now, it wouldn't change what we do today. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.93,
      "end_seconds": 365.42,
      "duration_seconds": 4.49,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.75,
      "end_seconds": 367.94,
      "duration_seconds": 1.19,
      "text": "All the best."
    }
  ]
}