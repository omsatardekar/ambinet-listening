{
  "schema_version": "1.0",
  "encounter_id": "01253",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 4.24,
      "duration_seconds": 2.9,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.42,
      "end_seconds": 9.19,
      "duration_seconds": 3.77,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.91,
      "end_seconds": 14.91,
      "duration_seconds": 4.0,
      "text": "I wanted to get difficulty swallowing looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.81,
      "end_seconds": 17.56,
      "duration_seconds": 1.75,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.35,
      "end_seconds": 25.61,
      "duration_seconds": 3.26,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.59,
      "end_seconds": 33.95,
      "duration_seconds": 3.36,
      "text": "Okay, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.78,
      "end_seconds": 37.63,
      "duration_seconds": 2.85,
      "text": "So, it feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.65,
      "end_seconds": 41.62,
      "duration_seconds": 1.97,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.09,
      "end_seconds": 50.32,
      "duration_seconds": 5.23,
      "text": "A muffled voice goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.44,
      "end_seconds": 54.77,
      "duration_seconds": 3.33,
      "text": "A few quick ones: cough or rash?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.0,
      "end_seconds": 58.03,
      "duration_seconds": 2.03,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.82,
      "end_seconds": 64.08,
      "duration_seconds": 4.26,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.23,
      "end_seconds": 67.19,
      "duration_seconds": 1.96,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.42,
      "end_seconds": 85.76,
      "duration_seconds": 2.34,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.86,
      "end_seconds": 90.76,
      "duration_seconds": 3.9,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.58,
      "end_seconds": 94.45,
      "duration_seconds": 1.87,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.55,
      "end_seconds": 99.23,
      "duration_seconds": 3.68,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.74,
      "end_seconds": 106.66,
      "duration_seconds": 2.92,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.8,
      "end_seconds": 113.0,
      "duration_seconds": 5.2,
      "text": "Ah, I have an irregular heartbeat, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.32,
      "end_seconds": 124.18,
      "duration_seconds": 9.86,
      "text": "Yes, an irregular heartbeat is known to us, good to have that clear. Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.77,
      "end_seconds": 127.1,
      "duration_seconds": 2.33,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.43,
      "end_seconds": 132.61,
      "duration_seconds": 4.18,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.42,
      "end_seconds": 135.82,
      "duration_seconds": 2.4,
      "text": "It's bisoprolol, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 138.45,
      "duration_seconds": 2.02,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.51,
      "end_seconds": 144.16,
      "duration_seconds": 4.65,
      "text": "2.5 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.3,
      "end_seconds": 159.52,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.34,
      "end_seconds": 162.35,
      "duration_seconds": 1.01,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.4,
      "end_seconds": 169.27,
      "duration_seconds": 4.87,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.58,
      "end_seconds": 172.44,
      "duration_seconds": 1.86,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.26,
      "end_seconds": 177.84,
      "duration_seconds": 3.58,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.83,
      "end_seconds": 181.61,
      "duration_seconds": 1.78,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.96,
      "end_seconds": 185.24,
      "duration_seconds": 2.28,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.97,
      "end_seconds": 198.19,
      "duration_seconds": 4.22,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.5,
      "end_seconds": 203.98,
      "duration_seconds": 2.48,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.92,
      "end_seconds": 224.55,
      "duration_seconds": 11.63,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be a possible airway infection that needs emergency care, or it might be severe tonsillitis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.57,
      "end_seconds": 230.52,
      "duration_seconds": 4.95,
      "text": "Sorry, what was I saying, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.17,
      "end_seconds": 245.01,
      "duration_seconds": 13.84,
      "text": "I understand the worry. At the moment I'd say it's a possible airway infection that needs emergency care, and we'll know more once the an urgent airway assessment is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.93,
      "end_seconds": 264.0,
      "duration_seconds": 6.07,
      "text": "I think an urgent airway assessment makes sense here, for stridor and drooling."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.78,
      "end_seconds": 268.0,
      "duration_seconds": 2.22,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.37,
      "end_seconds": 287.69,
      "duration_seconds": 16.32,
      "text": "Do not lie flat, I am calling an ambulance now. The emergency ENT team would be the right next step, I'll refer you. The thing that would worry me is if the breathing gets harder. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.6,
      "end_seconds": 291.25,
      "duration_seconds": 1.65,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.14,
      "end_seconds": 297.81,
      "duration_seconds": 4.67,
      "text": "Let's review you straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.5,
      "end_seconds": 302.38,
      "duration_seconds": 2.88,
      "text": "Great, thank you for your help."
    }
  ]
}