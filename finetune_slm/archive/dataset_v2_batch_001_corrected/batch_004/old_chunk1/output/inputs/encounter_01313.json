{
  "schema_version": "1.0",
  "encounter_id": "01313",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 5.44,
      "duration_seconds": 4.82,
      "text": "Hello, come in. Mind the step. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.72,
      "end_seconds": 14.68,
      "duration_seconds": 7.96,
      "text": "Honestly, it's a tight band around my head, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.51,
      "end_seconds": 19.08,
      "duration_seconds": 3.57,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.34,
      "end_seconds": 22.43,
      "duration_seconds": 2.09,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.8,
      "end_seconds": 28.67,
      "duration_seconds": 5.87,
      "text": "Ah. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.55,
      "end_seconds": 41.16,
      "duration_seconds": 10.61,
      "text": "Only a warm shower and a walk, and it's not much. Stress definitely sets it off. Oh, and tired eyes."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.59,
      "end_seconds": 45.28,
      "duration_seconds": 2.69,
      "text": "Any a stiff neck as well?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.24,
      "end_seconds": 56.42,
      "duration_seconds": 9.18,
      "text": "Yeah. Four weeks, I'd say. With stiff neck, about a four out of ten. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.88,
      "end_seconds": 64.8,
      "duration_seconds": 6.92,
      "text": "Have you had a tight band around your head before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.82,
      "end_seconds": 72.25,
      "duration_seconds": 5.43,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.52,
      "end_seconds": 90.08,
      "duration_seconds": 3.56,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.28,
      "end_seconds": 103.89,
      "duration_seconds": 2.61,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.64,
      "end_seconds": 131.94,
      "duration_seconds": 7.3,
      "text": "Okay: saturation 98 percent, pressure 118 over 82, temperature 36.5, pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.01,
      "end_seconds": 135.57,
      "duration_seconds": 1.56,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.09,
      "end_seconds": 143.54,
      "duration_seconds": 3.45,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.8,
      "end_seconds": 149.61,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.94,
      "end_seconds": 152.34,
      "duration_seconds": 1.4,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.84,
      "end_seconds": 166.93,
      "duration_seconds": 6.09,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.05,
      "end_seconds": 180.74,
      "duration_seconds": 8.69,
      "text": "All finished, thank you. Let me check a few things. Any blurred vision, weakness or sensitivity to light?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.61,
      "end_seconds": 191.62,
      "duration_seconds": 6.01,
      "text": "I haven't had blurred vision, weakness or sensitivity to light, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.88,
      "end_seconds": 198.34,
      "duration_seconds": 2.46,
      "text": "And sickness, any of that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.96,
      "end_seconds": 202.18,
      "duration_seconds": 3.22,
      "text": "No, I haven't had any sickness."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.15,
      "end_seconds": 205.91,
      "duration_seconds": 1.76,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.97,
      "end_seconds": 209.59,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.37,
      "end_seconds": 214.52,
      "duration_seconds": 4.15,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.01,
      "end_seconds": 219.08,
      "duration_seconds": 3.07,
      "text": "Erm, I've had depression, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.97,
      "end_seconds": 230.99,
      "duration_seconds": 11.02,
      "text": "Mm, okay. Right, so depression is already on your record. We'll keep that in mind today. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.33,
      "end_seconds": 237.27,
      "duration_seconds": 4.94,
      "text": "Erm, I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.4,
      "end_seconds": 253.8,
      "duration_seconds": 3.4,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.84,
      "end_seconds": 265.03,
      "duration_seconds": 7.19,
      "text": "I'm on mirtazapine, 15 milligrams, at night for my mood. Paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.57,
      "end_seconds": 267.92,
      "duration_seconds": 1.35,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.92,
      "end_seconds": 272.58,
      "duration_seconds": 3.66,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.55,
      "end_seconds": 275.79,
      "duration_seconds": 1.24,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.55,
      "end_seconds": 280.96,
      "duration_seconds": 4.41,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.03,
      "end_seconds": 285.1,
      "duration_seconds": 2.07,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.99,
      "end_seconds": 290.12,
      "duration_seconds": 4.13,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.08,
      "end_seconds": 294.67,
      "duration_seconds": 3.59,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.89,
      "end_seconds": 299.79,
      "duration_seconds": 3.9,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.8,
      "end_seconds": 306.6,
      "duration_seconds": 5.8,
      "text": "From what you've told me and what I found, I'd lean towards tension-type headache."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.26,
      "end_seconds": 332.65,
      "duration_seconds": 8.39,
      "text": "I'm sending you for an eye test because of eye strain. Take screen breaks every hour and try regular neck stretches."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.19,
      "end_seconds": 340.88,
      "duration_seconds": 7.69,
      "text": "I see, go ahead. Come back or go to emergency straight away if the headache becomes sudden and severe."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.78,
      "end_seconds": 344.93,
      "duration_seconds": 2.15,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.4,
      "end_seconds": 349.28,
      "duration_seconds": 2.88,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.99,
      "end_seconds": 354.5,
      "duration_seconds": 4.51,
      "text": "Let me think, great, thank you for your help."
    }
  ]
}