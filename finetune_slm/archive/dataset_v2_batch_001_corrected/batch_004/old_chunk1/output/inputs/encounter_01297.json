{
  "schema_version": "1.0",
  "encounter_id": "01297",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.36,
      "end_seconds": 6.53,
      "duration_seconds": 5.17,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.17,
      "end_seconds": 12.24,
      "duration_seconds": 4.07,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.94,
      "end_seconds": 18.26,
      "duration_seconds": 5.32,
      "text": "Oh, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.99,
      "end_seconds": 21.79,
      "duration_seconds": 2.8,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.98,
      "end_seconds": 29.82,
      "duration_seconds": 6.84,
      "text": "Mainly light vaginal bleeding. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.87,
      "end_seconds": 32.16,
      "duration_seconds": 1.29,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.45,
      "end_seconds": 39.06,
      "duration_seconds": 5.61,
      "text": "Around two weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.96,
      "end_seconds": 43.52,
      "duration_seconds": 2.56,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 45.19,
      "end_seconds": 50.4,
      "duration_seconds": 5.21,
      "text": "Shoulder tip pain goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.89,
      "end_seconds": 58.11,
      "duration_seconds": 7.22,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 58.21,
      "end_seconds": 63.23,
      "duration_seconds": 5.02,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.0,
      "end_seconds": 80.7,
      "duration_seconds": 11.7,
      "text": "I was getting to that! The shoulder tip pain? That's been for three weeks. About shoulder tip pain, moderate, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.96,
      "end_seconds": 100.01,
      "duration_seconds": 2.05,
      "text": "Any vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 101.61,
      "end_seconds": 111.74,
      "duration_seconds": 10.13,
      "text": "No, no vaginal discharge, no fever. I was feeling faint at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.1,
      "end_seconds": 115.82,
      "duration_seconds": 2.72,
      "text": "So, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.39,
      "end_seconds": 118.96,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.8,
      "end_seconds": 124.83,
      "duration_seconds": 4.03,
      "text": "Right, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 127.24,
      "end_seconds": 132.0,
      "duration_seconds": 4.76,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.79,
      "end_seconds": 145.8,
      "duration_seconds": 4.01,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.35,
      "end_seconds": 154.02,
      "duration_seconds": 6.67,
      "text": "Yes, asthma. Yes, anxiety. I've had eczema for nearly five years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.62,
      "end_seconds": 163.57,
      "duration_seconds": 7.95,
      "text": "Sure. Yes, asthma is known to us, good to have that clear. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.13,
      "end_seconds": 170.7,
      "duration_seconds": 6.57,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.48,
      "end_seconds": 174.28,
      "duration_seconds": 2.8,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.21,
      "end_seconds": 178.96,
      "duration_seconds": 2.75,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.77,
      "end_seconds": 182.2,
      "duration_seconds": 1.43,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.67,
      "end_seconds": 186.94,
      "duration_seconds": 3.27,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.72,
      "end_seconds": 190.52,
      "duration_seconds": 2.8,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.76,
      "end_seconds": 195.32,
      "duration_seconds": 3.56,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 201.54,
      "duration_seconds": 4.31,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 202.26,
      "end_seconds": 215.23,
      "duration_seconds": 12.97,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.75,
      "end_seconds": 219.09,
      "duration_seconds": 3.34,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.89,
      "end_seconds": 232.02,
      "duration_seconds": 11.13,
      "text": "Sorry, what was I saying, it's Seretide inhaler, twice a day for my asthma. Hydrocortisone cream. I take it when needed for the eczema."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 233.73,
      "end_seconds": 242.78,
      "duration_seconds": 9.05,
      "text": "Doctor, I've got the readings for you. Blood pressure 124 over 84, SpO2 98 percent on room air, pulse is 113 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.21,
      "end_seconds": 245.15,
      "duration_seconds": 0.94,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.0,
      "end_seconds": 249.07,
      "duration_seconds": 2.07,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.43,
      "end_seconds": 252.68,
      "duration_seconds": 2.25,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.16,
      "end_seconds": 275.81,
      "duration_seconds": 5.65,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.92,
      "end_seconds": 289.3,
      "duration_seconds": 11.38,
      "text": "That's the examination finished. Taking everything into account, it points towards a possible ectopic pregnancy. I can't rule out a ruptured ovarian cyst yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.15,
      "end_seconds": 293.34,
      "duration_seconds": 3.19,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.3,
      "end_seconds": 315.18,
      "duration_seconds": 19.88,
      "text": "I understand the worry. At the moment I'd say it's a possible ectopic pregnancy, and we'll know more once the an urgent pelvic scan is back. Let me repeat that back to make sure. You've had light vaginal bleeding for one week, and no fever or vaginal discharge."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 315.92,
      "end_seconds": 317.9,
      "duration_seconds": 1.98,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.44,
      "end_seconds": 336.52,
      "duration_seconds": 17.08,
      "text": "Let's get an urgent pelvic scan, for possible ectopic. I'm sending you for a pregnancy test because of pelvic pain and bleeding. You need to go to the hospital now for an emergency scan. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 337.54,
      "end_seconds": 339.63,
      "duration_seconds": 2.09,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.91,
      "end_seconds": 345.65,
      "duration_seconds": 2.74,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 346.85,
      "end_seconds": 351.07,
      "duration_seconds": 4.22,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.22,
      "end_seconds": 353.56,
      "duration_seconds": 1.34,
      "text": "Take care now."
    }
  ]
}