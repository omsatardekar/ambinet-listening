{
  "schema_version": "1.0",
  "encounter_id": "01325",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 3.29,
      "duration_seconds": 2.41,
      "text": "good afternoon how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.63,
      "end_seconds": 7.11,
      "duration_seconds": 2.48,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.34,
      "end_seconds": 13.11,
      "duration_seconds": 4.77,
      "text": "I wanted to get black tarry stools looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.38,
      "end_seconds": 21.21,
      "duration_seconds": 6.83,
      "text": "tell me your medicines, please. It It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.72,
      "end_seconds": 34.9,
      "duration_seconds": 13.18,
      "text": "okay, so I'm on Tiotropium inhaler, once a day. Clopidogrel i take it 75 milligrams, once a day i'm on ibuprofen, three times a day"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.48,
      "end_seconds": 38.12,
      "duration_seconds": 2.64,
      "text": "and and what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.75,
      "end_seconds": 39.87,
      "duration_seconds": 1.12,
      "text": "400 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.34,
      "end_seconds": 44.27,
      "duration_seconds": 2.93,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.89,
      "end_seconds": 48.99,
      "duration_seconds": 4.1,
      "text": "about... well, one week and stomach pain, too"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.14,
      "end_seconds": 52.09,
      "duration_seconds": 1.95,
      "text": "have you been feeling faint?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.33,
      "end_seconds": 60.98,
      "duration_seconds": 7.65,
      "text": "yes, about the the same, ten days. With feeling faint, about a five out of ten"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.93,
      "end_seconds": 71.21,
      "duration_seconds": 5.28,
      "text": "Have you had black tarry stools before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.78,
      "end_seconds": 79.43,
      "duration_seconds": 7.65,
      "text": "yes, something like this happened last year, and and it went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.36,
      "end_seconds": 85.9,
      "duration_seconds": 4.54,
      "text": "let me check a few things. Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.02,
      "end_seconds": 91.99,
      "duration_seconds": 4.97,
      "text": "I, I haven't had fever or chest pain, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 96.37,
      "duration_seconds": 4.11,
      "text": "hm, okay has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.11,
      "end_seconds": 106.7,
      "duration_seconds": 4.59,
      "text": "my heart's been fine as far as I know"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.65,
      "end_seconds": 116.84,
      "duration_seconds": 2.19,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.9,
      "end_seconds": 123.25,
      "duration_seconds": 5.35,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.19,
      "end_seconds": 128.1,
      "duration_seconds": 2.91,
      "text": "Right tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.33,
      "end_seconds": 134.86,
      "duration_seconds": 5.53,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.85,
      "end_seconds": 137.91,
      "duration_seconds": 2.06,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.14,
      "end_seconds": 143.26,
      "duration_seconds": 4.12,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.4,
      "end_seconds": 147.33,
      "duration_seconds": 2.93,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.32,
      "end_seconds": 153.34,
      "duration_seconds": 4.02,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.09,
      "end_seconds": 158.04,
      "duration_seconds": 3.95,
      "text": "Right anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.81,
      "end_seconds": 159.94,
      "duration_seconds": 1.13,
      "text": "yes COPD"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.24,
      "end_seconds": 162.52,
      "duration_seconds": 1.28,
      "text": "yes carry on"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.69,
      "end_seconds": 168.59,
      "duration_seconds": 2.9,
      "text": "I, I have heart disease"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.91,
      "end_seconds": 171.63,
      "duration_seconds": 1.72,
      "text": "Is that that everything?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.98,
      "end_seconds": 188.54,
      "duration_seconds": 2.56,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.97,
      "end_seconds": 203.73,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.89,
      "end_seconds": 234.22,
      "duration_seconds": 11.33,
      "text": "okay: temperature 36.7, pulse is 116 beats a minute, weight 75 kilos, blood pressure 131 over 70, saturation 96 percent, height 162 centimetres, respiratory rate 16."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.88,
      "end_seconds": 237.54,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.94,
      "end_seconds": 244.32,
      "duration_seconds": 2.38,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.87,
      "end_seconds": 250.6,
      "duration_seconds": 3.73,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.41,
      "end_seconds": 253.74,
      "duration_seconds": 1.33,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.23,
      "end_seconds": 272.18,
      "duration_seconds": 5.95,
      "text": "you look pale, your pulse is fast and your tummy is tender at the top"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.29,
      "end_seconds": 279.4,
      "duration_seconds": 2.11,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.95,
      "end_seconds": 312.97,
      "duration_seconds": 15.02,
      "text": "Right, here's what I'm thinking. This is probably a a possible bleeding stomach ulcer. Stop me if I've got anything wrong. You've had black tarry stools for one week, and no fever or chest pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.59,
      "end_seconds": 315.47,
      "duration_seconds": 1.88,
      "text": "that's what happened yes"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.14,
      "end_seconds": 320.06,
      "duration_seconds": 3.92,
      "text": "I'm sending you for urgent blood tests cos of bleeding"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 321.85,
      "end_seconds": 324.93,
      "duration_seconds": 3.08,
      "text": "the earliest is Wednesday 3:30 pm"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.69,
      "end_seconds": 340.62,
      "duration_seconds": 13.93,
      "text": "Please stop the ibuprofen and do not eat or drink. Don't skip meals, and try to eat smaller portions more often through the day. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.62,
      "end_seconds": 345.0,
      "duration_seconds": 2.38,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.86,
      "end_seconds": 354.86,
      "duration_seconds": 8.0,
      "text": "I'd like to to see you again straight away. Right that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.36,
      "end_seconds": 359.21,
      "duration_seconds": 2.85,
      "text": "great thank you for your help"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.19,
      "end_seconds": 361.43,
      "duration_seconds": 1.24,
      "text": "goodbye for now"
    }
  ]
}