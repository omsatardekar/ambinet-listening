      "role": "DOCTOR",
      "start_seconds": 141.97,
      "end_seconds": 144.91,
      "duration_seconds": 2.94,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.05,
      "end_seconds": 167.51,
      "duration_seconds": 5.46,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.61,
      "end_seconds": 172.55,
      "duration_seconds": 1.94,
