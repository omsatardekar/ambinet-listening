      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 354.43,
      "end_seconds": 358.02,
      "duration_seconds": 3.59,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.73,
      "end_seconds": 360.12,
      "duration_seconds": 1.39,
      "text": "yes that's manageable"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
