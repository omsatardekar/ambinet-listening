    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.85,
      "end_seconds": 223.05,
      "duration_seconds": 8.2,
      "text": "I take sumatriptan, 50 milligrams, when needed. Loratadine. I take it it 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.54,
      "end_seconds": 225.83,
      "duration_seconds": 1.29,
      "text": "Is that long-standing?"
