    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.8,
      "end_seconds": 275.26,
      "duration_seconds": 3.46,
      "text": "yes, naproxen, it gives me a rash"
