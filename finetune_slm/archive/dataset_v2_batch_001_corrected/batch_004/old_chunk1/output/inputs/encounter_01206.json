      "role": "DOCTOR",
      "start_seconds": 6.87,
      "end_seconds": 10.68,
      "duration_seconds": 3.81,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.12,
      "end_seconds": 15.86,
      "duration_seconds": 3.74,
      "text": "It's a dry cough in the evenings, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.76,
      "end_seconds": 20.68,
