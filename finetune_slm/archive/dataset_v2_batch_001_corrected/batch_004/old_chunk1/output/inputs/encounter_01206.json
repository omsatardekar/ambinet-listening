      "role": "PATIENT",
      "start_seconds": 62.67,
      "end_seconds": 66.07,
      "duration_seconds": 3.4,
      "text": "pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.4,
      "end_seconds": 75.97,
      "duration_seconds": 9.57,
      "text": "Okay, go on. Have you had a dry cough in the evenings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.61,
      "end_seconds": 83.97,
      "duration_seconds": 7.36,
      "text": "yes something like this happened last winter and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.2,
      "end_seconds": 87.48,
      "duration_seconds": 2.28,
      "text": "I'll do your observations first."
