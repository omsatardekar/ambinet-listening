      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.93,
      "end_seconds": 278.26,
      "duration_seconds": 2.33,
      "text": "Do you follow any particular diet?"
    },
