      "role": "PATIENT",
      "start_seconds": 21.94,
      "end_seconds": 25.77,
      "duration_seconds": 3.83,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.36,
      "end_seconds": 37.61,
      "duration_seconds": 11.25,
      "text": "mm-hmm tell me a bit more about it: how bad it gets, how often, and and whether anything makes it better or worse"
