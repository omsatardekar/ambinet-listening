    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.83,
      "end_seconds": 228.49,
      "duration_seconds": 1.66,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.43,
      "end_seconds": 242.39,
      "duration_seconds": 2.96,
      "text": "alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.0,
      "end_seconds": 246.26,
      "duration_seconds": 3.26,
      "text": "I've had migraines for two years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.18,
      "end_seconds": 269.86,
      "duration_seconds": 5.68,
      "text": "Right, has anything ever caused you a reaction? I mean any allergies."
