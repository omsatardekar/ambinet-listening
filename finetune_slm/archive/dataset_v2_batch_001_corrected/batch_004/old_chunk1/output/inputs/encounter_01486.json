{
  "schema_version": "1.0",
  "encounter_id": "01486",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.16,
      "end_seconds": 3.15,
      "duration_seconds": 1.99,
      "text": "Morning, come on through."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.69,
      "end_seconds": 5.81,
      "duration_seconds": 1.12,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.45,
      "end_seconds": 12.42,
      "duration_seconds": 2.97,
      "text": "Right, start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.11,
      "end_seconds": 16.72,
      "duration_seconds": 3.61,
      "text": "well, I've been having a sore ankle"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.58,
      "end_seconds": 20.42,
      "duration_seconds": 2.84,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.27,
      "end_seconds": 32.38,
      "duration_seconds": 10.11,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.33,
      "end_seconds": 36.06,
      "duration_seconds": 2.73,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.52,
      "end_seconds": 38.63,
      "duration_seconds": 1.11,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.44,
      "end_seconds": 46.21,
      "duration_seconds": 5.77,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.15,
      "end_seconds": 49.12,
      "duration_seconds": 1.97,
      "text": "honestly, all the time"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.5,
      "end_seconds": 53.06,
      "duration_seconds": 2.56,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.91,
      "end_seconds": 57.07,
      "duration_seconds": 3.16,
      "text": "I notice it more with walking"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.14,
      "end_seconds": 60.33,
      "duration_seconds": 2.19,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.28,
      "end_seconds": 66.53,
      "duration_seconds": 5.25,
      "text": "A little swelling goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 67.49,
      "end_seconds": 76.62,
      "duration_seconds": 9.13,
      "text": "Okay, so the vitals from earlier. Pulse is 69 beats a minute, pressure 122 over 70. Temperature 36.7, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.12,
      "end_seconds": 79.22,
      "duration_seconds": 1.1,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.64,
      "end_seconds": 85.2,
      "duration_seconds": 4.56,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.48,
      "end_seconds": 88.78,
      "duration_seconds": 2.3,
      "text": "Okay, does that that hurt?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.49,
      "end_seconds": 115.36,
      "duration_seconds": 7.87,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.77,
      "end_seconds": 120.72,
      "duration_seconds": 2.95,
      "text": "All finished, thank you. Nothing like numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.42,
      "end_seconds": 124.1,
      "duration_seconds": 2.68,
      "text": "I haven't noticed any numbness."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.8,
      "end_seconds": 132.31,
      "duration_seconds": 6.51,
      "text": "Let me check a few things. Any crack or pop or pain in the foot?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.27,
      "end_seconds": 140.14,
      "duration_seconds": 5.87,
      "text": "I haven't had crack or pop or pain in the foot, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.06,
      "end_seconds": 145.1,
      "duration_seconds": 3.04,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.08,
      "end_seconds": 148.94,
      "duration_seconds": 2.86,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.78,
      "end_seconds": 154.48,
      "duration_seconds": 3.7,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.14,
      "end_seconds": 159.09,
      "duration_seconds": 2.95,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.17,
      "end_seconds": 164.72,
      "duration_seconds": 3.55,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.76,
      "end_seconds": 170.72,
      "duration_seconds": 3.96,
      "text": "I take propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 171.87,
      "end_seconds": 176.75,
      "duration_seconds": 4.88,
      "text": "Doctor, our chart from the last visit lists it as 80 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.17,
      "end_seconds": 182.49,
      "duration_seconds": 4.32,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.46,
      "end_seconds": 195.34,
      "duration_seconds": 10.88,
      "text": "Not with me. I'll bring it next time. I'm on carbamazepine, 200 milligrams, twice a day for the seizures."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.78,
      "end_seconds": 199.59,
      "duration_seconds": 2.81,
      "text": "So, do you do any exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.48,
      "end_seconds": 204.12,
      "duration_seconds": 2.64,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.87,
      "end_seconds": 207.72,
      "duration_seconds": 1.85,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.74,
      "end_seconds": 214.19,
      "duration_seconds": 4.45,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.6,
      "end_seconds": 219.66,
      "duration_seconds": 4.06,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.0,
      "end_seconds": 229.44,
      "duration_seconds": 4.44,
      "text": "My aunt has rheumatoid arthritis. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.02,
      "end_seconds": 233.19,
      "duration_seconds": 3.17,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.59,
      "end_seconds": 239.15,
      "duration_seconds": 4.56,
      "text": "Yes, I had my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.68,
      "end_seconds": 245.14,
      "duration_seconds": 4.46,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.08,
      "end_seconds": 252.98,
      "duration_seconds": 6.9,
      "text": "I was told I'm allergic to walnuts, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.67,
      "end_seconds": 270.81,
      "duration_seconds": 4.14,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 271.84,
      "end_seconds": 275.99,
      "duration_seconds": 4.15,
      "text": "Migraines, for nearly five years. Yes, epilepsy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.77,
      "end_seconds": 282.25,
      "duration_seconds": 5.48,
      "text": "Yes, migraines is known to us, good to have that that clear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.12,
      "end_seconds": 312.56,
      "duration_seconds": 14.44,
      "text": "Okay, so my impression is this: The most likely explanation is a mild ankle sprain. That's my thinking for now, and it may change as we learn more. Another possibility is a minor fracture."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.45,
      "end_seconds": 334.39,
      "duration_seconds": 13.94,
      "text": "rest, ice, a compression bandage and keep it raised for two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.33,
      "end_seconds": 339.51,
      "duration_seconds": 3.18,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.41,
      "end_seconds": 347.82,
      "duration_seconds": 6.41,
      "text": "If you cannot put weight on it, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.32,
      "end_seconds": 353.26,
      "duration_seconds": 1.94,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.57,
      "end_seconds": 364.23,
      "duration_seconds": 9.66,
      "text": "please come and see me if it is not better in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.37,
      "end_seconds": 373.55,
      "duration_seconds": 4.18,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.56,
      "end_seconds": 376.76,
      "duration_seconds": 1.2,
      "text": "goodbye for now"
    }
  ]
}