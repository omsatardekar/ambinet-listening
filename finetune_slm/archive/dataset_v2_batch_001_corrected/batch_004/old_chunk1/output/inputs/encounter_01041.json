{
  "schema_version": "1.0",
  "encounter_id": "01041",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.6,
      "duration_seconds": 4.07,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.63,
      "end_seconds": 10.29,
      "duration_seconds": 4.66,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.47,
      "end_seconds": 18.85,
      "duration_seconds": 5.38,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.77,
      "end_seconds": 24.22,
      "duration_seconds": 3.45,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.8,
      "end_seconds": 30.95,
      "duration_seconds": 6.15,
      "text": "Well, uh, I've been having my face drooping on one side."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.92,
      "end_seconds": 35.51,
      "duration_seconds": 2.59,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.46,
      "end_seconds": 44.12,
      "duration_seconds": 7.66,
      "text": "Hmm, I'd say about a week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.7,
      "end_seconds": 47.83,
      "duration_seconds": 3.13,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.81,
      "end_seconds": 57.84,
      "duration_seconds": 9.03,
      "text": "I'd say mild. Oh, and a sudden headache. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.23,
      "end_seconds": 73.61,
      "duration_seconds": 5.38,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.52,
      "end_seconds": 79.69,
      "duration_seconds": 4.17,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.13,
      "end_seconds": 84.96,
      "duration_seconds": 3.83,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.79,
      "end_seconds": 90.13,
      "duration_seconds": 3.34,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.72,
      "end_seconds": 98.9,
      "duration_seconds": 4.18,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.25,
      "end_seconds": 110.64,
      "duration_seconds": 6.39,
      "text": "I've got an irregular heartbeat. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.92,
      "end_seconds": 119.24,
      "duration_seconds": 7.32,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.78,
      "end_seconds": 128.52,
      "duration_seconds": 8.74,
      "text": "Erm, I had my septum straightened in my thirties. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.6,
      "end_seconds": 132.69,
      "duration_seconds": 2.09,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.72,
      "end_seconds": 136.96,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.85,
      "end_seconds": 139.79,
      "duration_seconds": 1.94,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.96,
      "end_seconds": 144.82,
      "duration_seconds": 3.86,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.56,
      "end_seconds": 146.79,
      "duration_seconds": 1.23,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.87,
      "end_seconds": 150.68,
      "duration_seconds": 2.81,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.97,
      "end_seconds": 155.08,
      "duration_seconds": 3.11,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 157.15,
      "end_seconds": 161.64,
      "duration_seconds": 4.49,
      "text": "She takes apixaban, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.6,
      "end_seconds": 165.82,
      "duration_seconds": 2.22,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 167.85,
      "end_seconds": 170.1,
      "duration_seconds": 2.25,
      "text": "It's, It's 5 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.92,
      "end_seconds": 176.57,
      "duration_seconds": 5.65,
      "text": "I'd been on metoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.14,
      "end_seconds": 199.49,
      "duration_seconds": 4.35,
      "text": "A few quick ones: seizure, fever or loss of consciousness?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.46,
      "end_seconds": 208.83,
      "duration_seconds": 7.37,
      "text": "Ah, you know, I haven't had seizure, fever or loss of consciousness, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.78,
      "end_seconds": 212.23,
      "duration_seconds": 2.45,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.29,
      "end_seconds": 216.46,
      "duration_seconds": 3.17,
      "text": "No, um, skin's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.57,
      "end_seconds": 220.23,
      "duration_seconds": 2.66,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.91,
      "end_seconds": 223.59,
      "duration_seconds": 1.68,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.23,
      "end_seconds": 227.63,
      "duration_seconds": 3.4,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.69,
      "end_seconds": 242.3,
      "duration_seconds": 2.61,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.05,
      "end_seconds": 267.55,
      "duration_seconds": 9.5,
      "text": "Okay: blood pressure 171 over 90, SpO2 98 percent on room air, heart rate 84, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.64,
      "end_seconds": 271.22,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.28,
      "end_seconds": 276.51,
      "duration_seconds": 3.23,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.82,
      "end_seconds": 281.03,
      "duration_seconds": 2.21,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.89,
      "end_seconds": 284.41,
      "duration_seconds": 1.52,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.08,
      "end_seconds": 288.38,
      "duration_seconds": 2.3,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.89,
      "end_seconds": 312.97,
      "duration_seconds": 6.08,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.1,
      "end_seconds": 315.0,
      "duration_seconds": 0.9,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.12,
      "end_seconds": 319.72,
      "duration_seconds": 1.6,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.63,
      "end_seconds": 364.31,
      "duration_seconds": 35.68,
      "text": "Putting it all together, my working impression is a possible stroke, within the treatment window. We shouldn't forget a migraine with aura. I'll request a blood sugar test, it'll help with stroke symptoms. I'm sending you for an urgent CT scan of the head because of possible stroke. That will help us see what's going on underneath and decide the next step. Call an ambulance now, you need hospital immediately. I'll also refer you to the stroke team."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.35,
      "end_seconds": 373.33,
      "duration_seconds": 5.98,
      "text": "Do get help quickly if the symptoms change. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.28,
      "end_seconds": 379.13,
      "duration_seconds": 3.85,
      "text": "Well, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.66,
      "end_seconds": 382.55,
      "duration_seconds": 2.89,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.59,
      "end_seconds": 387.2,
      "duration_seconds": 3.61,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.84,
      "end_seconds": 389.16,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}