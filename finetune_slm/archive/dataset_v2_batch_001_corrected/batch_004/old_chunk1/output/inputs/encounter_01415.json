{
  "schema_version": "1.0",
  "encounter_id": "01415",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 4.2,
      "duration_seconds": 3.16,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.97,
      "end_seconds": 9.32,
      "duration_seconds": 4.35,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.42,
      "end_seconds": 15.25,
      "duration_seconds": 4.83,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.23,
      "end_seconds": 21.42,
      "duration_seconds": 5.19,
      "text": "I've been wanting contraception, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.11,
      "end_seconds": 25.47,
      "duration_seconds": 3.36,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.15,
      "end_seconds": 39.82,
      "duration_seconds": 9.67,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.24,
      "end_seconds": 44.89,
      "duration_seconds": 3.65,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.54,
      "end_seconds": 50.71,
      "duration_seconds": 4.17,
      "text": "Moderate, I'd say. And slightly heavy periods, too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.51,
      "end_seconds": 57.52,
      "duration_seconds": 5.01,
      "text": "Any smoking, breast lumps or migraine with aura at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.72,
      "end_seconds": 66.16,
      "duration_seconds": 6.44,
      "text": "I, I haven't had smoking, breast lumps or migraine with aura, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.6,
      "end_seconds": 69.2,
      "duration_seconds": 1.6,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.03,
      "end_seconds": 72.16,
      "duration_seconds": 1.13,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.14,
      "end_seconds": 77.12,
      "duration_seconds": 3.98,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.96,
      "end_seconds": 79.42,
      "duration_seconds": 1.46,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.9,
      "end_seconds": 95.13,
      "duration_seconds": 2.23,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.85,
      "end_seconds": 106.61,
      "duration_seconds": 10.76,
      "text": "I have gout, for five years i have thin bones, for two years i have an underactive thyroid, for five years"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.99,
      "end_seconds": 115.21,
      "duration_seconds": 7.22,
      "text": "okay, I can see an underactive thyroid in your file as well. Have you retired yet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.61,
      "end_seconds": 124.96,
      "duration_seconds": 4.35,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.56,
      "end_seconds": 128.69,
      "duration_seconds": 2.13,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.41,
      "end_seconds": 134.62,
      "duration_seconds": 4.21,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.84,
      "end_seconds": 153.22,
      "duration_seconds": 3.38,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.93,
      "end_seconds": 158.25,
      "duration_seconds": 4.32,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.33,
      "end_seconds": 163.5,
      "duration_seconds": 3.17,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.1,
      "end_seconds": 175.69,
      "duration_seconds": 10.59,
      "text": "I'm on allopurinol, 100 milligrams, once a day for the gout. I'm on Thyronorm, 50 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.39,
      "end_seconds": 178.88,
      "duration_seconds": 2.49,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.33,
      "end_seconds": 183.79,
      "duration_seconds": 3.46,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.8,
      "end_seconds": 188.67,
      "duration_seconds": 3.87,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.03,
      "end_seconds": 204.06,
      "duration_seconds": 3.03,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.04,
      "end_seconds": 223.88,
      "duration_seconds": 5.84,
      "text": "Okay: temp 36.5 degrees, BP is 122 over 80, pulse 64."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.01,
      "end_seconds": 229.96,
      "duration_seconds": 3.95,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.88,
      "end_seconds": 233.26,
      "duration_seconds": 2.38,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.8,
      "end_seconds": 252.05,
      "duration_seconds": 2.25,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.36,
      "end_seconds": 255.98,
      "duration_seconds": 1.62,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.9,
      "end_seconds": 279.01,
      "duration_seconds": 7.11,
      "text": "Putting it all together, this looks most like suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.9,
      "end_seconds": 282.78,
      "duration_seconds": 2.88,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.28,
      "end_seconds": 300.87,
      "duration_seconds": 16.59,
      "text": "nothing I've seen today points to an emergency it looks like suitable for hormonal contraception with no risk factors let me repeat that back to make sure you've been wanting contraception, moderate, and no migraine with aura or breast lumps"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.97,
      "end_seconds": 303.51,
      "duration_seconds": 1.54,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.15,
      "end_seconds": 333.57,
      "duration_seconds": 29.42,
      "text": "I'll start you on levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term that's for contraception i'll put all of this in writing so you don't have to remember it take the pill at the same time each day and use condoms if you miss two if you get leg swelling or severe headaches, or you feel really unwell, please come to the emergency department come back in three months"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.36,
      "end_seconds": 338.51,
      "duration_seconds": 4.15,
      "text": "that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.65,
      "end_seconds": 343.06,
      "duration_seconds": 3.41,
      "text": "Thank you, you know, that's helpful."
    }
  ]
}