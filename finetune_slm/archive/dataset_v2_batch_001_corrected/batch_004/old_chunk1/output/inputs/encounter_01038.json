{
  "schema_version": "1.0",
  "encounter_id": "01038",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 3.94,
      "duration_seconds": 3.11,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.86,
      "end_seconds": 10.03,
      "duration_seconds": 5.17,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.42,
      "end_seconds": 20.01,
      "duration_seconds": 8.59,
      "text": "Mainly I've been feeling well. That's why I came. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.01,
      "end_seconds": 22.2,
      "duration_seconds": 1.19,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.07,
      "end_seconds": 26.09,
      "duration_seconds": 3.02,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.8,
      "end_seconds": 31.01,
      "duration_seconds": 3.21,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.07,
      "end_seconds": 35.73,
      "duration_seconds": 1.66,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.44,
      "end_seconds": 39.44,
      "duration_seconds": 3.0,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.15,
      "end_seconds": 50.28,
      "duration_seconds": 9.13,
      "text": "When it starts I tend to get slightly dry skin as well. The slightly dry skin? That's been since yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.22,
      "end_seconds": 55.32,
      "duration_seconds": 4.1,
      "text": "Have you been feeling well at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.4,
      "end_seconds": 64.12,
      "duration_seconds": 7.72,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.69,
      "end_seconds": 72.6,
      "duration_seconds": 4.91,
      "text": "Have you noticed feeling cold, constipation, palpitations or weight change?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.3,
      "end_seconds": 77.54,
      "duration_seconds": 3.24,
      "text": "Actually, no, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.61,
      "end_seconds": 81.21,
      "duration_seconds": 1.6,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.84,
      "end_seconds": 83.26,
      "duration_seconds": 1.42,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.68,
      "end_seconds": 85.58,
      "duration_seconds": 0.9,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.66,
      "end_seconds": 90.92,
      "duration_seconds": 3.26,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.23,
      "end_seconds": 95.42,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.06,
      "end_seconds": 101.59,
      "duration_seconds": 5.53,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.38,
      "end_seconds": 105.66,
      "duration_seconds": 2.28,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.49,
      "end_seconds": 111.84,
      "duration_seconds": 4.35,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.5,
      "end_seconds": 115.7,
      "duration_seconds": 2.2,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.72,
      "end_seconds": 122.8,
      "duration_seconds": 6.08,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.04,
      "end_seconds": 127.13,
      "duration_seconds": 3.09,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.9,
      "end_seconds": 134.83,
      "duration_seconds": 2.93,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.28,
      "end_seconds": 151.33,
      "duration_seconds": 2.05,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.96,
      "end_seconds": 158.63,
      "duration_seconds": 5.67,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.96,
      "end_seconds": 171.84,
      "duration_seconds": 3.88,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.13,
      "end_seconds": 175.25,
      "duration_seconds": 2.12,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.08,
      "end_seconds": 184.11,
      "duration_seconds": 7.03,
      "text": "Okay, I can see an underactive thyroid in your file as well. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.96,
      "end_seconds": 190.45,
      "duration_seconds": 4.49,
      "text": "I'm on Eltroxin, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.5,
      "end_seconds": 194.58,
      "duration_seconds": 2.08,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.25,
      "end_seconds": 201.33,
      "duration_seconds": 5.08,
      "text": "100 micrograms, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.8,
      "end_seconds": 207.52,
      "duration_seconds": 4.72,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.15,
      "end_seconds": 212.04,
      "duration_seconds": 2.89,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.97,
      "end_seconds": 217.31,
      "duration_seconds": 3.34,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.65,
      "end_seconds": 227.52,
      "duration_seconds": 2.87,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.37,
      "end_seconds": 263.22,
      "duration_seconds": 17.85,
      "text": "Okay: BP is 115 over 68, height 167 centimetres, BMI works out to 24.4. And oxygen saturation is 99 percent, weight 68 kilos, pulse is 71 beats a minute, temperature is 36.7 degrees, respiratory rate 17."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.42,
      "end_seconds": 268.83,
      "duration_seconds": 3.41,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.58,
      "end_seconds": 273.16,
      "duration_seconds": 2.58,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.26,
      "end_seconds": 288.15,
      "duration_seconds": 4.89,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.24,
      "end_seconds": 295.56,
      "duration_seconds": 2.32,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.31,
      "end_seconds": 316.59,
      "duration_seconds": 12.28,
      "text": "Let me tell you where I've got to. This is probably well-controlled thyroid replacement. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.85,
      "end_seconds": 320.87,
      "duration_seconds": 2.02,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.83,
      "end_seconds": 345.01,
      "duration_seconds": 23.18,
      "text": "I understand the worry. At the moment I'd say it's well-controlled thyroid replacement, and we'll know more once the a thyroid blood test is back. I think a thyroid blood test makes sense here, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. Come back in twelve months."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.89,
      "end_seconds": 347.9,
      "duration_seconds": 2.01,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.5,
      "end_seconds": 351.82,
      "duration_seconds": 3.32,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.84,
      "end_seconds": 356.72,
      "duration_seconds": 3.88,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}