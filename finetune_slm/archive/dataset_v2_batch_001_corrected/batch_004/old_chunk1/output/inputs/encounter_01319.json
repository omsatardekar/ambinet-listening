{
  "schema_version": "1.0",
  "encounter_id": "01319",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 7.33,
      "duration_seconds": 5.99,
      "text": "So, uh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.18,
      "end_seconds": 12.42,
      "duration_seconds": 4.24,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.82,
      "end_seconds": 23.11,
      "duration_seconds": 9.29,
      "text": "It's, It's a blocked ear. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.6,
      "end_seconds": 27.64,
      "duration_seconds": 3.04,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.95,
      "end_seconds": 43.49,
      "duration_seconds": 2.54,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.33,
      "end_seconds": 67.31,
      "duration_seconds": 4.98,
      "text": "Okay: pulse 80, temperature 36.9, BP is 122 over 82."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.34,
      "end_seconds": 70.09,
      "duration_seconds": 1.75,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.29,
      "end_seconds": 74.86,
      "duration_seconds": 3.57,
      "text": "We'll go over that shortly. Since when exactly?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.39,
      "end_seconds": 78.43,
      "duration_seconds": 2.04,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.28,
      "end_seconds": 83.76,
      "duration_seconds": 3.48,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.63,
      "end_seconds": 87.34,
      "duration_seconds": 1.71,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.72,
      "end_seconds": 91.98,
      "duration_seconds": 3.26,
      "text": "Has there been a feeling of fullness too?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.42,
      "end_seconds": 98.54,
      "duration_seconds": 3.12,
      "text": "Yes, um, since last weekend."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.06,
      "end_seconds": 105.72,
      "duration_seconds": 5.66,
      "text": "Let me check a few things. Any ringing, ear pain, dizziness or discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.48,
      "end_seconds": 112.29,
      "duration_seconds": 2.81,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.2,
      "end_seconds": 120.26,
      "duration_seconds": 3.06,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.12,
      "end_seconds": 122.69,
      "duration_seconds": 1.57,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.43,
      "end_seconds": 136.99,
      "duration_seconds": 3.56,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.46,
      "end_seconds": 141.98,
      "duration_seconds": 3.52,
      "text": "I have heart failure, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.62,
      "end_seconds": 146.28,
      "duration_seconds": 3.66,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.23,
      "end_seconds": 153.07,
      "duration_seconds": 4.84,
      "text": "I'm on metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.58,
      "end_seconds": 158.26,
      "duration_seconds": 3.68,
      "text": "So, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.19,
      "end_seconds": 163.36,
      "duration_seconds": 3.17,
      "text": "Oh, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.85,
      "end_seconds": 165.65,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.68,
      "end_seconds": 169.5,
      "duration_seconds": 2.82,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.95,
      "end_seconds": 174.69,
      "duration_seconds": 1.74,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.8,
      "end_seconds": 179.34,
      "duration_seconds": 3.54,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.68,
      "end_seconds": 183.64,
      "duration_seconds": 2.96,
      "text": "Okay, do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.98,
      "end_seconds": 189.41,
      "duration_seconds": 4.43,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.29,
      "end_seconds": 196.3,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.17,
      "end_seconds": 202.64,
      "duration_seconds": 4.47,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.68,
      "end_seconds": 214.53,
      "duration_seconds": 4.85,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.5,
      "end_seconds": 220.26,
      "duration_seconds": 3.76,
      "text": "I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.61,
      "end_seconds": 224.03,
      "duration_seconds": 2.42,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.75,
      "end_seconds": 229.4,
      "duration_seconds": 4.65,
      "text": "Nothing, uh, I haven't had any operations."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.76,
      "end_seconds": 235.37,
      "duration_seconds": 3.61,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.16,
      "end_seconds": 239.21,
      "duration_seconds": 2.05,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.54,
      "end_seconds": 254.21,
      "duration_seconds": 4.67,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.96,
      "end_seconds": 266.71,
      "duration_seconds": 9.75,
      "text": "That's the examination finished. Okay, thinking it through, this is probably earwax blocking the ear. A middle ear fluid is also on my list."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.06,
      "end_seconds": 285.49,
      "duration_seconds": 3.43,
      "text": "I'm going to order ear irrigation, for wax."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.33,
      "end_seconds": 289.94,
      "duration_seconds": 3.61,
      "text": "Oh, um, is that done today?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.88,
      "end_seconds": 296.86,
      "duration_seconds": 5.98,
      "text": "Use the olive oil drops for a week and then we'll syringe the ear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.34,
      "end_seconds": 311.67,
      "duration_seconds": 14.33,
      "text": "Okay, go on. Do get help quickly if you get ear pain or dizziness. We'll catch up in one week. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.76,
      "end_seconds": 319.8,
      "duration_seconds": 6.04,
      "text": "So, I come back in one week. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.03,
      "end_seconds": 325.04,
      "duration_seconds": 4.01,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.03,
      "end_seconds": 330.22,
      "duration_seconds": 3.19,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.78,
      "end_seconds": 332.06,
      "duration_seconds": 1.28,
      "text": "Take care now."
    }
  ]
}