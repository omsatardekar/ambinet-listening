{
  "schema_version": "1.0",
  "encounter_id": "01183",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 5.25,
      "duration_seconds": 4.26,
      "text": "Good morning, grab a seat. What's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.84,
      "end_seconds": 18.24,
      "duration_seconds": 12.4,
      "text": "Sorry, what was I saying, I've been dealing with bloating after meals. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.6,
      "end_seconds": 22.56,
      "duration_seconds": 2.96,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.68,
      "end_seconds": 27.5,
      "duration_seconds": 3.82,
      "text": "It's, It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.13,
      "end_seconds": 43.73,
      "duration_seconds": 10.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.41,
      "end_seconds": 47.65,
      "duration_seconds": 3.24,
      "text": "Walking helps a bit. Moderate, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.23,
      "end_seconds": 54.22,
      "duration_seconds": 4.99,
      "text": "What about a lot of wind, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.84,
      "end_seconds": 57.81,
      "duration_seconds": 2.97,
      "text": "Actually, yes, for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.68,
      "end_seconds": 65.86,
      "duration_seconds": 5.18,
      "text": "what about loose stools now and then, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.88,
      "end_seconds": 69.88,
      "duration_seconds": 3.0,
      "text": "yeah, yes, that started yesterday"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.95,
      "end_seconds": 75.35,
      "duration_seconds": 3.4,
      "text": "Have you noticed weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.28,
      "end_seconds": 80.18,
      "duration_seconds": 3.9,
      "text": "No weight loss or vomiting, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.21,
      "end_seconds": 85.49,
      "duration_seconds": 4.28,
      "text": "Did you get blood in the stool or night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.35,
      "end_seconds": 91.08,
      "duration_seconds": 3.73,
      "text": "Um, no, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.5,
      "end_seconds": 98.95,
      "duration_seconds": 4.45,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.87,
      "end_seconds": 102.24,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.5,
      "end_seconds": 107.51,
      "duration_seconds": 4.01,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.36,
      "end_seconds": 112.8,
      "duration_seconds": 2.44,
      "text": "Anxiety, for nearly five years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.77,
      "end_seconds": 114.47,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.19,
      "end_seconds": 123.93,
      "duration_seconds": 8.74,
      "text": "Well, um, I have depression, for two years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.56,
      "end_seconds": 127.33,
      "duration_seconds": 1.77,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.32,
      "end_seconds": 135.27,
      "duration_seconds": 6.95,
      "text": "Alright, anxiety and depression, that matches what I have here. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.25,
      "end_seconds": 160.25,
      "duration_seconds": 23.0,
      "text": "I gave up cigarettes last spring. I used to drink heavily but I stopped four years ago. I'm a plumber, lots of bending and kneeling. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.7,
      "end_seconds": 165.38,
      "duration_seconds": 3.68,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.98,
      "end_seconds": 170.77,
      "duration_seconds": 4.79,
      "text": "Escitalopram i take it 10 milligrams, once a day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 172.46,
      "end_seconds": 177.48,
      "duration_seconds": 5.02,
      "text": "Doctor, our chart from the last visit lists it as 5 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.49,
      "end_seconds": 183.01,
      "duration_seconds": 4.52,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.7,
      "end_seconds": 193.4,
      "duration_seconds": 9.7,
      "text": "ah, no, I left it at home erm, I'm on fluoxetine, 20 milligrams, maybe, every morning"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.34,
      "end_seconds": 202.23,
      "duration_seconds": 3.89,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.2,
      "end_seconds": 209.65,
      "duration_seconds": 6.45,
      "text": "Not with me. I'll bring it next time. It's peppermint capsules, after meals."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.36,
      "end_seconds": 214.45,
      "duration_seconds": 4.09,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.48,
      "end_seconds": 228.97,
      "duration_seconds": 13.49,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.61,
      "end_seconds": 233.65,
      "duration_seconds": 3.04,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.72,
      "end_seconds": 241.99,
      "duration_seconds": 6.27,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.16,
      "end_seconds": 247.45,
      "duration_seconds": 4.29,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.09,
      "end_seconds": 251.12,
      "duration_seconds": 3.03,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 259.76,
      "end_seconds": 268.47,
      "duration_seconds": 8.71,
      "text": "Okay, so the vitals from earlier. Temperature is 36.5 degrees, pulse is 68 beats a minute, blood pressure 110 over 72."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.59,
      "end_seconds": 270.96,
      "duration_seconds": 1.37,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.34,
      "end_seconds": 276.97,
      "duration_seconds": 3.63,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.52,
      "end_seconds": 280.8,
      "duration_seconds": 2.28,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.33,
      "end_seconds": 294.23,
      "duration_seconds": 5.9,
      "text": "your tummy is soft and not tender, and I can't feel any lumps"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.58,
      "end_seconds": 298.83,
      "duration_seconds": 2.25,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.15,
      "end_seconds": 323.23,
      "duration_seconds": 17.08,
      "text": "Having listened and examined, my working impression is a functional bowel pattern, with no alarm features. That's my thinking for now, and it may change as we learn more. We shouldn't forget irritable bowel syndrome."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.39,
      "end_seconds": 338.76,
      "duration_seconds": 4.37,
      "text": "I'll request a coeliac blood test, it'll help with bloating."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.36,
      "end_seconds": 343.21,
      "duration_seconds": 3.85,
      "text": "Actually, where would I go for that?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.18,
      "end_seconds": 358.09,
      "duration_seconds": 13.91,
      "text": "Try smaller meals and keep a food and symptom diary for four weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.67,
      "end_seconds": 360.08,
      "duration_seconds": 1.41,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.08,
      "end_seconds": 364.47,
      "duration_seconds": 2.39,
      "text": "Come back in six weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.01,
      "end_seconds": 367.97,
      "duration_seconds": 1.96,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.5,
      "end_seconds": 377.09,
      "duration_seconds": 3.59,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.95,
      "end_seconds": 382.13,
      "duration_seconds": 4.18,
      "text": "Well, great, thank you for your help."
    }
  ]
}