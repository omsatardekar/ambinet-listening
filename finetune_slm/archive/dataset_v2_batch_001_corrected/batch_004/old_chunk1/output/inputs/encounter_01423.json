{
  "schema_version": "1.0",
  "encounter_id": "01423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 7.79,
      "duration_seconds": 7.08,
      "text": "Sorry, what was I saying, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.22,
      "end_seconds": 12.91,
      "duration_seconds": 3.69,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.35,
      "end_seconds": 22.36,
      "duration_seconds": 5.01,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.43,
      "end_seconds": 27.76,
      "duration_seconds": 3.33,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.51,
      "end_seconds": 35.46,
      "duration_seconds": 6.95,
      "text": "Doctor, it's a cut on my finger. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.08,
      "end_seconds": 40.87,
      "duration_seconds": 3.79,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.45,
      "end_seconds": 44.96,
      "duration_seconds": 3.51,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.61,
      "end_seconds": 49.44,
      "duration_seconds": 2.83,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.51,
      "end_seconds": 58.98,
      "duration_seconds": 8.47,
      "text": "A plaster helps a bit. Uh, I had a little bleeding before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.95,
      "end_seconds": 63.69,
      "duration_seconds": 2.74,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.4,
      "end_seconds": 68.94,
      "duration_seconds": 4.54,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.08,
      "end_seconds": 72.39,
      "duration_seconds": 2.31,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.74,
      "end_seconds": 77.51,
      "duration_seconds": 3.77,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.69,
      "end_seconds": 80.83,
      "duration_seconds": 2.14,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.21,
      "end_seconds": 87.37,
      "duration_seconds": 5.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.14,
      "end_seconds": 95.03,
      "duration_seconds": 2.89,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.43,
      "end_seconds": 99.73,
      "duration_seconds": 3.3,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.79,
      "end_seconds": 104.41,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.74,
      "end_seconds": 109.6,
      "duration_seconds": 3.86,
      "text": "Um, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.22,
      "end_seconds": 124.03,
      "duration_seconds": 3.81,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.66,
      "end_seconds": 127.02,
      "duration_seconds": 2.36,
      "text": "So, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.73,
      "end_seconds": 133.17,
      "duration_seconds": 4.44,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 134.23,
      "end_seconds": 143.36,
      "duration_seconds": 9.13,
      "text": "It's simvastatin, 20 milligrams, at night, doctor. Yeah, it's carbamazepine, 200 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.68,
      "end_seconds": 162.76,
      "duration_seconds": 2.08,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.31,
      "end_seconds": 171.08,
      "duration_seconds": 6.77,
      "text": "Ah, I've had high cholesterol for two years now. I've, I've got epilepsy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.74,
      "end_seconds": 178.95,
      "duration_seconds": 7.21,
      "text": "Right, right. Okay, I can see high cholesterol and epilepsy in your file as well."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.03,
      "end_seconds": 191.57,
      "duration_seconds": 3.54,
      "text": "Right, any numbness or dirty blade at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.44,
      "end_seconds": 196.5,
      "duration_seconds": 3.06,
      "text": "Oh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.44,
      "end_seconds": 200.06,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.02,
      "end_seconds": 204.82,
      "duration_seconds": 2.8,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.33,
      "end_seconds": 212.09,
      "duration_seconds": 3.76,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.19,
      "end_seconds": 222.44,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.43,
      "end_seconds": 252.11,
      "duration_seconds": 8.68,
      "text": "Okay: oxygen saturation is 97 percent, temperature 36.6. And BP is 117 over 78, pulse is 65 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.69,
      "end_seconds": 257.05,
      "duration_seconds": 2.36,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 259.61,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.41,
      "end_seconds": 282.28,
      "duration_seconds": 5.87,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.06,
      "end_seconds": 315.29,
      "duration_seconds": 29.23,
      "text": "Good, you can sit up again. Okay, so my impression is this: I think we're dealing with a minor clean wound that needs only dressing at this stage. I want to be honest that this is an impression, not a final answer. I'll close it with adhesive strips and keep it dry for two days. Come back or go to emergency straight away if the finger turns red, hot or swollen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.3,
      "end_seconds": 319.42,
      "duration_seconds": 3.12,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.3,
      "end_seconds": 324.18,
      "duration_seconds": 3.88,
      "text": "Book a review if it looks red or swollen."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.1,
      "end_seconds": 328.04,
      "duration_seconds": 1.94,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.56,
      "end_seconds": 332.41,
      "duration_seconds": 2.85,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.07,
      "end_seconds": 338.79,
      "duration_seconds": 4.72,
      "text": "Sorry, what was I saying, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.46,
      "end_seconds": 340.8,
      "duration_seconds": 1.34,
      "text": "Look after yourself."
    }
  ]
}