{
  "schema_version": "1.0",
  "encounter_id": "01383",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.06,
      "duration_seconds": 3.42,
      "text": "Oh, morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.47,
      "end_seconds": 10.11,
      "duration_seconds": 4.64,
      "text": "Alright, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.15,
      "end_seconds": 17.0,
      "duration_seconds": 5.85,
      "text": "Um, um, I'm here because of being very thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.72,
      "end_seconds": 19.99,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.07,
      "end_seconds": 35.72,
      "duration_seconds": 13.65,
      "text": "Ever since... since last night, really. Work has been very busy so I kept ignoring it. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.65,
      "end_seconds": 39.95,
      "duration_seconds": 3.3,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.43,
      "end_seconds": 50.74,
      "duration_seconds": 9.31,
      "text": "Maybe a seven out of ten on a bad day. And I've been passing a lot of urine as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.28,
      "end_seconds": 55.5,
      "duration_seconds": 4.22,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.52,
      "end_seconds": 66.83,
      "duration_seconds": 2.31,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.58,
      "end_seconds": 89.58,
      "duration_seconds": 13.0,
      "text": "Okay: BMI works out to 25.7, heart rate 105, height 172 centimetres. And BP is 120 over 70, temperature is 36.5 degrees, saturation 96 percent, weight 76 kilos."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.24,
      "end_seconds": 94.44,
      "duration_seconds": 3.2,
      "text": "Um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.48,
      "end_seconds": 99.69,
      "duration_seconds": 3.21,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.78,
      "end_seconds": 102.77,
      "duration_seconds": 1.99,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.2,
      "end_seconds": 106.31,
      "duration_seconds": 2.11,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.79,
      "end_seconds": 122.75,
      "duration_seconds": 4.96,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.39,
      "end_seconds": 132.34,
      "duration_seconds": 4.95,
      "text": "Good, you can sit up again. Alright, any chest pain or cough?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.56,
      "end_seconds": 141.0,
      "duration_seconds": 5.44,
      "text": "Sorry, what was I saying, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.24,
      "end_seconds": 146.52,
      "duration_seconds": 5.28,
      "text": "Right, right. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.38,
      "end_seconds": 151.3,
      "duration_seconds": 2.92,
      "text": "Oh, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.27,
      "end_seconds": 153.94,
      "duration_seconds": 1.67,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.2,
      "end_seconds": 156.85,
      "duration_seconds": 1.65,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.0,
      "end_seconds": 158.84,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.52,
      "end_seconds": 162.99,
      "duration_seconds": 3.47,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.63,
      "end_seconds": 168.54,
      "duration_seconds": 1.91,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.37,
      "end_seconds": 173.43,
      "duration_seconds": 4.06,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.16,
      "end_seconds": 176.14,
      "duration_seconds": 1.98,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.12,
      "end_seconds": 183.01,
      "duration_seconds": 5.89,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.79,
      "end_seconds": 187.9,
      "duration_seconds": 3.11,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.87,
      "end_seconds": 193.01,
      "duration_seconds": 3.14,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.29,
      "end_seconds": 196.26,
      "duration_seconds": 1.97,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.73,
      "end_seconds": 200.92,
      "duration_seconds": 3.19,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.31,
      "end_seconds": 211.58,
      "duration_seconds": 3.27,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.16,
      "end_seconds": 218.06,
      "duration_seconds": 4.9,
      "text": "I, I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.32,
      "end_seconds": 227.13,
      "duration_seconds": 7.81,
      "text": "Any allergies to tablets, food or anything in the environment? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.52,
      "end_seconds": 231.28,
      "duration_seconds": 2.76,
      "text": "Yes, tramadol. I get vomiting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.46,
      "end_seconds": 242.7,
      "duration_seconds": 3.24,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.16,
      "end_seconds": 247.62,
      "duration_seconds": 3.46,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.69,
      "end_seconds": 265.61,
      "duration_seconds": 2.92,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.61,
      "end_seconds": 273.02,
      "duration_seconds": 5.41,
      "text": "Sorry, what was I saying, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.17,
      "end_seconds": 285.04,
      "duration_seconds": 10.87,
      "text": "Okay, so my impression is this: This looks most like diabetic ketoacidosis. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.69,
      "end_seconds": 288.88,
      "duration_seconds": 3.19,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.1,
      "end_seconds": 311.17,
      "duration_seconds": 17.07,
      "text": "I can't promise yet, but most people with diabetic ketoacidosis do well once it's treated properly. Let me just check I've got this right. You've had being very thirsty, since last night, and no cough or chest pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.1,
      "end_seconds": 313.86,
      "duration_seconds": 1.76,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.87,
      "end_seconds": 342.73,
      "duration_seconds": 10.86,
      "text": "I'll request a blood sugar and ketone test, it'll help with thirst and vomiting. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.68,
      "end_seconds": 346.19,
      "duration_seconds": 1.51,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.97,
      "end_seconds": 376.26,
      "duration_seconds": 29.29,
      "text": "Let's get blood gas and electrolytes, for DKA. That will help us see what's going on underneath and decide the next step. You need to go to hospital now for insulin and fluids. If you cannot get there now, that's the point to come in urgently. Let's plan a check straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.4,
      "end_seconds": 382.52,
      "duration_seconds": 5.12,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.58,
      "end_seconds": 389.77,
      "duration_seconds": 6.19,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.62,
      "end_seconds": 396.71,
      "duration_seconds": 3.09,
      "text": "Great, thank you for your help."
    }
  ]
}