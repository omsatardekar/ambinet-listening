{
  "schema_version": "1.0",
  "encounter_id": "01436",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 6.59,
      "duration_seconds": 6.03,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.63,
      "end_seconds": 12.37,
      "duration_seconds": 3.74,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.54,
      "end_seconds": 22.29,
      "duration_seconds": 3.75,
      "text": "I'm here because of being very thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.78,
      "end_seconds": 27.04,
      "duration_seconds": 3.26,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.61,
      "end_seconds": 31.58,
      "duration_seconds": 2.97,
      "text": "Actually, it's been three days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.14,
      "end_seconds": 36.74,
      "duration_seconds": 3.6,
      "text": "A few quick ones: cough or chest pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.46,
      "end_seconds": 44.76,
      "duration_seconds": 2.3,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.78,
      "end_seconds": 47.96,
      "duration_seconds": 2.18,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.86,
      "end_seconds": 54.32,
      "duration_seconds": 4.46,
      "text": "Oh, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.97,
      "end_seconds": 60.25,
      "duration_seconds": 4.28,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.64,
      "end_seconds": 63.67,
      "duration_seconds": 2.03,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.87,
      "end_seconds": 72.42,
      "duration_seconds": 1.55,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.87,
      "end_seconds": 77.47,
      "duration_seconds": 3.6,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.0,
      "end_seconds": 80.34,
      "duration_seconds": 2.34,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.08,
      "end_seconds": 85.2,
      "duration_seconds": 4.12,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.98,
      "end_seconds": 98.45,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.87,
      "end_seconds": 101.46,
      "duration_seconds": 1.59,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.99,
      "end_seconds": 107.9,
      "duration_seconds": 4.91,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.26,
      "end_seconds": 112.24,
      "duration_seconds": 2.98,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.45,
      "end_seconds": 116.1,
      "duration_seconds": 2.65,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.44,
      "end_seconds": 132.3,
      "duration_seconds": 14.86,
      "text": "I have diabetes, for two years. I've been reading about it online and it worried me. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.83,
      "end_seconds": 145.33,
      "duration_seconds": 3.5,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.43,
      "end_seconds": 151.22,
      "duration_seconds": 3.79,
      "text": "Gliclazide. I take it twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.23,
      "end_seconds": 155.65,
      "duration_seconds": 2.42,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.72,
      "end_seconds": 157.67,
      "duration_seconds": 0.95,
      "text": "80 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.64,
      "end_seconds": 163.99,
      "duration_seconds": 4.35,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.25,
      "end_seconds": 175.31,
      "duration_seconds": 2.06,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.69,
      "end_seconds": 205.45,
      "duration_seconds": 8.76,
      "text": "Okay: pulse is 117 beats a minute, SpO2 96 percent on room air, blood pressure 125 over 75."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.0,
      "end_seconds": 208.61,
      "duration_seconds": 1.61,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.59,
      "end_seconds": 213.59,
      "duration_seconds": 3.0,
      "text": "Alright, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.07,
      "end_seconds": 220.78,
      "duration_seconds": 4.71,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.31,
      "end_seconds": 224.01,
      "duration_seconds": 1.7,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.23,
      "end_seconds": 242.16,
      "duration_seconds": 4.93,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.0,
      "end_seconds": 249.31,
      "duration_seconds": 2.31,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.76,
      "end_seconds": 271.23,
      "duration_seconds": 6.47,
      "text": "From what you've told me and what I found, it points towards diabetic ketoacidosis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.16,
      "end_seconds": 276.89,
      "duration_seconds": 3.73,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.9,
      "end_seconds": 310.43,
      "duration_seconds": 31.53,
      "text": "It's reasonable to be concerned, but right now diabetic ketoacidosis is my leading thought, not anything worse. I'm sending you for a blood sugar and ketone test because of thirst and vomiting. You need to go to hospital now for insulin and fluids. Keep an eye out, and if you cannot get there now, call us the same day or go to emergency. I'll want another look straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.49,
      "end_seconds": 314.2,
      "duration_seconds": 2.71,
      "text": "I think I understand everything. Thanks."
    }
  ]
}