{
  "schema_version": "1.0",
  "encounter_id": "01414",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.39,
      "end_seconds": 5.54,
      "duration_seconds": 4.15,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.64,
      "end_seconds": 11.63,
      "duration_seconds": 3.99,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.51,
      "end_seconds": 20.97,
      "duration_seconds": 7.46,
      "text": "Honestly, it's a swollen painful calf, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.02,
      "end_seconds": 24.98,
      "duration_seconds": 2.96,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.66,
      "end_seconds": 31.04,
      "duration_seconds": 4.38,
      "text": "It's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.02,
      "end_seconds": 43.15,
      "duration_seconds": 10.13,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.21,
      "end_seconds": 51.08,
      "duration_seconds": 5.87,
      "text": "It happens every other day. A seven out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.06,
      "end_seconds": 55.51,
      "duration_seconds": 2.45,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.79,
      "end_seconds": 79.15,
      "duration_seconds": 22.36,
      "text": "Sharp pain when I breathe in goes along with it, you know, most of the time. As for sharp pain when I breathe in, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.02,
      "end_seconds": 84.98,
      "duration_seconds": 3.96,
      "text": "Did you get fever, wheeze or chest tightness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.13,
      "end_seconds": 88.37,
      "duration_seconds": 2.24,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.96,
      "end_seconds": 93.94,
      "duration_seconds": 3.98,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.74,
      "end_seconds": 96.99,
      "duration_seconds": 2.25,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.66,
      "end_seconds": 101.12,
      "duration_seconds": 2.46,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.08,
      "end_seconds": 104.51,
      "duration_seconds": 1.43,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.08,
      "end_seconds": 120.38,
      "duration_seconds": 3.3,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.36,
      "end_seconds": 124.11,
      "duration_seconds": 2.75,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.09,
      "end_seconds": 127.18,
      "duration_seconds": 2.09,
      "text": "Alright, how about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.1,
      "end_seconds": 130.51,
      "duration_seconds": 2.41,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.39,
      "end_seconds": 134.28,
      "duration_seconds": 2.89,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.8,
      "end_seconds": 141.07,
      "duration_seconds": 5.27,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.93,
      "end_seconds": 144.49,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.7,
      "end_seconds": 147.93,
      "duration_seconds": 2.23,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.44,
      "end_seconds": 151.39,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.86,
      "end_seconds": 156.74,
      "duration_seconds": 3.88,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.65,
      "end_seconds": 163.75,
      "duration_seconds": 2.1,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.36,
      "end_seconds": 169.26,
      "duration_seconds": 3.9,
      "text": "I've had eczema for about a year now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.58,
      "end_seconds": 173.43,
      "duration_seconds": 2.85,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.19,
      "end_seconds": 184.44,
      "duration_seconds": 9.25,
      "text": "I had a reaction to amoxicillin when I was younger, a rash all over, and I've avoided it since."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.51,
      "end_seconds": 187.21,
      "duration_seconds": 1.7,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.0,
      "end_seconds": 189.18,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.14,
      "end_seconds": 194.48,
      "duration_seconds": 3.34,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.66,
      "end_seconds": 199.69,
      "duration_seconds": 4.03,
      "text": "Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 215.1,
      "end_seconds": 226.09,
      "duration_seconds": 10.99,
      "text": "Okay, so the vitals from earlier. Pulse is 88 beats a minute, temp 37.0 degrees, SpO2 90 percent on room air, respiratory rate 22, pressure 134 over 85."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.69,
      "end_seconds": 228.22,
      "duration_seconds": 1.53,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 234.01,
      "duration_seconds": 4.56,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.88,
      "end_seconds": 236.87,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.11,
      "end_seconds": 256.47,
      "duration_seconds": 6.36,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.16,
      "end_seconds": 272.54,
      "duration_seconds": 10.38,
      "text": "Right, all finished, thank you. Okay, so my impression is this: It points towards a possible blood clot in the lung."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 273.05,
      "end_seconds": 276.28,
      "duration_seconds": 3.23,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.96,
      "end_seconds": 290.63,
      "duration_seconds": 12.67,
      "text": "I understand the worry. At the moment I'd say it's a possible blood clot in the lung, and we'll know more once the a CT scan of the chest is back."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.24,
      "end_seconds": 317.12,
      "duration_seconds": 15.88,
      "text": "I'd like to arrange a CT scan of the chest for breathlessness. I'd like to arrange a D-dimer blood test for possible clot. You need to go to hospital now for a scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.6,
      "end_seconds": 329.38,
      "duration_seconds": 11.78,
      "text": "Mm, okay. If you feel faint, or you feel really unwell, please come to the emergency department. Book a review straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 330.39,
      "end_seconds": 333.23,
      "duration_seconds": 2.84,
      "text": "I think I understand everything. Thanks."
    }
  ]
}