{
  "schema_version": "1.0",
  "encounter_id": "01063",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 6.16,
      "duration_seconds": 5.32,
      "text": "Let me think, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 11.86,
      "duration_seconds": 3.66,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.94,
      "end_seconds": 18.58,
      "duration_seconds": 4.64,
      "text": "Well, I've been having sudden shortness of breath."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.7,
      "end_seconds": 22.92,
      "duration_seconds": 3.22,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.27,
      "end_seconds": 34.24,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.04,
      "end_seconds": 54.94,
      "duration_seconds": 8.9,
      "text": "Okay: oxygen saturation is 93 percent, BP is 126 over 79, heart rate 101. And respiratory rate 23, temperature 36.9."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.25,
      "end_seconds": 71.19,
      "duration_seconds": 3.94,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.74,
      "end_seconds": 76.69,
      "duration_seconds": 4.95,
      "text": "Around one week... no wait, it's more like three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.08,
      "end_seconds": 88.36,
      "duration_seconds": 10.28,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.86,
      "end_seconds": 95.34,
      "duration_seconds": 5.48,
      "text": "It happens every other day. Yes, breathing in. That makes it worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.21,
      "end_seconds": 99.94,
      "duration_seconds": 3.73,
      "text": "Have you noticed chest tightness, wheeze or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.08,
      "end_seconds": 104.19,
      "duration_seconds": 3.11,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.74,
      "end_seconds": 110.03,
      "duration_seconds": 5.29,
      "text": "I follow. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.03,
      "end_seconds": 118.93,
      "duration_seconds": 4.9,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.33,
      "end_seconds": 125.01,
      "duration_seconds": 4.68,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.13,
      "end_seconds": 130.1,
      "duration_seconds": 3.97,
      "text": "I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.3,
      "end_seconds": 150.18,
      "duration_seconds": 4.88,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.92,
      "end_seconds": 154.63,
      "duration_seconds": 3.71,
      "text": "Right, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.19,
      "end_seconds": 157.57,
      "duration_seconds": 2.38,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.19,
      "end_seconds": 160.94,
      "duration_seconds": 1.75,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.93,
      "end_seconds": 182.59,
      "duration_seconds": 2.66,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.01,
      "end_seconds": 185.94,
      "duration_seconds": 1.93,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.52,
      "end_seconds": 189.3,
      "duration_seconds": 2.78,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.1,
      "end_seconds": 203.61,
      "duration_seconds": 13.51,
      "text": "No, I share a house with my brother. I'm a bus driver, so I sit for long hours. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 209.38,
      "duration_seconds": 3.78,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.0,
      "end_seconds": 213.33,
      "duration_seconds": 2.33,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.83,
      "end_seconds": 237.15,
      "duration_seconds": 7.32,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.64,
      "end_seconds": 252.86,
      "duration_seconds": 11.22,
      "text": "You can sit up now. Having listened and examined, I think we're dealing with a possible blood clot in the lung at this stage."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.12,
      "end_seconds": 256.82,
      "duration_seconds": 2.7,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.43,
      "end_seconds": 269.72,
      "duration_seconds": 12.29,
      "text": "I understand the worry. At the moment I'd say it's a possible blood clot in the lung, and we'll know more once the a D-dimer blood test is back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.64,
      "end_seconds": 294.65,
      "duration_seconds": 10.01,
      "text": "A D-dimer blood test is what I'd like next, for possible clot. We should do a CT scan of the chest for breathlessness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.93,
      "end_seconds": 298.3,
      "duration_seconds": 2.37,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.18,
      "end_seconds": 308.79,
      "duration_seconds": 8.61,
      "text": "You need to go to hospital now for a scan. I think the medical team should see you too."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.51,
      "end_seconds": 312.17,
      "duration_seconds": 1.66,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.14,
      "end_seconds": 319.21,
      "duration_seconds": 5.07,
      "text": "One warning sign to remember: you feel faint. In that case don't wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.73,
      "end_seconds": 323.71,
      "duration_seconds": 2.98,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.13,
      "end_seconds": 330.17,
      "duration_seconds": 5.04,
      "text": "Let's plan a check straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.98,
      "end_seconds": 333.1,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}