{
  "schema_version": "1.0",
  "encounter_id": "01460",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 5.11,
      "duration_seconds": 4.5,
      "text": "Hmm, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 10.82,
      "duration_seconds": 3.93,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.11,
      "end_seconds": 18.68,
      "duration_seconds": 6.57,
      "text": "Honestly, it's trouble passing urine, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 22.37,
      "duration_seconds": 3.17,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.78,
      "end_seconds": 47.07,
      "duration_seconds": 23.29,
      "text": "Okay, so honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down. Hmm, I've had weakness in both legs too, for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.76,
      "end_seconds": 52.92,
      "duration_seconds": 4.16,
      "text": "What about numbness between your legs, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.76,
      "end_seconds": 64.56,
      "duration_seconds": 9.8,
      "text": "Actually, uh, yes, about the same, about three months. Hmm, there's severe lower back pain as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.36,
      "end_seconds": 69.89,
      "duration_seconds": 3.53,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.77,
      "end_seconds": 75.75,
      "duration_seconds": 3.98,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.81,
      "end_seconds": 80.56,
      "duration_seconds": 2.75,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.07,
      "end_seconds": 87.0,
      "duration_seconds": 5.93,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.14,
      "end_seconds": 93.67,
      "duration_seconds": 2.53,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 99.42,
      "duration_seconds": 4.17,
      "text": "I've had epilepsy for about ten years now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.4,
      "end_seconds": 101.1,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.95,
      "end_seconds": 116.5,
      "duration_seconds": 13.55,
      "text": "Sorry, what was I saying, I've had high blood pressure, yes. I have anxiety, for about a year. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.77,
      "end_seconds": 124.29,
      "duration_seconds": 6.52,
      "text": "Yes, epilepsy and anxiety are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.66,
      "end_seconds": 136.08,
      "duration_seconds": 2.42,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.34,
      "end_seconds": 143.57,
      "duration_seconds": 6.23,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.23,
      "end_seconds": 152.91,
      "duration_seconds": 7.68,
      "text": "Any allergies to tablets, food or anything in the environment? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.77,
      "end_seconds": 169.81,
      "duration_seconds": 13.04,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.7,
      "end_seconds": 172.97,
      "duration_seconds": 2.27,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.46,
      "end_seconds": 180.85,
      "duration_seconds": 6.39,
      "text": "It's losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.64,
      "end_seconds": 188.67,
      "duration_seconds": 3.03,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.36,
      "end_seconds": 202.65,
      "duration_seconds": 12.29,
      "text": "About a year now. Escitalopram, 10 milligrams, once a day for the anxiety. I, I used to take lamotrigine, but I stopped it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.78,
      "end_seconds": 216.98,
      "duration_seconds": 3.2,
      "text": "Did you get fever or recent fall?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.49,
      "end_seconds": 222.15,
      "duration_seconds": 4.66,
      "text": "No fever or recent fall, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.87,
      "end_seconds": 227.1,
      "duration_seconds": 3.23,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.67,
      "end_seconds": 229.48,
      "duration_seconds": 1.81,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.41,
      "end_seconds": 235.16,
      "duration_seconds": 3.75,
      "text": "Alright, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.55,
      "end_seconds": 237.63,
      "duration_seconds": 1.08,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.76,
      "end_seconds": 245.62,
      "duration_seconds": 2.86,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.26,
      "end_seconds": 261.92,
      "duration_seconds": 2.66,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.05,
      "end_seconds": 289.62,
      "duration_seconds": 11.57,
      "text": "Okay: SpO2 98 percent on room air, respiratory rate 18. And temperature 36.5, BP is 114 over 81, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.45,
      "end_seconds": 294.53,
      "duration_seconds": 3.08,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.93,
      "end_seconds": 297.68,
      "duration_seconds": 1.75,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.03,
      "end_seconds": 301.83,
      "duration_seconds": 2.8,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.06,
      "end_seconds": 325.31,
      "duration_seconds": 6.25,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.96,
      "end_seconds": 327.61,
      "duration_seconds": 1.65,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.98,
      "end_seconds": 332.15,
      "duration_seconds": 2.17,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.34,
      "end_seconds": 360.28,
      "duration_seconds": 10.94,
      "text": "So, based on the history and the examination, this looks most like possible cauda equina syndrome needing an urgent scan. Another possibility is a large disc prolapse."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.73,
      "end_seconds": 364.11,
      "duration_seconds": 2.38,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.29,
      "end_seconds": 383.02,
      "duration_seconds": 14.73,
      "text": "I can't promise yet, but most people with possible cauda equina syndrome needing an urgent scan do well once it's treated properly. I think an urgent MRI of the spine makes sense here, for possible cauda equina."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 387.79,
      "end_seconds": 390.43,
      "duration_seconds": 2.64,
      "text": "The earliest is Friday, 11:30 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.46,
      "end_seconds": 394.01,
      "duration_seconds": 2.55,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.69,
      "end_seconds": 404.72,
      "duration_seconds": 10.03,
      "text": "You need to go to hospital now for an emergency scan. Let's plan a check straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 406.27,
      "end_seconds": 408.05,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 408.58,
      "end_seconds": 409.96,
      "duration_seconds": 1.38,
      "text": "Take care now."
    }
  ]
}