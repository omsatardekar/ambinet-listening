{
  "schema_version": "1.0",
  "encounter_id": "01315",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.27,
      "duration_seconds": 3.48,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.97,
      "end_seconds": 8.87,
      "duration_seconds": 3.9,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.58,
      "end_seconds": 23.65,
      "duration_seconds": 13.07,
      "text": "Yeah, uh, it's my face drooping on one side. I don't know what's causing it. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.79,
      "end_seconds": 30.18,
      "duration_seconds": 3.39,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.71,
      "end_seconds": 39.73,
      "duration_seconds": 8.02,
      "text": "Actually, it's been two days, I'm fairly sure. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.34,
      "end_seconds": 44.53,
      "duration_seconds": 4.19,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.11,
      "end_seconds": 47.64,
      "duration_seconds": 1.53,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.92,
      "end_seconds": 53.96,
      "duration_seconds": 2.04,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.98,
      "end_seconds": 62.69,
      "duration_seconds": 6.71,
      "text": "When it starts I tend to get weakness in my right arm as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.91,
      "end_seconds": 68.94,
      "duration_seconds": 5.03,
      "text": "Let me check a few things. Any loss of consciousness or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.89,
      "end_seconds": 75.34,
      "duration_seconds": 4.45,
      "text": "No, you know, no loss of consciousness or fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.85,
      "end_seconds": 81.02,
      "duration_seconds": 4.17,
      "text": "So, have you had seizure, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.36,
      "end_seconds": 88.79,
      "duration_seconds": 2.43,
      "text": "No, none, no seizure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 93.97,
      "duration_seconds": 3.38,
      "text": "Right, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.76,
      "end_seconds": 98.1,
      "duration_seconds": 2.34,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.54,
      "end_seconds": 120.18,
      "duration_seconds": 3.64,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.39,
      "end_seconds": 125.5,
      "duration_seconds": 4.11,
      "text": "Actually, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.2,
      "end_seconds": 134.07,
      "duration_seconds": 3.87,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.85,
      "end_seconds": 138.79,
      "duration_seconds": 3.94,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.7,
      "end_seconds": 142.16,
      "duration_seconds": 1.46,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.71,
      "end_seconds": 145.49,
      "duration_seconds": 2.78,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.33,
      "end_seconds": 148.6,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.91,
      "end_seconds": 154.32,
      "duration_seconds": 4.41,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.99,
      "end_seconds": 157.21,
      "duration_seconds": 1.22,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.48,
      "end_seconds": 162.31,
      "duration_seconds": 3.83,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.32,
      "end_seconds": 166.34,
      "duration_seconds": 2.02,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.82,
      "end_seconds": 171.85,
      "duration_seconds": 4.03,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.95,
      "end_seconds": 192.72,
      "duration_seconds": 2.77,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.49,
      "end_seconds": 195.87,
      "duration_seconds": 2.38,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.96,
      "end_seconds": 203.11,
      "duration_seconds": 4.15,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 213.5,
      "duration_seconds": 2.33,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.0,
      "end_seconds": 230.45,
      "duration_seconds": 7.45,
      "text": "Okay: SpO2 97 percent on room air, blood pressure 168 over 89, heart rate 89, temperature 36.7."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.61,
      "end_seconds": 233.13,
      "duration_seconds": 1.52,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.42,
      "end_seconds": 238.15,
      "duration_seconds": 3.73,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.79,
      "end_seconds": 260.15,
      "duration_seconds": 11.36,
      "text": "Right, here's what I'm thinking. I'm honestly not certain yet. It could be a possible stroke, within the treatment window, or it might be a migraine with aura."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.64,
      "end_seconds": 263.55,
      "duration_seconds": 1.91,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.54,
      "end_seconds": 297.8,
      "duration_seconds": 30.26,
      "text": "I can't promise yet, but most people with a possible stroke, within the treatment window do well once it's treated properly. I think a blood sugar test makes sense here, for stroke symptoms. I want an urgent CT scan of the head done, that's for possible stroke. Call an ambulance now, you need hospital immediately. Keep an eye out, and if the symptoms change, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.63,
      "end_seconds": 305.38,
      "duration_seconds": 5.75,
      "text": "I'd like you back straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.14,
      "end_seconds": 311.23,
      "duration_seconds": 4.09,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.81,
      "end_seconds": 313.06,
      "duration_seconds": 1.25,
      "text": "Take care now."
    }
  ]
}