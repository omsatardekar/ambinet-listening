{
  "schema_version": "1.0",
  "encounter_id": "01360",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 7.64,
      "duration_seconds": 6.66,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.54,
      "end_seconds": 14.1,
      "duration_seconds": 4.56,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.71,
      "end_seconds": 17.98,
      "duration_seconds": 3.27,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.88,
      "end_seconds": 23.97,
      "duration_seconds": 4.09,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.32,
      "end_seconds": 31.76,
      "duration_seconds": 4.44,
      "text": "I wanted to get a mild cough looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.02,
      "end_seconds": 40.21,
      "duration_seconds": 4.19,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.53,
      "end_seconds": 48.56,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.14,
      "end_seconds": 72.03,
      "duration_seconds": 10.89,
      "text": "Okay: oxygen saturation is 98 percent, pulse is 81 beats a minute. And blood pressure 122 over 79, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.94,
      "end_seconds": 75.92,
      "duration_seconds": 2.98,
      "text": "Right, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.84,
      "end_seconds": 79.25,
      "duration_seconds": 2.41,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.52,
      "end_seconds": 100.28,
      "duration_seconds": 2.76,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.82,
      "end_seconds": 106.29,
      "duration_seconds": 4.47,
      "text": "Let me think, around three days, I think."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 108.2,
      "end_seconds": 111.96,
      "duration_seconds": 3.76,
      "text": "It was closer to five days, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.88,
      "end_seconds": 118.53,
      "duration_seconds": 4.65,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 122.14,
      "duration_seconds": 2.47,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.92,
      "end_seconds": 127.62,
      "duration_seconds": 1.7,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.13,
      "end_seconds": 134.04,
      "duration_seconds": 4.91,
      "text": "It settles a little with honey and lemon."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.82,
      "end_seconds": 136.4,
      "duration_seconds": 1.58,
      "text": "Have you had sneezing?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.34,
      "end_seconds": 150.37,
      "duration_seconds": 13.03,
      "text": "Yes, about the same, about a month. Mm, as for sneezing, mild, I'd say. There was a scratchy throat, yes, but that went away."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.33,
      "end_seconds": 157.72,
      "duration_seconds": 5.39,
      "text": "A few quick ones: chest pain, ear pain, shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.73,
      "end_seconds": 166.29,
      "duration_seconds": 7.56,
      "text": "Let me think, no, no chest pain, ear pain, shortness of breath or fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.34,
      "end_seconds": 171.12,
      "duration_seconds": 2.78,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.65,
      "end_seconds": 173.4,
      "duration_seconds": 1.75,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.3,
      "end_seconds": 177.94,
      "duration_seconds": 3.64,
      "text": "Alright, has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.94,
      "end_seconds": 180.63,
      "duration_seconds": 1.69,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.22,
      "end_seconds": 187.6,
      "duration_seconds": 2.38,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.18,
      "end_seconds": 189.45,
      "duration_seconds": 1.27,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.43,
      "end_seconds": 191.4,
      "duration_seconds": 0.97,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.61,
      "end_seconds": 201.27,
      "duration_seconds": 2.66,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.18,
      "end_seconds": 203.84,
      "duration_seconds": 1.66,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.01,
      "end_seconds": 222.96,
      "duration_seconds": 1.95,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 224.0,
      "end_seconds": 230.26,
      "duration_seconds": 6.26,
      "text": "He is on throat lozenges, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.96,
      "end_seconds": 233.99,
      "duration_seconds": 3.03,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.78,
      "end_seconds": 240.19,
      "duration_seconds": 4.41,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.95,
      "end_seconds": 244.21,
      "duration_seconds": 2.26,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.77,
      "end_seconds": 247.68,
      "duration_seconds": 2.91,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.2,
      "end_seconds": 251.61,
      "duration_seconds": 2.41,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.35,
      "end_seconds": 256.86,
      "duration_seconds": 3.51,
      "text": "No, um, not at all."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.41,
      "end_seconds": 263.38,
      "duration_seconds": 3.97,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.71,
      "end_seconds": 265.92,
      "duration_seconds": 1.21,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.73,
      "end_seconds": 288.99,
      "duration_seconds": 5.26,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.52,
      "end_seconds": 292.2,
      "duration_seconds": 1.68,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.52,
      "end_seconds": 310.99,
      "duration_seconds": 16.47,
      "text": "Okay, thank you, you can get dressed. Let me tell you where I've got to. It's hard to say. A simple viral cold is one possibility and early flu another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.62,
      "end_seconds": 315.06,
      "duration_seconds": 2.44,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.91,
      "end_seconds": 337.04,
      "duration_seconds": 20.13,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold. Rest, plenty of fluids, and paracetamol if you ache. Let's review you if it is not better in ten days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.5,
      "end_seconds": 343.26,
      "duration_seconds": 4.76,
      "text": "No, um, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.86,
      "end_seconds": 345.14,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}