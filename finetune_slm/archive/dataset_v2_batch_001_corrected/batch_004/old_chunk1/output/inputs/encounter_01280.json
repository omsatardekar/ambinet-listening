{
  "schema_version": "1.0",
  "encounter_id": "01280",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 6.17,
      "duration_seconds": 4.85,
      "text": "Yeah, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.02,
      "end_seconds": 14.01,
      "duration_seconds": 3.99,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.09,
      "end_seconds": 22.48,
      "duration_seconds": 6.39,
      "text": "Hello, you know, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.14,
      "end_seconds": 28.0,
      "duration_seconds": 3.86,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.28,
      "end_seconds": 33.72,
      "duration_seconds": 4.44,
      "text": "Doctor, it's vomiting. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.71,
      "end_seconds": 37.54,
      "duration_seconds": 1.83,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.34,
      "end_seconds": 43.9,
      "duration_seconds": 5.56,
      "text": "Oh, uh, it's been going on for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.42,
      "end_seconds": 48.81,
      "duration_seconds": 3.39,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.6,
      "end_seconds": 54.27,
      "duration_seconds": 3.67,
      "text": "Mostly mild. There's deep fast breathing as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.33,
      "end_seconds": 59.09,
      "duration_seconds": 2.76,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.91,
      "end_seconds": 61.85,
      "duration_seconds": 0.94,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.15,
      "end_seconds": 65.55,
      "duration_seconds": 2.4,
      "text": "Any being very thirsty as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.66,
      "end_seconds": 73.98,
      "duration_seconds": 7.32,
      "text": "Yes, for three days. Tummy pain was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.19,
      "end_seconds": 88.88,
      "duration_seconds": 3.69,
      "text": "A few quick ones: chest pain or cough?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.03,
      "end_seconds": 93.89,
      "duration_seconds": 3.86,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.94,
      "end_seconds": 98.69,
      "duration_seconds": 2.75,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.26,
      "end_seconds": 102.6,
      "duration_seconds": 2.34,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.72,
      "end_seconds": 107.32,
      "duration_seconds": 3.6,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 114.8,
      "duration_seconds": 5.63,
      "text": "My mother had a stroke. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.93,
      "end_seconds": 132.77,
      "duration_seconds": 2.84,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.97,
      "end_seconds": 154.59,
      "duration_seconds": 20.62,
      "text": "I've never touched a cigarette. I used to drink heavily but I stopped four years ago. I'm a bus driver, so I sit for long hours. I swim twice a week. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.15,
      "end_seconds": 159.99,
      "duration_seconds": 2.84,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.46,
      "end_seconds": 172.69,
      "duration_seconds": 9.23,
      "text": "It's gliclazide, 80 milligrams, twice a day. Sorry, what was I saying, I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.24,
      "end_seconds": 178.09,
      "duration_seconds": 4.85,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.87,
      "end_seconds": 181.22,
      "duration_seconds": 2.35,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 182.57,
      "end_seconds": 190.34,
      "duration_seconds": 7.77,
      "text": "Erm, hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.0,
      "end_seconds": 193.82,
      "duration_seconds": 2.82,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.95,
      "end_seconds": 201.11,
      "duration_seconds": 6.16,
      "text": "Fair enough, I'll write down both versions. Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.09,
      "end_seconds": 215.19,
      "duration_seconds": 12.1,
      "text": "I've got diabetes. I told myself I'd wait and see, and here I am. I'm hoping you can tell me something definite. I've got asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.92,
      "end_seconds": 225.12,
      "duration_seconds": 9.2,
      "text": "Right, so diabetes and asthma are already on your record. We'll keep that in mind today. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.01,
      "end_seconds": 241.09,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.66,
      "end_seconds": 261.38,
      "duration_seconds": 10.72,
      "text": "Okay: pulse is 115 beats a minute, blood pressure 125 over 76, SpO2 97 percent on room air, respiratory rate 20."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.14,
      "end_seconds": 264.49,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.62,
      "end_seconds": 268.63,
      "duration_seconds": 3.01,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.54,
      "end_seconds": 275.79,
      "duration_seconds": 4.25,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.7,
      "end_seconds": 278.78,
      "duration_seconds": 2.08,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.68,
      "end_seconds": 301.43,
      "duration_seconds": 4.75,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.76,
      "end_seconds": 306.72,
      "duration_seconds": 2.96,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.03,
      "end_seconds": 324.14,
      "duration_seconds": 4.11,
      "text": "I'll request blood gas and electrolytes, it'll help with DKA."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.4,
      "end_seconds": 327.65,
      "duration_seconds": 2.25,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.32,
      "end_seconds": 348.58,
      "duration_seconds": 20.26,
      "text": "Let's get a blood sugar and ketone test, for thirst and vomiting. You need to go to hospital now for insulin and fluids. We'll refer you to the emergency team. See me again straight away. Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.75,
      "end_seconds": 352.81,
      "duration_seconds": 3.06,
      "text": "I think I understand everything. Thanks."
    }
  ]
}