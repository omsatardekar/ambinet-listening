{
  "schema_version": "1.0",
  "encounter_id": "01286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.57,
      "duration_seconds": 4.48,
      "text": "Erm, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 9.86,
      "duration_seconds": 3.79,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.88,
      "end_seconds": 22.15,
      "duration_seconds": 11.27,
      "text": "Hello, doctor. I'm here with them in case I can help. We came because of my face drooping on one side."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.24,
      "end_seconds": 26.33,
      "duration_seconds": 3.09,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.89,
      "end_seconds": 29.48,
      "duration_seconds": 1.59,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.83,
      "end_seconds": 34.27,
      "duration_seconds": 3.44,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.43,
      "end_seconds": 38.3,
      "duration_seconds": 2.87,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.48,
      "end_seconds": 41.72,
      "duration_seconds": 2.24,
      "text": "Any slurred speech as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.43,
      "end_seconds": 46.37,
      "duration_seconds": 3.94,
      "text": "yes, actually about slurred speech, mostly moderate"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.42,
      "end_seconds": 51.82,
      "duration_seconds": 3.4,
      "text": "has there been a sudden headache too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.74,
      "end_seconds": 54.77,
      "duration_seconds": 1.03,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.5,
      "end_seconds": 57.79,
      "duration_seconds": 1.29,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.33,
      "end_seconds": 62.56,
      "duration_seconds": 3.23,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.17,
      "end_seconds": 67.23,
      "duration_seconds": 4.06,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.71,
      "end_seconds": 72.03,
      "duration_seconds": 3.32,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.5,
      "end_seconds": 75.22,
      "duration_seconds": 1.72,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.2,
      "end_seconds": 82.72,
      "duration_seconds": 3.52,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.61,
      "end_seconds": 87.83,
      "duration_seconds": 3.22,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.04,
      "end_seconds": 93.77,
      "duration_seconds": 4.73,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.27,
      "end_seconds": 98.82,
      "duration_seconds": 3.55,
      "text": "alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.41,
      "end_seconds": 107.05,
      "duration_seconds": 6.64,
      "text": "An irregular heartbeat, for nearly five years. I've got high blood pressure"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.85,
      "end_seconds": 117.93,
      "duration_seconds": 10.08,
      "text": "I follow. Right, so an irregular heartbeat is already on your record. We'll keep that in mind today. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.76,
      "end_seconds": 125.64,
      "duration_seconds": 5.88,
      "text": "yes, I had a meniscus repair on my knee, four years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.69,
      "end_seconds": 129.8,
      "duration_seconds": 2.11,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 130.77,
      "end_seconds": 134.8,
      "duration_seconds": 4.03,
      "text": "It's apixaban, 5 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.37,
      "end_seconds": 138.27,
      "duration_seconds": 2.9,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 139.62,
      "end_seconds": 147.76,
      "duration_seconds": 8.14,
      "text": "For nearly five years. So, it's losartan, 50 milligrams, once a day for my blood pressure, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.5,
      "end_seconds": 161.91,
      "duration_seconds": 4.41,
      "text": "Any fever, loss of consciousness or seizure at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.93,
      "end_seconds": 165.74,
      "duration_seconds": 2.81,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.86,
      "end_seconds": 168.97,
      "duration_seconds": 2.11,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.9,
      "end_seconds": 170.85,
      "duration_seconds": 0.95,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.48,
      "end_seconds": 188.55,
      "duration_seconds": 2.07,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 200.98,
      "duration_seconds": 3.16,
      "text": "alright, keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.66,
      "end_seconds": 228.67,
      "duration_seconds": 12.01,
      "text": "okay: pulse is 72 beats a minute, height 153 centimetres, saturation 96 percent and BMI works out to 32.9, weight 77 kilos, pressure 164 over 91."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.36,
      "end_seconds": 233.66,
      "duration_seconds": 2.3,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.48,
      "end_seconds": 237.34,
      "duration_seconds": 2.86,
      "text": "so, tell me if that's sore"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.4,
      "end_seconds": 251.35,
      "duration_seconds": 6.95,
      "text": "your right face droops, your right arm is weak and your speech is slurred"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.68,
      "end_seconds": 257.76,
      "duration_seconds": 2.08,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.02,
      "end_seconds": 305.14,
      "duration_seconds": 32.12,
      "text": "so, based on the history and the examination, I'd lean towards a possible stroke, within the treatment window. I'd also keep a migraine with aura in mind. I want an urgent CT scan of the head done, that's for possible stroke. Call an ambulance now, you need hospital immediately. If you smoke, this is a good moment to think about stopping, and we can help you with that. We'll catch up straight away"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.38,
      "end_seconds": 311.43,
      "duration_seconds": 5.05,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.09,
      "end_seconds": 314.2,
      "duration_seconds": 2.11,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}