{
  "schema_version": "1.0",
  "encounter_id": "01416",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.27,
      "duration_seconds": 3.3,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.99,
      "end_seconds": 10.26,
      "duration_seconds": 4.27,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.06,
      "end_seconds": 19.65,
      "duration_seconds": 8.59,
      "text": "Yeah, um, it's a red hot swelling on my leg. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.68,
      "end_seconds": 23.95,
      "duration_seconds": 3.27,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.04,
      "end_seconds": 30.21,
      "duration_seconds": 5.17,
      "text": "Around four weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.35,
      "end_seconds": 34.6,
      "duration_seconds": 3.25,
      "text": "Is it it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.53,
      "end_seconds": 40.62,
      "duration_seconds": 4.09,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.43,
      "end_seconds": 44.0,
      "duration_seconds": 2.57,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.66,
      "end_seconds": 48.64,
      "duration_seconds": 2.98,
      "text": "it's a few times a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.11,
      "end_seconds": 52.73,
      "duration_seconds": 3.62,
      "text": "Mm, okay. Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.19,
      "end_seconds": 66.91,
      "duration_seconds": 12.72,
      "text": "it usually comes with dark blisters the dark blisters? That's been for two days. A high fever was there, but it's gone away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.07,
      "end_seconds": 71.44,
      "duration_seconds": 3.37,
      "text": "Have you had any cut or insect bite?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.07,
      "end_seconds": 77.06,
      "duration_seconds": 3.99,
      "text": "No cut or insect bite, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 85.74,
      "duration_seconds": 3.81,
      "text": "Alright, any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.68,
      "end_seconds": 88.25,
      "duration_seconds": 1.57,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.66,
      "end_seconds": 99.35,
      "duration_seconds": 1.69,
      "text": "So, are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.29,
      "end_seconds": 103.07,
      "duration_seconds": 2.78,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.98,
      "end_seconds": 107.24,
      "duration_seconds": 3.26,
      "text": "Alright, do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.47,
      "end_seconds": 112.32,
      "duration_seconds": 3.85,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.83,
      "end_seconds": 116.13,
      "duration_seconds": 2.3,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.91,
      "end_seconds": 121.91,
      "duration_seconds": 2.0,
      "text": "I've had diabetes, yes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.58,
      "end_seconds": 126.39,
      "duration_seconds": 2.81,
      "text": "right, and anything else to add?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.44,
      "end_seconds": 130.28,
      "duration_seconds": 1.84,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.95,
      "end_seconds": 135.52,
      "duration_seconds": 3.57,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.09,
      "end_seconds": 144.77,
      "duration_seconds": 5.68,
      "text": "I'm on something called lans... lansoprazole, 30 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.41,
      "end_seconds": 148.77,
      "duration_seconds": 3.36,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.48,
      "end_seconds": 153.12,
      "duration_seconds": 3.64,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.85,
      "end_seconds": 170.29,
      "duration_seconds": 3.44,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.88,
      "end_seconds": 177.45,
      "duration_seconds": 5.57,
      "text": "I had a caesarean for my second baby nine years ago"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.64,
      "end_seconds": 181.5,
      "duration_seconds": 2.86,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.09,
      "end_seconds": 185.85,
      "duration_seconds": 2.76,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 187.63,
      "end_seconds": 195.35,
      "duration_seconds": 7.72,
      "text": "Okay, so the vitals from earlier. Saturation 97 percent, pulse 92, blood pressure 110 over 76, respiratory rate 19."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.31,
      "end_seconds": 197.23,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.72,
      "end_seconds": 203.87,
      "duration_seconds": 5.15,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.7,
      "end_seconds": 206.94,
      "duration_seconds": 1.24,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.46,
      "end_seconds": 225.61,
      "duration_seconds": 7.15,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.45,
      "end_seconds": 230.38,
      "duration_seconds": 1.93,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.48,
      "end_seconds": 250.3,
      "duration_seconds": 12.82,
      "text": "Right, here's what I'm thinking. I think we're dealing with a severe deep skin infection needing urgent surgery review at this stage. I can't rule out severe cellulitis yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.95,
      "end_seconds": 253.98,
      "duration_seconds": 2.03,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.61,
      "end_seconds": 284.55,
      "duration_seconds": 28.94,
      "text": "Nothing I've seen today points to an emergency. It looks like a severe deep skin infection needing urgent surgery review, but I'd like to confirm. I think urgent blood tests makes sense here, for severe skin infection. We should do an urgent surgical review for possible necrotising infection. I'd rather check than guess, and this is the quickest way to know more. I am sending you to hospital now, do not wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.39,
      "end_seconds": 312.53,
      "duration_seconds": 24.14,
      "text": "We'll refer you to the surgical team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if you cannot go now. Let's plan a check straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.29,
      "end_seconds": 316.88,
      "duration_seconds": 3.59,
      "text": "okay, that makes sense thanks for explaining"
    }
  ]
}