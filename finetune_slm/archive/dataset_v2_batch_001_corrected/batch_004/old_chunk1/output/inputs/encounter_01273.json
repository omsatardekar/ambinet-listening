{
  "schema_version": "1.0",
  "encounter_id": "01273",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.03,
      "duration_seconds": 4.81,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.69,
      "end_seconds": 13.36,
      "duration_seconds": 4.67,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.44,
      "end_seconds": 20.72,
      "duration_seconds": 5.28,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.49,
      "end_seconds": 27.07,
      "duration_seconds": 2.58,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.7,
      "end_seconds": 35.67,
      "duration_seconds": 6.97,
      "text": "It's a sore ankle, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.07,
      "end_seconds": 40.98,
      "duration_seconds": 3.91,
      "text": "So, what's the timeline, when did it it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.66,
      "end_seconds": 45.05,
      "duration_seconds": 2.39,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.69,
      "end_seconds": 54.86,
      "duration_seconds": 9.17,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.87,
      "end_seconds": 70.34,
      "duration_seconds": 13.47,
      "text": "Ice and rest helps a bit. Honestly, a few times a day. Moderate, I'd say. Oh, and a little swelling. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.29,
      "end_seconds": 74.39,
      "duration_seconds": 2.1,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.27,
      "end_seconds": 79.36,
      "duration_seconds": 3.09,
      "text": "Only elevation, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.27,
      "end_seconds": 85.0,
      "duration_seconds": 3.73,
      "text": "Right, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.88,
      "end_seconds": 87.62,
      "duration_seconds": 1.74,
      "text": "Mild, I'd say"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.03,
      "end_seconds": 95.49,
      "duration_seconds": 6.46,
      "text": "Have you had a sore ankle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.69,
      "end_seconds": 103.95,
      "duration_seconds": 7.26,
      "text": "I had a similar thing a couple of years ago. It went away"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.9,
      "end_seconds": 109.76,
      "duration_seconds": 4.86,
      "text": "did you get crack or pop, numbness or pain in the foot?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.89,
      "end_seconds": 117.88,
      "duration_seconds": 6.99,
      "text": "No crack or pop, numbness or pain in the foot, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.42,
      "end_seconds": 122.26,
      "duration_seconds": 3.84,
      "text": "Mm, okay. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.62,
      "end_seconds": 125.08,
      "duration_seconds": 1.46,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.84,
      "end_seconds": 135.48,
      "duration_seconds": 4.64,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.65,
      "end_seconds": 139.41,
      "duration_seconds": 2.76,
      "text": "Yes, I'm allergic to wheat."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.24,
      "end_seconds": 146.38,
      "duration_seconds": 3.14,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 147.59,
      "end_seconds": 160.91,
      "duration_seconds": 13.32,
      "text": "It's escitalopram, 10 milligrams, once a day, doctor. It's Asthalin inhaler, when needed for my asthma, doctor. She takes ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.2,
      "end_seconds": 169.22,
      "duration_seconds": 2.02,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 170.8,
      "end_seconds": 172.09,
      "duration_seconds": 1.29,
      "text": "About two months."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.59,
      "end_seconds": 174.89,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.53,
      "end_seconds": 177.56,
      "duration_seconds": 1.03,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.95,
      "end_seconds": 183.49,
      "duration_seconds": 4.54,
      "text": "alright, tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.43,
      "end_seconds": 186.8,
      "duration_seconds": 1.37,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.43,
      "end_seconds": 188.73,
      "duration_seconds": 1.3,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.97,
      "end_seconds": 198.79,
      "duration_seconds": 8.82,
      "text": "I have asthma, for about ten years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.14,
      "end_seconds": 204.94,
      "duration_seconds": 4.8,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.57,
      "end_seconds": 216.43,
      "duration_seconds": 9.86,
      "text": "I hardly move around during the day. I look after my grandchildren most days. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.51,
      "end_seconds": 233.65,
      "duration_seconds": 3.14,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.72,
      "end_seconds": 243.19,
      "duration_seconds": 2.47,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.2,
      "end_seconds": 271.15,
      "duration_seconds": 12.95,
      "text": "okay: saturation 97 percent, blood pressure 120 over 77. And pulse is 85 beats a minute, weight 54 kilos, respiratory rate 17, height 157 centimetres, temperature is 36.6 degrees"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.04,
      "end_seconds": 296.27,
      "duration_seconds": 12.23,
      "text": "Okay, so my impression from what you've said is this: The most likely explanation is a mild ankle sprain. We shouldn't forget a minor fracture."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.23,
      "end_seconds": 301.57,
      "duration_seconds": 3.34,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.51,
      "end_seconds": 311.49,
      "duration_seconds": 8.98,
      "text": "I understand the worry. At the moment I'd say it's a mild ankle sprain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.64,
      "end_seconds": 339.9,
      "duration_seconds": 18.26,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. One warning sign to remember: you cannot put weight on it. In that case don't wait. Book a review if it is not better in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.11,
      "end_seconds": 343.38,
      "duration_seconds": 2.27,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.38,
      "end_seconds": 349.58,
      "duration_seconds": 1.2,
      "text": "Look after yourself."
    }
  ]
}