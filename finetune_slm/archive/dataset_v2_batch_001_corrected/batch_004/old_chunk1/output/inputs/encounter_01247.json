      "start_seconds": 209.55,
      "end_seconds": 219.52,
      "duration_seconds": 9.97,
      "text": "okay: pulse 91, respiratory rate 17, temp 38.2 degrees, blood pressure 106 over 78, SpO2 95 percent on room air"
    },
