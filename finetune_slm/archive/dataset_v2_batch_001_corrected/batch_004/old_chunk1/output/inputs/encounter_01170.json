{
  "schema_version": "1.0",
  "encounter_id": "01170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 7.93,
      "duration_seconds": 6.85,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.08,
      "end_seconds": 13.71,
      "duration_seconds": 4.63,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.21,
      "end_seconds": 18.85,
      "duration_seconds": 3.64,
      "text": "So, I've been feeling confused, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.39,
      "end_seconds": 23.15,
      "duration_seconds": 2.76,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.9,
      "end_seconds": 26.75,
      "duration_seconds": 2.85,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.06,
      "end_seconds": 31.46,
      "duration_seconds": 3.4,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.0,
      "end_seconds": 52.31,
      "duration_seconds": 19.31,
      "text": "Mostly mild. Oh, and very little urine. That's been about the same, about a month. I've had a racing heart too, for three weeks. Well, there was shaking chills and a high temperature, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.4,
      "end_seconds": 61.01,
      "duration_seconds": 4.61,
      "text": "Have you been feeling confused at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.89,
      "end_seconds": 71.12,
      "duration_seconds": 8.23,
      "text": "Sorry, what was I saying, I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.72,
      "end_seconds": 87.36,
      "duration_seconds": 3.64,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.42,
      "end_seconds": 100.37,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.08,
      "end_seconds": 126.73,
      "duration_seconds": 8.65,
      "text": "Okay: pulse is 89 beats a minute, oxygen saturation is 96 percent. And pressure 126 over 69, respiratory rate 22."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.69,
      "end_seconds": 129.18,
      "duration_seconds": 1.49,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.76,
      "end_seconds": 134.81,
      "duration_seconds": 4.05,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.02,
      "end_seconds": 140.65,
      "duration_seconds": 3.63,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.09,
      "end_seconds": 143.65,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.43,
      "end_seconds": 148.66,
      "duration_seconds": 3.23,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.43,
      "end_seconds": 171.15,
      "duration_seconds": 6.72,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.72,
      "end_seconds": 179.03,
      "duration_seconds": 5.31,
      "text": "Please sit back down. Have you noticed rash, stiff neck or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.95,
      "end_seconds": 183.85,
      "duration_seconds": 3.9,
      "text": "No, no rash, stiff neck or chest pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.92,
      "end_seconds": 186.74,
      "duration_seconds": 1.82,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.43,
      "end_seconds": 189.0,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.07,
      "end_seconds": 194.23,
      "duration_seconds": 3.16,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.23,
      "end_seconds": 198.17,
      "duration_seconds": 1.94,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.52,
      "end_seconds": 213.94,
      "duration_seconds": 2.42,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.9,
      "end_seconds": 229.83,
      "duration_seconds": 13.93,
      "text": "I've had asthma for five years now. Eczema, for about ten years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.93,
      "end_seconds": 232.43,
      "duration_seconds": 1.5,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.52,
      "end_seconds": 242.98,
      "duration_seconds": 8.46,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.73,
      "end_seconds": 249.54,
      "duration_seconds": 4.81,
      "text": "So, it's Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.13,
      "end_seconds": 265.35,
      "duration_seconds": 1.22,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.37,
      "end_seconds": 269.78,
      "duration_seconds": 3.41,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.7,
      "end_seconds": 273.51,
      "duration_seconds": 2.81,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.34,
      "end_seconds": 279.22,
      "duration_seconds": 3.88,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.15,
      "end_seconds": 286.1,
      "duration_seconds": 2.95,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.2,
      "end_seconds": 292.6,
      "duration_seconds": 4.4,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.19,
      "end_seconds": 295.75,
      "duration_seconds": 2.56,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.72,
      "end_seconds": 298.51,
      "duration_seconds": 1.79,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.13,
      "end_seconds": 303.07,
      "duration_seconds": 2.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.23,
      "end_seconds": 307.16,
      "duration_seconds": 2.93,
      "text": "Okay, so no, not at all."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.52,
      "end_seconds": 330.88,
      "duration_seconds": 22.36,
      "text": "So, based on the history and the examination, it fits best with possible sepsis needing urgent treatment. I can't rule out a severe urine or chest infection yet. I'm going to order lactate and blood tests, for sepsis. It's a routine test and it'll give us a much clearer picture."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 332.4,
      "end_seconds": 336.12,
      "duration_seconds": 3.72,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.68,
      "end_seconds": 344.07,
      "duration_seconds": 2.39,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.01,
      "end_seconds": 362.05,
      "duration_seconds": 17.04,
      "text": "I'll request blood cultures, it'll help with fever with low blood pressure. I want to admit you to hospital now for fluids and antibiotics. Come back or go to emergency straight away if you cannot be brought in today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.05,
      "end_seconds": 365.14,
      "duration_seconds": 2.09,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.3,
      "end_seconds": 371.16,
      "duration_seconds": 4.86,
      "text": "Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.46,
      "end_seconds": 376.66,
      "duration_seconds": 4.2,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.52,
      "end_seconds": 378.97,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}