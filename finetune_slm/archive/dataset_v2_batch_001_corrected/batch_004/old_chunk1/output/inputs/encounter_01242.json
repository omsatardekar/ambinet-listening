{
  "schema_version": "1.0",
  "encounter_id": "01242",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 3.78,
      "duration_seconds": 3.17,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.24,
      "end_seconds": 9.24,
      "duration_seconds": 4.0,
      "text": "that's fine, sit down. Tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.98,
      "end_seconds": 18.89,
      "duration_seconds": 8.91,
      "text": "Erm, mainly bloating after meals. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.41,
      "end_seconds": 25.84,
      "duration_seconds": 3.43,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.65,
      "end_seconds": 33.17,
      "duration_seconds": 5.52,
      "text": "Around two days... no wait, it's more like five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.08,
      "end_seconds": 39.46,
      "duration_seconds": 5.38,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.53,
      "end_seconds": 73.67,
      "duration_seconds": 33.14,
      "text": "Yes, large meals and fizzy drinks. That makes it worse. A eight out of ten, I suppose. A neighbour of mine said I should see someone about it. I've never really been one for hospitals. Right, I've also had a lot of wind, for two months. I've had loose stools now and then too, for four weeks. With loose stools now and then, I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 94.47,
      "duration_seconds": 2.76,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.36,
      "end_seconds": 104.88,
      "duration_seconds": 9.52,
      "text": "Escitalopram. I take it 10 milligrams, once a day for the anxiety. I'm on peppermint capsules, after meals."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.4,
      "end_seconds": 112.88,
      "duration_seconds": 3.48,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.21,
      "end_seconds": 119.02,
      "duration_seconds": 4.81,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 126.02,
      "duration_seconds": 6.39,
      "text": "Before we go further, any allergies? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.53,
      "end_seconds": 134.99,
      "duration_seconds": 4.46,
      "text": "um, I don't think I have any, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.08,
      "end_seconds": 151.18,
      "duration_seconds": 4.1,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.71,
      "end_seconds": 157.96,
      "duration_seconds": 2.25,
      "text": "Anxiety, for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.07,
      "end_seconds": 164.15,
      "duration_seconds": 5.08,
      "text": "Hm, okay. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.69,
      "end_seconds": 174.67,
      "duration_seconds": 9.98,
      "text": "Yes, I work in a bakery, early starts. My partner and our baby. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.45,
      "end_seconds": 185.24,
      "duration_seconds": 4.79,
      "text": "Alright, a few quick ones: night-time diarrhoea or weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.7,
      "end_seconds": 191.89,
      "duration_seconds": 5.19,
      "text": "I haven't had night-time diarrhoea or weight loss, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.43,
      "end_seconds": 197.74,
      "duration_seconds": 4.31,
      "text": "Any blood in the stool or vomiting at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.62,
      "end_seconds": 202.0,
      "duration_seconds": 2.38,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.25,
      "end_seconds": 206.1,
      "duration_seconds": 2.85,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.72,
      "end_seconds": 209.17,
      "duration_seconds": 1.45,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.9,
      "end_seconds": 212.86,
      "duration_seconds": 2.96,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.29,
      "end_seconds": 221.4,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.28,
      "end_seconds": 249.6,
      "duration_seconds": 8.32,
      "text": "Okay: oxygen saturation is 98 percent, temperature is 36.5 degrees, heart rate 81. And pressure 115 over 77."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.36,
      "end_seconds": 252.32,
      "duration_seconds": 1.96,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.03,
      "end_seconds": 256.43,
      "duration_seconds": 2.4,
      "text": "we'll go over that shortly"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.09,
      "end_seconds": 263.54,
      "duration_seconds": 4.45,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.44,
      "end_seconds": 267.55,
      "duration_seconds": 2.11,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.89,
      "end_seconds": 283.79,
      "duration_seconds": 5.9,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.45,
      "end_seconds": 290.15,
      "duration_seconds": 1.7,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.5,
      "end_seconds": 317.32,
      "duration_seconds": 11.82,
      "text": "Taking everything into account, this looks most like a functional bowel pattern, with no alarm features. I think a coeliac blood test makes sense here, for bloating."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.4,
      "end_seconds": 320.8,
      "duration_seconds": 2.4,
      "text": "the earliest is Friday, 2 pm"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.24,
      "end_seconds": 331.4,
      "duration_seconds": 9.16,
      "text": "Try smaller meals and keep a food and symptom diary for four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.31,
      "end_seconds": 337.17,
      "duration_seconds": 3.86,
      "text": "ah, good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.46,
      "end_seconds": 339.85,
      "duration_seconds": 1.39,
      "text": "Look after yourself."
    }
  ]
}