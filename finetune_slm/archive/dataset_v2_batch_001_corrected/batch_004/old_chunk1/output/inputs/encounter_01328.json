{
  "schema_version": "1.0",
  "encounter_id": "01328",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.81,
      "duration_seconds": 3.67,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 11.05,
      "duration_seconds": 4.98,
      "text": "right, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.41,
      "end_seconds": 22.77,
      "duration_seconds": 6.36,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.61,
      "end_seconds": 26.68,
      "duration_seconds": 2.07,
      "text": "It's skipped beats, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.57,
      "end_seconds": 28.78,
      "duration_seconds": 1.21,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.19,
      "end_seconds": 34.35,
      "duration_seconds": 4.16,
      "text": "Yeah, it's been about four days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.39,
      "end_seconds": 44.46,
      "duration_seconds": 9.07,
      "text": "so, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.34,
      "end_seconds": 55.24,
      "duration_seconds": 8.9,
      "text": "It's worse with lying down. About a seven out of ten. Deep breaths helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.83,
      "end_seconds": 64.32,
      "duration_seconds": 8.49,
      "text": "I mean, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 64.42,
      "end_seconds": 70.46,
      "duration_seconds": 6.04,
      "text": "tell the doctor about the the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.44,
      "end_seconds": 75.82,
      "duration_seconds": 3.38,
      "text": "well, I was getting to that!"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.1,
      "end_seconds": 80.6,
      "duration_seconds": 3.5,
      "text": "have you had a flutter in your chest?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.86,
      "end_seconds": 86.03,
      "duration_seconds": 1.17,
      "text": "mm, yes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.04,
      "end_seconds": 90.93,
      "duration_seconds": 3.89,
      "text": "Alright, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.8,
      "end_seconds": 94.07,
      "duration_seconds": 1.27,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 94.86,
      "end_seconds": 97.34,
      "duration_seconds": 2.48,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.33,
      "end_seconds": 106.78,
      "duration_seconds": 4.45,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.69,
      "end_seconds": 111.84,
      "duration_seconds": 4.15,
      "text": "Hydrocortisone cream, when needed for the eczema"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 113.75,
      "end_seconds": 120.37,
      "duration_seconds": 6.62,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.88,
      "end_seconds": 129.18,
      "duration_seconds": 7.3,
      "text": "Let me think, I take sertraline, once a day for my mood."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.43,
      "end_seconds": 132.43,
      "duration_seconds": 2.0,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.57,
      "end_seconds": 146.22,
      "duration_seconds": 12.65,
      "text": "50 milligrams. Herbal calming tea. I take it in the evening. I, I'd been on escitalopram, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.49,
      "end_seconds": 151.68,
      "duration_seconds": 4.19,
      "text": "okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.14,
      "end_seconds": 167.04,
      "duration_seconds": 13.9,
      "text": "Hmm, um, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.32,
      "end_seconds": 172.15,
      "duration_seconds": 3.83,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.83,
      "end_seconds": 189.88,
      "duration_seconds": 16.05,
      "text": "I've had eczema for nearly five years now. I'd rather not end up on lots of tablets if I can avoid it. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.13,
      "end_seconds": 192.1,
      "duration_seconds": 0.97,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.41,
      "end_seconds": 195.95,
      "duration_seconds": 2.54,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.46,
      "end_seconds": 201.71,
      "duration_seconds": 5.25,
      "text": "Yes, eczema is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.79,
      "end_seconds": 213.56,
      "duration_seconds": 1.77,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.56,
      "end_seconds": 219.96,
      "duration_seconds": 5.4,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.01,
      "end_seconds": 226.62,
      "duration_seconds": 4.61,
      "text": "So, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.7,
      "end_seconds": 232.38,
      "duration_seconds": 3.68,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.55,
      "end_seconds": 240.85,
      "duration_seconds": 7.3,
      "text": "Let me check a few things. Any dizziness, chest pain, shortness of breath or fainting?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.53,
      "end_seconds": 258.11,
      "duration_seconds": 15.58,
      "text": "No, no dizziness, no chest pain, no shortness of breath. I did have being a bit anxious at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 261.85,
      "duration_seconds": 1.74,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.86,
      "end_seconds": 265.84,
      "duration_seconds": 1.98,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_6",
      "role": "NURSE",
      "start_seconds": 267.86,
      "end_seconds": 274.63,
      "duration_seconds": 6.77,
      "text": "okay, so the vitals from earlier. Pulse is 68 beats a minute, blood pressure 113 over 75."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.47,
      "end_seconds": 279.55,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.78,
      "end_seconds": 284.07,
      "duration_seconds": 3.29,
      "text": "Let's move on to the the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.71,
      "end_seconds": 285.78,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.87,
      "end_seconds": 288.69,
      "duration_seconds": 1.82,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.62,
      "end_seconds": 308.63,
      "duration_seconds": 4.01,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.51,
      "end_seconds": 313.1,
      "duration_seconds": 1.59,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.66,
      "end_seconds": 339.6,
      "duration_seconds": 8.94,
      "text": "putting it all together, the most likely explanation is harmless extra heartbeats. Another possibility is an anxiety-related palpitation"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.35,
      "end_seconds": 346.84,
      "duration_seconds": 5.49,
      "text": "let me think, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.09,
      "end_seconds": 359.45,
      "duration_seconds": 11.36,
      "text": "Nothing I've seen today points to an emergency. It looks like harmless extra heartbeats, but I'd like to confirm. I'd like to arrange an ECG for palpitations."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.82,
      "end_seconds": 363.15,
      "duration_seconds": 2.33,
      "text": "okay, I'll do it"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.39,
      "end_seconds": 378.58,
      "duration_seconds": 14.19,
      "text": "cut back on coffee and energy drinks and keep a diary of when it happens let's plan a check if it carries on after a month alright, what are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.16,
      "end_seconds": 387.62,
      "duration_seconds": 8.46,
      "text": "So, um, I come back if it carries on after a month. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.04,
      "end_seconds": 395.39,
      "duration_seconds": 6.35,
      "text": "yes, exactly right is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.71,
      "end_seconds": 400.51,
      "duration_seconds": 3.8,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.76,
      "end_seconds": 403.59,
      "duration_seconds": 1.83,
      "text": "Have a good day."
    }
  ]
}