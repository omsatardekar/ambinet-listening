{
  "schema_version": "1.0",
  "encounter_id": "01009",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.15,
      "duration_seconds": 3.94,
      "text": "Well, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 11.82,
      "duration_seconds": 5.13,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.72,
      "end_seconds": 17.56,
      "duration_seconds": 4.84,
      "text": "It's a red hot swelling on my leg, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.06,
      "end_seconds": 20.82,
      "duration_seconds": 1.76,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.4,
      "end_seconds": 24.64,
      "duration_seconds": 3.24,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.22,
      "end_seconds": 28.14,
      "duration_seconds": 2.92,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.89,
      "end_seconds": 30.52,
      "duration_seconds": 1.63,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.24,
      "end_seconds": 42.36,
      "duration_seconds": 3.12,
      "text": "Have you noticed insect bite or cut?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.88,
      "end_seconds": 44.86,
      "duration_seconds": 1.98,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.5,
      "end_seconds": 47.75,
      "duration_seconds": 2.25,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.48,
      "end_seconds": 51.28,
      "duration_seconds": 1.8,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.88,
      "end_seconds": 54.95,
      "duration_seconds": 2.07,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.2,
      "end_seconds": 58.08,
      "duration_seconds": 1.88,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.76,
      "end_seconds": 60.97,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.93,
      "end_seconds": 65.74,
      "duration_seconds": 2.81,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.02,
      "end_seconds": 79.76,
      "duration_seconds": 2.74,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.5,
      "end_seconds": 82.98,
      "duration_seconds": 1.48,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.26,
      "end_seconds": 88.76,
      "duration_seconds": 4.5,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.3,
      "end_seconds": 96.04,
      "duration_seconds": 5.74,
      "text": "Sorry, what was I saying, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.2,
      "end_seconds": 116.1,
      "duration_seconds": 3.9,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 127.5,
      "duration_seconds": 9.43,
      "text": "Glibenclamide, 5 milligrams, before breakfast for my sugar. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.08,
      "end_seconds": 129.53,
      "duration_seconds": 1.45,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.33,
      "end_seconds": 134.18,
      "duration_seconds": 2.85,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.98,
      "end_seconds": 141.25,
      "duration_seconds": 1.27,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.8,
      "end_seconds": 146.65,
      "duration_seconds": 3.85,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.37,
      "end_seconds": 150.09,
      "duration_seconds": 2.72,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.88,
      "end_seconds": 155.31,
      "duration_seconds": 3.43,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.5,
      "end_seconds": 161.95,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.72,
      "end_seconds": 166.99,
      "duration_seconds": 3.27,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.53,
      "end_seconds": 169.91,
      "duration_seconds": 2.38,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.85,
      "end_seconds": 175.04,
      "duration_seconds": 4.19,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.31,
      "end_seconds": 188.25,
      "duration_seconds": 2.94,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.18,
      "end_seconds": 200.07,
      "duration_seconds": 2.89,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.56,
      "end_seconds": 220.85,
      "duration_seconds": 6.29,
      "text": "Okay: heart rate 93, weight 95 kilos, height 182 centimetres, BP is 114 over 77."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.1,
      "end_seconds": 226.59,
      "duration_seconds": 3.49,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.15,
      "end_seconds": 227.85,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.73,
      "end_seconds": 232.09,
      "duration_seconds": 2.36,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.27,
      "end_seconds": 255.34,
      "duration_seconds": 7.07,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.19,
      "end_seconds": 280.1,
      "duration_seconds": 18.91,
      "text": "That's all I needed to check. Right, here's what I'm thinking. The most likely explanation is a severe deep skin infection needing urgent surgery review. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.62,
      "end_seconds": 283.85,
      "duration_seconds": 2.23,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.54,
      "end_seconds": 321.32,
      "duration_seconds": 33.78,
      "text": "It's reasonable to be concerned, but right now a severe deep skin infection needing urgent surgery review is my leading thought, not anything worse. I'll request urgent blood tests, it'll help with severe skin infection. An urgent surgical review is what I'd like next, for possible necrotising infection. I am sending you to hospital now, do not wait. Come back or go to emergency straight away if you cannot go now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.57,
      "end_seconds": 324.1,
      "duration_seconds": 1.53,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.61,
      "end_seconds": 333.93,
      "duration_seconds": 8.32,
      "text": "Please come and see me straight away. Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.89,
      "end_seconds": 338.38,
      "duration_seconds": 2.49,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}