{
  "schema_version": "1.0",
  "encounter_id": "01158",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 8.06,
      "duration_seconds": 6.99,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.4,
      "end_seconds": 13.64,
      "duration_seconds": 4.24,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.9,
      "end_seconds": 18.96,
      "duration_seconds": 4.06,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.09,
      "end_seconds": 23.6,
      "duration_seconds": 3.51,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.24,
      "end_seconds": 36.9,
      "duration_seconds": 11.66,
      "text": "I wanted to get an itchy patch on my wrist looked at. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.42,
      "end_seconds": 41.94,
      "duration_seconds": 3.52,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.67,
      "end_seconds": 46.24,
      "duration_seconds": 2.57,
      "text": "Around three weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 47.8,
      "end_seconds": 51.69,
      "duration_seconds": 3.89,
      "text": "Hm, I'd say more like a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.42,
      "end_seconds": 56.79,
      "duration_seconds": 4.37,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.43,
      "end_seconds": 60.5,
      "duration_seconds": 2.07,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.37,
      "end_seconds": 65.98,
      "duration_seconds": 4.61,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.24,
      "end_seconds": 89.56,
      "duration_seconds": 22.32,
      "text": "I notice it more with my new watch strap. It comes and goes. Pretty mild, if I'm being honest. I've also had dry flaky skin. With dry flaky skin, it's severe, honestly. Hmm, there's a bit of redness as well."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.93,
      "end_seconds": 98.89,
      "duration_seconds": 7.96,
      "text": "Have you had an itchy patch on your wrist before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.48,
      "end_seconds": 106.08,
      "duration_seconds": 5.6,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.13,
      "end_seconds": 113.15,
      "duration_seconds": 5.02,
      "text": "Let me check a few things. Any blisters, fever or spreading?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.19,
      "end_seconds": 117.61,
      "duration_seconds": 2.42,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.19,
      "end_seconds": 120.06,
      "duration_seconds": 1.87,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.66,
      "end_seconds": 123.78,
      "duration_seconds": 2.12,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.21,
      "end_seconds": 131.62,
      "duration_seconds": 1.41,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.34,
      "end_seconds": 137.5,
      "duration_seconds": 4.16,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.36,
      "end_seconds": 139.75,
      "duration_seconds": 1.39,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.63,
      "end_seconds": 144.94,
      "duration_seconds": 3.31,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.42,
      "end_seconds": 148.86,
      "duration_seconds": 2.44,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.81,
      "end_seconds": 154.72,
      "duration_seconds": 4.91,
      "text": "I, I have high cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.41,
      "end_seconds": 158.31,
      "duration_seconds": 1.9,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.9,
      "end_seconds": 162.82,
      "duration_seconds": 3.92,
      "text": "I have thin bones, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.51,
      "end_seconds": 182.95,
      "duration_seconds": 2.44,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.72,
      "end_seconds": 197.71,
      "duration_seconds": 13.99,
      "text": "I take simvastatin, 20 milligrams, at night. Alendronate. I take it 70 milligrams, once a week for my bones. I used to take rosuvastatin, but I stopped it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.74,
      "end_seconds": 202.87,
      "duration_seconds": 3.13,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.53,
      "end_seconds": 209.56,
      "duration_seconds": 6.03,
      "text": "My father had bowel cancer. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.03,
      "end_seconds": 214.02,
      "duration_seconds": 2.99,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.52,
      "end_seconds": 222.62,
      "duration_seconds": 3.1,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 233.75,
      "end_seconds": 242.06,
      "duration_seconds": 8.31,
      "text": "Doctor, I've got the readings for you. BP is 122 over 76, pulse 73, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.17,
      "end_seconds": 243.87,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.77,
      "end_seconds": 247.97,
      "duration_seconds": 2.2,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 251.2,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.11,
      "end_seconds": 272.63,
      "duration_seconds": 6.52,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.86,
      "end_seconds": 281.07,
      "duration_seconds": 1.21,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.41,
      "end_seconds": 300.81,
      "duration_seconds": 15.4,
      "text": "Okay, please sit back down. Let me tell you where I've got to. I think we're dealing with mild contact dermatitis from the watch strap at this stage. We shouldn't forget eczema."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.65,
      "end_seconds": 305.01,
      "duration_seconds": 2.36,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.15,
      "end_seconds": 338.39,
      "duration_seconds": 32.24,
      "text": "I understand the worry. At the moment I'd say it's mild contact dermatitis from the watch strap, and we'll watch how it goes. You'll be taking hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis. I'll put all of this in writing so you don't have to remember it. Stop wearing that strap and keep the skin moisturised. See me again if it has not cleared in two weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.28,
      "end_seconds": 343.24,
      "duration_seconds": 1.96,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.77,
      "end_seconds": 347.86,
      "duration_seconds": 4.09,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.99,
      "end_seconds": 362.45,
      "duration_seconds": 13.46,
      "text": "So, I take the hydrocortisone cream, 1%, once a day and come back if it has not cleared in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.47,
      "end_seconds": 367.67,
      "duration_seconds": 4.2,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.97,
      "end_seconds": 372.51,
      "duration_seconds": 3.54,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}