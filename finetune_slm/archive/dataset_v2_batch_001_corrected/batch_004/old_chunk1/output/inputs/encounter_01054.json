{
  "schema_version": "1.0",
  "encounter_id": "01054",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.33,
      "duration_seconds": 4.52,
      "text": "Actually, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.53,
      "duration_seconds": 4.18,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 16.08,
      "duration_seconds": 4.56,
      "text": "So the thing is, I've got being very thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.38,
      "end_seconds": 20.44,
      "duration_seconds": 3.06,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.09,
      "end_seconds": 29.55,
      "duration_seconds": 8.46,
      "text": "I've had it since Friday. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.71,
      "end_seconds": 32.68,
      "duration_seconds": 1.97,
      "text": "Has there been vomiting too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.16,
      "end_seconds": 35.71,
      "duration_seconds": 1.55,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.21,
      "end_seconds": 39.94,
      "duration_seconds": 3.73,
      "text": "Hm, okay. Did you get chest pain or cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.58,
      "end_seconds": 43.94,
      "duration_seconds": 3.36,
      "text": "No, no chest pain or cough."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.01,
      "end_seconds": 47.89,
      "duration_seconds": 2.88,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.88,
      "end_seconds": 49.85,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.89,
      "end_seconds": 55.79,
      "duration_seconds": 3.9,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.24,
      "end_seconds": 61.24,
      "duration_seconds": 4.0,
      "text": "No, you know, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.92,
      "end_seconds": 64.63,
      "duration_seconds": 2.71,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 69.67,
      "duration_seconds": 3.24,
      "text": "Actually, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.65,
      "end_seconds": 89.13,
      "duration_seconds": 4.48,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.92,
      "end_seconds": 92.79,
      "duration_seconds": 2.87,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.53,
      "end_seconds": 96.48,
      "duration_seconds": 2.95,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.04,
      "end_seconds": 100.08,
      "duration_seconds": 3.04,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.16,
      "end_seconds": 118.95,
      "duration_seconds": 2.79,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.44,
      "end_seconds": 133.85,
      "duration_seconds": 13.41,
      "text": "I've got diabetes. I didn't want to bother you but it keeps coming back. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.6,
      "end_seconds": 139.8,
      "duration_seconds": 4.2,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.77,
      "end_seconds": 146.54,
      "duration_seconds": 2.77,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.16,
      "end_seconds": 149.17,
      "duration_seconds": 2.01,
      "text": "Alright, how about smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.26,
      "end_seconds": 155.08,
      "duration_seconds": 3.82,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.37,
      "end_seconds": 157.77,
      "duration_seconds": 1.4,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.06,
      "end_seconds": 164.26,
      "duration_seconds": 5.2,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.69,
      "end_seconds": 167.65,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.33,
      "end_seconds": 170.7,
      "duration_seconds": 2.37,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 173.45,
      "duration_seconds": 1.3,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.98,
      "end_seconds": 177.55,
      "duration_seconds": 3.57,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.05,
      "end_seconds": 180.98,
      "duration_seconds": 2.93,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.14,
      "end_seconds": 192.99,
      "duration_seconds": 2.85,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.69,
      "end_seconds": 224.21,
      "duration_seconds": 10.52,
      "text": "Okay: height 183 centimetres, pulse 113, weight 61 kilos, BMI works out to 18.2, temperature is 36.5 degrees, pressure 114 over 72."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.52,
      "end_seconds": 229.33,
      "duration_seconds": 3.81,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.73,
      "end_seconds": 234.05,
      "duration_seconds": 3.32,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.78,
      "end_seconds": 246.8,
      "duration_seconds": 4.02,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.71,
      "end_seconds": 252.39,
      "duration_seconds": 1.68,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.1,
      "end_seconds": 301.56,
      "duration_seconds": 32.46,
      "text": "Right, here's what I'm thinking. My working impression is diabetic ketoacidosis. I want to be honest that this is an impression, not a final answer. I think blood gas and electrolytes makes sense here, for DKA. You need to go to hospital now for insulin and fluids. I think the emergency team should see you too. One warning sign to remember: you cannot get there now. In that case don't wait."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.1,
      "end_seconds": 303.45,
      "duration_seconds": 1.35,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.38,
      "end_seconds": 306.52,
      "duration_seconds": 2.14,
      "text": "We'll catch up straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.4,
      "end_seconds": 313.24,
      "duration_seconds": 1.84,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.01,
      "end_seconds": 319.02,
      "duration_seconds": 5.01,
      "text": "Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.25,
      "end_seconds": 324.52,
      "duration_seconds": 3.27,
      "text": "Right, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.08,
      "end_seconds": 326.36,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}