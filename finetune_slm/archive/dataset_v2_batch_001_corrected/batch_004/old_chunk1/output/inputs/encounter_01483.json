{
  "schema_version": "1.0",
  "encounter_id": "01483",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.0,
      "duration_seconds": 2.1,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.77,
      "end_seconds": 7.89,
      "duration_seconds": 3.12,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.05,
      "end_seconds": 10.35,
      "duration_seconds": 1.3,
      "text": "Was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.81,
      "end_seconds": 16.53,
      "duration_seconds": 4.72,
      "text": "Yeah, not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.68,
      "end_seconds": 20.11,
      "duration_seconds": 2.43,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.66,
      "end_seconds": 28.59,
      "duration_seconds": 6.93,
      "text": "Doctor, it's an itchy patch on my wrist. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.41,
      "end_seconds": 33.46,
      "duration_seconds": 3.05,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.17,
      "end_seconds": 37.98,
      "duration_seconds": 2.81,
      "text": "I've had it since last weekend."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.77,
      "end_seconds": 44.98,
      "duration_seconds": 5.21,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.85,
      "end_seconds": 54.58,
      "duration_seconds": 6.73,
      "text": "Severe, I'd say. It comes and goes. There's a bit of redness as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.25,
      "end_seconds": 59.77,
      "duration_seconds": 4.52,
      "text": "Let me check a few things. Any fever, spreading or blisters?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.53,
      "end_seconds": 64.77,
      "duration_seconds": 3.24,
      "text": "No, no fever, spreading or blisters."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.0,
      "end_seconds": 68.45,
      "duration_seconds": 2.45,
      "text": "Right, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.49,
      "end_seconds": 75.61,
      "duration_seconds": 2.12,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.26,
      "end_seconds": 79.1,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.08,
      "end_seconds": 83.07,
      "duration_seconds": 1.99,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.57,
      "end_seconds": 89.54,
      "duration_seconds": 4.97,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.12,
      "end_seconds": 95.12,
      "duration_seconds": 5.0,
      "text": "A plain moisturiser. I take it twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.69,
      "end_seconds": 100.13,
      "duration_seconds": 3.44,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.59,
      "end_seconds": 104.45,
      "duration_seconds": 2.86,
      "text": "No, you know, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.99,
      "end_seconds": 109.88,
      "duration_seconds": 4.89,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.93,
      "end_seconds": 113.8,
      "duration_seconds": 1.87,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.7,
      "end_seconds": 130.12,
      "duration_seconds": 1.42,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.6,
      "end_seconds": 135.5,
      "duration_seconds": 3.9,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.55,
      "end_seconds": 138.78,
      "duration_seconds": 1.23,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.75,
      "end_seconds": 143.71,
      "duration_seconds": 2.96,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.86,
      "end_seconds": 149.13,
      "duration_seconds": 2.27,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.27,
      "end_seconds": 154.73,
      "duration_seconds": 4.46,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.6,
      "end_seconds": 159.24,
      "duration_seconds": 2.64,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.84,
      "end_seconds": 164.3,
      "duration_seconds": 3.46,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.39,
      "end_seconds": 176.1,
      "duration_seconds": 3.71,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.27,
      "end_seconds": 189.63,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.5,
      "end_seconds": 215.53,
      "duration_seconds": 9.03,
      "text": "Okay: respiratory rate 14, heart rate 81, SpO2 98 percent on room air. And temperature 36.9, BP is 121 over 81."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.18,
      "end_seconds": 218.86,
      "duration_seconds": 1.68,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.96,
      "end_seconds": 224.08,
      "duration_seconds": 4.12,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.7,
      "end_seconds": 230.36,
      "duration_seconds": 3.66,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.88,
      "end_seconds": 241.58,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.03,
      "end_seconds": 245.5,
      "duration_seconds": 2.47,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.36,
      "end_seconds": 266.99,
      "duration_seconds": 5.63,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.58,
      "end_seconds": 268.28,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.46,
      "end_seconds": 275.61,
      "duration_seconds": 2.15,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.75,
      "end_seconds": 309.92,
      "duration_seconds": 27.17,
      "text": "So, based on the history and the examination, I think we're dealing with mild contact dermatitis from the watch strap at this stage. You'll be taking hydrocortisone cream, 1%, once a day, one week. It's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. If it spreads or blisters, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.42,
      "end_seconds": 311.98,
      "duration_seconds": 1.56,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.37,
      "end_seconds": 322.37,
      "duration_seconds": 9.0,
      "text": "I'd like to see you again if it has not cleared in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.53,
      "end_seconds": 325.83,
      "duration_seconds": 2.3,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}