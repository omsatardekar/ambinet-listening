{
  "schema_version": "1.0",
  "encounter_id": "01279",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.88,
      "end_seconds": 7.31,
      "duration_seconds": 6.43,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.92,
      "end_seconds": 12.17,
      "duration_seconds": 3.25,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 18.73,
      "duration_seconds": 5.98,
      "text": "Um, so... a dry cough in the evenings. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.27,
      "end_seconds": 23.25,
      "duration_seconds": 2.98,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.47,
      "end_seconds": 27.16,
      "duration_seconds": 2.69,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.26,
      "end_seconds": 33.18,
      "duration_seconds": 4.92,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.88,
      "end_seconds": 39.99,
      "duration_seconds": 5.11,
      "text": "Only antihistamine, and it's not much. Moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.93,
      "end_seconds": 46.05,
      "duration_seconds": 4.12,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.37,
      "end_seconds": 52.37,
      "duration_seconds": 3.0,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.32,
      "end_seconds": 65.39,
      "duration_seconds": 3.07,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.35,
      "end_seconds": 78.21,
      "duration_seconds": 10.86,
      "text": "Yes, I work in a bakery, early starts. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.61,
      "end_seconds": 93.84,
      "duration_seconds": 2.23,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.9,
      "end_seconds": 97.78,
      "duration_seconds": 2.88,
      "text": "I have depression, for five years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.01,
      "end_seconds": 101.92,
      "duration_seconds": 2.91,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.79,
      "end_seconds": 104.83,
      "duration_seconds": 1.04,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.38,
      "end_seconds": 124.49,
      "duration_seconds": 3.11,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.37,
      "end_seconds": 132.91,
      "duration_seconds": 6.54,
      "text": "It's sertraline, 50 milligrams, once a day. Loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.87,
      "end_seconds": 136.96,
      "duration_seconds": 3.09,
      "text": "Have you had wheeze, by any chance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.0,
      "end_seconds": 143.33,
      "duration_seconds": 5.33,
      "text": "Sorry, what was I saying, not at all, no wheeze."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.11,
      "end_seconds": 150.04,
      "duration_seconds": 4.93,
      "text": "Right, a few quick ones: shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.98,
      "end_seconds": 154.83,
      "duration_seconds": 3.85,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.67,
      "end_seconds": 158.91,
      "duration_seconds": 2.24,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.52,
      "end_seconds": 164.58,
      "duration_seconds": 2.06,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 166.35,
      "end_seconds": 184.99,
      "duration_seconds": 18.64,
      "text": "Okay, so the vitals from earlier. Temperature is 36.5 degrees, BP is 116 over 69. Weight 73 kilos, respiratory rate 14, heart rate 67, BMI works out to 29.6, height 157 centimetres, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.7,
      "end_seconds": 186.65,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.44,
      "end_seconds": 192.6,
      "duration_seconds": 3.16,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.7,
      "end_seconds": 196.29,
      "duration_seconds": 2.59,
      "text": "Yeah, you know, no problem."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.39,
      "end_seconds": 199.16,
      "duration_seconds": 1.77,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.75,
      "end_seconds": 214.92,
      "duration_seconds": 5.17,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.1,
      "end_seconds": 220.11,
      "duration_seconds": 2.01,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.47,
      "end_seconds": 248.24,
      "duration_seconds": 11.77,
      "text": "Okay, thinking it through, I don't have a clear answer today: seasonal hay fever causing the cough is possible, and so is early asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.96,
      "end_seconds": 251.65,
      "duration_seconds": 1.69,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.09,
      "end_seconds": 289.49,
      "duration_seconds": 36.4,
      "text": "I understand the worry. At the moment I'd say it's seasonal hay fever causing the cough, and we'll watch how it goes. I'll start you on fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever. Keep windows closed on high-pollen days and wash your hair at night. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.52,
      "end_seconds": 292.91,
      "duration_seconds": 2.39,
      "text": "Book a review in a month."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 295.75,
      "end_seconds": 297.85,
      "duration_seconds": 2.1,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.73,
      "end_seconds": 303.08,
      "duration_seconds": 3.35,
      "text": "Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.28,
      "end_seconds": 307.61,
      "duration_seconds": 3.33,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.34,
      "end_seconds": 310.81,
      "duration_seconds": 1.47,
      "text": "Take care now."
    }
  ]
}