{
  "schema_version": "1.0",
  "encounter_id": "01309",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.75,
      "duration_seconds": 4.73,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.22,
      "end_seconds": 10.96,
      "duration_seconds": 3.74,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.59,
      "end_seconds": 19.7,
      "duration_seconds": 8.11,
      "text": "Mainly sudden shortness of breath. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 23.3,
      "duration_seconds": 1.62,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.71,
      "end_seconds": 33.3,
      "duration_seconds": 8.59,
      "text": "For three weeks, I'd say. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.96,
      "end_seconds": 37.91,
      "duration_seconds": 2.95,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.84,
      "end_seconds": 43.19,
      "duration_seconds": 3.35,
      "text": "I notice it more with breathing in."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.4,
      "end_seconds": 48.02,
      "duration_seconds": 4.62,
      "text": "Yes, carry on. Have you been coughing up a little blood?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.18,
      "end_seconds": 61.16,
      "duration_seconds": 8.98,
      "text": "Yes, for about three months. With coughing up a little blood, it's a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.94,
      "end_seconds": 64.96,
      "duration_seconds": 3.02,
      "text": "Any chest tightness or fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.87,
      "end_seconds": 70.33,
      "duration_seconds": 3.46,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.95,
      "end_seconds": 74.11,
      "duration_seconds": 2.16,
      "text": "Did you notice any wheeze?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.33,
      "end_seconds": 77.72,
      "duration_seconds": 2.39,
      "text": "I haven't noticed any wheeze."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.29,
      "end_seconds": 82.53,
      "duration_seconds": 3.24,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.93,
      "end_seconds": 91.44,
      "duration_seconds": 7.51,
      "text": "Sorry, what was I saying, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.45,
      "end_seconds": 94.66,
      "duration_seconds": 1.21,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.39,
      "end_seconds": 98.09,
      "duration_seconds": 2.7,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.81,
      "end_seconds": 101.57,
      "duration_seconds": 2.76,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.58,
      "end_seconds": 107.87,
      "duration_seconds": 4.29,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.61,
      "end_seconds": 111.91,
      "duration_seconds": 3.3,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.31,
      "end_seconds": 116.34,
      "duration_seconds": 3.03,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.04,
      "end_seconds": 120.16,
      "duration_seconds": 2.12,
      "text": "So, how are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.82,
      "end_seconds": 126.34,
      "duration_seconds": 4.52,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.8,
      "end_seconds": 148.29,
      "duration_seconds": 3.49,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.89,
      "end_seconds": 152.92,
      "duration_seconds": 4.03,
      "text": "It's metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.35,
      "end_seconds": 157.58,
      "duration_seconds": 4.23,
      "text": "Okay, go on. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.56,
      "end_seconds": 167.9,
      "duration_seconds": 9.34,
      "text": "I've had high blood pressure for about a year now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.47,
      "end_seconds": 178.88,
      "duration_seconds": 9.41,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.17,
      "end_seconds": 182.96,
      "duration_seconds": 2.79,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.55,
      "end_seconds": 194.05,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.9,
      "end_seconds": 197.82,
      "duration_seconds": 1.92,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.49,
      "end_seconds": 203.51,
      "duration_seconds": 5.02,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.57,
      "end_seconds": 207.36,
      "duration_seconds": 2.79,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.91,
      "end_seconds": 214.14,
      "duration_seconds": 5.23,
      "text": "So, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.94,
      "end_seconds": 225.39,
      "duration_seconds": 1.45,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.8,
      "end_seconds": 229.7,
      "duration_seconds": 2.9,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.32,
      "end_seconds": 247.53,
      "duration_seconds": 6.21,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.87,
      "end_seconds": 254.67,
      "duration_seconds": 1.8,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.48,
      "end_seconds": 270.99,
      "duration_seconds": 6.51,
      "text": "Okay, so my impression is this: I'd lean towards a possible blood clot in the lung."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.92,
      "end_seconds": 273.89,
      "duration_seconds": 1.97,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.45,
      "end_seconds": 294.95,
      "duration_seconds": 19.5,
      "text": "It's reasonable to be concerned, but right now a possible blood clot in the lung is my leading thought, not anything worse. I want a CT scan of the chest done, that's for breathlessness. You need to go to hospital now for a scan."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.23,
      "end_seconds": 321.05,
      "duration_seconds": 25.82,
      "text": "Yes, carry on. Let's hold off on a D-dimer blood test for now, and if there's no change in a month we can revisit it. If you feel faint, or you feel really unwell, please come to the emergency department. Let's plan a check straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.98,
      "end_seconds": 325.26,
      "duration_seconds": 3.28,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.16,
      "end_seconds": 328.85,
      "duration_seconds": 1.69,
      "text": "Right, take care now."
    }
  ]
}