{
  "schema_version": "1.0",
  "encounter_id": "01191",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 6.18,
      "duration_seconds": 5.02,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.9,
      "end_seconds": 11.78,
      "duration_seconds": 3.88,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.73,
      "end_seconds": 22.28,
      "duration_seconds": 8.55,
      "text": "Mainly sudden shortness of breath. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.19,
      "end_seconds": 26.39,
      "duration_seconds": 3.2,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.7,
      "end_seconds": 30.3,
      "duration_seconds": 2.6,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.11,
      "end_seconds": 34.61,
      "duration_seconds": 2.5,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.09,
      "end_seconds": 38.66,
      "duration_seconds": 2.57,
      "text": "It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.55,
      "end_seconds": 42.14,
      "duration_seconds": 2.59,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 53.44,
      "duration_seconds": 10.03,
      "text": "A swollen painful calf goes along with it, most of the time. The swollen painful calf? That's been for about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.23,
      "end_seconds": 58.41,
      "duration_seconds": 3.18,
      "text": "Have you been coughing up a little blood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.44,
      "end_seconds": 61.43,
      "duration_seconds": 1.99,
      "text": "Yes, since last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.85,
      "end_seconds": 62.69,
      "duration_seconds": 0.84,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.87,
      "end_seconds": 76.7,
      "duration_seconds": 2.83,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.18,
      "end_seconds": 89.66,
      "duration_seconds": 2.48,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.17,
      "end_seconds": 113.06,
      "duration_seconds": 11.89,
      "text": "Okay: temperature is 37.2 degrees, pulse is 91 beats a minute. And blood pressure 136 over 85, respiratory rate 20, saturation 93 percent."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.26,
      "end_seconds": 115.75,
      "duration_seconds": 1.49,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.99,
      "end_seconds": 119.79,
      "duration_seconds": 2.8,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 126.62,
      "duration_seconds": 4.24,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.56,
      "end_seconds": 130.66,
      "duration_seconds": 3.1,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.89,
      "end_seconds": 151.83,
      "duration_seconds": 6.94,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.77,
      "end_seconds": 153.77,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.61,
      "end_seconds": 165.81,
      "duration_seconds": 6.2,
      "text": "Okay, that's enough for me. Okay, any fever, chest tightness or wheeze?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.95,
      "end_seconds": 169.06,
      "duration_seconds": 2.11,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.15,
      "end_seconds": 177.45,
      "duration_seconds": 3.3,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.5,
      "end_seconds": 181.67,
      "duration_seconds": 2.17,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.39,
      "end_seconds": 184.58,
      "duration_seconds": 2.19,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.13,
      "end_seconds": 187.78,
      "duration_seconds": 2.65,
      "text": "Asthma, for nearly five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.66,
      "end_seconds": 192.94,
      "duration_seconds": 3.28,
      "text": "Mm-hmm. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.23,
      "end_seconds": 199.41,
      "duration_seconds": 5.18,
      "text": "I'm on Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.57,
      "end_seconds": 202.78,
      "duration_seconds": 2.21,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.24,
      "end_seconds": 205.8,
      "duration_seconds": 1.56,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.97,
      "end_seconds": 224.52,
      "duration_seconds": 4.55,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.17,
      "end_seconds": 230.82,
      "duration_seconds": 4.65,
      "text": "Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.28,
      "end_seconds": 249.03,
      "duration_seconds": 2.75,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.31,
      "end_seconds": 253.39,
      "duration_seconds": 3.08,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.05,
      "end_seconds": 256.47,
      "duration_seconds": 2.42,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.87,
      "end_seconds": 271.85,
      "duration_seconds": 11.98,
      "text": "I do a yoga class on Thursdays. My husband and I live above the shop. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.39,
      "end_seconds": 286.07,
      "duration_seconds": 12.68,
      "text": "Okay, thinking it through, this looks most like a possible blood clot in the lung. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.91,
      "end_seconds": 289.13,
      "duration_seconds": 2.22,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.21,
      "end_seconds": 305.76,
      "duration_seconds": 15.55,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible blood clot in the lung, but I'd like to confirm. Let's book a CT scan of the chest to look into breathlessness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.44,
      "end_seconds": 309.11,
      "duration_seconds": 2.67,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.77,
      "end_seconds": 334.05,
      "duration_seconds": 23.28,
      "text": "We should do a D-dimer blood test for possible clot. You need to go to hospital now for a scan. One warning sign to remember: you feel faint. In that case don't wait. Come back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.57,
      "end_seconds": 340.65,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}