{
  "schema_version": "1.0",
  "encounter_id": "01326",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.68,
      "duration_seconds": 3.91,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.4,
      "end_seconds": 14.27,
      "duration_seconds": 4.87,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 16.14,
      "end_seconds": 18.93,
      "duration_seconds": 2.79,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.67,
      "end_seconds": 29.67,
      "duration_seconds": 10.0,
      "text": "Let me think, honestly, it's a dry cough in the evenings, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.41,
      "end_seconds": 33.94,
      "duration_seconds": 3.53,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.82,
      "end_seconds": 38.23,
      "duration_seconds": 3.41,
      "text": "I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.09,
      "end_seconds": 43.46,
      "duration_seconds": 4.37,
      "text": "It, It was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.88,
      "end_seconds": 49.62,
      "duration_seconds": 4.74,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.65,
      "end_seconds": 53.04,
      "duration_seconds": 2.39,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.98,
      "end_seconds": 60.55,
      "duration_seconds": 5.57,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.24,
      "end_seconds": 73.13,
      "duration_seconds": 6.89,
      "text": "yes, pollen season. That makes it worse. I'd say on and off"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.37,
      "end_seconds": 81.82,
      "duration_seconds": 2.45,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.43,
      "end_seconds": 94.15,
      "duration_seconds": 10.72,
      "text": "when it starts I tend to get sneezing fits as well i've had itchy eyes too, for ten days"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.72,
      "end_seconds": 95.42,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.69,
      "end_seconds": 105.27,
      "duration_seconds": 9.58,
      "text": "I see, go ahead. Have you had a dry cough in the evenings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.16,
      "end_seconds": 113.22,
      "duration_seconds": 7.06,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.13,
      "end_seconds": 116.6,
      "duration_seconds": 2.47,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.54,
      "end_seconds": 125.75,
      "duration_seconds": 6.21,
      "text": "Um, I had warfarin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.81,
      "end_seconds": 140.57,
      "duration_seconds": 3.76,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.47,
      "end_seconds": 148.02,
      "duration_seconds": 3.55,
      "text": "An irregular heartbeat, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.25,
      "end_seconds": 150.03,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.8,
      "end_seconds": 168.36,
      "duration_seconds": 2.56,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.87,
      "end_seconds": 172.18,
      "duration_seconds": 3.31,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.12,
      "end_seconds": 192.35,
      "duration_seconds": 4.23,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.19,
      "end_seconds": 196.03,
      "duration_seconds": 2.84,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.14,
      "end_seconds": 200.88,
      "duration_seconds": 3.74,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.28,
      "end_seconds": 205.97,
      "duration_seconds": 3.69,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.65,
      "end_seconds": 208.76,
      "duration_seconds": 2.11,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.89,
      "end_seconds": 216.56,
      "duration_seconds": 2.67,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.1,
      "end_seconds": 222.18,
      "duration_seconds": 4.08,
      "text": "have you noticed wheeze, shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.64,
      "end_seconds": 227.94,
      "duration_seconds": 4.3,
      "text": "No, no wheeze, shortness of breath or fever."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.86,
      "end_seconds": 236.25,
      "duration_seconds": 3.39,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.81,
      "end_seconds": 239.39,
      "duration_seconds": 2.58,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.61,
      "end_seconds": 242.94,
      "duration_seconds": 2.33,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.57,
      "end_seconds": 245.31,
      "duration_seconds": 1.74,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.04,
      "end_seconds": 249.8,
      "duration_seconds": 3.76,
      "text": "Alright, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.03,
      "end_seconds": 260.33,
      "duration_seconds": 2.3,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 288.99,
      "duration_seconds": 13.59,
      "text": "Okay: pulse 68, BMI works out to 32.3. And SpO2 97 percent on room air, height 167 centimetres, respiratory rate 15, weight 90 kilos, blood pressure 108 over 73."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.56,
      "end_seconds": 296.24,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.06,
      "end_seconds": 301.17,
      "duration_seconds": 3.11,
      "text": "Right, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.63,
      "end_seconds": 307.48,
      "duration_seconds": 3.85,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.17,
      "end_seconds": 310.85,
      "duration_seconds": 1.68,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.88,
      "end_seconds": 330.55,
      "duration_seconds": 5.67,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.7,
      "end_seconds": 347.17,
      "duration_seconds": 14.47,
      "text": "That's all I needed to check. Right, here's what I'm thinking. It's hard to say. Seasonal hay fever causing the cough is one possibility and early asthma another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.91,
      "end_seconds": 349.4,
      "duration_seconds": 1.49,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.1,
      "end_seconds": 368.22,
      "duration_seconds": 18.12,
      "text": "I understand the worry. At the moment I'd say it's seasonal hay fever causing the cough, and we'll watch how it goes. Let me just check I've got this right. You've had a dry cough in the evenings, and no shortness of breath or wheeze."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.91,
      "end_seconds": 371.39,
      "duration_seconds": 1.48,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.43,
      "end_seconds": 381.55,
      "duration_seconds": 9.12,
      "text": "we'll begin with fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.61,
      "end_seconds": 386.8,
      "duration_seconds": 4.19,
      "text": "should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.4,
      "end_seconds": 391.85,
      "duration_seconds": 4.45,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.87,
      "end_seconds": 397.1,
      "duration_seconds": 3.23,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.65,
      "end_seconds": 399.7,
      "duration_seconds": 2.05,
      "text": "Right, take care now."
    }
  ]
}