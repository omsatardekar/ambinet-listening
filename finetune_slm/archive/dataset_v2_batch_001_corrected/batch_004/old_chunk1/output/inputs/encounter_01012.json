{
  "schema_version": "1.0",
  "encounter_id": "01012",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 7.42,
      "duration_seconds": 6.45,
      "text": "Right, thanks for waiting, come in. So what can I do for you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.15,
      "end_seconds": 13.77,
      "duration_seconds": 4.62,
      "text": "It's pain much worse than it looks, mostly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.27,
      "end_seconds": 23.85,
      "duration_seconds": 8.58,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.61,
      "end_seconds": 29.73,
      "duration_seconds": 5.12,
      "text": "I, I notice it more with touch. Severe, I'd say."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.44,
      "end_seconds": 34.35,
      "duration_seconds": 3.91,
      "text": "any a red hot swelling on your leg as well?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.39,
      "end_seconds": 38.29,
      "duration_seconds": 2.9,
      "text": "yeah, um, that too"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.46,
      "end_seconds": 42.09,
      "duration_seconds": 2.63,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.06,
      "end_seconds": 49.19,
      "duration_seconds": 6.13,
      "text": "erm, uh, a four out of ten, I suppose"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.92,
      "end_seconds": 54.34,
      "duration_seconds": 3.42,
      "text": "A few quick ones: cut or insect bite?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.65,
      "end_seconds": 64.23,
      "duration_seconds": 5.58,
      "text": "Right, uh, I haven't had cut or insect bite, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.16,
      "end_seconds": 67.94,
      "duration_seconds": 2.78,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.51,
      "end_seconds": 71.48,
      "duration_seconds": 1.97,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.09,
      "end_seconds": 77.41,
      "duration_seconds": 4.32,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.44,
      "end_seconds": 83.21,
      "duration_seconds": 3.77,
      "text": "Let me think, no, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.77,
      "end_seconds": 88.2,
      "duration_seconds": 3.43,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.99,
      "end_seconds": 98.58,
      "duration_seconds": 9.59,
      "text": "Um, uh, I have diabetes, for five years. I mean, I have depression, for five years."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.35,
      "end_seconds": 109.51,
      "duration_seconds": 9.16,
      "text": "Okay, I can see depression in your file as well. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.33,
      "end_seconds": 113.98,
      "duration_seconds": 3.65,
      "text": "Actually, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.36,
      "end_seconds": 129.16,
      "duration_seconds": 2.8,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.29,
      "end_seconds": 134.03,
      "duration_seconds": 3.74,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.7,
      "end_seconds": 139.12,
      "duration_seconds": 3.42,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.95,
      "end_seconds": 146.65,
      "duration_seconds": 5.7,
      "text": "yes, I had a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.64,
      "end_seconds": 149.86,
      "duration_seconds": 1.22,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.91,
      "end_seconds": 156.79,
      "duration_seconds": 5.88,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.79,
      "end_seconds": 160.47,
      "duration_seconds": 2.68,
      "text": "Right, is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.82,
      "end_seconds": 166.39,
      "duration_seconds": 4.57,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.27,
      "end_seconds": 169.49,
      "duration_seconds": 1.22,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.59,
      "end_seconds": 175.05,
      "duration_seconds": 4.46,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.21,
      "end_seconds": 181.12,
      "duration_seconds": 1.91,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.36,
      "end_seconds": 187.18,
      "duration_seconds": 4.82,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.51,
      "end_seconds": 190.49,
      "duration_seconds": 1.98,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.37,
      "end_seconds": 208.29,
      "duration_seconds": 15.92,
      "text": "okay, so I'm on glimepiride, 2 milligrams, before breakfast. I just want to to get back to normal, really. It's escitalopram, 10 milligrams, once a day for my mood"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.6,
      "end_seconds": 212.55,
      "duration_seconds": 2.95,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.46,
      "end_seconds": 229.41,
      "duration_seconds": 2.95,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.39,
      "end_seconds": 262.61,
      "duration_seconds": 13.22,
      "text": "Okay: weight 65 kilos, pressure 121 over 71, temperature 38.2. And height 180 centimetres, respiratory rate 22, pulse 97, saturation 97 percent, BMI works out to 20.1."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.88,
      "end_seconds": 266.28,
      "duration_seconds": 2.4,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.99,
      "end_seconds": 275.65,
      "duration_seconds": 1.66,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.25,
      "end_seconds": 279.65,
      "duration_seconds": 2.4,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.53,
      "end_seconds": 296.91,
      "duration_seconds": 7.38,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.18,
      "end_seconds": 304.43,
      "duration_seconds": 3.25,
      "text": "Okay, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.98,
      "end_seconds": 330.34,
      "duration_seconds": 10.36,
      "text": "So where does that leave us? I think we're dealing with a severe deep skin infection needing urgent surgery review at this stage."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.95,
      "end_seconds": 335.04,
      "duration_seconds": 3.09,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.66,
      "end_seconds": 361.07,
      "duration_seconds": 24.41,
      "text": "I understand the worry. At the moment I'd say it's a severe deep skin infection needing urgent surgery review, and we'll know more once the an urgent surgical review is back. I want an urgent surgical review done, that's for possible necrotising infection. Urgent blood tests is what I'd like next, for severe skin infection."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 362.71,
      "end_seconds": 365.16,
      "duration_seconds": 2.45,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.1,
      "end_seconds": 383.62,
      "duration_seconds": 16.52,
      "text": "I am sending you to hospital now, do not wait we'll refer you to the surgical team do get help quickly if you cannot go now is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.34,
      "end_seconds": 388.2,
      "duration_seconds": 3.86,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.12,
      "end_seconds": 391.77,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
}