{
  "schema_version": "1.0",
  "encounter_id": "01318",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 2.83,
      "duration_seconds": 1.77,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.22,
      "end_seconds": 8.83,
      "duration_seconds": 4.61,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.02,
      "end_seconds": 14.95,
      "duration_seconds": 4.93,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.68,
      "end_seconds": 19.82,
      "duration_seconds": 4.14,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.71,
      "end_seconds": 24.84,
      "duration_seconds": 4.13,
      "text": "We came because of my throat closing up."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.88,
      "end_seconds": 29.33,
      "duration_seconds": 3.45,
      "text": "Alright, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.18,
      "end_seconds": 37.91,
      "duration_seconds": 7.73,
      "text": "About... well, ten days. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.99,
      "end_seconds": 46.08,
      "duration_seconds": 5.09,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.24,
      "end_seconds": 65.01,
      "duration_seconds": 17.77,
      "text": "Pretty severe, if I'm being honest. It sort of comes and goes. And there's swollen lips as well, um, two weeks now. Oh, and hives all over. With hives all over, honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.14,
      "end_seconds": 84.57,
      "duration_seconds": 3.43,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.24,
      "end_seconds": 95.6,
      "duration_seconds": 3.36,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.03,
      "end_seconds": 119.5,
      "duration_seconds": 11.47,
      "text": "Okay: BMI works out to 26.4, pressure 103 over 63, height 173 centimetres, temperature is 37.2 degrees, weight 79 kilos, heart rate 112."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.44,
      "end_seconds": 123.57,
      "duration_seconds": 2.13,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.81,
      "end_seconds": 126.81,
      "duration_seconds": 2.0,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.38,
      "end_seconds": 144.95,
      "duration_seconds": 7.57,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.32,
      "end_seconds": 153.69,
      "duration_seconds": 6.37,
      "text": "That's all I needed to check. Have you had any chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.1,
      "end_seconds": 157.61,
      "duration_seconds": 2.51,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.82,
      "end_seconds": 163.32,
      "duration_seconds": 4.5,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.96,
      "end_seconds": 165.49,
      "duration_seconds": 1.53,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.26,
      "end_seconds": 171.3,
      "duration_seconds": 4.04,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.95,
      "end_seconds": 176.69,
      "duration_seconds": 3.74,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.39,
      "end_seconds": 184.45,
      "duration_seconds": 2.06,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.99,
      "end_seconds": 190.5,
      "duration_seconds": 4.51,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.7,
      "end_seconds": 196.28,
      "duration_seconds": 1.58,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.09,
      "end_seconds": 200.47,
      "duration_seconds": 2.38,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.24,
      "end_seconds": 214.56,
      "duration_seconds": 2.32,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.06,
      "end_seconds": 223.87,
      "duration_seconds": 7.81,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.54,
      "end_seconds": 233.73,
      "duration_seconds": 8.19,
      "text": "What conditions have you been treated for in the past? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.38,
      "end_seconds": 237.23,
      "duration_seconds": 2.85,
      "text": "I have asthma, for two years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.85,
      "end_seconds": 244.35,
      "duration_seconds": 6.5,
      "text": "Alright, asthma, that matches what I have here. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.59,
      "end_seconds": 255.35,
      "duration_seconds": 9.76,
      "text": "I had a reaction to erythromycin when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.92,
      "end_seconds": 261.0,
      "duration_seconds": 5.08,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 263.85,
      "end_seconds": 271.0,
      "duration_seconds": 7.15,
      "text": "She is on Asthalin inhaler, when needed for my asthma, I give it to her."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.4,
      "end_seconds": 283.63,
      "duration_seconds": 11.23,
      "text": "Right, here's what I'm thinking. This looks most like anaphylaxis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.48,
      "end_seconds": 288.97,
      "duration_seconds": 3.49,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.54,
      "end_seconds": 312.04,
      "duration_seconds": 21.5,
      "text": "I understand the worry. At the moment I'd say it's anaphylaxis, and we'll know more once the monitoring is back. Just to be sure I understood. You've had your throat closing up for ten days, severe, and no chest pain or recent illness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.92,
      "end_seconds": 313.62,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.31,
      "end_seconds": 341.2,
      "duration_seconds": 17.89,
      "text": "I want monitoring done, that's for anaphylaxis. You'll be taking adrenaline, 0.5 milligrams, once now, single dose. That should help with anaphylaxis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.74,
      "end_seconds": 344.89,
      "duration_seconds": 3.15,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.9,
      "end_seconds": 364.41,
      "duration_seconds": 17.51,
      "text": "Lie flat with your legs raised, I am giving the injection now. Please don't wait if the symptoms return. That's when to be seen urgently. Book a review straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.82,
      "end_seconds": 372.01,
      "duration_seconds": 2.19,
      "text": "Alright, thanks, take care."
    }
  ]
}