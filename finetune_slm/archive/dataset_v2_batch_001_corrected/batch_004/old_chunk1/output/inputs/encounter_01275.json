{
  "schema_version": "1.0",
  "encounter_id": "01275",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.14,
      "end_seconds": 6.89,
      "duration_seconds": 5.75,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 11.36,
      "duration_seconds": 3.73,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.22,
      "end_seconds": 20.42,
      "duration_seconds": 7.2,
      "text": "I've been dealing with being very thirsty. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.23,
      "end_seconds": 22.9,
      "duration_seconds": 1.67,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.93,
      "end_seconds": 39.39,
      "duration_seconds": 12.46,
      "text": "I've had it for three days i told myself I'd wait and see, and here I am i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.73,
      "end_seconds": 45.01,
      "duration_seconds": 5.28,
      "text": "Ah. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.77,
      "end_seconds": 50.78,
      "duration_seconds": 5.01,
      "text": "I'd call it severe. It settles a little with water."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.61,
      "end_seconds": 55.07,
      "duration_seconds": 2.46,
      "text": "Have you had deep fast breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.68,
      "end_seconds": 60.34,
      "duration_seconds": 3.66,
      "text": "Yes, I have. There's vomiting as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.87,
      "end_seconds": 65.06,
      "duration_seconds": 4.19,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.11,
      "end_seconds": 68.79,
      "duration_seconds": 2.68,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.46,
      "end_seconds": 75.92,
      "duration_seconds": 5.46,
      "text": "Have you had being very thirsty before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 76.57,
      "end_seconds": 82.71,
      "duration_seconds": 6.14,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 95.5,
      "duration_seconds": 3.24,
      "text": "Did you get cough or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.5,
      "end_seconds": 101.65,
      "duration_seconds": 4.15,
      "text": "I haven't had cough or chest pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.21,
      "end_seconds": 109.03,
      "duration_seconds": 2.82,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.81,
      "end_seconds": 114.35,
      "duration_seconds": 3.54,
      "text": "Let me think, no, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.41,
      "end_seconds": 117.95,
      "duration_seconds": 2.54,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.36,
      "end_seconds": 122.76,
      "duration_seconds": 3.4,
      "text": "Oh, um, no, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.12,
      "end_seconds": 140.2,
      "duration_seconds": 4.08,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.18,
      "end_seconds": 143.89,
      "duration_seconds": 2.71,
      "text": "Diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.67,
      "end_seconds": 147.41,
      "duration_seconds": 1.74,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.16,
      "end_seconds": 155.82,
      "duration_seconds": 6.66,
      "text": "I have thin bones, for five years. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.56,
      "end_seconds": 159.37,
      "duration_seconds": 2.81,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.43,
      "end_seconds": 170.75,
      "duration_seconds": 10.32,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.65,
      "end_seconds": 175.47,
      "duration_seconds": 2.82,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.11,
      "end_seconds": 179.71,
      "duration_seconds": 2.6,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.3,
      "end_seconds": 198.61,
      "duration_seconds": 17.31,
      "text": "I'm on glibenclamide, 5 milligrams, before breakfast for my sugar. Alendronate. I take it 70 milligrams, once a week for my bones. Though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.42,
      "end_seconds": 202.58,
      "duration_seconds": 2.16,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.57,
      "end_seconds": 214.43,
      "duration_seconds": 9.86,
      "text": "just a mole taken off my arm, a few years ago i just wanna get back to normal, really"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.74,
      "end_seconds": 218.54,
      "duration_seconds": 2.8,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.48,
      "end_seconds": 234.08,
      "duration_seconds": 14.6,
      "text": "I have about eight cigarettes in a day. I do a yoga class on Thursdays. Lots of rice, lentils and some fruit. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 242.1,
      "end_seconds": 251.01,
      "duration_seconds": 8.91,
      "text": "Okay, so the vitals from earlier. Temperature 36.9, pulse is 125 beats a minute, pressure 133 over 83."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.9,
      "end_seconds": 253.6,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.87,
      "end_seconds": 260.04,
      "duration_seconds": 4.17,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 261.24,
      "end_seconds": 262.73,
      "duration_seconds": 1.49,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.38,
      "end_seconds": 265.58,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.13,
      "end_seconds": 278.6,
      "duration_seconds": 4.47,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.02,
      "end_seconds": 298.77,
      "duration_seconds": 15.75,
      "text": "All finished, thank you. Right, here's what I'm thinking. It points towards diabetic ketoacidosis. Let's get a blood sugar and ketone test, for thirst and vomiting. You need to go to hospital now for insulin and fluids."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.16,
      "end_seconds": 321.75,
      "duration_seconds": 22.59,
      "text": "Right, right. Please take the tablets with food so they don't upset your stomach. We'll refer you to the emergency team. Blood gas and electrolytes is something we might do if this doesn't improve in two weeks. One warning sign to remember: you cannot get there now. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.56,
      "end_seconds": 326.04,
      "duration_seconds": 3.48,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.83,
      "end_seconds": 331.4,
      "duration_seconds": 4.57,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.12,
      "end_seconds": 333.83,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.38,
      "end_seconds": 335.82,
      "duration_seconds": 1.44,
      "text": "Look after yourself."
    }
  ]
}