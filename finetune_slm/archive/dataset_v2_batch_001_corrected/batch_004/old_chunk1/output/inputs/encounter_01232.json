{
  "schema_version": "1.0",
  "encounter_id": "01232",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.93,
      "duration_seconds": 3.73,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.76,
      "end_seconds": 10.33,
      "duration_seconds": 4.57,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.27,
      "end_seconds": 17.42,
      "duration_seconds": 3.15,
      "text": "It's sudden shortness of breath, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.02,
      "end_seconds": 21.88,
      "duration_seconds": 3.86,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.26,
      "end_seconds": 38.79,
      "duration_seconds": 3.53,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.7,
      "end_seconds": 80.28,
      "duration_seconds": 19.58,
      "text": "Okay: height 177 centimetres, weight 53 kilos, SpO2 90 percent on room air, pressure 120 over 89, pulse is 101 beats a minute, respiratory rate 22, temperature is 37.4 degrees. What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.85,
      "end_seconds": 84.06,
      "duration_seconds": 3.21,
      "text": "It's been going on for two days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.39,
      "end_seconds": 101.43,
      "duration_seconds": 6.04,
      "text": "Let me check a few things. Any wheeze, fever or chest tightness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.28,
      "end_seconds": 111.0,
      "duration_seconds": 4.72,
      "text": "No wheeze, fever or chest tightness, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.48,
      "end_seconds": 118.54,
      "duration_seconds": 4.06,
      "text": "Alright, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.32,
      "end_seconds": 120.26,
      "duration_seconds": 0.94,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.05,
      "end_seconds": 125.96,
      "duration_seconds": 4.91,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.78,
      "end_seconds": 130.34,
      "duration_seconds": 2.56,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.02,
      "end_seconds": 146.44,
      "duration_seconds": 4.42,
      "text": "Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.15,
      "end_seconds": 152.18,
      "duration_seconds": 5.03,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.01,
      "end_seconds": 157.18,
      "duration_seconds": 4.17,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.87,
      "end_seconds": 160.33,
      "duration_seconds": 2.46,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.9,
      "end_seconds": 183.21,
      "duration_seconds": 5.31,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.31,
      "end_seconds": 200.02,
      "duration_seconds": 15.71,
      "text": "I only drink at family occasions. No, I've never smoked in my life. No, I share a house with my brother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.1,
      "end_seconds": 203.95,
      "duration_seconds": 2.85,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.39,
      "end_seconds": 211.16,
      "duration_seconds": 2.77,
      "text": "Anxiety, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.74,
      "end_seconds": 227.04,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.39,
      "end_seconds": 232.34,
      "duration_seconds": 3.95,
      "text": "Oh, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.42,
      "end_seconds": 237.35,
      "duration_seconds": 3.93,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.16,
      "end_seconds": 241.13,
      "duration_seconds": 1.97,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.47,
      "end_seconds": 254.6,
      "duration_seconds": 6.13,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.3,
      "end_seconds": 273.79,
      "duration_seconds": 16.49,
      "text": "Okay, that's enough for me. Putting it all together, this looks most like a possible blood clot in the lung. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.31,
      "end_seconds": 278.33,
      "duration_seconds": 3.02,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.35,
      "end_seconds": 293.45,
      "duration_seconds": 14.1,
      "text": "I can't promise yet, but most people with a possible blood clot in the lung do well once it's treated properly. I think a D-dimer blood test makes sense here, for possible clot."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.1,
      "end_seconds": 297.01,
      "duration_seconds": 2.91,
      "text": "The earliest is Wednesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.83,
      "end_seconds": 298.75,
      "duration_seconds": 0.92,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.41,
      "end_seconds": 308.37,
      "duration_seconds": 8.96,
      "text": "You need to go to hospital now for a scan. Please come and see me straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.11,
      "end_seconds": 315.0,
      "duration_seconds": 4.89,
      "text": "Right, um, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.46,
      "end_seconds": 317.68,
      "duration_seconds": 1.22,
      "text": "Look after yourself."
    }
  ]
}