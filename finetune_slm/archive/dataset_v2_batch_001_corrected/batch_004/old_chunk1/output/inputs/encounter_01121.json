{
  "schema_version": "1.0",
  "encounter_id": "01121",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 5.25,
      "duration_seconds": 4.0,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 10.82,
      "duration_seconds": 4.09,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.45,
      "end_seconds": 18.96,
      "duration_seconds": 6.51,
      "text": "Doctor, uh, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.49,
      "end_seconds": 24.61,
      "duration_seconds": 4.12,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.52,
      "end_seconds": 29.04,
      "duration_seconds": 3.52,
      "text": "It's, It's bloating after meals, mostly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.43,
      "end_seconds": 31.7,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.49,
      "end_seconds": 38.59,
      "duration_seconds": 6.1,
      "text": "I'd say about a week. Actually, uh, no, closer to three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.35,
      "end_seconds": 51.72,
      "duration_seconds": 12.37,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.5,
      "end_seconds": 64.15,
      "duration_seconds": 11.65,
      "text": "Large meals and fizzy drinks definitely sets it off. It settles a little with walking. Oh, and loose stools now and then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.65,
      "end_seconds": 68.02,
      "duration_seconds": 3.37,
      "text": "Has there been a lot of wind too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.27,
      "end_seconds": 76.6,
      "duration_seconds": 7.33,
      "text": "Yes, for six months. With lot of wind, it feels moderate to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.14,
      "end_seconds": 96.78,
      "duration_seconds": 4.64,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.74,
      "end_seconds": 101.76,
      "duration_seconds": 3.02,
      "text": "Oh, yes, walnuts. I get hives."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.36,
      "end_seconds": 107.44,
      "duration_seconds": 4.08,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.07,
      "end_seconds": 110.62,
      "duration_seconds": 1.55,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.65,
      "end_seconds": 120.98,
      "duration_seconds": 2.33,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.41,
      "end_seconds": 124.83,
      "duration_seconds": 2.42,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.52,
      "end_seconds": 128.96,
      "duration_seconds": 3.44,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.55,
      "end_seconds": 148.14,
      "duration_seconds": 17.59,
      "text": "I smoke roughly a pack every two days. I only drink at family occasions. My husband and I live above the shop. I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.51,
      "end_seconds": 156.08,
      "duration_seconds": 6.57,
      "text": "Have you had any blood in the stool, night-time diarrhoea, vomiting or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.97,
      "end_seconds": 162.62,
      "duration_seconds": 4.65,
      "text": "Let me think, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.17,
      "end_seconds": 165.82,
      "duration_seconds": 2.65,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.88,
      "end_seconds": 169.66,
      "duration_seconds": 2.78,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.37,
      "end_seconds": 173.41,
      "duration_seconds": 2.04,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.29,
      "end_seconds": 178.63,
      "duration_seconds": 3.34,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.89,
      "end_seconds": 195.28,
      "duration_seconds": 2.39,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.75,
      "end_seconds": 203.88,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.32,
      "end_seconds": 221.2,
      "duration_seconds": 6.88,
      "text": "Okay: BP is 124 over 70, oxygen saturation is 97 percent, respiratory rate 14, pulse 80."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.33,
      "end_seconds": 228.03,
      "duration_seconds": 5.7,
      "text": "Right, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.9,
      "end_seconds": 231.92,
      "duration_seconds": 2.02,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.72,
      "end_seconds": 254.84,
      "duration_seconds": 6.12,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.03,
      "end_seconds": 257.68,
      "duration_seconds": 1.65,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.3,
      "end_seconds": 297.62,
      "duration_seconds": 35.32,
      "text": "Right, that's the examination finished. Let me tell you where I've got to. My working impression is a functional bowel pattern, with no alarm features. I can't rule out irritable bowel syndrome yet. Let's book a coeliac blood test to look into bloating. Try smaller meals and keep a food and symptom diary for four weeks. If you see blood in the stool or lose weight, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.71,
      "end_seconds": 307.28,
      "duration_seconds": 7.57,
      "text": "We'll catch up in six weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.31,
      "end_seconds": 313.42,
      "duration_seconds": 4.11,
      "text": "Right, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.42,
      "end_seconds": 315.7,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}