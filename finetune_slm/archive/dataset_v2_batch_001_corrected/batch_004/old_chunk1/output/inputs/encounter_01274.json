{
  "schema_version": "1.0",
  "encounter_id": "01274",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 6.05,
      "duration_seconds": 4.86,
      "text": "Oh, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 12.11,
      "duration_seconds": 5.28,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.74,
      "end_seconds": 17.31,
      "duration_seconds": 4.57,
      "text": "It's a dry cough in the evenings, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.1,
      "end_seconds": 23.4,
      "duration_seconds": 4.3,
      "text": "Okay, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.26,
      "end_seconds": 27.67,
      "duration_seconds": 3.41,
      "text": "It's, It's been like this since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.49,
      "end_seconds": 39.74,
      "duration_seconds": 10.25,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.94,
      "end_seconds": 46.37,
      "duration_seconds": 5.43,
      "text": "It happens once or twice a day. It's worse with pollen season."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.22,
      "end_seconds": 50.64,
      "duration_seconds": 3.42,
      "text": "Okay, does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.49,
      "end_seconds": 56.66,
      "duration_seconds": 5.17,
      "text": "When it starts I tend to get itchy eyes as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.75,
      "end_seconds": 75.54,
      "duration_seconds": 2.79,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.17,
      "end_seconds": 90.04,
      "duration_seconds": 13.87,
      "text": "I have an irregular heartbeat. Right, you know, I have heart disease. I just want to get back to normal, really. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.78,
      "end_seconds": 97.83,
      "duration_seconds": 6.05,
      "text": "I see, go ahead. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.19,
      "end_seconds": 105.57,
      "duration_seconds": 6.38,
      "text": "So, I'm allergic to amoxicillin, I get a rash all over."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.34,
      "end_seconds": 109.84,
      "duration_seconds": 3.5,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.7,
      "end_seconds": 120.44,
      "duration_seconds": 9.74,
      "text": "Warfarin. I take it 3 milligrams, in the evening for the blood thinning. I mean, I take metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.22,
      "end_seconds": 124.48,
      "duration_seconds": 2.26,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.56,
      "end_seconds": 128.18,
      "duration_seconds": 1.62,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.49,
      "end_seconds": 132.4,
      "duration_seconds": 2.91,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.43,
      "end_seconds": 139.71,
      "duration_seconds": 5.28,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.42,
      "end_seconds": 158.23,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.0,
      "end_seconds": 162.41,
      "duration_seconds": 3.41,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.84,
      "end_seconds": 165.4,
      "duration_seconds": 1.56,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.49,
      "end_seconds": 170.51,
      "duration_seconds": 3.02,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.7,
      "end_seconds": 175.44,
      "duration_seconds": 3.74,
      "text": "Right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.4,
      "end_seconds": 180.1,
      "duration_seconds": 3.7,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.0,
      "end_seconds": 186.12,
      "duration_seconds": 4.12,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.96,
      "end_seconds": 191.63,
      "duration_seconds": 3.67,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.88,
      "end_seconds": 195.74,
      "duration_seconds": 2.86,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.87,
      "end_seconds": 200.01,
      "duration_seconds": 3.14,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.56,
      "end_seconds": 205.66,
      "duration_seconds": 4.1,
      "text": "Did you get fever, wheeze or shortness of breath?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.13,
      "end_seconds": 209.52,
      "duration_seconds": 2.39,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 214.95,
      "duration_seconds": 3.78,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.48,
      "end_seconds": 218.39,
      "duration_seconds": 2.91,
      "text": "Um, no, that's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.45,
      "end_seconds": 233.15,
      "duration_seconds": 2.7,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.0,
      "end_seconds": 243.96,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.05,
      "end_seconds": 268.19,
      "duration_seconds": 12.14,
      "text": "Okay: oxygen saturation is 99 percent, pulse is 64 beats a minute. And pressure 113 over 82, temperature is 36.8 degrees, respiratory rate 16."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.24,
      "end_seconds": 273.42,
      "duration_seconds": 3.18,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.72,
      "end_seconds": 275.74,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.43,
      "end_seconds": 278.7,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.23,
      "end_seconds": 294.11,
      "duration_seconds": 5.88,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.55,
      "end_seconds": 306.98,
      "duration_seconds": 9.43,
      "text": "Please sit back down. Right, here's what I'm thinking. It fits best with seasonal hay fever causing the cough."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.25,
      "end_seconds": 327.34,
      "duration_seconds": 8.09,
      "text": "The treatment will be fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.77,
      "end_seconds": 334.3,
      "duration_seconds": 1.53,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.83,
      "end_seconds": 351.68,
      "duration_seconds": 15.85,
      "text": "Keep windows closed on high-pollen days and wash your hair at night. Please take the tablets with food so they don't upset your stomach. I'll want another look in a month. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.21,
      "end_seconds": 356.5,
      "duration_seconds": 3.29,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}