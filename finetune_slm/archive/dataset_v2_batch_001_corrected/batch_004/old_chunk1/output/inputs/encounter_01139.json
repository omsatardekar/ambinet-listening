{
  "schema_version": "1.0",
  "encounter_id": "01139",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.6,
      "end_seconds": 4.75,
      "duration_seconds": 4.15,
      "text": "Sorry I'm a little late, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 10.1,
      "duration_seconds": 3.94,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.16,
      "end_seconds": 15.81,
      "duration_seconds": 4.65,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.84,
      "end_seconds": 20.42,
      "duration_seconds": 3.58,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 20.99,
      "end_seconds": 24.79,
      "duration_seconds": 3.8,
      "text": "she's been having sudden shortness of breath, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.45,
      "end_seconds": 29.1,
      "duration_seconds": 3.65,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.2,
      "end_seconds": 41.24,
      "duration_seconds": 11.04,
      "text": "Ever since... since yesterday, really. I did try to ignore it for a while. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.01,
      "end_seconds": 44.94,
      "duration_seconds": 2.93,
      "text": "Okay, how often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.73,
      "end_seconds": 56.95,
      "duration_seconds": 7.22,
      "text": "Honestly, all the time. I've also been coughing up a little blood, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.02,
      "end_seconds": 60.78,
      "duration_seconds": 2.76,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.77,
      "end_seconds": 70.13,
      "duration_seconds": 7.36,
      "text": "It's mild, honestly. I've also had sharp pain when I breathe in, since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.84,
      "end_seconds": 75.91,
      "duration_seconds": 3.07,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.31,
      "end_seconds": 86.31,
      "duration_seconds": 9.0,
      "text": "maybe a three out of ten on a bad day oh, and a swollen painful calf"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.6,
      "end_seconds": 95.25,
      "duration_seconds": 7.65,
      "text": "So, have you had sudden shortness of breath before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.75,
      "end_seconds": 106.35,
      "duration_seconds": 9.6,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 113.11,
      "duration_seconds": 5.36,
      "text": "Are you allergic to to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.97,
      "end_seconds": 117.22,
      "duration_seconds": 2.25,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 119.24,
      "end_seconds": 126.46,
      "duration_seconds": 7.22,
      "text": "hold on, doctor, I think she reacted to to trimethoprim once i'm not certain, though"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.59,
      "end_seconds": 129.67,
      "duration_seconds": 2.08,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.33,
      "end_seconds": 136.48,
      "duration_seconds": 5.15,
      "text": "Okay, I'll note both of those. Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.99,
      "end_seconds": 140.53,
      "duration_seconds": 2.54,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.94,
      "end_seconds": 144.35,
      "duration_seconds": 2.41,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.15,
      "end_seconds": 151.26,
      "duration_seconds": 4.11,
      "text": "I had my tonsils removed as a teenager"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.33,
      "end_seconds": 162.12,
      "duration_seconds": 2.79,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.28,
      "end_seconds": 173.48,
      "duration_seconds": 10.2,
      "text": "I have depression, for about ten years i told my wife I'd come today i, I have an irregular heartbeat"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.09,
      "end_seconds": 187.32,
      "duration_seconds": 10.23,
      "text": "Alright, an irregular heartbeat, that matches what I have here. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.14,
      "end_seconds": 198.74,
      "duration_seconds": 9.6,
      "text": "I look after my grandchildren most days. I'm vegetarian and have been for years. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 206.0,
      "duration_seconds": 3.63,
      "text": "And what about fever, wheeze or chest tightness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.28,
      "end_seconds": 209.8,
      "duration_seconds": 2.52,
      "text": "Erm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.34,
      "end_seconds": 213.48,
      "duration_seconds": 3.14,
      "text": "Sure. Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.8,
      "end_seconds": 222.73,
      "duration_seconds": 2.93,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.16,
      "end_seconds": 226.94,
      "duration_seconds": 2.78,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.73,
      "end_seconds": 230.38,
      "duration_seconds": 1.65,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.53,
      "end_seconds": 240.23,
      "duration_seconds": 2.7,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.15,
      "end_seconds": 249.43,
      "duration_seconds": 2.28,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.07,
      "end_seconds": 276.93,
      "duration_seconds": 11.86,
      "text": "Okay: temperature is 37.2 degrees, saturation 90 percent, blood pressure 134 over 77. And pulse is 100 beats a minute, respiratory rate 22."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.88,
      "end_seconds": 279.41,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.2,
      "end_seconds": 283.26,
      "duration_seconds": 2.06,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.66,
      "end_seconds": 290.6,
      "duration_seconds": 4.94,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.27,
      "end_seconds": 293.92,
      "duration_seconds": 1.65,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.72,
      "end_seconds": 314.1,
      "duration_seconds": 7.38,
      "text": "your left calf is swollen and tender, and your oxygen is lower than I'd like"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.82,
      "end_seconds": 321.34,
      "duration_seconds": 2.52,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.17,
      "end_seconds": 347.56,
      "duration_seconds": 13.39,
      "text": "putting it all together, it's hard to say a possible blood clot in the lung is one possibility and a chest infection another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.82,
      "end_seconds": 350.91,
      "duration_seconds": 2.09,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.16,
      "end_seconds": 385.13,
      "duration_seconds": 32.97,
      "text": "It's reasonable to be concerned, but right now a possible blood clot in the lung is my leading thought, not anything worse. A CT scan of the chest is what I'd like next, for breathlessness. It's a routine test and it'll give us a much clearer picture. A D-dimer blood test is what I'd like next, for possible clot. You need to go to hospital now for a scan. We'll refer you to the medical team."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.36,
      "end_seconds": 394.49,
      "duration_seconds": 5.13,
      "text": "If you feel faint, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.58,
      "end_seconds": 398.17,
      "duration_seconds": 1.59,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.3,
      "end_seconds": 402.31,
      "duration_seconds": 3.01,
      "text": "Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.26,
      "end_seconds": 405.04,
      "duration_seconds": 1.78,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.71,
      "end_seconds": 408.15,
      "duration_seconds": 1.44,
      "text": "look after yourself"
    }
  ]
}