      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.48,
      "end_seconds": 119.1,
      "duration_seconds": 2.62,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.64,
      "end_seconds": 142.67,
      "duration_seconds": 9.03,
      "text": "Okay: height 184 centimetres, pressure 116 over 68, temperature 37.0, weight 87 kilos, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.01,
      "end_seconds": 149.09,
      "duration_seconds": 5.08,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.35,
      "end_seconds": 152.3,
      "duration_seconds": 1.95,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.1,
      "end_seconds": 174.76,
      "duration_seconds": 4.66,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.95,
      "end_seconds": 193.75,
      "duration_seconds": 1.8,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.68,
      "end_seconds": 202.41,
      "duration_seconds": 2.73,
      "text": "Good, you can sit up again."
