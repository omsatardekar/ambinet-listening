    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.73,
      "end_seconds": 68.28,
      "duration_seconds": 4.55,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.61,
      "end_seconds": 89.27,
      "duration_seconds": 19.66,
      "text": "Uh, I get some relief from tissues. Maybe a a eight out of ten on a bad day. And a mild cough as well, since yesterday. About mild cough, honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.49,
      "end_seconds": 94.12,
      "duration_seconds": 3.63,
      "text": "What about a scratchy throat, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.57,
      "end_seconds": 101.22,
      "duration_seconds": 5.65,
      "text": "yeah, that too about scratchy throat, warm drinks helps a bit"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.15,
      "end_seconds": 105.9,
      "duration_seconds": 2.75,
      "text": "Let me quickly check your readings."
