      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.86,
      "end_seconds": 290.45,
      "duration_seconds": 3.59,
      "text": "Just a triple bypass, eight years ago."
