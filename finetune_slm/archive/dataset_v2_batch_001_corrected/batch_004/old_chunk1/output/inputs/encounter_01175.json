      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.25,
      "end_seconds": 306.53,
      "duration_seconds": 4.28,
      "text": "tell me about any past illnesses or ongoing conditions"
