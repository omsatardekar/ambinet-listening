    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.23,
      "end_seconds": 266.86,
      "duration_seconds": 2.63,
      "text": "Right, is there someone at home?"
