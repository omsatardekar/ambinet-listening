    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.16,
      "end_seconds": 26.13,
      "duration_seconds": 2.97,
      "text": "Start wherever you like, I'm listening."
