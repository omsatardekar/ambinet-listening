    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.36,
      "end_seconds": 331.12,
      "duration_seconds": 19.76,
      "text": "let me think, I've had heart failure, yes mm, I've got heart disease it's a relief to finally sit down and talk about it i didn't want to make a fuss, you know"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.59,
      "end_seconds": 340.41,
      "duration_seconds": 7.82,
      "text": "Okay, go on. So, based on the history and the examination, I'd lean towards a simple viral cold."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.15,
      "end_seconds": 343.63,
      "duration_seconds": 1.48,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.48,
      "end_seconds": 367.52,
      "duration_seconds": 23.04,
      "text": "nothing I've seen today points to an emergency it looks like a simple viral cold rest, plenty of fluids, and paracetamol if you ache if you develop a high fever or trouble breathing, that's the point to come in urgently i'd like you back if it is not better in ten days have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.47,
      "end_seconds": 371.71,
      "duration_seconds": 2.24,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
