      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.61,
      "end_seconds": 286.14,
      "duration_seconds": 2.53,
      "text": "have you been to theatre before?"
