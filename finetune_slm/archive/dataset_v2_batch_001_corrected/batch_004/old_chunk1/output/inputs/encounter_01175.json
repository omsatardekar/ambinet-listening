    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.57,
      "end_seconds": 54.29,
      "duration_seconds": 22.72,
      "text": "sorry, you know, what was I saying, it's a runny nose i thought I'd wait, but it hasn't gone i thought it would sort itself out, but it hasn't i'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0008",
