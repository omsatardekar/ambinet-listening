      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.08,
      "end_seconds": 223.76,
      "duration_seconds": 3.68,
      "text": "Any shortness of breath, chest pain or ear pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.29,
      "end_seconds": 231.52,
      "duration_seconds": 7.23,
      "text": "Erm, um, no, no shortness of breath, chest pain or ear pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.96,
      "end_seconds": 234.67,
      "duration_seconds": 1.71,
      "text": "any sign of fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.05,
      "end_seconds": 239.09,
      "duration_seconds": 3.04,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.9,
      "end_seconds": 243.04,
      "duration_seconds": 3.14,
      "text": "Any problems with your joints or muscles?"
