    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.14,
      "end_seconds": 245.69,
      "duration_seconds": 1.55,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.38,
      "end_seconds": 250.71,
      "duration_seconds": 3.33,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 252.45,
      "end_seconds": 262.74,
      "duration_seconds": 10.29,
      "text": "she takes clopidogrel, 75 milligrams, once a day for the stent ah, it's throat lozenges, when needed, doctor"
