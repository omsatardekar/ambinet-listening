{
  "schema_version": "1.0",
  "encounter_id": "01108",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 6.64,
      "duration_seconds": 5.49,
      "text": "Hello, uh, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.62,
      "end_seconds": 12.99,
      "duration_seconds": 4.37,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.74,
      "end_seconds": 19.94,
      "duration_seconds": 6.2,
      "text": "So, uh, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.99,
      "end_seconds": 23.8,
      "duration_seconds": 2.81,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.03,
      "end_seconds": 40.67,
      "duration_seconds": 15.64,
      "text": "I've been wanting contraception. I'd rather not end up on lots of tablets if I can avoid it. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.35,
      "end_seconds": 44.52,
      "duration_seconds": 2.17,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.96,
      "end_seconds": 51.71,
      "duration_seconds": 5.75,
      "text": "Slightly heavy periods goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.89,
      "end_seconds": 58.15,
      "duration_seconds": 5.26,
      "text": "Okay, did you get breast lumps, smoking or migraine with aura?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.91,
      "end_seconds": 62.68,
      "duration_seconds": 3.77,
      "text": "Right, no, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.16,
      "end_seconds": 71.68,
      "duration_seconds": 4.52,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.68,
      "end_seconds": 78.73,
      "duration_seconds": 6.05,
      "text": "My heart's been fine, um, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.21,
      "end_seconds": 86.55,
      "duration_seconds": 2.34,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.77,
      "end_seconds": 91.5,
      "duration_seconds": 3.73,
      "text": "Hmm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.62,
      "end_seconds": 100.3,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.92,
      "end_seconds": 105.03,
      "duration_seconds": 4.11,
      "text": "An irregular heartbeat, for about ten years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.72,
      "end_seconds": 106.57,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.49,
      "end_seconds": 111.71,
      "duration_seconds": 3.22,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.14,
      "end_seconds": 118.98,
      "duration_seconds": 2.84,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.27,
      "end_seconds": 125.75,
      "duration_seconds": 5.48,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.64,
      "end_seconds": 129.46,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.34,
      "end_seconds": 133.77,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.71,
      "end_seconds": 139.56,
      "duration_seconds": 3.85,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.15,
      "end_seconds": 143.83,
      "duration_seconds": 3.68,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.12,
      "end_seconds": 147.75,
      "duration_seconds": 2.63,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.73,
      "end_seconds": 158.86,
      "duration_seconds": 10.13,
      "text": "Sorry, what was I saying, I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.22,
      "end_seconds": 173.24,
      "duration_seconds": 5.02,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.8,
      "end_seconds": 179.72,
      "duration_seconds": 4.92,
      "text": "Uh, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.67,
      "end_seconds": 184.36,
      "duration_seconds": 3.69,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 186.11,
      "end_seconds": 191.29,
      "duration_seconds": 5.18,
      "text": "She takes bisoprolol, 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.52,
      "end_seconds": 196.99,
      "duration_seconds": 4.47,
      "text": "Before this I was on metoprolol; that's been stopped."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.33,
      "end_seconds": 202.3,
      "duration_seconds": 3.97,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.79,
      "end_seconds": 208.11,
      "duration_seconds": 4.32,
      "text": "Ah, um, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.92,
      "end_seconds": 211.89,
      "duration_seconds": 1.97,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.77,
      "end_seconds": 231.43,
      "duration_seconds": 1.66,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.57,
      "end_seconds": 234.3,
      "duration_seconds": 1.73,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.24,
      "end_seconds": 247.23,
      "duration_seconds": 1.99,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.48,
      "end_seconds": 250.19,
      "duration_seconds": 1.71,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.95,
      "end_seconds": 258.33,
      "duration_seconds": 2.38,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.77,
      "end_seconds": 284.01,
      "duration_seconds": 8.24,
      "text": "So, based on the history and the examination, it fits best with suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.06,
      "end_seconds": 289.82,
      "duration_seconds": 3.76,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.35,
      "end_seconds": 309.27,
      "duration_seconds": 17.92,
      "text": "I understand the worry. At the moment I'd say it's suitable for hormonal contraception with no risk factors, and we'll watch how it goes. There's nothing new for me to start or arrange today. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.09,
      "end_seconds": 313.44,
      "duration_seconds": 3.35,
      "text": "Thank you, uh, that's helpful."
    }
  ]
}