{
  "schema_version": "1.0",
  "encounter_id": "01422",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.51,
      "duration_seconds": 3.99,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.34,
      "end_seconds": 10.71,
      "duration_seconds": 4.37,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.36,
      "end_seconds": 17.0,
      "duration_seconds": 4.64,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.53,
      "end_seconds": 26.44,
      "duration_seconds": 7.91,
      "text": "Yeah, uh, it's severe lower back pain. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.18,
      "end_seconds": 29.5,
      "duration_seconds": 2.32,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.56,
      "end_seconds": 46.96,
      "duration_seconds": 13.4,
      "text": "Ever since... since this morning, really. I took the morning off to come in today. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.56,
      "end_seconds": 52.74,
      "duration_seconds": 5.18,
      "text": "Yes, carry on. So, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.05,
      "end_seconds": 68.08,
      "duration_seconds": 14.03,
      "text": "About a seven out of ten. I've also had trouble passing urine. Oh, and numbness between my legs. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.64,
      "end_seconds": 82.42,
      "duration_seconds": 2.78,
      "text": "Alright, any fever or recent fall?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.07,
      "end_seconds": 87.72,
      "duration_seconds": 4.65,
      "text": "No fever or recent fall, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.42,
      "end_seconds": 90.91,
      "duration_seconds": 2.49,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.72,
      "end_seconds": 95.31,
      "duration_seconds": 3.59,
      "text": "No, you know, my breathing's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.04,
      "end_seconds": 100.27,
      "duration_seconds": 3.23,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.08,
      "end_seconds": 104.38,
      "duration_seconds": 3.3,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.25,
      "end_seconds": 108.0,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.87,
      "end_seconds": 112.11,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.99,
      "end_seconds": 115.56,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.22,
      "end_seconds": 120.91,
      "duration_seconds": 3.69,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.05,
      "end_seconds": 136.98,
      "duration_seconds": 3.93,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 138.48,
      "end_seconds": 141.76,
      "duration_seconds": 3.28,
      "text": "It's naproxen, twice a day, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.9,
      "end_seconds": 145.07,
      "duration_seconds": 2.17,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 150.79,
      "end_seconds": 151.86,
      "duration_seconds": 1.07,
      "text": "250 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.71,
      "end_seconds": 157.0,
      "duration_seconds": 4.29,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.03,
      "end_seconds": 161.9,
      "duration_seconds": 3.87,
      "text": "I'm allergic to amoxicillin, I get hives."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.96,
      "end_seconds": 165.72,
      "duration_seconds": 2.76,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.03,
      "end_seconds": 171.33,
      "duration_seconds": 4.3,
      "text": "I have arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.9,
      "end_seconds": 174.29,
      "duration_seconds": 2.39,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.73,
      "end_seconds": 188.91,
      "duration_seconds": 2.18,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 218.57,
      "duration_seconds": 12.95,
      "text": "Okay: height 160 centimetres, pulse 74, temp 36.8 degrees. And BMI works out to 27.7, weight 71 kilos, blood pressure 127 over 78, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.58,
      "end_seconds": 220.93,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.63,
      "end_seconds": 225.47,
      "duration_seconds": 3.84,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.69,
      "end_seconds": 232.15,
      "duration_seconds": 4.46,
      "text": "Right, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.56,
      "end_seconds": 234.94,
      "duration_seconds": 1.38,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.87,
      "end_seconds": 256.55,
      "duration_seconds": 5.68,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.83,
      "end_seconds": 283.45,
      "duration_seconds": 22.62,
      "text": "That's the examination finished. Putting it all together, I think we're dealing with possible cauda equina syndrome needing an urgent scan at this stage. The reason I say that is that your story and my examination fit together. It could also be a large disc prolapse, so we'll keep that open."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.42,
      "end_seconds": 310.58,
      "duration_seconds": 15.16,
      "text": "An urgent MRI of the spine is what I'd like next, for possible cauda equina. You need to go to hospital now for an emergency scan. The spinal team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.18,
      "end_seconds": 315.47,
      "duration_seconds": 3.29,
      "text": "Sure, um, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.4,
      "end_seconds": 325.1,
      "duration_seconds": 7.7,
      "text": "The thing that would worry me is if the numbness spreads. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.71,
      "end_seconds": 328.45,
      "duration_seconds": 1.74,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.25,
      "end_seconds": 335.94,
      "duration_seconds": 5.69,
      "text": "Let's plan a check straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.66,
      "end_seconds": 340.03,
      "duration_seconds": 2.37,
      "text": "Alright, thanks, take care."
    }
  ]
}