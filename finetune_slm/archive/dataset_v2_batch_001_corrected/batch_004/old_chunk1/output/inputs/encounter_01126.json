  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 7.85,
      "duration_seconds": 7.03,
      "text": "Actually, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.38,
      "end_seconds": 13.53,
      "duration_seconds": 4.15,
      "text": "right, of course, leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.49,
      "end_seconds": 20.02,
      "duration_seconds": 5.53,
      "text": "I've been sweating, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.1,
      "end_seconds": 22.41,
      "duration_seconds": 1.31,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.77,
      "end_seconds": 35.71,
      "duration_seconds": 11.94,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.8,
      "end_seconds": 39.17,
      "duration_seconds": 2.37,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 43.66,
      "duration_seconds": 2.5,
      "text": "It, It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.73,
      "end_seconds": 49.55,
      "duration_seconds": 2.82,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.91,
      "end_seconds": 64.6,
      "duration_seconds": 13.69,
      "text": "When it starts I tend to get pain going into my left arm as well. The The pain going into my left arm? That's been for about four days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.63,
      "end_seconds": 71.89,
      "duration_seconds": 5.26,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.36,
      "end_seconds": 83.9,
      "duration_seconds": 2.54,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.57,
      "end_seconds": 102.47,
      "duration_seconds": 7.9,
      "text": "Okay: temperature is 36.6 degrees, oxygen saturation is 98 percent, blood pressure 136 over 76. And pulse 112."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.04,
      "end_seconds": 108.74,
      "duration_seconds": 3.7,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.31,
      "end_seconds": 111.73,
      "duration_seconds": 1.42,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.49,
      "end_seconds": 133.88,
      "duration_seconds": 4.39,
      "text": "you are pale and sweaty, and your pulse is fast"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.04,
      "end_seconds": 138.82,
      "duration_seconds": 1.78,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.89,
      "end_seconds": 158.78,
      "duration_seconds": 4.89,
      "text": "Let me check a few things. Any fever, leg swelling or cough?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.69,
      "end_seconds": 163.12,
      "duration_seconds": 2.43,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.71,
      "end_seconds": 166.91,
      "duration_seconds": 2.2,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.36,
      "end_seconds": 172.2,
      "duration_seconds": 3.84,
      "text": "Yeah, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.87,
      "end_seconds": 174.86,
      "duration_seconds": 1.99,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.57,
      "end_seconds": 177.49,
      "duration_seconds": 1.92,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.57,
      "end_seconds": 185.15,
      "duration_seconds": 6.58,
      "text": "Yes, high cholesterol is known to us, good to have that that clear."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.93,
      "end_seconds": 202.42,
      "duration_seconds": 4.49,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.02,
      "end_seconds": 207.26,
      "duration_seconds": 4.24,
      "text": "Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.79,
      "end_seconds": 211.26,
      "duration_seconds": 3.47,
      "text": "Right, right. Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.8,
      "end_seconds": 215.07,
      "duration_seconds": 2.27,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.33,
      "end_seconds": 218.16,
      "duration_seconds": 1.83,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.41,
      "end_seconds": 223.81,
      "duration_seconds": 4.4,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.59,
      "end_seconds": 228.96,
      "duration_seconds": 3.37,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.47,
      "end_seconds": 232.62,
      "duration_seconds": 3.15,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.78,
      "end_seconds": 238.17,
      "duration_seconds": 4.39,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.44,
      "end_seconds": 243.04,
      "duration_seconds": 3.6,
      "text": "um, I've never had an allergy"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.08,
      "end_seconds": 250.38,
      "duration_seconds": 5.3,
      "text": "right, here's what I'm thinking i'd lean towards a possible heart attack"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.69,
      "end_seconds": 286.58,
      "duration_seconds": 26.89,
      "text": "I'll request a troponin blood test, it'll help with chest pain. I think an ECG makes sense here, for chest pain. I'll start you on aspirin, 300 milligrams, once now, single dose. It's for possible heart attack. Stay lying down and do not eat or drink. I think the cardiac team should see you too. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.01,
      "end_seconds": 289.78,
      "duration_seconds": 1.77,
      "text": "yes, that's manageable"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.56,
      "end_seconds": 294.06,
      "duration_seconds": 2.5,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.16,
      "end_seconds": 299.88,
      "duration_seconds": 3.72,
      "text": "Let me think, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.39,
      "end_seconds": 302.87,
      "duration_seconds": 1.48,
      "text": "See you soon."
    }
  ]
