  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 3.98,
      "duration_seconds": 3.41,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.79,
      "end_seconds": 8.42,
      "duration_seconds": 3.63,
      "text": "Well, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.41,
      "end_seconds": 11.21,
      "duration_seconds": 1.8,
      "text": "Cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 15.72,
      "duration_seconds": 3.99,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.65,
      "end_seconds": 20.37,
      "duration_seconds": 2.72,
      "text": "so what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.04,
      "end_seconds": 25.06,
      "duration_seconds": 4.02,
      "text": "It's my face drooping on one side, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.84,
      "end_seconds": 28.33,
      "duration_seconds": 2.49,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.35,
      "end_seconds": 56.31,
      "duration_seconds": 25.96,
      "text": "It's been like this since last night. Well, as for weakness in my right arm, I honestly can't say when that began. It might have been last month or the month before. As for weakness in my right arm, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.93,
      "end_seconds": 60.18,
      "duration_seconds": 3.25,
      "text": "any fever, seizure or loss of consciousness?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.22,
      "end_seconds": 67.45,
      "duration_seconds": 5.23,
      "text": "No, um, no fever, seizure or loss of consciousness."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.63,
      "end_seconds": 71.02,
      "duration_seconds": 2.39,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.2,
      "end_seconds": 73.8,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.73,
      "end_seconds": 78.71,
      "duration_seconds": 2.98,
      "text": "any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.72,
      "end_seconds": 85.29,
      "duration_seconds": 5.57,
      "text": "Sorry, what was I saying, I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.85,
      "end_seconds": 89.6,
      "duration_seconds": 2.75,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.08,
      "end_seconds": 95.57,
      "duration_seconds": 4.49,
      "text": "I've had an irregular heartbeat for two years now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.59,
      "end_seconds": 98.31,
      "duration_seconds": 1.72,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.36,
      "end_seconds": 104.44,
      "duration_seconds": 5.08,
      "text": "I've, I've had high blood pressure for two years now"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.33,
      "end_seconds": 119.06,
      "duration_seconds": 12.73,
      "text": "Alright, an irregular heartbeat and high blood pressure, that matches what I have here. Right, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.89,
      "end_seconds": 144.55,
      "duration_seconds": 23.66,
      "text": "Metoprolol, 50 milligrams, twice a day for the heart rhythm. My family kept telling me to get it checked. Amlodipine. I take it 5 milligrams, once a day for my pressure. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.6,
      "end_seconds": 149.82,
      "duration_seconds": 4.22,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.57,
      "end_seconds": 152.37,
      "duration_seconds": 1.8,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.15,
      "end_seconds": 162.95,
      "duration_seconds": 2.8,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.81,
      "end_seconds": 165.67,
      "duration_seconds": 1.86,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.36,
      "end_seconds": 187.56,
      "duration_seconds": 3.2,
      "text": "Okay, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.29,
      "end_seconds": 199.63,
      "duration_seconds": 10.34,
      "text": "I'm a hairdresser, on my feet all day. I live with my elderly mother. I hardly move around during the day"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.54,
      "end_seconds": 210.78,
      "duration_seconds": 2.24,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.27,
      "end_seconds": 222.4,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.57,
      "end_seconds": 244.16,
      "duration_seconds": 7.59,
      "text": "okay: temp 36.5 degrees, pulse 91, BP is 164 over 97. And oxygen saturation is 96 percent"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.38,
      "end_seconds": 248.31,
      "duration_seconds": 2.93,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.66,
      "end_seconds": 250.78,
      "duration_seconds": 1.12,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.64,
      "end_seconds": 255.42,
      "duration_seconds": 2.78,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.27,
      "end_seconds": 276.1,
      "duration_seconds": 6.83,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.49,
      "end_seconds": 286.59,
      "duration_seconds": 8.1,
      "text": "That's the examination finished. Having listened and examined, the most likely explanation is a possible stroke, within the treatment window."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.54,
      "end_seconds": 290.81,
      "duration_seconds": 3.27,
      "text": "I mean, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.01,
      "end_seconds": 313.93,
      "duration_seconds": 21.92,
      "text": "nothing I've seen today points to an emergency. It looks like a possible stroke, within the treatment window, but I'd like to confirm. I'm sending you for a blood sugar test cos of stroke symptoms. Call an ambulance now, you need hospital immediately. The stroke team would be the right next step, I'll refer you"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.5,
      "end_seconds": 319.04,
      "duration_seconds": 4.54,
      "text": "Okay, so sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.59,
      "end_seconds": 331.41,
      "duration_seconds": 11.82,
      "text": "If the symptoms change, that's the point to come in urgently. I'd like you back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.01,
      "end_seconds": 336.36,
      "duration_seconds": 4.35,
      "text": "yeah, good, thanks, I'll see you then"
    }
  ]
}