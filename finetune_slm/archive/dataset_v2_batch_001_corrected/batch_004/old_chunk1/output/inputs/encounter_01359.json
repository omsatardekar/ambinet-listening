{
  "schema_version": "1.0",
  "encounter_id": "01359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 5.72,
      "duration_seconds": 4.86,
      "text": "Hello, come in. Mind the step. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.29,
      "end_seconds": 12.81,
      "duration_seconds": 5.52,
      "text": "I've been dealing with a red hot swelling on my leg."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.13,
      "end_seconds": 15.84,
      "duration_seconds": 1.71,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.44,
      "end_seconds": 20.91,
      "duration_seconds": 3.47,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.87,
      "end_seconds": 24.64,
      "duration_seconds": 2.77,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.48,
      "end_seconds": 29.03,
      "duration_seconds": 2.55,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.14,
      "end_seconds": 33.12,
      "duration_seconds": 2.98,
      "text": "Right, does anything else come with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.65,
      "end_seconds": 52.47,
      "duration_seconds": 18.82,
      "text": "When it starts I tend to get pain much worse than it looks as well. As for pain much worse than it looks, maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.91,
      "end_seconds": 65.92,
      "duration_seconds": 3.01,
      "text": "Any insect bite or cut at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.65,
      "end_seconds": 70.7,
      "duration_seconds": 4.05,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.03,
      "end_seconds": 73.99,
      "duration_seconds": 1.96,
      "text": "So, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.63,
      "end_seconds": 77.77,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.68,
      "end_seconds": 81.93,
      "duration_seconds": 2.25,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.91,
      "end_seconds": 87.57,
      "duration_seconds": 3.66,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.69,
      "end_seconds": 95.26,
      "duration_seconds": 6.57,
      "text": "I follow. Before we go further, any allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.83,
      "end_seconds": 98.44,
      "duration_seconds": 1.61,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.19,
      "end_seconds": 103.4,
      "duration_seconds": 3.21,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.08,
      "end_seconds": 109.01,
      "duration_seconds": 3.93,
      "text": "Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.34,
      "end_seconds": 117.69,
      "duration_seconds": 1.35,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.32,
      "end_seconds": 122.8,
      "duration_seconds": 3.48,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.01,
      "end_seconds": 126.33,
      "duration_seconds": 2.32,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.95,
      "end_seconds": 133.1,
      "duration_seconds": 4.15,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.15,
      "end_seconds": 136.59,
      "duration_seconds": 2.44,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.93,
      "end_seconds": 146.92,
      "duration_seconds": 4.99,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.85,
      "end_seconds": 166.88,
      "duration_seconds": 3.03,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.51,
      "end_seconds": 171.39,
      "duration_seconds": 2.88,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 172.76,
      "end_seconds": 183.02,
      "duration_seconds": 10.26,
      "text": "Okay, so the vitals from earlier. SpO2 95 percent on room air, temp 38.7 degrees, blood pressure 108 over 73. Pulse is 106 beats a minute."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.47,
      "end_seconds": 187.51,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.35,
      "end_seconds": 192.24,
      "duration_seconds": 2.89,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.26,
      "end_seconds": 194.66,
      "duration_seconds": 1.4,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.59,
      "end_seconds": 219.66,
      "duration_seconds": 8.07,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.17,
      "end_seconds": 227.83,
      "duration_seconds": 2.66,
      "text": "Alright, you can sit up now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.92,
      "end_seconds": 244.79,
      "duration_seconds": 8.87,
      "text": "So where does that leave us? This looks most like a severe deep skin infection needing urgent surgery review."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.43,
      "end_seconds": 247.26,
      "duration_seconds": 1.83,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.27,
      "end_seconds": 267.31,
      "duration_seconds": 18.04,
      "text": "I can't promise yet, but most people with a severe deep skin infection needing urgent surgery review do well once it's treated properly. I'll request an urgent surgical review, it'll help with possible necrotising infection. I am sending you to hospital now, do not wait."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.56,
      "end_seconds": 277.4,
      "duration_seconds": 9.84,
      "text": "I see, go ahead. If you cannot go now, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.47,
      "end_seconds": 281.61,
      "duration_seconds": 2.14,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.33,
      "end_seconds": 288.43,
      "duration_seconds": 2.1,
      "text": "Book a review straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.51,
      "end_seconds": 293.18,
      "duration_seconds": 2.67,
      "text": "Right, I can manage that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.96,
      "end_seconds": 296.87,
      "duration_seconds": 2.91,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.5,
      "end_seconds": 300.6,
      "duration_seconds": 3.1,
      "text": "Good, thanks, I'll see you then."
    }
  ]
