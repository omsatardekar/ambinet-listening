{
  "schema_version": "1.0",
  "encounter_id": "01492",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.79,
      "end_seconds": 8.48,
      "duration_seconds": 7.69,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.07,
      "end_seconds": 12.39,
      "duration_seconds": 3.32,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.18,
      "end_seconds": 18.43,
      "duration_seconds": 4.25,
      "text": "I'm here because of crushing chest pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.12,
      "end_seconds": 22.52,
      "duration_seconds": 3.4,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 23.31,
      "end_seconds": 27.17,
      "duration_seconds": 3.86,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.96,
      "end_seconds": 38.27,
      "duration_seconds": 9.31,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.99,
      "end_seconds": 50.0,
      "duration_seconds": 10.01,
      "text": "Honestly, all the time. Severe, really. I notice it more with exertion. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.94,
      "end_seconds": 54.9,
      "duration_seconds": 2.96,
      "text": "So, have you been feeling sick?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.7,
      "end_seconds": 80.13,
      "duration_seconds": 23.43,
      "text": "Sorry, uh, what was I saying, yes, that started yesterday. As for feeling sick, about a six out of ten. As for sweating, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 85.05,
      "end_seconds": 96.53,
      "duration_seconds": 11.48,
      "text": "Doctor, I've got the readings for you. Temperature is 36.7 degrees, pulse is 104 beats a minute, respiratory rate 18, blood pressure 113 over 79."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.38,
      "end_seconds": 99.8,
      "duration_seconds": 1.42,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.11,
      "end_seconds": 110.83,
      "duration_seconds": 3.72,
      "text": "Have you had any fever, leg swelling or cough?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.82,
      "end_seconds": 119.03,
      "duration_seconds": 6.21,
      "text": "Oh, I haven't had fever, leg swelling or cough, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.29,
      "end_seconds": 124.4,
      "duration_seconds": 4.11,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.29,
      "end_seconds": 130.31,
      "duration_seconds": 4.02,
      "text": "Right, uh, no, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.09,
      "end_seconds": 133.77,
      "duration_seconds": 2.68,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.21,
      "end_seconds": 138.24,
      "duration_seconds": 3.03,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.64,
      "end_seconds": 159.86,
      "duration_seconds": 4.22,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.34,
      "end_seconds": 166.49,
      "duration_seconds": 5.15,
      "text": "I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.66,
      "end_seconds": 170.51,
      "duration_seconds": 2.85,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.23,
      "end_seconds": 188.01,
      "duration_seconds": 15.78,
      "text": "I have high blood pressure. I have high cholesterol, for about ten years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.62,
      "end_seconds": 190.61,
      "duration_seconds": 1.99,
      "text": "Right, any other things?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.78,
      "end_seconds": 199.54,
      "duration_seconds": 7.76,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.91,
      "end_seconds": 210.86,
      "duration_seconds": 2.95,
      "text": "Right, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.38,
      "end_seconds": 215.97,
      "duration_seconds": 4.59,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.39,
      "end_seconds": 221.79,
      "duration_seconds": 4.4,
      "text": "Alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.04,
      "end_seconds": 230.04,
      "duration_seconds": 7.0,
      "text": "My grandfather had a stroke. Yeah, uh, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.41,
      "end_seconds": 238.1,
      "duration_seconds": 3.69,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.83,
      "end_seconds": 243.56,
      "duration_seconds": 4.73,
      "text": "So, I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 244.14,
      "end_seconds": 249.12,
      "duration_seconds": 4.98,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.4,
      "end_seconds": 254.91,
      "duration_seconds": 4.51,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.68,
      "end_seconds": 266.99,
      "duration_seconds": 10.31,
      "text": "Well, uh, not with me. I'll bring it next time. Rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.82,
      "end_seconds": 271.24,
      "duration_seconds": 2.42,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.9,
      "end_seconds": 275.35,
      "duration_seconds": 3.45,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.57,
      "end_seconds": 279.24,
      "duration_seconds": 2.67,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 279.81,
      "end_seconds": 283.66,
      "duration_seconds": 3.85,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.52,
      "end_seconds": 295.48,
      "duration_seconds": 9.96,
      "text": "From what you've told me, I don't have a clear answer today: a possible heart attack is possible, and so is unstable angina."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 297.02,
      "end_seconds": 298.63,
      "duration_seconds": 1.61,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.44,
      "end_seconds": 309.42,
      "duration_seconds": 9.98,
      "text": "I understand the worry. At the moment I'd say it's a possible heart attack, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 310.12,
      "end_seconds": 313.57,
      "duration_seconds": 3.45,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.99,
      "end_seconds": 321.45,
      "duration_seconds": 6.46,
      "text": "Alright, good, thanks for doing that. We should do a troponin blood test for chest pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.44,
      "end_seconds": 326.17,
      "duration_seconds": 3.73,
      "text": "Yeah, where would I go for that?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.79,
      "end_seconds": 353.4,
      "duration_seconds": 26.61,
      "text": "What I'm giving you is aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. Stay lying down and do not eat or drink. I'll also refer you to the cardiac team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.3,
      "end_seconds": 361.0,
      "duration_seconds": 1.7,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.04,
      "end_seconds": 368.72,
      "duration_seconds": 6.68,
      "text": "Let's review you straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 370.77,
      "end_seconds": 374.91,
      "duration_seconds": 4.14,
      "text": "Well, I think I understand everything. Thanks."
    }
  ]
}