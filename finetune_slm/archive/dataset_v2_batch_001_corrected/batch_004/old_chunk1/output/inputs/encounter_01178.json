{
  "schema_version": "1.0",
  "encounter_id": "01178",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 3.29,
      "duration_seconds": 2.54,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.95,
      "end_seconds": 8.62,
      "duration_seconds": 4.67,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.89,
      "end_seconds": 11.36,
      "duration_seconds": 1.47,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.49,
      "end_seconds": 15.63,
      "duration_seconds": 3.14,
      "text": "It's my throat closing up, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.73,
      "end_seconds": 20.5,
      "duration_seconds": 2.77,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.87,
      "end_seconds": 24.26,
      "duration_seconds": 2.39,
      "text": "About... well, about four days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.87,
      "end_seconds": 28.7,
      "duration_seconds": 2.83,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.28,
      "end_seconds": 33.23,
      "duration_seconds": 3.95,
      "text": "I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.82,
      "end_seconds": 38.28,
      "duration_seconds": 4.46,
      "text": "Mm, okay. Have you had any recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.74,
      "end_seconds": 43.91,
      "duration_seconds": 4.17,
      "text": "I haven't had recent illness or chest pain, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.36,
      "end_seconds": 47.41,
      "duration_seconds": 2.05,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.77,
      "end_seconds": 56.67,
      "duration_seconds": 4.9,
      "text": "Sorry, what was I saying, no, joints are fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.76,
      "end_seconds": 68.72,
      "duration_seconds": 2.96,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.66,
      "end_seconds": 82.32,
      "duration_seconds": 12.66,
      "text": "My husband and I live above the shop. I'm a bus driver, so I sit for long hours. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.09,
      "end_seconds": 89.73,
      "duration_seconds": 6.64,
      "text": "Do you have any medical conditions I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.49,
      "end_seconds": 92.29,
      "duration_seconds": 1.8,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.93,
      "end_seconds": 100.51,
      "duration_seconds": 2.58,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.29,
      "end_seconds": 105.23,
      "duration_seconds": 2.94,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.02,
      "end_seconds": 123.58,
      "duration_seconds": 2.56,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.68,
      "end_seconds": 127.97,
      "duration_seconds": 3.29,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.37,
      "end_seconds": 144.14,
      "duration_seconds": 3.77,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.01,
      "end_seconds": 158.02,
      "duration_seconds": 2.01,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.86,
      "end_seconds": 182.46,
      "duration_seconds": 8.6,
      "text": "Okay: SpO2 97 percent on room air, temperature is 37.0 degrees. And blood pressure 104 over 61, heart rate 108."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.35,
      "end_seconds": 186.4,
      "duration_seconds": 2.05,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.19,
      "end_seconds": 193.03,
      "duration_seconds": 2.84,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.48,
      "end_seconds": 199.01,
      "duration_seconds": 4.53,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.09,
      "end_seconds": 201.04,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.24,
      "end_seconds": 203.51,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.81,
      "end_seconds": 223.89,
      "duration_seconds": 7.08,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.85,
      "end_seconds": 231.18,
      "duration_seconds": 2.33,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.38,
      "end_seconds": 246.87,
      "duration_seconds": 8.49,
      "text": "From what you've told me and what I found, I think we're dealing with anaphylaxis at this stage."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.18,
      "end_seconds": 255.35,
      "duration_seconds": 3.17,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.36,
      "end_seconds": 274.32,
      "duration_seconds": 17.96,
      "text": "I understand the worry. At the moment I'd say it's anaphylaxis, and we'll know more once the monitoring is back. I'm going to order monitoring, for anaphylaxis. Let's use adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.44,
      "end_seconds": 276.95,
      "duration_seconds": 1.51,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.98,
      "end_seconds": 302.35,
      "duration_seconds": 24.37,
      "text": "Lie flat with your legs raised, I am giving the injection now. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. Come back or go to emergency straight away if the symptoms return. I'll want another look straight away. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.0,
      "end_seconds": 306.27,
      "duration_seconds": 2.27,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}