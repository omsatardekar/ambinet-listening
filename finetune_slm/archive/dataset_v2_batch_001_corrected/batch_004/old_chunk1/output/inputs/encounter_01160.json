{
  "schema_version": "1.0",
  "encounter_id": "01160",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.23,
      "duration_seconds": 5.36,
      "text": "Let me think, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.31,
      "end_seconds": 11.99,
      "duration_seconds": 4.68,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.59,
      "end_seconds": 17.37,
      "duration_seconds": 4.78,
      "text": "Well, I've been having a cut on my finger."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.54,
      "end_seconds": 22.23,
      "duration_seconds": 3.69,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.13,
      "end_seconds": 26.15,
      "duration_seconds": 3.02,
      "text": "Yeah, it's been two months now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.53,
      "end_seconds": 30.3,
      "duration_seconds": 2.77,
      "text": "So, what eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.65,
      "end_seconds": 40.69,
      "duration_seconds": 9.04,
      "text": "Only a plaster, uh, and it's not much. There was a little bleeding, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.38,
      "end_seconds": 44.54,
      "duration_seconds": 3.16,
      "text": "Did you get dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.08,
      "end_seconds": 49.44,
      "duration_seconds": 3.36,
      "text": "No, no dirty blade or numbness."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.69,
      "end_seconds": 55.49,
      "duration_seconds": 4.8,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.48,
      "end_seconds": 59.56,
      "duration_seconds": 2.08,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.65,
      "end_seconds": 65.54,
      "duration_seconds": 3.89,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.39,
      "end_seconds": 68.77,
      "duration_seconds": 1.38,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.93,
      "end_seconds": 87.84,
      "duration_seconds": 4.91,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.52,
      "end_seconds": 100.06,
      "duration_seconds": 7.54,
      "text": "Years back I got vomiting from tramadol, so I stay away from it now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.96,
      "end_seconds": 104.86,
      "duration_seconds": 3.9,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.85,
      "end_seconds": 109.47,
      "duration_seconds": 2.62,
      "text": "Ah, my brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.23,
      "end_seconds": 113.98,
      "duration_seconds": 2.75,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.35,
      "end_seconds": 118.95,
      "duration_seconds": 3.6,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.47,
      "end_seconds": 126.84,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.14,
      "end_seconds": 130.72,
      "duration_seconds": 2.58,
      "text": "I've, I've had eczema, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.73,
      "end_seconds": 140.55,
      "duration_seconds": 8.82,
      "text": "Yes, eczema is known to us, good to have that clear. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 145.05,
      "duration_seconds": 2.55,
      "text": "It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.91,
      "end_seconds": 167.14,
      "duration_seconds": 3.23,
      "text": "So, are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.11,
      "end_seconds": 171.06,
      "duration_seconds": 2.95,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.57,
      "end_seconds": 176.23,
      "duration_seconds": 3.66,
      "text": "So, what do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.1,
      "end_seconds": 180.25,
      "duration_seconds": 3.15,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.18,
      "end_seconds": 184.39,
      "duration_seconds": 2.21,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.27,
      "end_seconds": 188.47,
      "duration_seconds": 3.2,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.18,
      "end_seconds": 193.39,
      "duration_seconds": 3.21,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.58,
      "end_seconds": 209.55,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.94,
      "end_seconds": 232.06,
      "duration_seconds": 8.12,
      "text": "Okay: temperature 36.6, pulse 68, BP is 111 over 69, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.65,
      "end_seconds": 235.97,
      "duration_seconds": 2.32,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.67,
      "end_seconds": 240.52,
      "duration_seconds": 3.85,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.61,
      "end_seconds": 244.47,
      "duration_seconds": 2.86,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.24,
      "end_seconds": 257.31,
      "duration_seconds": 3.07,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.75,
      "end_seconds": 260.71,
      "duration_seconds": 1.96,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.52,
      "end_seconds": 278.22,
      "duration_seconds": 5.7,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.6,
      "end_seconds": 302.63,
      "duration_seconds": 20.03,
      "text": "Please sit back down. Right, here's what I'm thinking. I think we're dealing with a minor clean wound that needs only dressing at this stage. Stop me if I've got anything wrong. You've had a cut on your finger for two months, and no numbness or dirty blade."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.66,
      "end_seconds": 306.56,
      "duration_seconds": 2.9,
      "text": "Ah, that's what happened, yes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.24,
      "end_seconds": 315.22,
      "duration_seconds": 7.98,
      "text": "I'll close it with adhesive strips and keep it dry for two days. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.82,
      "end_seconds": 319.62,
      "duration_seconds": 3.8,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}