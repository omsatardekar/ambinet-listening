{
  "schema_version": "1.0",
  "encounter_id": "01172",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 8.56,
      "duration_seconds": 7.29,
      "text": "Erm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.84,
      "end_seconds": 14.05,
      "duration_seconds": 4.21,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.41,
      "end_seconds": 22.42,
      "duration_seconds": 5.01,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.03,
      "end_seconds": 26.73,
      "duration_seconds": 3.7,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.69,
      "end_seconds": 34.61,
      "duration_seconds": 6.92,
      "text": "Doctor, it's a dry cough in the evenings. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.13,
      "end_seconds": 37.9,
      "duration_seconds": 2.77,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 41.51,
      "duration_seconds": 2.71,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.0,
      "end_seconds": 52.42,
      "duration_seconds": 10.42,
      "text": "Okay, go on. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.43,
      "end_seconds": 59.64,
      "duration_seconds": 5.21,
      "text": "Antihistamine helps a bit. I notice it more with pollen season."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.42,
      "end_seconds": 62.45,
      "duration_seconds": 2.03,
      "text": "Have you had sneezing fits?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.0,
      "end_seconds": 66.26,
      "duration_seconds": 2.26,
      "text": "Yes, for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.5,
      "end_seconds": 69.52,
      "duration_seconds": 2.02,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.42,
      "end_seconds": 73.38,
      "duration_seconds": 1.96,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.97,
      "end_seconds": 74.67,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.99,
      "end_seconds": 78.61,
      "duration_seconds": 2.62,
      "text": "There's itchy eyes as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.24,
      "end_seconds": 82.73,
      "duration_seconds": 2.49,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.75,
      "end_seconds": 87.82,
      "duration_seconds": 4.07,
      "text": "It's, It's a few times a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.51,
      "end_seconds": 91.81,
      "duration_seconds": 3.3,
      "text": "Any fever, wheeze or shortness of breath?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.66,
      "end_seconds": 97.83,
      "duration_seconds": 4.17,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.11,
      "end_seconds": 103.08,
      "duration_seconds": 4.97,
      "text": "Hm, okay. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.94,
      "end_seconds": 106.35,
      "duration_seconds": 2.41,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.66,
      "end_seconds": 109.6,
      "duration_seconds": 1.94,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.06,
      "end_seconds": 122.74,
      "duration_seconds": 11.68,
      "text": "Ah, yes, I had a bunion operation, six years ago. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.46,
      "end_seconds": 126.94,
      "duration_seconds": 2.48,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.87,
      "end_seconds": 131.27,
      "duration_seconds": 3.4,
      "text": "Yes, naproxen, it gives me stomach pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.34,
      "end_seconds": 136.77,
      "duration_seconds": 3.43,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 138.12,
      "end_seconds": 145.62,
      "duration_seconds": 7.5,
      "text": "He is on escitalopram, 10 milligrams, once a day, I give it to him."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.95,
      "end_seconds": 146.92,
      "duration_seconds": 0.97,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 151.93,
      "end_seconds": 154.33,
      "duration_seconds": 2.4,
      "text": "It's sumatriptan, when needed, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.22,
      "end_seconds": 158.32,
      "duration_seconds": 2.1,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 160.26,
      "end_seconds": 161.25,
      "duration_seconds": 0.99,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.34,
      "end_seconds": 166.54,
      "duration_seconds": 3.2,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.38,
      "end_seconds": 177.04,
      "duration_seconds": 8.66,
      "text": "For two months. He is on loratadine, 10 milligrams, once a day, I give it to him."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.44,
      "end_seconds": 189.95,
      "duration_seconds": 2.51,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.91,
      "end_seconds": 210.32,
      "duration_seconds": 18.41,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. Yes, I work in a bakery, early starts. I walk the dog every morning. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.2,
      "end_seconds": 225.96,
      "duration_seconds": 3.76,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.84,
      "end_seconds": 242.01,
      "duration_seconds": 14.17,
      "text": "I've had anxiety for two years now. I looked a few things up online, you know, and that probably didn't help. Migraines, for five years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.81,
      "end_seconds": 250.85,
      "duration_seconds": 7.04,
      "text": "Alright, anxiety, that matches what I have here. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.29,
      "end_seconds": 264.53,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.31,
      "end_seconds": 284.35,
      "duration_seconds": 8.04,
      "text": "Okay: respiratory rate 16, pulse is 64 beats a minute. And pressure 110 over 76, saturation 97 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.01,
      "end_seconds": 290.12,
      "duration_seconds": 4.11,
      "text": "I mean, um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.09,
      "end_seconds": 295.04,
      "duration_seconds": 2.95,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.73,
      "end_seconds": 300.66,
      "duration_seconds": 3.93,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.89,
      "end_seconds": 304.3,
      "duration_seconds": 2.41,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.14,
      "end_seconds": 327.69,
      "duration_seconds": 5.55,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.68,
      "end_seconds": 333.7,
      "duration_seconds": 2.02,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.82,
      "end_seconds": 377.51,
      "duration_seconds": 31.69,
      "text": "We'll begin with fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever. Keep windows closed on high-pollen days and wash your hair at night. The thing that would worry me is if you start wheezing. If that happens, go to emergency. I'll want another look in a month. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.94,
      "end_seconds": 384.01,
      "duration_seconds": 5.07,
      "text": "Okay, so okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.12,
      "end_seconds": 386.32,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}