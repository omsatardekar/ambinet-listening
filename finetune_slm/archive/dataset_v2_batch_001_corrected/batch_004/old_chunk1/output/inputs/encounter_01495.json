{
  "schema_version": "1.0",
  "encounter_id": "01495",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 3.74,
      "duration_seconds": 3.21,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.2,
      "end_seconds": 6.39,
      "duration_seconds": 1.19,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.64,
      "end_seconds": 9.41,
      "duration_seconds": 1.77,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.75,
      "end_seconds": 21.58,
      "duration_seconds": 7.83,
      "text": "Let me think, um, it has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.24,
      "end_seconds": 25.02,
      "duration_seconds": 2.78,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.95,
      "end_seconds": 34.52,
      "duration_seconds": 8.57,
      "text": "Let me think, uh, so the thing is, I've got a cut on my finger."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.57,
      "end_seconds": 39.8,
      "duration_seconds": 3.23,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.07,
      "end_seconds": 56.09,
      "duration_seconds": 15.02,
      "text": "Probably about four days. Yeah. Ah, as for little bleeding, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.87,
      "end_seconds": 61.3,
      "duration_seconds": 3.43,
      "text": "Any numbness or dirty blade at all?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.08,
      "end_seconds": 65.4,
      "duration_seconds": 3.32,
      "text": "Right, none of those, no."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.92,
      "end_seconds": 70.58,
      "duration_seconds": 4.66,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 75.32,
      "duration_seconds": 3.98,
      "text": "No, um, that side's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.84,
      "end_seconds": 78.9,
      "duration_seconds": 2.06,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.54,
      "end_seconds": 83.83,
      "duration_seconds": 3.29,
      "text": "Ah, no, joints are fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.18,
      "end_seconds": 91.81,
      "duration_seconds": 2.63,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.53,
      "end_seconds": 108.14,
      "duration_seconds": 14.61,
      "text": "Hmm, I have epilepsy, for two years. I'm hoping you can tell me something definite. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.62,
      "end_seconds": 111.01,
      "duration_seconds": 1.39,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.02,
      "end_seconds": 114.38,
      "duration_seconds": 2.36,
      "text": "I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.45,
      "end_seconds": 117.87,
      "duration_seconds": 1.42,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.47,
      "end_seconds": 128.06,
      "duration_seconds": 8.59,
      "text": "Right, so epilepsy is already on your record. We'll keep that in mind today. Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.1,
      "end_seconds": 134.32,
      "duration_seconds": 4.22,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.21,
      "end_seconds": 137.97,
      "duration_seconds": 1.76,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.42,
      "end_seconds": 144.54,
      "duration_seconds": 4.12,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.25,
      "end_seconds": 150.6,
      "duration_seconds": 4.35,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.98,
      "end_seconds": 157.56,
      "duration_seconds": 5.58,
      "text": "Um, I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.29,
      "end_seconds": 172.12,
      "duration_seconds": 3.83,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.51,
      "end_seconds": 177.36,
      "duration_seconds": 3.85,
      "text": "Lamotrigine, 100 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.72,
      "end_seconds": 186.27,
      "duration_seconds": 3.55,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.68,
      "end_seconds": 202.75,
      "duration_seconds": 15.07,
      "text": "Not with me. I'll bring it next time. Uh, I'm on escitalopram, 10 milligrams, once a day. So, I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.01,
      "end_seconds": 224.21,
      "duration_seconds": 3.2,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.57,
      "end_seconds": 235.78,
      "duration_seconds": 10.21,
      "text": "I had my septum straightened in my thirties. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 244.21,
      "end_seconds": 253.79,
      "duration_seconds": 9.58,
      "text": "Doctor, I've got the readings for you. Temp 36.5 degrees, pulse 80, respiratory rate 17. Oxygen saturation is 97 percent, pressure 110 over 75."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.0,
      "end_seconds": 255.7,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.66,
      "end_seconds": 262.05,
      "duration_seconds": 4.39,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.69,
      "end_seconds": 265.82,
      "duration_seconds": 2.13,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.58,
      "end_seconds": 283.29,
      "duration_seconds": 5.71,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.38,
      "end_seconds": 296.29,
      "duration_seconds": 9.91,
      "text": "That's the examination finished. Let me tell you where I've got to. This is probably a minor clean wound that needs only dressing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.01,
      "end_seconds": 300.12,
      "duration_seconds": 3.11,
      "text": "Actually, will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.26,
      "end_seconds": 332.73,
      "duration_seconds": 31.47,
      "text": "I understand the worry. At the moment I'd say it's a minor clean wound that needs only dressing, and we'll watch how it goes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I don't need to add any tests or treatment at this point. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.14,
      "end_seconds": 335.73,
      "duration_seconds": 1.59,
      "text": "That's clear, thanks."
    }
  ]
}