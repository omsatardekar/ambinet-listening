{
  "schema_version": "1.0",
  "encounter_id": "01373",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 6.75,
      "duration_seconds": 5.94,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.82,
      "end_seconds": 11.94,
      "duration_seconds": 4.12,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.49,
      "end_seconds": 23.08,
      "duration_seconds": 9.59,
      "text": "Thank you for fitting us in, you know, doctor. Doctor, it's being very thirsty. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.96,
      "end_seconds": 27.4,
      "duration_seconds": 3.44,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.12,
      "end_seconds": 41.1,
      "duration_seconds": 2.98,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.17,
      "end_seconds": 67.3,
      "duration_seconds": 13.13,
      "text": "Okay: pulse 114, height 152 centimetres, BMI works out to 35.5. And saturation 97 percent, weight 82 kilos, temp 36.5 degrees, blood pressure 120 over 78."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.21,
      "end_seconds": 69.91,
      "duration_seconds": 1.7,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.54,
      "end_seconds": 74.92,
      "duration_seconds": 3.38,
      "text": "okay, that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.22,
      "end_seconds": 78.55,
      "duration_seconds": 3.33,
      "text": "Ah. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.3,
      "end_seconds": 96.82,
      "duration_seconds": 16.52,
      "text": "Sorry, what was I saying, a four out of ten, I suppose. I've also been passing a lot of urine, for ten days. Oh, and tummy pain. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.17,
      "end_seconds": 101.69,
      "duration_seconds": 3.52,
      "text": "A few quick ones: cough or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.62,
      "end_seconds": 106.69,
      "duration_seconds": 4.07,
      "text": "uh, no, no cough or chest pain"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.53,
      "end_seconds": 113.28,
      "duration_seconds": 2.75,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.59,
      "end_seconds": 117.44,
      "duration_seconds": 2.85,
      "text": "Okay, so I move fine otherwise."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.26,
      "end_seconds": 122.51,
      "duration_seconds": 3.25,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.29,
      "end_seconds": 130.22,
      "duration_seconds": 5.93,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.3,
      "end_seconds": 134.78,
      "duration_seconds": 2.48,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 135.39,
      "end_seconds": 145.68,
      "duration_seconds": 10.29,
      "text": "Hmm, she is on Glycomet, 500 milligrams, twice a day for my sugar, I give it to to her."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.86,
      "end_seconds": 152.25,
      "duration_seconds": 5.39,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.89,
      "end_seconds": 157.18,
      "duration_seconds": 3.29,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.66,
      "end_seconds": 173.15,
      "duration_seconds": 2.49,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.38,
      "end_seconds": 178.19,
      "duration_seconds": 3.81,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.92,
      "end_seconds": 182.92,
      "duration_seconds": 3.0,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.71,
      "end_seconds": 196.67,
      "duration_seconds": 12.96,
      "text": "Nothing, I'm teetotal. I've never touched a cigarette. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.89,
      "end_seconds": 211.34,
      "duration_seconds": 2.45,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.01,
      "end_seconds": 221.64,
      "duration_seconds": 9.63,
      "text": "I have diabetes, for five years. Work has been very busy so so I kept ignoring it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.44,
      "end_seconds": 230.58,
      "duration_seconds": 4.14,
      "text": "Ah. Alright, diabetes, that that matches what I have here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.28,
      "end_seconds": 234.35,
      "duration_seconds": 2.07,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.97,
      "end_seconds": 236.5,
      "duration_seconds": 1.53,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.42,
      "end_seconds": 239.59,
      "duration_seconds": 1.17,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.97,
      "end_seconds": 260.73,
      "duration_seconds": 4.76,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.44,
      "end_seconds": 279.4,
      "duration_seconds": 12.96,
      "text": "all finished, thank you. Let me tell you where I've got to. I can't pin this down yet. We're looking at diabetic ketoacidosis or a a severe infection"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.89,
      "end_seconds": 283.82,
      "duration_seconds": 2.93,
      "text": "Is this serious, um, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.23,
      "end_seconds": 295.48,
      "duration_seconds": 10.25,
      "text": "I understand the worry. At the moment I'd say it's diabetic ketoacidosis, and we'll know more once the blood gas and electrolytes is back."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.35,
      "end_seconds": 312.68,
      "duration_seconds": 5.33,
      "text": "I'm sending you for blood gas and electrolytes cos of DKA"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.51,
      "end_seconds": 314.58,
      "duration_seconds": 1.07,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.25,
      "end_seconds": 323.05,
      "duration_seconds": 6.8,
      "text": "I'm sending you for a blood sugar and ketone test because of thirst and vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.12,
      "end_seconds": 325.27,
      "duration_seconds": 1.15,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.95,
      "end_seconds": 333.27,
      "duration_seconds": 7.32,
      "text": "You need to go to hospital now for insulin and fluids. Come back straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.95,
      "end_seconds": 337.72,
      "duration_seconds": 3.77,
      "text": "I'll note it it in my calendar"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.76,
      "end_seconds": 341.95,
      "duration_seconds": 3.19,
      "text": "right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.23,
      "end_seconds": 346.68,
      "duration_seconds": 3.45,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.91,
      "end_seconds": 349.27,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    }
  ]
}