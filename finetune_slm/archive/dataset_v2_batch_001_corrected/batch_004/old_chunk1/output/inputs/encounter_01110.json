{
  "schema_version": "1.0",
  "encounter_id": "01110",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 6.78,
      "duration_seconds": 5.92,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.31,
      "end_seconds": 12.3,
      "duration_seconds": 3.99,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.23,
      "end_seconds": 20.18,
      "duration_seconds": 6.95,
      "text": "Mainly vomiting blood. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.64,
      "end_seconds": 27.77,
      "duration_seconds": 3.13,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.54,
      "end_seconds": 30.78,
      "duration_seconds": 2.24,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.83,
      "end_seconds": 34.44,
      "duration_seconds": 2.61,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.18,
      "end_seconds": 45.47,
      "duration_seconds": 10.29,
      "text": "Honestly, a few times a day. I've had stomach pain too, for two weeks. I've also been feeling faint, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.2,
      "end_seconds": 48.74,
      "duration_seconds": 2.54,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.36,
      "end_seconds": 52.86,
      "duration_seconds": 3.5,
      "text": "Um, lying down helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.24,
      "end_seconds": 56.6,
      "duration_seconds": 2.36,
      "text": "Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.51,
      "end_seconds": 62.22,
      "duration_seconds": 3.71,
      "text": "Uh, no, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.78,
      "end_seconds": 65.19,
      "duration_seconds": 2.41,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 67.39,
      "duration_seconds": 0.9,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.37,
      "end_seconds": 72.59,
      "duration_seconds": 3.22,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.25,
      "end_seconds": 79.02,
      "duration_seconds": 5.77,
      "text": "I mean, yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.55,
      "end_seconds": 95.0,
      "duration_seconds": 2.45,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.95,
      "end_seconds": 111.55,
      "duration_seconds": 15.6,
      "text": "I have epilepsy, for nearly five years. Yes, an underactive thyroid. I've been putting this off for weeks. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.17,
      "end_seconds": 122.37,
      "duration_seconds": 10.2,
      "text": "I follow. Right, yes, an underactive thyroid is known to us, good to have that clear. Right, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.11,
      "end_seconds": 125.35,
      "duration_seconds": 2.24,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.0,
      "end_seconds": 128.61,
      "duration_seconds": 1.61,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.94,
      "end_seconds": 132.74,
      "duration_seconds": 2.8,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.66,
      "end_seconds": 135.89,
      "duration_seconds": 1.23,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.23,
      "end_seconds": 140.85,
      "duration_seconds": 3.62,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.17,
      "end_seconds": 144.73,
      "duration_seconds": 2.56,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.41,
      "end_seconds": 148.87,
      "duration_seconds": 3.46,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 152.59,
      "duration_seconds": 1.67,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.47,
      "end_seconds": 159.67,
      "duration_seconds": 3.2,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 165.69,
      "duration_seconds": 4.78,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.55,
      "end_seconds": 175.28,
      "duration_seconds": 7.73,
      "text": "I had a reaction to tramadol when I was younger, vomiting, and I've avoided it since."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.18,
      "end_seconds": 194.39,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.17,
      "end_seconds": 198.2,
      "duration_seconds": 3.03,
      "text": "Carbamazepine, 200 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.11,
      "end_seconds": 202.46,
      "duration_seconds": 3.35,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.53,
      "end_seconds": 205.37,
      "duration_seconds": 1.84,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.9,
      "end_seconds": 207.19,
      "duration_seconds": 1.29,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.74,
      "end_seconds": 216.48,
      "duration_seconds": 7.74,
      "text": "I'm on thyroxine, 75 micrograms, every morning. I take ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.67,
      "end_seconds": 220.94,
      "duration_seconds": 3.27,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.49,
      "end_seconds": 223.19,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.06,
      "end_seconds": 226.09,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.24,
      "end_seconds": 250.34,
      "duration_seconds": 6.1,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.0,
      "end_seconds": 251.9,
      "duration_seconds": 0.9,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.74,
      "end_seconds": 273.63,
      "duration_seconds": 16.89,
      "text": "You can sit up now. From what you've told me and what I found, my working impression is a possible bleeding stomach ulcer. It could also be a bleed from the gullet, so we'll keep that open."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.55,
      "end_seconds": 277.26,
      "duration_seconds": 2.71,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.97,
      "end_seconds": 286.96,
      "duration_seconds": 7.99,
      "text": "I can't promise yet, but most people with a possible bleeding stomach ulcer do well once it's treated properly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.6,
      "end_seconds": 324.49,
      "duration_seconds": 29.89,
      "text": "I want urgent blood tests done, that's for bleeding. I want an endoscopy done, that's for bleeding. Please stop the ibuprofen and do not eat or drink. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Please come and see me straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.06,
      "end_seconds": 330.01,
      "duration_seconds": 4.95,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.62,
      "end_seconds": 335.24,
      "duration_seconds": 4.62,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.29,
      "end_seconds": 339.84,
      "duration_seconds": 3.55,
      "text": "Right, no, that's all. Thanks a lot."
    }
  ]
}