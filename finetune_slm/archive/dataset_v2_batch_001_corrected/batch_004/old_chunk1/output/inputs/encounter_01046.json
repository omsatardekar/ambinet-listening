{
  "schema_version": "1.0",
  "encounter_id": "01046",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.09,
      "duration_seconds": 3.0,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.61,
      "end_seconds": 8.36,
      "duration_seconds": 3.75,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.31,
      "end_seconds": 13.66,
      "duration_seconds": 3.35,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.36,
      "end_seconds": 16.95,
      "duration_seconds": 2.59,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.56,
      "end_seconds": 21.37,
      "duration_seconds": 3.81,
      "text": "He's been having severe lower back pain, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.51,
      "end_seconds": 26.44,
      "duration_seconds": 3.93,
      "text": "So, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.72,
      "end_seconds": 32.21,
      "duration_seconds": 4.49,
      "text": "It's hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 33.97,
      "end_seconds": 41.36,
      "duration_seconds": 7.39,
      "text": "It's meant to be when needed, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.92,
      "end_seconds": 49.21,
      "duration_seconds": 5.29,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.88,
      "end_seconds": 55.65,
      "duration_seconds": 4.77,
      "text": "I'd say every other day. I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.46,
      "end_seconds": 62.91,
      "duration_seconds": 6.45,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.01,
      "end_seconds": 67.83,
      "duration_seconds": 4.82,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.35,
      "end_seconds": 75.88,
      "duration_seconds": 2.53,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.78,
      "end_seconds": 85.48,
      "duration_seconds": 7.7,
      "text": "That's fine, one at a time. I'll ask about everything. Any numbness between your legs as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.08,
      "end_seconds": 96.74,
      "duration_seconds": 9.66,
      "text": "Yeah. Four weeks, I'd say. I did have trouble passing urine at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 97.85,
      "end_seconds": 100.17,
      "duration_seconds": 2.32,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.14,
      "end_seconds": 106.69,
      "duration_seconds": 4.55,
      "text": "Let me check a few things. Any recent fall or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.74,
      "end_seconds": 112.15,
      "duration_seconds": 3.41,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.51,
      "end_seconds": 115.54,
      "duration_seconds": 2.03,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.71,
      "end_seconds": 117.63,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.18,
      "end_seconds": 122.41,
      "duration_seconds": 3.23,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.33,
      "end_seconds": 125.36,
      "duration_seconds": 2.03,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.87,
      "end_seconds": 129.28,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.29,
      "end_seconds": 136.02,
      "duration_seconds": 4.73,
      "text": "My father has Parkinson's disease. My son has asthma."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.07,
      "end_seconds": 141.85,
      "duration_seconds": 4.78,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.92,
      "end_seconds": 145.55,
      "duration_seconds": 1.63,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.1,
      "end_seconds": 155.35,
      "duration_seconds": 9.25,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.57,
      "end_seconds": 170.12,
      "duration_seconds": 13.55,
      "text": "I used to drink heavily but I stopped four years ago. I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.13,
      "end_seconds": 175.43,
      "duration_seconds": 4.3,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.58,
      "end_seconds": 179.67,
      "duration_seconds": 3.09,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.18,
      "end_seconds": 192.68,
      "duration_seconds": 3.5,
      "text": "Okay, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.82,
      "end_seconds": 198.24,
      "duration_seconds": 4.42,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.02,
      "end_seconds": 212.3,
      "duration_seconds": 3.28,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.28,
      "end_seconds": 227.54,
      "duration_seconds": 2.26,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.41,
      "end_seconds": 263.27,
      "duration_seconds": 20.86,
      "text": "Okay: respiratory rate 15, blood pressure 124 over 82, pulse 77. And temperature is 36.6 degrees. So, based on your history, the most likely explanation is possible cauda equina syndrome needing an urgent scan. I can't rule out a large disc prolapse yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.31,
      "end_seconds": 270.57,
      "duration_seconds": 2.26,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.58,
      "end_seconds": 303.28,
      "duration_seconds": 31.7,
      "text": "It's reasonable to be concerned, but right now possible cauda equina syndrome needing an urgent scan is my leading thought, not anything worse. I'd like to arrange an urgent MRI of the spine for possible cauda equina. I'd rather check than guess, and this is the quickest way to know more. You need to go to hospital now for an emergency scan. Book a review straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.01,
      "end_seconds": 306.71,
      "duration_seconds": 2.7,
      "text": "I think I understand everything. Thanks."
    }
  ]
}