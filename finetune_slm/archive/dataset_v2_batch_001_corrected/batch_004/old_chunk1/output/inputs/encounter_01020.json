{
  "schema_version": "1.0",
  "encounter_id": "01020",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 3.63,
      "duration_seconds": 2.32,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.64,
      "end_seconds": 5.74,
      "duration_seconds": 1.1,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.75,
      "end_seconds": 14.72,
      "duration_seconds": 6.97,
      "text": "Hello, uh, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.86,
      "end_seconds": 21.59,
      "duration_seconds": 5.73,
      "text": "So, yes, that's no problem at all. Please sit. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.6,
      "end_seconds": 29.46,
      "duration_seconds": 5.86,
      "text": "Doctor, you know, it's black tarry stools. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.96,
      "end_seconds": 31.39,
      "duration_seconds": 1.43,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.36,
      "end_seconds": 34.68,
      "duration_seconds": 2.32,
      "text": "About... well, three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.87,
      "end_seconds": 40.04,
      "duration_seconds": 4.17,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.62,
      "end_seconds": 42.79,
      "duration_seconds": 1.17,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.77,
      "end_seconds": 46.44,
      "duration_seconds": 2.67,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.98,
      "end_seconds": 58.7,
      "duration_seconds": 10.72,
      "text": "Stomach pain goes along with it, most of the time. About Stomach pain, I'd say all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.39,
      "end_seconds": 64.21,
      "duration_seconds": 3.82,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.75,
      "end_seconds": 71.54,
      "duration_seconds": 6.79,
      "text": "actually, you know, I haven't had fever or chest pain, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.99,
      "end_seconds": 75.43,
      "duration_seconds": 2.44,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.1,
      "end_seconds": 79.07,
      "duration_seconds": 2.97,
      "text": "Ah, no problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.59,
      "end_seconds": 93.9,
      "duration_seconds": 3.31,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.56,
      "end_seconds": 103.07,
      "duration_seconds": 7.51,
      "text": "erm, uh, just a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.07,
      "end_seconds": 110.12,
      "duration_seconds": 5.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.2,
      "end_seconds": 119.6,
      "duration_seconds": 7.4,
      "text": "Not currently, you know, but as a youngster naproxen gave me a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.4,
      "end_seconds": 125.32,
      "duration_seconds": 4.92,
      "text": "Are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 126.18,
      "end_seconds": 129.04,
      "duration_seconds": 2.86,
      "text": "He takes simvastatin, at night."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.08,
      "end_seconds": 133.84,
      "duration_seconds": 2.76,
      "text": "Okay, do you know the dose?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 135.74,
      "end_seconds": 140.92,
      "duration_seconds": 5.18,
      "text": "20 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.69,
      "end_seconds": 146.08,
      "duration_seconds": 3.39,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.45,
      "end_seconds": 151.98,
      "duration_seconds": 4.53,
      "text": "Right, I have high cholesterol, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.02,
      "end_seconds": 158.86,
      "duration_seconds": 5.84,
      "text": "Yes, high cholesterol is known to us, good to have that that clear."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.35,
      "end_seconds": 170.27,
      "duration_seconds": 3.92,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.36,
      "end_seconds": 189.55,
      "duration_seconds": 18.19,
      "text": "I gave up cigarettes last spring. Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts. My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.17,
      "end_seconds": 193.63,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.14,
      "end_seconds": 206.49,
      "duration_seconds": 2.35,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.27,
      "end_seconds": 230.08,
      "duration_seconds": 6.81,
      "text": "okay: blood pressure 118 over 75, pulse is 109 beats a minute, temperature 37.1."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.38,
      "end_seconds": 236.41,
      "duration_seconds": 4.03,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.11,
      "end_seconds": 244.81,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.01,
      "end_seconds": 247.93,
      "duration_seconds": 1.92,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.48,
      "end_seconds": 264.79,
      "duration_seconds": 7.31,
      "text": "you look pale, your pulse is fast and your tummy is tender at the top"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.16,
      "end_seconds": 283.99,
      "duration_seconds": 15.83,
      "text": "Right, you can relax now. Putting it all together, I think we're dealing with a possible bleeding stomach ulcer at this stage. A bleed from the gullet is also on my list."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.56,
      "end_seconds": 287.59,
      "duration_seconds": 3.03,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.1,
      "end_seconds": 319.11,
      "duration_seconds": 28.01,
      "text": "I can't promise yet, but most people with a possible bleeding stomach ulcer do well once it's treated properly. Let's get an endoscopy, for bleeding. Urgent blood tests is what I'd like next, for bleeding. Please stop the ibuprofen and do not eat or drink. Book a review straight away. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.29,
      "end_seconds": 323.77,
      "duration_seconds": 3.48,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}