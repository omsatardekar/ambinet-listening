{
  "schema_version": "1.0",
  "encounter_id": "01342",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.75,
      "end_seconds": 3.04,
      "duration_seconds": 2.29,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.63,
      "end_seconds": 11.28,
      "duration_seconds": 6.65,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.9,
      "end_seconds": 16.72,
      "duration_seconds": 3.82,
      "text": "Absolutely, come and sit beside them. What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.64,
      "end_seconds": 22.13,
      "duration_seconds": 3.49,
      "text": "she's been having bloating after meals, doctor"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.38,
      "end_seconds": 26.46,
      "duration_seconds": 3.08,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.49,
      "end_seconds": 31.42,
      "duration_seconds": 2.93,
      "text": "Around three days, I think."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 32.09,
      "end_seconds": 36.3,
      "duration_seconds": 4.21,
      "text": "so, hm, I'd say more like five days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.95,
      "end_seconds": 42.96,
      "duration_seconds": 5.01,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.61,
      "end_seconds": 48.34,
      "duration_seconds": 3.73,
      "text": "Yeah, uh, that sounds about right."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.3,
      "end_seconds": 53.16,
      "duration_seconds": 2.86,
      "text": "Right, have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.43,
      "end_seconds": 59.43,
      "duration_seconds": 5.0,
      "text": "Yes, um, large meals. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.66,
      "end_seconds": 64.12,
      "duration_seconds": 3.46,
      "text": "Any loose stools now and then as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.07,
      "end_seconds": 67.34,
      "duration_seconds": 1.27,
      "text": "mm, yes"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.65,
      "end_seconds": 74.37,
      "duration_seconds": 5.72,
      "text": "Okay, have you had bloating after meals before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.17,
      "end_seconds": 81.22,
      "duration_seconds": 6.05,
      "text": "I had a similar thing last winter it went away"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 82.52,
      "end_seconds": 84.66,
      "duration_seconds": 2.14,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_6",
      "role": "NURSE",
      "start_seconds": 86.04,
      "end_seconds": 94.92,
      "duration_seconds": 8.88,
      "text": "here are the numbers, doctor temperature 36.9, saturation 98 percent, BP is 128 over 69, heart rate 70."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.64,
      "end_seconds": 98.15,
      "duration_seconds": 1.51,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.22,
      "end_seconds": 104.01,
      "duration_seconds": 4.79,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.0,
      "end_seconds": 107.23,
      "duration_seconds": 1.23,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.32,
      "end_seconds": 129.3,
      "duration_seconds": 5.98,
      "text": "your tummy is soft and not tender, and I can't feel any lumps"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.68,
      "end_seconds": 136.27,
      "duration_seconds": 1.59,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.8,
      "end_seconds": 147.53,
      "duration_seconds": 2.73,
      "text": "And what about night-time diarrhoea or vomiting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.2,
      "end_seconds": 160.99,
      "duration_seconds": 11.79,
      "text": "No, no night-time diarrhoea, no vomiting. I did have a lot of wind at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.72,
      "end_seconds": 165.55,
      "duration_seconds": 3.83,
      "text": "Any weight loss or blood in the stool?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.81,
      "end_seconds": 175.55,
      "duration_seconds": 6.74,
      "text": "I haven't had weight loss or blood in the stool, no"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.1,
      "end_seconds": 179.47,
      "duration_seconds": 3.37,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 180.42,
      "end_seconds": 182.12,
      "duration_seconds": 1.7,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.76,
      "end_seconds": 190.19,
      "duration_seconds": 4.43,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.17,
      "end_seconds": 195.12,
      "duration_seconds": 2.95,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.04,
      "end_seconds": 198.26,
      "duration_seconds": 2.22,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.73,
      "end_seconds": 203.99,
      "duration_seconds": 4.26,
      "text": "Oh, it's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.53,
      "end_seconds": 205.23,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.89,
      "end_seconds": 212.39,
      "duration_seconds": 5.5,
      "text": "Paracetamol, 650 milligrams, when needed for the knee pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.06,
      "end_seconds": 224.73,
      "duration_seconds": 10.67,
      "text": "um, um, it's a... um, I can't remember what it's called. It's a small white one"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.71,
      "end_seconds": 228.06,
      "duration_seconds": 2.35,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 229.78,
      "end_seconds": 244.1,
      "duration_seconds": 14.32,
      "text": "Well, for my cholesterol, I believe. My wife sets them out for me, I just take what I'm given. Peppermint capsules, after meals."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.64,
      "end_seconds": 246.8,
      "duration_seconds": 2.16,
      "text": "hm, okay how about smoking?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.88,
      "end_seconds": 251.83,
      "duration_seconds": 2.95,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.64,
      "end_seconds": 255.94,
      "duration_seconds": 2.3,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.61,
      "end_seconds": 259.13,
      "duration_seconds": 2.52,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.82,
      "end_seconds": 262.35,
      "duration_seconds": 2.53,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 262.93,
      "end_seconds": 266.69,
      "duration_seconds": 3.76,
      "text": "I'm allergic to amoxicillin, I get hives."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.77,
      "end_seconds": 272.95,
      "duration_seconds": 4.18,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 274.4,
      "end_seconds": 281.16,
      "duration_seconds": 6.76,
      "text": "Anxiety, for about a year i have arthritis in my knees"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.37,
      "end_seconds": 283.55,
      "duration_seconds": 1.18,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 284.61,
      "end_seconds": 288.77,
      "duration_seconds": 4.16,
      "text": "I have high cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.4,
      "end_seconds": 316.7,
      "duration_seconds": 26.3,
      "text": "Okay, I can see high cholesterol in your file as well. So where does that leave us? I think we're dealing with a functional bowel pattern, with no alarm features at this stage. The reason I say that is that your story and my examination fit together. Another possibility is irritable bowel syndrome."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.83,
      "end_seconds": 344.82,
      "duration_seconds": 14.99,
      "text": "We should do a coeliac blood test for bloating. That will help us see what's going on underneath and decide the next step. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.55,
      "end_seconds": 349.01,
      "duration_seconds": 3.46,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}