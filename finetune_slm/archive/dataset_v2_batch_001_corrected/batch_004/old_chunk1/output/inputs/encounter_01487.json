{
  "schema_version": "1.0",
  "encounter_id": "01487",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 5.65,
      "duration_seconds": 5.11,
      "text": "Right, thanks for waiting, come in. Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.56,
      "end_seconds": 11.55,
      "duration_seconds": 4.99,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.06,
      "end_seconds": 15.31,
      "duration_seconds": 2.25,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.18,
      "end_seconds": 24.69,
      "duration_seconds": 8.51,
      "text": "Well, I've been having skipped beats. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.63,
      "end_seconds": 29.98,
      "duration_seconds": 3.35,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.07,
      "end_seconds": 35.18,
      "duration_seconds": 2.11,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.85,
      "end_seconds": 37.88,
      "duration_seconds": 2.03,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.72,
      "end_seconds": 52.41,
      "duration_seconds": 12.69,
      "text": "It's worse with lying down and caffeine. I mean, I did have a flutter in my chest at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.32,
      "end_seconds": 68.11,
      "duration_seconds": 5.79,
      "text": "a few quick ones: shortness of breath, dizziness, chest pain or fainting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.92,
      "end_seconds": 77.15,
      "duration_seconds": 7.23,
      "text": "Mm, no shortness of breath, dizziness, chest pain or fainting, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.93,
      "end_seconds": 80.98,
      "duration_seconds": 3.05,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.4,
      "end_seconds": 84.34,
      "duration_seconds": 1.94,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.49,
      "end_seconds": 88.43,
      "duration_seconds": 2.94,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.3,
      "end_seconds": 93.89,
      "duration_seconds": 3.59,
      "text": "I've had anxiety for five years now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.59,
      "end_seconds": 100.38,
      "duration_seconds": 4.79,
      "text": "Mm-hmm. Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.22,
      "end_seconds": 120.87,
      "duration_seconds": 3.65,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.02,
      "end_seconds": 126.87,
      "duration_seconds": 4.85,
      "text": "No, um, not that I know of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.07,
      "end_seconds": 130.84,
      "duration_seconds": 2.77,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.36,
      "end_seconds": 138.84,
      "duration_seconds": 7.48,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 153.86,
      "duration_seconds": 2.94,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.75,
      "end_seconds": 160.83,
      "duration_seconds": 6.08,
      "text": "It's, It's escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.93,
      "end_seconds": 163.21,
      "duration_seconds": 1.28,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.54,
      "end_seconds": 167.47,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.31,
      "end_seconds": 170.06,
      "duration_seconds": 1.75,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.65,
      "end_seconds": 174.61,
      "duration_seconds": 2.96,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.82,
      "end_seconds": 178.56,
      "duration_seconds": 2.74,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.7,
      "end_seconds": 190.6,
      "duration_seconds": 2.9,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.9,
      "end_seconds": 220.76,
      "duration_seconds": 14.86,
      "text": "Okay: pressure 113 over 74, SpO2 98 percent on room air, temperature is 36.9 degrees, weight 82 kilos, height 163 centimetres, BMI works out to 30.9, pulse 86."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.94,
      "end_seconds": 228.11,
      "duration_seconds": 5.17,
      "text": "I'd like to to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.19,
      "end_seconds": 232.63,
      "duration_seconds": 3.44,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.79,
      "end_seconds": 247.82,
      "duration_seconds": 4.03,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.83,
      "end_seconds": 266.06,
      "duration_seconds": 14.23,
      "text": "Okay, that's enough for me. So where does that leave us? My working impression is harmless extra heartbeats. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.4,
      "end_seconds": 269.17,
      "duration_seconds": 1.77,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.11,
      "end_seconds": 302.31,
      "duration_seconds": 32.2,
      "text": "I can't promise yet, but most people with harmless extra heartbeats do well once it's treated properly. I want an ECG done, that's for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens. Keep an eye out, and if you faint or have chest pain, call us the same day or go to emergency. Let's review you if it carries on after a month."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.56,
      "end_seconds": 309.1,
      "duration_seconds": 5.54,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.12,
      "end_seconds": 316.27,
      "duration_seconds": 5.15,
      "text": "Okay, you know, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.03,
      "end_seconds": 320.25,
      "duration_seconds": 2.22,
      "text": "Have a a good day."
    }
  ]
}