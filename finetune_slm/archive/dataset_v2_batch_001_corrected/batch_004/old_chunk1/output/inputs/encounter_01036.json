{
  "schema_version": "1.0",
  "encounter_id": "01036",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.48,
      "duration_seconds": 4.09,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.28,
      "end_seconds": 10.79,
      "duration_seconds": 4.51,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.55,
      "end_seconds": 16.84,
      "duration_seconds": 4.29,
      "text": "Thank you for fitting us in, you know, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.48,
      "end_seconds": 23.19,
      "duration_seconds": 4.71,
      "text": "well, I've been having burning when I pass urine"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.17,
      "end_seconds": 27.92,
      "duration_seconds": 2.75,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.39,
      "end_seconds": 39.02,
      "duration_seconds": 9.63,
      "text": "It's been two months now. I've never really been one for hospitals. I just wanna get back to normal, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.32,
      "end_seconds": 41.9,
      "duration_seconds": 2.58,
      "text": "Ah. Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.43,
      "end_seconds": 57.06,
      "duration_seconds": 14.63,
      "text": "when it starts I tend to get a dull ache low in my tummy as well. As for dull ache low in my tummy, about a five out of ten"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.57,
      "end_seconds": 61.92,
      "duration_seconds": 3.35,
      "text": "have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.27,
      "end_seconds": 64.78,
      "duration_seconds": 1.51,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.56,
      "end_seconds": 83.63,
      "duration_seconds": 2.07,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.76,
      "end_seconds": 99.24,
      "duration_seconds": 3.48,
      "text": "That's it, just a a little longer..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.07,
      "end_seconds": 117.66,
      "duration_seconds": 8.59,
      "text": "Okay: blood pressure 110 over 69, pulse is 73 beats a minute, saturation 97 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.73,
      "end_seconds": 121.09,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.82,
      "end_seconds": 125.77,
      "duration_seconds": 2.95,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.79,
      "end_seconds": 130.52,
      "duration_seconds": 2.73,
      "text": "let's move on to to the examination"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.42,
      "end_seconds": 132.85,
      "duration_seconds": 1.43,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.88,
      "end_seconds": 153.04,
      "duration_seconds": 5.16,
      "text": "your tummy is soft with slight tenderness just above the pubic bone"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.41,
      "end_seconds": 159.29,
      "duration_seconds": 2.88,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.46,
      "end_seconds": 178.14,
      "duration_seconds": 7.68,
      "text": "alright, have you had any vaginal discharge, blood in the urine, fever or back pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.71,
      "end_seconds": 185.55,
      "duration_seconds": 6.84,
      "text": "no vaginal discharge, blood in the urine, fever or back pain, none of it"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.31,
      "end_seconds": 188.34,
      "duration_seconds": 2.03,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.89,
      "end_seconds": 192.67,
      "duration_seconds": 2.78,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.58,
      "end_seconds": 197.44,
      "duration_seconds": 2.86,
      "text": "Right, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.88,
      "end_seconds": 203.32,
      "duration_seconds": 4.44,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.9,
      "end_seconds": 220.29,
      "duration_seconds": 2.39,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.18,
      "end_seconds": 227.47,
      "duration_seconds": 3.29,
      "text": "I take Asthalin inhaler, when needed"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.2,
      "end_seconds": 231.08,
      "duration_seconds": 2.88,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.02,
      "end_seconds": 243.12,
      "duration_seconds": 11.1,
      "text": "My husband and I live above the shop. I'm a plumber, lots of bending and kneeling. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.42,
      "end_seconds": 246.83,
      "duration_seconds": 2.41,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.81,
      "end_seconds": 254.01,
      "duration_seconds": 4.2,
      "text": "I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.55,
      "end_seconds": 262.78,
      "duration_seconds": 4.23,
      "text": "Ah. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.62,
      "end_seconds": 265.12,
      "duration_seconds": 1.5,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.68,
      "end_seconds": 275.4,
      "duration_seconds": 9.72,
      "text": "Let me tell you where I've got to. I'd lean towards an uncomplicated urinary infection. Another possibility is vaginal irritation."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.29,
      "end_seconds": 281.28,
      "duration_seconds": 1.99,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.05,
      "end_seconds": 307.59,
      "duration_seconds": 25.54,
      "text": "I can't promise yet, but most people with an uncomplicated urinary infection do well once it's treated properly. I want a urine dipstick done, that's for burning urine. I'm prescribing nitrofurantoin, 100 milligrams, twice a day, three days. That's for urinary infection. I'll put all of this in writing so you don't have to remember it. Drink plenty of water and avoid holding urine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.97,
      "end_seconds": 322.4,
      "duration_seconds": 9.43,
      "text": "Keep an eye out, and if you get a fever or back pain, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.7,
      "end_seconds": 326.68,
      "duration_seconds": 2.98,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.25,
      "end_seconds": 334.83,
      "duration_seconds": 7.58,
      "text": "We'll catch up if it is not better in three days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.7,
      "end_seconds": 342.71,
      "duration_seconds": 3.01,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.68,
      "end_seconds": 346.28,
      "duration_seconds": 1.6,
      "text": "Have a good day."
    }
  ]
}