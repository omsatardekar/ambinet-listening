{
  "schema_version": "1.0",
  "encounter_id": "01435",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 5.72,
      "duration_seconds": 4.6,
      "text": "Right, thanks for waiting, come in. Was parking alright?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.28,
      "end_seconds": 14.22,
      "duration_seconds": 6.94,
      "text": "Sorry, what was I saying, not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.98,
      "end_seconds": 16.93,
      "duration_seconds": 1.95,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.32,
      "end_seconds": 22.72,
      "duration_seconds": 4.4,
      "text": "I wanted to get bloating after meals looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.56,
      "end_seconds": 25.58,
      "duration_seconds": 2.02,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.31,
      "end_seconds": 33.37,
      "duration_seconds": 7.06,
      "text": "About... well, about two weeks. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.09,
      "end_seconds": 38.39,
      "duration_seconds": 3.3,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.15,
      "end_seconds": 40.76,
      "duration_seconds": 1.61,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.6,
      "end_seconds": 47.08,
      "duration_seconds": 5.48,
      "text": "Let me check a few things. Any blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.71,
      "end_seconds": 50.14,
      "duration_seconds": 2.43,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.19,
      "end_seconds": 54.64,
      "duration_seconds": 3.45,
      "text": "A few quick ones: night-time diarrhoea or vomiting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.58,
      "end_seconds": 59.51,
      "duration_seconds": 3.93,
      "text": "Oh, no, no night-time diarrhoea or vomiting."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.69,
      "end_seconds": 63.17,
      "duration_seconds": 2.48,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.78,
      "end_seconds": 65.8,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.39,
      "end_seconds": 69.53,
      "duration_seconds": 3.14,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.48,
      "end_seconds": 73.88,
      "duration_seconds": 1.4,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.66,
      "end_seconds": 78.63,
      "duration_seconds": 2.97,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.0,
      "end_seconds": 83.47,
      "duration_seconds": 3.47,
      "text": "I'm allergic to diclofenac, I get wheezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.2,
      "end_seconds": 86.78,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.24,
      "end_seconds": 91.06,
      "duration_seconds": 2.82,
      "text": "I have anxiety, for two years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.02,
      "end_seconds": 102.09,
      "duration_seconds": 9.07,
      "text": "Ah. Okay, I can see anxiety in your file as well. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.09,
      "end_seconds": 109.02,
      "duration_seconds": 2.93,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.81,
      "end_seconds": 128.1,
      "duration_seconds": 2.29,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.84,
      "end_seconds": 135.78,
      "duration_seconds": 6.94,
      "text": "Sorry, what was I saying, it's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.39,
      "end_seconds": 155.57,
      "duration_seconds": 1.18,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 162.05,
      "duration_seconds": 5.06,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.96,
      "end_seconds": 168.28,
      "duration_seconds": 1.32,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.51,
      "end_seconds": 174.04,
      "duration_seconds": 4.53,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.65,
      "end_seconds": 177.02,
      "duration_seconds": 2.37,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.09,
      "end_seconds": 181.97,
      "duration_seconds": 3.88,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.05,
      "end_seconds": 187.41,
      "duration_seconds": 3.36,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.98,
      "end_seconds": 191.32,
      "duration_seconds": 3.34,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.81,
      "end_seconds": 194.36,
      "duration_seconds": 1.55,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.22,
      "end_seconds": 198.65,
      "duration_seconds": 3.43,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.38,
      "end_seconds": 203.08,
      "duration_seconds": 3.7,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.7,
      "end_seconds": 214.75,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.65,
      "end_seconds": 247.46,
      "duration_seconds": 10.81,
      "text": "Okay: height 170 centimetres, SpO2 99 percent on room air, blood pressure 112 over 70, pulse 85, weight 63 kilos, temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.42,
      "end_seconds": 267.05,
      "duration_seconds": 7.63,
      "text": "Going by what you've described, it fits best with a functional bowel pattern, with no alarm features."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.88,
      "end_seconds": 272.33,
      "duration_seconds": 4.45,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.5,
      "end_seconds": 298.87,
      "duration_seconds": 25.37,
      "text": "Nothing I've seen today points to an emergency. It looks like a functional bowel pattern, with no alarm features, but I'd like to confirm. Let's book a coeliac blood test to look into bloating. Try smaller meals and keep a food and symptom diary for four weeks. See me again in six weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.72,
      "end_seconds": 304.87,
      "duration_seconds": 2.15,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.11,
      "end_seconds": 308.86,
      "duration_seconds": 2.75,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.13,
      "end_seconds": 317.33,
      "duration_seconds": 4.2,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.06,
      "end_seconds": 320.5,
      "duration_seconds": 1.44,
      "text": "Look after yourself."
    }
  ]
}