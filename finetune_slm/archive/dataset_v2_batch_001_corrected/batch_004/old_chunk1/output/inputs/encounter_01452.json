{
  "schema_version": "1.0",
  "encounter_id": "01452",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 6.03,
      "duration_seconds": 5.33,
      "text": "Ah, you know, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.32,
      "end_seconds": 12.35,
      "duration_seconds": 5.03,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.21,
      "end_seconds": 19.95,
      "duration_seconds": 5.74,
      "text": "Right, I wanted to get a blocked ear looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.7,
      "end_seconds": 23.37,
      "duration_seconds": 1.67,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.0,
      "end_seconds": 28.46,
      "duration_seconds": 4.46,
      "text": "Oh, it's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.73,
      "end_seconds": 29.68,
      "duration_seconds": 0.95,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.16,
      "end_seconds": 37.72,
      "duration_seconds": 6.56,
      "text": "And muffled hearing on one side as well, uh, since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.69,
      "end_seconds": 42.18,
      "duration_seconds": 2.49,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.61,
      "end_seconds": 56.84,
      "duration_seconds": 2.23,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.63,
      "end_seconds": 78.4,
      "duration_seconds": 6.77,
      "text": "Okay: heart rate 65, temp 36.8 degrees, blood pressure 121 over 71, respiratory rate 17."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.19,
      "end_seconds": 81.74,
      "duration_seconds": 1.55,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.56,
      "end_seconds": 86.34,
      "duration_seconds": 2.78,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.38,
      "end_seconds": 93.83,
      "duration_seconds": 5.45,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.54,
      "end_seconds": 97.62,
      "duration_seconds": 2.08,
      "text": "So, breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.77,
      "end_seconds": 111.64,
      "duration_seconds": 4.87,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.94,
      "end_seconds": 129.85,
      "duration_seconds": 0.91,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.63,
      "end_seconds": 138.11,
      "duration_seconds": 2.48,
      "text": "Alright, that's the examination finished."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.95,
      "end_seconds": 156.45,
      "duration_seconds": 2.5,
      "text": "And discharge, any of that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.85,
      "end_seconds": 161.56,
      "duration_seconds": 1.71,
      "text": "Nope, no discharge."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.07,
      "end_seconds": 166.37,
      "duration_seconds": 3.3,
      "text": "Have you noticed ringing, ear pain or dizziness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.24,
      "end_seconds": 172.31,
      "duration_seconds": 4.07,
      "text": "No, you know, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.3,
      "end_seconds": 175.95,
      "duration_seconds": 2.65,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.98,
      "end_seconds": 181.76,
      "duration_seconds": 3.78,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.67,
      "end_seconds": 184.84,
      "duration_seconds": 2.17,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.42,
      "end_seconds": 188.03,
      "duration_seconds": 1.61,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.98,
      "end_seconds": 210.6,
      "duration_seconds": 3.62,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.79,
      "end_seconds": 216.03,
      "duration_seconds": 4.24,
      "text": "I'm allergic to cat fur, I get sneezing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.8,
      "end_seconds": 222.49,
      "duration_seconds": 4.69,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.13,
      "end_seconds": 225.69,
      "duration_seconds": 1.56,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.27,
      "end_seconds": 231.97,
      "duration_seconds": 2.7,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.5,
      "end_seconds": 234.59,
      "duration_seconds": 1.09,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.12,
      "end_seconds": 238.4,
      "duration_seconds": 2.28,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.17,
      "end_seconds": 243.28,
      "duration_seconds": 4.11,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.4,
      "end_seconds": 248.4,
      "duration_seconds": 4.0,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.3,
      "end_seconds": 254.16,
      "duration_seconds": 3.86,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.1,
      "end_seconds": 258.59,
      "duration_seconds": 2.49,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.34,
      "end_seconds": 267.16,
      "duration_seconds": 3.82,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.32,
      "end_seconds": 281.61,
      "duration_seconds": 5.29,
      "text": "So where does that leave us? I'd lean towards earwax blocking the ear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.47,
      "end_seconds": 284.38,
      "duration_seconds": 1.91,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.34,
      "end_seconds": 304.73,
      "duration_seconds": 18.39,
      "text": "Nothing I've seen today points to an emergency. It looks like earwax blocking the ear, but I'd like to confirm. I'm going to order ear irrigation, for wax. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 306.81,
      "end_seconds": 311.62,
      "duration_seconds": 4.81,
      "text": "We have a slot Monday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.62,
      "end_seconds": 316.37,
      "duration_seconds": 2.75,
      "text": "Monday, that works for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.99,
      "end_seconds": 336.86,
      "duration_seconds": 19.87,
      "text": "Use the olive oil drops for a week and then we'll syringe the ear. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Book a review in one week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.31,
      "end_seconds": 340.8,
      "duration_seconds": 2.49,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.47,
      "end_seconds": 343.65,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}