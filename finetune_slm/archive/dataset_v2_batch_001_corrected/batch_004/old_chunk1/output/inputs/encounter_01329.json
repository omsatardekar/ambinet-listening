{
  "schema_version": "1.0",
  "encounter_id": "01329",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 7.95,
      "duration_seconds": 6.93,
      "text": "Uh, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.82,
      "end_seconds": 14.15,
      "duration_seconds": 4.33,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.68,
      "end_seconds": 32.31,
      "duration_seconds": 13.63,
      "text": "Erm, hello, doctor. I hope it's alright if I stay in for this. Doctor, it's sharp pain when I breathe in. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.79,
      "end_seconds": 39.06,
      "duration_seconds": 5.27,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.8,
      "end_seconds": 55.37,
      "duration_seconds": 10.57,
      "text": "Um, you know, it happens all the time. Yes, deep breaths. That makes it worse. I'd call it severe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.43,
      "end_seconds": 58.94,
      "duration_seconds": 2.51,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.8,
      "end_seconds": 70.0,
      "duration_seconds": 10.2,
      "text": "Sorry, you know, what was I saying, when it starts I tend to get a swollen painful calf as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.51,
      "end_seconds": 77.64,
      "duration_seconds": 7.13,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 77.74,
      "end_seconds": 84.92,
      "duration_seconds": 7.18,
      "text": "I mean, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.23,
      "end_seconds": 95.05,
      "duration_seconds": 8.82,
      "text": "I was getting to that! I've, I've also had sudden shortness of breath, for ten days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.3,
      "end_seconds": 96.0,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.69,
      "end_seconds": 102.13,
      "duration_seconds": 4.44,
      "text": "The swollen painful calf? That's been for three weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.05,
      "end_seconds": 107.3,
      "duration_seconds": 3.25,
      "text": "Any wheeze, fever or chest tightness at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.04,
      "end_seconds": 112.53,
      "duration_seconds": 3.49,
      "text": "No, no wheeze, fever or chest tightness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.4,
      "end_seconds": 118.93,
      "duration_seconds": 2.53,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.84,
      "end_seconds": 123.53,
      "duration_seconds": 2.69,
      "text": "Ah, no, that's all fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.05,
      "end_seconds": 128.71,
      "duration_seconds": 3.66,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.31,
      "end_seconds": 134.2,
      "duration_seconds": 4.89,
      "text": "My cousin has psoriasis. My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.93,
      "end_seconds": 139.02,
      "duration_seconds": 3.09,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.68,
      "end_seconds": 145.22,
      "duration_seconds": 4.54,
      "text": "Migraines, for nearly five years. I have heart failure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.23,
      "end_seconds": 148.14,
      "duration_seconds": 0.91,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.48,
      "end_seconds": 155.27,
      "duration_seconds": 5.79,
      "text": "Mm, I've had arthritis in my knees for five years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.88,
      "end_seconds": 158.73,
      "duration_seconds": 1.85,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.44,
      "end_seconds": 165.35,
      "duration_seconds": 4.91,
      "text": "I've had an underactive thyroid for five years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.91,
      "end_seconds": 171.2,
      "duration_seconds": 5.29,
      "text": "Alright, migraines and heart failure, that matches what I have here."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.21,
      "end_seconds": 182.74,
      "duration_seconds": 2.53,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.51,
      "end_seconds": 188.29,
      "duration_seconds": 4.78,
      "text": "I, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.94,
      "end_seconds": 195.68,
      "duration_seconds": 2.74,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.47,
      "end_seconds": 209.72,
      "duration_seconds": 13.25,
      "text": "I quit smoking around ten years ago. Nothing, I'm teetotal. Not much, I mostly stay in these days. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.71,
      "end_seconds": 214.65,
      "duration_seconds": 3.94,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.74,
      "end_seconds": 221.02,
      "duration_seconds": 4.28,
      "text": "Yes, plasters, it gives me a red itchy rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.06,
      "end_seconds": 225.31,
      "duration_seconds": 2.25,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.38,
      "end_seconds": 237.91,
      "duration_seconds": 11.53,
      "text": "I take propranolol, 40 milligrams, twice a day for the migraine prevention. Furosemide. I take it 40 milligrams, maybe, every morning for the fluid."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.77,
      "end_seconds": 244.58,
      "duration_seconds": 4.81,
      "text": "Okay, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.97,
      "end_seconds": 258.07,
      "duration_seconds": 12.1,
      "text": "Not with me. I'll bring it next time. Paracetamol, 650 milligrams, when needed for the knee pain. It's thyroxine, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.73,
      "end_seconds": 261.18,
      "duration_seconds": 2.45,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.24,
      "end_seconds": 264.28,
      "duration_seconds": 1.04,
      "text": "75 micrograms."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.53,
      "end_seconds": 271.42,
      "duration_seconds": 1.89,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.06,
      "end_seconds": 279.88,
      "duration_seconds": 7.82,
      "text": "About about a year. I'd been on metoprolol, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.23,
      "end_seconds": 284.74,
      "duration_seconds": 3.51,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.62,
      "end_seconds": 295.37,
      "duration_seconds": 2.75,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.57,
      "end_seconds": 316.55,
      "duration_seconds": 7.98,
      "text": "Okay: blood pressure 137 over 77, respiratory rate 26, SpO2 92 percent on room air, heart rate 88."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.95,
      "end_seconds": 323.28,
      "duration_seconds": 4.33,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.36,
      "end_seconds": 326.89,
      "duration_seconds": 1.53,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.76,
      "end_seconds": 330.21,
      "duration_seconds": 2.45,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.53,
      "end_seconds": 347.85,
      "duration_seconds": 6.32,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.62,
      "end_seconds": 354.18,
      "duration_seconds": 2.56,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.45,
      "end_seconds": 400.19,
      "duration_seconds": 29.74,
      "text": "Right, here's what I'm thinking. It points towards a possible blood clot in the lung. Another possibility is a chest infection. I want a D-dimer blood test done, that's for possible clot. Let's get a CT scan of the chest, for breathlessness. You need to go to hospital now for a scan. I'm going to send a referral to the medical team."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.27,
      "end_seconds": 413.23,
      "duration_seconds": 11.96,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back straight away."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.35,
      "end_seconds": 418.18,
      "duration_seconds": 3.83,
      "text": "Let me think, alright, I'll be back."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.3,
      "end_seconds": 422.45,
      "duration_seconds": 3.15,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.77,
      "end_seconds": 429.45,
      "duration_seconds": 3.68,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.54,
      "end_seconds": 432.96,
      "duration_seconds": 1.42,
      "text": "See you soon."
    }
  ]
}