{
  "schema_version": "1.0",
  "encounter_id": "01095",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 8.98,
      "duration_seconds": 7.83,
      "text": "Mm, uh, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.15,
      "end_seconds": 14.39,
      "duration_seconds": 4.24,
      "text": "of course, leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.41,
      "end_seconds": 23.75,
      "duration_seconds": 8.34,
      "text": "Mainly a sore ankle. There's a a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.45,
      "end_seconds": 26.82,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.59,
      "end_seconds": 31.96,
      "duration_seconds": 2.37,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.45,
      "end_seconds": 38.44,
      "duration_seconds": 5.99,
      "text": "I see, go ahead. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.87,
      "end_seconds": 40.87,
      "duration_seconds": 1.0,
      "text": "mostly mild"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.57,
      "end_seconds": 48.03,
      "duration_seconds": 3.46,
      "text": "so, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.6,
      "end_seconds": 51.39,
      "duration_seconds": 2.79,
      "text": "it happens on and off"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.43,
      "end_seconds": 58.75,
      "duration_seconds": 5.32,
      "text": "Did you get crack or pop, numbness or pain in the foot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.77,
      "end_seconds": 69.33,
      "duration_seconds": 9.56,
      "text": "Hmm, um, I haven't had crack or pop, numbness or pain in the foot, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 74.74,
      "duration_seconds": 4.44,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.68,
      "end_seconds": 79.03,
      "duration_seconds": 2.35,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 98.43,
      "duration_seconds": 2.41,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.43,
      "end_seconds": 105.52,
      "duration_seconds": 5.09,
      "text": "just two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.57,
      "end_seconds": 111.55,
      "duration_seconds": 3.98,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.72,
      "end_seconds": 120.85,
      "duration_seconds": 8.13,
      "text": "I'm on clopidogrel, 75 milligrams, once a day. Ibuprofen gel. I take it three times a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.5,
      "end_seconds": 124.83,
      "duration_seconds": 2.33,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 129.92,
      "duration_seconds": 3.95,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.85,
      "end_seconds": 133.45,
      "duration_seconds": 2.6,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.69,
      "end_seconds": 137.89,
      "duration_seconds": 3.2,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.24,
      "end_seconds": 147.25,
      "duration_seconds": 4.01,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.21,
      "end_seconds": 151.45,
      "duration_seconds": 2.24,
      "text": "I have heart disease"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.2,
      "end_seconds": 155.04,
      "duration_seconds": 2.84,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.64,
      "end_seconds": 160.99,
      "duration_seconds": 4.35,
      "text": "Uh, no, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.2,
      "end_seconds": 182.69,
      "duration_seconds": 3.49,
      "text": "Alright, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.68,
      "end_seconds": 195.61,
      "duration_seconds": 2.93,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.81,
      "end_seconds": 220.37,
      "duration_seconds": 8.56,
      "text": "Okay: BP is 111 over 77, respiratory rate 14, heart rate 72, oxygen saturation is 99 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.46,
      "end_seconds": 223.86,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.59,
      "end_seconds": 229.26,
      "duration_seconds": 3.67,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.75,
      "end_seconds": 235.41,
      "duration_seconds": 3.66,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.81,
      "end_seconds": 239.57,
      "duration_seconds": 2.76,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.42,
      "end_seconds": 258.11,
      "duration_seconds": 8.69,
      "text": "there's mild swelling over the outside of the ankle, and and you can put your weight on it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.79,
      "end_seconds": 265.25,
      "duration_seconds": 3.46,
      "text": "Alright, good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.05,
      "end_seconds": 295.36,
      "duration_seconds": 11.31,
      "text": "rest, ice, a compression bandage and keep it raised for two days. I'd like to see you again if it is not better in two weeks"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.9,
      "end_seconds": 300.19,
      "duration_seconds": 3.29,
      "text": "Um, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.17,
      "end_seconds": 304.81,
      "duration_seconds": 3.64,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.71,
      "end_seconds": 308.0,
      "duration_seconds": 2.29,
      "text": "Alright, thanks, take care."
    }
  ]
}