{
  "schema_version": "1.0",
  "encounter_id": "01271",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.79,
      "duration_seconds": 4.04,
      "text": "Hi doctor, um, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.42,
      "end_seconds": 10.97,
      "duration_seconds": 4.55,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.74,
      "end_seconds": 16.78,
      "duration_seconds": 5.04,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.23,
      "end_seconds": 22.68,
      "duration_seconds": 4.45,
      "text": "So, good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.84,
      "end_seconds": 29.07,
      "duration_seconds": 5.23,
      "text": "Doctor, it's a runny nose. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.0,
      "end_seconds": 35.16,
      "duration_seconds": 4.16,
      "text": "So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.14,
      "end_seconds": 60.19,
      "duration_seconds": 23.05,
      "text": "Right, uh, it's pantoprazole, 40 milligrams, before breakfast, doctor. Well, she is on hydrocortisone cream, when needed for the eczema, I give it to her. She is on propranolol, 40 milligrams, twice a day for the migraine prevention, I give it to her."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.37,
      "end_seconds": 63.29,
      "duration_seconds": 1.92,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 63.97,
      "end_seconds": 66.25,
      "duration_seconds": 2.28,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.97,
      "end_seconds": 70.5,
      "duration_seconds": 2.53,
      "text": "Omeprazole I don't take anymore."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.46,
      "end_seconds": 75.19,
      "duration_seconds": 3.73,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.17,
      "end_seconds": 86.54,
      "duration_seconds": 9.37,
      "text": "Uh, you know, for ten days, I'd say. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.97,
      "end_seconds": 90.1,
      "duration_seconds": 3.13,
      "text": "I follow. Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.89,
      "end_seconds": 93.86,
      "duration_seconds": 1.97,
      "text": "Tissues helps a bit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.26,
      "end_seconds": 98.5,
      "duration_seconds": 3.24,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.05,
      "end_seconds": 103.98,
      "duration_seconds": 4.93,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.81,
      "end_seconds": 107.77,
      "duration_seconds": 1.96,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.32,
      "end_seconds": 112.11,
      "duration_seconds": 2.79,
      "text": "It usually comes with sneezing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.84,
      "end_seconds": 120.62,
      "duration_seconds": 7.78,
      "text": "Right, um, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 120.72,
      "end_seconds": 128.15,
      "duration_seconds": 7.43,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.37,
      "end_seconds": 131.77,
      "duration_seconds": 2.4,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.67,
      "end_seconds": 140.53,
      "duration_seconds": 7.86,
      "text": "Oh, and a scratchy throat. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.48,
      "end_seconds": 144.9,
      "duration_seconds": 2.42,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.51,
      "end_seconds": 151.06,
      "duration_seconds": 4.55,
      "text": "Yes, you know, swallowing. That makes it worse."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 151.63,
      "end_seconds": 154.21,
      "duration_seconds": 2.58,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.41,
      "end_seconds": 164.79,
      "duration_seconds": 2.38,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.41,
      "end_seconds": 168.23,
      "duration_seconds": 1.82,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 168.82,
      "end_seconds": 174.25,
      "duration_seconds": 5.43,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.36,
      "end_seconds": 187.5,
      "duration_seconds": 7.14,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.44,
      "end_seconds": 196.38,
      "duration_seconds": 7.94,
      "text": "Alright, I'll note both what you've said and what you've noticed. Have you had any ear pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.6,
      "end_seconds": 199.67,
      "duration_seconds": 2.07,
      "text": "Nope, no ear pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.19,
      "end_seconds": 204.5,
      "duration_seconds": 4.31,
      "text": "Any shortness of breath or chest pain at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.31,
      "end_seconds": 219.6,
      "duration_seconds": 13.29,
      "text": "No, you know, no shortness of breath, no chest pain. I did have a mild cough at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.42,
      "end_seconds": 223.68,
      "duration_seconds": 2.26,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.68,
      "end_seconds": 228.43,
      "duration_seconds": 2.75,
      "text": "I, I move fine otherwise."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.07,
      "end_seconds": 231.79,
      "duration_seconds": 1.72,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.76,
      "end_seconds": 234.34,
      "duration_seconds": 1.58,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.3,
      "end_seconds": 239.17,
      "duration_seconds": 2.87,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.76,
      "end_seconds": 243.93,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.15,
      "end_seconds": 248.77,
      "duration_seconds": 3.62,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.57,
      "end_seconds": 253.7,
      "duration_seconds": 4.13,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.45,
      "end_seconds": 262.1,
      "duration_seconds": 3.65,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.81,
      "end_seconds": 268.8,
      "duration_seconds": 5.99,
      "text": "Um, uh, I've had anxiety for about ten years now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.12,
      "end_seconds": 270.93,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.92,
      "end_seconds": 287.31,
      "duration_seconds": 15.39,
      "text": "I've had acid reflux, yes. Eczema, for nearly five years. I've, I've had migraines for about ten years now. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.02,
      "end_seconds": 297.31,
      "duration_seconds": 8.29,
      "text": "I follow. Alright, anxiety and acid reflux, that matches what I have here. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.95,
      "end_seconds": 305.55,
      "duration_seconds": 7.6,
      "text": "I mean, yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.18,
      "end_seconds": 310.61,
      "duration_seconds": 3.43,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.35,
      "end_seconds": 321.73,
      "duration_seconds": 10.38,
      "text": "I, I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 322.23,
      "end_seconds": 329.71,
      "duration_seconds": 7.48,
      "text": "Doctor, I've got the readings for you. Pulse 72, BP is 115 over 82, temperature 37.0."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.24,
      "end_seconds": 331.62,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.65,
      "end_seconds": 337.47,
      "duration_seconds": 3.82,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.54,
      "end_seconds": 342.51,
      "duration_seconds": 2.97,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.29,
      "end_seconds": 346.69,
      "duration_seconds": 2.4,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.4,
      "end_seconds": 365.39,
      "duration_seconds": 4.99,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.43,
      "end_seconds": 370.69,
      "duration_seconds": 3.26,
      "text": "Alright, good, you can sit up again."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.03,
      "end_seconds": 403.02,
      "duration_seconds": 22.99,
      "text": "Let me tell you where I've got to. I'm honestly not certain yet. It could be a simple viral cold, or it might be early flu. Let me repeat that back to make sure. You've had a runny nose for ten days, and no ear pain or chest pain."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 403.85,
      "end_seconds": 405.98,
      "duration_seconds": 2.13,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.14,
      "end_seconds": 416.42,
      "duration_seconds": 9.28,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. Come back if it is not better in ten days."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.8,
      "end_seconds": 420.29,
      "duration_seconds": 2.49,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.31,
      "end_seconds": 426.61,
      "duration_seconds": 4.3,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.12,
      "end_seconds": 431.44,
      "duration_seconds": 4.32,
      "text": "Uh, uh, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.05,
      "end_seconds": 437.52,
      "duration_seconds": 1.47,
      "text": "Look after yourself."
    }
  ]
}