{
  "schema_version": "1.0",
  "encounter_id": "01039",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 5.0,
      "duration_seconds": 4.36,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.62,
      "end_seconds": 10.92,
      "duration_seconds": 4.3,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.88,
      "end_seconds": 19.18,
      "duration_seconds": 6.3,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.97,
      "end_seconds": 26.92,
      "duration_seconds": 5.95,
      "text": "so the thing is, I've got burning when I pass urine"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.8,
      "end_seconds": 30.93,
      "duration_seconds": 3.13,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.83,
      "end_seconds": 43.11,
      "duration_seconds": 8.28,
      "text": "About... well, five days. I've also had a dull ache low in my tummy, for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.96,
      "end_seconds": 47.2,
      "duration_seconds": 3.24,
      "text": "Have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.4,
      "end_seconds": 50.79,
      "duration_seconds": 2.39,
      "text": "yes, for about a month"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.88,
      "end_seconds": 57.78,
      "duration_seconds": 4.9,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.92,
      "end_seconds": 68.18,
      "duration_seconds": 3.26,
      "text": "Okay, sit still for a a moment..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.39,
      "end_seconds": 91.08,
      "duration_seconds": 9.69,
      "text": "Okay: saturation 99 percent, pulse is 82 beats a minute, temperature is 36.5 degrees, respiratory rate 16, blood pressure 108 over 79."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.01,
      "end_seconds": 95.24,
      "duration_seconds": 2.23,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.01,
      "end_seconds": 98.45,
      "duration_seconds": 1.44,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.87,
      "end_seconds": 120.61,
      "duration_seconds": 4.74,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.52,
      "end_seconds": 128.43,
      "duration_seconds": 1.91,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.32,
      "end_seconds": 137.79,
      "duration_seconds": 1.47,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.93,
      "end_seconds": 140.43,
      "duration_seconds": 1.5,
      "text": "No, no fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.05,
      "end_seconds": 147.4,
      "duration_seconds": 5.35,
      "text": "Have you noticed blood in the urine, vaginal discharge or back pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.05,
      "end_seconds": 155.2,
      "duration_seconds": 6.15,
      "text": "no, no blood in the urine, vaginal discharge or back pain"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.67,
      "end_seconds": 159.18,
      "duration_seconds": 2.51,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.78,
      "end_seconds": 161.48,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.01,
      "end_seconds": 164.52,
      "duration_seconds": 2.51,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.33,
      "end_seconds": 169.26,
      "duration_seconds": 2.93,
      "text": "It's febuxostat, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.8,
      "end_seconds": 172.15,
      "duration_seconds": 2.35,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.39,
      "end_seconds": 174.35,
      "duration_seconds": 0.96,
      "text": "80 milligrams"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.71,
      "end_seconds": 176.92,
      "duration_seconds": 1.21,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.42,
      "end_seconds": 184.6,
      "duration_seconds": 6.18,
      "text": "about nearly five years. Metoprolol, 50 milligrams, twice a day for my pressure"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.78,
      "end_seconds": 190.45,
      "duration_seconds": 2.67,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.54,
      "end_seconds": 193.56,
      "duration_seconds": 2.02,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.67,
      "end_seconds": 198.68,
      "duration_seconds": 4.01,
      "text": "alright, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.4,
      "end_seconds": 203.21,
      "duration_seconds": 3.81,
      "text": "I'm allergic to milk, I get a rash."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.15,
      "end_seconds": 220.93,
      "duration_seconds": 2.78,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.95,
      "end_seconds": 234.84,
      "duration_seconds": 11.89,
      "text": "I hardly move around during the day. I live with my elderly mother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 240.78,
      "duration_seconds": 4.45,
      "text": "okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.66,
      "end_seconds": 249.99,
      "duration_seconds": 7.33,
      "text": "I've got gout. I've, I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.58,
      "end_seconds": 259.17,
      "duration_seconds": 8.59,
      "text": "Okay, I can see gout and high blood pressure in your file as well. What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.21,
      "end_seconds": 267.79,
      "duration_seconds": 6.58,
      "text": "Mm, just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.27,
      "end_seconds": 294.01,
      "duration_seconds": 10.74,
      "text": "Let me tell you where I've got to. This is probably an uncomplicated urinary infection. It could also be vaginal irritation, so we'll keep that open."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.82,
      "end_seconds": 298.64,
      "duration_seconds": 2.82,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.6,
      "end_seconds": 336.02,
      "duration_seconds": 35.42,
      "text": "I understand the worry at the moment I'd say it's an uncomplicated urinary infection, and we'll know more once the a urine dipstick is back i'm going to order a urine dipstick, for burning urine i'll start you on nitrofurantoin, 100 milligrams, twice a day, three days you take it by mouth that should help with urinary infection drink plenty of water and avoid holding urine let's plan a check if it is not better in three days"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.9,
      "end_seconds": 337.6,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.44,
      "end_seconds": 342.64,
      "duration_seconds": 3.2,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.64,
      "end_seconds": 350.82,
      "duration_seconds": 3.18,
      "text": "I think I understand everything. Thanks."
    }
  ]
}