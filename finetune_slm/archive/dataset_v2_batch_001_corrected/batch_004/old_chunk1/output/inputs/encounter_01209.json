{
  "schema_version": "1.0",
  "encounter_id": "01209",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 6.35,
      "duration_seconds": 5.56,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.3,
      "end_seconds": 11.82,
      "duration_seconds": 3.52,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 22.9,
      "duration_seconds": 9.61,
      "text": "Mainly hives all over. There's a couple of other things, you know, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.76,
      "end_seconds": 26.74,
      "duration_seconds": 2.98,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.65,
      "end_seconds": 30.33,
      "duration_seconds": 2.68,
      "text": "For five days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.59,
      "end_seconds": 34.31,
      "duration_seconds": 2.72,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.83,
      "end_seconds": 42.61,
      "duration_seconds": 6.78,
      "text": "Pretty severe, if I'm being honest. I've also been feeling faint, since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.72,
      "end_seconds": 47.01,
      "duration_seconds": 3.29,
      "text": "What about wheezing, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.17,
      "end_seconds": 56.61,
      "duration_seconds": 8.44,
      "text": "Okay, you know, so yes, about the same, five days. With wheezing, I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.59,
      "end_seconds": 73.58,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.43,
      "end_seconds": 80.18,
      "duration_seconds": 4.75,
      "text": "I take Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.71,
      "end_seconds": 86.44,
      "duration_seconds": 4.73,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.01,
      "end_seconds": 96.55,
      "duration_seconds": 9.54,
      "text": "My partner and our baby. I'm a hairdresser, on my feet all day. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 105.68,
      "duration_seconds": 4.11,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 109.4,
      "duration_seconds": 2.9,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.4,
      "end_seconds": 127.23,
      "duration_seconds": 2.83,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.76,
      "end_seconds": 134.01,
      "duration_seconds": 2.25,
      "text": "Asthma, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.11,
      "end_seconds": 142.27,
      "duration_seconds": 7.16,
      "text": "Okay, I can see asthma in your file as well. Have you noticed recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.03,
      "end_seconds": 146.95,
      "duration_seconds": 3.92,
      "text": "No, no recent illness or chest pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.69,
      "end_seconds": 152.16,
      "duration_seconds": 3.47,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.11,
      "end_seconds": 156.87,
      "duration_seconds": 2.76,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.89,
      "end_seconds": 161.89,
      "duration_seconds": 3.0,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.75,
      "end_seconds": 164.31,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.48,
      "end_seconds": 167.92,
      "duration_seconds": 2.44,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.52,
      "end_seconds": 182.98,
      "duration_seconds": 2.46,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.39,
      "end_seconds": 212.14,
      "duration_seconds": 10.75,
      "text": "Okay: pressure 99 over 56, height 162 centimetres, respiratory rate 17. And weight 73 kilos, BMI works out to 27.8, pulse 111."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.7,
      "end_seconds": 215.06,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.46,
      "end_seconds": 219.01,
      "duration_seconds": 2.55,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.62,
      "end_seconds": 223.56,
      "duration_seconds": 1.94,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 226.28,
      "duration_seconds": 1.43,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.24,
      "end_seconds": 252.38,
      "duration_seconds": 7.14,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.91,
      "end_seconds": 259.24,
      "duration_seconds": 2.33,
      "text": "Okay, please sit back down."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.2,
      "end_seconds": 300.47,
      "duration_seconds": 30.27,
      "text": "So where does that leave us? I don't have a clear answer today: anaphylaxis is possible, and so is a severe allergic reaction. I'm sending you for monitoring because of anaphylaxis. Let's use adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.79,
      "end_seconds": 306.79,
      "duration_seconds": 3.0,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.74,
      "end_seconds": 311.87,
      "duration_seconds": 3.13,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.68,
      "end_seconds": 318.28,
      "duration_seconds": 5.6,
      "text": "Yeah, um, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.17,
      "end_seconds": 320.49,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}