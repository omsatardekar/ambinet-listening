{
  "schema_version": "1.0",
  "encounter_id": "01165",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.96,
      "end_seconds": 3.5,
      "duration_seconds": 2.54,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.8,
      "end_seconds": 7.98,
      "duration_seconds": 3.18,
      "text": "Afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.43,
      "end_seconds": 16.2,
      "duration_seconds": 3.77,
      "text": "okay, is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.12,
      "end_seconds": 24.5,
      "duration_seconds": 6.38,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.59,
      "end_seconds": 28.55,
      "duration_seconds": 1.96,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.37,
      "end_seconds": 47.79,
      "duration_seconds": 17.42,
      "text": "Yeah, it's a blocked ear. I don't know what's causing it. I took the morning off to come in today. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.16,
      "end_seconds": 50.96,
      "duration_seconds": 1.8,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.52,
      "end_seconds": 55.28,
      "duration_seconds": 3.76,
      "text": "I've, I've had it for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.17,
      "end_seconds": 65.24,
      "duration_seconds": 8.07,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.61,
      "end_seconds": 71.52,
      "duration_seconds": 4.91,
      "text": "it feels severe to me it's worse with showering"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.06,
      "end_seconds": 77.2,
      "duration_seconds": 4.14,
      "text": "Has there been muffled hearing on one side too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.4,
      "end_seconds": 79.99,
      "duration_seconds": 1.59,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.72,
      "end_seconds": 99.31,
      "duration_seconds": 1.59,
      "text": "Any sign of ringing?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.74,
      "end_seconds": 103.93,
      "duration_seconds": 3.19,
      "text": "Nope, you know, no ringing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.02,
      "end_seconds": 109.89,
      "duration_seconds": 3.87,
      "text": "A few quick ones: ear pain, dizziness or discharge?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.41,
      "end_seconds": 114.42,
      "duration_seconds": 3.01,
      "text": "Well, none of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.16,
      "end_seconds": 117.76,
      "duration_seconds": 2.6,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.46,
      "end_seconds": 119.47,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.14,
      "end_seconds": 124.7,
      "duration_seconds": 4.56,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.95,
      "end_seconds": 127.9,
      "duration_seconds": 1.95,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.27,
      "end_seconds": 147.96,
      "duration_seconds": 3.69,
      "text": "right, a a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.33,
      "end_seconds": 169.01,
      "duration_seconds": 19.68,
      "text": "I'll have a glass of wine with dinner. I have about eight cigarettes in a day. I'm a hairdresser, on my feet all day. I drink a lot of tea and snack through the day. My partner and our baby"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.75,
      "end_seconds": 173.2,
      "duration_seconds": 2.45,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.63,
      "end_seconds": 187.36,
      "duration_seconds": 12.73,
      "text": "I have anxiety. I've got heart failure. It's a relief to finally sit down and talk about it. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.06,
      "end_seconds": 197.8,
      "duration_seconds": 9.74,
      "text": "Yes, carry on. Alright, anxiety, that matches what I have here. Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.44,
      "end_seconds": 202.26,
      "duration_seconds": 3.82,
      "text": "Yeah, I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.91,
      "end_seconds": 206.35,
      "duration_seconds": 3.44,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.44,
      "end_seconds": 222.15,
      "duration_seconds": 14.71,
      "text": "Okay, so it's escitalopram, 10 milligrams, once a day. So, uh, I take metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 223.63,
      "end_seconds": 234.95,
      "duration_seconds": 11.32,
      "text": "Okay, so the vitals from earlier. Temperature 36.6, pulse is 75 beats a minute. Respiratory rate 15, oxygen saturation is 98 percent, blood pressure 118 over 76."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 237.24,
      "duration_seconds": 0.91,
      "text": "Right, thanks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.7,
      "end_seconds": 242.51,
      "duration_seconds": 3.81,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.59,
      "end_seconds": 244.89,
      "duration_seconds": 1.3,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.22,
      "end_seconds": 260.8,
      "duration_seconds": 4.58,
      "text": "there's a lot of wax blocking the right ear canal"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.99,
      "end_seconds": 263.84,
      "duration_seconds": 1.85,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.27,
      "end_seconds": 270.35,
      "duration_seconds": 3.08,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.02,
      "end_seconds": 313.73,
      "duration_seconds": 24.71,
      "text": "Putting it all together, this is probably earwax blocking the ear. A middle ear fluid is still possible. We should do ear irrigation for wax. The result will help us decide whether anything more is needed. Use the olive oil drops for a week and then we'll syringe the ear. Come back in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.49,
      "end_seconds": 320.4,
      "duration_seconds": 1.91,
      "text": "That's clear, thanks."
    }
  ]
}