{
  "schema_version": "1.0",
  "encounter_id": "01093",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 6.25,
      "duration_seconds": 5.01,
      "text": "Actually, uh, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.24,
      "end_seconds": 11.82,
      "duration_seconds": 4.58,
      "text": "Alright, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.65,
      "end_seconds": 25.86,
      "duration_seconds": 12.21,
      "text": "hello, doctor. I hope it's alright if I stay in for this. We came because of shaking chills and a high temperature"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.42,
      "end_seconds": 29.16,
      "duration_seconds": 2.74,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.68,
      "end_seconds": 37.4,
      "duration_seconds": 6.72,
      "text": "It's been two months now. And I've been feeling confused as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.69,
      "end_seconds": 51.49,
      "duration_seconds": 3.8,
      "text": "Have you noticed stiff neck, rash or chest pain?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.04,
      "end_seconds": 56.96,
      "duration_seconds": 3.92,
      "text": "Well, no, not a single one."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.5,
      "end_seconds": 61.59,
      "duration_seconds": 3.09,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.36,
      "end_seconds": 66.06,
      "duration_seconds": 3.7,
      "text": "No, you know, that's been fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.45,
      "end_seconds": 70.52,
      "duration_seconds": 3.07,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.88,
      "end_seconds": 74.88,
      "duration_seconds": 3.0,
      "text": "uh, I move fine otherwise"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.6,
      "end_seconds": 92.33,
      "duration_seconds": 4.73,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.12,
      "end_seconds": 97.47,
      "duration_seconds": 4.35,
      "text": "Yes, plasters. I get a red itchy rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 102.62,
      "duration_seconds": 3.54,
      "text": "so, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.38,
      "end_seconds": 104.56,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.17,
      "end_seconds": 109.46,
      "duration_seconds": 4.29,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.1,
      "end_seconds": 115.28,
      "duration_seconds": 4.18,
      "text": "Actually, uh, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.75,
      "end_seconds": 126.32,
      "duration_seconds": 3.57,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 127.89,
      "end_seconds": 134.66,
      "duration_seconds": 6.77,
      "text": "Ah, it's simvastatin, 20 milligrams, at night for my cholesterol, doctor."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.27,
      "end_seconds": 139.93,
      "duration_seconds": 4.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.83,
      "end_seconds": 159.78,
      "duration_seconds": 18.95,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. I hardly move around during the day. Lots of rice, lentils and some fruit. Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.91,
      "end_seconds": 167.26,
      "duration_seconds": 6.35,
      "text": "What about your medical history? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.57,
      "end_seconds": 174.1,
      "duration_seconds": 5.53,
      "text": "I've had high cholesterol for about a year now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.85,
      "end_seconds": 185.75,
      "duration_seconds": 10.9,
      "text": "Sure. Yes, high cholesterol is known to us, good to have that clear. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.25,
      "end_seconds": 199.52,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.68,
      "end_seconds": 229.74,
      "duration_seconds": 14.06,
      "text": "Okay: temperature 38.8, BMI works out to 25.0. And saturation 95 percent, height 166 centimetres, pulse is 95 beats a minute, pressure 107 over 66, weight 69 kilos, respiratory rate 19."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.94,
      "end_seconds": 234.32,
      "duration_seconds": 2.38,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.16,
      "end_seconds": 237.44,
      "duration_seconds": 1.28,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.0,
      "end_seconds": 260.88,
      "duration_seconds": 6.88,
      "text": "you are hot, your heart is racing and your blood pressure is low, which worries me"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.51,
      "end_seconds": 279.38,
      "duration_seconds": 13.87,
      "text": "You can sit up now. So, based on the history and the examination, this looks most like possible sepsis needing urgent treatment. I can't rule out a severe urine or chest infection yet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.85,
      "end_seconds": 284.3,
      "duration_seconds": 3.45,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.23,
      "end_seconds": 303.45,
      "duration_seconds": 18.22,
      "text": "It's reasonable to be concerned, but right now possible sepsis needing urgent treatment is my leading thought, not anything worse. Blood cultures is what I'd like next, for fever with low blood pressure. Lactate and blood tests is what I'd like next, for sepsis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.23,
      "end_seconds": 306.33,
      "duration_seconds": 1.1,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.33,
      "end_seconds": 334.57,
      "duration_seconds": 26.24,
      "text": "A chest X-ray is what I'd like next, for fever. That will help us see what's going on underneath and decide the next step. I wanna admit you to hospital now for fluids and antibiotics. Let's get you seen by the emergency team, I'll arrange the letter. We'll catch up straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.52,
      "end_seconds": 337.34,
      "duration_seconds": 1.82,
      "text": "that's clear, thanks"
    }
  ]
}