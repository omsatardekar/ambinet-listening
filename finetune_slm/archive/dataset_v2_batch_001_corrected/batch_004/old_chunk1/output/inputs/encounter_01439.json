{
  "schema_version": "1.0",
  "encounter_id": "01439",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 4.67,
      "duration_seconds": 3.94,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.26,
      "end_seconds": 10.56,
      "duration_seconds": 5.3,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.75,
      "end_seconds": 17.49,
      "duration_seconds": 5.74,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.47,
      "end_seconds": 22.7,
      "duration_seconds": 3.23,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.31,
      "end_seconds": 29.81,
      "duration_seconds": 5.5,
      "text": "Yeah, it's my throat closing up. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.85,
      "end_seconds": 35.35,
      "duration_seconds": 3.5,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.38,
      "end_seconds": 45.22,
      "duration_seconds": 8.84,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.3,
      "end_seconds": 57.06,
      "duration_seconds": 9.76,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.82,
      "end_seconds": 64.53,
      "duration_seconds": 5.71,
      "text": "Honestly, every other day. A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.94,
      "end_seconds": 71.85,
      "duration_seconds": 6.91,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 71.95,
      "end_seconds": 77.61,
      "duration_seconds": 5.66,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.16,
      "end_seconds": 86.05,
      "duration_seconds": 7.89,
      "text": "I was getting to that! I've also had swollen lips, for about two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.72,
      "end_seconds": 89.53,
      "duration_seconds": 2.81,
      "text": "Any hives all over as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.09,
      "end_seconds": 97.72,
      "duration_seconds": 7.63,
      "text": "Mm, yes. As for hives all over, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.22,
      "end_seconds": 101.24,
      "duration_seconds": 2.02,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.24,
      "end_seconds": 105.49,
      "duration_seconds": 3.25,
      "text": "Yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.53,
      "end_seconds": 113.11,
      "duration_seconds": 6.58,
      "text": "Have you had your throat closing up before, or is this the first time?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.75,
      "end_seconds": 120.11,
      "duration_seconds": 6.36,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 122.08,
      "end_seconds": 130.75,
      "duration_seconds": 8.67,
      "text": "Okay, so the vitals from earlier. Blood pressure 96 over 62, SpO2 99 percent on room air, pulse is 108 beats a minute."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.77,
      "end_seconds": 133.76,
      "duration_seconds": 0.99,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.26,
      "end_seconds": 137.51,
      "duration_seconds": 2.25,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.57,
      "end_seconds": 140.02,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.39,
      "end_seconds": 159.95,
      "duration_seconds": 7.56,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.75,
      "end_seconds": 169.6,
      "duration_seconds": 5.85,
      "text": "That's all I needed to check. Any chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.47,
      "end_seconds": 176.18,
      "duration_seconds": 4.71,
      "text": "I haven't had chest pain or recent illness, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.51,
      "end_seconds": 181.74,
      "duration_seconds": 4.23,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.02,
      "end_seconds": 185.1,
      "duration_seconds": 2.08,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.21,
      "end_seconds": 188.67,
      "duration_seconds": 2.46,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.93,
      "end_seconds": 192.61,
      "duration_seconds": 2.68,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.52,
      "end_seconds": 197.75,
      "duration_seconds": 4.23,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.41,
      "end_seconds": 203.26,
      "duration_seconds": 3.85,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.8,
      "end_seconds": 206.58,
      "duration_seconds": 2.78,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.99,
      "end_seconds": 211.18,
      "duration_seconds": 3.19,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.99,
      "end_seconds": 214.47,
      "duration_seconds": 2.48,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 215.88,
      "end_seconds": 220.86,
      "duration_seconds": 4.98,
      "text": "He takes Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.5,
      "end_seconds": 227.89,
      "duration_seconds": 5.39,
      "text": "I'd been on Seretide inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.15,
      "end_seconds": 233.82,
      "duration_seconds": 4.67,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.52,
      "end_seconds": 240.05,
      "duration_seconds": 4.53,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.51,
      "end_seconds": 251.76,
      "duration_seconds": 3.25,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.83,
      "end_seconds": 256.11,
      "duration_seconds": 2.28,
      "text": "Asthma, for five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.73,
      "end_seconds": 267.9,
      "duration_seconds": 3.17,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.92,
      "end_seconds": 272.97,
      "duration_seconds": 4.05,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.71,
      "end_seconds": 308.6,
      "duration_seconds": 34.89,
      "text": "Right, here's what I'm thinking. I think we're dealing with anaphylaxis at this stage. A severe allergic reaction is also on my list. I'm sending you for monitoring because of anaphylaxis. I'd rather check than guess, and this is the quickest way to know more. I'm going to put you on adrenaline, 0.5 milligrams, once now, single dose. That should help with anaphylaxis. Lie flat with your legs raised, I am giving the injection now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.61,
      "end_seconds": 314.31,
      "duration_seconds": 4.7,
      "text": "I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.55,
      "end_seconds": 317.18,
      "duration_seconds": 1.63,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.96,
      "end_seconds": 326.58,
      "duration_seconds": 7.62,
      "text": "If the symptoms return, that's the point to come in urgently. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.17,
      "end_seconds": 329.4,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.37,
      "end_seconds": 332.76,
      "duration_seconds": 1.39,
      "text": "Take care now."
    }
  ]
}