{
  "schema_version": "1.0",
  "encounter_id": "01464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.32,
      "duration_seconds": 4.46,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.06,
      "duration_seconds": 3.79,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.11,
      "end_seconds": 15.65,
      "duration_seconds": 4.54,
      "text": "Mainly I've been feeling faint. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.17,
      "end_seconds": 20.5,
      "duration_seconds": 3.33,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.39,
      "end_seconds": 27.58,
      "duration_seconds": 3.19,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.09,
      "end_seconds": 32.81,
      "duration_seconds": 4.72,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 42.98,
      "duration_seconds": 8.73,
      "text": "I get some relief from lying down. It happens a couple of times a week. Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.15,
      "end_seconds": 47.7,
      "duration_seconds": 3.55,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.4,
      "end_seconds": 56.06,
      "duration_seconds": 6.66,
      "text": "Sodium valproate. I take it 500 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.76,
      "end_seconds": 72.42,
      "duration_seconds": 4.66,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.17,
      "end_seconds": 75.84,
      "duration_seconds": 1.67,
      "text": "Plasters, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.97,
      "end_seconds": 80.37,
      "duration_seconds": 3.4,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.85,
      "end_seconds": 84.15,
      "duration_seconds": 2.3,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.57,
      "end_seconds": 97.34,
      "duration_seconds": 1.77,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.48,
      "end_seconds": 101.18,
      "duration_seconds": 2.7,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.25,
      "end_seconds": 105.32,
      "duration_seconds": 2.07,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.33,
      "end_seconds": 115.04,
      "duration_seconds": 5.71,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.68,
      "end_seconds": 117.07,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.68,
      "end_seconds": 121.24,
      "duration_seconds": 3.56,
      "text": "Well, you know, no, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.67,
      "end_seconds": 125.75,
      "duration_seconds": 3.08,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.43,
      "end_seconds": 131.68,
      "duration_seconds": 4.25,
      "text": "I've, I've had epilepsy for about ten years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.36,
      "end_seconds": 147.86,
      "duration_seconds": 12.5,
      "text": "I see, go ahead. Right, so epilepsy is already on your record. We'll keep that in mind today. Let me check a few things. Any fever or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.73,
      "end_seconds": 151.97,
      "duration_seconds": 3.24,
      "text": "No, no fever or chest pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.14,
      "end_seconds": 155.02,
      "duration_seconds": 1.88,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.78,
      "end_seconds": 157.53,
      "duration_seconds": 1.75,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.37,
      "end_seconds": 173.66,
      "duration_seconds": 3.29,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.62,
      "end_seconds": 184.61,
      "duration_seconds": 2.99,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.4,
      "end_seconds": 213.08,
      "duration_seconds": 7.68,
      "text": "Okay: BP is 114 over 85, respiratory rate 17, temp 37.1 degrees, heart rate 108."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.64,
      "end_seconds": 218.92,
      "duration_seconds": 4.28,
      "text": "Okay, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.5,
      "end_seconds": 220.56,
      "duration_seconds": 1.06,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.45,
      "end_seconds": 223.76,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.05,
      "end_seconds": 247.21,
      "duration_seconds": 6.16,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 253.77,
      "duration_seconds": 2.07,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.84,
      "end_seconds": 277.43,
      "duration_seconds": 6.59,
      "text": "Okay, so my impression is this: This is probably a possible bleeding stomach ulcer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.24,
      "end_seconds": 281.39,
      "duration_seconds": 3.15,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.48,
      "end_seconds": 307.33,
      "duration_seconds": 24.85,
      "text": "I can't promise yet, but most people with a possible bleeding stomach ulcer do well once it's treated properly. I'd like to arrange urgent blood tests for bleeding. Let's book an endoscopy to look into bleeding. Please stop the ibuprofen and do not eat or drink. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.66,
      "end_seconds": 309.36,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.66,
      "end_seconds": 314.53,
      "duration_seconds": 3.87,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.9,
      "end_seconds": 321.09,
      "duration_seconds": 3.19,
      "text": "I think I understand everything. Thanks."
    }
  ]
}