{
  "schema_version": "1.0",
  "encounter_id": "01276",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.62,
      "end_seconds": 6.73,
      "duration_seconds": 6.11,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.14,
      "end_seconds": 12.09,
      "duration_seconds": 3.95,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.45,
      "end_seconds": 18.81,
      "duration_seconds": 5.36,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.55,
      "end_seconds": 23.07,
      "duration_seconds": 2.52,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.26,
      "end_seconds": 29.01,
      "duration_seconds": 4.75,
      "text": "Doctor, it's no real problems. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.66,
      "end_seconds": 33.08,
      "duration_seconds": 3.42,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 34.71,
      "end_seconds": 55.64,
      "duration_seconds": 20.93,
      "text": "It's been like this since Monday. My neighbour said I should get it looked at. Well, um, as for bit of back stiffness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.26,
      "end_seconds": 59.42,
      "duration_seconds": 2.16,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 60.94,
      "end_seconds": 63.64,
      "duration_seconds": 2.7,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.45,
      "end_seconds": 68.53,
      "duration_seconds": 4.08,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 69.53,
      "end_seconds": 73.18,
      "duration_seconds": 3.65,
      "text": "High cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.17,
      "end_seconds": 76.13,
      "duration_seconds": 0.96,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 78.05,
      "end_seconds": 83.84,
      "duration_seconds": 5.79,
      "text": "Um, I have heart failure, for about ten years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.79,
      "end_seconds": 88.97,
      "duration_seconds": 1.18,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 90.89,
      "end_seconds": 94.61,
      "duration_seconds": 3.72,
      "text": "An underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.86,
      "end_seconds": 104.23,
      "duration_seconds": 8.37,
      "text": "Ah. Okay, I can see high cholesterol in your file as well. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 105.74,
      "end_seconds": 109.88,
      "duration_seconds": 4.14,
      "text": "Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 110.97,
      "end_seconds": 118.79,
      "duration_seconds": 7.82,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.0,
      "end_seconds": 122.34,
      "duration_seconds": 2.34,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 123.28,
      "end_seconds": 140.39,
      "duration_seconds": 17.11,
      "text": "For the fluid, I believe. My son sets them out for me, I just take what I'm given. I take Eltroxin, 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 142.45,
      "end_seconds": 146.88,
      "duration_seconds": 4.43,
      "text": "Doctor, our chart from the last visit lists it as 50 micrograms."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.95,
      "end_seconds": 152.74,
      "duration_seconds": 4.79,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 154.14,
      "end_seconds": 159.14,
      "duration_seconds": 5.0,
      "text": "I, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.14,
      "end_seconds": 163.5,
      "duration_seconds": 3.36,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 164.17,
      "end_seconds": 166.64,
      "duration_seconds": 2.47,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.43,
      "end_seconds": 171.57,
      "duration_seconds": 4.14,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 172.12,
      "end_seconds": 185.56,
      "duration_seconds": 13.44,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.95,
      "end_seconds": 188.3,
      "duration_seconds": 1.35,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 190.28,
      "end_seconds": 191.9,
      "duration_seconds": 1.62,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.67,
      "end_seconds": 194.47,
      "duration_seconds": 0.8,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 195.98,
      "end_seconds": 199.51,
      "duration_seconds": 3.53,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.23,
      "end_seconds": 202.08,
      "duration_seconds": 1.85,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 203.2,
      "end_seconds": 209.11,
      "duration_seconds": 5.91,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.16,
      "end_seconds": 211.54,
      "duration_seconds": 1.38,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 213.55,
      "end_seconds": 217.68,
      "duration_seconds": 4.13,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.4,
      "end_seconds": 223.92,
      "duration_seconds": 4.52,
      "text": "Did you get chest pain, weight loss or shortness of breath?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 225.35,
      "end_seconds": 240.07,
      "duration_seconds": 14.72,
      "text": "Well, no, no chest pain, no weight loss, no shortness of breath. I did have an occasional headache at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 245.65,
      "duration_seconds": 4.05,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 246.52,
      "end_seconds": 249.84,
      "duration_seconds": 3.32,
      "text": "Ah, no, that's been fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 259.92,
      "end_seconds": 270.13,
      "duration_seconds": 10.21,
      "text": "Doctor, I've got the readings for you. Pulse 79, temperature 36.6, oxygen saturation is 98 percent. BP is 120 over 75."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.68,
      "end_seconds": 272.01,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.57,
      "end_seconds": 277.83,
      "duration_seconds": 4.26,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.82,
      "end_seconds": 281.16,
      "duration_seconds": 2.34,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.59,
      "end_seconds": 291.0,
      "duration_seconds": 2.41,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.51,
      "end_seconds": 297.84,
      "duration_seconds": 2.33,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.74,
      "end_seconds": 334.03,
      "duration_seconds": 23.29,
      "text": "Having listened and examined, this is probably a healthy adult with no worrying findings. I want to be honest that this is an impression, not a final answer. I'll request a fasting sugar test, it'll help with routine check. A cholesterol blood test is what I'd like next, for routine check."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 335.26,
      "end_seconds": 337.29,
      "duration_seconds": 2.03,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.73,
      "end_seconds": 357.26,
      "duration_seconds": 18.53,
      "text": "Keep up regular exercise and a balanced diet. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please come and see me in twelve months. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_5",
      "role": "PATIENT",
      "start_seconds": 358.28,
      "end_seconds": 363.92,
      "duration_seconds": 5.64,
      "text": "Uh, um, okay, that makes sense. Thanks for explaining."
    }
  ]
}