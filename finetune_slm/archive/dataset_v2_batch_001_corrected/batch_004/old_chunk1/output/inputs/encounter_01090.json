{
  "schema_version": "1.0",
  "encounter_id": "01090",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 6.09,
      "duration_seconds": 5.25,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.95,
      "end_seconds": 12.53,
      "duration_seconds": 4.58,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.37,
      "end_seconds": 17.6,
      "duration_seconds": 3.23,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.71,
      "end_seconds": 21.85,
      "duration_seconds": 3.14,
      "text": "So, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.09,
      "end_seconds": 29.3,
      "duration_seconds": 6.21,
      "text": "It's a stiff neck, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.86,
      "end_seconds": 33.1,
      "duration_seconds": 3.24,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.2,
      "end_seconds": 43.28,
      "duration_seconds": 9.08,
      "text": "About a eight out of ten. And there's hating the light as well, four weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.94,
      "end_seconds": 49.83,
      "duration_seconds": 4.89,
      "text": "Has there been a rash that does not fade too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.55,
      "end_seconds": 53.08,
      "duration_seconds": 1.53,
      "text": "Yes, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.71,
      "end_seconds": 58.1,
      "duration_seconds": 4.39,
      "text": "Right, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.36,
      "end_seconds": 61.32,
      "duration_seconds": 1.96,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.85,
      "end_seconds": 71.99,
      "duration_seconds": 3.14,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 74.02,
      "end_seconds": 83.45,
      "duration_seconds": 9.43,
      "text": "She is on clopidogrel, 75 milligrams, once a day for the stent, I give it to her."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.85,
      "end_seconds": 85.53,
      "duration_seconds": 1.68,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 87.48,
      "end_seconds": 93.41,
      "duration_seconds": 5.93,
      "text": "She is on Asthalin inhaler, when needed, I give it to her."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.22,
      "end_seconds": 98.02,
      "duration_seconds": 2.8,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 99.18,
      "end_seconds": 101.28,
      "duration_seconds": 2.1,
      "text": "About about a month."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.49,
      "end_seconds": 118.5,
      "duration_seconds": 3.01,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.54,
      "end_seconds": 122.01,
      "duration_seconds": 2.47,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.23,
      "end_seconds": 126.25,
      "duration_seconds": 3.02,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.01,
      "end_seconds": 131.71,
      "duration_seconds": 4.7,
      "text": "I have asthma. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.97,
      "end_seconds": 142.73,
      "duration_seconds": 9.76,
      "text": "Okay, I can see asthma in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.08,
      "end_seconds": 155.41,
      "duration_seconds": 11.33,
      "text": "I live with my elderly mother. I grab fast food at lunch most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.84,
      "end_seconds": 162.47,
      "duration_seconds": 5.63,
      "text": "Let me check a few things. Any cough or recent head injury?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.33,
      "end_seconds": 168.56,
      "duration_seconds": 5.23,
      "text": "No cough or recent head injury, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.64,
      "end_seconds": 172.9,
      "duration_seconds": 2.26,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.36,
      "end_seconds": 176.8,
      "duration_seconds": 2.44,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.42,
      "end_seconds": 180.25,
      "duration_seconds": 2.83,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.16,
      "end_seconds": 189.99,
      "duration_seconds": 2.83,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.69,
      "end_seconds": 217.49,
      "duration_seconds": 6.8,
      "text": "Okay: pressure 120 over 79, temp 38.2 degrees, pulse is 95 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.71,
      "end_seconds": 222.27,
      "duration_seconds": 3.56,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.14,
      "end_seconds": 225.32,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.75,
      "end_seconds": 248.42,
      "duration_seconds": 8.67,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.12,
      "end_seconds": 260.4,
      "duration_seconds": 9.28,
      "text": "Good, you can sit up again. So, based on the history and the examination, this is probably possible bacterial meningitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.7,
      "end_seconds": 263.51,
      "duration_seconds": 1.81,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 273.02,
      "duration_seconds": 8.22,
      "text": "Nothing I've seen today points to an emergency. It looks like possible bacterial meningitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.08,
      "end_seconds": 314.68,
      "duration_seconds": 28.6,
      "text": "I'd like to arrange a lumbar puncture for possible meningitis. Let's book blood cultures to look into possible meningitis. For this, benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. It's a commonly used medicine and most people tolerate it well. Call an ambulance now, this is an emergency. We'll refer you to the emergency team. Come back straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 317.93,
      "duration_seconds": 2.24,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.99,
      "end_seconds": 322.45,
      "duration_seconds": 2.46,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.62,
      "end_seconds": 326.57,
      "duration_seconds": 2.95,
      "text": "Okay, so thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.49,
      "end_seconds": 329.45,
      "duration_seconds": 1.96,
      "text": "Okay, all the best."
    }
  ]
}