{
  "schema_version": "1.0",
  "encounter_id": "01100",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 8.43,
      "duration_seconds": 7.59,
      "text": "Hello doctor, sorry, I took a wrong turn on the the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.13,
      "end_seconds": 14.43,
      "duration_seconds": 4.3,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.98,
      "end_seconds": 22.98,
      "duration_seconds": 8.0,
      "text": "Yeah, it's a tight band around my head. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.72,
      "end_seconds": 31.14,
      "duration_seconds": 3.42,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.93,
      "end_seconds": 41.66,
      "duration_seconds": 5.73,
      "text": "Around about three months... no wait, it's more like six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.31,
      "end_seconds": 46.61,
      "duration_seconds": 3.3,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.96,
      "end_seconds": 52.16,
      "duration_seconds": 4.2,
      "text": "It settles a little with a warm shower."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.63,
      "end_seconds": 55.56,
      "duration_seconds": 1.93,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.5,
      "end_seconds": 65.55,
      "duration_seconds": 8.05,
      "text": "I notice it more with stress and long screen days. And a stiff neck, too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.02,
      "end_seconds": 75.74,
      "duration_seconds": 5.72,
      "text": "So, have you had any blurred vision, sensitivity to light or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.33,
      "end_seconds": 81.78,
      "duration_seconds": 5.45,
      "text": "I haven't had blurred vision, sensitivity to light or weakness, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.83,
      "end_seconds": 87.46,
      "duration_seconds": 1.63,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.45,
      "end_seconds": 91.85,
      "duration_seconds": 2.4,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.32,
      "end_seconds": 104.66,
      "duration_seconds": 4.34,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.67,
      "end_seconds": 107.39,
      "duration_seconds": 1.72,
      "text": "not really, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.63,
      "end_seconds": 112.19,
      "duration_seconds": 3.56,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.47,
      "end_seconds": 119.77,
      "duration_seconds": 4.3,
      "text": "Uh, I'm on paracetamol, 1 gram, when needed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.02,
      "end_seconds": 123.45,
      "duration_seconds": 3.43,
      "text": "Right, right. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.54,
      "end_seconds": 140.42,
      "duration_seconds": 15.88,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. No, I share a house with my brother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 155.25,
      "duration_seconds": 4.49,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.65,
      "end_seconds": 159.18,
      "duration_seconds": 2.53,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.66,
      "end_seconds": 171.44,
      "duration_seconds": 3.78,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.31,
      "end_seconds": 175.22,
      "duration_seconds": 1.91,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.91,
      "end_seconds": 178.81,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.95,
      "end_seconds": 194.37,
      "duration_seconds": 2.42,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.06,
      "end_seconds": 223.42,
      "duration_seconds": 8.36,
      "text": "okay: temperature 36.4, pulse is 75 beats a minute, blood pressure 124 over 79, respiratory rate 16."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.12,
      "end_seconds": 226.81,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.61,
      "end_seconds": 232.66,
      "duration_seconds": 5.05,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.81,
      "end_seconds": 236.92,
      "duration_seconds": 2.11,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.98,
      "end_seconds": 240.67,
      "duration_seconds": 2.69,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.96,
      "end_seconds": 253.45,
      "duration_seconds": 5.49,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.56,
      "end_seconds": 258.94,
      "duration_seconds": 2.38,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.8,
      "end_seconds": 281.01,
      "duration_seconds": 5.21,
      "text": "Right, here's what I'm thinking. This looks most like tension-type headache."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.97,
      "end_seconds": 285.53,
      "duration_seconds": 2.56,
      "text": "Erm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.29,
      "end_seconds": 298.89,
      "duration_seconds": 11.6,
      "text": "it's reasonable to be concerned, but right now tension-type headache is my leading thought, not anything worse i'm sending you for an eye test because of eye strain"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.15,
      "end_seconds": 302.93,
      "duration_seconds": 2.78,
      "text": "do I need to prepare?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.65,
      "end_seconds": 312.71,
      "duration_seconds": 8.06,
      "text": "Take screen breaks every hour and try regular neck stretches. Let's plan a check in four weeks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.22,
      "end_seconds": 315.02,
      "duration_seconds": 1.8,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.61,
      "end_seconds": 320.23,
      "duration_seconds": 4.62,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.4,
      "end_seconds": 323.79,
      "duration_seconds": 2.39,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.97,
      "end_seconds": 326.29,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}