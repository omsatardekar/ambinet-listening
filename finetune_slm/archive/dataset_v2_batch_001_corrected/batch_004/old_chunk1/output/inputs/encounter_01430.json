{
  "schema_version": "1.0",
  "encounter_id": "01430",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 8.07,
      "duration_seconds": 6.88,
      "text": "Hello doctor, um, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.43,
      "end_seconds": 13.68,
      "duration_seconds": 4.25,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.99,
      "end_seconds": 19.26,
      "duration_seconds": 4.27,
      "text": "It's a dry cough in the evenings, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.55,
      "end_seconds": 22.53,
      "duration_seconds": 1.98,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.48,
      "end_seconds": 28.01,
      "duration_seconds": 4.53,
      "text": "It's been about four days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.28,
      "end_seconds": 32.63,
      "duration_seconds": 3.35,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.05,
      "end_seconds": 37.64,
      "duration_seconds": 3.59,
      "text": "Actually, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.21,
      "end_seconds": 42.96,
      "duration_seconds": 3.75,
      "text": "What about sneezing fits, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.83,
      "end_seconds": 45.98,
      "duration_seconds": 1.15,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.54,
      "end_seconds": 50.66,
      "duration_seconds": 3.12,
      "text": "Did you notice any shortness of breath?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.5,
      "end_seconds": 54.8,
      "duration_seconds": 2.3,
      "text": "No. No shortness of breath."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.71,
      "end_seconds": 57.68,
      "duration_seconds": 1.97,
      "text": "Any wheeze or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.31,
      "end_seconds": 63.09,
      "duration_seconds": 3.78,
      "text": "Um, no, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.64,
      "end_seconds": 66.23,
      "duration_seconds": 2.59,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.81,
      "end_seconds": 70.77,
      "duration_seconds": 2.96,
      "text": "Yeah, no, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.63,
      "end_seconds": 74.91,
      "duration_seconds": 3.28,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.12,
      "end_seconds": 79.25,
      "duration_seconds": 3.13,
      "text": "Okay, so no, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.56,
      "end_seconds": 85.79,
      "duration_seconds": 5.23,
      "text": "Alright, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.3,
      "end_seconds": 91.77,
      "duration_seconds": 4.47,
      "text": "Let me think, my mother had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.85,
      "end_seconds": 101.0,
      "duration_seconds": 2.15,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 105.63,
      "duration_seconds": 4.05,
      "text": "It's, It's loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.2,
      "end_seconds": 110.95,
      "duration_seconds": 4.75,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.01,
      "end_seconds": 116.58,
      "duration_seconds": 1.57,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.62,
      "end_seconds": 128.98,
      "duration_seconds": 2.36,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.87,
      "end_seconds": 139.56,
      "duration_seconds": 9.69,
      "text": "My husband and I live above the shop. I swim twice a week. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.12,
      "end_seconds": 142.42,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.22,
      "end_seconds": 144.76,
      "duration_seconds": 1.54,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.94,
      "end_seconds": 161.87,
      "duration_seconds": 2.93,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.59,
      "end_seconds": 167.83,
      "duration_seconds": 4.24,
      "text": "No, uh, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.81,
      "end_seconds": 171.81,
      "duration_seconds": 3.0,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.52,
      "end_seconds": 182.63,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.66,
      "end_seconds": 208.47,
      "duration_seconds": 5.81,
      "text": "Okay: pressure 127 over 80, saturation 98 percent, respiratory rate 16, heart rate 81."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.1,
      "end_seconds": 214.99,
      "duration_seconds": 3.89,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.1,
      "end_seconds": 217.67,
      "duration_seconds": 1.57,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.57,
      "end_seconds": 234.93,
      "duration_seconds": 5.36,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.76,
      "end_seconds": 239.64,
      "duration_seconds": 1.88,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.68,
      "end_seconds": 255.15,
      "duration_seconds": 7.47,
      "text": "So, based on the history and the examination, it fits best with seasonal hay fever causing the cough."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.23,
      "end_seconds": 260.48,
      "duration_seconds": 3.25,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.07,
      "end_seconds": 283.73,
      "duration_seconds": 21.66,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal hay fever causing the cough. The treatment will be fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.06,
      "end_seconds": 287.69,
      "duration_seconds": 2.63,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.21,
      "end_seconds": 298.29,
      "duration_seconds": 10.08,
      "text": "Keep windows closed on high-pollen days and wash your hair at night. Please don't wait if you start wheezing. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.48,
      "end_seconds": 300.98,
      "duration_seconds": 1.5,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.29,
      "end_seconds": 307.12,
      "duration_seconds": 4.83,
      "text": "We'll catch up in a month. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.73,
      "end_seconds": 311.54,
      "duration_seconds": 2.81,
      "text": "Yeah, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.36,
      "end_seconds": 315.32,
      "duration_seconds": 1.96,
      "text": "Have a good day."
    }
  ]
}