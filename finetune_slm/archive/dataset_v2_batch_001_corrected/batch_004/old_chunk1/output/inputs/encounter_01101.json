{
  "schema_version": "1.0",
  "encounter_id": "01101",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.74,
      "end_seconds": 3.31,
      "duration_seconds": 2.57,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.28,
      "end_seconds": 7.33,
      "duration_seconds": 3.05,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.57,
      "end_seconds": 11.25,
      "duration_seconds": 2.68,
      "text": "You came on your own today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.27,
      "end_seconds": 15.3,
      "duration_seconds": 3.03,
      "text": "Yes, I managed on my own."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.8,
      "end_seconds": 18.46,
      "duration_seconds": 1.66,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.72,
      "end_seconds": 24.73,
      "duration_seconds": 5.01,
      "text": "I wanted to get weakness in my right arm looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.79,
      "end_seconds": 29.7,
      "duration_seconds": 2.91,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.05,
      "end_seconds": 36.51,
      "duration_seconds": 2.46,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.6,
      "end_seconds": 46.06,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.67,
      "end_seconds": 62.25,
      "duration_seconds": 2.58,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.11,
      "end_seconds": 80.96,
      "duration_seconds": 6.85,
      "text": "Okay: pulse 92, pressure 156 over 88, temp 36.6 degrees. And oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.47,
      "end_seconds": 84.41,
      "duration_seconds": 1.94,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.53,
      "end_seconds": 88.2,
      "duration_seconds": 2.67,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.89,
      "end_seconds": 105.58,
      "duration_seconds": 5.69,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.46,
      "end_seconds": 111.12,
      "duration_seconds": 1.66,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.4,
      "end_seconds": 127.24,
      "duration_seconds": 3.84,
      "text": "And what about fever, seizure or loss of consciousness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.09,
      "end_seconds": 133.62,
      "duration_seconds": 4.53,
      "text": "Okay, so no, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.03,
      "end_seconds": 137.18,
      "duration_seconds": 2.15,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.37,
      "end_seconds": 143.41,
      "duration_seconds": 2.04,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.26,
      "end_seconds": 146.01,
      "duration_seconds": 1.75,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.54,
      "end_seconds": 149.83,
      "duration_seconds": 3.29,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 153.04,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.81,
      "end_seconds": 158.99,
      "duration_seconds": 4.18,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.73,
      "end_seconds": 162.06,
      "duration_seconds": 2.33,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.15,
      "end_seconds": 166.43,
      "duration_seconds": 3.28,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.29,
      "end_seconds": 168.56,
      "duration_seconds": 1.27,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.56,
      "end_seconds": 173.52,
      "duration_seconds": 2.96,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.3,
      "end_seconds": 180.7,
      "duration_seconds": 6.4,
      "text": "Have you got any known allergies? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.8,
      "end_seconds": 183.9,
      "duration_seconds": 2.1,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.56,
      "end_seconds": 191.01,
      "duration_seconds": 2.45,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.16,
      "end_seconds": 198.63,
      "duration_seconds": 5.47,
      "text": "I, I take losartan, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.14,
      "end_seconds": 202.27,
      "duration_seconds": 2.13,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.7,
      "end_seconds": 204.69,
      "duration_seconds": 0.99,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.01,
      "end_seconds": 209.41,
      "duration_seconds": 3.4,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.62,
      "end_seconds": 213.01,
      "duration_seconds": 2.39,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.45,
      "end_seconds": 215.38,
      "duration_seconds": 0.93,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.53,
      "end_seconds": 229.74,
      "duration_seconds": 7.21,
      "text": "Okay, thinking it through, I'd lean towards a possible stroke, within the treatment window."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.66,
      "end_seconds": 234.47,
      "duration_seconds": 2.81,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.42,
      "end_seconds": 244.22,
      "duration_seconds": 8.8,
      "text": "I can't promise yet, but most people with a possible stroke, within the treatment window do well once it's treated properly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.87,
      "end_seconds": 266.44,
      "duration_seconds": 6.57,
      "text": "I'd like to arrange an urgent CT scan of the head for possible stroke."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.23,
      "end_seconds": 270.23,
      "duration_seconds": 3.0,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.68,
      "end_seconds": 296.16,
      "duration_seconds": 24.48,
      "text": "Call an ambulance now, you need hospital immediately. I'd like you to see the stroke team as well, and I'll write the referral. I'm not ordering a blood sugar test today. If things carry on next month, we'll consider it. If the symptoms change, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.79,
      "end_seconds": 298.46,
      "duration_seconds": 1.67,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.65,
      "end_seconds": 311.26,
      "duration_seconds": 8.61,
      "text": "Let's review you straight away. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.38,
      "end_seconds": 316.75,
      "duration_seconds": 4.37,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.3,
      "end_seconds": 322.33,
      "duration_seconds": 5.03,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.81,
      "end_seconds": 326.07,
      "duration_seconds": 2.26,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.86,
      "end_seconds": 329.33,
      "duration_seconds": 1.47,
      "text": "All the best."
    }
  ]
}