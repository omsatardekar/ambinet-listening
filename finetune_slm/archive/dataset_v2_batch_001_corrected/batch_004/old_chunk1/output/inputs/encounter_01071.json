{
  "schema_version": "1.0",
  "encounter_id": "01071",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 4.38,
      "duration_seconds": 3.05,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.05,
      "end_seconds": 8.77,
      "duration_seconds": 3.72,
      "text": "mm, hello, thanks for fitting me in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 12.66,
      "duration_seconds": 2.73,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.02,
      "end_seconds": 18.06,
      "duration_seconds": 4.04,
      "text": "Well, I've been having severe lower back pain."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.08,
      "end_seconds": 22.32,
      "duration_seconds": 2.24,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.96,
      "end_seconds": 31.02,
      "duration_seconds": 8.06,
      "text": "Aspirin. I take it 75 milligrams, maybe, once a day for my heart."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.51,
      "end_seconds": 40.52,
      "duration_seconds": 4.01,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.95,
      "end_seconds": 53.42,
      "duration_seconds": 11.47,
      "text": "sorry, what was I saying, no, it's at home. Thyronorm, 50 micrograms, every morning. It's losartan, 50 milligrams, once a day"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.99,
      "end_seconds": 55.01,
      "duration_seconds": 1.02,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.07,
      "end_seconds": 63.25,
      "duration_seconds": 7.18,
      "text": "Uh, um, I was on hydrochlorothiazide before. I stopped taking it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.17,
      "end_seconds": 66.91,
      "duration_seconds": 2.74,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.55,
      "end_seconds": 76.12,
      "duration_seconds": 8.57,
      "text": "about... well, about a month. My neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.63,
      "end_seconds": 80.49,
      "duration_seconds": 2.86,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.07,
      "end_seconds": 106.27,
      "duration_seconds": 24.2,
      "text": "It usually comes with numbness between my legs. The numbness between my legs? That's been for five days. So, as for numbness between my legs, pretty severe, if I'm being honest. Mm, I had weakness in both legs before. That's settled now, though."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.46,
      "end_seconds": 110.82,
      "duration_seconds": 3.36,
      "text": "Okay, have you noticed fever or recent fall?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.96,
      "end_seconds": 115.16,
      "duration_seconds": 3.2,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.4,
      "end_seconds": 119.08,
      "duration_seconds": 2.68,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.6,
      "end_seconds": 122.47,
      "duration_seconds": 2.87,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.54,
      "end_seconds": 134.02,
      "duration_seconds": 4.48,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.11,
      "end_seconds": 137.8,
      "duration_seconds": 1.69,
      "text": "Amoxicillin, I'd say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.82,
      "end_seconds": 141.91,
      "duration_seconds": 3.09,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.46,
      "end_seconds": 148.57,
      "duration_seconds": 6.11,
      "text": "Um, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.29,
      "end_seconds": 167.99,
      "duration_seconds": 1.7,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.88,
      "end_seconds": 171.41,
      "duration_seconds": 2.53,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.96,
      "end_seconds": 176.67,
      "duration_seconds": 1.71,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.66,
      "end_seconds": 183.7,
      "duration_seconds": 5.04,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.44,
      "end_seconds": 187.12,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.64,
      "end_seconds": 191.65,
      "duration_seconds": 4.01,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.1,
      "end_seconds": 196.02,
      "duration_seconds": 2.92,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.87,
      "end_seconds": 214.64,
      "duration_seconds": 17.77,
      "text": "I have heart disease, for two years. Oh, I have an underactive thyroid, for nearly five years. It's the not knowing that gets to to me. I've had high blood pressure for two years now"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.6,
      "end_seconds": 227.08,
      "duration_seconds": 10.48,
      "text": "yes, heart disease and high blood pressure are known to us, good to have that clear okay, time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.62,
      "end_seconds": 240.01,
      "duration_seconds": 2.39,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.61,
      "end_seconds": 260.48,
      "duration_seconds": 10.87,
      "text": "Okay: pulse is 86 beats a a minute, BP is 120 over 73, temp 36.7 degrees. And oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.97,
      "end_seconds": 266.72,
      "duration_seconds": 4.75,
      "text": "Let me look at the the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.55,
      "end_seconds": 269.88,
      "duration_seconds": 1.33,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.03,
      "end_seconds": 286.1,
      "duration_seconds": 6.07,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.27,
      "end_seconds": 291.01,
      "duration_seconds": 1.74,
      "text": "please sit back down"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.98,
      "end_seconds": 332.16,
      "duration_seconds": 25.18,
      "text": "Putting it all together, I don't have a clear answer today: possible cauda equina syndrome needing an urgent scan is possible, and so is a large disc prolapse. Let me just check I've got this right. You've had severe lower back pain for about a month, and no fever or recent fall."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.79,
      "end_seconds": 340.56,
      "duration_seconds": 2.77,
      "text": "mm, uh, that's right"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.32,
      "end_seconds": 358.94,
      "duration_seconds": 17.62,
      "text": "I'd like to arrange an urgent MRI of the spine for possible cauda equina. You need to go to hospital now for an emergency scan. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.06,
      "end_seconds": 364.82,
      "duration_seconds": 4.76,
      "text": "Um, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.06,
      "end_seconds": 371.14,
      "duration_seconds": 5.08,
      "text": "Do get help quickly if the numbness spreads. See me again straight away."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.76,
      "end_seconds": 376.16,
      "duration_seconds": 3.4,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.97,
      "end_seconds": 382.27,
      "duration_seconds": 5.3,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.1,
      "end_seconds": 388.1,
      "duration_seconds": 4.0,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}