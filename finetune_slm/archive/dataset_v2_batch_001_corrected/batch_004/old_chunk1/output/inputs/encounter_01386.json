{
  "schema_version": "1.0",
  "encounter_id": "01386",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.91,
      "end_seconds": 7.85,
      "duration_seconds": 6.94,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.23,
      "end_seconds": 13.62,
      "duration_seconds": 4.39,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.77,
      "end_seconds": 23.42,
      "duration_seconds": 5.65,
      "text": "So the thing is, I've got a severe sore throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.5,
      "end_seconds": 27.4,
      "duration_seconds": 2.9,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.12,
      "end_seconds": 34.12,
      "duration_seconds": 6.0,
      "text": "Mm, I'd say about a week. Actually, no, closer to four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.26,
      "end_seconds": 43.15,
      "duration_seconds": 7.89,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.73,
      "end_seconds": 59.59,
      "duration_seconds": 13.86,
      "text": "Yes, swallowing. That makes it worse. Maybe a five out of ten on a bad day. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.74,
      "end_seconds": 66.69,
      "duration_seconds": 2.95,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.54,
      "end_seconds": 72.49,
      "duration_seconds": 3.95,
      "text": "It usually comes with a muffled voice."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.67,
      "end_seconds": 76.5,
      "duration_seconds": 2.83,
      "text": "Okay, have you had noisy breathing?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.15,
      "end_seconds": 79.91,
      "duration_seconds": 1.76,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.62,
      "end_seconds": 85.65,
      "duration_seconds": 4.03,
      "text": "So, have you had any cough or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.56,
      "end_seconds": 90.91,
      "duration_seconds": 3.35,
      "text": "Yeah, no, no cough or rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.38,
      "end_seconds": 94.8,
      "duration_seconds": 2.42,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 96.13,
      "end_seconds": 98.17,
      "duration_seconds": 2.04,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 101.25,
      "duration_seconds": 2.17,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.94,
      "end_seconds": 104.5,
      "duration_seconds": 2.56,
      "text": "Acid reflux, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.53,
      "end_seconds": 110.72,
      "duration_seconds": 5.19,
      "text": "Okay, I can see acid reflux in your file as well."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.81,
      "end_seconds": 130.21,
      "duration_seconds": 2.4,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.92,
      "end_seconds": 137.23,
      "duration_seconds": 2.31,
      "text": "It's lansoprazole, before breakfast."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.58,
      "end_seconds": 141.33,
      "duration_seconds": 2.75,
      "text": "Alright, how much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.23,
      "end_seconds": 143.69,
      "duration_seconds": 1.46,
      "text": "It's 30 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.56,
      "end_seconds": 148.14,
      "duration_seconds": 2.58,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.67,
      "end_seconds": 154.35,
      "duration_seconds": 4.68,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 170.1,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.73,
      "end_seconds": 172.91,
      "duration_seconds": 1.18,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.07,
      "end_seconds": 175.64,
      "duration_seconds": 1.57,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.42,
      "end_seconds": 180.43,
      "duration_seconds": 4.01,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.96,
      "end_seconds": 184.42,
      "duration_seconds": 2.46,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.21,
      "end_seconds": 190.09,
      "duration_seconds": 3.88,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.64,
      "end_seconds": 197.76,
      "duration_seconds": 3.12,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.88,
      "end_seconds": 203.81,
      "duration_seconds": 4.93,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 208.5,
      "end_seconds": 217.16,
      "duration_seconds": 8.66,
      "text": "Okay, so the vitals from earlier. Heart rate 102, pressure 131 over 74, oxygen saturation is 91 percent. Temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.79,
      "end_seconds": 219.87,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.56,
      "end_seconds": 225.95,
      "duration_seconds": 4.39,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.19,
      "end_seconds": 229.47,
      "duration_seconds": 2.28,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.04,
      "end_seconds": 245.86,
      "duration_seconds": 4.82,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.43,
      "end_seconds": 253.32,
      "duration_seconds": 1.89,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.54,
      "end_seconds": 285.66,
      "duration_seconds": 14.12,
      "text": "Okay, thinking it through, it's hard to say. A possible airway infection that needs emergency care is one possibility and severe tonsillitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.73,
      "end_seconds": 288.79,
      "duration_seconds": 2.06,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.69,
      "end_seconds": 324.16,
      "duration_seconds": 33.47,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible airway infection that needs emergency care, but I'd like to confirm. I'll request an urgent airway assessment, it'll help with stridor and drooling. Do not lie flat, I am calling an ambulance now. The emergency ENT team would be the right next step, I'll refer you. Let's review you straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.2,
      "end_seconds": 329.41,
      "duration_seconds": 4.21,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.75,
      "end_seconds": 332.07,
      "duration_seconds": 1.32,
      "text": "Goodbye for now."
    }
  ]
}