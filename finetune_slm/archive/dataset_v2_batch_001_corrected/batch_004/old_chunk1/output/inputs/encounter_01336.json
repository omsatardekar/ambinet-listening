{
  "schema_version": "1.0",
  "encounter_id": "01336",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 5.46,
      "duration_seconds": 4.75,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.23,
      "end_seconds": 10.26,
      "duration_seconds": 4.03,
      "text": "Right, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.09,
      "end_seconds": 20.53,
      "duration_seconds": 5.44,
      "text": "Yeah, it's a high fever. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.4,
      "end_seconds": 26.65,
      "duration_seconds": 4.25,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.78,
      "end_seconds": 34.75,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.92,
      "end_seconds": 60.21,
      "duration_seconds": 7.29,
      "text": "Okay: saturation 95 percent, pulse is 88 beats a minute, blood pressure 104 over 68."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.3,
      "end_seconds": 64.61,
      "duration_seconds": 2.31,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.75,
      "end_seconds": 70.47,
      "duration_seconds": 4.72,
      "text": "We'll look at it together shortly. Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.87,
      "end_seconds": 74.61,
      "duration_seconds": 2.74,
      "text": "It's been about four days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.67,
      "end_seconds": 78.02,
      "duration_seconds": 2.35,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.72,
      "end_seconds": 89.91,
      "duration_seconds": 11.19,
      "text": "I'd say all the time. There's a stiff neck as well. About stiff neck, it happens a few times a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 96.15,
      "duration_seconds": 5.71,
      "text": "Let me check a few things. Any cough or recent head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.84,
      "end_seconds": 100.55,
      "duration_seconds": 3.71,
      "text": "No, no cough or recent head injury."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.32,
      "end_seconds": 106.3,
      "duration_seconds": 3.98,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.08,
      "end_seconds": 109.09,
      "duration_seconds": 2.01,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.26,
      "end_seconds": 112.34,
      "duration_seconds": 2.08,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.21,
      "end_seconds": 116.76,
      "duration_seconds": 3.55,
      "text": "Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.52,
      "end_seconds": 135.57,
      "duration_seconds": 4.05,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.91,
      "end_seconds": 139.47,
      "duration_seconds": 2.56,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.54,
      "end_seconds": 155.89,
      "duration_seconds": 4.35,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.9,
      "end_seconds": 159.16,
      "duration_seconds": 2.26,
      "text": "I've got heart failure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 165.3,
      "duration_seconds": 4.63,
      "text": "Mm-hmm. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.28,
      "end_seconds": 169.26,
      "duration_seconds": 2.98,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.47,
      "end_seconds": 182.67,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.36,
      "end_seconds": 189.86,
      "duration_seconds": 5.5,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.63,
      "end_seconds": 192.84,
      "duration_seconds": 1.21,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.76,
      "end_seconds": 200.59,
      "duration_seconds": 2.83,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.63,
      "end_seconds": 206.56,
      "duration_seconds": 1.93,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.47,
      "end_seconds": 210.99,
      "duration_seconds": 3.52,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.12,
      "end_seconds": 213.79,
      "duration_seconds": 1.67,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.79,
      "end_seconds": 219.5,
      "duration_seconds": 2.71,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.3,
      "end_seconds": 226.99,
      "duration_seconds": 4.69,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.45,
      "end_seconds": 229.63,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.29,
      "end_seconds": 254.89,
      "duration_seconds": 8.6,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.54,
      "end_seconds": 259.91,
      "duration_seconds": 2.37,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.24,
      "end_seconds": 282.14,
      "duration_seconds": 7.9,
      "text": "From what you've told me and what I found, the most likely explanation is possible bacterial meningitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.98,
      "end_seconds": 287.38,
      "duration_seconds": 3.4,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.15,
      "end_seconds": 308.19,
      "duration_seconds": 19.04,
      "text": "I can't promise yet, but most people with possible bacterial meningitis do well once it's treated properly. Stop me if I've got anything wrong. You've had a high fever for about four days, and no recent head injury or cough."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.45,
      "end_seconds": 310.15,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.11,
      "end_seconds": 315.59,
      "duration_seconds": 4.48,
      "text": "I think a lumbar puncture makes sense here, for possible meningitis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 316.46,
      "end_seconds": 318.83,
      "duration_seconds": 2.37,
      "text": "The earliest is Monday, 10 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.38,
      "end_seconds": 335.69,
      "duration_seconds": 15.31,
      "text": "I'd like you to take benzylpenicillin, 1.2 grams, once now, single dose. That's for possible meningitis. Call an ambulance now, this is an emergency. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.79,
      "end_seconds": 340.17,
      "duration_seconds": 2.38,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.86,
      "end_seconds": 351.59,
      "duration_seconds": 10.73,
      "text": "The thing that would worry me is if you cannot go now. If that happens, go to emergency. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.16,
      "end_seconds": 353.96,
      "duration_seconds": 1.8,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.14,
      "end_seconds": 357.74,
      "duration_seconds": 2.6,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.96,
      "end_seconds": 362.77,
      "duration_seconds": 3.81,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.84,
      "end_seconds": 365.02,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}