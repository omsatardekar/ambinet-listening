{
  "schema_version": "1.0",
  "encounter_id": "01143",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 4.36,
      "duration_seconds": 2.96,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.97,
      "end_seconds": 10.04,
      "duration_seconds": 4.07,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.83,
      "end_seconds": 16.4,
      "duration_seconds": 5.57,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.35,
      "end_seconds": 22.34,
      "duration_seconds": 3.99,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.89,
      "end_seconds": 29.03,
      "duration_seconds": 5.14,
      "text": "Well, I've been having a tight band around my head."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.91,
      "end_seconds": 34.77,
      "duration_seconds": 3.86,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.8,
      "end_seconds": 40.1,
      "duration_seconds": 3.3,
      "text": "It's been like this since Friday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.53,
      "end_seconds": 50.25,
      "duration_seconds": 8.72,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.28,
      "end_seconds": 54.3,
      "duration_seconds": 3.02,
      "text": "Moderate, really. Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.82,
      "end_seconds": 58.5,
      "duration_seconds": 2.68,
      "text": "Have you had a stiff neck?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.18,
      "end_seconds": 79.69,
      "duration_seconds": 20.51,
      "text": "Yes, I have. As for stiff neck, only stretching, and it's not much. I've also had tired eyes. Okay, so as for tired eyes, a five out of ten, I suppose. It's worse with screens."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.71,
      "end_seconds": 89.59,
      "duration_seconds": 7.88,
      "text": "Have you had a tight band around your head before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.5,
      "end_seconds": 96.76,
      "duration_seconds": 5.26,
      "text": "Oh, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.37,
      "end_seconds": 114.2,
      "duration_seconds": 1.83,
      "text": "Any sickness or weakness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.19,
      "end_seconds": 118.86,
      "duration_seconds": 2.67,
      "text": "Erm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.85,
      "end_seconds": 124.65,
      "duration_seconds": 4.8,
      "text": "Alright, any sensitivity to light or blurred vision at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.32,
      "end_seconds": 131.07,
      "duration_seconds": 5.75,
      "text": "No sensitivity to light or blurred vision, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.96,
      "end_seconds": 135.34,
      "duration_seconds": 2.38,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.33,
      "end_seconds": 140.1,
      "duration_seconds": 2.77,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.04,
      "end_seconds": 146.08,
      "duration_seconds": 5.04,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.06,
      "end_seconds": 150.93,
      "duration_seconds": 3.87,
      "text": "Not to my knowledge, uh, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 152.95,
      "end_seconds": 159.36,
      "duration_seconds": 6.41,
      "text": "Erm, I'm not sure that's right. I seem to recall a problem with amoxicillin."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.23,
      "end_seconds": 162.72,
      "duration_seconds": 2.49,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.67,
      "end_seconds": 168.16,
      "duration_seconds": 4.49,
      "text": "Okay, I'll note both of those. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.07,
      "end_seconds": 183.8,
      "duration_seconds": 11.73,
      "text": "It's atorvastatin, 20 milligrams, at night for my cholesterol. Sorry, I know I'm rambling a bit. Hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.36,
      "end_seconds": 188.99,
      "duration_seconds": 4.63,
      "text": "Yes, carry on. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.76,
      "end_seconds": 196.73,
      "duration_seconds": 4.97,
      "text": "Sorry, what was I saying, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.69,
      "end_seconds": 207.13,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.7,
      "end_seconds": 210.43,
      "duration_seconds": 2.73,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.05,
      "end_seconds": 216.41,
      "duration_seconds": 4.36,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.14,
      "end_seconds": 220.38,
      "duration_seconds": 2.24,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.73,
      "end_seconds": 223.24,
      "duration_seconds": 1.51,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.15,
      "end_seconds": 231.57,
      "duration_seconds": 6.42,
      "text": "I've had eczema, yes. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.93,
      "end_seconds": 238.5,
      "duration_seconds": 5.57,
      "text": "Mm, okay. Alright, eczema, that matches what I have here. Do you smoke?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.7,
      "end_seconds": 246.24,
      "duration_seconds": 3.54,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.83,
      "end_seconds": 248.02,
      "duration_seconds": 1.19,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.05,
      "end_seconds": 250.57,
      "duration_seconds": 1.52,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.58,
      "end_seconds": 256.34,
      "duration_seconds": 1.76,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.94,
      "end_seconds": 259.57,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.34,
      "end_seconds": 261.92,
      "duration_seconds": 1.58,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.45,
      "end_seconds": 266.71,
      "duration_seconds": 3.26,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.35,
      "end_seconds": 273.8,
      "duration_seconds": 3.45,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.03,
      "end_seconds": 282.77,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.14,
      "end_seconds": 299.25,
      "duration_seconds": 5.11,
      "text": "Okay: pulse 75, respiratory rate 17, BP is 119 over 79."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.83,
      "end_seconds": 302.46,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.41,
      "end_seconds": 306.72,
      "duration_seconds": 3.31,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.38,
      "end_seconds": 312.42,
      "duration_seconds": 4.04,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.38,
      "end_seconds": 315.58,
      "duration_seconds": 1.2,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.1,
      "end_seconds": 336.92,
      "duration_seconds": 5.82,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.47,
      "end_seconds": 340.09,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.03,
      "end_seconds": 359.16,
      "duration_seconds": 13.13,
      "text": "That's all I needed to check. Let me tell you where I've got to. I can't pin this down yet. We're looking at tension-type headache or eye strain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.43,
      "end_seconds": 381.36,
      "duration_seconds": 9.93,
      "text": "An eye test is what I'd like next, for eye strain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.42,
      "end_seconds": 383.49,
      "duration_seconds": 1.07,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.35,
      "end_seconds": 406.91,
      "duration_seconds": 22.56,
      "text": "Take screen breaks every hour and try regular neck stretches. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please don't wait if the headache becomes sudden and severe. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.84,
      "end_seconds": 410.45,
      "duration_seconds": 1.61,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.46,
      "end_seconds": 416.43,
      "duration_seconds": 3.97,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 418.29,
      "end_seconds": 421.53,
      "duration_seconds": 3.24,
      "text": "I think I understand everything. Thanks."
    }
  ]
}