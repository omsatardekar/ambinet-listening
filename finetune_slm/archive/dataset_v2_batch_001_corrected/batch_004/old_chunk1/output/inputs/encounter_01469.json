{
  "schema_version": "1.0",
  "encounter_id": "01469",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 4.25,
      "duration_seconds": 2.94,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.7,
      "end_seconds": 6.78,
      "duration_seconds": 1.08,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.34,
      "end_seconds": 10.29,
      "duration_seconds": 2.95,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.11,
      "end_seconds": 15.57,
      "duration_seconds": 3.46,
      "text": "I've been dealing with a runny nose."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.53,
      "end_seconds": 22.8,
      "duration_seconds": 3.27,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.4,
      "end_seconds": 27.35,
      "duration_seconds": 2.95,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.35,
      "end_seconds": 31.8,
      "duration_seconds": 3.45,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.28,
      "end_seconds": 41.73,
      "duration_seconds": 8.45,
      "text": "Pretty severe, if I'm being honest. I had a scratchy throat before. That's settled now, though."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.71,
      "end_seconds": 45.94,
      "duration_seconds": 3.23,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.76,
      "end_seconds": 51.15,
      "duration_seconds": 4.39,
      "text": "Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.7,
      "end_seconds": 54.65,
      "duration_seconds": 2.95,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.92,
      "end_seconds": 65.16,
      "duration_seconds": 9.24,
      "text": "About three months now. Omeprazole, 20 milligrams, once a day. I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.45,
      "end_seconds": 69.22,
      "duration_seconds": 2.77,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.64,
      "end_seconds": 74.29,
      "duration_seconds": 1.65,
      "text": "For two years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.88,
      "end_seconds": 93.66,
      "duration_seconds": 5.78,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.85,
      "end_seconds": 104.61,
      "duration_seconds": 9.76,
      "text": "I swim twice a week. I'm vegetarian and have been for years. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.34,
      "end_seconds": 109.63,
      "duration_seconds": 2.29,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.01,
      "end_seconds": 114.04,
      "duration_seconds": 3.03,
      "text": "Yeah, I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.36,
      "end_seconds": 116.21,
      "duration_seconds": 0.85,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.2,
      "end_seconds": 118.76,
      "duration_seconds": 1.56,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.77,
      "end_seconds": 121.63,
      "duration_seconds": 1.86,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.73,
      "end_seconds": 124.7,
      "duration_seconds": 1.97,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.74,
      "end_seconds": 139.83,
      "duration_seconds": 13.09,
      "text": "Understood. Right, so thin bones and acid reflux are already on your record. We'll keep that in mind today. Alright, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.08,
      "end_seconds": 143.53,
      "duration_seconds": 2.45,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.23,
      "end_seconds": 158.12,
      "duration_seconds": 2.89,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.59,
      "end_seconds": 162.9,
      "duration_seconds": 3.31,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.25,
      "end_seconds": 181.23,
      "duration_seconds": 4.98,
      "text": "A few quick ones: ear pain, shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.87,
      "end_seconds": 187.42,
      "duration_seconds": 4.55,
      "text": "No, no ear pain, shortness of breath or fever."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.25,
      "end_seconds": 192.77,
      "duration_seconds": 3.52,
      "text": "Have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.3,
      "end_seconds": 197.47,
      "duration_seconds": 3.17,
      "text": "I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.7,
      "end_seconds": 201.73,
      "duration_seconds": 3.03,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.77,
      "end_seconds": 208.75,
      "duration_seconds": 1.98,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.92,
      "end_seconds": 214.04,
      "duration_seconds": 4.12,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.82,
      "end_seconds": 217.16,
      "duration_seconds": 1.34,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.18,
      "end_seconds": 222.37,
      "duration_seconds": 3.19,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.16,
      "end_seconds": 233.68,
      "duration_seconds": 2.52,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.91,
      "end_seconds": 252.68,
      "duration_seconds": 6.77,
      "text": "Okay: pressure 119 over 80, temperature 36.6, heart rate 75, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.74,
      "end_seconds": 258.78,
      "duration_seconds": 4.04,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.41,
      "end_seconds": 261.04,
      "duration_seconds": 1.63,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.75,
      "end_seconds": 264.17,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.18,
      "end_seconds": 277.67,
      "duration_seconds": 4.49,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.95,
      "end_seconds": 313.78,
      "duration_seconds": 30.83,
      "text": "That's the examination finished. Having listened and examined, I'd lean towards a simple viral cold. I want to be honest that this is an impression, not a final answer. Early flu is also on my list. Rest, plenty of fluids, and paracetamol if you ache. Come back if it is not better in ten days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.13,
      "end_seconds": 319.43,
      "duration_seconds": 4.3,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}