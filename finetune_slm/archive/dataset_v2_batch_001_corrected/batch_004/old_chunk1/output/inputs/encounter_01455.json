{
  "schema_version": "1.0",
  "encounter_id": "01455",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.93,
      "duration_seconds": 3.96,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.68,
      "end_seconds": 10.93,
      "duration_seconds": 4.25,
      "text": "not at all please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.58,
      "end_seconds": 16.03,
      "duration_seconds": 4.45,
      "text": "Morning doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.71,
      "end_seconds": 19.71,
      "duration_seconds": 3.0,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.67,
      "end_seconds": 27.92,
      "duration_seconds": 6.25,
      "text": "sorry, what was I saying, we came cos of a cut on my finger"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.99,
      "end_seconds": 31.19,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.14,
      "end_seconds": 44.89,
      "duration_seconds": 8.75,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.46,
      "end_seconds": 47.8,
      "duration_seconds": 2.34,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.19,
      "end_seconds": 59.76,
      "duration_seconds": 6.57,
      "text": "A little bleeding goes along with it, most of the the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.39,
      "end_seconds": 64.53,
      "duration_seconds": 3.14,
      "text": "Did you get numbness or dirty blade?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.71,
      "end_seconds": 69.81,
      "duration_seconds": 4.1,
      "text": "no numbness or dirty blade none of it"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.24,
      "end_seconds": 75.65,
      "duration_seconds": 4.41,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.59,
      "end_seconds": 79.76,
      "duration_seconds": 2.17,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.78,
      "end_seconds": 89.72,
      "duration_seconds": 4.94,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.99,
      "end_seconds": 96.86,
      "duration_seconds": 1.87,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.73,
      "end_seconds": 101.87,
      "duration_seconds": 3.14,
      "text": "So have you been to theatre before?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.68,
      "end_seconds": 107.23,
      "duration_seconds": 4.55,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.47,
      "end_seconds": 111.15,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.27,
      "end_seconds": 120.35,
      "duration_seconds": 5.08,
      "text": "I've had high blood pressure, yes i have high cholesterol"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.22,
      "end_seconds": 123.12,
      "duration_seconds": 1.9,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.35,
      "end_seconds": 127.08,
      "duration_seconds": 2.73,
      "text": "Depression, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.92,
      "end_seconds": 133.73,
      "duration_seconds": 4.81,
      "text": "okay, I can see high blood pressure in your file as well"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.36,
      "end_seconds": 151.05,
      "duration_seconds": 2.69,
      "text": "before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.01,
      "end_seconds": 161.13,
      "duration_seconds": 9.12,
      "text": "yes, milk. I've no idea what the reaction was, only that I'm not supposed to have it"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.56,
      "end_seconds": 175.14,
      "duration_seconds": 2.58,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.53,
      "end_seconds": 182.1,
      "duration_seconds": 5.57,
      "text": "I'm on something called simv... simvastatin 20 milligrams maybe at night"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.8,
      "end_seconds": 187.6,
      "duration_seconds": 4.8,
      "text": "Alright, did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.56,
      "end_seconds": 194.02,
      "duration_seconds": 4.46,
      "text": "not with me. I'll bring it next time"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.0,
      "end_seconds": 203.58,
      "duration_seconds": 5.58,
      "text": "Tell me about your routine, work, habits, that that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.94,
      "end_seconds": 223.88,
      "duration_seconds": 15.94,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. I hardly move around during the day. I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.08,
      "end_seconds": 229.33,
      "duration_seconds": 4.25,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.15,
      "end_seconds": 231.85,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.84,
      "end_seconds": 235.98,
      "duration_seconds": 2.14,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.61,
      "end_seconds": 257.46,
      "duration_seconds": 5.85,
      "text": "It's a clean shallow cut, no longer bleeding, and the the finger moves normally."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.98,
      "end_seconds": 259.68,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.17,
      "end_seconds": 267.06,
      "duration_seconds": 1.89,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.96,
      "end_seconds": 282.88,
      "duration_seconds": 7.92,
      "text": "Right, here's what I'm thinking. This looks most like a minor clean wound that needs only dressing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.87,
      "end_seconds": 286.23,
      "duration_seconds": 1.36,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.61,
      "end_seconds": 317.71,
      "duration_seconds": 26.1,
      "text": "I understand the worry. At the moment I'd say it's a minor clean wound that needs only dressing and we'll watch how it goes. I'll close it with adhesive strips and keep it dry for two days. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.42,
      "end_seconds": 323.16,
      "duration_seconds": 3.74,
      "text": "Okay, that that makes sense. Thanks for explaining."
    }
  ]
}