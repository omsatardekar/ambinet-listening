{
  "schema_version": "1.0",
  "encounter_id": "01353",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.37,
      "end_seconds": 3.0,
      "duration_seconds": 1.63,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.91,
      "end_seconds": 5.96,
      "duration_seconds": 1.05,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.53,
      "end_seconds": 8.72,
      "duration_seconds": 1.19,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.44,
      "end_seconds": 15.35,
      "duration_seconds": 4.91,
      "text": "Mainly I've been feeling faint. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.85,
      "end_seconds": 17.7,
      "duration_seconds": 1.85,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.43,
      "end_seconds": 25.81,
      "duration_seconds": 6.38,
      "text": "Three days, I think... sorry, ten days, I got that wrong."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.86,
      "end_seconds": 31.12,
      "duration_seconds": 3.26,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.28,
      "end_seconds": 33.2,
      "duration_seconds": 0.92,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.39,
      "end_seconds": 37.01,
      "duration_seconds": 2.62,
      "text": "Alright, what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.44,
      "end_seconds": 41.21,
      "duration_seconds": 2.77,
      "text": "I notice it more with standing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.76,
      "end_seconds": 47.01,
      "duration_seconds": 2.25,
      "text": "Any vomiting blood as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.65,
      "end_seconds": 54.43,
      "duration_seconds": 6.78,
      "text": "Yes, for about two weeks. With vomiting blood, it just comes and goes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.31,
      "end_seconds": 59.55,
      "duration_seconds": 3.24,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 71.95,
      "duration_seconds": 2.85,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.99,
      "end_seconds": 98.73,
      "duration_seconds": 5.74,
      "text": "Okay: pulse 113, BP is 126 over 85, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.59,
      "end_seconds": 102.05,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.84,
      "end_seconds": 105.75,
      "duration_seconds": 2.91,
      "text": "Right, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.37,
      "end_seconds": 109.65,
      "duration_seconds": 2.28,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.55,
      "end_seconds": 112.64,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.96,
      "end_seconds": 131.48,
      "duration_seconds": 7.52,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.36,
      "end_seconds": 136.17,
      "duration_seconds": 1.81,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.08,
      "end_seconds": 156.2,
      "duration_seconds": 3.12,
      "text": "Have you noticed fever or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.64,
      "end_seconds": 160.24,
      "duration_seconds": 2.6,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.39,
      "end_seconds": 163.38,
      "duration_seconds": 1.99,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.12,
      "end_seconds": 167.65,
      "duration_seconds": 3.53,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.53,
      "end_seconds": 174.4,
      "duration_seconds": 2.87,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.8,
      "end_seconds": 178.14,
      "duration_seconds": 2.34,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.93,
      "end_seconds": 188.41,
      "duration_seconds": 2.48,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.41,
      "end_seconds": 192.18,
      "duration_seconds": 2.77,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.39,
      "end_seconds": 193.09,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.4,
      "end_seconds": 200.71,
      "duration_seconds": 3.31,
      "text": "It's ibuprofen, three times a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.46,
      "end_seconds": 203.68,
      "duration_seconds": 2.22,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.76,
      "end_seconds": 206.71,
      "duration_seconds": 0.95,
      "text": "400 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.45,
      "end_seconds": 211.44,
      "duration_seconds": 2.99,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.4,
      "end_seconds": 215.61,
      "duration_seconds": 3.21,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.82,
      "end_seconds": 219.13,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.63,
      "end_seconds": 227.67,
      "duration_seconds": 4.04,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.21,
      "end_seconds": 234.51,
      "duration_seconds": 5.3,
      "text": "Alright, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.55,
      "end_seconds": 237.68,
      "duration_seconds": 2.13,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.37,
      "end_seconds": 247.67,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.17,
      "end_seconds": 251.23,
      "duration_seconds": 2.06,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.67,
      "end_seconds": 255.01,
      "duration_seconds": 2.34,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.77,
      "end_seconds": 264.57,
      "duration_seconds": 5.8,
      "text": "Yes, COPD. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.18,
      "end_seconds": 275.94,
      "duration_seconds": 3.76,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.73,
      "end_seconds": 278.68,
      "duration_seconds": 1.95,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.04,
      "end_seconds": 292.5,
      "duration_seconds": 12.46,
      "text": "Taking everything into account, I don't have a clear answer today: a possible bleeding stomach ulcer is possible, and so is a bleed from the gullet."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.12,
      "end_seconds": 295.96,
      "duration_seconds": 1.84,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.01,
      "end_seconds": 312.86,
      "duration_seconds": 15.85,
      "text": "I understand the worry. At the moment I'd say it's a possible bleeding stomach ulcer, and we'll know more once the urgent blood tests is back. I'm sending you for urgent blood tests because of bleeding."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.37,
      "end_seconds": 316.91,
      "duration_seconds": 2.54,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.04,
      "end_seconds": 333.21,
      "duration_seconds": 15.17,
      "text": "Please stop the ibuprofen and do not eat or drink. If it hasn't settled in two weeks, we'd think about an endoscopy, but not now. Book a review straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.08,
      "end_seconds": 337.61,
      "duration_seconds": 3.53,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}