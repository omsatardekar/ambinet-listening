{
  "schema_version": "1.0",
  "encounter_id": "01091",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 2.22,
      "duration_seconds": 1.58,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.05,
      "end_seconds": 7.55,
      "duration_seconds": 4.5,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.84,
      "end_seconds": 15.73,
      "duration_seconds": 6.89,
      "text": "Well, um, hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.79,
      "end_seconds": 20.4,
      "duration_seconds": 2.61,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.89,
      "end_seconds": 27.35,
      "duration_seconds": 5.46,
      "text": "Doctor, it's a muffled voice. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.26,
      "end_seconds": 29.52,
      "duration_seconds": 1.26,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.54,
      "end_seconds": 34.13,
      "duration_seconds": 2.59,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.06,
      "end_seconds": 41.58,
      "duration_seconds": 5.52,
      "text": "I mean, I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.45,
      "end_seconds": 49.96,
      "duration_seconds": 4.51,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.09,
      "end_seconds": 53.04,
      "duration_seconds": 1.95,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.78,
      "end_seconds": 57.11,
      "duration_seconds": 3.33,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.36,
      "end_seconds": 60.22,
      "duration_seconds": 1.86,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.79,
      "end_seconds": 68.57,
      "duration_seconds": 2.78,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.57,
      "end_seconds": 78.1,
      "duration_seconds": 8.53,
      "text": "It usually comes with drooling. And there's difficulty swallowing as well, you know, about a month now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.16,
      "end_seconds": 82.28,
      "duration_seconds": 3.12,
      "text": "Have you had a severe sore throat?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.05,
      "end_seconds": 84.84,
      "duration_seconds": 1.79,
      "text": "Yes, since Monday."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.86,
      "end_seconds": 103.85,
      "duration_seconds": 2.99,
      "text": "Okay, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.37,
      "end_seconds": 118.99,
      "duration_seconds": 14.62,
      "text": "I have about eight cigarettes in a day. Yes, I work in a bakery, early starts. My husband and I live above the shop. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.07,
      "end_seconds": 123.01,
      "duration_seconds": 2.94,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.89,
      "end_seconds": 127.93,
      "duration_seconds": 3.04,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.45,
      "end_seconds": 132.13,
      "duration_seconds": 3.68,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.62,
      "end_seconds": 142.27,
      "duration_seconds": 5.65,
      "text": "I mean, um, I've had migraines for about a year now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.78,
      "end_seconds": 149.17,
      "duration_seconds": 6.39,
      "text": "Okay, yes, migraines is known to us, good to have that clear. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 153.38,
      "duration_seconds": 3.25,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.35,
      "end_seconds": 158.87,
      "duration_seconds": 3.52,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.38,
      "end_seconds": 163.7,
      "duration_seconds": 3.32,
      "text": "Oh, I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.33,
      "end_seconds": 167.94,
      "duration_seconds": 2.61,
      "text": "Have you noticed cough or rash?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.73,
      "end_seconds": 172.23,
      "duration_seconds": 3.5,
      "text": "No, you know, no cough or rash."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.09,
      "end_seconds": 176.05,
      "duration_seconds": 2.96,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.95,
      "end_seconds": 179.84,
      "duration_seconds": 2.89,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.96,
      "end_seconds": 183.42,
      "duration_seconds": 2.46,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.27,
      "end_seconds": 199.23,
      "duration_seconds": 2.96,
      "text": "Okay, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.72,
      "end_seconds": 221.25,
      "duration_seconds": 8.53,
      "text": "Okay: respiratory rate 22, blood pressure 130 over 78, heart rate 102, SpO2 91 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 226.46,
      "duration_seconds": 3.95,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.76,
      "end_seconds": 229.89,
      "duration_seconds": 2.13,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.36,
      "end_seconds": 245.19,
      "duration_seconds": 4.83,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.68,
      "end_seconds": 252.75,
      "duration_seconds": 2.07,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.37,
      "end_seconds": 286.74,
      "duration_seconds": 18.37,
      "text": "Let me tell you where I've got to. The most likely explanation is a possible airway infection that needs emergency care. That's my thinking for now, and it may change as we learn more. I'd also keep severe tonsillitis in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.51,
      "end_seconds": 291.22,
      "duration_seconds": 2.71,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.75,
      "end_seconds": 329.97,
      "duration_seconds": 37.22,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible airway infection that needs emergency care, but I'd like to confirm. I'd like to arrange an urgent airway assessment for stridor and drooling. Do not lie flat, I am calling an ambulance now. The emergency ENT team would be the right next step, I'll refer you. We'll catch up straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.01,
      "end_seconds": 334.13,
      "duration_seconds": 2.12,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.21,
      "end_seconds": 337.12,
      "duration_seconds": 1.91,
      "text": "Right, see you soon."
    }
  ]
}