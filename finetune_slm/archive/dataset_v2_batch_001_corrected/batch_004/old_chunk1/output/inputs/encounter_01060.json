{
  "schema_version": "1.0",
  "encounter_id": "01060",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 6.36,
      "duration_seconds": 5.58,
      "text": "Doctor? Hello, uh, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.7,
      "end_seconds": 11.94,
      "duration_seconds": 4.24,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.28,
      "end_seconds": 19.12,
      "duration_seconds": 5.84,
      "text": "Um, so... burning when I pass urine. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.13,
      "end_seconds": 26.29,
      "duration_seconds": 6.16,
      "text": "Alright, what's on your current medicine list? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.49,
      "end_seconds": 33.23,
      "duration_seconds": 5.74,
      "text": "Oh, I'm on sodium valproate, twice a day for the fits."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.81,
      "end_seconds": 37.46,
      "duration_seconds": 2.65,
      "text": "Okay, do you know the dose?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.14,
      "end_seconds": 51.39,
      "duration_seconds": 12.25,
      "text": "500 milligrams, I think that's what's on the box. I'm on losartan, 50 milligrams, once a day. I take cranberry juice, daily."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.72,
      "end_seconds": 69.14,
      "duration_seconds": 3.42,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.11,
      "end_seconds": 71.69,
      "duration_seconds": 1.58,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.42,
      "end_seconds": 80.9,
      "duration_seconds": 8.48,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.24,
      "end_seconds": 94.15,
      "duration_seconds": 11.91,
      "text": "I'd say on and off. Drinking water helps a bit. And I've been going to the toilet often as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 96.61,
      "duration_seconds": 1.43,
      "text": "Any vaginal discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.01,
      "end_seconds": 102.76,
      "duration_seconds": 4.75,
      "text": "Okay, so not at all, no vaginal discharge."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 108.25,
      "duration_seconds": 4.46,
      "text": "Did you get back pain, fever or blood in the urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.18,
      "end_seconds": 118.02,
      "duration_seconds": 7.84,
      "text": "Well, I haven't had back pain, fever or blood in the urine, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.03,
      "end_seconds": 122.59,
      "duration_seconds": 2.56,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.39,
      "end_seconds": 125.41,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.28,
      "end_seconds": 130.62,
      "duration_seconds": 4.34,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.2,
      "end_seconds": 150.56,
      "duration_seconds": 19.36,
      "text": "Mm, uh, I've had epilepsy for about a year now. My family kept telling me to get it checked. I told my wife I'd come today. Right, I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.47,
      "end_seconds": 159.45,
      "duration_seconds": 7.98,
      "text": "Yes, epilepsy and high blood pressure are known to us, good to have that clear. Do you smoke?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.52,
      "end_seconds": 165.4,
      "duration_seconds": 3.88,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.06,
      "end_seconds": 169.49,
      "duration_seconds": 2.43,
      "text": "Okay, who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.89,
      "end_seconds": 173.68,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.65,
      "end_seconds": 178.55,
      "duration_seconds": 2.9,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.23,
      "end_seconds": 183.84,
      "duration_seconds": 4.61,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.94,
      "end_seconds": 187.28,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.8,
      "end_seconds": 192.31,
      "duration_seconds": 3.51,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.87,
      "end_seconds": 200.21,
      "duration_seconds": 4.34,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.65,
      "end_seconds": 211.42,
      "duration_seconds": 9.77,
      "text": "So, you know, I was told I'm allergic to tramadol, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.78,
      "end_seconds": 231.41,
      "duration_seconds": 3.63,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.97,
      "end_seconds": 246.86,
      "duration_seconds": 2.89,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 279.36,
      "duration_seconds": 10.64,
      "text": "Okay: pulse 73, temperature is 36.5 degrees, BMI works out to 22.0. And height 158 centimetres, weight 55 kilos, BP is 128 over 79."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.79,
      "end_seconds": 283.12,
      "duration_seconds": 2.33,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.82,
      "end_seconds": 287.64,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.05,
      "end_seconds": 306.74,
      "duration_seconds": 5.69,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.03,
      "end_seconds": 313.21,
      "duration_seconds": 2.18,
      "text": "So, that's the examination finished."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.72,
      "end_seconds": 352.11,
      "duration_seconds": 31.39,
      "text": "Taking everything into account, this looks most like an uncomplicated urinary infection. I can't rule out vaginal irritation yet. Let's get a urine dipstick, for burning urine. We'll begin with nitrofurantoin, 100 milligrams, twice a day, three days. That's for urinary infection. It's a commonly used medicine and most people tolerate it well. Drink plenty of water and avoid holding urine. If you get a fever or back pain, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.41,
      "end_seconds": 361.32,
      "duration_seconds": 3.91,
      "text": "So, you know, that's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.9,
      "end_seconds": 372.67,
      "duration_seconds": 9.77,
      "text": "Let's plan a check if it is not better in three days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.69,
      "end_seconds": 379.07,
      "duration_seconds": 5.38,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}