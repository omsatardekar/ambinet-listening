{
  "schema_version": "1.0",
  "encounter_id": "01330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.26,
      "duration_seconds": 4.28,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 11.51,
      "duration_seconds": 5.26,
      "text": "right, yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.18,
      "end_seconds": 19.06,
      "duration_seconds": 5.88,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.46,
      "end_seconds": 22.87,
      "duration_seconds": 2.41,
      "text": "It's crushing chest pain, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.62,
      "end_seconds": 28.46,
      "duration_seconds": 3.84,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.41,
      "end_seconds": 32.56,
      "duration_seconds": 3.15,
      "text": "Ever since... since last weekend, really."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.54,
      "end_seconds": 38.11,
      "duration_seconds": 3.57,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.64,
      "end_seconds": 45.88,
      "duration_seconds": 6.24,
      "text": "well, it's... hard to say, it's kind of.. i don't know—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.15,
      "end_seconds": 53.35,
      "duration_seconds": 6.2,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.38,
      "end_seconds": 55.42,
      "duration_seconds": 1.04,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.18,
      "end_seconds": 63.59,
      "duration_seconds": 7.41,
      "text": "and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 63.69,
      "end_seconds": 69.67,
      "duration_seconds": 5.98,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.59,
      "end_seconds": 73.51,
      "duration_seconds": 2.92,
      "text": "Oh, I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.05,
      "end_seconds": 79.38,
      "duration_seconds": 4.33,
      "text": "Have you had pain going into your left arm?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.19,
      "end_seconds": 87.12,
      "duration_seconds": 2.93,
      "text": "yes, you know, for two days"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.13,
      "end_seconds": 95.05,
      "duration_seconds": 5.92,
      "text": "Have you had crushing chest pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.03,
      "end_seconds": 101.31,
      "duration_seconds": 5.28,
      "text": "a bit, last year it settled by itself back then"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.28,
      "end_seconds": 120.81,
      "duration_seconds": 3.53,
      "text": "so, any cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.58,
      "end_seconds": 135.89,
      "duration_seconds": 14.31,
      "text": "sorry, what was I saying, no, no cough, no leg swelling, no fever i was sweating at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.26,
      "end_seconds": 139.22,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.27,
      "end_seconds": 142.36,
      "duration_seconds": 1.09,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.19,
      "end_seconds": 146.88,
      "duration_seconds": 3.69,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.44,
      "end_seconds": 150.85,
      "duration_seconds": 2.41,
      "text": "no, nothing like that that"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.87,
      "end_seconds": 156.33,
      "duration_seconds": 4.46,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.08,
      "end_seconds": 168.05,
      "duration_seconds": 9.97,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.62,
      "end_seconds": 171.67,
      "duration_seconds": 3.05,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.68,
      "end_seconds": 178.37,
      "duration_seconds": 5.69,
      "text": "yes, I had two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.77,
      "end_seconds": 180.97,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.98,
      "end_seconds": 187.67,
      "duration_seconds": 2.69,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.35,
      "end_seconds": 191.61,
      "duration_seconds": 2.26,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.57,
      "end_seconds": 201.13,
      "duration_seconds": 7.56,
      "text": "I've had high blood pressure, yes. I have high cholesterol. Right, I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.19,
      "end_seconds": 204.51,
      "duration_seconds": 1.32,
      "text": "So, anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.12,
      "end_seconds": 213.5,
      "duration_seconds": 7.38,
      "text": "I've had an enlarged prostate for five years now. I have heart disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.04,
      "end_seconds": 223.59,
      "duration_seconds": 9.55,
      "text": "Right, right. Right, yes, high cholesterol is known to us, good to have that clear. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.2,
      "end_seconds": 239.34,
      "duration_seconds": 15.14,
      "text": "Amlodipine, 5 milligrams, once a day. I wasn't sure whether to come in at all, to be honest. I've been putting this off for weeks. It's simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 241.86,
      "end_seconds": 248.55,
      "duration_seconds": 6.69,
      "text": "He is supposed to take it at night, but I can't say he always does."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.14,
      "end_seconds": 263.33,
      "duration_seconds": 14.19,
      "text": "I take tamsulosin, 0.4 milligrams, at night. I'm on aspirin, 75 milligrams, once a day. I'd been on valsartan, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 266.76,
      "end_seconds": 278.37,
      "duration_seconds": 11.61,
      "text": "Doctor, I've got the readings for you. Weight 94 kilos, pulse is 105 beats a minute. Height 181 centimetres, pressure 124 over 83, BMI works out to 28.7."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.15,
      "end_seconds": 280.85,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.53,
      "end_seconds": 287.8,
      "duration_seconds": 4.27,
      "text": "Right, let's have a a proper look at you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.16,
      "end_seconds": 290.74,
      "duration_seconds": 1.58,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.96,
      "end_seconds": 305.5,
      "duration_seconds": 4.54,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.27,
      "end_seconds": 311.28,
      "duration_seconds": 2.01,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.07,
      "end_seconds": 339.27,
      "duration_seconds": 16.2,
      "text": "right, here's what I'm thinking the most likely explanation is a possible heart attack i want to be honest that this is an impression, not a final answer. Unstable angina is still possible"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.96,
      "end_seconds": 345.82,
      "duration_seconds": 2.86,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.61,
      "end_seconds": 367.64,
      "duration_seconds": 19.03,
      "text": "I can't promise yet, but most people with a possible heart attack do well once it's treated properly. Let's get a troponin blood test, for chest pain. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 371.15,
      "end_seconds": 373.93,
      "duration_seconds": 2.78,
      "text": "The earliest is Tuesday, 9 am."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.72,
      "end_seconds": 378.69,
      "duration_seconds": 0.97,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.26,
      "end_seconds": 383.45,
      "duration_seconds": 4.19,
      "text": "An ECG is what I'd like next, for chest pain."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.74,
      "end_seconds": 389.87,
      "duration_seconds": 2.13,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.91,
      "end_seconds": 407.36,
      "duration_seconds": 15.45,
      "text": "Stay lying down and do not eat or drink. I'm going to send a referral to the cardiac team. The thing that would worry me is if the pain returns. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.15,
      "end_seconds": 410.4,
      "duration_seconds": 2.25,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.98,
      "end_seconds": 417.5,
      "duration_seconds": 5.52,
      "text": "Book a review straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.07,
      "end_seconds": 424.93,
      "duration_seconds": 3.86,
      "text": "No, that's all. Thanks a a lot."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.01,
      "end_seconds": 428.39,
      "duration_seconds": 1.38,
      "text": "Goodbye for now."
    }
  ]
}