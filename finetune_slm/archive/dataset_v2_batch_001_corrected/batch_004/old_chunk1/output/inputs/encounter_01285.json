  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 3.02,
      "duration_seconds": 2.05,
      "text": "morning, come on through"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.34,
      "end_seconds": 7.65,
      "duration_seconds": 3.31,
      "text": "hello i hope I'm not late"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.52,
      "end_seconds": 12.27,
      "duration_seconds": 3.75,
      "text": "is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.2,
      "end_seconds": 20.17,
      "duration_seconds": 5.97,
      "text": "Mm, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.97,
      "end_seconds": 24.65,
      "duration_seconds": 2.68,
      "text": "how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 35.08,
      "duration_seconds": 8.91,
      "text": "honestly, um, it's shaking chills and a high temperature, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.47,
      "end_seconds": 37.78,
      "duration_seconds": 1.31,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.36,
      "end_seconds": 48.37,
      "duration_seconds": 7.01,
      "text": "Right you know I'd say three weeks. Actually no closer to four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.3,
      "end_seconds": 52.19,
      "duration_seconds": 1.89,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.63,
      "end_seconds": 57.15,
      "duration_seconds": 3.52,
      "text": "It settles a a little with blankets."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.41,
      "end_seconds": 63.53,
      "duration_seconds": 5.12,
      "text": "alright, have you had any stiff neck, rash or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.13,
      "end_seconds": 67.62,
      "duration_seconds": 2.49,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.34,
      "end_seconds": 71.12,
      "duration_seconds": 2.78,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.38,
      "end_seconds": 73.96,
      "duration_seconds": 1.58,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.26,
      "end_seconds": 87.95,
      "duration_seconds": 3.69,
      "text": "let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.2,
      "end_seconds": 91.93,
      "duration_seconds": 2.73,
      "text": "not to my knowledge no"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.25,
      "end_seconds": 95.31,
      "duration_seconds": 2.06,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.58,
      "end_seconds": 98.39,
      "duration_seconds": 1.81,
      "text": "No uh none."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.01,
      "end_seconds": 111.92,
      "duration_seconds": 4.91,
      "text": "okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.9,
      "end_seconds": 115.94,
      "duration_seconds": 3.04,
      "text": "No nothing I can think of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.59,
      "end_seconds": 128.67,
      "duration_seconds": 2.08,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.44,
      "end_seconds": 133.24,
      "duration_seconds": 3.8,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.07,
      "end_seconds": 135.25,
      "duration_seconds": 1.18,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.56,
      "end_seconds": 140.51,
      "duration_seconds": 3.95,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.31,
      "end_seconds": 155.61,
      "duration_seconds": 3.3,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.55,
      "end_seconds": 168.42,
      "duration_seconds": 2.87,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 197.47,
      "duration_seconds": 8.67,
      "text": "Okay: heart rate 89, temperature 38.9, respiratory rate 19, SpO2 98 percent on room air, blood pressure 115 over 66."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.39,
      "end_seconds": 200.83,
      "duration_seconds": 1.44,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.49,
      "end_seconds": 205.39,
      "duration_seconds": 2.9,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.71,
      "end_seconds": 211.1,
      "duration_seconds": 4.39,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.94,
      "end_seconds": 214.3,
      "duration_seconds": 2.36,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.61,
      "end_seconds": 238.38,
      "duration_seconds": 7.77,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.97,
      "end_seconds": 257.48,
      "duration_seconds": 16.51,
      "text": "good, you can sit up again. From what you've told me and what I found, it's hard to say. Possible sepsis needing urgent treatment is one possibility and a severe urine or chest infection another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.46,
      "end_seconds": 261.22,
      "duration_seconds": 2.76,
      "text": "Well, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.94,
      "end_seconds": 292.24,
      "duration_seconds": 29.3,
      "text": "I can't promise yet, but most people with possible sepsis needing urgent treatment do well once it's treated properly i'm going to order a chest X-ray, for fever let's get blood cultures, for fever with low blood pressure i want to to admit you to hospital now for fluids and antibiotics i'd like you to see the emergency team as well, and I'll write the referral"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.85,
      "end_seconds": 296.25,
      "duration_seconds": 3.4,
      "text": "actually, sure, where do I go?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.45,
      "end_seconds": 306.65,
      "duration_seconds": 9.2,
      "text": "the thing that would worry me is if you cannot be brought in today if that happens, go to emergency"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.24,
      "end_seconds": 308.64,
      "duration_seconds": 1.4,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.5,
      "end_seconds": 311.96,
      "duration_seconds": 2.46,
      "text": "I'd like you back straight away"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.9,
      "end_seconds": 317.5,
      "duration_seconds": 3.6,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.22,
      "end_seconds": 324.63,
      "duration_seconds": 6.41,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.15,
      "end_seconds": 331.47,
      "duration_seconds": 5.32,
      "text": "so you know I come back straight away is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.55,
      "end_seconds": 336.22,
      "duration_seconds": 3.67,
      "text": "yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.39,
      "end_seconds": 339.1,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.68,
      "end_seconds": 340.98,
      "duration_seconds": 1.3,
      "text": "take care now"
    }
  ]
