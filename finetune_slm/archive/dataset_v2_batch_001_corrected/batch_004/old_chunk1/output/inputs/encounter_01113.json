{
  "schema_version": "1.0",
  "encounter_id": "01113",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 4.66,
      "duration_seconds": 3.64,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.13,
      "end_seconds": 10.57,
      "duration_seconds": 4.44,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 14.66,
      "duration_seconds": 2.0,
      "text": "I've been feeling well"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.72,
      "end_seconds": 18.28,
      "duration_seconds": 2.56,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.65,
      "end_seconds": 27.44,
      "duration_seconds": 2.79,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.98,
      "end_seconds": 53.61,
      "duration_seconds": 7.63,
      "text": "Okay: temp 36.6 degrees, pressure 116 over 68. And SpO2 99 percent on room air, pulse 71."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.55,
      "end_seconds": 56.22,
      "duration_seconds": 1.67,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.82,
      "end_seconds": 64.41,
      "duration_seconds": 7.59,
      "text": "So, I'll explain what these mean in a moment. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.08,
      "end_seconds": 69.31,
      "duration_seconds": 3.23,
      "text": "erm, for two months, I'd say"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.58,
      "end_seconds": 72.32,
      "duration_seconds": 2.74,
      "text": "Yes. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.39,
      "end_seconds": 83.14,
      "duration_seconds": 9.75,
      "text": "Slightly dry skin goes along with it, most of the time the Slightly dry skin? That's been for five days"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.22,
      "end_seconds": 91.1,
      "duration_seconds": 6.88,
      "text": "let me check a few things any constipation, feeling cold, palpitations or weight change?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.7,
      "end_seconds": 95.04,
      "duration_seconds": 3.34,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.44,
      "end_seconds": 100.59,
      "duration_seconds": 4.15,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.77,
      "end_seconds": 106.29,
      "duration_seconds": 1.52,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.28,
      "end_seconds": 110.08,
      "duration_seconds": 2.8,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.0,
      "end_seconds": 120.35,
      "duration_seconds": 9.35,
      "text": "I've had an underactive thyroid, yes. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.36,
      "end_seconds": 130.27,
      "duration_seconds": 7.91,
      "text": "Okay, I can see an underactive thyroid in your file as well. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.38,
      "end_seconds": 137.44,
      "duration_seconds": 6.06,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.36,
      "end_seconds": 142.81,
      "duration_seconds": 4.45,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.5,
      "end_seconds": 151.94,
      "duration_seconds": 4.44,
      "text": "Naproxen. I come out in... well, stomach pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.95,
      "end_seconds": 169.1,
      "duration_seconds": 5.15,
      "text": "Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.4,
      "end_seconds": 172.98,
      "duration_seconds": 2.58,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.3,
      "end_seconds": 193.21,
      "duration_seconds": 1.91,
      "text": "have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.72,
      "end_seconds": 198.21,
      "duration_seconds": 4.49,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.01,
      "end_seconds": 201.42,
      "duration_seconds": 2.41,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.32,
      "end_seconds": 209.62,
      "duration_seconds": 3.3,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.53,
      "end_seconds": 213.68,
      "duration_seconds": 2.15,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.74,
      "end_seconds": 218.93,
      "duration_seconds": 4.19,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.43,
      "end_seconds": 223.72,
      "duration_seconds": 3.29,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.44,
      "end_seconds": 229.26,
      "duration_seconds": 4.82,
      "text": "It's thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.08,
      "end_seconds": 234.66,
      "duration_seconds": 2.58,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.38,
      "end_seconds": 238.43,
      "duration_seconds": 2.05,
      "text": "tell me if that's sore"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.34,
      "end_seconds": 254.24,
      "duration_seconds": 4.9,
      "text": "your pulse is steady and your thyroid feels normal in size"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.16,
      "end_seconds": 262.63,
      "duration_seconds": 2.47,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.29,
      "end_seconds": 279.94,
      "duration_seconds": 7.65,
      "text": "so, based on the history and the examination, the most likely explanation is well-controlled thyroid replacement"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.74,
      "end_seconds": 323.49,
      "duration_seconds": 27.75,
      "text": "I want a thyroid blood test done, that's for annual review keep taking the tablet on an empty stomach, apart from coffee if you notice palpitations or weight change, or you feel really unwell, please come to the emergency department i'll want another look in twelve months that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.09,
      "end_seconds": 328.61,
      "duration_seconds": 3.52,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}