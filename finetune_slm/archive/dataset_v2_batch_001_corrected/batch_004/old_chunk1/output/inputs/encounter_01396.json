{
  "schema_version": "1.0",
  "encounter_id": "01396",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 7.1,
      "duration_seconds": 5.98,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.75,
      "end_seconds": 12.43,
      "duration_seconds": 3.68,
      "text": "yes, have a seat. Tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.3,
      "end_seconds": 30.44,
      "duration_seconds": 16.14,
      "text": "Ah, uh, it's sudden shortness of breath. I thought I'd wait, but it hasn't gone. I've been putting this off for weeks. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.44,
      "end_seconds": 35.09,
      "duration_seconds": 3.65,
      "text": "What's the the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.01,
      "end_seconds": 39.73,
      "duration_seconds": 2.72,
      "text": "I've had it for six months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.25,
      "end_seconds": 42.54,
      "duration_seconds": 2.29,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.01,
      "end_seconds": 59.75,
      "duration_seconds": 15.74,
      "text": "It's all the time. Right, um, and and a swollen painful calf as well, since last weekend. Uh, I'd been coughing up a little blood, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.52,
      "end_seconds": 65.86,
      "duration_seconds": 4.34,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.15,
      "end_seconds": 72.39,
      "duration_seconds": 5.24,
      "text": "Acid reflux, for two years. I have asthma, for two years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.55,
      "end_seconds": 80.17,
      "duration_seconds": 6.62,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.37,
      "end_seconds": 89.56,
      "duration_seconds": 1.19,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.17,
      "end_seconds": 93.63,
      "duration_seconds": 2.46,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.27,
      "end_seconds": 96.15,
      "duration_seconds": 1.88,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.82,
      "end_seconds": 103.09,
      "duration_seconds": 2.27,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.84,
      "end_seconds": 106.76,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.78,
      "end_seconds": 113.23,
      "duration_seconds": 4.45,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 115.94,
      "duration_seconds": 2.14,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 120.66,
      "duration_seconds": 3.89,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.57,
      "end_seconds": 124.85,
      "duration_seconds": 2.28,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.54,
      "end_seconds": 136.32,
      "duration_seconds": 7.78,
      "text": "Sorry, what was I saying, I take pantoprazole, 40 milligrams, before breakfast. Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.55,
      "end_seconds": 141.4,
      "duration_seconds": 3.85,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.28,
      "end_seconds": 149.49,
      "duration_seconds": 7.21,
      "text": "Not currently, uh, but as a youngster erythromycin gave me a rash."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.34,
      "end_seconds": 151.74,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.6,
      "end_seconds": 157.04,
      "duration_seconds": 3.44,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.81,
      "end_seconds": 164.83,
      "duration_seconds": 6.02,
      "text": "Let me check a few things. Any chest tightness, fever or wheeze?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.63,
      "end_seconds": 173.45,
      "duration_seconds": 6.82,
      "text": "Let me think, no chest tightness, fever or wheeze, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.88,
      "end_seconds": 178.83,
      "duration_seconds": 3.95,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.86,
      "end_seconds": 181.41,
      "duration_seconds": 1.55,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.85,
      "end_seconds": 194.69,
      "duration_seconds": 2.84,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.48,
      "end_seconds": 207.91,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.26,
      "end_seconds": 237.57,
      "duration_seconds": 9.31,
      "text": "Okay: pressure 142 over 79, respiratory rate 23. And temperature is 37.3 degrees, oxygen saturation is 91 percent, pulse 97."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.39,
      "end_seconds": 241.43,
      "duration_seconds": 3.04,
      "text": "mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.55,
      "end_seconds": 246.9,
      "duration_seconds": 4.35,
      "text": "So, don't worry, we'll discuss it it in a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.9,
      "end_seconds": 272.41,
      "duration_seconds": 16.51,
      "text": "listening to the whole story, this is probably a possible blood clot in the lung a chest infection is still possible we should do a D-dimer blood test for possible clot you need to go to hospital now for a scan"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.45,
      "end_seconds": 282.61,
      "duration_seconds": 8.16,
      "text": "Uh, could I get a CT scan of the chest done? A friend had it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.68,
      "end_seconds": 297.04,
      "duration_seconds": 12.36,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. I'll want another look straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.47,
      "end_seconds": 303.24,
      "duration_seconds": 4.77,
      "text": "I mean, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.88,
      "end_seconds": 305.18,
      "duration_seconds": 1.3,
      "text": "look after yourself"
    }
  ]
}