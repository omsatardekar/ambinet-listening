{
  "schema_version": "1.0",
  "encounter_id": "01478",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 6.5,
      "duration_seconds": 5.5,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 11.26,
      "duration_seconds": 3.79,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.51,
      "end_seconds": 21.1,
      "duration_seconds": 8.59,
      "text": "Honestly, it's sharp pain low on one side, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.02,
      "end_seconds": 25.97,
      "duration_seconds": 2.95,
      "text": "So, any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.94,
      "end_seconds": 31.58,
      "duration_seconds": 4.64,
      "text": "well, you know, no, I'm not on anything"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.89,
      "end_seconds": 34.33,
      "duration_seconds": 1.44,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.98,
      "end_seconds": 38.43,
      "duration_seconds": 3.45,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.98,
      "end_seconds": 48.8,
      "duration_seconds": 9.82,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.35,
      "end_seconds": 55.17,
      "duration_seconds": 5.82,
      "text": "a five out of ten, I suppose. Honestly, on and off"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.17,
      "end_seconds": 59.45,
      "duration_seconds": 3.28,
      "text": "Okay, has there been light vaginal bleeding too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.45,
      "end_seconds": 64.32,
      "duration_seconds": 2.87,
      "text": "Yeah. About three months, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.08,
      "end_seconds": 73.24,
      "duration_seconds": 3.16,
      "text": "Any fever or vaginal discharge at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.88,
      "end_seconds": 77.87,
      "duration_seconds": 3.99,
      "text": "No fever or vaginal discharge, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.49,
      "end_seconds": 81.69,
      "duration_seconds": 3.2,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.54,
      "end_seconds": 86.07,
      "duration_seconds": 3.53,
      "text": "I mean, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.89,
      "end_seconds": 98.43,
      "duration_seconds": 4.54,
      "text": "okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.11,
      "end_seconds": 103.04,
      "duration_seconds": 3.93,
      "text": "Um, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.43,
      "end_seconds": 111.43,
      "duration_seconds": 5.0,
      "text": "Alright, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.39,
      "end_seconds": 114.51,
      "duration_seconds": 1.12,
      "text": "Yes, erythromycin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.41,
      "end_seconds": 119.46,
      "duration_seconds": 4.05,
      "text": "Okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.76,
      "end_seconds": 123.0,
      "duration_seconds": 2.24,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.91,
      "end_seconds": 128.21,
      "duration_seconds": 3.3,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.3,
      "end_seconds": 135.21,
      "duration_seconds": 4.91,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.22,
      "end_seconds": 141.26,
      "duration_seconds": 4.04,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.46,
      "end_seconds": 145.59,
      "duration_seconds": 3.13,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.27,
      "end_seconds": 164.0,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.05,
      "end_seconds": 173.71,
      "duration_seconds": 2.66,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.46,
      "end_seconds": 211.28,
      "duration_seconds": 16.82,
      "text": "okay: weight 84 kilos, heart rate 115, temperature is 36.6 degrees and SpO2 97 percent on room air, BMI works out to 24.5, respiratory rate 17, height 185 centimetres, BP is 112 over 83."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.34,
      "end_seconds": 217.05,
      "duration_seconds": 4.71,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.23,
      "end_seconds": 230.4,
      "duration_seconds": 2.17,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.35,
      "end_seconds": 233.3,
      "duration_seconds": 1.95,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.04,
      "end_seconds": 254.4,
      "duration_seconds": 5.36,
      "text": "Your tummy is tender low on the right and and you look pale."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.89,
      "end_seconds": 261.56,
      "duration_seconds": 2.67,
      "text": "So, all finished, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.21,
      "end_seconds": 305.81,
      "duration_seconds": 29.6,
      "text": "Having listened and and examined, this looks most like a possible ectopic pregnancy. We should do an urgent pelvic scan for possible ectopic. You need to go to the hospital now for an emergency scan. Come back or go to emergency straight away if the pain gets worse or you faint. I'll want another look straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.89,
      "end_seconds": 310.95,
      "duration_seconds": 3.06,
      "text": "alright, you know, thanks, take care"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.1,
      "end_seconds": 316.96,
      "duration_seconds": 1.86,
      "text": "have a good day"
    }
  ]
}