{
  "schema_version": "1.0",
  "encounter_id": "01037",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.24,
      "end_seconds": 3.32,
      "duration_seconds": 2.08,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.12,
      "end_seconds": 5.38,
      "duration_seconds": 1.26,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 9.26,
      "duration_seconds": 2.59,
      "text": "Is it your first time here?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.88,
      "end_seconds": 14.04,
      "duration_seconds": 4.16,
      "text": "No, I came last year for something else."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.96,
      "end_seconds": 18.05,
      "duration_seconds": 3.09,
      "text": "Right, how are things, what's been happening?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.69,
      "end_seconds": 32.59,
      "duration_seconds": 8.9,
      "text": "Mainly my throat closing up. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.42,
      "end_seconds": 38.46,
      "duration_seconds": 4.04,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.32,
      "end_seconds": 54.77,
      "duration_seconds": 2.45,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.35,
      "end_seconds": 76.1,
      "duration_seconds": 6.75,
      "text": "Okay: temp 36.7 degrees, pulse is 98 beats a minute, blood pressure 93 over 58."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.92,
      "end_seconds": 80.22,
      "duration_seconds": 3.3,
      "text": "Is that alright, uh, doctor?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.57,
      "end_seconds": 87.15,
      "duration_seconds": 5.58,
      "text": "They help me see the whole picture, more shortly. When did this begin?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.86,
      "end_seconds": 92.91,
      "duration_seconds": 5.05,
      "text": "Okay, so it's been going on for one week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.29,
      "end_seconds": 97.74,
      "duration_seconds": 3.45,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.6,
      "end_seconds": 100.54,
      "duration_seconds": 0.94,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.64,
      "end_seconds": 104.31,
      "duration_seconds": 2.67,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.08,
      "end_seconds": 109.59,
      "duration_seconds": 3.51,
      "text": "Honestly, a couple of times a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.39,
      "end_seconds": 130.79,
      "duration_seconds": 2.4,
      "text": "Any chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.75,
      "end_seconds": 136.63,
      "duration_seconds": 4.88,
      "text": "I haven't had chest pain or recent illness, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.25,
      "end_seconds": 140.7,
      "duration_seconds": 2.45,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.26,
      "end_seconds": 146.22,
      "duration_seconds": 3.96,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.05,
      "end_seconds": 151.88,
      "duration_seconds": 1.83,
      "text": "Okay, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.88,
      "end_seconds": 155.23,
      "duration_seconds": 1.35,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.87,
      "end_seconds": 159.43,
      "duration_seconds": 2.56,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.01,
      "end_seconds": 161.11,
      "duration_seconds": 1.1,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.34,
      "end_seconds": 178.8,
      "duration_seconds": 1.46,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.66,
      "end_seconds": 183.17,
      "duration_seconds": 2.51,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.11,
      "end_seconds": 187.6,
      "duration_seconds": 2.49,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.36,
      "end_seconds": 192.2,
      "duration_seconds": 3.84,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.85,
      "end_seconds": 195.57,
      "duration_seconds": 1.72,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.35,
      "end_seconds": 201.21,
      "duration_seconds": 3.86,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.92,
      "end_seconds": 203.59,
      "duration_seconds": 1.67,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.71,
      "end_seconds": 211.36,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.69,
      "end_seconds": 227.04,
      "duration_seconds": 3.35,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.74,
      "end_seconds": 230.69,
      "duration_seconds": 2.95,
      "text": "I mean, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.89,
      "end_seconds": 235.73,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.52,
      "end_seconds": 240.39,
      "duration_seconds": 2.87,
      "text": "Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.94,
      "end_seconds": 243.13,
      "duration_seconds": 2.19,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.66,
      "end_seconds": 246.13,
      "duration_seconds": 1.47,
      "text": "I have asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.99,
      "end_seconds": 252.67,
      "duration_seconds": 5.68,
      "text": "Right, yes, asthma is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.09,
      "end_seconds": 257.75,
      "duration_seconds": 3.66,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.0,
      "end_seconds": 263.36,
      "duration_seconds": 1.36,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.39,
      "end_seconds": 265.65,
      "duration_seconds": 1.26,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.29,
      "end_seconds": 289.39,
      "duration_seconds": 6.1,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.94,
      "end_seconds": 296.96,
      "duration_seconds": 2.02,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.2,
      "end_seconds": 341.94,
      "duration_seconds": 26.74,
      "text": "Having listened and examined, it points towards anaphylaxis. Monitoring is what I'd like next, for anaphylaxis. The result will help us decide whether anything more is needed. I'll start you on adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. I'd like you back straight away. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.64,
      "end_seconds": 346.12,
      "duration_seconds": 3.48,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}