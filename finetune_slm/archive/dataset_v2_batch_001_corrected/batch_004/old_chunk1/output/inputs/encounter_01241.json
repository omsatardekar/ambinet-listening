{
  "schema_version": "1.0",
  "encounter_id": "01241",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 3.75,
      "duration_seconds": 3.07,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.8,
      "end_seconds": 10.0,
      "duration_seconds": 4.2,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.5,
      "end_seconds": 17.35,
      "duration_seconds": 5.85,
      "text": "So the thing is, you know, I've got a severe sore throat."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.93,
      "end_seconds": 22.83,
      "duration_seconds": 3.9,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.53,
      "end_seconds": 30.77,
      "duration_seconds": 3.24,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.44,
      "end_seconds": 35.25,
      "duration_seconds": 2.81,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 43.83,
      "duration_seconds": 7.6,
      "text": "It usually comes with a muffled voice. Actually, the muffled voice? That's been for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.83,
      "end_seconds": 61.74,
      "duration_seconds": 2.91,
      "text": "Have you had any rash or cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.88,
      "end_seconds": 67.03,
      "duration_seconds": 4.15,
      "text": "Right, you know, no, no rash or cough."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.17,
      "end_seconds": 70.69,
      "duration_seconds": 2.52,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.71,
      "end_seconds": 76.51,
      "duration_seconds": 3.8,
      "text": "Hmm, um, no, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.34,
      "end_seconds": 80.08,
      "duration_seconds": 2.74,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.92,
      "end_seconds": 87.01,
      "duration_seconds": 5.09,
      "text": "No, um, nothing as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.52,
      "end_seconds": 90.63,
      "duration_seconds": 3.11,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.69,
      "end_seconds": 93.51,
      "duration_seconds": 1.82,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.74,
      "end_seconds": 103.68,
      "duration_seconds": 2.94,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.71,
      "end_seconds": 114.78,
      "duration_seconds": 10.07,
      "text": "I retired from the post office two years ago. My husband and I live above the shop. I swim twice a week."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.47,
      "end_seconds": 118.27,
      "duration_seconds": 2.8,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.02,
      "end_seconds": 120.06,
      "duration_seconds": 1.04,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.75,
      "end_seconds": 123.5,
      "duration_seconds": 2.75,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.5,
      "end_seconds": 129.35,
      "duration_seconds": 4.85,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.98,
      "end_seconds": 133.64,
      "duration_seconds": 2.66,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.54,
      "end_seconds": 138.61,
      "duration_seconds": 3.07,
      "text": "An underactive thyroid, for two years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.65,
      "end_seconds": 147.54,
      "duration_seconds": 6.89,
      "text": "Right, so an underactive thyroid is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 167.85,
      "duration_seconds": 2.92,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.55,
      "end_seconds": 178.45,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.6,
      "end_seconds": 197.89,
      "duration_seconds": 5.29,
      "text": "Okay: pulse 91, blood pressure 120 over 83, respiratory rate 20."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.33,
      "end_seconds": 200.8,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.85,
      "end_seconds": 210.27,
      "duration_seconds": 3.42,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.6,
      "end_seconds": 215.82,
      "duration_seconds": 4.22,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.29,
      "end_seconds": 220.42,
      "duration_seconds": 3.13,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.12,
      "end_seconds": 236.25,
      "duration_seconds": 4.13,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.2,
      "end_seconds": 261.73,
      "duration_seconds": 22.53,
      "text": "You can relax now. So, based on the history and the examination, I'm honestly not certain yet. It could be a possible airway infection that needs emergency care, or it might be severe tonsillitis. We should do an urgent airway assessment for stridor and drooling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 262.3,
      "end_seconds": 264.84,
      "duration_seconds": 2.54,
      "text": "The earliest is Tuesday, 10 am."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.4,
      "end_seconds": 267.95,
      "duration_seconds": 2.55,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.98,
      "end_seconds": 284.38,
      "duration_seconds": 15.4,
      "text": "Do not lie flat, I am calling an ambulance now. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Come back straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.41,
      "end_seconds": 290.48,
      "duration_seconds": 4.07,
      "text": "Yeah, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.6,
      "end_seconds": 298.49,
      "duration_seconds": 6.89,
      "text": "Right, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.95,
      "end_seconds": 305.13,
      "duration_seconds": 5.18,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.78,
      "end_seconds": 310.25,
      "duration_seconds": 4.47,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.22,
      "end_seconds": 315.79,
      "duration_seconds": 3.57,
      "text": "Well, good, thanks, I'll see you then."
    }
  ]
}