{
  "schema_version": "1.0",
  "encounter_id": "01404",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.57,
      "duration_seconds": 3.77,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 9.99,
      "duration_seconds": 3.78,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.76,
      "end_seconds": 23.74,
      "duration_seconds": 11.98,
      "text": "Um, I'm here because of a tight band around my head. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.34,
      "end_seconds": 27.81,
      "duration_seconds": 2.47,
      "text": "Alright, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.75,
      "end_seconds": 34.94,
      "duration_seconds": 6.19,
      "text": "for three weeks, I'd say i've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.29,
      "end_seconds": 41.09,
      "duration_seconds": 4.8,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.49,
      "end_seconds": 45.53,
      "duration_seconds": 3.04,
      "text": "it sort of comes and goes"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.35,
      "end_seconds": 48.78,
      "duration_seconds": 2.43,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.92,
      "end_seconds": 57.89,
      "duration_seconds": 7.97,
      "text": "It usually comes with a stiff neck. About stiff neck, it happens every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.27,
      "end_seconds": 75.44,
      "duration_seconds": 4.17,
      "text": "Did you get blurred vision, weakness or sensitivity to light?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.41,
      "end_seconds": 82.02,
      "duration_seconds": 5.61,
      "text": "no, um, no blurred vision, weakness or sensitivity to light"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.98,
      "end_seconds": 87.62,
      "duration_seconds": 3.64,
      "text": "Okay, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.76,
      "end_seconds": 92.01,
      "duration_seconds": 3.25,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.74,
      "end_seconds": 95.99,
      "duration_seconds": 3.25,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.13,
      "end_seconds": 99.07,
      "duration_seconds": 1.94,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.75,
      "end_seconds": 115.67,
      "duration_seconds": 3.92,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 119.71,
      "duration_seconds": 3.1,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.51,
      "end_seconds": 137.19,
      "duration_seconds": 1.68,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.46,
      "end_seconds": 144.03,
      "duration_seconds": 5.57,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.79,
      "end_seconds": 148.98,
      "duration_seconds": 4.19,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.43,
      "end_seconds": 153.71,
      "duration_seconds": 3.28,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.81,
      "end_seconds": 156.56,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.6,
      "end_seconds": 161.07,
      "duration_seconds": 2.47,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.59,
      "end_seconds": 164.4,
      "duration_seconds": 2.81,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.19,
      "end_seconds": 170.4,
      "duration_seconds": 4.21,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.42,
      "end_seconds": 173.39,
      "duration_seconds": 1.97,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.27,
      "end_seconds": 180.65,
      "duration_seconds": 6.38,
      "text": "Hmm, yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 183.83,
      "duration_seconds": 2.6,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.56,
      "end_seconds": 186.02,
      "duration_seconds": 1.46,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.01,
      "end_seconds": 190.22,
      "duration_seconds": 3.21,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.61,
      "end_seconds": 193.11,
      "duration_seconds": 1.5,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.98,
      "end_seconds": 198.61,
      "duration_seconds": 3.63,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.02,
      "end_seconds": 204.76,
      "duration_seconds": 4.74,
      "text": "ah, you know, my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.56,
      "end_seconds": 209.3,
      "duration_seconds": 2.74,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.35,
      "end_seconds": 224.3,
      "duration_seconds": 1.95,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.63,
      "end_seconds": 245.37,
      "duration_seconds": 6.74,
      "text": "okay: respiratory rate 16, pressure 124 over 80, pulse 70, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.44,
      "end_seconds": 249.97,
      "duration_seconds": 3.53,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.95,
      "end_seconds": 253.19,
      "duration_seconds": 2.24,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.34,
      "end_seconds": 270.18,
      "duration_seconds": 6.84,
      "text": "your neck and shoulder muscles are tight, and and your eye movements are normal"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.88,
      "end_seconds": 277.22,
      "duration_seconds": 2.34,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.48,
      "end_seconds": 292.61,
      "duration_seconds": 4.13,
      "text": "Having listened and examined, my working impression is tension-type headache."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.64,
      "end_seconds": 298.12,
      "duration_seconds": 3.48,
      "text": "Erm, is it it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.19,
      "end_seconds": 317.97,
      "duration_seconds": 18.78,
      "text": "I understand the worry. At the moment I'd say it's tension-type headache, and we'll know more once the an eye test is back. We should do an eye test for eye strain. Take screen breaks every hour and try regular neck stretches."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.29,
      "end_seconds": 322.67,
      "duration_seconds": 4.38,
      "text": "Ah. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.78,
      "end_seconds": 327.22,
      "duration_seconds": 3.44,
      "text": "great, thank you for your help"
    }
  ]
}