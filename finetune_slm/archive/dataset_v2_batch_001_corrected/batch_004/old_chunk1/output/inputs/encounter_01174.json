    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.85,
      "end_seconds": 47.99,
      "duration_seconds": 3.14,
      "text": "Can you tell me when it first started?"
