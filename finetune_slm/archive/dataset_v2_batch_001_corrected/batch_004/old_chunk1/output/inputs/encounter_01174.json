      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.52,
      "end_seconds": 294.63,
      "duration_seconds": 7.11,
      "text": "okay: respiratory rate 14, temperature 36.7, blood pressure 110 over 82. And heart rate 66."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.92,
      "end_seconds": 299.87,
      "duration_seconds": 2.95,
      "text": "Okay, time for me to examine you."
