    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.72,
      "end_seconds": 68.43,
      "duration_seconds": 2.71,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.39,
      "end_seconds": 78.08,
      "duration_seconds": 8.69,
      "text": "it, It happens on and off i've also had tired eyes, since last night"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.9,
      "end_seconds": 82.05,
      "duration_seconds": 3.15,
      "text": "Has there been a stiff neck too?"
