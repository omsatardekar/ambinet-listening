    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.95,
      "end_seconds": 218.88,
      "duration_seconds": 11.93,
      "text": "I do a yoga class on Thursdays. I live with my elderly mother. I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.64,
      "end_seconds": 224.06,
      "duration_seconds": 4.42,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.87,
      "end_seconds": 239.56,
      "duration_seconds": 14.69,
      "text": "I have COPD for five years i've never really been one for hospitals i took the morning off to to come in today i've got eczema"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.39,
      "end_seconds": 255.1,
      "duration_seconds": 9.71,
      "text": "right, right yes, eczema is known to us, good to have that clear so, I'll just record a few vital signs"
