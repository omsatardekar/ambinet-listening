{
  "schema_version": "1.0",
  "encounter_id": "01387",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.53,
      "duration_seconds": 3.87,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.58,
      "end_seconds": 9.08,
      "duration_seconds": 3.5,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.73,
      "end_seconds": 16.18,
      "duration_seconds": 5.45,
      "text": "hmm, morning, doctor. I'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.46,
      "end_seconds": 21.05,
      "duration_seconds": 3.59,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.92,
      "end_seconds": 32.97,
      "duration_seconds": 11.05,
      "text": "Doctor, it's a sore ankle. It's getting on my nerves now. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.44,
      "end_seconds": 39.5,
      "duration_seconds": 3.06,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.57,
      "end_seconds": 47.78,
      "duration_seconds": 6.21,
      "text": "About... well, two days. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.21,
      "end_seconds": 53.92,
      "duration_seconds": 4.71,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.96,
      "end_seconds": 68.5,
      "duration_seconds": 9.54,
      "text": "Moderate, I'd say. I'd say once or twice a day. I've also had a little swelling, since Friday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.44,
      "end_seconds": 73.83,
      "duration_seconds": 3.39,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.76,
      "end_seconds": 79.04,
      "duration_seconds": 4.28,
      "text": "Let me think, I get some relief from elevation."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.23,
      "end_seconds": 86.36,
      "duration_seconds": 6.13,
      "text": "have you had a sore ankle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.39,
      "end_seconds": 95.46,
      "duration_seconds": 7.07,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.11,
      "end_seconds": 113.21,
      "duration_seconds": 6.1,
      "text": "have you had any pain in the foot, numbness or crack or pop?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.03,
      "end_seconds": 121.79,
      "duration_seconds": 7.76,
      "text": "mm, I haven't had pain in the foot, numbness or crack or pop, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.13,
      "end_seconds": 125.35,
      "duration_seconds": 3.22,
      "text": "Hm, okay. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.67,
      "end_seconds": 130.79,
      "duration_seconds": 1.12,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.35,
      "end_seconds": 134.58,
      "duration_seconds": 2.23,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.96,
      "end_seconds": 140.41,
      "duration_seconds": 4.45,
      "text": "erm, that's normal as far as I know"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.56,
      "end_seconds": 159.34,
      "duration_seconds": 3.78,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.27,
      "end_seconds": 166.57,
      "duration_seconds": 5.3,
      "text": "My father had bowel cancer. My mother had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.03,
      "end_seconds": 171.35,
      "duration_seconds": 3.32,
      "text": "okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.49,
      "end_seconds": 184.29,
      "duration_seconds": 11.8,
      "text": "I think I reacted to to some antibiotic once, um, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.11,
      "end_seconds": 188.84,
      "duration_seconds": 2.73,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.4,
      "end_seconds": 193.5,
      "duration_seconds": 4.1,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.35,
      "end_seconds": 196.4,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.95,
      "end_seconds": 201.73,
      "duration_seconds": 3.78,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.43,
      "end_seconds": 206.05,
      "duration_seconds": 2.62,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.77,
      "end_seconds": 210.13,
      "duration_seconds": 2.36,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.83,
      "end_seconds": 212.71,
      "duration_seconds": 0.88,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.66,
      "end_seconds": 233.14,
      "duration_seconds": 19.48,
      "text": "I've had high blood pressure, yes. I'd rather know what's going on than keep guessing. I've got eczema. I just want to get back to normal, really. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.55,
      "end_seconds": 236.03,
      "duration_seconds": 1.48,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.93,
      "end_seconds": 241.52,
      "duration_seconds": 4.59,
      "text": "I've had acid reflux for nearly five years now"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.5,
      "end_seconds": 244.91,
      "duration_seconds": 1.41,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 258.68,
      "duration_seconds": 12.52,
      "text": "Okay, yes, gout is known to us, good to have that clear. Are you taking anything regularly, including from the pharmacy? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.05,
      "end_seconds": 265.59,
      "duration_seconds": 3.54,
      "text": "Febuxostat, 80 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.29,
      "end_seconds": 270.31,
      "duration_seconds": 4.02,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.96,
      "end_seconds": 289.77,
      "duration_seconds": 17.81,
      "text": "Erm, um, not with me. I'll bring it next time. It's amlodipine, 5 milligrams, once a day. Hydrocortisone cream, when needed for the eczema. Lansoprazole. I take it 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.11,
      "end_seconds": 293.89,
      "duration_seconds": 2.78,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.76,
      "end_seconds": 304.97,
      "duration_seconds": 2.21,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.25,
      "end_seconds": 334.8,
      "duration_seconds": 10.55,
      "text": "Okay: pressure 115 over 75, temp 36.8 degrees, height 169 centimetres, saturation 99 percent, weight 71 kilos, pulse is 86 beats a minute."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.87,
      "end_seconds": 340.14,
      "duration_seconds": 4.27,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.48,
      "end_seconds": 343.89,
      "duration_seconds": 2.41,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.89,
      "end_seconds": 366.28,
      "duration_seconds": 7.39,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.21,
      "end_seconds": 397.98,
      "duration_seconds": 26.77,
      "text": "good, you can sit up again. Putting it all together, this looks most like a mild ankle sprain. It could also be a minor fracture, so we'll keep that open. Rest, ice, a compression bandage and keep it raised for two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.24,
      "end_seconds": 408.93,
      "duration_seconds": 9.69,
      "text": "keep an eye out, and if you cannot put weight on it, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 410.87,
      "end_seconds": 412.44,
      "duration_seconds": 1.57,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.01,
      "end_seconds": 418.08,
      "duration_seconds": 4.07,
      "text": "Come back if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 418.66,
      "end_seconds": 422.38,
      "duration_seconds": 3.72,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.77,
      "end_seconds": 426.4,
      "duration_seconds": 2.63,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 431.66,
      "end_seconds": 434.94,
      "duration_seconds": 3.28,
      "text": "okay, that makes sense. Thanks for explaining"
    }
  ]
}