{
  "schema_version": "1.0",
  "encounter_id": "01144",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.27,
      "end_seconds": 3.94,
      "duration_seconds": 2.67,
      "text": "Okay, afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.83,
      "end_seconds": 6.04,
      "duration_seconds": 1.21,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.54,
      "end_seconds": 9.77,
      "duration_seconds": 3.23,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.54,
      "end_seconds": 16.96,
      "duration_seconds": 5.42,
      "text": "Good, that'll be useful. Pull up a chair. What's been worrying you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.96,
      "end_seconds": 21.6,
      "duration_seconds": 2.64,
      "text": "We came because of slurred speech."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.56,
      "end_seconds": 26.54,
      "duration_seconds": 3.98,
      "text": "Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.68,
      "end_seconds": 34.84,
      "duration_seconds": 7.16,
      "text": "About... well, three days. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.91,
      "end_seconds": 40.53,
      "duration_seconds": 3.62,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.29,
      "end_seconds": 53.69,
      "duration_seconds": 11.4,
      "text": "Let me think, a five out of ten, I suppose. Oh, and weakness in my right arm. That's been about the same, one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.55,
      "end_seconds": 59.39,
      "duration_seconds": 3.84,
      "text": "What about a sudden headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.1,
      "end_seconds": 77.93,
      "duration_seconds": 17.83,
      "text": "Yeah, I've had that since Monday. Oh, and my face drooping on one side. That's been about the same, three days. As for my face drooping on one side, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.83,
      "end_seconds": 81.54,
      "duration_seconds": 2.71,
      "text": "And what about fever or seizure?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.28,
      "end_seconds": 88.2,
      "duration_seconds": 2.92,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.05,
      "end_seconds": 93.08,
      "duration_seconds": 4.03,
      "text": "Okay, and loss of consciousness, any of that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.69,
      "end_seconds": 96.06,
      "duration_seconds": 2.37,
      "text": "Nope, no loss of consciousness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.95,
      "end_seconds": 100.08,
      "duration_seconds": 2.13,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.02,
      "end_seconds": 102.81,
      "duration_seconds": 1.79,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.4,
      "end_seconds": 109.02,
      "duration_seconds": 4.62,
      "text": "So, how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.88,
      "end_seconds": 112.34,
      "duration_seconds": 2.46,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.69,
      "end_seconds": 120.2,
      "duration_seconds": 2.51,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.28,
      "end_seconds": 131.5,
      "duration_seconds": 10.22,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.6,
      "end_seconds": 144.14,
      "duration_seconds": 2.54,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.9,
      "end_seconds": 150.51,
      "duration_seconds": 4.61,
      "text": "I, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.72,
      "end_seconds": 172.53,
      "duration_seconds": 3.81,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.48,
      "end_seconds": 181.55,
      "duration_seconds": 7.07,
      "text": "Losartan. I take it 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 183.06,
      "end_seconds": 192.8,
      "duration_seconds": 9.74,
      "text": "Doctor, I think the last prescription for the losartan was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.5,
      "end_seconds": 197.83,
      "duration_seconds": 3.33,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.65,
      "end_seconds": 210.27,
      "duration_seconds": 11.62,
      "text": "No, I left it at home. It's bisoprolol, 2.5 milligrams, once a day. I take naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.8,
      "end_seconds": 215.54,
      "duration_seconds": 3.74,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.62,
      "end_seconds": 221.2,
      "duration_seconds": 3.58,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.15,
      "end_seconds": 224.23,
      "duration_seconds": 2.08,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.72,
      "end_seconds": 230.14,
      "duration_seconds": 4.42,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.06,
      "end_seconds": 234.8,
      "duration_seconds": 3.74,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.37,
      "end_seconds": 262.95,
      "duration_seconds": 27.58,
      "text": "I have high blood pressure, for about ten years. I thought it would sort itself out, but it hasn't. I told my wife I'd come today. I have an irregular heartbeat. I, I have arthritis in my knees, for two years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.16,
      "end_seconds": 265.6,
      "duration_seconds": 1.44,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.27,
      "end_seconds": 275.24,
      "duration_seconds": 7.97,
      "text": "Right, so high blood pressure and an irregular heartbeat are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 276.13,
      "end_seconds": 285.44,
      "duration_seconds": 9.31,
      "text": "Okay, so the vitals from earlier. Temperature is 36.6 degrees, oxygen saturation is 97 percent, blood pressure 144 over 101, heart rate 75."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.58,
      "end_seconds": 287.58,
      "duration_seconds": 1.0,
      "text": "Alright, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.73,
      "end_seconds": 293.73,
      "duration_seconds": 4.0,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.88,
      "end_seconds": 296.86,
      "duration_seconds": 1.98,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.01,
      "end_seconds": 315.78,
      "duration_seconds": 6.77,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.2,
      "end_seconds": 321.79,
      "duration_seconds": 1.59,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.31,
      "end_seconds": 340.76,
      "duration_seconds": 10.45,
      "text": "Let me tell you where I've got to. This is probably a possible stroke, within the treatment window. A migraine with aura is still possible."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.18,
      "end_seconds": 344.38,
      "duration_seconds": 2.2,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.06,
      "end_seconds": 367.55,
      "duration_seconds": 21.49,
      "text": "It's reasonable to be concerned, but right now a possible stroke, within the treatment window is my leading thought, not anything worse. Let me repeat that back to make sure. You've had slurred speech for three days, and no loss of consciousness or fever."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.99,
      "end_seconds": 370.67,
      "duration_seconds": 1.68,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 371.31,
      "end_seconds": 378.26,
      "duration_seconds": 6.95,
      "text": "Doctor, I did a blood sugar test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.35,
      "end_seconds": 387.67,
      "duration_seconds": 7.32,
      "text": "Thanks, that helps. I'm sending you for an urgent CT scan of the head because of possible stroke."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.42,
      "end_seconds": 390.77,
      "duration_seconds": 1.35,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.73,
      "end_seconds": 404.37,
      "duration_seconds": 11.64,
      "text": "Call an ambulance now, you need hospital immediately. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.1,
      "end_seconds": 407.15,
      "duration_seconds": 1.05,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.93,
      "end_seconds": 412.6,
      "duration_seconds": 4.67,
      "text": "Book a review straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.56,
      "end_seconds": 416.65,
      "duration_seconds": 2.09,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}