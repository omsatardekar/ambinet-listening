{
  "schema_version": "1.0",
  "encounter_id": "01245",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.58,
      "duration_seconds": 4.77,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.46,
      "end_seconds": 11.26,
      "duration_seconds": 4.8,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.09,
      "end_seconds": 25.79,
      "duration_seconds": 9.7,
      "text": "Mainly an itchy patch on my wrist. There's a couple of other things, but that's the the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.07,
      "end_seconds": 28.72,
      "duration_seconds": 1.65,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.89,
      "end_seconds": 32.5,
      "duration_seconds": 2.61,
      "text": "about... well, about three months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.96,
      "end_seconds": 38.54,
      "duration_seconds": 5.58,
      "text": "mm, okay. Okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.96,
      "end_seconds": 47.87,
      "duration_seconds": 7.91,
      "text": "My new watch strap definitely sets it off. Severe, really. It happens every other day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.08,
      "end_seconds": 53.24,
      "duration_seconds": 4.16,
      "text": "what about dry flaky skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.29,
      "end_seconds": 62.43,
      "duration_seconds": 7.14,
      "text": "Yes, I have. About dry flaky skin, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.94,
      "end_seconds": 78.15,
      "duration_seconds": 3.21,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.94,
      "end_seconds": 85.56,
      "duration_seconds": 5.62,
      "text": "yes, I had two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.04,
      "end_seconds": 90.71,
      "duration_seconds": 3.67,
      "text": "Alright, are you on your own at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.32,
      "end_seconds": 95.39,
      "duration_seconds": 3.07,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.36,
      "end_seconds": 99.22,
      "duration_seconds": 1.86,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.02,
      "end_seconds": 104.58,
      "duration_seconds": 3.56,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.06,
      "end_seconds": 113.08,
      "duration_seconds": 3.02,
      "text": "alright, tell me about your eating"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.34,
      "end_seconds": 119.66,
      "duration_seconds": 5.32,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.89,
      "end_seconds": 138.48,
      "duration_seconds": 5.59,
      "text": "so, what's on your current medicine list? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.74,
      "end_seconds": 153.14,
      "duration_seconds": 13.4,
      "text": "Apixaban, 5 milligrams, twice a day. It's carvedilol, 6.25 milligrams, twice a day for my heart. Metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.64,
      "end_seconds": 156.07,
      "duration_seconds": 2.43,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.76,
      "end_seconds": 160.23,
      "duration_seconds": 2.47,
      "text": "I have an irregular heartbeat."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.53,
      "end_seconds": 162.53,
      "duration_seconds": 1.0,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.5,
      "end_seconds": 167.36,
      "duration_seconds": 3.86,
      "text": "I've got heart failure. I have heart disease."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.04,
      "end_seconds": 180.03,
      "duration_seconds": 10.99,
      "text": "mm, okay yes, heart failure is known to us, good to have that clear a few quick ones: spreading, blisters or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.61,
      "end_seconds": 184.02,
      "duration_seconds": 3.41,
      "text": "No, no spreading, blisters or fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.07,
      "end_seconds": 188.68,
      "duration_seconds": 2.61,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.21,
      "end_seconds": 195.83,
      "duration_seconds": 5.62,
      "text": "Sorry, what was I saying, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 196.38,
      "end_seconds": 211.54,
      "duration_seconds": 15.16,
      "text": "here are the numbers, doctor. Temperature 37.0, BMI works out to 36.4, heart rate 69, height 151 centimetres, weight 83 kilos, blood pressure 110 over 71, oxygen saturation is 98 percent"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.54,
      "end_seconds": 214.24,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.24,
      "end_seconds": 219.08,
      "duration_seconds": 2.84,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.77,
      "end_seconds": 224.21,
      "duration_seconds": 3.44,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.8,
      "end_seconds": 249.32,
      "duration_seconds": 6.52,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.81,
      "end_seconds": 254.93,
      "duration_seconds": 2.12,
      "text": "Right, you can relax now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.35,
      "end_seconds": 299.89,
      "duration_seconds": 30.54,
      "text": "You'll be taking hydrocortisone cream, 1%, once a day, one week. That's for contact dermatitis. I'll put all of this in writing so you don't have to remember it. Stop wearing that strap and keep the skin moisturised. A short walk every day, even twenty minutes, will help more than you'd think. If it spreads or blisters, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.46,
      "end_seconds": 310.72,
      "duration_seconds": 9.26,
      "text": "Let's plan a check if it has not cleared in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.73,
      "end_seconds": 315.62,
      "duration_seconds": 3.89,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.39,
      "end_seconds": 317.57,
      "duration_seconds": 1.18,
      "text": "take care now"
    }
  ]
}