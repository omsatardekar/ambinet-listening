{
  "schema_version": "1.0",
  "encounter_id": "01263",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.4,
      "end_seconds": 7.06,
      "duration_seconds": 5.66,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.74,
      "end_seconds": 13.92,
      "duration_seconds": 5.18,
      "text": "Great. Hello, come in and and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.49,
      "end_seconds": 21.08,
      "duration_seconds": 6.59,
      "text": "Good afternoon, um, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.16,
      "end_seconds": 26.3,
      "duration_seconds": 4.14,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.4,
      "end_seconds": 31.64,
      "duration_seconds": 4.24,
      "text": "I wanted to get no real problems looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.4,
      "end_seconds": 37.14,
      "duration_seconds": 3.74,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.49,
      "end_seconds": 43.0,
      "duration_seconds": 4.51,
      "text": "about three days, uh, give or take"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 44.49,
      "end_seconds": 49.12,
      "duration_seconds": 4.63,
      "text": "I, I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.01,
      "end_seconds": 56.88,
      "duration_seconds": 4.87,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.14,
      "end_seconds": 59.19,
      "duration_seconds": 1.05,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.07,
      "end_seconds": 63.35,
      "duration_seconds": 3.28,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 65.07,
      "end_seconds": 72.05,
      "duration_seconds": 6.98,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.47,
      "end_seconds": 79.24,
      "duration_seconds": 5.77,
      "text": "take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.38,
      "end_seconds": 84.84,
      "duration_seconds": 4.46,
      "text": "A five out of ten, you know, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.53,
      "end_seconds": 91.41,
      "duration_seconds": 5.88,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 91.51,
      "end_seconds": 97.72,
      "duration_seconds": 6.21,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.56,
      "end_seconds": 100.71,
      "duration_seconds": 2.15,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 102.42,
      "end_seconds": 108.35,
      "duration_seconds": 5.93,
      "text": "so, you know, I've had an occasional headache too, for three days"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 109.13,
      "end_seconds": 112.54,
      "duration_seconds": 3.41,
      "text": "yes, that's right, that's how it was"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.17,
      "end_seconds": 119.42,
      "duration_seconds": 5.25,
      "text": "And what about shortness of breath, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.92,
      "end_seconds": 135.27,
      "duration_seconds": 14.35,
      "text": "actually, no, no shortness of breath, no weight loss, no chest pain i did have a bit of back stiffness at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.11,
      "end_seconds": 139.28,
      "duration_seconds": 2.17,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.19,
      "end_seconds": 143.68,
      "duration_seconds": 2.49,
      "text": "nothing there, um, no"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.14,
      "end_seconds": 150.3,
      "duration_seconds": 3.16,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.32,
      "end_seconds": 153.32,
      "duration_seconds": 1.0,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.64,
      "end_seconds": 157.22,
      "duration_seconds": 2.58,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.76,
      "end_seconds": 161.62,
      "duration_seconds": 3.86,
      "text": "Amoxicillin i come out in... well, hives"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.69,
      "end_seconds": 164.77,
      "duration_seconds": 2.08,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.6,
      "end_seconds": 183.04,
      "duration_seconds": 17.44,
      "text": "I've had high cholesterol for nearly five years now. An underactive thyroid, for about ten years. I have migraines, for two years. I've, I've had heart disease for two years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.54,
      "end_seconds": 193.19,
      "duration_seconds": 8.65,
      "text": "yes, an underactive thyroid and migraines are known to us, good to have that clear any surgery in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.72,
      "end_seconds": 200.11,
      "duration_seconds": 5.39,
      "text": "yes, I had part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.36,
      "end_seconds": 208.24,
      "duration_seconds": 3.88,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.32,
      "end_seconds": 214.88,
      "duration_seconds": 4.56,
      "text": "my aunt has rheumatoid arthritis. My grandmother had dementia"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.16,
      "end_seconds": 220.11,
      "duration_seconds": 3.95,
      "text": "Okay, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.89,
      "end_seconds": 230.31,
      "duration_seconds": 9.42,
      "text": "It's atorvastatin, 20 milligrams, at night. I'd rather know what's going on than keep guessing. It's Eltroxin, every morning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.02,
      "end_seconds": 233.12,
      "duration_seconds": 2.1,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.58,
      "end_seconds": 239.11,
      "duration_seconds": 4.53,
      "text": "100 micrograms, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.91,
      "end_seconds": 243.36,
      "duration_seconds": 3.45,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.39,
      "end_seconds": 246.78,
      "duration_seconds": 1.39,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.82,
      "end_seconds": 255.65,
      "duration_seconds": 6.83,
      "text": "It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.71,
      "end_seconds": 259.08,
      "duration_seconds": 2.37,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.02,
      "end_seconds": 275.07,
      "duration_seconds": 14.05,
      "text": "yeah, for the migraine prevention, I believe. My daughter sets them out for me, I just take what I'm given. Right, I take metoprolol, twice a day"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.16,
      "end_seconds": 278.5,
      "duration_seconds": 2.34,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 279.86,
      "end_seconds": 285.92,
      "duration_seconds": 6.06,
      "text": "It's 50 milligrams. So, I was on rosuvastatin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.9,
      "end_seconds": 289.85,
      "duration_seconds": 1.95,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.75,
      "end_seconds": 294.64,
      "duration_seconds": 2.89,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.42,
      "end_seconds": 298.8,
      "duration_seconds": 2.38,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 299.49,
      "end_seconds": 303.13,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 317.74,
      "end_seconds": 333.31,
      "duration_seconds": 15.57,
      "text": "Here are the numbers, doctor. Oxygen saturation is 99 percent, weight 62 kilos, pulse is 82 beats a minute. Height 178 centimetres, temperature is 36.8 degrees, respiratory rate 16, BP is 125 over 73."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.0,
      "end_seconds": 335.09,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.97,
      "end_seconds": 342.05,
      "duration_seconds": 4.08,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.88,
      "end_seconds": 345.41,
      "duration_seconds": 1.53,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.72,
      "end_seconds": 348.1,
      "duration_seconds": 1.38,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.45,
      "end_seconds": 367.07,
      "duration_seconds": 2.62,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.74,
      "end_seconds": 387.93,
      "duration_seconds": 15.19,
      "text": "You can sit up now. Having listened and examined, I think we're dealing with a healthy adult with no worrying findings at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.64,
      "end_seconds": 392.03,
      "duration_seconds": 3.39,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.78,
      "end_seconds": 406.75,
      "duration_seconds": 13.97,
      "text": "I understand the worry. At the moment I'd say it's a healthy adult with no worrying findings, and we'll know more once the a cholesterol blood test is back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.14,
      "end_seconds": 427.85,
      "duration_seconds": 4.71,
      "text": "I want a cholesterol blood test done, that's for routine check."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 429.38,
      "end_seconds": 435.1,
      "duration_seconds": 5.72,
      "text": "So, can you send me for a fasting sugar test?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 436.04,
      "end_seconds": 448.85,
      "duration_seconds": 12.81,
      "text": "not right now, it wouldn't change what we do today let's plan a check in twelve months right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 450.25,
      "end_seconds": 452.58,
      "duration_seconds": 2.33,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 453.59,
      "end_seconds": 455.27,
      "duration_seconds": 1.68,
      "text": "Have a good day."
    }
  ]
}