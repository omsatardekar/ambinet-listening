{
  "schema_version": "1.0",
  "encounter_id": "01007",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.99,
      "duration_seconds": 3.94,
      "text": "So, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.37,
      "end_seconds": 13.28,
      "duration_seconds": 3.91,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.73,
      "end_seconds": 20.2,
      "duration_seconds": 5.47,
      "text": "I wanted to get a severe headache looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.36,
      "end_seconds": 24.67,
      "duration_seconds": 3.31,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.13,
      "end_seconds": 29.46,
      "duration_seconds": 3.33,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.84,
      "end_seconds": 36.15,
      "duration_seconds": 6.31,
      "text": "Hm, okay. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.32,
      "end_seconds": 45.15,
      "duration_seconds": 7.83,
      "text": "Light definitely sets it off. I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.03,
      "end_seconds": 51.44,
      "duration_seconds": 4.41,
      "text": "Have you had a rash that does not fade?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.9,
      "end_seconds": 54.01,
      "duration_seconds": 1.11,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.29,
      "end_seconds": 74.44,
      "duration_seconds": 2.15,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.19,
      "end_seconds": 82.64,
      "duration_seconds": 7.45,
      "text": "I'm on something called leve... levetiracetam, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.78,
      "end_seconds": 86.86,
      "duration_seconds": 3.08,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.59,
      "end_seconds": 92.09,
      "duration_seconds": 4.5,
      "text": "Ah, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.74,
      "end_seconds": 111.12,
      "duration_seconds": 4.38,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.1,
      "end_seconds": 124.25,
      "duration_seconds": 11.15,
      "text": "I, I have gout, for about ten years. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.8,
      "end_seconds": 127.24,
      "duration_seconds": 1.44,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.64,
      "end_seconds": 130.94,
      "duration_seconds": 2.3,
      "text": "Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.72,
      "end_seconds": 139.39,
      "duration_seconds": 6.67,
      "text": "Alright, epilepsy, that matches what I have here. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.3,
      "end_seconds": 145.11,
      "duration_seconds": 3.81,
      "text": "I mean, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.72,
      "end_seconds": 149.07,
      "duration_seconds": 3.35,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.87,
      "end_seconds": 154.09,
      "duration_seconds": 4.22,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.77,
      "end_seconds": 157.12,
      "duration_seconds": 2.35,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.2,
      "end_seconds": 162.57,
      "duration_seconds": 4.37,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.2,
      "end_seconds": 181.85,
      "duration_seconds": 3.65,
      "text": "Have you had any cough or recent head injury?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.68,
      "end_seconds": 185.98,
      "duration_seconds": 2.3,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.4,
      "end_seconds": 191.88,
      "duration_seconds": 5.48,
      "text": "Yes, carry on. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.25,
      "end_seconds": 194.91,
      "duration_seconds": 1.66,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.83,
      "end_seconds": 201.55,
      "duration_seconds": 4.72,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.59,
      "end_seconds": 215.92,
      "duration_seconds": 2.33,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.48,
      "end_seconds": 238.09,
      "duration_seconds": 11.61,
      "text": "Okay: temperature is 38.3 degrees, BP is 110 over 68. And pulse is 101 beats a minute, SpO2 95 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.01,
      "end_seconds": 241.83,
      "duration_seconds": 1.82,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.13,
      "end_seconds": 246.42,
      "duration_seconds": 3.29,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.95,
      "end_seconds": 254.56,
      "duration_seconds": 5.61,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.16,
      "end_seconds": 258.51,
      "duration_seconds": 2.35,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.96,
      "end_seconds": 274.31,
      "duration_seconds": 7.35,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.12,
      "end_seconds": 277.6,
      "duration_seconds": 1.48,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.02,
      "end_seconds": 299.74,
      "duration_seconds": 17.72,
      "text": "Alright, you can sit up now. Right, here's what I'm thinking. It points towards possible bacterial meningitis. That's my thinking for now, and it may change as we learn more. It could also be meningococcal septicaemia, so we'll keep that open."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.3,
      "end_seconds": 304.03,
      "duration_seconds": 3.73,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.03,
      "end_seconds": 327.69,
      "duration_seconds": 21.66,
      "text": "I can't promise yet, but most people with possible bacterial meningitis do well once it's treated properly. Let's book blood cultures to look into possible meningitis. I want a lumbar puncture done, that's for possible meningitis. We'll begin with benzylpenicillin, 1.2 grams, once now, single dose. It's for possible meningitis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.05,
      "end_seconds": 333.93,
      "duration_seconds": 4.88,
      "text": "Oh, um, alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.5,
      "end_seconds": 347.72,
      "duration_seconds": 13.22,
      "text": "Call an ambulance now, this is an emergency. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.3,
      "end_seconds": 352.95,
      "duration_seconds": 3.65,
      "text": "Yeah, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.24,
      "end_seconds": 357.37,
      "duration_seconds": 3.13,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.74,
      "end_seconds": 359.44,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.41,
      "end_seconds": 364.62,
      "duration_seconds": 3.21,
      "text": "So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.36,
      "end_seconds": 366.96,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.62,
      "end_seconds": 371.9,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}