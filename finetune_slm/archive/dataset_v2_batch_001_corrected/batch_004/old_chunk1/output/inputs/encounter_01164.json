{
  "schema_version": "1.0",
  "encounter_id": "01164",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.29,
      "duration_seconds": 4.11,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.01,
      "end_seconds": 9.9,
      "duration_seconds": 3.89,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.78,
      "end_seconds": 17.91,
      "duration_seconds": 6.13,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.08,
      "end_seconds": 22.52,
      "duration_seconds": 3.44,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.86,
      "end_seconds": 25.49,
      "duration_seconds": 1.63,
      "text": "I've been sweating."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.41,
      "end_seconds": 30.1,
      "duration_seconds": 3.69,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.0,
      "end_seconds": 36.17,
      "duration_seconds": 3.17,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.17,
      "end_seconds": 49.85,
      "duration_seconds": 8.68,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.37,
      "end_seconds": 62.95,
      "duration_seconds": 12.58,
      "text": "Pretty mild, if I'm being honest. It happens all the time. Pain going into my left arm was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.51,
      "end_seconds": 67.26,
      "duration_seconds": 3.75,
      "text": "Have you been sweating at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.35,
      "end_seconds": 73.05,
      "duration_seconds": 4.7,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.25,
      "end_seconds": 92.35,
      "duration_seconds": 3.1,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.27,
      "end_seconds": 102.32,
      "duration_seconds": 2.05,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.06,
      "end_seconds": 122.44,
      "duration_seconds": 7.38,
      "text": "Okay: oxygen saturation is 98 percent, temperature is 37.1 degrees, pressure 137 over 70. And pulse 114."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.54,
      "end_seconds": 125.12,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.71,
      "end_seconds": 128.96,
      "duration_seconds": 3.25,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.48,
      "end_seconds": 135.68,
      "duration_seconds": 4.2,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.83,
      "end_seconds": 138.04,
      "duration_seconds": 1.21,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.32,
      "end_seconds": 160.2,
      "duration_seconds": 4.88,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.76,
      "end_seconds": 171.67,
      "duration_seconds": 5.91,
      "text": "That's the examination finished. Okay, and what about cough, leg swelling or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.31,
      "end_seconds": 175.64,
      "duration_seconds": 3.33,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.93,
      "end_seconds": 181.27,
      "duration_seconds": 4.34,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.54,
      "end_seconds": 185.48,
      "duration_seconds": 2.94,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.6,
      "end_seconds": 191.85,
      "duration_seconds": 5.25,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.62,
      "end_seconds": 195.45,
      "duration_seconds": 1.83,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.45,
      "end_seconds": 201.12,
      "duration_seconds": 4.67,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 202.51,
      "end_seconds": 206.39,
      "duration_seconds": 3.88,
      "text": "It's atorvastatin, 20 milligrams, at night, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 211.16,
      "duration_seconds": 2.7,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.19,
      "end_seconds": 230.52,
      "duration_seconds": 15.33,
      "text": "I used to drink heavily but I stopped four years ago. I have about eight cigarettes in a day. I work in accounts at a hospital. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.23,
      "end_seconds": 242.39,
      "duration_seconds": 3.16,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.56,
      "end_seconds": 253.53,
      "duration_seconds": 7.97,
      "text": "I've had high cholesterol for two years now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.31,
      "end_seconds": 255.24,
      "duration_seconds": 0.93,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.67,
      "end_seconds": 271.39,
      "duration_seconds": 5.72,
      "text": "Okay, so my impression is this: My working impression is a possible heart attack."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.66,
      "end_seconds": 276.06,
      "duration_seconds": 3.4,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.98,
      "end_seconds": 309.66,
      "duration_seconds": 31.68,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible heart attack, but I'd like to confirm. I think a troponin blood test makes sense here, for chest pain. I'd like you to take aspirin, 300 milligrams, once now, single dose. You take it by mouth. That should help with possible heart attack. Stay lying down and do not eat or drink. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.08,
      "end_seconds": 315.42,
      "duration_seconds": 4.34,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.95,
      "end_seconds": 318.08,
      "duration_seconds": 2.13,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.25,
      "end_seconds": 320.68,
      "duration_seconds": 1.43,
      "text": "See you soon."
    }
  ]
}