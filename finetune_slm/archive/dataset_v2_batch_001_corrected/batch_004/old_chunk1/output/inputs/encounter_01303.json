{
  "schema_version": "1.0",
  "encounter_id": "01303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 5.2,
      "duration_seconds": 4.38,
      "text": "Oh, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.02,
      "end_seconds": 11.27,
      "duration_seconds": 4.25,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 19.13,
      "duration_seconds": 6.23,
      "text": "So the thing is, I've got pain going into my left arm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.27,
      "end_seconds": 23.62,
      "duration_seconds": 3.35,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.34,
      "end_seconds": 32.81,
      "duration_seconds": 3.47,
      "text": "It's been six months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.81,
      "end_seconds": 37.54,
      "duration_seconds": 2.73,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.96,
      "end_seconds": 41.81,
      "duration_seconds": 2.85,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.64,
      "end_seconds": 45.05,
      "duration_seconds": 2.41,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.6,
      "end_seconds": 63.32,
      "duration_seconds": 12.72,
      "text": "It usually comes with crushing chest pain. The crushing chest pain? That's been for three days. As for crushing chest pain, it's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.9,
      "end_seconds": 66.47,
      "duration_seconds": 2.57,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.12,
      "end_seconds": 83.38,
      "duration_seconds": 3.26,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.25,
      "end_seconds": 109.68,
      "duration_seconds": 5.43,
      "text": "Okay: blood pressure 129 over 76, heart rate 124, saturation 99 percent."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.35,
      "end_seconds": 116.17,
      "duration_seconds": 3.82,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.54,
      "end_seconds": 118.75,
      "duration_seconds": 1.21,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.8,
      "end_seconds": 130.54,
      "duration_seconds": 4.74,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.09,
      "end_seconds": 134.8,
      "duration_seconds": 1.71,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.69,
      "end_seconds": 157.61,
      "duration_seconds": 3.92,
      "text": "Have you noticed cough, fever or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.2,
      "end_seconds": 161.94,
      "duration_seconds": 3.74,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.06,
      "end_seconds": 165.04,
      "duration_seconds": 1.98,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.81,
      "end_seconds": 169.62,
      "duration_seconds": 2.81,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.92,
      "end_seconds": 173.91,
      "duration_seconds": 2.99,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.51,
      "end_seconds": 176.41,
      "duration_seconds": 0.9,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.38,
      "end_seconds": 182.34,
      "duration_seconds": 4.96,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.4,
      "end_seconds": 184.89,
      "duration_seconds": 1.49,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.03,
      "end_seconds": 189.39,
      "duration_seconds": 3.36,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.87,
      "end_seconds": 198.56,
      "duration_seconds": 3.69,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.44,
      "end_seconds": 201.56,
      "duration_seconds": 2.12,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.21,
      "end_seconds": 207.73,
      "duration_seconds": 5.52,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.49,
      "end_seconds": 211.32,
      "duration_seconds": 2.83,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.38,
      "end_seconds": 215.79,
      "duration_seconds": 3.41,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.95,
      "end_seconds": 221.24,
      "duration_seconds": 4.29,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.11,
      "end_seconds": 227.84,
      "duration_seconds": 4.73,
      "text": "I'm on hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.26,
      "end_seconds": 234.7,
      "duration_seconds": 6.44,
      "text": "Okay, go on. So, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.2,
      "end_seconds": 238.03,
      "duration_seconds": 2.83,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.92,
      "end_seconds": 242.2,
      "duration_seconds": 2.28,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.28,
      "end_seconds": 246.13,
      "duration_seconds": 2.85,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.75,
      "end_seconds": 261.51,
      "duration_seconds": 14.76,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Okay, so my impression is this: I think we're dealing with a possible heart attack at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.71,
      "end_seconds": 264.58,
      "duration_seconds": 1.87,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.88,
      "end_seconds": 278.77,
      "duration_seconds": 9.89,
      "text": "I understand the worry. At the moment I'd say it's a possible heart attack, and we'll know more once the an ECG is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.86,
      "end_seconds": 301.15,
      "duration_seconds": 4.29,
      "text": "I'll request an ECG, it'll help with chest pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 301.87,
      "end_seconds": 306.94,
      "duration_seconds": 5.07,
      "text": "We have a slot Wednesday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.16,
      "end_seconds": 310.45,
      "duration_seconds": 2.29,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.22,
      "end_seconds": 334.51,
      "duration_seconds": 22.29,
      "text": "I'm prescribing aspirin, 300 milligrams, once now, single dose. You take it by mouth. That's for possible heart attack. Stay lying down and do not eat or drink. A troponin blood test is something we might do if this doesn't improve next month. If the pain returns, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.33,
      "end_seconds": 338.72,
      "duration_seconds": 2.39,
      "text": "Alright, um, I follow."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.34,
      "end_seconds": 346.55,
      "duration_seconds": 7.21,
      "text": "I'd like to see you again straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.47,
      "end_seconds": 351.75,
      "duration_seconds": 3.28,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}