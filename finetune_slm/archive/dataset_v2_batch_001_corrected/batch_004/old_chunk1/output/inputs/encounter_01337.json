{
  "schema_version": "1.0",
  "encounter_id": "01337",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.23,
      "duration_seconds": 3.88,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.55,
      "end_seconds": 12.72,
      "duration_seconds": 4.17,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.78,
      "end_seconds": 24.62,
      "duration_seconds": 10.84,
      "text": "Yeah, it's a runny nose. I don't know what's causing it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.04,
      "end_seconds": 29.54,
      "duration_seconds": 3.5,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.29,
      "end_seconds": 33.38,
      "duration_seconds": 2.09,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.82,
      "end_seconds": 40.06,
      "duration_seconds": 5.24,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.43,
      "end_seconds": 50.77,
      "duration_seconds": 9.34,
      "text": "I'd say severe. Only tissues, and it's not much. I've had a mild cough too, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.32,
      "end_seconds": 70.26,
      "duration_seconds": 2.94,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.74,
      "end_seconds": 84.16,
      "duration_seconds": 2.42,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.06,
      "end_seconds": 106.78,
      "duration_seconds": 11.72,
      "text": "Okay: temperature 36.9, heart rate 83, BMI works out to 32.7, height 173 centimetres, respiratory rate 16, weight 98 kilos, blood pressure 118 over 68."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.46,
      "end_seconds": 110.82,
      "duration_seconds": 2.36,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.88,
      "end_seconds": 114.43,
      "duration_seconds": 1.55,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.52,
      "end_seconds": 117.86,
      "duration_seconds": 2.34,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.24,
      "end_seconds": 139.17,
      "duration_seconds": 4.93,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.38,
      "end_seconds": 148.36,
      "duration_seconds": 3.98,
      "text": "All finished, thank you. How about ear pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.44,
      "end_seconds": 152.59,
      "duration_seconds": 2.15,
      "text": "No ear pain, thankfully."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.04,
      "end_seconds": 159.46,
      "duration_seconds": 3.42,
      "text": "Any chest pain, shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.25,
      "end_seconds": 163.89,
      "duration_seconds": 3.64,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.51,
      "end_seconds": 171.54,
      "duration_seconds": 3.03,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.14,
      "end_seconds": 174.92,
      "duration_seconds": 2.78,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.42,
      "end_seconds": 176.96,
      "duration_seconds": 1.54,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.24,
      "end_seconds": 183.19,
      "duration_seconds": 1.95,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.39,
      "end_seconds": 197.02,
      "duration_seconds": 6.63,
      "text": "Are you taking anything regularly, including from the pharmacy? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.92,
      "end_seconds": 201.87,
      "duration_seconds": 2.95,
      "text": "It's atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 206.47,
      "duration_seconds": 4.09,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.42,
      "end_seconds": 210.93,
      "duration_seconds": 2.51,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.88,
      "end_seconds": 216.66,
      "duration_seconds": 3.78,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.96,
      "end_seconds": 219.43,
      "duration_seconds": 1.47,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.13,
      "end_seconds": 227.07,
      "duration_seconds": 6.94,
      "text": "Alright, high cholesterol, that matches what I have here. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.71,
      "end_seconds": 248.62,
      "duration_seconds": 19.91,
      "text": "I'll have a glass of wine with dinner. I smoke roughly a pack every two days. I walk the dog every morning. I'm a plumber, lots of bending and kneeling. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.17,
      "end_seconds": 250.39,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.19,
      "end_seconds": 253.92,
      "duration_seconds": 1.73,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.08,
      "end_seconds": 269.67,
      "duration_seconds": 7.59,
      "text": "From what you've told me and what I found, it points towards a simple viral cold."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.72,
      "end_seconds": 298.84,
      "duration_seconds": 21.12,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. Come back or go to emergency straight away if you develop a high fever or trouble breathing. I'd like to see you again if it is not better in ten days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.22,
      "end_seconds": 302.35,
      "duration_seconds": 2.13,
      "text": "Alright, thanks, take care."
    }
  ]
}