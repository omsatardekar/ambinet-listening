  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 6.76,
      "duration_seconds": 5.75,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.41,
      "end_seconds": 12.51,
      "duration_seconds": 4.1,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.86,
      "end_seconds": 19.76,
      "duration_seconds": 5.9,
      "text": "Well, um, I've been having severe lower back pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.27,
      "end_seconds": 23.71,
      "duration_seconds": 3.44,
      "text": "Sure. How often do you get it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.32,
      "end_seconds": 28.0,
      "duration_seconds": 3.68,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.65,
      "end_seconds": 33.83,
      "duration_seconds": 5.18,
      "text": "Alright, what about trouble passing urine, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.19,
      "end_seconds": 41.38,
      "duration_seconds": 6.19,
      "text": "Yeah, uh, that too. With trouble passing urine, severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.35,
      "end_seconds": 54.81,
      "duration_seconds": 3.46,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.55,
      "end_seconds": 60.6,
      "duration_seconds": 5.05,
      "text": "I take febuxostat, 80 milligrams, maybe, once a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.33,
      "end_seconds": 70.29,
      "duration_seconds": 4.96,
      "text": "Have you got the the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.16,
      "end_seconds": 85.82,
      "duration_seconds": 14.66,
      "text": "Not with me. I'll bring it it next time. Mm, it's paracetamol, 650 milligrams, when needed for the knee pain. Though honestly, some days I forget to take it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.16,
      "end_seconds": 105.09,
      "duration_seconds": 3.93,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.5,
      "end_seconds": 109.54,
      "duration_seconds": 3.04,
      "text": "Actually, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.62,
      "end_seconds": 113.3,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.34,
      "end_seconds": 117.93,
      "duration_seconds": 3.59,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.27,
      "end_seconds": 121.92,
      "duration_seconds": 2.65,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.11,
      "end_seconds": 130.98,
      "duration_seconds": 3.87,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.62,
      "end_seconds": 136.07,
      "duration_seconds": 4.45,
      "text": "alright, what do you do during the the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.93,
      "end_seconds": 141.85,
      "duration_seconds": 3.92,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.76,
      "end_seconds": 155.88,
      "duration_seconds": 4.12,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 178.95,
      "duration_seconds": 21.96,
      "text": "I've had gout for about a year now a neighbour of mine said I should see someone about it i've, I've had arthritis in my knees for about ten years now i've never really been one for hospitals"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.9,
      "end_seconds": 186.24,
      "duration_seconds": 6.34,
      "text": "Mm, okay. Okay, I can see gout in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.79,
      "end_seconds": 189.02,
      "duration_seconds": 2.23,
      "text": "no, um, never"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.55,
      "end_seconds": 197.48,
      "duration_seconds": 4.93,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.54,
      "end_seconds": 201.23,
      "duration_seconds": 1.69,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.41,
      "end_seconds": 207.44,
      "duration_seconds": 5.03,
      "text": "Let me check a few things. Any fever or recent fall?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.96,
      "end_seconds": 211.56,
      "duration_seconds": 3.6,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.04,
      "end_seconds": 215.17,
      "duration_seconds": 2.13,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.88,
      "end_seconds": 220.17,
      "duration_seconds": 3.29,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.16,
      "end_seconds": 223.8,
      "duration_seconds": 2.64,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.73,
      "end_seconds": 235.53,
      "duration_seconds": 2.8,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.09,
      "end_seconds": 253.68,
      "duration_seconds": 7.59,
      "text": "okay: pulse 80, pressure 112 over 69, temperature 36.7, oxygen saturation is 98 percent"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.8,
      "end_seconds": 258.71,
      "duration_seconds": 3.91,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.8,
      "end_seconds": 262.55,
      "duration_seconds": 1.75,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.11,
      "end_seconds": 265.91,
      "duration_seconds": 1.8,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.11,
      "end_seconds": 285.7,
      "duration_seconds": 5.59,
      "text": "you have numbness in the saddle area and your leg strength is reduced"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.0,
      "end_seconds": 322.3,
      "duration_seconds": 34.3,
      "text": "Please sit back down. So where does that leave us? I think we're dealing with possible cauda equina syndrome needing an urgent scan at this stage. The reason I say that is that your story and my examination fit together. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Right, today I'm not changing anything. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.02,
      "end_seconds": 327.23,
      "duration_seconds": 3.21,
      "text": "Hmm, thank you, doctor, goodbye."
    }
  ]
}