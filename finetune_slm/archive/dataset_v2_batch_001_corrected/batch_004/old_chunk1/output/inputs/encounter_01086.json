{
  "schema_version": "1.0",
  "encounter_id": "01086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.54,
      "end_seconds": 2.94,
      "duration_seconds": 2.4,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.41,
      "end_seconds": 10.18,
      "duration_seconds": 2.77,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.73,
      "end_seconds": 13.66,
      "duration_seconds": 1.93,
      "text": "what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.66,
      "end_seconds": 22.72,
      "duration_seconds": 8.06,
      "text": "mainly sudden shortness of breath there's a couple of other things, but that's the main one"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.68,
      "end_seconds": 29.45,
      "duration_seconds": 4.77,
      "text": "Right, when was the the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.89,
      "end_seconds": 35.43,
      "duration_seconds": 4.54,
      "text": "It's, It's been going on for ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.37,
      "end_seconds": 40.01,
      "duration_seconds": 1.64,
      "text": "What about chest tightness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.04,
      "end_seconds": 44.31,
      "duration_seconds": 2.27,
      "text": "No chest tightness, thankfully."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.68,
      "end_seconds": 49.84,
      "duration_seconds": 4.16,
      "text": "let me check a few things any fever or wheeze?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.64,
      "end_seconds": 53.01,
      "duration_seconds": 2.37,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.0,
      "end_seconds": 60.71,
      "duration_seconds": 5.71,
      "text": "Alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.51,
      "end_seconds": 64.51,
      "duration_seconds": 2.0,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.45,
      "end_seconds": 75.97,
      "duration_seconds": 2.52,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.44,
      "end_seconds": 78.64,
      "duration_seconds": 1.2,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.13,
      "end_seconds": 93.39,
      "duration_seconds": 4.26,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.09,
      "end_seconds": 98.69,
      "duration_seconds": 4.6,
      "text": "I mean, yes, trimethoprim. I get a rash."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.7,
      "end_seconds": 104.2,
      "duration_seconds": 3.5,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.88,
      "end_seconds": 106.57,
      "duration_seconds": 1.69,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.73,
      "end_seconds": 127.32,
      "duration_seconds": 2.59,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.21,
      "end_seconds": 140.55,
      "duration_seconds": 11.34,
      "text": "I'm a hairdresser, on my feet all day. My husband and I live above the shop. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.6,
      "end_seconds": 159.24,
      "duration_seconds": 3.64,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.18,
      "end_seconds": 170.97,
      "duration_seconds": 2.79,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.89,
      "end_seconds": 197.03,
      "duration_seconds": 9.14,
      "text": "okay: respiratory rate 24, pressure 137 over 73, heart rate 95, saturation 92 percent, temp 37.0 degrees"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.65,
      "end_seconds": 204.22,
      "duration_seconds": 4.57,
      "text": "Right, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.88,
      "end_seconds": 207.21,
      "duration_seconds": 1.33,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.94,
      "end_seconds": 230.97,
      "duration_seconds": 7.03,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.71,
      "end_seconds": 252.05,
      "duration_seconds": 16.34,
      "text": "You can relax now. From what you've told me and and what I found, it's hard to say. A possible blood clot in the lung is one possibility and a chest infection another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.76,
      "end_seconds": 255.56,
      "duration_seconds": 2.8,
      "text": "Uh, will it clear up?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.39,
      "end_seconds": 278.49,
      "duration_seconds": 21.1,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible blood clot in the lung, but I'd like to confirm. I'll request a CT scan of the chest, it'll help with breathlessness. I'd like to arrange a D-dimer blood test for possible clot."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.59,
      "end_seconds": 281.99,
      "duration_seconds": 2.4,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.65,
      "end_seconds": 288.27,
      "duration_seconds": 4.62,
      "text": "you need to go to hospital now for a scan"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.67,
      "end_seconds": 303.04,
      "duration_seconds": 14.37,
      "text": "sure. We'll refer you to the medical team. Keep an eye out, and if you feel faint, call us the same day or go to emergency. See me again straight away"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.96,
      "end_seconds": 308.28,
      "duration_seconds": 3.32,
      "text": "Uh, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.92,
      "end_seconds": 315.36,
      "duration_seconds": 5.44,
      "text": "So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.02,
      "end_seconds": 320.12,
      "duration_seconds": 4.1,
      "text": "Erm, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.3,
      "end_seconds": 322.98,
      "duration_seconds": 1.68,
      "text": "So, look after yourself."
    }
  ]
}