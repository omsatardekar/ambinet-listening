{
  "schema_version": "1.0",
  "encounter_id": "01234",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.21,
      "end_seconds": 5.91,
      "duration_seconds": 4.7,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.09,
      "end_seconds": 14.33,
      "duration_seconds": 3.24,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.17,
      "end_seconds": 19.25,
      "duration_seconds": 4.08,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 20.74,
      "end_seconds": 25.91,
      "duration_seconds": 5.17,
      "text": "Well, I've been having a red hot swelling on my leg."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.11,
      "end_seconds": 34.76,
      "duration_seconds": 3.65,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.29,
      "end_seconds": 39.92,
      "duration_seconds": 3.63,
      "text": "it's been going on for about four days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.26,
      "end_seconds": 45.06,
      "duration_seconds": 4.8,
      "text": "Okay, go on. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.73,
      "end_seconds": 50.93,
      "duration_seconds": 4.2,
      "text": "I'd give it a six, out of ten"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.09,
      "end_seconds": 54.18,
      "duration_seconds": 2.09,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 56.25,
      "end_seconds": 58.6,
      "duration_seconds": 2.35,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.05,
      "end_seconds": 65.53,
      "duration_seconds": 6.48,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 65.63,
      "end_seconds": 71.19,
      "duration_seconds": 5.56,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.55,
      "end_seconds": 75.0,
      "duration_seconds": 2.45,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.31,
      "end_seconds": 82.57,
      "duration_seconds": 6.26,
      "text": "that's fine, one at a time i'll ask about everything any dark blisters as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.77,
      "end_seconds": 90.7,
      "duration_seconds": 6.93,
      "text": "Yes, for about four days. There's pain much worse than it looks as well."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.73,
      "end_seconds": 97.57,
      "duration_seconds": 4.84,
      "text": "okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.5,
      "end_seconds": 107.17,
      "duration_seconds": 7.67,
      "text": "it happens once or twice a day. It's worse with touch. And a high fever, too"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 110.66,
      "end_seconds": 112.76,
      "duration_seconds": 2.1,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 113.88,
      "end_seconds": 125.24,
      "duration_seconds": 11.36,
      "text": "Doctor, I've got the readings for you. Temp 38.4 degrees, respiratory rate 16, pulse is 94 beats a minute, pressure 106 over 68."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.24,
      "end_seconds": 127.94,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.88,
      "end_seconds": 134.39,
      "duration_seconds": 4.51,
      "text": "Let me look at the the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.36,
      "end_seconds": 137.06,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.63,
      "end_seconds": 139.92,
      "duration_seconds": 1.29,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.4,
      "end_seconds": 160.79,
      "duration_seconds": 8.39,
      "text": "the skin on your leg is dusky with blisters and is very tender, and you are feverish"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.11,
      "end_seconds": 171.25,
      "duration_seconds": 6.14,
      "text": "thank you, you can get dressed a few quick ones: insect bite or cut?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.18,
      "end_seconds": 175.06,
      "duration_seconds": 2.88,
      "text": "No, no insect bite or cut."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.43,
      "end_seconds": 183.39,
      "duration_seconds": 2.96,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.41,
      "end_seconds": 187.12,
      "duration_seconds": 1.71,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.79,
      "end_seconds": 191.1,
      "duration_seconds": 3.31,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.87,
      "end_seconds": 195.3,
      "duration_seconds": 2.43,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.73,
      "end_seconds": 206.14,
      "duration_seconds": 3.41,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.23,
      "end_seconds": 211.61,
      "duration_seconds": 2.38,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.49,
      "end_seconds": 216.6,
      "duration_seconds": 3.11,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_6",
      "role": "FAMILY_MEMBER",
      "start_seconds": 218.1,
      "end_seconds": 230.31,
      "duration_seconds": 12.21,
      "text": "right, uh, he is on glibenclamide, 5 milligrams, before breakfast, I give it to him it's hydrocortisone cream, when needed for the eczema, doctor"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 240.62,
      "duration_seconds": 4.74,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.7,
      "end_seconds": 245.2,
      "duration_seconds": 2.5,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_6",
      "role": "FAMILY_MEMBER",
      "start_seconds": 247.16,
      "end_seconds": 255.11,
      "duration_seconds": 7.95,
      "text": "Actually, I remember he had some kind of reaction to to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 256.63,
      "end_seconds": 259.2,
      "duration_seconds": 2.57,
      "text": "Actually, I don't remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.66,
      "end_seconds": 268.73,
      "duration_seconds": 8.07,
      "text": "Alright, so that's unclear. I'll record what each of you said. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.41,
      "end_seconds": 273.05,
      "duration_seconds": 3.64,
      "text": "I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.34,
      "end_seconds": 276.04,
      "duration_seconds": 1.7,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 277.18,
      "end_seconds": 281.44,
      "duration_seconds": 4.26,
      "text": "oh, I've had eczema for two years now"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.42,
      "end_seconds": 297.69,
      "duration_seconds": 3.27,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 298.19,
      "end_seconds": 301.11,
      "duration_seconds": 2.92,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.05,
      "end_seconds": 317.34,
      "duration_seconds": 14.29,
      "text": "So where does that leave us? It's hard to say. A severe deep skin infection needing urgent surgery review is one possibility and severe cellulitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.13,
      "end_seconds": 320.49,
      "duration_seconds": 2.36,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.55,
      "end_seconds": 337.57,
      "duration_seconds": 16.02,
      "text": "It's reasonable to to be concerned, but right now a severe deep skin infection needing urgent surgery review is my leading thought, not anything worse. I want urgent blood tests done, that's for severe skin infection."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 338.18,
      "end_seconds": 343.83,
      "duration_seconds": 5.65,
      "text": "Sorry, what was I saying, do I need to prepare?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.38,
      "end_seconds": 369.6,
      "duration_seconds": 24.22,
      "text": "I want an urgent surgical review done, that's for possible necrotising infection. I am sending you to hospital now, do not wait. Let's get you seen by the surgical team, I'll arrange the letter. I'd like you back straight away. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 371.54,
      "end_seconds": 376.42,
      "duration_seconds": 4.88,
      "text": "so, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.81,
      "end_seconds": 384.75,
      "duration_seconds": 3.94,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 385.96,
      "end_seconds": 388.05,
      "duration_seconds": 2.09,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.77,
      "end_seconds": 391.13,
      "duration_seconds": 1.36,
      "text": "Look after yourself."
    }
  ]
}