{
  "schema_version": "1.0",
  "encounter_id": "01496",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.4,
      "end_seconds": 6.57,
      "duration_seconds": 5.17,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.88,
      "end_seconds": 11.85,
      "duration_seconds": 3.97,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.8,
      "end_seconds": 16.92,
      "duration_seconds": 2.12,
      "text": "I've been feeling well."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.73,
      "end_seconds": 20.6,
      "duration_seconds": 2.87,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.65,
      "end_seconds": 33.03,
      "duration_seconds": 2.38,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.83,
      "end_seconds": 64.03,
      "duration_seconds": 12.2,
      "text": "Okay: BMI works out to 31.6, blood pressure 120 over 72, height 151 centimetres. And saturation 98 percent, pulse is 83 beats a minute, weight 72 kilos."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.04,
      "end_seconds": 80.33,
      "duration_seconds": 3.29,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.01,
      "end_seconds": 85.71,
      "duration_seconds": 3.7,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.92,
      "end_seconds": 89.98,
      "duration_seconds": 4.06,
      "text": "Yes, carry on. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.05,
      "end_seconds": 96.63,
      "duration_seconds": 4.58,
      "text": "I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.13,
      "end_seconds": 99.72,
      "duration_seconds": 2.59,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.86,
      "end_seconds": 118.3,
      "duration_seconds": 17.44,
      "text": "I mean, uh, it usually comes with slightly dry skin. I mean, as for slightly dry skin, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.84,
      "end_seconds": 121.07,
      "duration_seconds": 1.23,
      "text": "Nothing like palpitations?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.0,
      "end_seconds": 127.88,
      "duration_seconds": 4.88,
      "text": "No, um, I haven't had any palpitations."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.1,
      "end_seconds": 134.7,
      "duration_seconds": 6.6,
      "text": "Mm, okay. Let me check a few things. Any constipation, weight change or feeling cold?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.41,
      "end_seconds": 141.88,
      "duration_seconds": 5.47,
      "text": "No constipation, weight change or feeling cold, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.4,
      "end_seconds": 146.97,
      "duration_seconds": 4.57,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.67,
      "end_seconds": 150.82,
      "duration_seconds": 2.15,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.88,
      "end_seconds": 153.94,
      "duration_seconds": 2.06,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.14,
      "end_seconds": 157.81,
      "duration_seconds": 2.67,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.82,
      "end_seconds": 165.63,
      "duration_seconds": 4.81,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.57,
      "end_seconds": 178.35,
      "duration_seconds": 11.78,
      "text": "An underactive thyroid, for five years. I didn't want to bother you but it keeps coming back. I've got gout."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.56,
      "end_seconds": 187.87,
      "duration_seconds": 8.31,
      "text": "Yes, gout is known to us, good to have that clear. Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.82,
      "end_seconds": 193.94,
      "duration_seconds": 4.12,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.61,
      "end_seconds": 195.9,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.0,
      "end_seconds": 200.4,
      "duration_seconds": 3.4,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.76,
      "end_seconds": 206.7,
      "duration_seconds": 2.94,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.13,
      "end_seconds": 209.84,
      "duration_seconds": 1.71,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.8,
      "end_seconds": 215.37,
      "duration_seconds": 4.57,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.38,
      "end_seconds": 220.03,
      "duration_seconds": 2.65,
      "text": "I take Thyronorm, every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.84,
      "end_seconds": 223.17,
      "duration_seconds": 2.33,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.83,
      "end_seconds": 230.94,
      "duration_seconds": 7.11,
      "text": "It's 50 micrograms. Uh, I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.81,
      "end_seconds": 235.56,
      "duration_seconds": 2.75,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.45,
      "end_seconds": 238.81,
      "duration_seconds": 2.36,
      "text": "Nearly five years now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.04,
      "end_seconds": 244.39,
      "duration_seconds": 3.35,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.36,
      "end_seconds": 247.63,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.55,
      "end_seconds": 266.11,
      "duration_seconds": 4.56,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.54,
      "end_seconds": 271.95,
      "duration_seconds": 2.41,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.47,
      "end_seconds": 285.09,
      "duration_seconds": 5.62,
      "text": "Let me tell you where I've got to. It points towards well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.76,
      "end_seconds": 290.32,
      "duration_seconds": 3.56,
      "text": "Yeah, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.33,
      "end_seconds": 298.43,
      "duration_seconds": 6.1,
      "text": "Nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.36,
      "end_seconds": 305.9,
      "duration_seconds": 5.54,
      "text": "Should I have a thyroid blood test as well?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.39,
      "end_seconds": 322.11,
      "duration_seconds": 14.72,
      "text": "I wouldn't order it today. If anything changes, we'll reconsider. Alright, there's nothing new for me to start or arrange today. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.67,
      "end_seconds": 326.09,
      "duration_seconds": 2.42,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}