{
  "schema_version": "1.0",
  "encounter_id": "01189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 4.61,
      "duration_seconds": 3.65,
      "text": "Right, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 11.45,
      "duration_seconds": 5.12,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.58,
      "end_seconds": 16.82,
      "duration_seconds": 4.24,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.37,
      "end_seconds": 21.61,
      "duration_seconds": 3.24,
      "text": "So, I've been feeling well, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.2,
      "end_seconds": 25.0,
      "duration_seconds": 2.8,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.99,
      "end_seconds": 32.15,
      "duration_seconds": 5.16,
      "text": "I'd give it a four, you know, out of ten."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.03,
      "end_seconds": 35.01,
      "duration_seconds": 1.98,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.41,
      "end_seconds": 43.11,
      "duration_seconds": 6.7,
      "text": "Slightly dry skin goes along with it, um, most of the time."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 43.94,
      "end_seconds": 46.32,
      "duration_seconds": 2.38,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.5,
      "end_seconds": 51.83,
      "duration_seconds": 4.33,
      "text": "Any feeling cold, weight change or constipation at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.9,
      "end_seconds": 56.54,
      "duration_seconds": 2.64,
      "text": "Yeah, none of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.33,
      "end_seconds": 60.49,
      "duration_seconds": 2.16,
      "text": "Did you notice any palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.03,
      "end_seconds": 67.36,
      "duration_seconds": 3.33,
      "text": "Not that I've noticed, no palpitations."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 68.79,
      "end_seconds": 73.64,
      "duration_seconds": 4.85,
      "text": "Actually, doctor, I did notice palpitations. She doesn't always say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.26,
      "end_seconds": 82.02,
      "duration_seconds": 6.76,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.53,
      "end_seconds": 89.41,
      "duration_seconds": 6.88,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.44,
      "end_seconds": 96.0,
      "duration_seconds": 2.56,
      "text": "So, no problems with breathing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.84,
      "end_seconds": 99.89,
      "duration_seconds": 3.05,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.11,
      "end_seconds": 103.39,
      "duration_seconds": 2.28,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.6,
      "end_seconds": 107.32,
      "duration_seconds": 2.72,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.1,
      "end_seconds": 112.81,
      "duration_seconds": 3.71,
      "text": "An underactive thyroid, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.57,
      "end_seconds": 114.54,
      "duration_seconds": 0.97,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.49,
      "end_seconds": 118.19,
      "duration_seconds": 1.7,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.88,
      "end_seconds": 120.3,
      "duration_seconds": 1.42,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.82,
      "end_seconds": 123.77,
      "duration_seconds": 1.95,
      "text": "Depression, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.65,
      "end_seconds": 136.52,
      "duration_seconds": 11.87,
      "text": "Okay, I can see an underactive thyroid and high cholesterol in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.02,
      "end_seconds": 146.18,
      "duration_seconds": 9.16,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.23,
      "end_seconds": 150.63,
      "duration_seconds": 2.4,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.97,
      "end_seconds": 158.31,
      "duration_seconds": 6.34,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.17,
      "end_seconds": 163.35,
      "duration_seconds": 4.18,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.88,
      "end_seconds": 169.89,
      "duration_seconds": 5.01,
      "text": "My father had bowel cancer. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.35,
      "end_seconds": 186.77,
      "duration_seconds": 1.42,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.27,
      "end_seconds": 197.19,
      "duration_seconds": 4.92,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.55,
      "end_seconds": 201.99,
      "duration_seconds": 3.44,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.15,
      "end_seconds": 207.91,
      "duration_seconds": 4.76,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.96,
      "end_seconds": 226.04,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.0,
      "end_seconds": 236.52,
      "duration_seconds": 8.52,
      "text": "Atorvastatin, 20 milligrams, at night for my cholesterol. Sertraline, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.93,
      "end_seconds": 242.16,
      "duration_seconds": 4.23,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.49,
      "end_seconds": 255.29,
      "duration_seconds": 8.8,
      "text": "Not with me. I'll bring it next time. I had rosuvastatin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.89,
      "end_seconds": 259.49,
      "duration_seconds": 3.6,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.89,
      "end_seconds": 269.79,
      "duration_seconds": 2.9,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.13,
      "end_seconds": 301.78,
      "duration_seconds": 11.65,
      "text": "Okay: height 158 centimetres, SpO2 98 percent on room air, blood pressure 119 over 72, temp 36.6 degrees, weight 90 kilos, respiratory rate 15, heart rate 69."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.67,
      "end_seconds": 305.23,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.11,
      "end_seconds": 313.45,
      "duration_seconds": 7.34,
      "text": "I'll interpret them after the examination. Going by what you've described, I'd lean towards well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.47,
      "end_seconds": 319.79,
      "duration_seconds": 4.32,
      "text": "I'm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.23,
      "end_seconds": 333.16,
      "duration_seconds": 11.93,
      "text": "I can't promise yet, but most people with well-controlled thyroid replacement do well once it's treated properly. I'd like to arrange a thyroid blood test for annual review."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 334.65,
      "end_seconds": 339.23,
      "duration_seconds": 4.58,
      "text": "We have a slot Wednesday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.13,
      "end_seconds": 356.63,
      "duration_seconds": 15.5,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.66,
      "end_seconds": 361.53,
      "duration_seconds": 2.87,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.61,
      "end_seconds": 366.0,
      "duration_seconds": 3.39,
      "text": "I'd like you back in twelve months."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.91,
      "end_seconds": 369.84,
      "duration_seconds": 1.93,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.57,
      "end_seconds": 373.94,
      "duration_seconds": 2.37,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.36,
      "end_seconds": 379.91,
      "duration_seconds": 2.55,
      "text": "Yeah, thank you, that's helpful."
    }
  ]
}