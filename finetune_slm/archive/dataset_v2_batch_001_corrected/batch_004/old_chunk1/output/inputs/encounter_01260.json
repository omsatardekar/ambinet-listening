{
  "schema_version": "1.0",
  "encounter_id": "01260",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.08,
      "duration_seconds": 3.32,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.67,
      "end_seconds": 9.4,
      "duration_seconds": 3.73,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.74,
      "end_seconds": 15.1,
      "duration_seconds": 4.36,
      "text": "It's pain going into my left arm, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.74,
      "end_seconds": 20.38,
      "duration_seconds": 3.64,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.27,
      "end_seconds": 32.66,
      "duration_seconds": 11.39,
      "text": "Yesterday, it came on out of nowhere. I'm hoping you can tell me something definite. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.18,
      "end_seconds": 35.68,
      "duration_seconds": 2.5,
      "text": "Yes. How frequently does it come?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.75,
      "end_seconds": 41.36,
      "duration_seconds": 3.61,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.11,
      "end_seconds": 47.03,
      "duration_seconds": 3.92,
      "text": "A few quick ones: leg swelling or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 52.76,
      "duration_seconds": 3.7,
      "text": "I haven't had leg swelling or fever, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.81,
      "end_seconds": 55.09,
      "duration_seconds": 1.28,
      "text": "How about cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.53,
      "end_seconds": 58.96,
      "duration_seconds": 2.43,
      "text": "Not at all, no cough."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.44,
      "end_seconds": 62.89,
      "duration_seconds": 2.45,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.83,
      "end_seconds": 65.65,
      "duration_seconds": 1.82,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.57,
      "end_seconds": 78.94,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.71,
      "end_seconds": 83.78,
      "duration_seconds": 3.07,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.36,
      "end_seconds": 87.3,
      "duration_seconds": 2.94,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.65,
      "end_seconds": 92.22,
      "duration_seconds": 3.57,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.25,
      "end_seconds": 96.77,
      "duration_seconds": 2.52,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.68,
      "end_seconds": 101.32,
      "duration_seconds": 3.64,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.78,
      "end_seconds": 121.0,
      "duration_seconds": 4.22,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.84,
      "end_seconds": 123.88,
      "duration_seconds": 2.04,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.23,
      "end_seconds": 143.65,
      "duration_seconds": 2.42,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.3,
      "end_seconds": 152.43,
      "duration_seconds": 3.13,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.26,
      "end_seconds": 166.59,
      "duration_seconds": 4.33,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.0,
      "end_seconds": 175.55,
      "duration_seconds": 2.55,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.92,
      "end_seconds": 193.48,
      "duration_seconds": 6.56,
      "text": "Okay: pulse 104, oxygen saturation is 97 percent, blood pressure 112 over 84."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.03,
      "end_seconds": 197.13,
      "duration_seconds": 3.1,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.39,
      "end_seconds": 202.19,
      "duration_seconds": 3.8,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.88,
      "end_seconds": 208.96,
      "duration_seconds": 4.08,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.5,
      "end_seconds": 211.2,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.18,
      "end_seconds": 213.39,
      "duration_seconds": 1.21,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.66,
      "end_seconds": 235.08,
      "duration_seconds": 4.42,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.1,
      "end_seconds": 249.4,
      "duration_seconds": 10.3,
      "text": "Okay, that's all I needed to check. From what you've told me and what I found, this looks most like a possible heart attack."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.15,
      "end_seconds": 252.97,
      "duration_seconds": 2.82,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.22,
      "end_seconds": 277.18,
      "duration_seconds": 22.96,
      "text": "I can't promise yet, but most people with a possible heart attack do well once it's treated properly. I'm going to order a troponin blood test, for chest pain. It's a routine test and it'll give us a much clearer picture. Let's use aspirin, 300 milligrams, once now, single dose. It's for possible heart attack."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.88,
      "end_seconds": 279.4,
      "duration_seconds": 1.52,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.63,
      "end_seconds": 305.21,
      "duration_seconds": 24.58,
      "text": "Stay lying down and do not eat or drink. The cardiac team would be the right next step, I'll refer you. The thing that would worry me is if the pain returns. If that happens, go to emergency. I'd like you back straight away. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.55,
      "end_seconds": 309.55,
      "duration_seconds": 3.0,
      "text": "Great, thank you for your help."
    }
  ]
}