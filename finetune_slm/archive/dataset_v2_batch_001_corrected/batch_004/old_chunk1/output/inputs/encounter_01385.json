{
  "schema_version": "1.0",
  "encounter_id": "01385",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.87,
      "end_seconds": 9.97,
      "duration_seconds": 9.1,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.75,
      "end_seconds": 16.32,
      "duration_seconds": 4.57,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.97,
      "end_seconds": 26.6,
      "duration_seconds": 8.63,
      "text": "Honestly, it's a red hot swelling on my leg, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.98,
      "end_seconds": 29.57,
      "duration_seconds": 1.59,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 34.23,
      "end_seconds": 37.22,
      "duration_seconds": 2.99,
      "text": "For about three months, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.52,
      "end_seconds": 41.5,
      "duration_seconds": 2.98,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.13,
      "end_seconds": 56.0,
      "duration_seconds": 10.87,
      "text": "Moderate, really. There's dark blisters as well. And there's pain much worse than it looks as well, about two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.63,
      "end_seconds": 67.02,
      "duration_seconds": 9.39,
      "text": "Alright, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.55,
      "end_seconds": 76.63,
      "duration_seconds": 8.08,
      "text": "Ah, yes, touch. That makes it worse. A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.65,
      "end_seconds": 84.45,
      "duration_seconds": 6.8,
      "text": "Have you had a red hot swelling on your leg before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.41,
      "end_seconds": 91.86,
      "duration_seconds": 5.45,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.16,
      "end_seconds": 97.01,
      "duration_seconds": 3.85,
      "text": "So, and what about insect bite or cut?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.52,
      "end_seconds": 102.64,
      "duration_seconds": 4.12,
      "text": "I haven't had insect bite or cut, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.54,
      "end_seconds": 105.65,
      "duration_seconds": 2.11,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.31,
      "end_seconds": 107.28,
      "duration_seconds": 0.97,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.29,
      "end_seconds": 112.43,
      "duration_seconds": 4.14,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.18,
      "end_seconds": 118.04,
      "duration_seconds": 4.86,
      "text": "Sorry, what was I saying, no, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.63,
      "end_seconds": 123.47,
      "duration_seconds": 3.84,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.35,
      "end_seconds": 133.0,
      "duration_seconds": 7.65,
      "text": "Glycomet. I take it 500 milligrams, twice a day. It's allopurinol, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.3,
      "end_seconds": 142.49,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.28,
      "end_seconds": 146.13,
      "duration_seconds": 2.85,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.16,
      "end_seconds": 149.97,
      "duration_seconds": 2.81,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.76,
      "end_seconds": 156.07,
      "duration_seconds": 4.31,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.12,
      "end_seconds": 176.72,
      "duration_seconds": 2.6,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.03,
      "end_seconds": 181.44,
      "duration_seconds": 3.41,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.86,
      "end_seconds": 203.56,
      "duration_seconds": 3.7,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.57,
      "end_seconds": 224.78,
      "duration_seconds": 19.21,
      "text": "Diabetes, for about ten years. I've, I've had gout for about a year now. I thought it would sort itself out, uh, but it hasn't. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.81,
      "end_seconds": 227.36,
      "duration_seconds": 1.55,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.28,
      "end_seconds": 234.01,
      "duration_seconds": 4.73,
      "text": "Yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 235.22,
      "end_seconds": 242.64,
      "duration_seconds": 7.42,
      "text": "Doctor, I've got the readings for you. Heart rate 90, temp 38.7 degrees, pressure 126 over 73."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.35,
      "end_seconds": 245.36,
      "duration_seconds": 1.01,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.09,
      "end_seconds": 251.28,
      "duration_seconds": 3.19,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.17,
      "end_seconds": 254.03,
      "duration_seconds": 1.86,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.13,
      "end_seconds": 268.87,
      "duration_seconds": 7.74,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.2,
      "end_seconds": 310.21,
      "duration_seconds": 38.01,
      "text": "Right, you can relax now. Okay, thinking it through, this looks most like a severe deep skin infection needing urgent surgery review. I'd like to arrange urgent blood tests for severe skin infection. I'm going to order an urgent surgical review, for possible necrotising infection. The result will help us decide whether anything more is needed. I am sending you to hospital now, do not wait. Please take the tablets with food so they don't upset your stomach."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.52,
      "end_seconds": 320.06,
      "duration_seconds": 5.54,
      "text": "The surgical team would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.64,
      "end_seconds": 321.34,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.95,
      "end_seconds": 328.43,
      "duration_seconds": 6.48,
      "text": "Let's plan a check straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.92,
      "end_seconds": 331.67,
      "duration_seconds": 1.75,
      "text": "That's clear, thanks."
    }
  ]
}