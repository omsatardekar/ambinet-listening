{
  "schema_version": "1.0",
  "encounter_id": "01343",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.57,
      "end_seconds": 4.36,
      "duration_seconds": 3.79,
      "text": "So, hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.25,
      "end_seconds": 8.26,
      "duration_seconds": 3.01,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.21,
      "end_seconds": 14.71,
      "duration_seconds": 2.5,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.62,
      "end_seconds": 22.91,
      "duration_seconds": 6.29,
      "text": "So the thing is, I've got my face drooping on one side."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.36,
      "end_seconds": 26.83,
      "duration_seconds": 2.47,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.88,
      "end_seconds": 40.51,
      "duration_seconds": 2.63,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.97,
      "end_seconds": 63.4,
      "duration_seconds": 5.43,
      "text": "Okay: temperature 36.7, BP is 168 over 103, heart rate 87."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.27,
      "end_seconds": 66.67,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.31,
      "end_seconds": 72.01,
      "duration_seconds": 3.7,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.49,
      "end_seconds": 82.48,
      "duration_seconds": 2.99,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.96,
      "end_seconds": 86.65,
      "duration_seconds": 2.69,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.47,
      "end_seconds": 93.04,
      "duration_seconds": 4.57,
      "text": "What about weakness in your right arm, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.82,
      "end_seconds": 97.17,
      "duration_seconds": 3.35,
      "text": "Ah, yes, for about three months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.97,
      "end_seconds": 102.0,
      "duration_seconds": 4.03,
      "text": "Have you noticed fever, loss of consciousness or seizure?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.01,
      "end_seconds": 106.23,
      "duration_seconds": 2.22,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.74,
      "end_seconds": 110.24,
      "duration_seconds": 3.5,
      "text": "Right, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.07,
      "end_seconds": 114.14,
      "duration_seconds": 3.07,
      "text": "No, um, that's all fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.0,
      "end_seconds": 118.82,
      "duration_seconds": 2.82,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.9,
      "end_seconds": 129.3,
      "duration_seconds": 9.4,
      "text": "High blood pressure, for about ten years. I've had an irregular heartbeat for about ten years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.79,
      "end_seconds": 144.91,
      "duration_seconds": 11.12,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.39,
      "end_seconds": 155.46,
      "duration_seconds": 9.07,
      "text": "I walk the dog every morning. My partner and our baby. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.96,
      "end_seconds": 162.71,
      "duration_seconds": 3.75,
      "text": "Okay, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.69,
      "end_seconds": 168.21,
      "duration_seconds": 4.52,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.66,
      "end_seconds": 171.85,
      "duration_seconds": 2.19,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.97,
      "end_seconds": 185.12,
      "duration_seconds": 9.15,
      "text": "Lisinopril. I take it 10 milligrams, once a day for my pressure. Apixaban, 5 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.16,
      "end_seconds": 189.64,
      "duration_seconds": 3.48,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.88,
      "end_seconds": 194.71,
      "duration_seconds": 3.83,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.98,
      "end_seconds": 199.67,
      "duration_seconds": 3.69,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 217.66,
      "end_seconds": 219.84,
      "duration_seconds": 2.18,
      "text": "Okay, you know, doctor."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.43,
      "end_seconds": 223.21,
      "duration_seconds": 1.78,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.6,
      "end_seconds": 245.45,
      "duration_seconds": 6.85,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.43,
      "end_seconds": 279.35,
      "duration_seconds": 29.92,
      "text": "Thank you, you can get dressed. Taking everything into account, my working impression is a possible stroke, within the treatment window. The reason I say that is that your story and my examination fit together. It could also be a migraine with aura, so we'll keep that open. I think a blood sugar test makes sense here, for stroke symptoms. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.15,
      "end_seconds": 300.02,
      "duration_seconds": 18.87,
      "text": "Call an ambulance now, you need hospital immediately. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.83,
      "end_seconds": 303.68,
      "duration_seconds": 2.85,
      "text": "Oh, alright, thanks, take care."
    }
  ]
}