{
  "schema_version": "1.0",
  "encounter_id": "01151",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.18,
      "duration_seconds": 4.34,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 9.69,
      "duration_seconds": 3.69,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.56,
      "end_seconds": 18.25,
      "duration_seconds": 6.69,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.98,
      "end_seconds": 21.8,
      "duration_seconds": 2.82,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.21,
      "end_seconds": 26.23,
      "duration_seconds": 3.02,
      "text": "She's been having vomiting blood, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.86,
      "end_seconds": 30.46,
      "duration_seconds": 3.6,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.97,
      "end_seconds": 33.54,
      "duration_seconds": 2.57,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.51,
      "end_seconds": 37.32,
      "duration_seconds": 2.81,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.2,
      "end_seconds": 55.75,
      "duration_seconds": 16.55,
      "text": "Black tarry stools goes along with it, most of the time. The black tarry stools? That's been for about a month. About black tarry stools, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.65,
      "end_seconds": 62.55,
      "duration_seconds": 5.9,
      "text": "Have you had vomiting blood before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 70.36,
      "duration_seconds": 6.16,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.19,
      "end_seconds": 75.94,
      "duration_seconds": 3.75,
      "text": "Right, did you get fever or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.91,
      "end_seconds": 80.31,
      "duration_seconds": 2.4,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.96,
      "end_seconds": 83.87,
      "duration_seconds": 2.91,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.42,
      "end_seconds": 86.84,
      "duration_seconds": 1.42,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.19,
      "end_seconds": 90.15,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.73,
      "end_seconds": 92.74,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.73,
      "end_seconds": 97.19,
      "duration_seconds": 2.46,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.01,
      "end_seconds": 108.0,
      "duration_seconds": 8.99,
      "text": "It's alendronate, 70 milligrams, once a week. It's ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.33,
      "end_seconds": 111.79,
      "duration_seconds": 3.46,
      "text": "Yes. Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.41,
      "end_seconds": 114.87,
      "duration_seconds": 1.46,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.62,
      "end_seconds": 121.61,
      "duration_seconds": 4.99,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.15,
      "end_seconds": 126.11,
      "duration_seconds": 2.96,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.72,
      "end_seconds": 141.11,
      "duration_seconds": 4.39,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.12,
      "end_seconds": 144.38,
      "duration_seconds": 2.26,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.82,
      "end_seconds": 151.16,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.95,
      "end_seconds": 153.88,
      "duration_seconds": 1.93,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.18,
      "end_seconds": 156.97,
      "duration_seconds": 1.79,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.7,
      "end_seconds": 162.22,
      "duration_seconds": 4.52,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.05,
      "end_seconds": 163.84,
      "duration_seconds": 0.79,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.83,
      "end_seconds": 167.24,
      "duration_seconds": 2.41,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.26,
      "end_seconds": 170.58,
      "duration_seconds": 2.32,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.62,
      "end_seconds": 176.2,
      "duration_seconds": 3.58,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 179.88,
      "duration_seconds": 2.91,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.9,
      "end_seconds": 186.71,
      "duration_seconds": 4.81,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.02,
      "end_seconds": 197.77,
      "duration_seconds": 3.75,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.44,
      "end_seconds": 211.4,
      "duration_seconds": 2.96,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.88,
      "end_seconds": 234.46,
      "duration_seconds": 13.58,
      "text": "Okay: height 165 centimetres, SpO2 98 percent on room air, temperature 36.8, pulse 111, weight 79 kilos, pressure 130 over 80, respiratory rate 20, BMI works out to 29.0."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.83,
      "end_seconds": 237.43,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.09,
      "end_seconds": 241.82,
      "duration_seconds": 3.73,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.98,
      "end_seconds": 245.11,
      "duration_seconds": 2.13,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.8,
      "end_seconds": 249.53,
      "duration_seconds": 2.73,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.57,
      "end_seconds": 265.68,
      "duration_seconds": 6.11,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.99,
      "end_seconds": 271.78,
      "duration_seconds": 2.79,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.98,
      "end_seconds": 301.74,
      "duration_seconds": 22.76,
      "text": "Putting it all together, I'd lean towards a possible bleeding stomach ulcer. I'll request urgent blood tests, it'll help with bleeding. Please stop the ibuprofen and do not eat or drink. Don't skip meals, and try to eat smaller portions more often through the day. Book a review straight away. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.84,
      "end_seconds": 305.19,
      "duration_seconds": 2.35,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.93,
      "end_seconds": 308.74,
      "duration_seconds": 1.81,
      "text": "Have a good day."
    }
  ]
}