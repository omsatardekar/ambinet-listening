{
  "schema_version": "1.0",
  "encounter_id": "01321",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 3.52,
      "duration_seconds": 2.14,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.82,
      "end_seconds": 12.49,
      "duration_seconds": 4.67,
      "text": "Good morning, you know, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.84,
      "end_seconds": 20.58,
      "duration_seconds": 6.74,
      "text": "I mean, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.14,
      "end_seconds": 24.07,
      "duration_seconds": 2.93,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.6,
      "end_seconds": 44.61,
      "duration_seconds": 19.01,
      "text": "Um, you know, so... an itchy patch on my wrist. That's why I came. I just want to get back to normal, really. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.3,
      "end_seconds": 48.27,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.03,
      "end_seconds": 54.63,
      "duration_seconds": 4.6,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.14,
      "end_seconds": 64.07,
      "duration_seconds": 7.93,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.86,
      "end_seconds": 78.92,
      "duration_seconds": 13.06,
      "text": "Oh, uh, it settles a little with moisturiser. Yes, my new watch strap. That makes it worse. Mostly severe. Honestly, every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.8,
      "end_seconds": 82.82,
      "duration_seconds": 3.02,
      "text": "Right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.97,
      "end_seconds": 87.83,
      "duration_seconds": 3.86,
      "text": "It usually comes with dry flaky skin."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.09,
      "end_seconds": 88.88,
      "duration_seconds": 0.79,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.53,
      "end_seconds": 97.26,
      "duration_seconds": 6.73,
      "text": "A bit of redness was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.7,
      "end_seconds": 101.58,
      "duration_seconds": 2.88,
      "text": "Okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.74,
      "end_seconds": 107.4,
      "duration_seconds": 4.66,
      "text": "Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.23,
      "end_seconds": 112.71,
      "duration_seconds": 1.48,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.46,
      "end_seconds": 118.54,
      "duration_seconds": 4.08,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.73,
      "end_seconds": 121.07,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.81,
      "end_seconds": 126.78,
      "duration_seconds": 4.97,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.39,
      "end_seconds": 130.57,
      "duration_seconds": 2.18,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.95,
      "end_seconds": 136.89,
      "duration_seconds": 4.94,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.61,
      "end_seconds": 139.88,
      "duration_seconds": 2.27,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.23,
      "end_seconds": 145.82,
      "duration_seconds": 4.59,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.8,
      "end_seconds": 161.04,
      "duration_seconds": 4.24,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.01,
      "end_seconds": 164.33,
      "duration_seconds": 2.32,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.24,
      "end_seconds": 169.55,
      "duration_seconds": 4.31,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 174.68,
      "end_seconds": 190.63,
      "duration_seconds": 15.95,
      "text": "Right, it's simvastatin, 20 milligrams, at night for my cholesterol, doctor. So, um, he is on a plain moisturiser, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.43,
      "end_seconds": 211.92,
      "duration_seconds": 2.49,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.98,
      "end_seconds": 216.19,
      "duration_seconds": 3.21,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.14,
      "end_seconds": 221.49,
      "duration_seconds": 3.35,
      "text": "Have you had any blisters or fever?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.56,
      "end_seconds": 227.23,
      "duration_seconds": 3.67,
      "text": "No blisters or fever, none of it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 232.07,
      "duration_seconds": 3.83,
      "text": "Alright, have you had spreading, by any chance?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.98,
      "end_seconds": 235.66,
      "duration_seconds": 2.68,
      "text": "Not at all, no spreading."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 241.73,
      "duration_seconds": 5.2,
      "text": "Okay, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.39,
      "end_seconds": 244.92,
      "duration_seconds": 1.53,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.94,
      "end_seconds": 252.01,
      "duration_seconds": 3.07,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.99,
      "end_seconds": 257.61,
      "duration_seconds": 4.62,
      "text": "I mean, um, no, joints are fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.92,
      "end_seconds": 265.55,
      "duration_seconds": 3.63,
      "text": "Right, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.46,
      "end_seconds": 275.62,
      "duration_seconds": 2.16,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.11,
      "end_seconds": 301.88,
      "duration_seconds": 5.77,
      "text": "Okay: pulse 82, oxygen saturation is 98 percent, BP is 117 over 70."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.37,
      "end_seconds": 308.31,
      "duration_seconds": 3.94,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.88,
      "end_seconds": 315.08,
      "duration_seconds": 1.2,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.96,
      "end_seconds": 317.93,
      "duration_seconds": 1.97,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.64,
      "end_seconds": 339.63,
      "duration_seconds": 6.99,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.9,
      "end_seconds": 352.4,
      "duration_seconds": 7.5,
      "text": "You can relax now. Okay, thinking it through, this is probably mild contact dermatitis from the watch strap."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.05,
      "end_seconds": 357.03,
      "duration_seconds": 3.98,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.14,
      "end_seconds": 368.31,
      "duration_seconds": 10.17,
      "text": "I understand the worry. At the moment I'd say it's mild contact dermatitis from the watch strap, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.36,
      "end_seconds": 392.49,
      "duration_seconds": 8.13,
      "text": "I'd like you to take hydrocortisone cream, 1%, once a day, one week. That's for contact dermatitis."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.34,
      "end_seconds": 396.42,
      "duration_seconds": 3.08,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 397.64,
      "end_seconds": 421.57,
      "duration_seconds": 23.93,
      "text": "Stop wearing that strap and keep the skin moisturised. Please take the tablets with food so they don't upset your stomach. The thing that would worry me is if it spreads or blisters. If that happens, go to emergency. I'll want another look if it has not cleared in two weeks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 422.68,
      "end_seconds": 425.89,
      "duration_seconds": 3.21,
      "text": "Uh, alright, I'll be back."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 426.71,
      "end_seconds": 430.41,
      "duration_seconds": 3.7,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 431.46,
      "end_seconds": 434.24,
      "duration_seconds": 2.78,
      "text": "That's clear, uh, thanks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 435.56,
      "end_seconds": 436.81,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}