{
  "schema_version": "1.0",
  "encounter_id": "01157",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 4.71,
      "duration_seconds": 4.07,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.72,
      "end_seconds": 10.03,
      "duration_seconds": 4.31,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.27,
      "end_seconds": 18.23,
      "duration_seconds": 6.96,
      "text": "I mean, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.76,
      "end_seconds": 22.1,
      "duration_seconds": 3.34,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.36,
      "end_seconds": 34.36,
      "duration_seconds": 7.0,
      "text": "So, I wanted to get burning when I pass urine looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.94,
      "end_seconds": 37.17,
      "duration_seconds": 2.23,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.13,
      "end_seconds": 41.61,
      "duration_seconds": 3.48,
      "text": "I get some relief from drinking water."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.51,
      "end_seconds": 50.64,
      "duration_seconds": 8.13,
      "text": "Right, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 50.74,
      "end_seconds": 56.54,
      "duration_seconds": 5.8,
      "text": "Ah, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.14,
      "end_seconds": 64.24,
      "duration_seconds": 7.1,
      "text": "I was getting to that! I've also been going to the toilet often."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.94,
      "end_seconds": 69.42,
      "duration_seconds": 3.48,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.07,
      "end_seconds": 79.22,
      "duration_seconds": 6.15,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.01,
      "end_seconds": 87.92,
      "duration_seconds": 6.91,
      "text": "Have you had any vaginal discharge, fever, blood in the urine or back pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.98,
      "end_seconds": 106.97,
      "duration_seconds": 16.99,
      "text": "No, no vaginal discharge, no fever, no blood in the urine. I did have a dull ache low in my tummy at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.52,
      "end_seconds": 111.81,
      "duration_seconds": 3.29,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.65,
      "end_seconds": 114.43,
      "duration_seconds": 1.78,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.0,
      "end_seconds": 118.94,
      "duration_seconds": 2.94,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.39,
      "end_seconds": 122.7,
      "duration_seconds": 2.31,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.83,
      "end_seconds": 124.86,
      "duration_seconds": 1.03,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.78,
      "end_seconds": 126.9,
      "duration_seconds": 1.12,
      "text": "Yes, epilepsy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.23,
      "end_seconds": 130.16,
      "duration_seconds": 1.93,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.52,
      "end_seconds": 137.75,
      "duration_seconds": 3.23,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.89,
      "end_seconds": 142.23,
      "duration_seconds": 3.34,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.04,
      "end_seconds": 148.61,
      "duration_seconds": 4.57,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.59,
      "end_seconds": 152.96,
      "duration_seconds": 2.37,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.0,
      "end_seconds": 160.64,
      "duration_seconds": 6.64,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 164.68,
      "duration_seconds": 2.52,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 169.28,
      "duration_seconds": 2.76,
      "text": "Yes, I'm allergic to erythromycin."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.76,
      "end_seconds": 181.46,
      "duration_seconds": 2.7,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.09,
      "end_seconds": 190.86,
      "duration_seconds": 5.77,
      "text": "Let me think, I take alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.53,
      "end_seconds": 198.7,
      "duration_seconds": 6.17,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.48,
      "end_seconds": 207.77,
      "duration_seconds": 8.29,
      "text": "Ah, uh, it's something called carb... carbamazepine, 200 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.16,
      "end_seconds": 212.22,
      "duration_seconds": 3.06,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.8,
      "end_seconds": 220.17,
      "duration_seconds": 7.37,
      "text": "No, um, it's at home. Yeah, I take cranberry juice, daily."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.14,
      "end_seconds": 224.59,
      "duration_seconds": 3.45,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.29,
      "end_seconds": 227.37,
      "duration_seconds": 2.08,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 229.11,
      "end_seconds": 238.2,
      "duration_seconds": 9.09,
      "text": "Okay, so the vitals from earlier. Pulse is 78 beats a minute, respiratory rate 14, blood pressure 123 over 73."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.8,
      "end_seconds": 240.84,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.76,
      "end_seconds": 247.77,
      "duration_seconds": 4.01,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.19,
      "end_seconds": 249.89,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.8,
      "end_seconds": 252.79,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.17,
      "end_seconds": 268.31,
      "duration_seconds": 5.14,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.82,
      "end_seconds": 273.64,
      "duration_seconds": 2.82,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.13,
      "end_seconds": 318.79,
      "duration_seconds": 35.66,
      "text": "Let's get a urine dipstick, for burning urine. Let's use nitrofurantoin, 100 milligrams, twice a day, three days. It's for urinary infection. Drink plenty of water and avoid holding urine. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If you get a fever or back pain, that's the point to come in urgently. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.15,
      "end_seconds": 324.67,
      "duration_seconds": 4.52,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.29,
      "end_seconds": 327.94,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
}