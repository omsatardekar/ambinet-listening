{
  "schema_version": "1.0",
  "encounter_id": "01088",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 6.55,
      "duration_seconds": 5.74,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.25,
      "end_seconds": 13.67,
      "duration_seconds": 4.42,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.63,
      "end_seconds": 21.27,
      "duration_seconds": 6.64,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.55,
      "end_seconds": 29.38,
      "duration_seconds": 6.83,
      "text": "Yeah, it's burning when I pass urine. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.32,
      "end_seconds": 33.82,
      "duration_seconds": 2.5,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.76,
      "end_seconds": 56.49,
      "duration_seconds": 19.73,
      "text": "I take clopidogrel, 75 milligrams, once a day for the stent. I didn't want to make a fuss, you know. I've been reading about it online and it worried me. Uh, I had metoprolol at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.25,
      "end_seconds": 64.61,
      "duration_seconds": 3.36,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.58,
      "end_seconds": 72.53,
      "duration_seconds": 5.95,
      "text": "It's been about a week now. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.16,
      "end_seconds": 78.76,
      "duration_seconds": 4.6,
      "text": "Any a dull ache low in your tummy as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.57,
      "end_seconds": 83.88,
      "duration_seconds": 3.31,
      "text": "Yeah, I've had that since last weekend."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.78,
      "end_seconds": 96.08,
      "duration_seconds": 8.3,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.44,
      "end_seconds": 108.46,
      "duration_seconds": 7.02,
      "text": "It feels moderate to me. I get some relief from a hot water bottle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.89,
      "end_seconds": 114.13,
      "duration_seconds": 4.24,
      "text": "So, have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.62,
      "end_seconds": 118.87,
      "duration_seconds": 3.25,
      "text": "Yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.79,
      "end_seconds": 122.97,
      "duration_seconds": 3.18,
      "text": "Have you noticed back pain or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.72,
      "end_seconds": 127.1,
      "duration_seconds": 2.38,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.33,
      "end_seconds": 132.31,
      "duration_seconds": 3.98,
      "text": "Have you noticed vaginal discharge or blood in the urine?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.2,
      "end_seconds": 138.79,
      "duration_seconds": 4.59,
      "text": "No, you know, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.4,
      "end_seconds": 143.26,
      "duration_seconds": 3.86,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.71,
      "end_seconds": 150.2,
      "duration_seconds": 3.49,
      "text": "No, uh, that side's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.21,
      "end_seconds": 170.48,
      "duration_seconds": 3.27,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.46,
      "end_seconds": 177.74,
      "duration_seconds": 5.28,
      "text": "Ah, I have an underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.76,
      "end_seconds": 181.32,
      "duration_seconds": 1.56,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.73,
      "end_seconds": 184.43,
      "duration_seconds": 1.7,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.25,
      "end_seconds": 192.86,
      "duration_seconds": 2.61,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.95,
      "end_seconds": 198.2,
      "duration_seconds": 4.25,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.73,
      "end_seconds": 201.95,
      "duration_seconds": 3.22,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 203.4,
      "end_seconds": 209.75,
      "duration_seconds": 6.35,
      "text": "Hold on, doctor, I think she reacted to erythromycin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.51,
      "end_seconds": 212.56,
      "duration_seconds": 2.05,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.23,
      "end_seconds": 219.25,
      "duration_seconds": 3.02,
      "text": "Okay, I'll note both of those."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.98,
      "end_seconds": 231.97,
      "duration_seconds": 3.99,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.65,
      "end_seconds": 239.05,
      "duration_seconds": 3.4,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.74,
      "end_seconds": 242.82,
      "duration_seconds": 3.08,
      "text": "Okay, do you work outside the home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.42,
      "end_seconds": 247.77,
      "duration_seconds": 4.35,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.71,
      "end_seconds": 252.05,
      "duration_seconds": 2.34,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.52,
      "end_seconds": 257.83,
      "duration_seconds": 4.31,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.28,
      "end_seconds": 271.2,
      "duration_seconds": 2.92,
      "text": "Alright, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.74,
      "end_seconds": 276.5,
      "duration_seconds": 4.76,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.24,
      "end_seconds": 280.96,
      "duration_seconds": 2.72,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.28,
      "end_seconds": 292.11,
      "duration_seconds": 2.83,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.06,
      "end_seconds": 317.14,
      "duration_seconds": 9.08,
      "text": "Okay: pulse is 79 beats a minute, SpO2 98 percent on room air, temp 36.6 degrees, pressure 112 over 69."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.77,
      "end_seconds": 319.13,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.8,
      "end_seconds": 324.84,
      "duration_seconds": 4.04,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.88,
      "end_seconds": 330.68,
      "duration_seconds": 3.8,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.36,
      "end_seconds": 332.93,
      "duration_seconds": 1.57,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.74,
      "end_seconds": 336.17,
      "duration_seconds": 2.43,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.24,
      "end_seconds": 358.04,
      "duration_seconds": 5.8,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.56,
      "end_seconds": 372.68,
      "duration_seconds": 9.12,
      "text": "That's the examination finished. Taking everything into account, I'd lean towards an uncomplicated urinary infection. Vaginal irritation is also on my list."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.16,
      "end_seconds": 377.9,
      "duration_seconds": 3.74,
      "text": "Um, is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.64,
      "end_seconds": 398.02,
      "duration_seconds": 18.38,
      "text": "I understand the worry. At the moment I'd say it's an uncomplicated urinary infection, and we'll watch how it goes. Drink plenty of water and avoid holding urine. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.65,
      "end_seconds": 402.97,
      "duration_seconds": 3.32,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.82,
      "end_seconds": 406.75,
      "duration_seconds": 1.93,
      "text": "Right, all the best."
    }
  ]
}