{
  "schema_version": "1.0",
  "encounter_id": "01044",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.34,
      "duration_seconds": 3.59,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.98,
      "end_seconds": 9.66,
      "duration_seconds": 3.68,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.17,
      "end_seconds": 16.44,
      "duration_seconds": 5.27,
      "text": "Yeah, it's bloating after meals. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.02,
      "end_seconds": 21.62,
      "duration_seconds": 3.6,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.14,
      "end_seconds": 34.52,
      "duration_seconds": 11.38,
      "text": "It's, It's been six months, I'm fairly sure. I did have loose stools now and then at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.27,
      "end_seconds": 42.01,
      "duration_seconds": 5.74,
      "text": "Alright, have you had bloating after meals before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.44,
      "end_seconds": 53.31,
      "duration_seconds": 7.87,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.51,
      "end_seconds": 60.18,
      "duration_seconds": 5.67,
      "text": "Did you get blood in the stool, vomiting, weight loss or night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.71,
      "end_seconds": 69.62,
      "duration_seconds": 2.91,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.29,
      "end_seconds": 75.33,
      "duration_seconds": 4.04,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.82,
      "end_seconds": 81.9,
      "duration_seconds": 2.08,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.38,
      "end_seconds": 85.63,
      "duration_seconds": 2.25,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.53,
      "end_seconds": 89.07,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.11,
      "end_seconds": 93.29,
      "duration_seconds": 2.18,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.45,
      "end_seconds": 97.32,
      "duration_seconds": 2.87,
      "text": "I'm on escitalopram, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.2,
      "end_seconds": 101.15,
      "duration_seconds": 1.95,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.59,
      "end_seconds": 107.67,
      "duration_seconds": 5.08,
      "text": "It's 10 milligrams. I'm on bisoprolol, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.87,
      "end_seconds": 111.3,
      "duration_seconds": 2.43,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.78,
      "end_seconds": 114.21,
      "duration_seconds": 1.43,
      "text": "2.5 milligrams."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.41,
      "end_seconds": 131.59,
      "duration_seconds": 1.18,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.98,
      "end_seconds": 134.06,
      "duration_seconds": 1.08,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.6,
      "end_seconds": 136.82,
      "duration_seconds": 1.22,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.47,
      "end_seconds": 142.37,
      "duration_seconds": 3.9,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.54,
      "end_seconds": 146.45,
      "duration_seconds": 2.91,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.19,
      "end_seconds": 150.97,
      "duration_seconds": 3.78,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.14,
      "end_seconds": 154.69,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.18,
      "end_seconds": 159.79,
      "duration_seconds": 3.61,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.72,
      "end_seconds": 179.4,
      "duration_seconds": 3.68,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.14,
      "end_seconds": 182.51,
      "duration_seconds": 2.37,
      "text": "Anxiety, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.37,
      "end_seconds": 185.12,
      "duration_seconds": 1.75,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.57,
      "end_seconds": 191.04,
      "duration_seconds": 4.47,
      "text": "I have an irregular heartbeat, for two years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.0,
      "end_seconds": 199.86,
      "duration_seconds": 6.86,
      "text": "Understood. Right, so anxiety is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.98,
      "end_seconds": 218.32,
      "duration_seconds": 2.34,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.35,
      "end_seconds": 231.84,
      "duration_seconds": 2.49,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 247.43,
      "duration_seconds": 5.83,
      "text": "Okay: BP is 117 over 70, temperature is 36.9 degrees, pulse 68."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.87,
      "end_seconds": 250.79,
      "duration_seconds": 1.92,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.33,
      "end_seconds": 255.51,
      "duration_seconds": 4.18,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.63,
      "end_seconds": 258.95,
      "duration_seconds": 2.32,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.17,
      "end_seconds": 261.69,
      "duration_seconds": 1.52,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.73,
      "end_seconds": 264.82,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.38,
      "end_seconds": 287.37,
      "duration_seconds": 5.99,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.42,
      "end_seconds": 302.87,
      "duration_seconds": 10.45,
      "text": "Okay, you can relax now. Okay, so my impression is this: My working impression is a functional bowel pattern, with no alarm features."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.39,
      "end_seconds": 307.25,
      "duration_seconds": 2.86,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.35,
      "end_seconds": 350.39,
      "duration_seconds": 38.04,
      "text": "I can't promise yet, but most people with a functional bowel pattern, with no alarm features do well once it's treated properly. Let's get a coeliac blood test, for bloating. Try smaller meals and keep a food and symptom diary for four weeks. The thing that would worry me is if you see blood in the stool or lose weight. If that happens, go to emergency. Let's review you in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.99,
      "end_seconds": 354.68,
      "duration_seconds": 2.69,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.0,
      "end_seconds": 357.32,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}