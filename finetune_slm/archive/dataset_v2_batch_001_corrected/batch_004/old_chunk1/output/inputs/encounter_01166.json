{
  "schema_version": "1.0",
  "encounter_id": "01166",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.87,
      "duration_seconds": 4.58,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.62,
      "end_seconds": 11.19,
      "duration_seconds": 4.57,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.97,
      "end_seconds": 24.97,
      "duration_seconds": 12.0,
      "text": "Honestly, it's vomiting blood, and my family pushed me to come. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.52,
      "end_seconds": 27.74,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.92,
      "end_seconds": 40.34,
      "duration_seconds": 7.42,
      "text": "Oh, I've had it since yesterday. I've also had black tarry stools, for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.12,
      "end_seconds": 45.91,
      "duration_seconds": 4.79,
      "text": "Have you had vomiting blood before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.46,
      "end_seconds": 52.61,
      "duration_seconds": 5.15,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.83,
      "end_seconds": 68.17,
      "duration_seconds": 3.34,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.88,
      "end_seconds": 83.0,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.04,
      "end_seconds": 107.75,
      "duration_seconds": 14.71,
      "text": "Okay: heart rate 124, SpO2 96 percent on room air, weight 65 kilos, temperature is 36.9 degrees, pressure 138 over 70, BMI works out to 22.8, height 169 centimetres."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.77,
      "end_seconds": 114.45,
      "duration_seconds": 1.68,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.05,
      "end_seconds": 119.38,
      "duration_seconds": 3.33,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.6,
      "end_seconds": 124.22,
      "duration_seconds": 3.62,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.86,
      "end_seconds": 126.96,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.18,
      "end_seconds": 130.52,
      "duration_seconds": 2.34,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.23,
      "end_seconds": 151.23,
      "duration_seconds": 6.0,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.4,
      "end_seconds": 156.53,
      "duration_seconds": 2.13,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.74,
      "end_seconds": 167.0,
      "duration_seconds": 3.26,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.61,
      "end_seconds": 171.63,
      "duration_seconds": 3.02,
      "text": "No, no fever or chest pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.14,
      "end_seconds": 175.09,
      "duration_seconds": 2.95,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.88,
      "end_seconds": 179.1,
      "duration_seconds": 2.22,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.18,
      "end_seconds": 186.82,
      "duration_seconds": 6.64,
      "text": "What do you take on a normal day? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.72,
      "end_seconds": 193.08,
      "duration_seconds": 5.36,
      "text": "It's sertraline, 50 milligrams, once a day for my mood."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.53,
      "end_seconds": 200.92,
      "duration_seconds": 1.39,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.0,
      "end_seconds": 209.1,
      "duration_seconds": 6.1,
      "text": "For about a month. Before this I was on fluoxetine; that's been stopped."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.93,
      "end_seconds": 213.59,
      "duration_seconds": 2.66,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.58,
      "end_seconds": 220.75,
      "duration_seconds": 2.17,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.76,
      "end_seconds": 224.26,
      "duration_seconds": 2.5,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.54,
      "end_seconds": 239.72,
      "duration_seconds": 12.18,
      "text": "I do a yoga class on Thursdays. I look after my grandchildren most days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.1,
      "end_seconds": 248.34,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.7,
      "end_seconds": 250.82,
      "duration_seconds": 1.12,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.96,
      "end_seconds": 256.38,
      "duration_seconds": 4.42,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.21,
      "end_seconds": 261.75,
      "duration_seconds": 3.54,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.41,
      "end_seconds": 277.83,
      "duration_seconds": 15.42,
      "text": "From what you've told me and what I found, this is probably a possible bleeding stomach ulcer. It could also be a bleed from the gullet, so we'll keep that open."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.49,
      "end_seconds": 281.19,
      "duration_seconds": 2.7,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.92,
      "end_seconds": 301.15,
      "duration_seconds": 18.23,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible bleeding stomach ulcer, but I'd like to confirm. Let's book an endoscopy to look into bleeding. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 302.79,
      "end_seconds": 307.06,
      "duration_seconds": 4.27,
      "text": "We have a slot Wednesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.26,
      "end_seconds": 311.12,
      "duration_seconds": 2.86,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.71,
      "end_seconds": 330.85,
      "duration_seconds": 18.14,
      "text": "I'll request urgent blood tests, it'll help with bleeding. Please stop the ibuprofen and do not eat or drink. Come back or go to emergency straight away if you vomit again. I'd like you back straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.78,
      "end_seconds": 333.48,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.43,
      "end_seconds": 338.68,
      "duration_seconds": 3.25,
      "text": "So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.79,
      "end_seconds": 345.73,
      "duration_seconds": 2.94,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.25,
      "end_seconds": 347.51,
      "duration_seconds": 1.26,
      "text": "Look after yourself."
    }
  ]
}