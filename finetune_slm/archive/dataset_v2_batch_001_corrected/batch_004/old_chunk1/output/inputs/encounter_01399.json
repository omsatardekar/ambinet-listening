      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.58,
      "end_seconds": 332.72,
      "duration_seconds": 7.14,
      "text": "Sorry, what was I saying, good, thanks, I'll see you then."
