{
  "schema_version": "1.0",
  "encounter_id": "01382",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 5.98,
      "duration_seconds": 5.24,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.26,
      "end_seconds": 11.58,
      "duration_seconds": 4.32,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.62,
      "end_seconds": 19.29,
      "duration_seconds": 5.67,
      "text": "I'm here because of a tight band around my head."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 24.07,
      "duration_seconds": 3.38,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.19,
      "end_seconds": 27.15,
      "duration_seconds": 1.96,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.89,
      "end_seconds": 33.3,
      "duration_seconds": 5.41,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.32,
      "end_seconds": 37.45,
      "duration_seconds": 2.13,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.27,
      "end_seconds": 41.39,
      "duration_seconds": 3.12,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.4,
      "end_seconds": 44.06,
      "duration_seconds": 1.66,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.58,
      "end_seconds": 47.09,
      "duration_seconds": 2.51,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.85,
      "end_seconds": 51.98,
      "duration_seconds": 3.13,
      "text": "I get some relief from a walk."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.04,
      "end_seconds": 56.36,
      "duration_seconds": 2.32,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.9,
      "end_seconds": 62.13,
      "duration_seconds": 5.23,
      "text": "A stiff neck goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.01,
      "end_seconds": 65.94,
      "duration_seconds": 2.93,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.71,
      "end_seconds": 69.01,
      "duration_seconds": 2.3,
      "text": "It's, It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.82,
      "end_seconds": 77.72,
      "duration_seconds": 7.9,
      "text": "Can you list what you take, tablets, creams or inhalers? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.27,
      "end_seconds": 88.05,
      "duration_seconds": 8.78,
      "text": "It's alendronate, 70 milligrams, once a week for my bones. I take aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 92.55,
      "duration_seconds": 2.45,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.17,
      "end_seconds": 97.91,
      "duration_seconds": 4.74,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.62,
      "end_seconds": 117.9,
      "duration_seconds": 4.28,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 125.96,
      "duration_seconds": 6.29,
      "text": "I've had gout, yes. I have thin bones. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.93,
      "end_seconds": 137.12,
      "duration_seconds": 9.19,
      "text": "Yes, carry on. Okay, I can see thin bones in your file as well. Okay, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.72,
      "end_seconds": 160.72,
      "duration_seconds": 22.0,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I grab fast food at lunch most days. I work in accounts at a hospital. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.61,
      "end_seconds": 175.35,
      "duration_seconds": 4.74,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.25,
      "end_seconds": 178.52,
      "duration_seconds": 2.27,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.75,
      "end_seconds": 195.6,
      "duration_seconds": 3.85,
      "text": "Any sickness, weakness or blurred vision at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.4,
      "end_seconds": 200.13,
      "duration_seconds": 2.73,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.03,
      "end_seconds": 203.92,
      "duration_seconds": 2.89,
      "text": "And sensitivity to light, any of that?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.32,
      "end_seconds": 209.35,
      "duration_seconds": 4.03,
      "text": "Not at all, no sensitivity to light."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.21,
      "end_seconds": 214.97,
      "duration_seconds": 4.76,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.0,
      "end_seconds": 220.16,
      "duration_seconds": 3.16,
      "text": "No, uh, all normal there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.26,
      "end_seconds": 225.0,
      "duration_seconds": 2.74,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.99,
      "end_seconds": 234.09,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.18,
      "end_seconds": 262.17,
      "duration_seconds": 9.99,
      "text": "Okay: temp 36.6 degrees, pulse is 83 beats a minute, saturation 99 percent, pressure 116 over 80, respiratory rate 17."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.97,
      "end_seconds": 264.93,
      "duration_seconds": 1.96,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.28,
      "end_seconds": 268.27,
      "duration_seconds": 1.99,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.02,
      "end_seconds": 275.73,
      "duration_seconds": 4.71,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.67,
      "end_seconds": 279.62,
      "duration_seconds": 1.95,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 302.98,
      "duration_seconds": 5.81,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.79,
      "end_seconds": 317.22,
      "duration_seconds": 9.43,
      "text": "Good, you can sit up again. From what you've told me and what I found, my working impression is tension-type headache."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.02,
      "end_seconds": 322.7,
      "duration_seconds": 3.68,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.61,
      "end_seconds": 331.42,
      "duration_seconds": 7.81,
      "text": "Nothing I've seen today points to an emergency. It looks like tension-type headache, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.31,
      "end_seconds": 353.4,
      "duration_seconds": 8.09,
      "text": "We should do an eye test for eye strain. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.62,
      "end_seconds": 359.73,
      "duration_seconds": 3.11,
      "text": "Thank you, um, that's helpful."
    }
  ]
}