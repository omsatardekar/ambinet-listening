    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.89,
      "end_seconds": 239.8,
      "duration_seconds": 3.91,
      "text": "your pulse is regular and your heart sounds are normal"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.41,
      "end_seconds": 245.37,
      "duration_seconds": 1.96,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.95,
      "end_seconds": 269.28,
      "duration_seconds": 5.33,
      "text": "taking everything into account the most likely explanation is harmless extra heartbeats"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.95,
      "end_seconds": 305.03,
      "duration_seconds": 17.08,
      "text": "I'd like to arrange an ECG for palpitations. Cut back on coffee and energy drinks and and keep a diary of when it happens. One warning sign to remember: you faint or have chest pain. In that case don't wait."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.9,
      "end_seconds": 307.88,
      "duration_seconds": 1.98,
      "text": "Thank you, that's clear."
    },
