    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.12,
      "end_seconds": 157.5,
      "duration_seconds": 5.38,
      "text": "let's talk a a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.54,
      "end_seconds": 170.63,
      "duration_seconds": 11.09,
      "text": "I retired from the post office two years ago. I hardly move around during the day. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.33,
      "end_seconds": 176.32,
      "duration_seconds": 4.99,
      "text": "Alright, can I check a few measurements before we carry on?"
    },
