      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.67,
      "end_seconds": 312.78,
      "duration_seconds": 4.11,
      "text": "let's review you if it carries on after a month"
