      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.87,
      "end_seconds": 186.12,
      "duration_seconds": 2.25,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.25,
      "end_seconds": 211.32,
      "duration_seconds": 4.07,
      "text": "okay: heart rate 68, pressure 111 over 82."
    },
    {
