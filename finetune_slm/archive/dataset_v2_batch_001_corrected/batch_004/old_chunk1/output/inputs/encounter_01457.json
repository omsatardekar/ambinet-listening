    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.5,
      "end_seconds": 143.19,
      "duration_seconds": 4.69,
      "text": "no, you know, I've never been operated on"
