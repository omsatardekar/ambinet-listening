{
  "schema_version": "1.0",
  "encounter_id": "01238",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 4.21,
      "duration_seconds": 2.97,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.18,
      "end_seconds": 14.36,
      "duration_seconds": 5.18,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.57,
      "end_seconds": 23.34,
      "duration_seconds": 7.77,
      "text": "Doctor, I'm just here to help with the details. She's been having been wanting contraception, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.26,
      "end_seconds": 27.03,
      "duration_seconds": 1.77,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.64,
      "end_seconds": 31.16,
      "duration_seconds": 3.52,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.67,
      "end_seconds": 35.71,
      "duration_seconds": 3.04,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.47,
      "end_seconds": 39.57,
      "duration_seconds": 3.1,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.89,
      "end_seconds": 43.13,
      "duration_seconds": 2.24,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.0,
      "end_seconds": 51.53,
      "duration_seconds": 6.53,
      "text": "When it starts I tend to get slightly heavy periods as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.31,
      "end_seconds": 57.37,
      "duration_seconds": 4.06,
      "text": "Have you been wanting contraception at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.86,
      "end_seconds": 64.18,
      "duration_seconds": 5.32,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.0,
      "end_seconds": 70.12,
      "duration_seconds": 5.12,
      "text": "Okay, have you had any breast lumps, migraine with aura or smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.45,
      "end_seconds": 76.63,
      "duration_seconds": 5.18,
      "text": "No breast lumps, migraine with aura or smoking, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.6,
      "end_seconds": 79.69,
      "duration_seconds": 2.09,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.7,
      "end_seconds": 82.51,
      "duration_seconds": 1.81,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.26,
      "end_seconds": 85.69,
      "duration_seconds": 2.43,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.07,
      "end_seconds": 89.82,
      "duration_seconds": 2.75,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.37,
      "end_seconds": 102.59,
      "duration_seconds": 4.22,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.14,
      "end_seconds": 107.08,
      "duration_seconds": 2.94,
      "text": "Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 108.76,
      "end_seconds": 114.99,
      "duration_seconds": 6.23,
      "text": "That's what's prescribed, but I'm not sure she takes it every day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.5,
      "end_seconds": 122.79,
      "duration_seconds": 6.29,
      "text": "It's paracetamol, 650 milligrams, when needed. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.3,
      "end_seconds": 126.2,
      "duration_seconds": 2.9,
      "text": "Understood. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.55,
      "end_seconds": 133.27,
      "duration_seconds": 5.72,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.85,
      "end_seconds": 136.46,
      "duration_seconds": 2.61,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.27,
      "end_seconds": 141.66,
      "duration_seconds": 3.39,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 145.41,
      "end_seconds": 154.15,
      "duration_seconds": 8.74,
      "text": "Actually, I remember she had some kind of reaction to naproxen before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.14,
      "end_seconds": 160.27,
      "duration_seconds": 3.13,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.12,
      "end_seconds": 166.74,
      "duration_seconds": 4.62,
      "text": "Okay, I'll note both of those. So, how about smoking?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.39,
      "end_seconds": 170.79,
      "duration_seconds": 3.4,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.07,
      "end_seconds": 174.42,
      "duration_seconds": 2.35,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.98,
      "end_seconds": 178.82,
      "duration_seconds": 3.84,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.69,
      "end_seconds": 184.22,
      "duration_seconds": 3.53,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.17,
      "end_seconds": 188.67,
      "duration_seconds": 3.5,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.18,
      "end_seconds": 193.12,
      "duration_seconds": 2.94,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.97,
      "end_seconds": 198.14,
      "duration_seconds": 3.17,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.56,
      "end_seconds": 211.93,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.46,
      "end_seconds": 217.63,
      "duration_seconds": 4.17,
      "text": "I have asthma. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.89,
      "end_seconds": 219.59,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.48,
      "end_seconds": 223.86,
      "duration_seconds": 2.38,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.73,
      "end_seconds": 232.07,
      "duration_seconds": 7.34,
      "text": "Hm, okay. Okay, I can see asthma in your file as well. Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.76,
      "end_seconds": 245.1,
      "duration_seconds": 2.34,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.91,
      "end_seconds": 270.27,
      "duration_seconds": 9.36,
      "text": "Okay: temp 36.6 degrees, pulse 76. And saturation 98 percent, BP is 112 over 71, respiratory rate 17."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.62,
      "end_seconds": 277.08,
      "duration_seconds": 4.46,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.7,
      "end_seconds": 280.64,
      "duration_seconds": 1.94,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.5,
      "end_seconds": 301.91,
      "duration_seconds": 2.41,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.44,
      "end_seconds": 313.11,
      "duration_seconds": 8.67,
      "text": "Please sit back down. Taking everything into account, my working impression is suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.78,
      "end_seconds": 332.52,
      "duration_seconds": 10.74,
      "text": "Let's use levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That's for contraception. Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.83,
      "end_seconds": 335.36,
      "duration_seconds": 1.53,
      "text": "That's clear, thanks."
    }
  ]
}