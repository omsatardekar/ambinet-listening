{
  "schema_version": "1.0",
  "encounter_id": "01142",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.79,
      "end_seconds": 7.29,
      "duration_seconds": 6.5,
      "text": "Come in, have a seat by the desk. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.67,
      "end_seconds": 21.94,
      "duration_seconds": 13.27,
      "text": "I, I wanted to get shaking chills and a high temperature looked at. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.73,
      "end_seconds": 25.18,
      "duration_seconds": 2.45,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.4,
      "end_seconds": 28.96,
      "duration_seconds": 2.56,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.72,
      "end_seconds": 33.04,
      "duration_seconds": 2.32,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.07,
      "end_seconds": 35.94,
      "duration_seconds": 1.87,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.75,
      "end_seconds": 56.91,
      "duration_seconds": 3.16,
      "text": "Okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.3,
      "end_seconds": 66.42,
      "duration_seconds": 8.12,
      "text": "Years back I got stomach pain from naproxen, so I stay away from it now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.22,
      "end_seconds": 69.47,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.34,
      "end_seconds": 76.25,
      "duration_seconds": 4.91,
      "text": "Um, you know, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.84,
      "end_seconds": 78.9,
      "duration_seconds": 2.06,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.68,
      "end_seconds": 83.65,
      "duration_seconds": 3.97,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.54,
      "end_seconds": 89.7,
      "duration_seconds": 4.16,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.29,
      "end_seconds": 94.21,
      "duration_seconds": 3.92,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.01,
      "end_seconds": 108.13,
      "duration_seconds": 3.12,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.89,
      "end_seconds": 114.9,
      "duration_seconds": 5.01,
      "text": "I, I take febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.33,
      "end_seconds": 127.9,
      "duration_seconds": 2.57,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.73,
      "end_seconds": 130.87,
      "duration_seconds": 1.14,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.58,
      "end_seconds": 138.59,
      "duration_seconds": 6.01,
      "text": "Okay, go on. Have you noticed rash, chest pain or stiff neck?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.59,
      "end_seconds": 144.37,
      "duration_seconds": 3.78,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.15,
      "end_seconds": 148.94,
      "duration_seconds": 2.79,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.35,
      "end_seconds": 153.0,
      "duration_seconds": 2.65,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.24,
      "end_seconds": 158.17,
      "duration_seconds": 3.93,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.16,
      "end_seconds": 162.67,
      "duration_seconds": 2.51,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.23,
      "end_seconds": 167.65,
      "duration_seconds": 3.42,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.83,
      "end_seconds": 182.57,
      "duration_seconds": 2.74,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.08,
      "end_seconds": 202.95,
      "duration_seconds": 7.87,
      "text": "Okay: blood pressure 111 over 70, respiratory rate 20. And oxygen saturation is 97 percent, pulse 101."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.2,
      "end_seconds": 205.83,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.48,
      "end_seconds": 210.31,
      "duration_seconds": 3.83,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.77,
      "end_seconds": 215.52,
      "duration_seconds": 3.75,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.59,
      "end_seconds": 233.55,
      "duration_seconds": 0.96,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.44,
      "end_seconds": 236.83,
      "duration_seconds": 1.39,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.76,
      "end_seconds": 260.86,
      "duration_seconds": 8.1,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.84,
      "end_seconds": 278.28,
      "duration_seconds": 12.44,
      "text": "Good, you can sit up again. So where does that leave us? I think we're dealing with possible sepsis needing urgent treatment at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.91,
      "end_seconds": 280.77,
      "duration_seconds": 1.86,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.32,
      "end_seconds": 306.33,
      "duration_seconds": 24.01,
      "text": "I can't promise yet, but most people with possible sepsis needing urgent treatment do well once it's treated properly. A chest X-ray is what I'd like next, for fever. Let's book lactate and blood tests to look into sepsis. I want to admit you to hospital now for fluids and antibiotics. I think the emergency team should see you too."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.27,
      "end_seconds": 321.53,
      "duration_seconds": 14.26,
      "text": "Keep an eye out, and if you cannot be brought in today, call us the same day or go to emergency. See me again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.77,
      "end_seconds": 325.41,
      "duration_seconds": 2.64,
      "text": "So, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.14,
      "end_seconds": 328.39,
      "duration_seconds": 1.25,
      "text": "Goodbye for now."
    }
  ]
}