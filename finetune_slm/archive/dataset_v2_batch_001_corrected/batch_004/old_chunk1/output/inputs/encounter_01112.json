{
  "schema_version": "1.0",
  "encounter_id": "01112",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 2.35,
      "duration_seconds": 1.56,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.15,
      "end_seconds": 8.04,
      "duration_seconds": 3.89,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 9.51,
      "end_seconds": 14.43,
      "duration_seconds": 4.92,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.93,
      "end_seconds": 20.99,
      "duration_seconds": 5.06,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.36,
      "end_seconds": 29.96,
      "duration_seconds": 3.6,
      "text": "Well, I've been having a scratchy throat."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.75,
      "end_seconds": 37.54,
      "duration_seconds": 6.79,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 37.64,
      "end_seconds": 44.1,
      "duration_seconds": 6.46,
      "text": "Mm, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.04,
      "end_seconds": 52.43,
      "duration_seconds": 7.39,
      "text": "I was getting to that! I've also had a mild cough, since Friday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.59,
      "end_seconds": 56.79,
      "duration_seconds": 3.2,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.11,
      "end_seconds": 59.82,
      "duration_seconds": 1.71,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.75,
      "end_seconds": 66.36,
      "duration_seconds": 5.61,
      "text": "Have you had a scratchy throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.68,
      "end_seconds": 75.91,
      "duration_seconds": 8.23,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 77.8,
      "end_seconds": 81.95,
      "duration_seconds": 4.15,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.67,
      "end_seconds": 84.08,
      "duration_seconds": 1.41,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.88,
      "end_seconds": 89.12,
      "duration_seconds": 4.24,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.22,
      "end_seconds": 92.18,
      "duration_seconds": 1.96,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.36,
      "end_seconds": 99.56,
      "duration_seconds": 3.2,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.57,
      "end_seconds": 116.02,
      "duration_seconds": 4.45,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.63,
      "end_seconds": 119.55,
      "duration_seconds": 2.92,
      "text": "It's Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 123.7,
      "duration_seconds": 3.36,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.81,
      "end_seconds": 130.37,
      "duration_seconds": 5.56,
      "text": "About six months. Escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.46,
      "end_seconds": 135.43,
      "duration_seconds": 3.97,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.81,
      "end_seconds": 145.11,
      "duration_seconds": 8.3,
      "text": "No, it's at home. I take iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.51,
      "end_seconds": 149.17,
      "duration_seconds": 2.66,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.34,
      "end_seconds": 154.26,
      "duration_seconds": 3.92,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.38,
      "end_seconds": 158.67,
      "duration_seconds": 3.29,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.63,
      "end_seconds": 162.62,
      "duration_seconds": 1.99,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.58,
      "end_seconds": 168.26,
      "duration_seconds": 4.68,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.36,
      "end_seconds": 172.7,
      "duration_seconds": 3.34,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.48,
      "end_seconds": 178.66,
      "duration_seconds": 4.18,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.53,
      "end_seconds": 186.53,
      "duration_seconds": 7.0,
      "text": "I have asthma. I have depression, for about ten years. I've got low haemoglobin."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.3,
      "end_seconds": 195.36,
      "duration_seconds": 7.06,
      "text": "Yes, asthma is known to us, good to have that clear. What about fever?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.03,
      "end_seconds": 197.41,
      "duration_seconds": 1.38,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.91,
      "end_seconds": 203.9,
      "duration_seconds": 4.99,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.25,
      "end_seconds": 211.43,
      "duration_seconds": 6.18,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.04,
      "end_seconds": 225.16,
      "duration_seconds": 12.12,
      "text": "Alright, I'll note both what you've said and what you've noticed. Let me check a few things. Any chest pain, ear pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.59,
      "end_seconds": 238.38,
      "duration_seconds": 11.79,
      "text": "No, no chest pain, no ear pain, no shortness of breath. I did have sneezing at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.13,
      "end_seconds": 242.59,
      "duration_seconds": 3.46,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.59,
      "end_seconds": 247.16,
      "duration_seconds": 3.57,
      "text": "No, you know, nothing with my heart."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.11,
      "end_seconds": 262.22,
      "duration_seconds": 2.11,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.38,
      "end_seconds": 270.63,
      "duration_seconds": 2.25,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.95,
      "end_seconds": 294.99,
      "duration_seconds": 10.04,
      "text": "Okay: temperature is 36.6 degrees, pulse is 71 beats a minute, pressure 128 over 80, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.86,
      "end_seconds": 297.54,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.81,
      "end_seconds": 300.82,
      "duration_seconds": 2.01,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.54,
      "end_seconds": 306.5,
      "duration_seconds": 2.96,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.41,
      "end_seconds": 309.47,
      "duration_seconds": 1.06,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.44,
      "end_seconds": 313.11,
      "duration_seconds": 2.67,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.94,
      "end_seconds": 325.93,
      "duration_seconds": 4.99,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.7,
      "end_seconds": 349.08,
      "duration_seconds": 19.38,
      "text": "You can sit up now. From what you've told me and what I found, it fits best with a simple viral cold. The reason I say that is that your story and my examination fit together. It could also be early flu, so we'll keep that open."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.38,
      "end_seconds": 352.39,
      "duration_seconds": 2.01,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.17,
      "end_seconds": 367.42,
      "duration_seconds": 11.25,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold. So, to recap quickly. You've had a scratchy throat, and no ear pain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.05,
      "end_seconds": 370.13,
      "duration_seconds": 2.08,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.63,
      "end_seconds": 400.7,
      "duration_seconds": 30.07,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If you develop a high fever or trouble breathing, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 401.74,
      "end_seconds": 402.66,
      "duration_seconds": 0.92,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.7,
      "end_seconds": 409.57,
      "duration_seconds": 4.87,
      "text": "Let's review you if it is not better in ten days."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 410.27,
      "end_seconds": 413.53,
      "duration_seconds": 3.26,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.15,
      "end_seconds": 416.92,
      "duration_seconds": 2.77,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.56,
      "end_seconds": 419.74,
      "duration_seconds": 2.18,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.19,
      "end_seconds": 423.14,
      "duration_seconds": 1.95,
      "text": "So, all the best."
    }
  ]
}