{
  "schema_version": "1.0",
  "encounter_id": "01401",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 5.75,
      "duration_seconds": 5.14,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 11.85,
      "duration_seconds": 4.7,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.71,
      "end_seconds": 22.75,
      "duration_seconds": 6.04,
      "text": "Honestly, it's a sore ankle, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.97,
      "end_seconds": 26.15,
      "duration_seconds": 2.18,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.68,
      "end_seconds": 30.47,
      "duration_seconds": 3.79,
      "text": "It's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.92,
      "end_seconds": 36.85,
      "duration_seconds": 5.93,
      "text": "Ah. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 38.2,
      "end_seconds": 41.94,
      "duration_seconds": 3.74,
      "text": "It's once or twice a day. Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.47,
      "end_seconds": 52.7,
      "duration_seconds": 6.23,
      "text": "A few quick ones: numbness, crack or pop or pain in the foot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.23,
      "end_seconds": 57.86,
      "duration_seconds": 3.63,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.63,
      "end_seconds": 62.01,
      "duration_seconds": 2.38,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.67,
      "end_seconds": 65.36,
      "duration_seconds": 2.69,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.4,
      "end_seconds": 70.07,
      "duration_seconds": 2.67,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.01,
      "end_seconds": 72.54,
      "duration_seconds": 1.53,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.94,
      "end_seconds": 85.81,
      "duration_seconds": 4.87,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.62,
      "end_seconds": 90.0,
      "duration_seconds": 2.38,
      "text": "I, I have heart failure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.35,
      "end_seconds": 98.7,
      "duration_seconds": 7.35,
      "text": "Right, so heart failure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.64,
      "end_seconds": 108.6,
      "duration_seconds": 1.96,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.53,
      "end_seconds": 117.72,
      "duration_seconds": 4.19,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.97,
      "end_seconds": 121.02,
      "duration_seconds": 2.05,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.25,
      "end_seconds": 126.8,
      "duration_seconds": 4.55,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.29,
      "end_seconds": 131.32,
      "duration_seconds": 3.03,
      "text": "Right, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 136.26,
      "end_seconds": 140.19,
      "duration_seconds": 3.93,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.68,
      "end_seconds": 144.08,
      "duration_seconds": 2.4,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.95,
      "end_seconds": 149.34,
      "duration_seconds": 4.39,
      "text": "Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.55,
      "end_seconds": 166.24,
      "duration_seconds": 7.69,
      "text": "Do you react to any medicines or foods? Any allergies? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.82,
      "end_seconds": 169.04,
      "duration_seconds": 2.22,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 183.75,
      "end_seconds": 194.08,
      "duration_seconds": 10.33,
      "text": "Okay, so the vitals from earlier. Heart rate 81, blood pressure 113 over 76. Temperature is 36.9 degrees, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.6,
      "end_seconds": 195.9,
      "duration_seconds": 1.3,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.13,
      "end_seconds": 200.33,
      "duration_seconds": 2.2,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.17,
      "end_seconds": 203.3,
      "duration_seconds": 2.13,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.03,
      "end_seconds": 222.01,
      "duration_seconds": 6.98,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.04,
      "end_seconds": 236.21,
      "duration_seconds": 9.17,
      "text": "Please sit back down. So, based on the history and the examination, this is probably a mild ankle sprain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.69,
      "end_seconds": 243.65,
      "duration_seconds": 2.96,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.42,
      "end_seconds": 260.31,
      "duration_seconds": 15.89,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild ankle sprain. Let me repeat that back to make sure. You've had a sore ankle, since this morning, mild, and no numbness or pain in the foot."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 261.02,
      "end_seconds": 262.54,
      "duration_seconds": 1.52,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.31,
      "end_seconds": 285.23,
      "duration_seconds": 21.92,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. A short walk every day, even twenty minutes, will help more than you'd think. Keep an eye out, and if you cannot put weight on it, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.95,
      "end_seconds": 289.12,
      "duration_seconds": 2.17,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.21,
      "end_seconds": 298.57,
      "duration_seconds": 8.36,
      "text": "I'll want another look if it is not better in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 299.11,
      "end_seconds": 301.91,
      "duration_seconds": 2.8,
      "text": "That's clear, uh, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.59,
      "end_seconds": 303.83,
      "duration_seconds": 1.24,
      "text": "See you soon."
    }
  ]
}