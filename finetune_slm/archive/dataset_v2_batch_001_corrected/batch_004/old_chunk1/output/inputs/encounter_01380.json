{
  "schema_version": "1.0",
  "encounter_id": "01380",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 6.29,
      "duration_seconds": 5.58,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 10.55,
      "duration_seconds": 3.7,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.57,
      "end_seconds": 18.62,
      "duration_seconds": 7.05,
      "text": "Mainly a high fever. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.78,
      "end_seconds": 23.13,
      "duration_seconds": 3.35,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.88,
      "end_seconds": 36.69,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.5,
      "end_seconds": 58.31,
      "duration_seconds": 8.81,
      "text": "Okay: BP is 118 over 77, pulse 96. And oxygen saturation is 97 percent, temp 38.0 degrees."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 61.73,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.65,
      "end_seconds": 66.4,
      "duration_seconds": 2.75,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.86,
      "end_seconds": 81.8,
      "duration_seconds": 1.94,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.42,
      "end_seconds": 92.23,
      "duration_seconds": 8.81,
      "text": "Uh, for ten days, I'd say. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.27,
      "end_seconds": 96.92,
      "duration_seconds": 2.65,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.02,
      "end_seconds": 109.61,
      "duration_seconds": 11.59,
      "text": "Oh, it sort of comes and goes. I did have pain much worse than it looks at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.92,
      "end_seconds": 125.93,
      "duration_seconds": 2.01,
      "text": "Any insect bite or cut?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.6,
      "end_seconds": 130.01,
      "duration_seconds": 2.41,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.79,
      "end_seconds": 134.06,
      "duration_seconds": 3.27,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.11,
      "end_seconds": 137.63,
      "duration_seconds": 1.52,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.18,
      "end_seconds": 141.61,
      "duration_seconds": 3.43,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.33,
      "end_seconds": 144.92,
      "duration_seconds": 2.59,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.64,
      "end_seconds": 147.5,
      "duration_seconds": 0.86,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.14,
      "end_seconds": 150.85,
      "duration_seconds": 2.71,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.28,
      "end_seconds": 154.29,
      "duration_seconds": 2.01,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.67,
      "end_seconds": 163.91,
      "duration_seconds": 5.24,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.98,
      "end_seconds": 167.93,
      "duration_seconds": 2.95,
      "text": "Okay, do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.64,
      "end_seconds": 172.1,
      "duration_seconds": 2.46,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.97,
      "end_seconds": 176.2,
      "duration_seconds": 2.23,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.96,
      "end_seconds": 183.92,
      "duration_seconds": 5.96,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.33,
      "end_seconds": 190.0,
      "duration_seconds": 4.67,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.9,
      "end_seconds": 197.34,
      "duration_seconds": 6.44,
      "text": "Diabetes, for two years. I've had an enlarged prostate for nearly five years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.49,
      "end_seconds": 201.14,
      "duration_seconds": 2.65,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 216.09,
      "duration_seconds": 13.09,
      "text": "Alright, an enlarged prostate, that matches what I have here. So, can you list what you take, tablets, creams or inhalers? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.1,
      "end_seconds": 221.73,
      "duration_seconds": 4.63,
      "text": "I take metformin, 500 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.3,
      "end_seconds": 227.13,
      "duration_seconds": 4.83,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.8,
      "end_seconds": 236.44,
      "duration_seconds": 7.64,
      "text": "Erm, not with me. I'll bring it next time. Tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.26,
      "end_seconds": 240.45,
      "duration_seconds": 2.19,
      "text": "Right, and for how long?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.31,
      "end_seconds": 244.3,
      "duration_seconds": 1.99,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.16,
      "end_seconds": 247.89,
      "duration_seconds": 2.73,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.33,
      "end_seconds": 250.68,
      "duration_seconds": 1.35,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.63,
      "end_seconds": 257.54,
      "duration_seconds": 3.91,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.41,
      "end_seconds": 260.73,
      "duration_seconds": 2.32,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.46,
      "end_seconds": 280.27,
      "duration_seconds": 6.81,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.94,
      "end_seconds": 299.46,
      "duration_seconds": 1.52,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.46,
      "end_seconds": 313.72,
      "duration_seconds": 12.26,
      "text": "Alright, thank you, you can get dressed. Let me tell you where I've got to. I'd lean towards a severe deep skin infection needing urgent surgery review."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.53,
      "end_seconds": 318.75,
      "duration_seconds": 3.22,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.44,
      "end_seconds": 336.01,
      "duration_seconds": 15.57,
      "text": "It's reasonable to be concerned, but right now a severe deep skin infection needing urgent surgery review is my leading thought, not anything worse. Let's book urgent blood tests to look into severe skin infection."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 337.31,
      "end_seconds": 340.02,
      "duration_seconds": 2.71,
      "text": "The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.4,
      "end_seconds": 357.48,
      "duration_seconds": 16.08,
      "text": "An urgent surgical review is what I'd like next, for possible necrotising infection. I am sending you to hospital now, do not wait. I'm going to send a referral to the surgical team."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.05,
      "end_seconds": 360.69,
      "duration_seconds": 1.64,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.43,
      "end_seconds": 369.61,
      "duration_seconds": 8.18,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.32,
      "end_seconds": 374.02,
      "duration_seconds": 2.7,
      "text": "Well, thank you, that's clear."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.28,
      "end_seconds": 384.52,
      "duration_seconds": 9.24,
      "text": "One warning sign to remember: you cannot go now. In that case don't wait. See me again straight away."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.3,
      "end_seconds": 388.83,
      "duration_seconds": 3.53,
      "text": "Let me think, I can manage that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.76,
      "end_seconds": 393.96,
      "duration_seconds": 4.2,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.76,
      "end_seconds": 398.05,
      "duration_seconds": 2.29,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.79,
      "end_seconds": 400.97,
      "duration_seconds": 1.18,
      "text": "Goodbye for now."
    }
  ]
}