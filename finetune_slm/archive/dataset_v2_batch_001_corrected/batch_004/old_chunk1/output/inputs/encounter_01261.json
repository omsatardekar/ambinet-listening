    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.77,
      "end_seconds": 252.97,
      "duration_seconds": 7.2,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.34,
      "end_seconds": 259.68,
      "duration_seconds": 2.34,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.82,
      "end_seconds": 275.29,
      "duration_seconds": 5.47,
      "text": "okay, thinking it through, it points towards a mild ankle sprain"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.34,
      "end_seconds": 279.6,
      "duration_seconds": 3.26,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.8,
      "end_seconds": 301.41,
      "duration_seconds": 20.61,
      "text": "I understand the worry. At the moment I'd say it's a mild ankle sprain, and we'll watch how it goes. Rest, ice, a compression bandage and keep it raised for two days. Let's plan a check if it is not better in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.56,
      "end_seconds": 309.45,
      "duration_seconds": 3.89,
      "text": "Hmm, good, thanks, I'll see you then."
    }
