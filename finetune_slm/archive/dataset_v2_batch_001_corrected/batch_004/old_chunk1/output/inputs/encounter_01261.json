      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.13,
      "end_seconds": 223.48,
      "duration_seconds": 2.35,
      "text": "I'll come back to the numbers"
