    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.92,
      "end_seconds": 154.81,
      "duration_seconds": 3.89,
      "text": "Any medical conditions, anything you've been treated for?"
