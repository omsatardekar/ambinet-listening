    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.86,
      "end_seconds": 216.74,
      "duration_seconds": 7.88,
      "text": "Okay: pressure 121 over 78, temperature is 36.6 degrees, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.33,
      "end_seconds": 219.68,
      "duration_seconds": 2.35,
      "text": "Is that alright, doctor?"
