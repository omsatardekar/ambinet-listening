      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.79,
      "end_seconds": 168.84,
      "duration_seconds": 1.05,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.19,
      "end_seconds": 179.39,
      "duration_seconds": 2.2,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.3,
      "end_seconds": 181.4,
      "duration_seconds": 1.1,
      "text": "no, none"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.13,
      "end_seconds": 186.45,
      "duration_seconds": 3.32,
      "text": "I'll just record a few vital signs"
