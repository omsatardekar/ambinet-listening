      "start_seconds": 1.26,
      "end_seconds": 4.26,
      "duration_seconds": 3.0,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.17,
      "end_seconds": 10.69,
      "duration_seconds": 5.52,
      "text": "Okay, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.42,
      "end_seconds": 18.56,
      "duration_seconds": 6.14,
      "text": "Doctor, it's a sore ankle. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.64,
      "end_seconds": 24.07,
      "duration_seconds": 3.43,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.86,
      "end_seconds": 26.56,
      "duration_seconds": 1.7,
      "text": "It started yesterday."
