      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.32,
      "end_seconds": 87.61,
      "duration_seconds": 2.29,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.31,
      "end_seconds": 102.59,
      "duration_seconds": 1.28,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.25,
      "end_seconds": 107.09,
      "duration_seconds": 3.84,
      "text": "I work in accounts at a hospital."
