    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.24,
      "end_seconds": 199.84,
      "duration_seconds": 2.6,
      "text": "bear with me while this finishes.."
