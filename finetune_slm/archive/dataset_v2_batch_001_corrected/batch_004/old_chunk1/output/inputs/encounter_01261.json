    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.09,
      "end_seconds": 230.19,
      "duration_seconds": 4.1,
      "text": "Now I'm going to do a short physical check."
