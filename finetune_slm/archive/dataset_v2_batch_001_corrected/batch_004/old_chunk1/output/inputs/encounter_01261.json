    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.87,
      "end_seconds": 234.61,
      "duration_seconds": 2.74,
      "text": "Stay as you are for a moment."
