      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.13,
      "end_seconds": 32.67,
      "duration_seconds": 4.54,
      "text": "Okay, give me more detail on it, whatever comes to mind."
