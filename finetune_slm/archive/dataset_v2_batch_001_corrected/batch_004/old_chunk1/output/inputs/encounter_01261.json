      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.63,
      "end_seconds": 77.75,
      "duration_seconds": 4.12,
      "text": "no, none, no pain in the foot"
