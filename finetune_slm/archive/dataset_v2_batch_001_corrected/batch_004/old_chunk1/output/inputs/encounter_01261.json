      "role": "DOCTOR",
      "start_seconds": 48.57,
      "end_seconds": 50.65,
      "duration_seconds": 2.08,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.74,
      "end_seconds": 60.61,
      "duration_seconds": 8.87,
      "text": "A little swelling goes along with it, most of the time. With little swelling, moderate, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.18,
      "end_seconds": 65.94,
      "duration_seconds": 4.76,
      "text": "Let me check a few things. Any crack or pop or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.32,
      "end_seconds": 69.45,
      "duration_seconds": 2.13,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.2,
      "end_seconds": 73.09,
      "duration_seconds": 2.89,
      "text": "nothing like pain in the foot?"
