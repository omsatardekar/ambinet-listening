{
  "schema_version": "1.0",
  "encounter_id": "01371",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.57,
      "duration_seconds": 3.48,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.03,
      "end_seconds": 10.0,
      "duration_seconds": 3.97,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.71,
      "end_seconds": 15.73,
      "duration_seconds": 5.02,
      "text": "Mainly I've been feeling well. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.4,
      "end_seconds": 20.57,
      "duration_seconds": 3.17,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.49,
      "end_seconds": 34.04,
      "duration_seconds": 12.55,
      "text": "Oh, I'd say two months. Actually, no, closer to about three months. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.91,
      "end_seconds": 39.04,
      "duration_seconds": 3.13,
      "text": "So, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.36,
      "end_seconds": 41.86,
      "duration_seconds": 1.5,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.89,
      "end_seconds": 46.08,
      "duration_seconds": 2.19,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.83,
      "end_seconds": 53.11,
      "duration_seconds": 5.28,
      "text": "Slightly dry skin goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.01,
      "end_seconds": 58.91,
      "duration_seconds": 4.9,
      "text": "So, have you been feeling well at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.85,
      "end_seconds": 65.49,
      "duration_seconds": 5.64,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.57,
      "end_seconds": 71.58,
      "duration_seconds": 4.01,
      "text": "A few quick ones: palpitations, feeling cold or constipation?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.36,
      "end_seconds": 76.11,
      "duration_seconds": 2.75,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.66,
      "end_seconds": 79.65,
      "duration_seconds": 1.99,
      "text": "Any sign of weight change?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.75,
      "end_seconds": 87.07,
      "duration_seconds": 3.32,
      "text": "No, I haven't had any weight change."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.25,
      "end_seconds": 90.21,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.33,
      "end_seconds": 92.98,
      "duration_seconds": 1.65,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.55,
      "end_seconds": 98.02,
      "duration_seconds": 3.47,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.8,
      "end_seconds": 103.04,
      "duration_seconds": 3.24,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.37,
      "end_seconds": 119.64,
      "duration_seconds": 3.27,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.2,
      "end_seconds": 125.75,
      "duration_seconds": 5.55,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.5,
      "end_seconds": 129.44,
      "duration_seconds": 2.94,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.2,
      "end_seconds": 133.87,
      "duration_seconds": 3.67,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.49,
      "end_seconds": 138.53,
      "duration_seconds": 3.04,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.9,
      "end_seconds": 143.73,
      "duration_seconds": 3.83,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.92,
      "end_seconds": 147.46,
      "duration_seconds": 2.54,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.59,
      "end_seconds": 152.0,
      "duration_seconds": 3.41,
      "text": "Mm, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.04,
      "end_seconds": 155.78,
      "duration_seconds": 2.74,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.96,
      "end_seconds": 160.9,
      "duration_seconds": 3.94,
      "text": "No, you know, I'm not on anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.79,
      "end_seconds": 166.1,
      "duration_seconds": 3.31,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.95,
      "end_seconds": 171.52,
      "duration_seconds": 4.57,
      "text": "I have an underactive thyroid, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.31,
      "end_seconds": 178.03,
      "duration_seconds": 5.72,
      "text": "Understood. Yes, an underactive thyroid is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.84,
      "end_seconds": 190.25,
      "duration_seconds": 2.41,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.02,
      "end_seconds": 197.0,
      "duration_seconds": 4.98,
      "text": "Um, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.12,
      "end_seconds": 200.52,
      "duration_seconds": 2.4,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.12,
      "end_seconds": 214.42,
      "duration_seconds": 2.3,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.15,
      "end_seconds": 247.64,
      "duration_seconds": 13.49,
      "text": "Okay: temperature is 36.8 degrees, pulse 69. And SpO2 97 percent on room air, height 185 centimetres, blood pressure 113 over 72, weight 72 kilos, BMI works out to 21.0."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.71,
      "end_seconds": 250.12,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.02,
      "end_seconds": 254.35,
      "duration_seconds": 2.33,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.81,
      "end_seconds": 271.5,
      "duration_seconds": 5.69,
      "text": "Listening to the whole story, my working impression is well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.1,
      "end_seconds": 276.35,
      "duration_seconds": 4.25,
      "text": "Yeah, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.73,
      "end_seconds": 294.07,
      "duration_seconds": 16.34,
      "text": "I understand the worry. At the moment I'd say it's well-controlled thyroid replacement, and we'll watch how it goes. Keep taking the tablet on an empty stomach, apart from coffee. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.57,
      "end_seconds": 302.41,
      "duration_seconds": 2.84,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.09,
      "end_seconds": 304.27,
      "duration_seconds": 1.18,
      "text": "Look after yourself."
    }
  ]
}