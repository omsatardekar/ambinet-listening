{
  "schema_version": "1.0",
  "encounter_id": "01489",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 4.36,
      "duration_seconds": 3.22,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.98,
      "end_seconds": 9.25,
      "duration_seconds": 4.27,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.42,
      "end_seconds": 20.21,
      "duration_seconds": 4.79,
      "text": "Hmm, so the thing is, I've got vomiting blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.24,
      "end_seconds": 28.47,
      "duration_seconds": 3.23,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.48,
      "end_seconds": 32.13,
      "duration_seconds": 2.65,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 38.21,
      "duration_seconds": 4.67,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.52,
      "end_seconds": 43.85,
      "duration_seconds": 4.33,
      "text": "Moderate, I'd say. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.25,
      "end_seconds": 56.89,
      "duration_seconds": 4.64,
      "text": "Let me check a few things. Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.63,
      "end_seconds": 61.41,
      "duration_seconds": 2.78,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.19,
      "end_seconds": 64.88,
      "duration_seconds": 2.69,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.13,
      "end_seconds": 67.6,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.55,
      "end_seconds": 71.51,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.26,
      "end_seconds": 74.79,
      "duration_seconds": 1.53,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.99,
      "end_seconds": 79.79,
      "duration_seconds": 3.8,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.47,
      "end_seconds": 84.53,
      "duration_seconds": 3.06,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.42,
      "end_seconds": 89.6,
      "duration_seconds": 3.18,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.42,
      "end_seconds": 105.78,
      "duration_seconds": 15.36,
      "text": "I only drink at family occasions. My husband and I live above the shop. I grab fast food at lunch most days. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.03,
      "end_seconds": 109.41,
      "duration_seconds": 2.38,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.07,
      "end_seconds": 113.66,
      "duration_seconds": 3.59,
      "text": "Ibuprofen. I take it three times a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.72,
      "end_seconds": 121.79,
      "duration_seconds": 3.07,
      "text": "Right, do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.46,
      "end_seconds": 128.22,
      "duration_seconds": 4.76,
      "text": "400 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.72,
      "end_seconds": 133.06,
      "duration_seconds": 4.34,
      "text": "Sure. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.65,
      "end_seconds": 140.48,
      "duration_seconds": 5.83,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.66,
      "end_seconds": 146.1,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.74,
      "end_seconds": 149.22,
      "duration_seconds": 2.48,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.58,
      "end_seconds": 165.42,
      "duration_seconds": 2.84,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.53,
      "end_seconds": 178.09,
      "duration_seconds": 2.56,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.36,
      "end_seconds": 207.44,
      "duration_seconds": 10.08,
      "text": "Okay: temperature 36.6, pulse is 106 beats a minute, SpO2 96 percent on room air, blood pressure 122 over 77, respiratory rate 19."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.98,
      "end_seconds": 212.3,
      "duration_seconds": 3.32,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.2,
      "end_seconds": 215.72,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.75,
      "end_seconds": 218.7,
      "duration_seconds": 1.95,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.86,
      "end_seconds": 241.88,
      "duration_seconds": 7.02,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.88,
      "end_seconds": 248.72,
      "duration_seconds": 1.84,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.28,
      "end_seconds": 264.17,
      "duration_seconds": 6.89,
      "text": "Putting it all together, the most likely explanation is a possible bleeding stomach ulcer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.93,
      "end_seconds": 268.73,
      "duration_seconds": 3.8,
      "text": "I mean, is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.73,
      "end_seconds": 279.41,
      "duration_seconds": 8.68,
      "text": "I can't promise yet, but most people with a possible bleeding stomach ulcer do well once it's treated properly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.09,
      "end_seconds": 309.47,
      "duration_seconds": 11.38,
      "text": "Let's book urgent blood tests to look into bleeding. Please stop the ibuprofen and do not eat or drink. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.48,
      "end_seconds": 313.86,
      "duration_seconds": 3.38,
      "text": "Sure, um, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.48,
      "end_seconds": 329.3,
      "duration_seconds": 14.82,
      "text": "I'm not ordering an endoscopy today. If things carry on in a month, we'll consider it. Please come and see me straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.41,
      "end_seconds": 334.91,
      "duration_seconds": 4.5,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.51,
      "end_seconds": 342.68,
      "duration_seconds": 4.17,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.98,
      "end_seconds": 347.88,
      "duration_seconds": 3.9,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}