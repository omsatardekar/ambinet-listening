{
  "schema_version": "1.0",
  "encounter_id": "01134",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 7.05,
      "duration_seconds": 6.37,
      "text": "Come in, have a seat by the desk. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.24,
      "end_seconds": 12.14,
      "duration_seconds": 3.9,
      "text": "I'm here because of no real problems."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.9,
      "end_seconds": 17.2,
      "duration_seconds": 3.3,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.0,
      "end_seconds": 29.92,
      "duration_seconds": 2.92,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.13,
      "end_seconds": 59.6,
      "duration_seconds": 9.47,
      "text": "Okay: pulse is 79 beats a minute, oxygen saturation is 98 percent, BP is 125 over 68. And temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.71,
      "end_seconds": 69.65,
      "duration_seconds": 2.94,
      "text": "Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.41,
      "end_seconds": 74.86,
      "duration_seconds": 1.45,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.56,
      "end_seconds": 79.61,
      "duration_seconds": 3.05,
      "text": "Alright, any an occasional headache as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.41,
      "end_seconds": 97.55,
      "duration_seconds": 16.14,
      "text": "Erm, yes, about the same, about four days. With occasional headache, it happens on and off. There was a bit of back stiffness, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.4,
      "end_seconds": 102.25,
      "duration_seconds": 3.85,
      "text": "Any shortness of breath, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.09,
      "end_seconds": 108.01,
      "duration_seconds": 4.92,
      "text": "Sorry, what was I saying, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.97,
      "end_seconds": 112.49,
      "duration_seconds": 2.52,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.25,
      "end_seconds": 116.83,
      "duration_seconds": 3.58,
      "text": "No, uh, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.77,
      "end_seconds": 119.74,
      "duration_seconds": 0.97,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 123.61,
      "duration_seconds": 2.94,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.15,
      "end_seconds": 126.57,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.83,
      "end_seconds": 134.85,
      "duration_seconds": 4.02,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.87,
      "end_seconds": 139.12,
      "duration_seconds": 2.25,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.95,
      "end_seconds": 149.04,
      "duration_seconds": 4.09,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.54,
      "end_seconds": 152.64,
      "duration_seconds": 2.1,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.62,
      "end_seconds": 158.22,
      "duration_seconds": 4.6,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.87,
      "end_seconds": 164.22,
      "duration_seconds": 4.35,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.26,
      "end_seconds": 167.98,
      "duration_seconds": 2.72,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.94,
      "end_seconds": 175.55,
      "duration_seconds": 3.61,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.65,
      "end_seconds": 182.24,
      "duration_seconds": 5.59,
      "text": "I'm on simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.16,
      "end_seconds": 188.05,
      "duration_seconds": 3.89,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.46,
      "end_seconds": 199.44,
      "duration_seconds": 9.98,
      "text": "Uh, I've had high cholesterol for five years now. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.2,
      "end_seconds": 203.93,
      "duration_seconds": 1.73,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.62,
      "end_seconds": 209.14,
      "duration_seconds": 3.52,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.71,
      "end_seconds": 212.33,
      "duration_seconds": 1.62,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.67,
      "end_seconds": 215.8,
      "duration_seconds": 2.13,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.69,
      "end_seconds": 232.33,
      "duration_seconds": 2.64,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.48,
      "end_seconds": 234.97,
      "duration_seconds": 1.49,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.5,
      "end_seconds": 239.41,
      "duration_seconds": 1.91,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.92,
      "end_seconds": 265.26,
      "duration_seconds": 8.34,
      "text": "Putting it all together, I think we're dealing with a healthy adult with no worrying findings at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.3,
      "end_seconds": 268.44,
      "duration_seconds": 2.14,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.12,
      "end_seconds": 279.03,
      "duration_seconds": 9.91,
      "text": "It's reasonable to be concerned, but right now a healthy adult with no worrying findings is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.63,
      "end_seconds": 309.41,
      "duration_seconds": 18.78,
      "text": "Let's get a fasting sugar test, for routine check. Keep up regular exercise and a balanced diet. If it hasn't settled in a month, we'd think about a cholesterol blood test, but not now. I'd like you back in twelve months. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.16,
      "end_seconds": 314.68,
      "duration_seconds": 3.52,
      "text": "Okay, so thank you, doctor, goodbye."
    }
  ]
}