{
  "schema_version": "1.0",
  "encounter_id": "01084",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 4.32,
      "duration_seconds": 3.38,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 10.69,
      "duration_seconds": 4.53,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.98,
      "end_seconds": 21.31,
      "duration_seconds": 9.33,
      "text": "Um, so... burning when I pass urine. That's why I came. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.74,
      "end_seconds": 26.35,
      "duration_seconds": 3.61,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.4,
      "end_seconds": 60.13,
      "duration_seconds": 32.73,
      "text": "It's, It's been about four days now. And I've been going to the toilet often as well, since yesterday. I've had a dull ache low in my tummy too, for two weeks. As for dull ache low in my tummy, maybe a four out of ten on a bad day. A hot water bottle helps a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.2,
      "end_seconds": 67.34,
      "duration_seconds": 6.14,
      "text": "Have you had burning when you pass urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.62,
      "end_seconds": 73.5,
      "duration_seconds": 4.88,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.78,
      "end_seconds": 78.79,
      "duration_seconds": 4.01,
      "text": "Have you noticed vaginal discharge or blood in the urine?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.87,
      "end_seconds": 88.19,
      "duration_seconds": 4.32,
      "text": "No, no vaginal discharge or blood in the urine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.16,
      "end_seconds": 92.45,
      "duration_seconds": 2.29,
      "text": "Any back pain or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.77,
      "end_seconds": 97.76,
      "duration_seconds": 1.99,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.99,
      "end_seconds": 103.61,
      "duration_seconds": 4.62,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.67,
      "end_seconds": 106.89,
      "duration_seconds": 2.22,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.43,
      "end_seconds": 110.17,
      "duration_seconds": 2.74,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.58,
      "end_seconds": 115.24,
      "duration_seconds": 3.66,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.31,
      "end_seconds": 119.49,
      "duration_seconds": 3.18,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.01,
      "end_seconds": 125.25,
      "duration_seconds": 4.24,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.77,
      "end_seconds": 129.67,
      "duration_seconds": 2.9,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.35,
      "end_seconds": 133.88,
      "duration_seconds": 3.53,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.09,
      "end_seconds": 137.88,
      "duration_seconds": 2.79,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.05,
      "end_seconds": 140.62,
      "duration_seconds": 1.57,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.74,
      "end_seconds": 142.77,
      "duration_seconds": 1.03,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.44,
      "end_seconds": 145.79,
      "duration_seconds": 2.35,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.53,
      "end_seconds": 164.48,
      "duration_seconds": 3.95,
      "text": "Okay, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.56,
      "end_seconds": 184.74,
      "duration_seconds": 18.18,
      "text": "Escitalopram. I take it 10 milligrams, once a day. I'm supposed to take it regularly, but I don't always manage. I take losartan, 50 milligrams, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 185.97,
      "end_seconds": 190.74,
      "duration_seconds": 4.77,
      "text": "Doctor, our chart from the last visit lists it as 100 milligrams."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.56,
      "end_seconds": 195.68,
      "duration_seconds": 3.12,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.64,
      "end_seconds": 204.99,
      "duration_seconds": 7.35,
      "text": "I don't think I have it with me. I'm on cranberry juice, daily."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.28,
      "end_seconds": 227.66,
      "duration_seconds": 4.38,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.68,
      "end_seconds": 231.89,
      "duration_seconds": 3.21,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 232.72,
      "end_seconds": 242.18,
      "duration_seconds": 9.46,
      "text": "Doctor, I've got the readings for you. Blood pressure 108 over 80, pulse 84. Saturation 97 percent, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.74,
      "end_seconds": 244.28,
      "duration_seconds": 1.54,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.64,
      "end_seconds": 249.24,
      "duration_seconds": 2.6,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.61,
      "end_seconds": 252.03,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.51,
      "end_seconds": 275.95,
      "duration_seconds": 5.44,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.97,
      "end_seconds": 292.97,
      "duration_seconds": 12.0,
      "text": "All finished, thank you. From what you've told me and what I found, this is probably an uncomplicated urinary infection. I can't rule out vaginal irritation yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 306.53,
      "end_seconds": 312.3,
      "duration_seconds": 5.77,
      "text": "Doctor, I did a urine dipstick before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.38,
      "end_seconds": 333.57,
      "duration_seconds": 18.19,
      "text": "Okay, thanks, I'll have a look. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. For now, no new medicines or tests are needed. Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.47,
      "end_seconds": 337.99,
      "duration_seconds": 3.52,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}