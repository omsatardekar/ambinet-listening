{
  "schema_version": "1.0",
  "encounter_id": "01127",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 7.89,
      "duration_seconds": 6.75,
      "text": "Mm, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.58,
      "end_seconds": 13.96,
      "duration_seconds": 4.38,
      "text": "No problem at all come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.09,
      "end_seconds": 22.25,
      "duration_seconds": 7.16,
      "text": "Honestly it's crushing chest pain and my family pushed me to to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.92,
      "end_seconds": 27.26,
      "duration_seconds": 3.34,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.02,
      "end_seconds": 31.01,
      "duration_seconds": 2.99,
      "text": "I've had it for three weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.83,
      "end_seconds": 37.51,
      "duration_seconds": 5.68,
      "text": "okay give me more detail on it it whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.37,
      "end_seconds": 57.09,
      "duration_seconds": 17.72,
      "text": "Exertion definitely sets it it off. I get some relief from rest. Honestly, once or twice a day. A neighbour of mine said I should see someone about it. Let me think, and I've been sweating as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.52,
      "end_seconds": 61.71,
      "duration_seconds": 3.19,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.48,
      "end_seconds": 66.18,
      "duration_seconds": 2.7,
      "text": "about a seven out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.7,
      "end_seconds": 82.44,
      "duration_seconds": 3.74,
      "text": "what about your parents brothers or sisters any conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.0,
      "end_seconds": 86.91,
      "duration_seconds": 2.91,
      "text": "ah, my grandfather had a stroke"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.13,
      "end_seconds": 90.23,
      "duration_seconds": 2.1,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.53,
      "end_seconds": 95.8,
      "duration_seconds": 4.27,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.36,
      "end_seconds": 99.55,
      "duration_seconds": 2.19,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.59,
      "end_seconds": 104.86,
      "duration_seconds": 4.27,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.59,
      "end_seconds": 120.04,
      "duration_seconds": 2.45,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.59,
      "end_seconds": 123.08,
      "duration_seconds": 1.49,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.37,
      "end_seconds": 135.44,
      "duration_seconds": 2.07,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.13,
      "end_seconds": 150.24,
      "duration_seconds": 13.11,
      "text": "okay so I had keyhole surgery on my gallbladder two years back i looked a few things up online and that probably didn't help"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.31,
      "end_seconds": 153.64,
      "duration_seconds": 2.33,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.35,
      "end_seconds": 157.02,
      "duration_seconds": 2.67,
      "text": "No I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.61,
      "end_seconds": 162.57,
      "duration_seconds": 3.96,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.14,
      "end_seconds": 167.52,
      "duration_seconds": 3.38,
      "text": "oh no I've always been fairly healthy"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.0,
      "end_seconds": 174.43,
      "duration_seconds": 5.43,
      "text": "Let me check a few things. Any fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.31,
      "end_seconds": 180.16,
      "duration_seconds": 4.85,
      "text": "No fever, cough or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.64,
      "end_seconds": 184.3,
      "duration_seconds": 3.66,
      "text": "Mm-hmm. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.57,
      "end_seconds": 189.45,
      "duration_seconds": 3.88,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.6,
      "end_seconds": 200.49,
      "duration_seconds": 2.89,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.55,
      "end_seconds": 214.5,
      "duration_seconds": 2.95,
      "text": "Right, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.54,
      "end_seconds": 256.85,
      "duration_seconds": 29.31,
      "text": "okay: temperature is 36.7 degrees, blood pressure 129 over 87, pulse is 114 beats a minute and oxygen saturation is 97 percent, respiratory rate 19. Okay, so my impression from what you've said is this: The most likely explanation is a possible heart attack i want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.53,
      "end_seconds": 261.01,
      "duration_seconds": 2.48,
      "text": "Erm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.52,
      "end_seconds": 288.87,
      "duration_seconds": 26.35,
      "text": "I understand the worry at the moment I'd say it's a possible heart attack and we'll know more once the an ECG is back i'm sending you for an ECG because of chest pain. A troponin blood test is what I'd like next for chest pain for this aspirin 300 milligrams once now single dose it's for possible heart attack"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.88,
      "end_seconds": 293.62,
      "duration_seconds": 2.74,
      "text": "should I take that with food?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.71,
      "end_seconds": 301.38,
      "duration_seconds": 6.67,
      "text": "Stay lying down and do not eat or drink. We'll refer you to the cardiac team."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.31,
      "end_seconds": 304.01,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.62,
      "end_seconds": 311.5,
      "duration_seconds": 5.88,
      "text": "If the pain returns or you feel really unwell please come to the emergency department."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.4,
      "end_seconds": 315.03,
      "duration_seconds": 1.63,
      "text": "I'll remember that"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.19,
      "end_seconds": 318.89,
      "duration_seconds": 2.7,
      "text": "let's plan a check straight away"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.9,
      "end_seconds": 323.03,
      "duration_seconds": 2.13,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.72,
      "end_seconds": 327.3,
      "duration_seconds": 3.58,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.11,
      "end_seconds": 329.64,
      "duration_seconds": 1.53,
      "text": "that's clear, thanks"
    }
  ]
