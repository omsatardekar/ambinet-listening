{
  "schema_version": "1.0",
  "encounter_id": "01079",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.18,
      "end_seconds": 4.84,
      "duration_seconds": 3.66,
      "text": "Okay, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.3,
      "end_seconds": 7.46,
      "duration_seconds": 1.16,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.69,
      "end_seconds": 11.77,
      "duration_seconds": 3.08,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.88,
      "end_seconds": 23.53,
      "duration_seconds": 8.65,
      "text": "Erm, mainly a runny nose. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.5,
      "end_seconds": 31.99,
      "duration_seconds": 3.49,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.67,
      "end_seconds": 43.62,
      "duration_seconds": 2.95,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.26,
      "end_seconds": 71.51,
      "duration_seconds": 8.25,
      "text": "Okay: heart rate 78, temp 36.7 degrees. And SpO2 99 percent on room air, blood pressure 124 over 74."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.33,
      "end_seconds": 85.35,
      "duration_seconds": 3.02,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.69,
      "end_seconds": 93.68,
      "duration_seconds": 6.99,
      "text": "I, I'd say ten days. Actually, no, closer to three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.83,
      "end_seconds": 98.27,
      "duration_seconds": 3.44,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.36,
      "end_seconds": 101.86,
      "duration_seconds": 1.5,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.49,
      "end_seconds": 105.29,
      "duration_seconds": 2.8,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.72,
      "end_seconds": 130.11,
      "duration_seconds": 23.39,
      "text": "When it starts I tend to get a scratchy throat as well. I've had a mild cough too, uh, for about two weeks. As for mild cough, honestly, all the time. Actually, the scratchy throat? That's been since last night."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.31,
      "end_seconds": 134.88,
      "duration_seconds": 3.57,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.93,
      "end_seconds": 138.02,
      "duration_seconds": 2.09,
      "text": "I, I'd say mild."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.77,
      "end_seconds": 143.81,
      "duration_seconds": 5.04,
      "text": "Have you noticed shortness of breath, chest pain, ear pain or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.16,
      "end_seconds": 152.2,
      "duration_seconds": 7.04,
      "text": "I haven't had shortness of breath, chest pain, ear pain or fever, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.72,
      "end_seconds": 156.38,
      "duration_seconds": 3.66,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.46,
      "end_seconds": 164.68,
      "duration_seconds": 2.22,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.47,
      "end_seconds": 169.96,
      "duration_seconds": 3.49,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.82,
      "end_seconds": 177.68,
      "duration_seconds": 3.86,
      "text": "Right, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.38,
      "end_seconds": 179.97,
      "duration_seconds": 1.59,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.82,
      "end_seconds": 184.62,
      "duration_seconds": 3.8,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.0,
      "end_seconds": 188.79,
      "duration_seconds": 2.79,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.63,
      "end_seconds": 193.26,
      "duration_seconds": 3.63,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.8,
      "end_seconds": 198.52,
      "duration_seconds": 3.72,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.63,
      "end_seconds": 205.02,
      "duration_seconds": 5.39,
      "text": "Carvedilol. I take it 6.25 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.91,
      "end_seconds": 208.68,
      "duration_seconds": 2.77,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.24,
      "end_seconds": 215.42,
      "duration_seconds": 6.18,
      "text": "For about a year. Actually, I take throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.32,
      "end_seconds": 225.51,
      "duration_seconds": 1.19,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.17,
      "end_seconds": 227.93,
      "duration_seconds": 1.76,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.98,
      "end_seconds": 237.6,
      "duration_seconds": 7.62,
      "text": "Any allergies to tablets, food or anything in the environment? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.91,
      "end_seconds": 247.29,
      "duration_seconds": 8.38,
      "text": "Hmm, uh, not currently, but as a youngster erythromycin gave me bad stomach cramps."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.69,
      "end_seconds": 253.8,
      "duration_seconds": 5.11,
      "text": "Okay, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.65,
      "end_seconds": 258.44,
      "duration_seconds": 3.79,
      "text": "I've, I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.72,
      "end_seconds": 263.87,
      "duration_seconds": 3.15,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.72,
      "end_seconds": 267.63,
      "duration_seconds": 1.91,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.6,
      "end_seconds": 286.33,
      "duration_seconds": 4.73,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.33,
      "end_seconds": 288.34,
      "duration_seconds": 1.01,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.48,
      "end_seconds": 292.23,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.37,
      "end_seconds": 322.22,
      "duration_seconds": 13.85,
      "text": "Right, here's what I'm thinking. I think we're dealing with a simple viral cold at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.03,
      "end_seconds": 326.83,
      "duration_seconds": 3.8,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.33,
      "end_seconds": 354.15,
      "duration_seconds": 25.82,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold. Rest, plenty of fluids, and paracetamol if you ache. If you develop a high fever or trouble breathing, that's the point to come in urgently. I'd like you back if it is not better in ten days."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 355.19,
      "end_seconds": 358.22,
      "duration_seconds": 3.03,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.42,
      "end_seconds": 363.17,
      "duration_seconds": 3.75,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.75,
      "end_seconds": 367.13,
      "duration_seconds": 3.38,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.16,
      "end_seconds": 370.61,
      "duration_seconds": 1.45,
      "text": "All the best."
    }
  ]
}