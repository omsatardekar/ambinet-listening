{
  "schema_version": "1.0",
  "encounter_id": "01468",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.71,
      "end_seconds": 6.93,
      "duration_seconds": 6.22,
      "text": "So, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.85,
      "end_seconds": 12.03,
      "duration_seconds": 4.18,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.06,
      "end_seconds": 17.67,
      "duration_seconds": 4.61,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.38,
      "end_seconds": 21.89,
      "duration_seconds": 3.51,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.71,
      "end_seconds": 28.17,
      "duration_seconds": 5.46,
      "text": "Doctor, it's no real problems. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 29.38,
      "end_seconds": 38.35,
      "duration_seconds": 8.97,
      "text": "Doctor, I've got the readings for you. Pulse is 78 beats a minute, saturation 99 percent, pressure 114 over 74."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.96,
      "end_seconds": 40.95,
      "duration_seconds": 1.99,
      "text": "Thanks. When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.78,
      "end_seconds": 55.85,
      "duration_seconds": 13.07,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.85,
      "end_seconds": 61.21,
      "duration_seconds": 3.36,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.76,
      "end_seconds": 65.61,
      "duration_seconds": 2.85,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.02,
      "end_seconds": 73.27,
      "duration_seconds": 7.25,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 73.37,
      "end_seconds": 78.36,
      "duration_seconds": 4.99,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.4,
      "end_seconds": 86.28,
      "duration_seconds": 5.88,
      "text": "I was getting to that! There's an occasional headache as well."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.28,
      "end_seconds": 105.17,
      "duration_seconds": 3.89,
      "text": "Have you had weight loss, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 109.63,
      "duration_seconds": 3.37,
      "text": "I haven't noticed any weight loss."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.89,
      "end_seconds": 115.66,
      "duration_seconds": 4.77,
      "text": "A few quick ones: shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.13,
      "end_seconds": 134.64,
      "duration_seconds": 14.51,
      "text": "No, no shortness of breath, no chest pain. I did have a bit of back stiffness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.56,
      "end_seconds": 139.02,
      "duration_seconds": 2.46,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.7,
      "end_seconds": 141.71,
      "duration_seconds": 1.01,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.22,
      "end_seconds": 146.51,
      "duration_seconds": 3.29,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.59,
      "end_seconds": 152.1,
      "duration_seconds": 4.51,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.79,
      "end_seconds": 156.73,
      "duration_seconds": 3.94,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.26,
      "end_seconds": 171.85,
      "duration_seconds": 13.59,
      "text": "I have high cholesterol, for about ten years. It's the not knowing that gets to me. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.32,
      "end_seconds": 174.1,
      "duration_seconds": 0.78,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.52,
      "end_seconds": 181.51,
      "duration_seconds": 5.99,
      "text": "Gout, for about ten years. I've had asthma, yes. I've got migraines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.0,
      "end_seconds": 183.9,
      "duration_seconds": 0.9,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.95,
      "end_seconds": 194.26,
      "duration_seconds": 9.31,
      "text": "Alright, high cholesterol and gout, that matches what I have here. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.51,
      "end_seconds": 197.51,
      "duration_seconds": 2.0,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.81,
      "end_seconds": 202.5,
      "duration_seconds": 3.69,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.2,
      "end_seconds": 209.46,
      "duration_seconds": 6.26,
      "text": "I'm on something called simv... simvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.12,
      "end_seconds": 215.95,
      "duration_seconds": 4.83,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.65,
      "end_seconds": 226.81,
      "duration_seconds": 9.16,
      "text": "Not with me. I'll bring it next time. I'm on febuxostat, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.64,
      "end_seconds": 234.6,
      "duration_seconds": 2.96,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.06,
      "end_seconds": 247.79,
      "duration_seconds": 11.73,
      "text": "About three months now. I'm on Seretide inhaler, twice a day. I take sumatriptan, 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.78,
      "end_seconds": 252.91,
      "duration_seconds": 3.13,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.17,
      "end_seconds": 256.28,
      "duration_seconds": 2.11,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.2,
      "end_seconds": 260.41,
      "duration_seconds": 3.21,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.16,
      "end_seconds": 263.98,
      "duration_seconds": 1.82,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.03,
      "end_seconds": 281.59,
      "duration_seconds": 2.56,
      "text": "Alright, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.57,
      "end_seconds": 289.28,
      "duration_seconds": 5.71,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.04,
      "end_seconds": 293.45,
      "duration_seconds": 3.41,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.7,
      "end_seconds": 299.21,
      "duration_seconds": 4.51,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.83,
      "end_seconds": 304.59,
      "duration_seconds": 2.76,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.11,
      "end_seconds": 308.07,
      "duration_seconds": 1.96,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.73,
      "end_seconds": 320.13,
      "duration_seconds": 2.4,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.99,
      "end_seconds": 336.53,
      "duration_seconds": 11.54,
      "text": "Okay, that's enough for me. Taking everything into account, I think we're dealing with a healthy adult with no worrying findings at this stage."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.34,
      "end_seconds": 338.73,
      "duration_seconds": 1.39,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.76,
      "end_seconds": 358.87,
      "duration_seconds": 19.11,
      "text": "I can't promise yet, but most people with a healthy adult with no worrying findings do well once it's treated properly. Just to be sure I understood. You've had no real problems, and no shortness of breath or weight loss."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 360.95,
      "end_seconds": 363.13,
      "duration_seconds": 2.18,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.56,
      "end_seconds": 368.99,
      "duration_seconds": 4.43,
      "text": "Let's get a fasting sugar test, for routine check."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.79,
      "end_seconds": 373.05,
      "duration_seconds": 2.26,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.67,
      "end_seconds": 394.13,
      "duration_seconds": 19.46,
      "text": "A cholesterol blood test is what I'd like next, for routine check. Keep up regular exercise and a balanced diet. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 395.44,
      "end_seconds": 398.4,
      "duration_seconds": 2.96,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.59,
      "end_seconds": 406.25,
      "duration_seconds": 6.66,
      "text": "If new symptoms appear, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.68,
      "end_seconds": 410.65,
      "duration_seconds": 2.97,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.72,
      "end_seconds": 414.33,
      "duration_seconds": 2.61,
      "text": "Book a review in twelve months."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.04,
      "end_seconds": 417.26,
      "duration_seconds": 2.22,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.46,
      "end_seconds": 425.76,
      "duration_seconds": 7.3,
      "text": "Alright, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.54,
      "end_seconds": 431.76,
      "duration_seconds": 5.22,
      "text": "So, I come back in twelve months. Is that right?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.71,
      "end_seconds": 437.43,
      "duration_seconds": 3.72,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 439.34,
      "end_seconds": 441.44,
      "duration_seconds": 2.1,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.28,
      "end_seconds": 444.61,
      "duration_seconds": 1.33,
      "text": "Take care now."
    }
  ]
}