{
  "schema_version": "1.0",
  "encounter_id": "01291",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 4.26,
      "duration_seconds": 3.18,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.06,
      "end_seconds": 12.76,
      "duration_seconds": 3.7,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.8,
      "end_seconds": 17.86,
      "duration_seconds": 4.06,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.63,
      "end_seconds": 23.15,
      "duration_seconds": 4.52,
      "text": "It's an itchy patch on my wrist, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.11,
      "end_seconds": 26.08,
      "duration_seconds": 1.97,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.17,
      "end_seconds": 31.29,
      "duration_seconds": 3.12,
      "text": "Erm, it's been two months now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.34,
      "end_seconds": 41.84,
      "duration_seconds": 9.5,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.22,
      "end_seconds": 60.74,
      "duration_seconds": 17.52,
      "text": "My new watch strap definitely sets it off. About a seven out of ten. As for bit of redness, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.74,
      "end_seconds": 65.57,
      "duration_seconds": 3.83,
      "text": "What about dry flaky skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.21,
      "end_seconds": 71.0,
      "duration_seconds": 3.79,
      "text": "Actually, yes, about the same, two days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 71.82,
      "end_seconds": 83.44,
      "duration_seconds": 11.62,
      "text": "Doctor, I've got the readings for you. Temp 36.8 degrees, heart rate 69, SpO2 99 percent on room air, respiratory rate 17, pressure 121 over 80."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.05,
      "end_seconds": 90.43,
      "duration_seconds": 1.38,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.99,
      "end_seconds": 98.45,
      "duration_seconds": 5.46,
      "text": "Okay, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.04,
      "end_seconds": 101.06,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.75,
      "end_seconds": 104.09,
      "duration_seconds": 1.34,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.55,
      "end_seconds": 128.95,
      "duration_seconds": 6.4,
      "text": "There's a neat red patch where the watch strap sits, with a little scaling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.21,
      "end_seconds": 135.82,
      "duration_seconds": 1.61,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.55,
      "end_seconds": 149.58,
      "duration_seconds": 8.03,
      "text": "Thank you, you can get dressed. Let me check a few things. Any fever, spreading or blisters?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.48,
      "end_seconds": 155.94,
      "duration_seconds": 4.46,
      "text": "Sorry, what was I saying, nope, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.47,
      "end_seconds": 159.61,
      "duration_seconds": 2.14,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.55,
      "end_seconds": 163.78,
      "duration_seconds": 2.23,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.47,
      "end_seconds": 166.73,
      "duration_seconds": 2.26,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.28,
      "end_seconds": 174.96,
      "duration_seconds": 2.68,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.64,
      "end_seconds": 189.62,
      "duration_seconds": 2.98,
      "text": "Right, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.68,
      "end_seconds": 196.38,
      "duration_seconds": 4.7,
      "text": "I take paracetamol, 650 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.83,
      "end_seconds": 202.5,
      "duration_seconds": 4.67,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.2,
      "end_seconds": 218.62,
      "duration_seconds": 14.42,
      "text": "Not with me. I'll bring it next time. Apixaban. I take it 5 milligrams, twice a day for the heart rhythm. I take a plain moisturiser, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.44,
      "end_seconds": 220.61,
      "duration_seconds": 1.17,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.93,
      "end_seconds": 225.66,
      "duration_seconds": 3.73,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.37,
      "end_seconds": 229.9,
      "duration_seconds": 2.53,
      "text": "Alright, who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.09,
      "end_seconds": 236.5,
      "duration_seconds": 2.41,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.1,
      "end_seconds": 240.84,
      "duration_seconds": 2.74,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.55,
      "end_seconds": 244.42,
      "duration_seconds": 2.87,
      "text": "Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.14,
      "end_seconds": 249.16,
      "duration_seconds": 3.02,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.04,
      "end_seconds": 254.86,
      "duration_seconds": 3.82,
      "text": "Let me think, I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.46,
      "end_seconds": 256.56,
      "duration_seconds": 1.1,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.18,
      "end_seconds": 262.3,
      "duration_seconds": 5.12,
      "text": "I have an irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.39,
      "end_seconds": 271.15,
      "duration_seconds": 7.76,
      "text": "Right, so acid reflux and an irregular heartbeat are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 282.9,
      "duration_seconds": 4.02,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.73,
      "end_seconds": 292.2,
      "duration_seconds": 7.47,
      "text": "My father had bowel cancer. Sorry, what was I saying, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.35,
      "end_seconds": 296.26,
      "duration_seconds": 2.91,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.26,
      "end_seconds": 300.66,
      "duration_seconds": 2.4,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.3,
      "end_seconds": 314.15,
      "duration_seconds": 2.85,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.03,
      "end_seconds": 322.11,
      "duration_seconds": 3.08,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.72,
      "end_seconds": 346.41,
      "duration_seconds": 22.69,
      "text": "Right, here's what I'm thinking. The most likely explanation is mild contact dermatitis from the watch strap. I'd also keep eczema in mind. Stop me if I've got anything wrong. You've had an itchy patch on your wrist for two months, and no blisters or fever."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.58,
      "end_seconds": 348.28,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.31,
      "end_seconds": 367.89,
      "duration_seconds": 17.58,
      "text": "You'll be taking hydrocortisone cream, 1%, once a day, one week. That's for contact dermatitis. Stop wearing that strap and keep the skin moisturised. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.0,
      "end_seconds": 371.83,
      "duration_seconds": 2.83,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.01,
      "end_seconds": 379.04,
      "duration_seconds": 6.03,
      "text": "If it spreads or blisters, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.8,
      "end_seconds": 382.9,
      "duration_seconds": 2.1,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.08,
      "end_seconds": 388.59,
      "duration_seconds": 4.51,
      "text": "We'll catch up if it has not cleared in two weeks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.55,
      "end_seconds": 391.03,
      "duration_seconds": 1.48,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.8,
      "end_seconds": 396.83,
      "duration_seconds": 4.03,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.46,
      "end_seconds": 410.27,
      "duration_seconds": 11.81,
      "text": "So, I take the hydrocortisone cream, 1%, once a day and come back if it has not cleared in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.14,
      "end_seconds": 416.31,
      "duration_seconds": 4.17,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.0,
      "end_seconds": 425.2,
      "duration_seconds": 3.2,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}