{
  "schema_version": "1.0",
  "encounter_id": "01289",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.43,
      "duration_seconds": 4.3,
      "text": "Ah, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.44,
      "end_seconds": 10.78,
      "duration_seconds": 4.34,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.24,
      "end_seconds": 17.31,
      "duration_seconds": 5.07,
      "text": "I'm, I'm here because of sudden shortness of breath."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.2,
      "end_seconds": 21.28,
      "duration_seconds": 3.08,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.82,
      "end_seconds": 30.21,
      "duration_seconds": 8.39,
      "text": "Sorry, what was I saying, it's been about three months now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.09,
      "end_seconds": 34.53,
      "duration_seconds": 2.44,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.83,
      "end_seconds": 44.79,
      "duration_seconds": 3.96,
      "text": "Yes, breathing in. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.88,
      "end_seconds": 55.85,
      "duration_seconds": 2.97,
      "text": "Any wheeze, fever or chest tightness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.42,
      "end_seconds": 59.26,
      "duration_seconds": 2.84,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.7,
      "end_seconds": 64.69,
      "duration_seconds": 3.99,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.64,
      "end_seconds": 69.5,
      "duration_seconds": 3.86,
      "text": "Okay, so no, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 74.3,
      "duration_seconds": 2.89,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.33,
      "end_seconds": 78.61,
      "duration_seconds": 2.28,
      "text": "No, um, never."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.66,
      "end_seconds": 92.68,
      "duration_seconds": 4.02,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.93,
      "end_seconds": 96.72,
      "duration_seconds": 2.79,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.64,
      "end_seconds": 102.25,
      "duration_seconds": 4.61,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.38,
      "end_seconds": 109.83,
      "duration_seconds": 6.45,
      "text": "I take tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.38,
      "end_seconds": 130.93,
      "duration_seconds": 2.55,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.27,
      "end_seconds": 145.98,
      "duration_seconds": 13.71,
      "text": "So, I have an enlarged prostate. My family kept telling me to get it checked. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.76,
      "end_seconds": 149.57,
      "duration_seconds": 1.81,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.68,
      "end_seconds": 154.84,
      "duration_seconds": 4.16,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.66,
      "end_seconds": 158.09,
      "duration_seconds": 1.43,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.46,
      "end_seconds": 162.57,
      "duration_seconds": 3.11,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.6,
      "end_seconds": 166.77,
      "duration_seconds": 2.17,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.48,
      "end_seconds": 170.09,
      "duration_seconds": 2.61,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.96,
      "end_seconds": 185.51,
      "duration_seconds": 2.55,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.5,
      "end_seconds": 200.66,
      "duration_seconds": 2.16,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.3,
      "end_seconds": 225.69,
      "duration_seconds": 9.39,
      "text": "Okay: temperature 37.5, respiratory rate 22, BP is 132 over 83, pulse 90, oxygen saturation is 91 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.61,
      "end_seconds": 231.76,
      "duration_seconds": 4.15,
      "text": "So, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.17,
      "end_seconds": 235.17,
      "duration_seconds": 2.0,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 254.03,
      "duration_seconds": 6.06,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.06,
      "end_seconds": 265.04,
      "duration_seconds": 8.98,
      "text": "That's all I needed to check. Taking everything into account, I'd lean towards a possible blood clot in the lung."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.23,
      "end_seconds": 267.83,
      "duration_seconds": 1.6,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.1,
      "end_seconds": 287.3,
      "duration_seconds": 18.2,
      "text": "It's reasonable to be concerned, but right now a possible blood clot in the lung is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had sudden shortness of breath for about three months, and no fever or wheeze."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.39,
      "end_seconds": 289.09,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.75,
      "end_seconds": 295.96,
      "duration_seconds": 5.21,
      "text": "Let's book a D-dimer blood test to look into possible clot."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 297.44,
      "end_seconds": 302.06,
      "duration_seconds": 4.62,
      "text": "We have a slot Monday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.5,
      "end_seconds": 306.08,
      "duration_seconds": 2.58,
      "text": "Monday, that works for me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.94,
      "end_seconds": 318.48,
      "duration_seconds": 11.54,
      "text": "You need to go to hospital now for a scan. Come back or go to emergency straight away if you feel faint. See me again straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.24,
      "end_seconds": 325.45,
      "duration_seconds": 6.21,
      "text": "Sorry, what was I saying, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.37,
      "end_seconds": 330.33,
      "duration_seconds": 3.96,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.08,
      "end_seconds": 333.83,
      "duration_seconds": 1.75,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.59,
      "end_seconds": 336.8,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}