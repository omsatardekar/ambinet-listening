{
  "schema_version": "1.0",
  "encounter_id": "01482",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 3.03,
      "duration_seconds": 2.45,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.59,
      "end_seconds": 13.75,
      "duration_seconds": 5.16,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.26,
      "end_seconds": 22.56,
      "duration_seconds": 7.3,
      "text": "Uh, hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.46,
      "end_seconds": 29.24,
      "duration_seconds": 4.78,
      "text": "Please do. Extra information is always welcome. Busy day out there?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.04,
      "end_seconds": 34.73,
      "duration_seconds": 3.69,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.38,
      "end_seconds": 38.85,
      "duration_seconds": 3.47,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.91,
      "end_seconds": 44.17,
      "duration_seconds": 3.26,
      "text": "He's been having a sore ankle, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.88,
      "end_seconds": 48.42,
      "duration_seconds": 3.54,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.44,
      "end_seconds": 52.58,
      "duration_seconds": 2.14,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.17,
      "end_seconds": 56.58,
      "duration_seconds": 2.41,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.11,
      "end_seconds": 59.99,
      "duration_seconds": 2.88,
      "text": "Only ice, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.79,
      "end_seconds": 63.29,
      "duration_seconds": 2.5,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.44,
      "end_seconds": 76.94,
      "duration_seconds": 12.5,
      "text": "A little swelling goes along with it, most of the time. With little swelling, it happens every other day. It settles a little with elevation."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.58,
      "end_seconds": 83.95,
      "duration_seconds": 6.37,
      "text": "Have you had a sore ankle before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.95,
      "end_seconds": 92.84,
      "duration_seconds": 7.89,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.63,
      "end_seconds": 99.93,
      "duration_seconds": 5.3,
      "text": "Any crack or pop, numbness or pain in the foot at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.12,
      "end_seconds": 108.42,
      "duration_seconds": 7.3,
      "text": "I haven't had crack or pop, numbness or pain in the foot, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.35,
      "end_seconds": 113.79,
      "duration_seconds": 3.44,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.9,
      "end_seconds": 115.89,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.99,
      "end_seconds": 132.19,
      "duration_seconds": 1.2,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.41,
      "end_seconds": 136.67,
      "duration_seconds": 3.26,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.18,
      "end_seconds": 140.63,
      "duration_seconds": 2.45,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.21,
      "end_seconds": 146.71,
      "duration_seconds": 4.5,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.57,
      "end_seconds": 150.74,
      "duration_seconds": 3.17,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.91,
      "end_seconds": 157.25,
      "duration_seconds": 5.34,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.43,
      "end_seconds": 162.33,
      "duration_seconds": 3.9,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 166.26,
      "end_seconds": 173.49,
      "duration_seconds": 7.23,
      "text": "He is on propranolol, 40 milligrams, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.17,
      "end_seconds": 176.94,
      "duration_seconds": 2.77,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 178.56,
      "end_seconds": 180.68,
      "duration_seconds": 2.12,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.03,
      "end_seconds": 181.95,
      "duration_seconds": 0.92,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 182.72,
      "end_seconds": 185.2,
      "duration_seconds": 2.48,
      "text": "He takes tamsulosin, at night."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.63,
      "end_seconds": 188.8,
      "duration_seconds": 2.17,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.56,
      "end_seconds": 201.97,
      "duration_seconds": 11.41,
      "text": "0.4 milligrams, I think that's what's on the box. He is on ibuprofen gel, three times a day, I give it to him."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 223.88,
      "duration_seconds": 3.4,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.74,
      "end_seconds": 229.18,
      "duration_seconds": 4.44,
      "text": "Migraines, for five years. I've got an enlarged prostate."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.53,
      "end_seconds": 244.43,
      "duration_seconds": 11.9,
      "text": "Alright, an enlarged prostate, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.07,
      "end_seconds": 249.77,
      "duration_seconds": 3.7,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.26,
      "end_seconds": 254.96,
      "duration_seconds": 3.7,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.75,
      "end_seconds": 258.73,
      "duration_seconds": 1.98,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.62,
      "end_seconds": 263.84,
      "duration_seconds": 3.22,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.08,
      "end_seconds": 275.07,
      "duration_seconds": 1.99,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.92,
      "end_seconds": 304.93,
      "duration_seconds": 10.01,
      "text": "Okay: SpO2 99 percent on room air, pulse is 75 beats a minute, respiratory rate 18, temp 36.6 degrees, pressure 113 over 75."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.21,
      "end_seconds": 310.24,
      "duration_seconds": 4.03,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.5,
      "end_seconds": 313.45,
      "duration_seconds": 1.95,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.99,
      "end_seconds": 336.06,
      "duration_seconds": 7.07,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.13,
      "end_seconds": 346.93,
      "duration_seconds": 7.8,
      "text": "You can relax now. Let me tell you where I've got to. It fits best with a mild ankle sprain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.7,
      "end_seconds": 368.68,
      "duration_seconds": 8.98,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.68,
      "end_seconds": 374.15,
      "duration_seconds": 3.47,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}