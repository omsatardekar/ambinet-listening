{
  "schema_version": "1.0",
  "encounter_id": "01480",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 4.66,
      "duration_seconds": 3.32,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 9.62,
      "duration_seconds": 4.4,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.41,
      "end_seconds": 14.33,
      "duration_seconds": 3.92,
      "text": "It's, It's burning when I pass urine, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.92,
      "end_seconds": 18.97,
      "duration_seconds": 3.05,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.75,
      "end_seconds": 23.16,
      "duration_seconds": 2.41,
      "text": "Probably about four days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.45,
      "end_seconds": 27.19,
      "duration_seconds": 3.74,
      "text": "Mm-hmm. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.9,
      "end_seconds": 33.65,
      "duration_seconds": 5.75,
      "text": "It usually comes with a dull ache low in my tummy."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.64,
      "end_seconds": 41.76,
      "duration_seconds": 3.12,
      "text": "Have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.33,
      "end_seconds": 45.01,
      "duration_seconds": 1.68,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.94,
      "end_seconds": 49.4,
      "duration_seconds": 2.46,
      "text": "Right, how frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.45,
      "end_seconds": 55.99,
      "duration_seconds": 2.54,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.32,
      "end_seconds": 59.63,
      "duration_seconds": 3.31,
      "text": "Mm-hmm. Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.25,
      "end_seconds": 64.85,
      "duration_seconds": 3.6,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 68.36,
      "duration_seconds": 2.8,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.06,
      "end_seconds": 74.23,
      "duration_seconds": 4.17,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.16,
      "end_seconds": 78.25,
      "duration_seconds": 2.09,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.16,
      "end_seconds": 83.79,
      "duration_seconds": 3.63,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.84,
      "end_seconds": 89.18,
      "duration_seconds": 3.34,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.86,
      "end_seconds": 94.86,
      "duration_seconds": 4.0,
      "text": "I mean, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.1,
      "end_seconds": 101.0,
      "duration_seconds": 4.9,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.04,
      "end_seconds": 107.19,
      "duration_seconds": 4.15,
      "text": "I have arthritis in my knees, for two years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.7,
      "end_seconds": 113.96,
      "duration_seconds": 5.26,
      "text": "Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.98,
      "end_seconds": 132.99,
      "duration_seconds": 3.01,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.84,
      "end_seconds": 138.47,
      "duration_seconds": 3.63,
      "text": "Yes, walnuts, it gives me hives."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.74,
      "end_seconds": 146.33,
      "duration_seconds": 3.59,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.23,
      "end_seconds": 155.19,
      "duration_seconds": 6.96,
      "text": "Naproxen, 250 milligrams, twice a day. Yeah, I'm on cranberry juice, daily."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.83,
      "end_seconds": 168.23,
      "duration_seconds": 5.4,
      "text": "Did you get vaginal discharge, fever or blood in the urine?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.85,
      "end_seconds": 171.34,
      "duration_seconds": 2.49,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.44,
      "end_seconds": 174.36,
      "duration_seconds": 1.92,
      "text": "Nothing like back pain?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.61,
      "end_seconds": 180.6,
      "duration_seconds": 1.99,
      "text": "No. No back pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.0,
      "end_seconds": 186.08,
      "duration_seconds": 4.08,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.54,
      "end_seconds": 189.3,
      "duration_seconds": 1.76,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.65,
      "end_seconds": 193.76,
      "duration_seconds": 3.11,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.32,
      "end_seconds": 196.95,
      "duration_seconds": 1.63,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.49,
      "end_seconds": 202.67,
      "duration_seconds": 4.18,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.04,
      "end_seconds": 211.6,
      "duration_seconds": 2.56,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.3,
      "end_seconds": 237.29,
      "duration_seconds": 7.99,
      "text": "Okay: respiratory rate 17, oxygen saturation is 98 percent, pulse 64, temperature 36.7, pressure 112 over 76."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.91,
      "end_seconds": 242.98,
      "duration_seconds": 4.07,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.2,
      "end_seconds": 246.24,
      "duration_seconds": 2.04,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.42,
      "end_seconds": 261.2,
      "duration_seconds": 5.78,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.88,
      "end_seconds": 265.51,
      "duration_seconds": 1.63,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.53,
      "end_seconds": 288.3,
      "duration_seconds": 9.77,
      "text": "Taking everything into account, the most likely explanation is an uncomplicated urinary infection. A urine dipstick is what I'd like next, for burning urine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 289.75,
      "end_seconds": 292.41,
      "duration_seconds": 2.66,
      "text": "The earliest is Wednesday, 10 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.21,
      "end_seconds": 300.45,
      "duration_seconds": 7.24,
      "text": "You'll be taking nitrofurantoin, 100 milligrams, twice a day, three days. That's for urinary infection."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.6,
      "end_seconds": 303.13,
      "duration_seconds": 1.53,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.99,
      "end_seconds": 314.63,
      "duration_seconds": 10.64,
      "text": "Drink plenty of water and avoid holding urine. Come back or go to emergency straight away if you get a fever or back pain."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.34,
      "end_seconds": 320.51,
      "duration_seconds": 2.17,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.4,
      "end_seconds": 330.31,
      "duration_seconds": 4.91,
      "text": "See me again if it is not better in three days."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.08,
      "end_seconds": 331.78,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.37,
      "end_seconds": 336.79,
      "duration_seconds": 4.42,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.36,
      "end_seconds": 340.79,
      "duration_seconds": 3.43,
      "text": "So, I think I understand everything. Thanks."
    }
  ]
}