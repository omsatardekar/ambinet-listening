{
  "schema_version": "1.0",
  "encounter_id": "01097",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 5.12,
      "duration_seconds": 4.03,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.07,
      "end_seconds": 13.81,
      "duration_seconds": 4.74,
      "text": "okay, yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.19,
      "end_seconds": 25.31,
      "duration_seconds": 10.12,
      "text": "Mainly an itchy patch on my wrist. There's a a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.7,
      "end_seconds": 28.1,
      "duration_seconds": 1.4,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.65,
      "end_seconds": 31.1,
      "duration_seconds": 2.45,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.43,
      "end_seconds": 40.77,
      "duration_seconds": 8.34,
      "text": "alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.17,
      "end_seconds": 60.65,
      "duration_seconds": 18.48,
      "text": "a seven out of ten, I suppose. It happens all the time. Moisturiser helps a bit. Oh, and a bit of redness. Had that since last night. Oh, and dry flaky skin"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.41,
      "end_seconds": 65.96,
      "duration_seconds": 3.55,
      "text": "is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.38,
      "end_seconds": 70.66,
      "duration_seconds": 3.28,
      "text": "Pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.79,
      "end_seconds": 87.46,
      "duration_seconds": 3.67,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.25,
      "end_seconds": 91.63,
      "duration_seconds": 2.38,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 109.41,
      "duration_seconds": 7.95,
      "text": "do you take any prescribed or over-the-counter medicines? I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.28,
      "end_seconds": 121.22,
      "duration_seconds": 9.94,
      "text": "I take Seretide inhaler, twice a day for my asthma. A plain moisturiser. I take it twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.42,
      "end_seconds": 123.82,
      "duration_seconds": 1.4,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.77,
      "end_seconds": 131.11,
      "duration_seconds": 5.34,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.79,
      "end_seconds": 135.19,
      "duration_seconds": 2.4,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.77,
      "end_seconds": 141.12,
      "duration_seconds": 4.35,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.12,
      "end_seconds": 145.07,
      "duration_seconds": 2.95,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.77,
      "end_seconds": 150.97,
      "duration_seconds": 5.2,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.97,
      "end_seconds": 155.24,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.16,
      "end_seconds": 162.66,
      "duration_seconds": 5.5,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.59,
      "end_seconds": 167.09,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.46,
      "end_seconds": 171.26,
      "duration_seconds": 2.8,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.11,
      "end_seconds": 176.41,
      "duration_seconds": 4.3,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.32,
      "end_seconds": 184.78,
      "duration_seconds": 7.46,
      "text": "I've had asthma for nearly five years now it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 190.37,
      "duration_seconds": 4.32,
      "text": "Right, right. A few quick ones: fever, spreading or blisters?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.27,
      "end_seconds": 195.28,
      "duration_seconds": 4.01,
      "text": "I haven't had fever, spreading or blisters, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.31,
      "end_seconds": 199.17,
      "duration_seconds": 2.86,
      "text": "Okay, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.89,
      "end_seconds": 201.61,
      "duration_seconds": 1.72,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.25,
      "end_seconds": 207.53,
      "duration_seconds": 4.28,
      "text": "so, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.89,
      "end_seconds": 211.7,
      "duration_seconds": 2.81,
      "text": "no, nothing with my heart"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.9,
      "end_seconds": 215.59,
      "duration_seconds": 2.69,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.03,
      "end_seconds": 230.37,
      "duration_seconds": 2.34,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.25,
      "end_seconds": 251.9,
      "duration_seconds": 9.65,
      "text": "Okay: respiratory rate 14, heart rate 69, temperature 36.6. And oxygen saturation is 98 percent, blood pressure 128 over 81."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.77,
      "end_seconds": 257.62,
      "duration_seconds": 3.85,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.57,
      "end_seconds": 259.65,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.51,
      "end_seconds": 261.91,
      "duration_seconds": 1.4,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.91,
      "end_seconds": 286.6,
      "duration_seconds": 5.69,
      "text": "there's a neat red patch where the watch strap sits, with a little scaling"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.81,
      "end_seconds": 291.93,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.83,
      "end_seconds": 318.43,
      "duration_seconds": 13.6,
      "text": "Let me tell you where I've got to. I'd lean towards mild contact dermatitis from the watch strap. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.12,
      "end_seconds": 325.14,
      "duration_seconds": 3.02,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.45,
      "end_seconds": 352.51,
      "duration_seconds": 26.06,
      "text": "Nothing I've seen today points to an emergency. It looks like mild contact dermatitis from the watch strap. I'm prescribing hydrocortisone cream, 1%, once a day, one week. That's for contact dermatitis. I'd like to see you again if it has not cleared in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.36,
      "end_seconds": 355.39,
      "duration_seconds": 2.03,
      "text": "Thank you, that's helpful."
    }
  ]
}