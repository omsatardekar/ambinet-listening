    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.92,
      "end_seconds": 64.9,
      "duration_seconds": 1.98,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.33,
      "end_seconds": 66.73,
      "duration_seconds": 1.4,
      "text": "yes carry on"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.23,
      "end_seconds": 74.36,
      "duration_seconds": 6.13,
      "text": "The weakness in my right arm? That's been since last weekend."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.98,
      "end_seconds": 80.12,
      "duration_seconds": 4.14,
      "text": "did you get loss of consciousness, seizure or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.21,
      "end_seconds": 89.42,
      "duration_seconds": 6.21,
      "text": "Uh, I haven't had loss of consciousness, seizure or fever, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.13,
      "end_seconds": 94.34,
      "duration_seconds": 4.21,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.41,
      "end_seconds": 99.69,
      "duration_seconds": 3.28,
      "text": "okay so no all normal there"
