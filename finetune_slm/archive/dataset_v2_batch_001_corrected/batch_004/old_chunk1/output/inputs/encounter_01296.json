      "start_seconds": 1.17,
      "end_seconds": 8.98,
      "duration_seconds": 7.81,
      "text": "right uh doctor hi where would you like me to to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.79,
      "end_seconds": 14.04,
      "duration_seconds": 4.25,
      "text": "Okay, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.26,
      "end_seconds": 20.7,
      "duration_seconds": 5.44,
      "text": "yeah it's slurred speech i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.39,
      "end_seconds": 24.5,
      "duration_seconds": 3.11,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.32,
      "end_seconds": 35.32,
      "duration_seconds": 10.0,
      "text": "it's been going on for four weeks it's a a relief to finally sit down and talk about it"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.3,
      "end_seconds": 40.58,
      "duration_seconds": 3.28,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.1,
      "end_seconds": 46.35,
      "duration_seconds": 4.25,
      "text": "it usually comes with weakness in my right arm"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.58,
      "end_seconds": 54.44,
      "duration_seconds": 3.86,
      "text": "what about a sudden headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.09,
      "end_seconds": 56.16,
      "duration_seconds": 1.07,
      "text": "Mm yes."
    },
    {
      "segment_id": "SEG0010",
