    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.43,
      "end_seconds": 119.0,
      "duration_seconds": 3.57,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.75,
      "end_seconds": 122.04,
      "duration_seconds": 2.29,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.97,
      "end_seconds": 133.33,
      "duration_seconds": 5.36,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 137.67,
      "duration_seconds": 2.79,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 143.59,
      "duration_seconds": 4.25,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.57,
      "end_seconds": 146.77,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.46,
      "end_seconds": 150.16,
      "duration_seconds": 2.7,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.39,
      "end_seconds": 161.63,
      "duration_seconds": 3.24,
      "text": "what do you take on a normal day?"
