{
  "schema_version": "1.0",
  "encounter_id": "01357",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 4.52,
      "duration_seconds": 3.73,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.22,
      "end_seconds": 10.23,
      "duration_seconds": 5.01,
      "text": "Yes, have a a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.16,
      "end_seconds": 17.44,
      "duration_seconds": 6.28,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.35,
      "end_seconds": 23.41,
      "duration_seconds": 5.06,
      "text": "Okay, that's fine, sit down. We'll go through it it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.44,
      "end_seconds": 31.26,
      "duration_seconds": 2.82,
      "text": "she's been having skipped beats, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.33,
      "end_seconds": 36.8,
      "duration_seconds": 3.47,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.99,
      "end_seconds": 41.25,
      "duration_seconds": 3.26,
      "text": "It's been going on for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.07,
      "end_seconds": 45.38,
      "duration_seconds": 2.31,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.26,
      "end_seconds": 50.68,
      "duration_seconds": 3.42,
      "text": "I get some relief from deep breaths."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.44,
      "end_seconds": 55.19,
      "duration_seconds": 2.75,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.61,
      "end_seconds": 66.76,
      "duration_seconds": 10.15,
      "text": "Being a bit anxious goes along with it, most of the time. The Being a bit anxious? That's been for three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.83,
      "end_seconds": 87.89,
      "duration_seconds": 3.06,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.8,
      "end_seconds": 101.48,
      "duration_seconds": 11.68,
      "text": "Yes, I had a wisdom tooth extraction under sedation, five years ago. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.28,
      "end_seconds": 108.2,
      "duration_seconds": 4.92,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.73,
      "end_seconds": 117.04,
      "duration_seconds": 7.31,
      "text": "sorry, what was I saying, yes, erythromycin, it it gives me a rash"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.59,
      "end_seconds": 121.79,
      "duration_seconds": 4.2,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.57,
      "end_seconds": 126.48,
      "duration_seconds": 3.91,
      "text": "I've had anxiety for about a year now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.33,
      "end_seconds": 132.13,
      "duration_seconds": 0.8,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.16,
      "end_seconds": 137.83,
      "duration_seconds": 3.67,
      "text": "I've had diabetes for nearly five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.89,
      "end_seconds": 143.73,
      "duration_seconds": 0.84,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.11,
      "end_seconds": 153.21,
      "duration_seconds": 8.1,
      "text": "okay, I can see diabetes in your file as well do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 155.27,
      "end_seconds": 167.07,
      "duration_seconds": 11.8,
      "text": "she is on escitalopram, 10 milligrams, once a day, I give it to her she takes herbal calming tea, in the evening"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.75,
      "end_seconds": 169.57,
      "duration_seconds": 0.82,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.89,
      "end_seconds": 175.43,
      "duration_seconds": 4.54,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.21,
      "end_seconds": 178.92,
      "duration_seconds": 1.71,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.63,
      "end_seconds": 182.57,
      "duration_seconds": 2.94,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.79,
      "end_seconds": 185.92,
      "duration_seconds": 2.13,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.75,
      "end_seconds": 191.58,
      "duration_seconds": 3.83,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.98,
      "end_seconds": 195.73,
      "duration_seconds": 2.75,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.87,
      "end_seconds": 200.93,
      "duration_seconds": 4.06,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.09,
      "end_seconds": 203.93,
      "duration_seconds": 1.84,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.6,
      "end_seconds": 207.96,
      "duration_seconds": 2.36,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.98,
      "end_seconds": 214.12,
      "duration_seconds": 5.14,
      "text": "And what about fainting, dizziness, chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.2,
      "end_seconds": 218.59,
      "duration_seconds": 2.39,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.67,
      "end_seconds": 226.53,
      "duration_seconds": 3.86,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.77,
      "end_seconds": 228.9,
      "duration_seconds": 1.13,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.04,
      "end_seconds": 246.35,
      "duration_seconds": 3.31,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.89,
      "end_seconds": 255.86,
      "duration_seconds": 1.97,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.61,
      "end_seconds": 278.58,
      "duration_seconds": 8.97,
      "text": "okay: temp 36.5 degrees, pulse 81, blood pressure 112 over 71, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.92,
      "end_seconds": 281.5,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.72,
      "end_seconds": 285.43,
      "duration_seconds": 2.71,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.1,
      "end_seconds": 292.14,
      "duration_seconds": 4.04,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.98,
      "end_seconds": 294.16,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.86,
      "end_seconds": 314.28,
      "duration_seconds": 4.42,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.28,
      "end_seconds": 319.97,
      "duration_seconds": 1.69,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.02,
      "end_seconds": 363.4,
      "duration_seconds": 31.38,
      "text": "Putting it all together, it points towards harmless extra heartbeats. The reason I say that is that your story and my examination fit together. I want an ECG done, that's for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens. I'll want another look if it carries on after a month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.29,
      "end_seconds": 369.31,
      "duration_seconds": 5.02,
      "text": "Let me think, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.02,
      "end_seconds": 371.74,
      "duration_seconds": 1.72,
      "text": "Have a good day."
    }
  ]
}