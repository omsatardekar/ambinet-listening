{
  "schema_version": "1.0",
  "encounter_id": "01458",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 3.44,
      "duration_seconds": 2.59,
      "text": "good morning, grab a seat"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.0,
      "end_seconds": 6.13,
      "duration_seconds": 2.13,
      "text": "hello, uh, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 9.61,
      "duration_seconds": 1.56,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.66,
      "end_seconds": 25.35,
      "duration_seconds": 14.69,
      "text": "Well, I'm here because of trouble passing urine. I looked a few things up online, and that probably didn't help. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.08,
      "end_seconds": 29.33,
      "duration_seconds": 2.25,
      "text": "Okay, when did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.44,
      "end_seconds": 33.5,
      "duration_seconds": 3.06,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.24,
      "end_seconds": 37.25,
      "duration_seconds": 3.01,
      "text": "would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.57,
      "end_seconds": 40.68,
      "duration_seconds": 2.11,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.15,
      "end_seconds": 44.4,
      "duration_seconds": 2.25,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.27,
      "end_seconds": 50.38,
      "duration_seconds": 5.11,
      "text": "It, It It usually comes with weakness in both legs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.11,
      "end_seconds": 55.23,
      "duration_seconds": 4.12,
      "text": "what about severe lower back pain, have you noticed that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.52,
      "end_seconds": 59.79,
      "duration_seconds": 3.27,
      "text": "Yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.26,
      "end_seconds": 64.4,
      "duration_seconds": 3.14,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.38,
      "end_seconds": 81.5,
      "duration_seconds": 16.12,
      "text": "I mean, it feels mild to to me. As for weakness in both legs, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.65,
      "end_seconds": 86.95,
      "duration_seconds": 4.3,
      "text": "Let me check a few things. Any recent fall or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.69,
      "end_seconds": 93.25,
      "duration_seconds": 4.56,
      "text": "I, I haven't had recent fall or fever, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.8,
      "end_seconds": 95.75,
      "duration_seconds": 1.95,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.14,
      "end_seconds": 99.7,
      "duration_seconds": 2.56,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 104.58,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.84,
      "end_seconds": 113.43,
      "duration_seconds": 4.59,
      "text": "I've got thin bones. Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.58,
      "end_seconds": 118.73,
      "duration_seconds": 4.15,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.77,
      "end_seconds": 126.59,
      "duration_seconds": 3.82,
      "text": "no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.6,
      "end_seconds": 138.29,
      "duration_seconds": 2.69,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.4,
      "end_seconds": 142.2,
      "duration_seconds": 2.8,
      "text": "I'm on alendronate, once a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.65,
      "end_seconds": 146.2,
      "duration_seconds": 2.55,
      "text": "Do you know the the dose?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.8,
      "end_seconds": 153.27,
      "duration_seconds": 5.47,
      "text": "it's 70 milligrams. I take Thyronorm, 50 micrograms, every morning"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.97,
      "end_seconds": 169.26,
      "duration_seconds": 1.29,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.9,
      "end_seconds": 173.86,
      "duration_seconds": 3.96,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.4,
      "end_seconds": 176.48,
      "duration_seconds": 2.08,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.51,
      "end_seconds": 182.14,
      "duration_seconds": 4.63,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.26,
      "end_seconds": 202.2,
      "duration_seconds": 2.94,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 212.74,
      "duration_seconds": 2.52,
      "text": "Alright, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.22,
      "end_seconds": 236.14,
      "duration_seconds": 7.92,
      "text": "Okay: saturation 97 percent, pulse 70. And BP is 121 over 76, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.81,
      "end_seconds": 239.81,
      "duration_seconds": 2.0,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.41,
      "end_seconds": 245.19,
      "duration_seconds": 3.78,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.54,
      "end_seconds": 251.33,
      "duration_seconds": 3.79,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.76,
      "end_seconds": 255.29,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.43,
      "end_seconds": 268.33,
      "duration_seconds": 5.9,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.37,
      "end_seconds": 281.36,
      "duration_seconds": 7.99,
      "text": "Thank you, you can get dressed. I'd like to arrange an urgent MRI of the spine for possible cauda equina."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 282.07,
      "end_seconds": 285.79,
      "duration_seconds": 3.72,
      "text": "I can book that for Friday at 10 am"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.68,
      "end_seconds": 310.84,
      "duration_seconds": 21.16,
      "text": "you need to go to hospital now for an emergency scan. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. We'll refer you to the spinal team. One warning sign to remember: the numbness spreads. In that case don't wait"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.03,
      "end_seconds": 313.47,
      "duration_seconds": 1.44,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.69,
      "end_seconds": 319.4,
      "duration_seconds": 4.71,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.45,
      "end_seconds": 325.64,
      "duration_seconds": 4.19,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}