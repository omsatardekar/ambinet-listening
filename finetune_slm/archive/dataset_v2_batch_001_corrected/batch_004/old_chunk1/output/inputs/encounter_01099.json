{
  "schema_version": "1.0",
  "encounter_id": "01099",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 2.89,
      "duration_seconds": 1.76,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.37,
      "end_seconds": 6.84,
      "duration_seconds": 2.47,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.33,
      "end_seconds": 15.98,
      "duration_seconds": 5.65,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.26,
      "end_seconds": 22.07,
      "duration_seconds": 4.81,
      "text": "Absolutely, come and sit beside them. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.74,
      "end_seconds": 27.16,
      "duration_seconds": 3.42,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.96,
      "end_seconds": 30.35,
      "duration_seconds": 1.39,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.13,
      "end_seconds": 38.51,
      "duration_seconds": 7.38,
      "text": "Well, I've been having a runny nose. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.31,
      "end_seconds": 44.24,
      "duration_seconds": 3.93,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.56,
      "end_seconds": 47.89,
      "duration_seconds": 2.33,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.62,
      "end_seconds": 51.67,
      "duration_seconds": 3.05,
      "text": "So, is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.35,
      "end_seconds": 86.75,
      "duration_seconds": 33.4,
      "text": "A mild cough goes along with it, most of the time. Oh, you know, and a scratchy throat. About scratchy throat, it feels moderate to me. I've also had sneezing, since last Tuesday. With sneezing, it feels mild to me. The mild cough? That's been for about a month. About mild cough, about a six out of ten. It settles a little with honey and lemon."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.98,
      "end_seconds": 97.84,
      "duration_seconds": 4.86,
      "text": "A few quick ones: ear pain, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.58,
      "end_seconds": 104.1,
      "duration_seconds": 5.52,
      "text": "No, no ear pain, shortness of breath or chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.08,
      "end_seconds": 107.52,
      "duration_seconds": 1.44,
      "text": "Nothing like fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.51,
      "end_seconds": 112.6,
      "duration_seconds": 3.09,
      "text": "Ah, no, none, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 113.81,
      "end_seconds": 118.91,
      "duration_seconds": 5.1,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.44,
      "end_seconds": 125.81,
      "duration_seconds": 6.37,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.49,
      "end_seconds": 137.52,
      "duration_seconds": 7.03,
      "text": "Alright, I'll note both what you've said and what you've noticed. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.56,
      "end_seconds": 144.75,
      "duration_seconds": 3.19,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.95,
      "end_seconds": 161.13,
      "duration_seconds": 3.18,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.46,
      "end_seconds": 169.02,
      "duration_seconds": 3.56,
      "text": "It's thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 169.53,
      "end_seconds": 180.85,
      "duration_seconds": 11.32,
      "text": "Doctor, you know, I think the last prescription for the thyroxine was 150 micrograms. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.63,
      "end_seconds": 187.88,
      "duration_seconds": 5.25,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.53,
      "end_seconds": 197.96,
      "duration_seconds": 9.43,
      "text": "I don't think I have it with me. Hmm, I'm on furosemide, 40 milligrams, every morning for the fluid."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.57,
      "end_seconds": 200.82,
      "duration_seconds": 2.25,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.33,
      "end_seconds": 203.83,
      "duration_seconds": 1.5,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.57,
      "end_seconds": 208.7,
      "duration_seconds": 4.13,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.47,
      "end_seconds": 219.5,
      "duration_seconds": 10.03,
      "text": "I've never touched a cigarette. Nothing, I'm teetotal. I grab fast food at lunch most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.45,
      "end_seconds": 235.21,
      "duration_seconds": 2.76,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.31,
      "end_seconds": 238.36,
      "duration_seconds": 2.05,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.79,
      "end_seconds": 244.01,
      "duration_seconds": 4.22,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.44,
      "end_seconds": 251.32,
      "duration_seconds": 5.88,
      "text": "I have an underactive thyroid. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.77,
      "end_seconds": 253.74,
      "duration_seconds": 0.97,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.47,
      "end_seconds": 261.98,
      "duration_seconds": 6.51,
      "text": "Heart failure, for about ten years. Heart disease, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.93,
      "end_seconds": 274.24,
      "duration_seconds": 11.31,
      "text": "Yes, carry on. Alright, heart failure and heart disease, that matches what I have here. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.93,
      "end_seconds": 279.26,
      "duration_seconds": 3.33,
      "text": "So, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.72,
      "end_seconds": 301.48,
      "duration_seconds": 4.76,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.71,
      "end_seconds": 313.2,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.11,
      "end_seconds": 336.5,
      "duration_seconds": 7.39,
      "text": "Okay: oxygen saturation is 98 percent, pulse 69, temperature 36.8. And blood pressure 118 over 79."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.63,
      "end_seconds": 339.25,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.16,
      "end_seconds": 342.87,
      "duration_seconds": 2.71,
      "text": "Right, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.35,
      "end_seconds": 349.13,
      "duration_seconds": 4.78,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.63,
      "end_seconds": 351.82,
      "duration_seconds": 1.19,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.31,
      "end_seconds": 354.74,
      "duration_seconds": 1.43,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.46,
      "end_seconds": 370.05,
      "duration_seconds": 4.59,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.62,
      "end_seconds": 389.49,
      "duration_seconds": 14.87,
      "text": "You can relax now. So where does that leave us? I'd lean towards a simple viral cold. The reason I say that is that your story and my examination fit together. Early flu is still possible."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.43,
      "end_seconds": 394.71,
      "duration_seconds": 3.28,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.3,
      "end_seconds": 413.73,
      "duration_seconds": 18.43,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold. Let me repeat that back to make sure. You've had a runny nose, severe, and no shortness of breath or ear pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.77,
      "end_seconds": 417.53,
      "duration_seconds": 2.76,
      "text": "Mm, um, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 418.34,
      "end_seconds": 440.63,
      "duration_seconds": 22.29,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If you develop a high fever or trouble breathing, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 441.56,
      "end_seconds": 444.73,
      "duration_seconds": 3.17,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 446.51,
      "end_seconds": 452.2,
      "duration_seconds": 5.69,
      "text": "Please come and see me if it is not better in ten days."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 457.4,
      "end_seconds": 458.97,
      "duration_seconds": 1.57,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 459.52,
      "end_seconds": 463.41,
      "duration_seconds": 3.89,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 465.3,
      "end_seconds": 469.29,
      "duration_seconds": 3.99,
      "text": "Erm, okay, that makes sense. Thanks for explaining."
    }
  ]
}