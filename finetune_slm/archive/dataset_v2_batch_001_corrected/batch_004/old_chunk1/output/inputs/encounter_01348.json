{
  "schema_version": "1.0",
  "encounter_id": "01348",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 5.8,
      "duration_seconds": 4.66,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.33,
      "end_seconds": 13.9,
      "duration_seconds": 4.57,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.56,
      "end_seconds": 22.22,
      "duration_seconds": 6.66,
      "text": "Hello, uh, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.0,
      "end_seconds": 27.3,
      "duration_seconds": 3.3,
      "text": "please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.8,
      "end_seconds": 32.1,
      "duration_seconds": 3.3,
      "text": "so, I've been feeling well, doctor"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.06,
      "end_seconds": 38.99,
      "duration_seconds": 4.93,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.99,
      "end_seconds": 43.8,
      "duration_seconds": 2.81,
      "text": "Eltroxin. I take it every morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.32,
      "end_seconds": 46.52,
      "duration_seconds": 2.2,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.55,
      "end_seconds": 53.99,
      "duration_seconds": 6.44,
      "text": "it's 100 micrograms. Aspirin, 75 milligrams, maybe, once a day for my heart"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 59.66,
      "duration_seconds": 4.64,
      "text": "do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.18,
      "end_seconds": 66.28,
      "duration_seconds": 6.1,
      "text": "yeah, no, it's at home. Yeah, it's diclofenac, 50 milligrams, when needed"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.54,
      "end_seconds": 70.08,
      "duration_seconds": 3.54,
      "text": "mm, okay okay, when did this begin?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.32,
      "end_seconds": 74.18,
      "duration_seconds": 2.86,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 75.78,
      "end_seconds": 79.61,
      "duration_seconds": 3.83,
      "text": "erm, it was closer to two weeks, doctor"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.3,
      "end_seconds": 84.95,
      "duration_seconds": 4.65,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.01,
      "end_seconds": 88.2,
      "duration_seconds": 2.19,
      "text": "yes, somewhere around that"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.55,
      "end_seconds": 94.29,
      "duration_seconds": 5.74,
      "text": "I follow. Right, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.81,
      "end_seconds": 100.32,
      "duration_seconds": 4.51,
      "text": "I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.5,
      "end_seconds": 105.62,
      "duration_seconds": 4.12,
      "text": "did you get feeling cold, constipation or weight change?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 119.0,
      "duration_seconds": 12.74,
      "text": "No, no feeling cold, no constipation, no weight change. I did have slightly dry skin at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.65,
      "end_seconds": 122.7,
      "duration_seconds": 2.05,
      "text": "Has there been any palpitations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.65,
      "end_seconds": 125.29,
      "duration_seconds": 1.64,
      "text": "Definitely no palpitations."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.2,
      "end_seconds": 128.23,
      "duration_seconds": 2.03,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.57,
      "end_seconds": 131.25,
      "duration_seconds": 1.68,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.51,
      "end_seconds": 135.66,
      "duration_seconds": 3.15,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.03,
      "end_seconds": 138.53,
      "duration_seconds": 1.5,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.01,
      "end_seconds": 143.08,
      "duration_seconds": 3.07,
      "text": "So, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.99,
      "end_seconds": 163.63,
      "duration_seconds": 18.64,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I'm vegetarian and have been for years. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.6,
      "end_seconds": 167.03,
      "duration_seconds": 2.43,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.64,
      "end_seconds": 172.73,
      "duration_seconds": 1.09,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.32,
      "end_seconds": 179.19,
      "duration_seconds": 4.87,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.89,
      "end_seconds": 199.35,
      "duration_seconds": 18.46,
      "text": "I've had an underactive thyroid for about ten years now. Actually, I've had heart disease, yes. Yes, arthritis in my knees. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.91,
      "end_seconds": 211.49,
      "duration_seconds": 6.58,
      "text": "Alright, an underactive thyroid and heart disease, that that matches what I have here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.0,
      "end_seconds": 224.99,
      "duration_seconds": 3.99,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.75,
      "end_seconds": 235.04,
      "duration_seconds": 9.29,
      "text": "I think I reacted to to some antibiotic once, years ago. I don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.16,
      "end_seconds": 239.79,
      "duration_seconds": 3.63,
      "text": "Alright, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.18,
      "end_seconds": 256.0,
      "duration_seconds": 2.82,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.85,
      "end_seconds": 283.93,
      "duration_seconds": 16.08,
      "text": "okay: BMI works out to 26.6, weight 64 kilos, oxygen saturation is 97 percent and pulse is 78 beats a minute, height 155 centimetres, blood pressure 110 over 77, temperature 36.9."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.97,
      "end_seconds": 300.93,
      "duration_seconds": 7.96,
      "text": "So, based on your history, I think we're dealing with well-controlled thyroid replacement at this stage."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.96,
      "end_seconds": 304.99,
      "duration_seconds": 3.03,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.1,
      "end_seconds": 316.56,
      "duration_seconds": 10.46,
      "text": "I can't promise yet, but most people with well-controlled thyroid replacement do well once it's treated properly. Let's get a thyroid blood test, for annual review."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.44,
      "end_seconds": 323.38,
      "duration_seconds": 4.94,
      "text": "we have a slot Tuesday at 11:30 am, if that works"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.72,
      "end_seconds": 326.98,
      "duration_seconds": 2.26,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.76,
      "end_seconds": 353.78,
      "duration_seconds": 23.02,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee. And please bring the latest prescription or the medicine boxes to the next visit, so so we can settle the dose. I'll want another look in twelve months. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.84,
      "end_seconds": 358.4,
      "duration_seconds": 3.56,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.72,
      "end_seconds": 362.95,
      "duration_seconds": 1.23,
      "text": "All the best."
    }
  ]
}