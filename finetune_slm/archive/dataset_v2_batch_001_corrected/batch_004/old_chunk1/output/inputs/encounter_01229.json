{
  "schema_version": "1.0",
  "encounter_id": "01229",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 4.14,
      "duration_seconds": 3.19,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.71,
      "end_seconds": 9.64,
      "duration_seconds": 3.93,
      "text": "Morning, um, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.44,
      "end_seconds": 13.13,
      "duration_seconds": 1.69,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.91,
      "end_seconds": 20.5,
      "duration_seconds": 6.59,
      "text": "Um, so... pain much worse than it looks. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.85,
      "end_seconds": 24.74,
      "duration_seconds": 2.89,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.79,
      "end_seconds": 30.04,
      "duration_seconds": 3.25,
      "text": "It's been going on for two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.21,
      "end_seconds": 36.13,
      "duration_seconds": 4.92,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.38,
      "end_seconds": 56.44,
      "duration_seconds": 19.06,
      "text": "I'd give it a three, you know, out of ten. Touch definitely sets it off. I'd say once or twice a day. I've, I've had a red hot swelling on my leg too, for about four days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.32,
      "end_seconds": 60.32,
      "duration_seconds": 2.0,
      "text": "Have you had dark blisters?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.6,
      "end_seconds": 65.27,
      "duration_seconds": 3.67,
      "text": "Yes, about the same, about a week."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.35,
      "end_seconds": 71.2,
      "duration_seconds": 3.85,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.78,
      "end_seconds": 74.11,
      "duration_seconds": 2.33,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.14,
      "end_seconds": 75.96,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.36,
      "end_seconds": 82.0,
      "duration_seconds": 4.64,
      "text": "I've, I've had asthma for about a year now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.14,
      "end_seconds": 84.8,
      "duration_seconds": 1.66,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.49,
      "end_seconds": 93.1,
      "duration_seconds": 6.61,
      "text": "Yes, diabetes is known to us, good to have that clear. Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.57,
      "end_seconds": 98.32,
      "duration_seconds": 3.75,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.81,
      "end_seconds": 106.41,
      "duration_seconds": 3.6,
      "text": "Right, what line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.27,
      "end_seconds": 113.44,
      "duration_seconds": 5.17,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.6,
      "end_seconds": 116.74,
      "duration_seconds": 2.14,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.37,
      "end_seconds": 126.87,
      "duration_seconds": 4.5,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.93,
      "end_seconds": 130.75,
      "duration_seconds": 2.82,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.53,
      "end_seconds": 134.67,
      "duration_seconds": 3.14,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.93,
      "end_seconds": 153.79,
      "duration_seconds": 3.86,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.24,
      "end_seconds": 157.41,
      "duration_seconds": 2.17,
      "text": "Sitagliptin, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.72,
      "end_seconds": 162.96,
      "duration_seconds": 2.24,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.66,
      "end_seconds": 169.35,
      "duration_seconds": 5.69,
      "text": "It's 100 milligrams. Mm, I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.36,
      "end_seconds": 174.27,
      "duration_seconds": 2.91,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.91,
      "end_seconds": 178.63,
      "duration_seconds": 2.72,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.9,
      "end_seconds": 198.41,
      "duration_seconds": 3.51,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.15,
      "end_seconds": 204.21,
      "duration_seconds": 4.06,
      "text": "No, um, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.25,
      "end_seconds": 221.9,
      "duration_seconds": 3.65,
      "text": "A few quick ones: insect bite or cut?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.87,
      "end_seconds": 224.82,
      "duration_seconds": 1.95,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.0,
      "end_seconds": 227.59,
      "duration_seconds": 1.59,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.67,
      "end_seconds": 232.13,
      "duration_seconds": 2.46,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.02,
      "end_seconds": 237.33,
      "duration_seconds": 3.31,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.49,
      "end_seconds": 244.4,
      "duration_seconds": 1.91,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 246.02,
      "end_seconds": 255.54,
      "duration_seconds": 9.52,
      "text": "Here are the numbers, doctor. Temperature is 38.3 degrees, BP is 126 over 67, oxygen saturation is 96 percent. Pulse 100."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.48,
      "end_seconds": 259.02,
      "duration_seconds": 1.54,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.69,
      "end_seconds": 266.12,
      "duration_seconds": 4.43,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.0,
      "end_seconds": 268.48,
      "duration_seconds": 1.48,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.16,
      "end_seconds": 272.12,
      "duration_seconds": 1.96,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.72,
      "end_seconds": 298.27,
      "duration_seconds": 7.55,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.21,
      "end_seconds": 315.14,
      "duration_seconds": 13.93,
      "text": "That's the examination finished. So, based on the history and the examination, it fits best with a severe deep skin infection needing urgent surgery review. Severe cellulitis is still possible."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.69,
      "end_seconds": 317.69,
      "duration_seconds": 2.0,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.19,
      "end_seconds": 350.33,
      "duration_seconds": 29.14,
      "text": "I understand the worry. At the moment I'd say it's a severe deep skin infection needing urgent surgery review, and we'll know more once the urgent blood tests is back. I'm going to order urgent blood tests, for severe skin infection. I am sending you to hospital now, do not wait. One warning sign to remember: you cannot go now. In that case don't wait."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 351.72,
      "end_seconds": 353.14,
      "duration_seconds": 1.42,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.51,
      "end_seconds": 357.38,
      "duration_seconds": 2.87,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.96,
      "end_seconds": 359.66,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.76,
      "end_seconds": 364.34,
      "duration_seconds": 2.58,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.03,
      "end_seconds": 369.76,
      "duration_seconds": 3.73,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}