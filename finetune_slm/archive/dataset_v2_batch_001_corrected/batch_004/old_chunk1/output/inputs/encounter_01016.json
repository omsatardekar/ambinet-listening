{
  "schema_version": "1.0",
  "encounter_id": "01016",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 6.43,
      "duration_seconds": 5.2,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.28,
      "end_seconds": 12.46,
      "duration_seconds": 4.18,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.01,
      "end_seconds": 28.88,
      "duration_seconds": 11.87,
      "text": "So, you know, I've been passing a lot of urine, doctor. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 29.65,
      "end_seconds": 44.12,
      "duration_seconds": 14.47,
      "text": "okay, so the vitals from earlier bMI works out to 18.4, heart rate 126. Weight 59 kilos, SpO2 97 percent on room air, height 179 centimetres, temperature is 36.6 degrees, blood pressure 113 over 70."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.34,
      "end_seconds": 50.29,
      "duration_seconds": 2.95,
      "text": "Good, thank you. When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.88,
      "end_seconds": 53.1,
      "duration_seconds": 2.22,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.09,
      "end_seconds": 57.25,
      "duration_seconds": 3.16,
      "text": "How much trouble does it it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.83,
      "end_seconds": 65.4,
      "duration_seconds": 7.57,
      "text": "Severe, I'd say. And being very thirsty as well, um, since last weekend."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.31,
      "end_seconds": 68.05,
      "duration_seconds": 1.74,
      "text": "Have you had vomiting?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 70.11,
      "end_seconds": 73.36,
      "duration_seconds": 3.25,
      "text": "Well, yeah. Five days, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.98,
      "end_seconds": 89.37,
      "duration_seconds": 3.39,
      "text": "A few quick ones: chest pain or cough?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.34,
      "end_seconds": 93.3,
      "duration_seconds": 2.96,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.31,
      "end_seconds": 100.82,
      "duration_seconds": 2.51,
      "text": "Alright, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.79,
      "end_seconds": 107.68,
      "duration_seconds": 1.89,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.95,
      "end_seconds": 112.96,
      "duration_seconds": 4.01,
      "text": "anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.73,
      "end_seconds": 117.84,
      "duration_seconds": 4.11,
      "text": "no, you know, nothing with my heart"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.93,
      "end_seconds": 122.62,
      "duration_seconds": 2.69,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.44,
      "end_seconds": 128.19,
      "duration_seconds": 3.75,
      "text": "Erm, I've never had an allergy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.59,
      "end_seconds": 132.3,
      "duration_seconds": 2.71,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.82,
      "end_seconds": 140.96,
      "duration_seconds": 3.14,
      "text": "So, no, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.82,
      "end_seconds": 148.76,
      "duration_seconds": 3.94,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.59,
      "end_seconds": 154.75,
      "duration_seconds": 5.16,
      "text": "Diabetes, for five years. Acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.4,
      "end_seconds": 157.2,
      "duration_seconds": 0.8,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.86,
      "end_seconds": 164.65,
      "duration_seconds": 5.79,
      "text": "I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.05,
      "end_seconds": 170.58,
      "duration_seconds": 4.53,
      "text": "Alright, arthritis in your knees, that matches what I have here."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.49,
      "end_seconds": 192.31,
      "duration_seconds": 3.82,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.4,
      "end_seconds": 208.19,
      "duration_seconds": 14.79,
      "text": "Gliclazide, 80 milligrams, twice a day. I'm, I'm on omeprazole, 20 milligrams, once a day. Right, uh, I used to take diclofenac, but I stopped it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.95,
      "end_seconds": 212.25,
      "duration_seconds": 3.3,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.18,
      "end_seconds": 225.67,
      "duration_seconds": 11.49,
      "text": "My husband and I live above the shop. I'm vegetarian and have been for years. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.64,
      "end_seconds": 230.66,
      "duration_seconds": 2.02,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.79,
      "end_seconds": 234.15,
      "duration_seconds": 2.36,
      "text": "Hold that that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.41,
      "end_seconds": 248.87,
      "duration_seconds": 4.46,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.89,
      "end_seconds": 251.13,
      "duration_seconds": 1.24,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.1,
      "end_seconds": 268.3,
      "duration_seconds": 12.2,
      "text": "Okay, that's enough for me. Taking everything into account, I think we're dealing with diabetic ketoacidosis at this stage. We shouldn't forget a severe infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.79,
      "end_seconds": 302.77,
      "duration_seconds": 23.98,
      "text": "I want a blood sugar and ketone test done, that's for thirst and vomiting. You need to go to hospital now for insulin and fluids. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Let's get you seen by the emergency team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.67,
      "end_seconds": 306.45,
      "duration_seconds": 1.78,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.82,
      "end_seconds": 313.06,
      "duration_seconds": 5.24,
      "text": "See me again straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 314.0,
      "end_seconds": 315.75,
      "duration_seconds": 1.75,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.47,
      "end_seconds": 318.64,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}