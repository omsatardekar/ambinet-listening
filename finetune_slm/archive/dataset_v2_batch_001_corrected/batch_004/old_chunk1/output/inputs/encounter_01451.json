{
  "schema_version": "1.0",
  "encounter_id": "01451",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.63,
      "end_seconds": 7.97,
      "duration_seconds": 7.34,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.76,
      "end_seconds": 14.26,
      "duration_seconds": 4.5,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.36,
      "end_seconds": 22.31,
      "duration_seconds": 6.95,
      "text": "Sorry, you know, what was I saying, doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.26,
      "end_seconds": 31.18,
      "duration_seconds": 3.92,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 32.36,
      "end_seconds": 42.2,
      "duration_seconds": 9.84,
      "text": "I mean, uh, I've been dealing with a blocked ear. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.73,
      "end_seconds": 45.81,
      "duration_seconds": 3.08,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 47.34,
      "end_seconds": 58.39,
      "duration_seconds": 11.05,
      "text": "About... well, about four days. I'm not great at remembering details, so bear with me. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.94,
      "end_seconds": 63.69,
      "duration_seconds": 4.75,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.51,
      "end_seconds": 68.94,
      "duration_seconds": 4.43,
      "text": "Showering definitely sets it off. Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.73,
      "end_seconds": 74.01,
      "duration_seconds": 4.28,
      "text": "Alright, any muffled hearing on one side as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.8,
      "end_seconds": 77.73,
      "duration_seconds": 2.93,
      "text": "Yes, for about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.68,
      "end_seconds": 81.88,
      "duration_seconds": 3.2,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.62,
      "end_seconds": 87.32,
      "duration_seconds": 4.7,
      "text": "Uh, about a four out of ten."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.32,
      "end_seconds": 92.37,
      "duration_seconds": 4.05,
      "text": "What about a feeling of fullness, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.52,
      "end_seconds": 95.11,
      "duration_seconds": 1.59,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.82,
      "end_seconds": 99.61,
      "duration_seconds": 3.79,
      "text": "Did you get ringing, dizziness or ear pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.26,
      "end_seconds": 104.49,
      "duration_seconds": 4.23,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.33,
      "end_seconds": 108.6,
      "duration_seconds": 2.27,
      "text": "Did you notice any discharge?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.85,
      "end_seconds": 111.68,
      "duration_seconds": 1.83,
      "text": "No discharge, thankfully."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.75,
      "end_seconds": 117.46,
      "duration_seconds": 3.71,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.75,
      "end_seconds": 120.37,
      "duration_seconds": 1.62,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.24,
      "end_seconds": 140.0,
      "duration_seconds": 2.76,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.76,
      "end_seconds": 145.34,
      "duration_seconds": 4.58,
      "text": "Um, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.25,
      "end_seconds": 150.3,
      "duration_seconds": 4.05,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.18,
      "end_seconds": 158.67,
      "duration_seconds": 3.49,
      "text": "Hmm, no allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.2,
      "end_seconds": 167.37,
      "duration_seconds": 3.17,
      "text": "Okay, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.15,
      "end_seconds": 173.03,
      "duration_seconds": 4.88,
      "text": "I've had depression for nearly five years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.91,
      "end_seconds": 175.58,
      "duration_seconds": 1.67,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.0,
      "end_seconds": 182.42,
      "duration_seconds": 5.42,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.97,
      "end_seconds": 186.42,
      "duration_seconds": 2.45,
      "text": "So, do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.9,
      "end_seconds": 195.41,
      "duration_seconds": 4.51,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.45,
      "end_seconds": 199.39,
      "duration_seconds": 1.94,
      "text": "Right, what's your work?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.29,
      "end_seconds": 204.59,
      "duration_seconds": 4.3,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.02,
      "end_seconds": 210.3,
      "duration_seconds": 4.28,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 213.21,
      "end_seconds": 217.45,
      "duration_seconds": 4.24,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 229.78,
      "duration_seconds": 3.89,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 231.44,
      "end_seconds": 237.22,
      "duration_seconds": 5.78,
      "text": "I take sertraline, 50 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.84,
      "end_seconds": 245.78,
      "duration_seconds": 3.94,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.92,
      "end_seconds": 250.26,
      "duration_seconds": 3.34,
      "text": "Hmm, no, it's at home."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 251.39,
      "end_seconds": 262.99,
      "duration_seconds": 11.6,
      "text": "Doctor, I've got the readings for you. Blood pressure 116 over 69, saturation 99 percent, respiratory rate 16. Heart rate 70, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.04,
      "end_seconds": 266.5,
      "duration_seconds": 1.46,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.09,
      "end_seconds": 272.27,
      "duration_seconds": 3.18,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.76,
      "end_seconds": 277.15,
      "duration_seconds": 3.39,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.29,
      "end_seconds": 295.39,
      "duration_seconds": 4.1,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.99,
      "end_seconds": 301.56,
      "duration_seconds": 1.57,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.52,
      "end_seconds": 325.24,
      "duration_seconds": 10.72,
      "text": "Putting it all together, I don't have a clear answer today: earwax blocking the ear is possible, and so is a middle ear fluid."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.96,
      "end_seconds": 332.93,
      "duration_seconds": 5.97,
      "text": "I mean, uh, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.45,
      "end_seconds": 357.39,
      "duration_seconds": 23.94,
      "text": "I understand the worry. At the moment I'd say it's earwax blocking the ear, and we'll know more once the ear irrigation is back. Let's get ear irrigation, for wax. Use the olive oil drops for a week and then we'll syringe the ear. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.6,
      "end_seconds": 381.55,
      "duration_seconds": 22.95,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. The thing that would worry me is if you get ear pain or dizziness. If that happens, go to emergency. Let's review you in one week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.55,
      "end_seconds": 388.49,
      "duration_seconds": 5.94,
      "text": "Oh, um, okay, that makes sense. Thanks for explaining."
    }
  ]
}