{
  "schema_version": "1.0",
  "encounter_id": "01411",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 6.79,
      "duration_seconds": 5.89,
      "text": "Hello, sorry about the delay, do sit. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.37,
      "end_seconds": 14.91,
      "duration_seconds": 2.54,
      "text": "It's a runny nose, mostly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.46,
      "end_seconds": 22.9,
      "duration_seconds": 3.44,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.8,
      "end_seconds": 29.93,
      "duration_seconds": 5.13,
      "text": "Around three days... no wait, it's more like about four days."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.01,
      "end_seconds": 34.39,
      "duration_seconds": 3.38,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.19,
      "end_seconds": 38.26,
      "duration_seconds": 3.07,
      "text": "It settles a little with tissues."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.07,
      "end_seconds": 42.29,
      "duration_seconds": 3.22,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.84,
      "end_seconds": 46.11,
      "duration_seconds": 2.27,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.18,
      "end_seconds": 50.96,
      "duration_seconds": 2.78,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.75,
      "end_seconds": 67.26,
      "duration_seconds": 14.51,
      "text": "Sneezing goes along with it, most of the time. The sneezing? That's been since this morning. As for sneezing, mostly severe. I'd say all the time."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.89,
      "end_seconds": 71.57,
      "duration_seconds": 2.68,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.16,
      "end_seconds": 76.42,
      "duration_seconds": 4.26,
      "text": "Naproxen. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.2,
      "end_seconds": 79.76,
      "duration_seconds": 2.56,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 87.75,
      "duration_seconds": 4.16,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.58,
      "end_seconds": 91.46,
      "duration_seconds": 1.88,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.92,
      "end_seconds": 101.01,
      "duration_seconds": 4.09,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.35,
      "end_seconds": 106.42,
      "duration_seconds": 4.07,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.99,
      "end_seconds": 108.61,
      "duration_seconds": 1.62,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.49,
      "end_seconds": 111.75,
      "duration_seconds": 2.26,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.84,
      "end_seconds": 116.78,
      "duration_seconds": 2.94,
      "text": "Nothing regular, you know, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.68,
      "end_seconds": 121.41,
      "duration_seconds": 2.73,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.42,
      "end_seconds": 124.07,
      "duration_seconds": 1.65,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.14,
      "end_seconds": 140.07,
      "duration_seconds": 4.93,
      "text": "Have you noticed shortness of breath, fever or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.91,
      "end_seconds": 142.95,
      "duration_seconds": 2.04,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.35,
      "end_seconds": 146.82,
      "duration_seconds": 3.47,
      "text": "Right, right. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.32,
      "end_seconds": 151.46,
      "duration_seconds": 3.14,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.98,
      "end_seconds": 157.36,
      "duration_seconds": 4.38,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.81,
      "end_seconds": 170.81,
      "duration_seconds": 2.0,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.45,
      "end_seconds": 196.17,
      "duration_seconds": 9.72,
      "text": "Okay: respiratory rate 15, temp 36.5 degrees, BP is 128 over 80, saturation 97 percent, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.22,
      "end_seconds": 201.16,
      "duration_seconds": 3.94,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.78,
      "end_seconds": 204.23,
      "duration_seconds": 1.45,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.78,
      "end_seconds": 218.87,
      "duration_seconds": 5.09,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.35,
      "end_seconds": 225.9,
      "duration_seconds": 2.55,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.1,
      "end_seconds": 239.8,
      "duration_seconds": 4.7,
      "text": "Okay, thinking it through, this is probably a simple viral cold."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.84,
      "end_seconds": 245.06,
      "duration_seconds": 3.22,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.84,
      "end_seconds": 254.17,
      "duration_seconds": 7.33,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.91,
      "end_seconds": 300.69,
      "duration_seconds": 29.78,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Please don't wait if you develop a high fever or trouble breathing. That's when to be seen urgently. See me again if it is not better in ten days. Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.79,
      "end_seconds": 304.83,
      "duration_seconds": 3.04,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}