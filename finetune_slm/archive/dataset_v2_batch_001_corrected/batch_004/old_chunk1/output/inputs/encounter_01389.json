{
  "schema_version": "1.0",
  "encounter_id": "01389",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 6.14,
      "duration_seconds": 4.91,
      "text": "doctor, I've brought them through. The observations are done, whenever you need them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.89,
      "end_seconds": 10.92,
      "duration_seconds": 4.03,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 25.98,
      "duration_seconds": 14.29,
      "text": "It's sudden shortness of breath. I thought I'd wait, uh, but it hasn't gone. Sorry, I know I'm rambling a a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.09,
      "end_seconds": 28.93,
      "duration_seconds": 1.84,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.08,
      "end_seconds": 36.39,
      "duration_seconds": 3.31,
      "text": "I've had it for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.36,
      "end_seconds": 47.56,
      "duration_seconds": 9.2,
      "text": "Tell me a bit more about it: how bad it it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.74,
      "end_seconds": 56.14,
      "duration_seconds": 7.4,
      "text": "I'd say on and off it settles a little with sitting up"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.76,
      "end_seconds": 62.73,
      "duration_seconds": 4.97,
      "text": "What about a swollen painful calf, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.36,
      "end_seconds": 77.05,
      "duration_seconds": 13.69,
      "text": "Yes, about the same, about a month. I've been coughing up a little blood too. About coughing up a little blood, mild, really. It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.79,
      "end_seconds": 82.53,
      "duration_seconds": 3.74,
      "text": "Did you get fever, chest tightness or wheeze?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 83.3,
      "end_seconds": 87.54,
      "duration_seconds": 4.24,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.21,
      "end_seconds": 89.56,
      "duration_seconds": 1.35,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.66,
      "end_seconds": 94.78,
      "duration_seconds": 3.12,
      "text": "No, um, that's all normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.81,
      "end_seconds": 98.84,
      "duration_seconds": 3.03,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.62,
      "end_seconds": 101.35,
      "duration_seconds": 1.73,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.85,
      "end_seconds": 104.15,
      "duration_seconds": 1.3,
      "text": "Okay, any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.09,
      "end_seconds": 111.4,
      "duration_seconds": 4.31,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.57,
      "end_seconds": 113.97,
      "duration_seconds": 1.4,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.34,
      "end_seconds": 120.67,
      "duration_seconds": 3.33,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.38,
      "end_seconds": 124.41,
      "duration_seconds": 3.03,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 124.91,
      "end_seconds": 128.55,
      "duration_seconds": 3.64,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.33,
      "end_seconds": 132.84,
      "duration_seconds": 3.51,
      "text": "Right, are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.94,
      "end_seconds": 136.96,
      "duration_seconds": 3.02,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.88,
      "end_seconds": 142.99,
      "duration_seconds": 4.11,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.66,
      "end_seconds": 147.57,
      "duration_seconds": 3.91,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.74,
      "end_seconds": 164.55,
      "duration_seconds": 4.81,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.29,
      "end_seconds": 170.43,
      "duration_seconds": 4.14,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.92,
      "end_seconds": 191.81,
      "duration_seconds": 3.89,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 192.92,
      "end_seconds": 199.81,
      "duration_seconds": 6.89,
      "text": "well, yes, heart failure my family kept telling me to get it checked"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.5,
      "end_seconds": 216.04,
      "duration_seconds": 3.54,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.83,
      "end_seconds": 221.74,
      "duration_seconds": 4.91,
      "text": "I'm on carvedilol, 6.25 milligrams, twice a day"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.76,
      "end_seconds": 225.18,
      "duration_seconds": 2.42,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.01,
      "end_seconds": 228.64,
      "duration_seconds": 1.63,
      "text": "for two years"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 229.52,
      "end_seconds": 240.88,
      "duration_seconds": 11.36,
      "text": "doctor, I've got the readings for you blood pressure 133 over 84, pulse is 88 beats a minute, temperature 37.6, respiratory rate 22, saturation 93 percent"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.03,
      "end_seconds": 243.43,
      "duration_seconds": 1.4,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.6,
      "end_seconds": 249.41,
      "duration_seconds": 3.81,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.43,
      "end_seconds": 251.81,
      "duration_seconds": 1.38,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.45,
      "end_seconds": 274.13,
      "duration_seconds": 6.68,
      "text": "your left calf is swollen and tender, and your oxygen is lower than I'd like"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.46,
      "end_seconds": 310.67,
      "duration_seconds": 32.21,
      "text": "So, you can relax now. Okay, thinking it through, I think we're dealing with a possible blood clot in the lung at this stage. Let's book a D-dimer blood test to look into possible clot. You need to go to hospital now for a scan. I'll also refer you to the medical team. Let's hold off on a CT scan of the chest for now, and if there's no change next month we can revisit it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.68,
      "end_seconds": 316.48,
      "duration_seconds": 4.8,
      "text": "come back straight away that's all from me any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.72,
      "end_seconds": 321.6,
      "duration_seconds": 3.88,
      "text": "Let me think, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.17,
      "end_seconds": 323.5,
      "duration_seconds": 1.33,
      "text": "take care now"
    }
  ]
}