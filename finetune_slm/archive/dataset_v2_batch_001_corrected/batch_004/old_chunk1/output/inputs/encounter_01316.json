{
  "schema_version": "1.0",
  "encounter_id": "01316",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 8.84,
      "duration_seconds": 8.2,
      "text": "Um, um, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.79,
      "end_seconds": 15.92,
      "duration_seconds": 5.13,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.04,
      "end_seconds": 23.53,
      "duration_seconds": 6.49,
      "text": "Um, so... a dry cough in the evenings. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.08,
      "end_seconds": 26.84,
      "duration_seconds": 2.76,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.12,
      "end_seconds": 30.93,
      "duration_seconds": 2.81,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.34,
      "end_seconds": 35.43,
      "duration_seconds": 3.09,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.46,
      "end_seconds": 39.42,
      "duration_seconds": 1.96,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.1,
      "end_seconds": 42.58,
      "duration_seconds": 2.48,
      "text": "Has there been itchy eyes too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.0,
      "end_seconds": 47.2,
      "duration_seconds": 3.2,
      "text": "Yes, um, for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.85,
      "end_seconds": 50.25,
      "duration_seconds": 2.4,
      "text": "Any sneezing fits as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.21,
      "end_seconds": 56.04,
      "duration_seconds": 3.83,
      "text": "Yeah, I've had that since last night."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.71,
      "end_seconds": 68.06,
      "duration_seconds": 4.35,
      "text": "And what about fever, shortness of breath or wheeze?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.86,
      "end_seconds": 76.7,
      "duration_seconds": 7.84,
      "text": "Okay, um, so I haven't had fever, shortness of breath or wheeze, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.2,
      "end_seconds": 80.39,
      "duration_seconds": 3.19,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.79,
      "end_seconds": 87.08,
      "duration_seconds": 2.29,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.15,
      "end_seconds": 92.31,
      "duration_seconds": 3.16,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.51,
      "end_seconds": 95.53,
      "duration_seconds": 2.02,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.73,
      "end_seconds": 100.46,
      "duration_seconds": 3.73,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.01,
      "end_seconds": 107.31,
      "duration_seconds": 5.3,
      "text": "I've had thin bones for about a year now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.42,
      "end_seconds": 119.51,
      "duration_seconds": 11.09,
      "text": "Right, so thin bones is already on your record. We'll keep that in mind today. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.85,
      "end_seconds": 124.95,
      "duration_seconds": 4.1,
      "text": "No, uh, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.74,
      "end_seconds": 140.83,
      "duration_seconds": 4.09,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.59,
      "end_seconds": 151.27,
      "duration_seconds": 8.68,
      "text": "Alendronate, 70 milligrams, once a week for my bones. I'm on loratadine, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.11,
      "end_seconds": 155.2,
      "duration_seconds": 2.09,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.23,
      "end_seconds": 162.44,
      "duration_seconds": 5.21,
      "text": "10 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.0,
      "end_seconds": 165.45,
      "duration_seconds": 2.45,
      "text": "Yes. Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.95,
      "end_seconds": 169.1,
      "duration_seconds": 2.15,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.03,
      "end_seconds": 174.45,
      "duration_seconds": 3.42,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.29,
      "end_seconds": 179.99,
      "duration_seconds": 4.7,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.92,
      "end_seconds": 183.86,
      "duration_seconds": 1.94,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.67,
      "end_seconds": 188.72,
      "duration_seconds": 4.05,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.11,
      "end_seconds": 191.97,
      "duration_seconds": 1.86,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.03,
      "end_seconds": 195.6,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.84,
      "end_seconds": 215.65,
      "duration_seconds": 2.81,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.58,
      "end_seconds": 228.82,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.44,
      "end_seconds": 252.21,
      "duration_seconds": 7.77,
      "text": "Okay: saturation 97 percent, BP is 119 over 76. And heart rate 84, respiratory rate 18, temperature 36.5."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.97,
      "end_seconds": 257.25,
      "duration_seconds": 3.28,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.36,
      "end_seconds": 259.06,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.46,
      "end_seconds": 262.21,
      "duration_seconds": 1.75,
      "text": "Okay, nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.94,
      "end_seconds": 275.42,
      "duration_seconds": 5.48,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.32,
      "end_seconds": 289.81,
      "duration_seconds": 11.49,
      "text": "You can sit up now. Let's use fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.82,
      "end_seconds": 295.34,
      "duration_seconds": 4.52,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.53,
      "end_seconds": 309.73,
      "duration_seconds": 13.2,
      "text": "Keep windows closed on high-pollen days and wash your hair at night. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. We'll catch up in a month."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.74,
      "end_seconds": 312.82,
      "duration_seconds": 2.08,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.56,
      "end_seconds": 317.2,
      "duration_seconds": 2.64,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.79,
      "end_seconds": 322.37,
      "duration_seconds": 3.58,
      "text": "Thank you, uh, doctor, goodbye."
    }
  ]
}