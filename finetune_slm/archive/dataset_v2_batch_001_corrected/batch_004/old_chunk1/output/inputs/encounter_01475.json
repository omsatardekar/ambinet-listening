{
  "schema_version": "1.0",
  "encounter_id": "01475",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.71,
      "duration_seconds": 4.34,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.81,
      "end_seconds": 11.38,
      "duration_seconds": 4.57,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.92,
      "end_seconds": 17.73,
      "duration_seconds": 4.81,
      "text": "Mainly I've been feeling well. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.14,
      "end_seconds": 22.99,
      "duration_seconds": 3.85,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.78,
      "end_seconds": 27.05,
      "duration_seconds": 3.27,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.55,
      "end_seconds": 31.68,
      "duration_seconds": 3.13,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.76,
      "end_seconds": 49.05,
      "duration_seconds": 12.29,
      "text": "I'd say mild. Okay, so I've also had slightly dry skin, for five days. With slightly dry skin, moisturiser helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.11,
      "end_seconds": 55.66,
      "duration_seconds": 4.55,
      "text": "A few quick ones: palpitations, weight change or feeling cold?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.18,
      "end_seconds": 61.47,
      "duration_seconds": 5.29,
      "text": "Sorry, what was I saying, no, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.01,
      "end_seconds": 64.35,
      "duration_seconds": 2.34,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.36,
      "end_seconds": 69.06,
      "duration_seconds": 3.7,
      "text": "No, uh, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.87,
      "end_seconds": 73.75,
      "duration_seconds": 2.88,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.31,
      "end_seconds": 83.17,
      "duration_seconds": 7.86,
      "text": "Years back I got a rash from erythromycin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.94,
      "end_seconds": 85.38,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.18,
      "end_seconds": 89.33,
      "duration_seconds": 2.15,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.06,
      "end_seconds": 92.96,
      "duration_seconds": 1.9,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.95,
      "end_seconds": 99.23,
      "duration_seconds": 4.28,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.91,
      "end_seconds": 101.2,
      "duration_seconds": 1.29,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.83,
      "end_seconds": 106.19,
      "duration_seconds": 4.36,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.6,
      "end_seconds": 113.4,
      "duration_seconds": 1.8,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.11,
      "end_seconds": 118.97,
      "duration_seconds": 3.86,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.56,
      "end_seconds": 140.91,
      "duration_seconds": 3.35,
      "text": "Okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.76,
      "end_seconds": 148.07,
      "duration_seconds": 6.31,
      "text": "I mean, I'm on Eltroxin, 100 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.94,
      "end_seconds": 151.78,
      "duration_seconds": 2.84,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.84,
      "end_seconds": 158.9,
      "duration_seconds": 3.06,
      "text": "I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.75,
      "end_seconds": 175.98,
      "duration_seconds": 4.23,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.76,
      "end_seconds": 186.96,
      "duration_seconds": 2.2,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.37,
      "end_seconds": 218.69,
      "duration_seconds": 11.32,
      "text": "Okay: temperature is 36.5 degrees, pulse 70, weight 65 kilos. And pressure 118 over 75, BMI works out to 28.1, height 152 centimetres."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.19,
      "end_seconds": 237.53,
      "duration_seconds": 5.34,
      "text": "Right, here's what I'm thinking. It fits best with well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.93,
      "end_seconds": 241.77,
      "duration_seconds": 2.84,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.18,
      "end_seconds": 250.46,
      "duration_seconds": 7.28,
      "text": "It's reasonable to be concerned, but right now well-controlled thyroid replacement is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.85,
      "end_seconds": 298.51,
      "duration_seconds": 34.66,
      "text": "I'm sending you for a thyroid blood test because of annual review. Keep taking the tablet on an empty stomach, apart from coffee. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. The thing that would worry me is if you notice palpitations or weight change. If that happens, go to emergency. We'll catch up in twelve months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.5,
      "end_seconds": 301.43,
      "duration_seconds": 1.93,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.4,
      "end_seconds": 303.59,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}