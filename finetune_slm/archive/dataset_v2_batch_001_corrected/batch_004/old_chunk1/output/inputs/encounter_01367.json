  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 4.15,
      "duration_seconds": 3.45,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.16,
      "end_seconds": 7.28,
      "duration_seconds": 1.12,
      "text": "hi, thanks"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.14,
      "end_seconds": 15.22,
      "duration_seconds": 3.08,
      "text": "Was it a long journey this morning?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.18,
      "end_seconds": 20.98,
      "duration_seconds": 3.8,
      "text": "Not too bad, the roads were quiet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.1,
      "end_seconds": 25.84,
      "duration_seconds": 3.74,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.88,
      "end_seconds": 35.15,
      "duration_seconds": 8.27,
      "text": "So So the thing is, I've got no real problems. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.64,
      "end_seconds": 39.6,
      "duration_seconds": 2.96,
      "text": "alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.66,
      "end_seconds": 46.04,
      "duration_seconds": 5.38,
      "text": "Simvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.83,
      "end_seconds": 51.25,
      "duration_seconds": 3.42,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.07,
      "end_seconds": 58.38,
      "duration_seconds": 6.31,
      "text": "About a year now. It's lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.36,
      "end_seconds": 62.86,
      "duration_seconds": 3.5,
      "text": "So, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.84,
      "end_seconds": 74.81,
      "duration_seconds": 9.97,
      "text": "Moderate, I'd say. I've also had a bit of back stiffness. As for bit of back stiffness, it's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.21,
      "end_seconds": 78.88,
      "duration_seconds": 3.67,
      "text": "mm-hmm have you had an occasional headache?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.68,
      "end_seconds": 83.6,
      "duration_seconds": 2.92,
      "text": "Yeah. Ten days, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.6,
      "end_seconds": 86.27,
      "duration_seconds": 1.67,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.18,
      "end_seconds": 91.34,
      "duration_seconds": 3.16,
      "text": "I get some relief from water."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.65,
      "end_seconds": 97.31,
      "duration_seconds": 4.66,
      "text": "Did you get weight loss, chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.41,
      "end_seconds": 103.16,
      "duration_seconds": 4.75,
      "text": "no, no weight loss, chest pain or shortness of breath"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.44,
      "end_seconds": 106.7,
      "duration_seconds": 2.26,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.01,
      "end_seconds": 109.7,
      "duration_seconds": 1.69,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.21,
      "end_seconds": 114.25,
      "duration_seconds": 3.04,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.11,
      "end_seconds": 119.36,
      "duration_seconds": 3.25,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.66,
      "end_seconds": 122.4,
      "duration_seconds": 1.74,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.14,
      "end_seconds": 126.91,
      "duration_seconds": 3.77,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.45,
      "end_seconds": 130.24,
      "duration_seconds": 2.79,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.87,
      "end_seconds": 135.53,
      "duration_seconds": 3.66,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.96,
      "end_seconds": 141.24,
      "duration_seconds": 4.28,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.04,
      "end_seconds": 145.83,
      "duration_seconds": 2.79,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.04,
      "end_seconds": 150.96,
      "duration_seconds": 3.92,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.95,
      "end_seconds": 155.86,
      "duration_seconds": 2.91,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.9,
      "end_seconds": 160.96,
      "duration_seconds": 4.06,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.68,
      "end_seconds": 166.45,
      "duration_seconds": 4.77,
      "text": "I have high cholesterol. I have epilepsy, for five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.65,
      "end_seconds": 176.69,
      "duration_seconds": 4.04,
      "text": "Okay, I can see epilepsy in your file as well."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.64,
      "end_seconds": 199.03,
      "duration_seconds": 3.39,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.31,
      "end_seconds": 207.57,
      "duration_seconds": 2.26,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.56,
      "end_seconds": 229.17,
      "duration_seconds": 8.61,
      "text": "Okay: temperature 36.4, respiratory rate 15, heart rate 74, SpO2 97 percent on room air, pressure 117 over 69."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.5,
      "end_seconds": 233.68,
      "duration_seconds": 2.18,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.76,
      "end_seconds": 236.75,
      "duration_seconds": 1.99,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.57,
      "end_seconds": 251.18,
      "duration_seconds": 2.61,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.01,
      "end_seconds": 255.97,
      "duration_seconds": 1.96,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.68,
      "end_seconds": 278.0,
      "duration_seconds": 13.32,
      "text": "So, based on the history and the examination, this looks most like a healthy adult with no worrying findings. A cholesterol blood test is what I'd like next, for routine check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.05,
      "end_seconds": 281.07,
      "duration_seconds": 2.02,
      "text": "okay, I'll do it"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.23,
      "end_seconds": 287.03,
      "duration_seconds": 4.8,
      "text": "I think a fasting sugar test makes sense here, for routine check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.93,
      "end_seconds": 290.1,
      "duration_seconds": 1.17,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.82,
      "end_seconds": 303.94,
      "duration_seconds": 12.12,
      "text": "Keep up regular exercise and a balanced diet. The thing that would worry me is if new symptoms appear. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.68,
      "end_seconds": 307.8,
      "duration_seconds": 3.12,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.31,
      "end_seconds": 319.91,
      "duration_seconds": 10.6,
      "text": "come back in twelve months. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.67,
      "end_seconds": 327.62,
      "duration_seconds": 4.95,
      "text": "So, I come back in twelve months. Is that right?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.62,
      "end_seconds": 336.47,
      "duration_seconds": 6.85,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.11,
      "end_seconds": 341.32,
      "duration_seconds": 3.21,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.01,
      "end_seconds": 344.37,
      "duration_seconds": 1.36,
      "text": "See you soon."
    }
  ]
