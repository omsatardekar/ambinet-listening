      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.63,
      "end_seconds": 301.03,
      "duration_seconds": 4.4,
      "text": "we should do a pregnancy test for pelvic pain and bleeding"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.97,
      "end_seconds": 305.42,
      "duration_seconds": 2.45,
      "text": "How long will it take?"
