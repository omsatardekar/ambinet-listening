      "start_seconds": 204.33,
      "end_seconds": 215.2,
      "duration_seconds": 10.87,
      "text": "Okay: blood pressure 113 over 85, temperature is 36.7 degrees, pulse is 121 beats a minute, SpO2 98 percent on room air."
    },
