      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.29,
      "end_seconds": 262.42,
      "duration_seconds": 9.13,
      "text": "All finished, thank you. So, based on the history and the examination, this looks most like a possible ectopic pregnancy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.21,
      "end_seconds": 267.27,
      "duration_seconds": 3.06,
      "text": "Erm, is this serious, doctor?"
