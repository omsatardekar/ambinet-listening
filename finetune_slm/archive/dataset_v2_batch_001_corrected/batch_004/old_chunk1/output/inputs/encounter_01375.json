{
  "schema_version": "1.0",
  "encounter_id": "01375",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.13,
      "end_seconds": 10.14,
      "duration_seconds": 9.01,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.88,
      "end_seconds": 15.27,
      "duration_seconds": 3.39,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.5,
      "end_seconds": 28.6,
      "duration_seconds": 12.1,
      "text": "Hello, doctor, I came in with them, if that's okay. Right, it's a muffled voice, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.07,
      "end_seconds": 33.82,
      "duration_seconds": 1.75,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.44,
      "end_seconds": 37.07,
      "duration_seconds": 2.63,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.71,
      "end_seconds": 42.03,
      "duration_seconds": 3.32,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 43.74,
      "end_seconds": 45.63,
      "duration_seconds": 1.89,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.23,
      "end_seconds": 52.57,
      "duration_seconds": 6.34,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 52.67,
      "end_seconds": 59.71,
      "duration_seconds": 7.04,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.53,
      "end_seconds": 62.83,
      "duration_seconds": 2.3,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.71,
      "end_seconds": 67.87,
      "duration_seconds": 3.16,
      "text": "Oh, uh, and noisy breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.39,
      "end_seconds": 72.42,
      "duration_seconds": 3.03,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.38,
      "end_seconds": 80.6,
      "duration_seconds": 6.22,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.1,
      "end_seconds": 87.21,
      "duration_seconds": 5.11,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.76,
      "end_seconds": 93.31,
      "duration_seconds": 4.55,
      "text": "Right, a three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 94.55,
      "end_seconds": 98.2,
      "duration_seconds": 3.65,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.26,
      "end_seconds": 102.7,
      "duration_seconds": 3.44,
      "text": "Have you had any rash or cough?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.33,
      "end_seconds": 115.02,
      "duration_seconds": 10.69,
      "text": "No, no rash, no cough. I did have difficulty swallowing at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.58,
      "end_seconds": 118.93,
      "duration_seconds": 2.35,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.03,
      "end_seconds": 122.91,
      "duration_seconds": 1.88,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.12,
      "end_seconds": 126.98,
      "duration_seconds": 2.86,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.83,
      "end_seconds": 130.86,
      "duration_seconds": 2.03,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.27,
      "end_seconds": 143.75,
      "duration_seconds": 3.48,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.53,
      "end_seconds": 148.09,
      "duration_seconds": 2.56,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.89,
      "end_seconds": 151.36,
      "duration_seconds": 2.47,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.72,
      "end_seconds": 153.85,
      "duration_seconds": 1.13,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.21,
      "end_seconds": 157.16,
      "duration_seconds": 1.95,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.53,
      "end_seconds": 163.01,
      "duration_seconds": 4.48,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.55,
      "end_seconds": 166.28,
      "duration_seconds": 1.73,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 168.37,
      "end_seconds": 172.79,
      "duration_seconds": 4.42,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.07,
      "end_seconds": 177.33,
      "duration_seconds": 3.26,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 178.68,
      "end_seconds": 189.07,
      "duration_seconds": 10.39,
      "text": "I've got depression. I've got high cholesterol. I've had acid reflux, yes. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.99,
      "end_seconds": 200.52,
      "duration_seconds": 10.53,
      "text": "Right, so depression and high cholesterol are already on your record. We'll keep that in mind today. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.65,
      "end_seconds": 206.39,
      "duration_seconds": 4.74,
      "text": "Fluoxetine. I take it 20 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.12,
      "end_seconds": 211.38,
      "duration_seconds": 4.26,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 212.18,
      "end_seconds": 219.33,
      "duration_seconds": 7.15,
      "text": "Let me think, um, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 220.93,
      "end_seconds": 229.84,
      "duration_seconds": 8.91,
      "text": "It's a... um, you know, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.12,
      "end_seconds": 235.78,
      "duration_seconds": 2.66,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.35,
      "end_seconds": 252.32,
      "duration_seconds": 14.97,
      "text": "For my cholesterol, I believe. My wife sets them out for me, I just take what I'm given. Erm, uh, I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 254.06,
      "end_seconds": 263.34,
      "duration_seconds": 9.28,
      "text": "Okay, so it's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 276.34,
      "end_seconds": 286.76,
      "duration_seconds": 10.42,
      "text": "Doctor, I've got the readings for you. Temperature is 37.2 degrees, blood pressure 121 over 82, heart rate 87. SpO2 92 percent on room air."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.58,
      "end_seconds": 293.32,
      "duration_seconds": 5.74,
      "text": "Thanks. An urgent airway assessment is what I'd like next, for stridor and drooling."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 294.67,
      "end_seconds": 298.49,
      "duration_seconds": 3.82,
      "text": "I can book that for Wednesday at 3:30 pm."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.3,
      "end_seconds": 308.54,
      "duration_seconds": 8.24,
      "text": "Do not lie flat, I am calling an ambulance now. I'll also refer you to the emergency ENT team."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.02,
      "end_seconds": 316.66,
      "duration_seconds": 3.64,
      "text": "Oh, sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.66,
      "end_seconds": 328.28,
      "duration_seconds": 10.62,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back straight away."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 328.97,
      "end_seconds": 335.99,
      "duration_seconds": 7.02,
      "text": "Sorry, what was I saying, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.93,
      "end_seconds": 342.12,
      "duration_seconds": 4.19,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.03,
      "end_seconds": 345.09,
      "duration_seconds": 2.06,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.45,
      "end_seconds": 347.7,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}