{
  "schema_version": "1.0",
  "encounter_id": "01299",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.56,
      "duration_seconds": 3.73,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.58,
      "end_seconds": 9.98,
      "duration_seconds": 4.4,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.1,
      "end_seconds": 14.55,
      "duration_seconds": 3.45,
      "text": "Well, I've been having a muffled voice."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.48,
      "end_seconds": 20.19,
      "duration_seconds": 3.71,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.05,
      "end_seconds": 23.93,
      "duration_seconds": 2.88,
      "text": "I've had it since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.51,
      "end_seconds": 30.34,
      "duration_seconds": 4.83,
      "text": "let me check a few things. Any cough or rash?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.92,
      "end_seconds": 37.98,
      "duration_seconds": 3.06,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.57,
      "end_seconds": 41.72,
      "duration_seconds": 2.15,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.76,
      "end_seconds": 46.13,
      "duration_seconds": 1.37,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.71,
      "end_seconds": 64.87,
      "duration_seconds": 4.16,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.44,
      "end_seconds": 69.49,
      "duration_seconds": 4.05,
      "text": "I've, I've had depression for five years now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.48,
      "end_seconds": 76.96,
      "duration_seconds": 5.48,
      "text": "Okay, go on. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.87,
      "end_seconds": 82.76,
      "duration_seconds": 3.89,
      "text": "Fluoxetine, 20 milligrams, every morning for my mood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.43,
      "end_seconds": 86.02,
      "duration_seconds": 2.59,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.74,
      "end_seconds": 88.93,
      "duration_seconds": 1.19,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.44,
      "end_seconds": 92.7,
      "duration_seconds": 2.26,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.21,
      "end_seconds": 97.37,
      "duration_seconds": 4.16,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.01,
      "end_seconds": 101.56,
      "duration_seconds": 2.55,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.1,
      "end_seconds": 105.81,
      "duration_seconds": 3.71,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.51,
      "end_seconds": 111.88,
      "duration_seconds": 4.37,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.33,
      "end_seconds": 116.75,
      "duration_seconds": 3.42,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.44,
      "end_seconds": 120.8,
      "duration_seconds": 2.36,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.57,
      "end_seconds": 131.39,
      "duration_seconds": 4.82,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.51,
      "end_seconds": 143.54,
      "duration_seconds": 4.03,
      "text": "alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.24,
      "end_seconds": 147.75,
      "duration_seconds": 3.51,
      "text": "Mm, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.97,
      "end_seconds": 166.09,
      "duration_seconds": 3.12,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.15,
      "end_seconds": 177.62,
      "duration_seconds": 2.47,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.24,
      "end_seconds": 200.48,
      "duration_seconds": 12.24,
      "text": "Okay: pulse is 103 beats a minute, BP is 133 over 85, respiratory rate 26, SpO2 93 percent on room air, temperature 37.1."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.16,
      "end_seconds": 203.59,
      "duration_seconds": 1.43,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.06,
      "end_seconds": 209.85,
      "duration_seconds": 4.79,
      "text": "Alright, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.66,
      "end_seconds": 215.29,
      "duration_seconds": 3.63,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.89,
      "end_seconds": 219.13,
      "duration_seconds": 2.24,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.45,
      "end_seconds": 236.27,
      "duration_seconds": 4.82,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.38,
      "end_seconds": 242.04,
      "duration_seconds": 1.66,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.27,
      "end_seconds": 265.96,
      "duration_seconds": 8.69,
      "text": "Let me tell you where I've got to. My working impression is a possible airway infection that needs emergency care."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.0,
      "end_seconds": 270.28,
      "duration_seconds": 3.28,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.9,
      "end_seconds": 297.23,
      "duration_seconds": 26.33,
      "text": "I can't promise yet, but most people with a possible airway infection that needs emergency care do well once it's treated properly. An urgent airway assessment is what I'd like next, for stridor and drooling. Do not lie flat, I am calling an ambulance now. We'll refer you to the emergency ENT team. Let's review you straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.78,
      "end_seconds": 301.74,
      "duration_seconds": 3.96,
      "text": "Well, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.26,
      "end_seconds": 306.07,
      "duration_seconds": 3.81,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.95,
      "end_seconds": 310.11,
      "duration_seconds": 3.16,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.21,
      "end_seconds": 312.45,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}