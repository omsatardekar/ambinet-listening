{
  "schema_version": "1.0",
  "encounter_id": "01300",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 4.13,
      "duration_seconds": 2.95,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 11.15,
      "duration_seconds": 5.03,
      "text": "Okay, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.4,
      "end_seconds": 16.58,
      "duration_seconds": 4.18,
      "text": "Well, I've been having numbness between my legs."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.83,
      "end_seconds": 20.88,
      "duration_seconds": 3.05,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.66,
      "end_seconds": 23.46,
      "duration_seconds": 1.8,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.76,
      "end_seconds": 29.82,
      "duration_seconds": 5.06,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.32,
      "end_seconds": 34.87,
      "duration_seconds": 3.55,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.93,
      "end_seconds": 38.79,
      "duration_seconds": 2.86,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.75,
      "end_seconds": 50.7,
      "duration_seconds": 9.95,
      "text": "Mostly mild. Oh, and severe lower back pain. With severe lower back pain, I'd say a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.15,
      "end_seconds": 54.88,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.93,
      "end_seconds": 64.13,
      "duration_seconds": 2.2,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.57,
      "end_seconds": 98.16,
      "duration_seconds": 14.59,
      "text": "Okay: pulse is 76 beats a minute, BMI works out to 27.5, SpO2 99 percent on room air. And weight 86 kilos, height 177 centimetres, BP is 111 over 79, temperature 36.7."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.93,
      "end_seconds": 100.36,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.26,
      "end_seconds": 103.73,
      "duration_seconds": 2.47,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.78,
      "end_seconds": 109.08,
      "duration_seconds": 4.3,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.97,
      "end_seconds": 124.67,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.47,
      "end_seconds": 127.76,
      "duration_seconds": 1.29,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.36,
      "end_seconds": 150.23,
      "duration_seconds": 5.87,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.44,
      "end_seconds": 156.48,
      "duration_seconds": 4.04,
      "text": "Okay, that's enough for me. Any fever or recent fall?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 160.77,
      "duration_seconds": 2.93,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 168.64,
      "duration_seconds": 3.2,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.37,
      "end_seconds": 171.67,
      "duration_seconds": 2.3,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.73,
      "end_seconds": 177.37,
      "duration_seconds": 3.64,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.27,
      "end_seconds": 181.18,
      "duration_seconds": 2.91,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.86,
      "end_seconds": 184.82,
      "duration_seconds": 1.96,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.6,
      "end_seconds": 188.07,
      "duration_seconds": 1.47,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.59,
      "end_seconds": 189.99,
      "duration_seconds": 1.4,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.64,
      "end_seconds": 194.08,
      "duration_seconds": 2.44,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.59,
      "end_seconds": 197.7,
      "duration_seconds": 2.11,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.35,
      "end_seconds": 202.33,
      "duration_seconds": 3.98,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.16,
      "end_seconds": 206.17,
      "duration_seconds": 3.01,
      "text": "Okay, tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.74,
      "end_seconds": 212.82,
      "duration_seconds": 6.08,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.41,
      "end_seconds": 217.28,
      "duration_seconds": 3.87,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.88,
      "end_seconds": 220.39,
      "duration_seconds": 2.51,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.3,
      "end_seconds": 224.67,
      "duration_seconds": 2.37,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.49,
      "end_seconds": 227.49,
      "duration_seconds": 2.0,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.21,
      "end_seconds": 248.3,
      "duration_seconds": 3.09,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.98,
      "end_seconds": 254.21,
      "duration_seconds": 5.23,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.5,
      "end_seconds": 278.1,
      "duration_seconds": 9.6,
      "text": "So, based on the history and the examination, this looks most like possible cauda equina syndrome needing an urgent scan."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.04,
      "end_seconds": 283.1,
      "duration_seconds": 3.06,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.26,
      "end_seconds": 293.74,
      "duration_seconds": 9.48,
      "text": "I understand the worry. At the moment I'd say it's possible cauda equina syndrome needing an urgent scan, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.82,
      "end_seconds": 316.66,
      "duration_seconds": 4.84,
      "text": "Today I'm not changing anything. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.92,
      "end_seconds": 324.05,
      "duration_seconds": 2.13,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.73,
      "end_seconds": 327.02,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}