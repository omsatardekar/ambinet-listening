{
  "schema_version": "1.0",
  "encounter_id": "01407",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 5.41,
      "duration_seconds": 4.44,
      "text": "Mm, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 11.09,
      "duration_seconds": 4.4,
      "text": "not at all, please sit what seems to to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 18.82,
      "duration_seconds": 6.16,
      "text": "I've been feeling confused. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.76,
      "end_seconds": 24.77,
      "duration_seconds": 4.01,
      "text": "Alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.75,
      "end_seconds": 34.93,
      "duration_seconds": 9.18,
      "text": "Ah, I've had it for three days. And there's a racing heart as well, about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.61,
      "end_seconds": 51.17,
      "duration_seconds": 2.56,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.66,
      "end_seconds": 66.26,
      "duration_seconds": 2.6,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.88,
      "end_seconds": 94.13,
      "duration_seconds": 8.25,
      "text": "Okay: saturation 98 percent, temperature 38.2. And pulse is 108 beats a minute, blood pressure 113 over 66."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.99,
      "end_seconds": 98.31,
      "duration_seconds": 2.32,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.03,
      "end_seconds": 102.92,
      "duration_seconds": 2.89,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.44,
      "end_seconds": 109.67,
      "duration_seconds": 4.23,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.01,
      "end_seconds": 113.96,
      "duration_seconds": 2.95,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.34,
      "end_seconds": 138.44,
      "duration_seconds": 7.1,
      "text": "You are hot, your heart is racing and and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.55,
      "end_seconds": 147.2,
      "duration_seconds": 1.65,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.8,
      "end_seconds": 154.74,
      "duration_seconds": 2.94,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.36,
      "end_seconds": 171.95,
      "duration_seconds": 5.59,
      "text": "Let me check a few things. Any stiff neck, rash or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.23,
      "end_seconds": 176.16,
      "duration_seconds": 2.93,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.92,
      "end_seconds": 181.43,
      "duration_seconds": 3.51,
      "text": "okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.27,
      "end_seconds": 183.82,
      "duration_seconds": 1.55,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 187.49,
      "duration_seconds": 2.86,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.02,
      "end_seconds": 194.52,
      "duration_seconds": 1.5,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 201.26,
      "duration_seconds": 5.36,
      "text": "okay, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.06,
      "end_seconds": 205.98,
      "duration_seconds": 2.92,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.68,
      "end_seconds": 225.59,
      "duration_seconds": 4.91,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.26,
      "end_seconds": 236.43,
      "duration_seconds": 9.17,
      "text": "Yes, grass pollen. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.26,
      "end_seconds": 239.54,
      "duration_seconds": 2.28,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.87,
      "end_seconds": 243.15,
      "duration_seconds": 2.28,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.3,
      "end_seconds": 246.68,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.34,
      "end_seconds": 252.97,
      "duration_seconds": 5.63,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.47,
      "end_seconds": 270.04,
      "duration_seconds": 16.57,
      "text": "let me tell you where I've got to it's hard to say. Possible sepsis needing urgent treatment is one possibility and a severe urine or chest infection another, and I'd rather not commit yet"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.56,
      "end_seconds": 273.3,
      "duration_seconds": 2.74,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.7,
      "end_seconds": 292.35,
      "duration_seconds": 17.65,
      "text": "It's reasonable to be concerned, but right now possible sepsis needing urgent treatment is my leading thought, not anything worse. So, to recap quickly. You've been feeling confused for three days, and no rash or chest pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.18,
      "end_seconds": 295.99,
      "duration_seconds": 2.81,
      "text": "mm, um, that's right"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.54,
      "end_seconds": 300.84,
      "duration_seconds": 4.3,
      "text": "Let's book lactate and blood tests to look into sepsis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.34,
      "end_seconds": 303.53,
      "duration_seconds": 1.19,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.39,
      "end_seconds": 327.55,
      "duration_seconds": 23.16,
      "text": "I want to admit you to hospital now for fluids and antibiotics. We'll refer you to the emergency team. Keep an eye out, and if you cannot be brought in today, call us the same day or go to emergency. I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.22,
      "end_seconds": 334.03,
      "duration_seconds": 3.81,
      "text": "Ah, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.52,
      "end_seconds": 340.3,
      "duration_seconds": 4.78,
      "text": "right, that's the plan do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.48,
      "end_seconds": 343.83,
      "duration_seconds": 2.35,
      "text": "Alright, thanks, take care."
    }
  ]
}