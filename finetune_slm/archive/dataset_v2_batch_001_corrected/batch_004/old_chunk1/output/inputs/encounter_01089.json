{
  "schema_version": "1.0",
  "encounter_id": "01089",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 4.77,
      "duration_seconds": 4.12,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 10.46,
      "duration_seconds": 3.66,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 16.35,
      "duration_seconds": 4.83,
      "text": "Um, so... shoulder tip pain. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.35,
      "end_seconds": 24.55,
      "duration_seconds": 3.2,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.12,
      "end_seconds": 33.62,
      "duration_seconds": 4.5,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.68,
      "end_seconds": 41.8,
      "duration_seconds": 3.12,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.47,
      "end_seconds": 48.18,
      "duration_seconds": 4.71,
      "text": "Moderate, really. I've also been feeling faint, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.21,
      "end_seconds": 52.56,
      "duration_seconds": 3.35,
      "text": "Any vaginal discharge or fever at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.58,
      "end_seconds": 58.24,
      "duration_seconds": 3.66,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.34,
      "end_seconds": 66.9,
      "duration_seconds": 4.56,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.35,
      "end_seconds": 71.21,
      "duration_seconds": 2.86,
      "text": "No, uh, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.79,
      "end_seconds": 76.45,
      "duration_seconds": 4.66,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.46,
      "end_seconds": 86.48,
      "duration_seconds": 8.02,
      "text": "I was told I'm allergic to grass pollen, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.91,
      "end_seconds": 90.86,
      "duration_seconds": 2.95,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.48,
      "end_seconds": 96.12,
      "duration_seconds": 3.64,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.76,
      "end_seconds": 109.8,
      "duration_seconds": 4.04,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.51,
      "end_seconds": 113.53,
      "duration_seconds": 2.02,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.4,
      "end_seconds": 134.36,
      "duration_seconds": 2.96,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.89,
      "end_seconds": 137.65,
      "duration_seconds": 2.76,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.67,
      "end_seconds": 143.33,
      "duration_seconds": 4.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.46,
      "end_seconds": 157.47,
      "duration_seconds": 10.01,
      "text": "I do a yoga class on Thursdays. My partner and our baby. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.52,
      "end_seconds": 161.88,
      "duration_seconds": 2.36,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.23,
      "end_seconds": 171.62,
      "duration_seconds": 2.39,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.44,
      "end_seconds": 199.53,
      "duration_seconds": 8.09,
      "text": "Okay: SpO2 96 percent on room air, pulse is 104 beats a minute, BP is 137 over 77."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.13,
      "end_seconds": 205.15,
      "duration_seconds": 4.02,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.89,
      "end_seconds": 217.0,
      "duration_seconds": 1.11,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.06,
      "end_seconds": 220.12,
      "duration_seconds": 2.06,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.79,
      "end_seconds": 234.58,
      "duration_seconds": 4.79,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.8,
      "end_seconds": 238.37,
      "duration_seconds": 1.57,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.86,
      "end_seconds": 266.37,
      "duration_seconds": 13.51,
      "text": "From what you've told me and what I found, I don't have a clear answer today: a possible ectopic pregnancy is possible, and so is a ruptured ovarian cyst."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.76,
      "end_seconds": 273.0,
      "duration_seconds": 3.24,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.41,
      "end_seconds": 290.7,
      "duration_seconds": 15.29,
      "text": "I understand the worry. At the moment I'd say it's a possible ectopic pregnancy, and we'll know more once the an urgent pelvic scan is back. Let's get an urgent pelvic scan, for possible ectopic."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.68,
      "end_seconds": 293.9,
      "duration_seconds": 1.22,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.66,
      "end_seconds": 302.04,
      "duration_seconds": 7.38,
      "text": "You need to go to the hospital now for an emergency scan. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.26,
      "end_seconds": 305.19,
      "duration_seconds": 1.93,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.19,
      "end_seconds": 309.56,
      "duration_seconds": 2.37,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.91,
      "end_seconds": 313.22,
      "duration_seconds": 2.31,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.85,
      "end_seconds": 315.23,
      "duration_seconds": 1.38,
      "text": "See you soon."
    }
  ]
}