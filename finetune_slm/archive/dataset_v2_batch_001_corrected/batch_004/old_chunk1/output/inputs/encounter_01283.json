{
  "schema_version": "1.0",
  "encounter_id": "01283",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.96,
      "end_seconds": 6.2,
      "duration_seconds": 5.24,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 13.65,
      "duration_seconds": 5.45,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.34,
      "end_seconds": 17.36,
      "duration_seconds": 2.02,
      "text": "It's skipped beats, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 21.31,
      "duration_seconds": 2.02,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.65,
      "end_seconds": 37.12,
      "duration_seconds": 2.47,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.8,
      "end_seconds": 65.45,
      "duration_seconds": 15.65,
      "text": "Okay: BP is 113 over 73, temperature 36.9, heart rate 66, SpO2 99 percent on room air. When was the first time you noticed it? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.76,
      "end_seconds": 79.85,
      "duration_seconds": 13.09,
      "text": "Ever since... since last weekend, really. I didn't want to make a fuss, you know. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 83.79,
      "duration_seconds": 2.01,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.57,
      "end_seconds": 98.27,
      "duration_seconds": 12.7,
      "text": "Caffeine and lying down definitely sets it off. Oh, and a flutter in my chest. That's been about the same, four weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.26,
      "end_seconds": 102.32,
      "duration_seconds": 2.06,
      "text": "What about shortness of breath?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.66,
      "end_seconds": 106.21,
      "duration_seconds": 2.55,
      "text": "No. No shortness of breath."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.61,
      "end_seconds": 111.34,
      "duration_seconds": 3.73,
      "text": "Any chest pain, fainting or dizziness at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.81,
      "end_seconds": 117.96,
      "duration_seconds": 5.15,
      "text": "I haven't had chest pain, fainting or dizziness, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.2,
      "end_seconds": 121.64,
      "duration_seconds": 2.44,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.88,
      "end_seconds": 124.89,
      "duration_seconds": 2.01,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.72,
      "end_seconds": 127.89,
      "duration_seconds": 2.17,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.01,
      "end_seconds": 131.29,
      "duration_seconds": 2.28,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.26,
      "end_seconds": 137.1,
      "duration_seconds": 4.84,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.99,
      "end_seconds": 140.84,
      "duration_seconds": 2.85,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.03,
      "end_seconds": 154.9,
      "duration_seconds": 3.87,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.67,
      "end_seconds": 163.14,
      "duration_seconds": 6.47,
      "text": "Sorry, what was I saying, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.3,
      "end_seconds": 167.27,
      "duration_seconds": 2.97,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.36,
      "end_seconds": 170.8,
      "duration_seconds": 2.44,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.83,
      "end_seconds": 175.11,
      "duration_seconds": 3.28,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.58,
      "end_seconds": 188.22,
      "duration_seconds": 11.64,
      "text": "I'm vegetarian and have been for years. I look after my grandchildren most days. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.67,
      "end_seconds": 209.05,
      "duration_seconds": 2.38,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.16,
      "end_seconds": 212.51,
      "duration_seconds": 2.35,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.51,
      "end_seconds": 214.73,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.82,
      "end_seconds": 219.85,
      "duration_seconds": 3.03,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.8,
      "end_seconds": 226.21,
      "duration_seconds": 3.41,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.79,
      "end_seconds": 240.32,
      "duration_seconds": 1.53,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.1,
      "end_seconds": 244.26,
      "duration_seconds": 2.16,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.25,
      "end_seconds": 262.84,
      "duration_seconds": 4.59,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.6,
      "end_seconds": 270.85,
      "duration_seconds": 2.25,
      "text": "Right, you can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.41,
      "end_seconds": 309.28,
      "duration_seconds": 23.87,
      "text": "Let's book an ECG to look into palpitations. I'd rather check than guess, and this is the quickest way to know more. Cut back on coffee and energy drinks and keep a diary of when it happens. Keep an eye out, and if you faint or have chest pain, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.14,
      "end_seconds": 317.25,
      "duration_seconds": 2.11,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.07,
      "end_seconds": 323.49,
      "duration_seconds": 4.42,
      "text": "Come back if it carries on after a month."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.57,
      "end_seconds": 327.55,
      "duration_seconds": 1.98,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.69,
      "end_seconds": 332.45,
      "duration_seconds": 3.76,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.59,
      "end_seconds": 335.8,
      "duration_seconds": 2.21,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.44,
      "end_seconds": 338.84,
      "duration_seconds": 1.4,
      "text": "Goodbye for now."
    }
  ]
}