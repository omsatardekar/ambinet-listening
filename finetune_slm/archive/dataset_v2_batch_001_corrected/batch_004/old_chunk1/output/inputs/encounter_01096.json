  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 4.64,
      "duration_seconds": 3.57,
      "text": "hi there, the chair's free, sit down"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 5.29,
      "end_seconds": 10.93,
      "duration_seconds": 5.64,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.66,
      "end_seconds": 14.14,
      "duration_seconds": 1.48,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.12,
      "end_seconds": 19.75,
      "duration_seconds": 4.63,
      "text": "doctor, it's a sore ankle. That's what we're worried about"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.25,
      "end_seconds": 27.01,
      "duration_seconds": 3.76,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.32,
      "end_seconds": 42.5,
      "duration_seconds": 3.18,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.4,
      "end_seconds": 67.71,
      "duration_seconds": 9.31,
      "text": "Okay: temperature 36.9, BP is 111 over 76, heart rate 65. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.41,
      "end_seconds": 71.55,
      "duration_seconds": 3.14,
      "text": "About three weeks, give or take."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 72.43,
      "end_seconds": 76.76,
      "duration_seconds": 4.33,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.87,
      "end_seconds": 84.06,
      "duration_seconds": 4.19,
      "text": "okay, so roughly three to four weeks is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.59,
      "end_seconds": 85.78,
      "duration_seconds": 1.19,
      "text": "yeah, roughly"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 92.11,
      "duration_seconds": 4.92,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.76,
      "end_seconds": 96.03,
      "duration_seconds": 3.27,
      "text": "I, I'd say all the time"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.97,
      "end_seconds": 100.14,
      "duration_seconds": 3.17,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.47,
      "end_seconds": 112.59,
      "duration_seconds": 11.12,
      "text": "Actually, uh, it settles a little with ice. Right, there was a little swelling, yes, but that went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.43,
      "end_seconds": 119.89,
      "duration_seconds": 5.46,
      "text": "Have you had any pain in the foot, crack or pop or numbness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.82,
      "end_seconds": 125.9,
      "duration_seconds": 4.08,
      "text": "Ah, no, none of those at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.9,
      "end_seconds": 130.66,
      "duration_seconds": 2.76,
      "text": "anything different when you pass water?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.28,
      "end_seconds": 133.65,
      "duration_seconds": 1.37,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.52,
      "end_seconds": 137.55,
      "duration_seconds": 2.03,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.39,
      "end_seconds": 140.32,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.1,
      "end_seconds": 145.51,
      "duration_seconds": 3.41,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.16,
      "end_seconds": 159.45,
      "duration_seconds": 12.29,
      "text": "My husband and I live above the shop. I do a yoga class on Thursdays. I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.57,
      "end_seconds": 171.05,
      "duration_seconds": 4.48,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.05,
      "end_seconds": 175.44,
      "duration_seconds": 2.39,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.33,
      "end_seconds": 179.41,
      "duration_seconds": 2.08,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.08,
      "end_seconds": 188.61,
      "duration_seconds": 7.53,
      "text": "It's Asthalin inhaler, when needed for my asthma. I take ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.93,
      "end_seconds": 204.7,
      "duration_seconds": 4.77,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.06,
      "end_seconds": 207.83,
      "duration_seconds": 1.77,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 209.16,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.0,
      "end_seconds": 212.13,
      "duration_seconds": 1.13,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.57,
      "end_seconds": 214.77,
      "duration_seconds": 1.2,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.37,
      "end_seconds": 230.27,
      "duration_seconds": 2.9,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.01,
      "end_seconds": 235.24,
      "duration_seconds": 4.23,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.55,
      "end_seconds": 240.17,
      "duration_seconds": 3.62,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.41,
      "end_seconds": 246.43,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.11,
      "end_seconds": 250.08,
      "duration_seconds": 1.97,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.29,
      "end_seconds": 271.26,
      "duration_seconds": 7.97,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.64,
      "end_seconds": 284.33,
      "duration_seconds": 9.69,
      "text": "please sit back down having listened and examined, the most likely explanation is a mild ankle sprain we shouldn't forget a minor fracture"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 286.4,
      "end_seconds": 288.51,
      "duration_seconds": 2.11,
      "text": "will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.02,
      "end_seconds": 309.04,
      "duration_seconds": 19.02,
      "text": "I understand the worry at the moment I'd say it's a mild ankle sprain, and we'll watch how it goes rest, ice, a compression bandage and keep it raised for two days does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.51,
      "end_seconds": 315.02,
      "duration_seconds": 3.51,
      "text": "Great, thank you for your help."
    }
  ]
