  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 4.56,
      "duration_seconds": 3.52,
      "text": "morning, doctor lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.28,
      "end_seconds": 10.23,
      "duration_seconds": 4.95,
      "text": "Not at all please sit. What seems to to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.9,
      "end_seconds": 19.17,
      "duration_seconds": 8.27,
      "text": "Sorry, what was I saying, mainly I've been wanting contraception. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.16,
      "end_seconds": 23.18,
      "duration_seconds": 3.02,
      "text": "okay, tell me your medicines, please"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.94,
      "end_seconds": 30.39,
      "duration_seconds": 5.45,
      "text": "Ramipril 5 milligrams every morning for my blood pressure"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.03,
      "end_seconds": 43.37,
      "duration_seconds": 3.34,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.7,
      "end_seconds": 50.89,
      "duration_seconds": 6.19,
      "text": "sorry what was I saying I've had it for two months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.29,
      "end_seconds": 55.3,
      "duration_seconds": 3.01,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.54,
      "end_seconds": 57.7,
      "duration_seconds": 1.16,
      "text": "mostly severe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.27,
      "end_seconds": 62.57,
      "duration_seconds": 4.3,
      "text": "what about slightly heavy periods, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.2,
      "end_seconds": 67.21,
      "duration_seconds": 4.01,
      "text": "yeah, I've had that since last weekend"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.6,
      "end_seconds": 72.83,
      "duration_seconds": 4.23,
      "text": "have you noticed smoking, breast lumps or migraine with aura?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.02,
      "end_seconds": 85.11,
      "duration_seconds": 11.09,
      "text": "Sorry you know what was I saying I haven't had smoking breast lumps or migraine with aura no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 89.99,
      "duration_seconds": 3.53,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.92,
      "end_seconds": 93.92,
      "duration_seconds": 2.0,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.83,
      "end_seconds": 98.28,
      "duration_seconds": 2.45,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.43,
      "end_seconds": 109.97,
      "duration_seconds": 7.54,
      "text": "okay, um, so I've had high blood pressure for five years now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.98,
      "end_seconds": 120.83,
      "duration_seconds": 9.85,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Okay, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.86,
      "end_seconds": 129.82,
      "duration_seconds": 6.96,
      "text": "okay, so I had my appendix taken out when I was in my twenties"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.52,
      "end_seconds": 131.42,
      "duration_seconds": 0.9,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 137.37,
      "duration_seconds": 4.24,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.33,
      "end_seconds": 140.63,
      "duration_seconds": 1.3,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.31,
      "end_seconds": 146.37,
      "duration_seconds": 4.06,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.68,
      "end_seconds": 153.64,
      "duration_seconds": 1.96,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.29,
      "end_seconds": 157.83,
      "duration_seconds": 3.54,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.81,
      "end_seconds": 162.9,
      "duration_seconds": 3.09,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.73,
      "end_seconds": 168.05,
      "duration_seconds": 3.32,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.31,
      "end_seconds": 175.15,
      "duration_seconds": 5.84,
      "text": "has anything ever caused you a a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.71,
      "end_seconds": 180.65,
      "duration_seconds": 4.94,
      "text": "I mean, yes, cat fur. I get wheezing"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.29,
      "end_seconds": 185.94,
      "duration_seconds": 3.65,
      "text": "is there anything relevant on the the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.36,
      "end_seconds": 190.17,
      "duration_seconds": 2.81,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.25,
      "end_seconds": 194.59,
      "duration_seconds": 3.34,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.55,
      "end_seconds": 199.27,
      "duration_seconds": 2.72,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.51,
      "end_seconds": 219.58,
      "duration_seconds": 2.07,
      "text": "your blood pressure is normal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.78,
      "end_seconds": 225.84,
      "duration_seconds": 2.06,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.43,
      "end_seconds": 252.31,
      "duration_seconds": 12.88,
      "text": "so based on the history and the examination it points towards suitable for hormonal contraception with no risk factors that's my thinking for now and it may change as we learn more"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.21,
      "end_seconds": 295.42,
      "duration_seconds": 24.21,
      "text": "I'll start you on levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That should help with contraception. Take the pill at the same time each day and use condoms if you miss two. Do get help quickly if you get leg swelling or severe headaches."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.16,
      "end_seconds": 298.46,
      "duration_seconds": 2.3,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.12,
      "end_seconds": 307.35,
      "duration_seconds": 8.23,
      "text": "Let's plan a check in three months. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.31,
      "end_seconds": 322.32,
      "duration_seconds": 14.01,
      "text": "So, uh, I take the levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day and come back in three months. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.35,
      "end_seconds": 329.04,
      "duration_seconds": 5.69,
      "text": "yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.63,
      "end_seconds": 333.19,
      "duration_seconds": 2.56,
      "text": "That's clear, um, thanks."
    }
  ]
}