{
  "schema_version": "1.0",
  "encounter_id": "01444",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.86,
      "duration_seconds": 3.14,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.15,
      "end_seconds": 8.81,
      "duration_seconds": 3.66,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.58,
      "end_seconds": 17.33,
      "duration_seconds": 6.75,
      "text": "So, So the thing is, um, I've got bloating after meals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.41,
      "end_seconds": 22.99,
      "duration_seconds": 1.58,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.63,
      "end_seconds": 28.37,
      "duration_seconds": 3.74,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.82,
      "end_seconds": 39.73,
      "duration_seconds": 9.91,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 50.41,
      "duration_seconds": 7.09,
      "text": "Walking helps a bit. Maybe a six out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.52,
      "end_seconds": 56.13,
      "duration_seconds": 4.61,
      "text": "What about a lot of wind, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.11,
      "end_seconds": 58.33,
      "duration_seconds": 1.22,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.45,
      "end_seconds": 76.56,
      "duration_seconds": 3.11,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.81,
      "end_seconds": 79.18,
      "duration_seconds": 1.37,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.29,
      "end_seconds": 88.0,
      "duration_seconds": 7.71,
      "text": "Okay, go on. Alright, anxiety, that matches what I have here. Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.81,
      "end_seconds": 92.76,
      "duration_seconds": 2.95,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.72,
      "end_seconds": 97.31,
      "duration_seconds": 3.59,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.08,
      "end_seconds": 102.56,
      "duration_seconds": 4.48,
      "text": "I'm on escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.85,
      "end_seconds": 117.46,
      "duration_seconds": 4.61,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.0,
      "end_seconds": 121.08,
      "duration_seconds": 2.08,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.11,
      "end_seconds": 125.84,
      "duration_seconds": 2.73,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.09,
      "end_seconds": 130.48,
      "duration_seconds": 3.39,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.15,
      "end_seconds": 133.32,
      "duration_seconds": 1.17,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.23,
      "end_seconds": 137.07,
      "duration_seconds": 2.84,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.89,
      "end_seconds": 140.75,
      "duration_seconds": 2.86,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.01,
      "end_seconds": 146.34,
      "duration_seconds": 4.33,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.2,
      "end_seconds": 152.48,
      "duration_seconds": 1.28,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.46,
      "end_seconds": 157.15,
      "duration_seconds": 2.69,
      "text": "Mm, no, not at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.89,
      "end_seconds": 161.83,
      "duration_seconds": 2.94,
      "text": "Any sign of blood in the stool?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.19,
      "end_seconds": 166.24,
      "duration_seconds": 3.05,
      "text": "No, no blood in the stool."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.77,
      "end_seconds": 171.99,
      "duration_seconds": 4.22,
      "text": "A few quick ones: vomiting, night-time diarrhoea or weight loss?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.67,
      "end_seconds": 176.11,
      "duration_seconds": 2.44,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.97,
      "end_seconds": 179.4,
      "duration_seconds": 2.43,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.26,
      "end_seconds": 184.11,
      "duration_seconds": 2.85,
      "text": "No, uh, that's all fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.93,
      "end_seconds": 205.89,
      "duration_seconds": 2.96,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.76,
      "end_seconds": 214.79,
      "duration_seconds": 2.03,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.01,
      "end_seconds": 241.44,
      "duration_seconds": 8.43,
      "text": "Okay: pulse is 78 beats a minute, temperature 36.5, saturation 98 percent, blood pressure 120 over 73."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.96,
      "end_seconds": 245.47,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.47,
      "end_seconds": 257.06,
      "duration_seconds": 1.59,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.03,
      "end_seconds": 260.25,
      "duration_seconds": 2.22,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.74,
      "end_seconds": 274.46,
      "duration_seconds": 5.72,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.47,
      "end_seconds": 290.79,
      "duration_seconds": 14.32,
      "text": "That's the examination finished. Taking everything into account, it's hard to say. A functional bowel pattern, with no alarm features is one possibility and irritable bowel syndrome another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.61,
      "end_seconds": 293.69,
      "duration_seconds": 2.08,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.07,
      "end_seconds": 329.42,
      "duration_seconds": 34.35,
      "text": "I understand the worry. At the moment I'd say it's a functional bowel pattern, with no alarm features, and we'll know more once the a coeliac blood test is back. A coeliac blood test is what I'd like next, for bloating. Try smaller meals and keep a food and symptom diary for four weeks. I'd like you back in six weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.66,
      "end_seconds": 334.0,
      "duration_seconds": 3.34,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}