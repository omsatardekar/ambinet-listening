{
  "schema_version": "1.0",
  "encounter_id": "01147",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.65,
      "duration_seconds": 3.56,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.65,
      "end_seconds": 10.06,
      "duration_seconds": 4.41,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 16.78,
      "duration_seconds": 5.09,
      "text": "I wanted to get my throat closing up looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.67,
      "end_seconds": 19.88,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.29,
      "end_seconds": 26.61,
      "duration_seconds": 5.32,
      "text": "Sorry, what was I saying, ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.9,
      "end_seconds": 31.45,
      "duration_seconds": 4.55,
      "text": "I see, go ahead. How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.85,
      "end_seconds": 34.22,
      "duration_seconds": 1.37,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.63,
      "end_seconds": 38.76,
      "duration_seconds": 3.13,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.57,
      "end_seconds": 51.91,
      "duration_seconds": 11.34,
      "text": "It usually comes with swollen lips. I've also been feeling faint, for about four days. The swollen lips? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.83,
      "end_seconds": 57.75,
      "duration_seconds": 4.92,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.31,
      "end_seconds": 60.54,
      "duration_seconds": 2.23,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.83,
      "end_seconds": 61.53,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.89,
      "end_seconds": 71.28,
      "duration_seconds": 2.39,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.2,
      "end_seconds": 89.26,
      "duration_seconds": 14.06,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I work in accounts at a hospital. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.39,
      "end_seconds": 94.96,
      "duration_seconds": 4.57,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.63,
      "end_seconds": 103.04,
      "duration_seconds": 3.41,
      "text": "So, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.7,
      "end_seconds": 106.11,
      "duration_seconds": 2.41,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.03,
      "end_seconds": 110.94,
      "duration_seconds": 3.91,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.47,
      "end_seconds": 116.77,
      "duration_seconds": 4.3,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.43,
      "end_seconds": 120.26,
      "duration_seconds": 2.83,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.67,
      "end_seconds": 141.54,
      "duration_seconds": 2.87,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 144.93,
      "duration_seconds": 2.43,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.99,
      "end_seconds": 151.22,
      "duration_seconds": 4.23,
      "text": "Alright, a few quick ones: recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.02,
      "end_seconds": 155.17,
      "duration_seconds": 2.15,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.44,
      "end_seconds": 160.33,
      "duration_seconds": 4.89,
      "text": "Understood. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.19,
      "end_seconds": 164.71,
      "duration_seconds": 2.52,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.77,
      "end_seconds": 169.17,
      "duration_seconds": 3.4,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.12,
      "end_seconds": 173.42,
      "duration_seconds": 2.3,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.04,
      "end_seconds": 176.96,
      "duration_seconds": 2.92,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.42,
      "end_seconds": 191.59,
      "duration_seconds": 2.17,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.77,
      "end_seconds": 208.73,
      "duration_seconds": 6.96,
      "text": "Okay: pulse is 112 beats a minute, pressure 96 over 56, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.56,
      "end_seconds": 214.0,
      "duration_seconds": 3.44,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 217.58,
      "duration_seconds": 2.12,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.73,
      "end_seconds": 240.04,
      "duration_seconds": 6.31,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.06,
      "end_seconds": 247.42,
      "duration_seconds": 2.36,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.32,
      "end_seconds": 274.36,
      "duration_seconds": 10.04,
      "text": "Let me tell you where I've got to. This is probably anaphylaxis. I'd also keep a severe allergic reaction in mind."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.7,
      "end_seconds": 278.21,
      "duration_seconds": 2.51,
      "text": "So, will it clear up?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.14,
      "end_seconds": 296.55,
      "duration_seconds": 17.41,
      "text": "I understand the worry. At the moment I'd say it's anaphylaxis, and we'll know more once the monitoring is back. I'd like to arrange monitoring for anaphylaxis. You'll be taking adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.21,
      "end_seconds": 300.35,
      "duration_seconds": 2.14,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.35,
      "end_seconds": 309.57,
      "duration_seconds": 7.22,
      "text": "Lie flat with your legs raised, I am giving the injection now. Come back straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.47,
      "end_seconds": 313.77,
      "duration_seconds": 3.3,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.97,
      "end_seconds": 319.58,
      "duration_seconds": 4.61,
      "text": "Okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.6,
      "end_seconds": 324.29,
      "duration_seconds": 3.69,
      "text": "Yeah, I think I understand everything. Thanks."
    }
  ]
}