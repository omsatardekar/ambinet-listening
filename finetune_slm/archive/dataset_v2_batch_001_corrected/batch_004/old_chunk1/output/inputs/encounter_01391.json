{
  "schema_version": "1.0",
  "encounter_id": "01391",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.42,
      "duration_seconds": 4.56,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.16,
      "end_seconds": 12.21,
      "duration_seconds": 5.05,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.89,
      "end_seconds": 21.03,
      "duration_seconds": 7.14,
      "text": "It's a cut on my finger. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.37,
      "end_seconds": 25.6,
      "duration_seconds": 3.23,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.48,
      "end_seconds": 28.98,
      "duration_seconds": 1.5,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.96,
      "end_seconds": 33.41,
      "duration_seconds": 2.45,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.91,
      "end_seconds": 43.05,
      "duration_seconds": 5.14,
      "text": "Well, only pressure and a plaster, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.19,
      "end_seconds": 46.69,
      "duration_seconds": 2.5,
      "text": "Right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.79,
      "end_seconds": 53.5,
      "duration_seconds": 5.71,
      "text": "A little bleeding goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.23,
      "end_seconds": 62.21,
      "duration_seconds": 6.98,
      "text": "Anything in your past medical history I should know? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.96,
      "end_seconds": 66.64,
      "duration_seconds": 2.68,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.5,
      "end_seconds": 71.65,
      "duration_seconds": 4.15,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.49,
      "end_seconds": 73.65,
      "duration_seconds": 1.16,
      "text": "Yes, wheat."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.08,
      "end_seconds": 95.25,
      "duration_seconds": 3.17,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.81,
      "end_seconds": 98.7,
      "duration_seconds": 2.89,
      "text": "I'm on clopidogrel, once a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.34,
      "end_seconds": 101.57,
      "duration_seconds": 2.23,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.4,
      "end_seconds": 103.44,
      "duration_seconds": 1.04,
      "text": "75 milligrams."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.43,
      "end_seconds": 118.63,
      "duration_seconds": 4.2,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.45,
      "end_seconds": 122.25,
      "duration_seconds": 1.8,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.75,
      "end_seconds": 133.19,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.78,
      "end_seconds": 136.93,
      "duration_seconds": 2.15,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.0,
      "end_seconds": 141.85,
      "duration_seconds": 2.85,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.57,
      "end_seconds": 155.45,
      "duration_seconds": 11.88,
      "text": "I walk the dog every morning. I look after my grandchildren most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.82,
      "end_seconds": 158.96,
      "duration_seconds": 2.14,
      "text": "Any dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.12,
      "end_seconds": 162.86,
      "duration_seconds": 2.74,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.74,
      "end_seconds": 168.37,
      "duration_seconds": 4.63,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.87,
      "end_seconds": 172.01,
      "duration_seconds": 2.14,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.53,
      "end_seconds": 174.58,
      "duration_seconds": 2.05,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.09,
      "end_seconds": 176.88,
      "duration_seconds": 1.79,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.19,
      "end_seconds": 188.08,
      "duration_seconds": 2.89,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.51,
      "end_seconds": 200.91,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.87,
      "end_seconds": 229.88,
      "duration_seconds": 12.01,
      "text": "Okay: pressure 124 over 75, weight 61 kilos, temperature 36.9, heart rate 68, saturation 99 percent, BMI works out to 21.1, height 170 centimetres."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.9,
      "end_seconds": 236.36,
      "duration_seconds": 4.46,
      "text": "So, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.39,
      "end_seconds": 238.09,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.43,
      "end_seconds": 241.51,
      "duration_seconds": 2.08,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.81,
      "end_seconds": 257.4,
      "duration_seconds": 6.59,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.23,
      "end_seconds": 260.82,
      "duration_seconds": 1.59,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.7,
      "end_seconds": 293.81,
      "duration_seconds": 30.11,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. It fits best with a minor clean wound that needs only dressing. I'll close it with adhesive strips and keep it dry for two days. Keep an eye out, and if the finger turns red, hot or swollen, call us the same day or go to emergency. I'll want another look if it looks red or swollen."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 295.2,
      "end_seconds": 298.65,
      "duration_seconds": 3.45,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.33,
      "end_seconds": 302.97,
      "duration_seconds": 2.64,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.91,
      "end_seconds": 306.62,
      "duration_seconds": 1.71,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 313.38,
      "duration_seconds": 1.89,
      "text": "Have a good day."
    }
  ]
}