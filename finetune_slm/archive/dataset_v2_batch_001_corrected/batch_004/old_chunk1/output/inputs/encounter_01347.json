{
  "schema_version": "1.0",
  "encounter_id": "01347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 6.61,
      "duration_seconds": 6.0,
      "text": "doctor, I've brought them through the observations are done, whenever you need them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.26,
      "end_seconds": 11.64,
      "duration_seconds": 4.38,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.35,
      "end_seconds": 18.25,
      "duration_seconds": 4.9,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 23.49,
      "end_seconds": 30.57,
      "duration_seconds": 7.08,
      "text": "Doctor, it's a dry cough in the evenings. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.58,
      "end_seconds": 35.41,
      "duration_seconds": 2.83,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.09,
      "end_seconds": 39.5,
      "duration_seconds": 2.41,
      "text": "around three weeks, I think"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 40.59,
      "end_seconds": 43.74,
      "duration_seconds": 3.15,
      "text": "It was closer to a month, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.65,
      "end_seconds": 51.07,
      "duration_seconds": 5.42,
      "text": "Okay, so so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.7,
      "end_seconds": 53.63,
      "duration_seconds": 1.93,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.88,
      "end_seconds": 57.35,
      "duration_seconds": 2.47,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.9,
      "end_seconds": 61.02,
      "duration_seconds": 3.12,
      "text": "I get some relief from antihistamine"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.54,
      "end_seconds": 67.38,
      "duration_seconds": 2.84,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.15,
      "end_seconds": 74.03,
      "duration_seconds": 4.88,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.87,
      "end_seconds": 77.18,
      "duration_seconds": 2.31,
      "text": "what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.81,
      "end_seconds": 86.13,
      "duration_seconds": 8.32,
      "text": "Hmm, pollen season definitely sets it off. Well, I've also had sneezing fits, for five days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.94,
      "end_seconds": 89.89,
      "duration_seconds": 1.95,
      "text": "Any itchy eyes as well?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.22,
      "end_seconds": 92.92,
      "duration_seconds": 1.7,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 93.49,
      "end_seconds": 104.25,
      "duration_seconds": 10.76,
      "text": "Okay, so the vitals from earlier. Temp 36.9 degrees, pressure 128 over 80. Pulse 79, oxygen saturation is 97 percent, respiratory rate 18."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.81,
      "end_seconds": 105.9,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.35,
      "end_seconds": 111.59,
      "duration_seconds": 3.24,
      "text": "Right, shall I start the the examination?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.44,
      "end_seconds": 115.73,
      "duration_seconds": 2.29,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.86,
      "end_seconds": 136.76,
      "duration_seconds": 4.9,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.92,
      "end_seconds": 144.78,
      "duration_seconds": 2.86,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.03,
      "end_seconds": 158.23,
      "duration_seconds": 4.2,
      "text": "A few quick ones: shortness of breath or wheeze?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.79,
      "end_seconds": 162.49,
      "duration_seconds": 2.7,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.73,
      "end_seconds": 165.77,
      "duration_seconds": 2.04,
      "text": "Has there been any fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.92,
      "end_seconds": 170.17,
      "duration_seconds": 3.25,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.8,
      "end_seconds": 173.3,
      "duration_seconds": 2.5,
      "text": "so, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 174.9,
      "end_seconds": 176.68,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.78,
      "end_seconds": 182.77,
      "duration_seconds": 1.99,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.49,
      "end_seconds": 186.02,
      "duration_seconds": 2.53,
      "text": "nothing there, um, no"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.67,
      "end_seconds": 195.49,
      "duration_seconds": 3.82,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.88,
      "end_seconds": 202.47,
      "duration_seconds": 5.59,
      "text": "My aunt has rheumatoid arthritis. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.36,
      "end_seconds": 219.56,
      "duration_seconds": 1.2,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.69,
      "end_seconds": 225.41,
      "duration_seconds": 1.72,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.13,
      "end_seconds": 230.04,
      "duration_seconds": 2.91,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.55,
      "end_seconds": 234.47,
      "duration_seconds": 3.92,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.27,
      "end_seconds": 237.76,
      "duration_seconds": 2.49,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.02,
      "end_seconds": 242.34,
      "duration_seconds": 3.32,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.01,
      "end_seconds": 246.24,
      "duration_seconds": 2.23,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.64,
      "end_seconds": 251.41,
      "duration_seconds": 3.77,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.47,
      "end_seconds": 256.49,
      "duration_seconds": 3.02,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.5,
      "end_seconds": 266.13,
      "duration_seconds": 7.63,
      "text": "I take Seretide inhaler, twice a day for my asthma it's diclofenac, when needed"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.69,
      "end_seconds": 269.64,
      "duration_seconds": 1.95,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.24,
      "end_seconds": 276.9,
      "duration_seconds": 5.66,
      "text": "it's 50 milligrams. Metoprolol. I take it twice a day"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.26,
      "end_seconds": 280.33,
      "duration_seconds": 2.07,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 281.83,
      "end_seconds": 283.25,
      "duration_seconds": 1.42,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.35,
      "end_seconds": 285.66,
      "duration_seconds": 1.31,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.39,
      "end_seconds": 292.27,
      "duration_seconds": 5.88,
      "text": "Two years now. Loratadine, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.36,
      "end_seconds": 298.24,
      "duration_seconds": 3.88,
      "text": "Is the the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 300.31,
      "end_seconds": 304.04,
      "duration_seconds": 3.73,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.73,
      "end_seconds": 308.72,
      "duration_seconds": 3.99,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 309.95,
      "end_seconds": 314.64,
      "duration_seconds": 4.69,
      "text": "So, I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.6,
      "end_seconds": 317.58,
      "duration_seconds": 0.98,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 318.82,
      "end_seconds": 326.55,
      "duration_seconds": 7.73,
      "text": "I've got arthritis in my knees a neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.27,
      "end_seconds": 328.17,
      "duration_seconds": 0.9,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 329.1,
      "end_seconds": 334.66,
      "duration_seconds": 5.56,
      "text": "I have an irregular heartbeat. I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.66,
      "end_seconds": 339.88,
      "duration_seconds": 1.22,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.16,
      "end_seconds": 344.65,
      "duration_seconds": 3.49,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.53,
      "end_seconds": 348.9,
      "duration_seconds": 3.37,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 349.49,
      "end_seconds": 355.96,
      "duration_seconds": 6.47,
      "text": "Hold on, doctor, I think he reacted to tramadol once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 357.06,
      "end_seconds": 359.99,
      "duration_seconds": 2.93,
      "text": "really? I don't think so so"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.69,
      "end_seconds": 363.68,
      "duration_seconds": 2.99,
      "text": "fair enough, I'll write down both versions"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.87,
      "end_seconds": 383.81,
      "duration_seconds": 2.94,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.43,
      "end_seconds": 389.23,
      "duration_seconds": 4.8,
      "text": "I had a a triple bypass eight years ago"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.81,
      "end_seconds": 407.59,
      "duration_seconds": 17.78,
      "text": "from what you've told me and what I found, this looks most like seasonal hay fever causing the cough. That's my thinking for now, and it may change as we learn more. Early asthma is also on my list"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 410.97,
      "end_seconds": 414.05,
      "duration_seconds": 3.08,
      "text": "Is it dangerous, you know, doctor?"
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.61,
      "end_seconds": 447.39,
      "duration_seconds": 31.78,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal hay fever causing the cough. What I'm giving you is fluticasone nasal spray, 50 micrograms, once a day, for the season. That's for hay fever. Keep windows closed on high-pollen days and wash your hair at night. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.63,
      "end_seconds": 458.19,
      "duration_seconds": 9.56,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 459.59,
      "end_seconds": 462.68,
      "duration_seconds": 3.09,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 464.7,
      "end_seconds": 475.19,
      "duration_seconds": 10.49,
      "text": "one warning sign to remember: you start wheezing in that case don't wait let's plan a check in a month that's all from me any questions?"
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 475.88,
      "end_seconds": 479.21,
      "duration_seconds": 3.33,
      "text": "Great, thank you for your help."
    }
  ]
}