{
  "schema_version": "1.0",
  "encounter_id": "01197",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.56,
      "duration_seconds": 3.47,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.19,
      "end_seconds": 10.53,
      "duration_seconds": 4.34,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.81,
      "end_seconds": 15.97,
      "duration_seconds": 4.16,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.68,
      "end_seconds": 24.49,
      "duration_seconds": 2.81,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.79,
      "end_seconds": 34.69,
      "duration_seconds": 8.9,
      "text": "Mainly a severe sore throat. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.76,
      "end_seconds": 38.56,
      "duration_seconds": 2.8,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.5,
      "end_seconds": 42.13,
      "duration_seconds": 2.63,
      "text": "Around three weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 43.0,
      "end_seconds": 47.93,
      "duration_seconds": 4.93,
      "text": "Uh, I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.31,
      "end_seconds": 53.59,
      "duration_seconds": 4.28,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.64,
      "end_seconds": 60.56,
      "duration_seconds": 1.92,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.03,
      "end_seconds": 65.33,
      "duration_seconds": 3.3,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.93,
      "end_seconds": 70.01,
      "duration_seconds": 4.08,
      "text": "I'd call it severe. And drooling, too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.97,
      "end_seconds": 74.36,
      "duration_seconds": 3.39,
      "text": "So, has there been a muffled voice too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.83,
      "end_seconds": 84.75,
      "duration_seconds": 8.92,
      "text": "Yeah, I've had that since yesterday. As for muffled voice, I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 90.3,
      "duration_seconds": 3.84,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.88,
      "end_seconds": 101.95,
      "duration_seconds": 2.07,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.33,
      "end_seconds": 128.11,
      "duration_seconds": 7.78,
      "text": "Okay: temperature is 36.9 degrees, pulse is 95 beats a minute, blood pressure 120 over 73."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.15,
      "end_seconds": 131.48,
      "duration_seconds": 2.33,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.34,
      "end_seconds": 144.24,
      "duration_seconds": 0.9,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.6,
      "end_seconds": 147.82,
      "duration_seconds": 2.22,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.72,
      "end_seconds": 164.42,
      "duration_seconds": 4.7,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.53,
      "end_seconds": 172.46,
      "duration_seconds": 3.93,
      "text": "That's the examination finished. So, what about cough?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.62,
      "end_seconds": 176.36,
      "duration_seconds": 2.74,
      "text": "Ah, no, none, no cough."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.5,
      "end_seconds": 181.02,
      "duration_seconds": 3.52,
      "text": "Have you had rash, by any chance?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.69,
      "end_seconds": 185.33,
      "duration_seconds": 2.64,
      "text": "I haven't noticed any rash."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 185.83,
      "end_seconds": 190.57,
      "duration_seconds": 4.74,
      "text": "Actually, doctor, I did notice rash. She doesn't always say."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.28,
      "end_seconds": 197.88,
      "duration_seconds": 5.6,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.58,
      "end_seconds": 206.78,
      "duration_seconds": 7.2,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.82,
      "end_seconds": 210.38,
      "duration_seconds": 1.56,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.74,
      "end_seconds": 216.03,
      "duration_seconds": 4.29,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.19,
      "end_seconds": 221.64,
      "duration_seconds": 1.45,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.23,
      "end_seconds": 226.02,
      "duration_seconds": 2.79,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 227.77,
      "end_seconds": 236.31,
      "duration_seconds": 8.54,
      "text": "She takes sumatriptan, 50 milligrams, when needed. It's Foracort inhaler, twice a day for my asthma, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.85,
      "end_seconds": 238.4,
      "duration_seconds": 1.55,
      "text": "Sure. How about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.43,
      "end_seconds": 242.14,
      "duration_seconds": 2.71,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.72,
      "end_seconds": 245.97,
      "duration_seconds": 3.25,
      "text": "Alright, what line of work are you in?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.0,
      "end_seconds": 251.62,
      "duration_seconds": 4.62,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.23,
      "end_seconds": 255.6,
      "duration_seconds": 2.37,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.55,
      "end_seconds": 259.87,
      "duration_seconds": 2.32,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.34,
      "end_seconds": 264.55,
      "duration_seconds": 3.21,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.35,
      "end_seconds": 270.21,
      "duration_seconds": 2.86,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.7,
      "end_seconds": 291.91,
      "duration_seconds": 3.21,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.74,
      "end_seconds": 294.73,
      "duration_seconds": 1.99,
      "text": "I've had migraines, yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.29,
      "end_seconds": 296.99,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.65,
      "end_seconds": 301.63,
      "duration_seconds": 2.98,
      "text": "I have asthma, for five years."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.16,
      "end_seconds": 311.47,
      "duration_seconds": 9.31,
      "text": "Okay, I can see migraines in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.94,
      "end_seconds": 316.34,
      "duration_seconds": 3.4,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.04,
      "end_seconds": 328.67,
      "duration_seconds": 10.63,
      "text": "Okay, so my impression is this: It points towards a possible airway infection that needs emergency care. Severe tonsillitis is still possible."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.71,
      "end_seconds": 332.87,
      "duration_seconds": 3.16,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.59,
      "end_seconds": 352.64,
      "duration_seconds": 19.05,
      "text": "I can't promise yet, but most people with a possible airway infection that needs emergency care do well once it's treated properly. Just to be sure I understood. You've had a severe sore throat, severe, and no cough."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.68,
      "end_seconds": 355.18,
      "duration_seconds": 1.5,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.56,
      "end_seconds": 380.15,
      "duration_seconds": 15.59,
      "text": "Let's book an urgent airway assessment to look into stridor and drooling. Do not lie flat, I am calling an ambulance now. Book a review straight away. So, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.22,
      "end_seconds": 385.86,
      "duration_seconds": 4.64,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.81,
      "end_seconds": 390.46,
      "duration_seconds": 3.65,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.5,
      "end_seconds": 394.32,
      "duration_seconds": 2.82,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.06,
      "end_seconds": 396.73,
      "duration_seconds": 1.67,
      "text": "Have a good day."
    }
  ]
}