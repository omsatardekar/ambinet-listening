{
  "schema_version": "1.0",
  "encounter_id": "01005",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.08,
      "duration_seconds": 3.31,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.55,
      "end_seconds": 12.03,
      "duration_seconds": 4.48,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.63,
      "end_seconds": 18.08,
      "duration_seconds": 5.45,
      "text": "I'm here because of a dry cough in the evenings."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.91,
      "end_seconds": 22.04,
      "duration_seconds": 3.13,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.05,
      "end_seconds": 26.16,
      "duration_seconds": 3.11,
      "text": "Ever since... since this morning, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.8,
      "end_seconds": 32.95,
      "duration_seconds": 5.15,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.81,
      "end_seconds": 38.85,
      "duration_seconds": 5.04,
      "text": "Yes, pollen season. That makes it worse. Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.88,
      "end_seconds": 53.02,
      "duration_seconds": 5.14,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.09,
      "end_seconds": 67.06,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.29,
      "end_seconds": 90.83,
      "duration_seconds": 9.54,
      "text": "Okay: oxygen saturation is 97 percent, pulse 66, temperature is 36.8 degrees, respiratory rate 14, BP is 112 over 71."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.64,
      "end_seconds": 92.98,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.76,
      "end_seconds": 96.92,
      "duration_seconds": 2.16,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.44,
      "end_seconds": 102.67,
      "duration_seconds": 4.23,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.22,
      "end_seconds": 117.92,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.61,
      "end_seconds": 121.88,
      "duration_seconds": 2.27,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.12,
      "end_seconds": 143.27,
      "duration_seconds": 5.15,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.48,
      "end_seconds": 149.35,
      "duration_seconds": 1.87,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.61,
      "end_seconds": 165.04,
      "duration_seconds": 4.43,
      "text": "A few quick ones: fever, shortness of breath or wheeze?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.1,
      "end_seconds": 170.01,
      "duration_seconds": 3.91,
      "text": "Well, um, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.51,
      "end_seconds": 175.04,
      "duration_seconds": 3.53,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.46,
      "end_seconds": 178.41,
      "duration_seconds": 1.95,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.73,
      "end_seconds": 182.95,
      "duration_seconds": 3.22,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.49,
      "end_seconds": 194.71,
      "duration_seconds": 11.22,
      "text": "I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.24,
      "end_seconds": 199.62,
      "duration_seconds": 3.38,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.43,
      "end_seconds": 204.82,
      "duration_seconds": 3.39,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.63,
      "end_seconds": 207.67,
      "duration_seconds": 2.04,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 212.94,
      "duration_seconds": 4.06,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.54,
      "end_seconds": 218.33,
      "duration_seconds": 4.79,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.66,
      "end_seconds": 223.15,
      "duration_seconds": 3.49,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.84,
      "end_seconds": 230.48,
      "duration_seconds": 6.64,
      "text": "Can you list what you take, tablets, creams or inhalers? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.02,
      "end_seconds": 239.43,
      "duration_seconds": 7.41,
      "text": "Loratadine, 10 milligrams, once a day. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.02,
      "end_seconds": 253.63,
      "duration_seconds": 12.61,
      "text": "Right, here's what I'm thinking. It fits best with seasonal hay fever causing the cough. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.31,
      "end_seconds": 258.18,
      "duration_seconds": 3.87,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.99,
      "end_seconds": 279.91,
      "duration_seconds": 20.92,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal hay fever causing the cough. Let me just check I've got this right. You've had a dry cough in the evenings, since this morning, severe, and no wheeze or shortness of breath."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.5,
      "end_seconds": 282.08,
      "duration_seconds": 1.58,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.07,
      "end_seconds": 320.61,
      "duration_seconds": 27.54,
      "text": "The treatment will be fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever. Keep windows closed on high-pollen days and wash your hair at night. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Do get help quickly if you start wheezing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.25,
      "end_seconds": 323.77,
      "duration_seconds": 1.52,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.35,
      "end_seconds": 326.94,
      "duration_seconds": 2.59,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.67,
      "end_seconds": 330.84,
      "duration_seconds": 3.17,
      "text": "I think I understand everything. Thanks."
    }
  ]
}