{
  "schema_version": "1.0",
  "encounter_id": "01199",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.94,
      "duration_seconds": 4.36,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 11.42,
      "duration_seconds": 4.62,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.34,
      "end_seconds": 18.56,
      "duration_seconds": 6.22,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.51,
      "end_seconds": 24.67,
      "duration_seconds": 4.16,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.27,
      "end_seconds": 28.64,
      "duration_seconds": 2.37,
      "text": "She's been wanting contraception, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.33,
      "end_seconds": 32.16,
      "duration_seconds": 2.83,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.76,
      "end_seconds": 43.06,
      "duration_seconds": 2.3,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.24,
      "end_seconds": 71.36,
      "duration_seconds": 7.12,
      "text": "Okay: BP is 111 over 70, temperature is 36.4 degrees, respiratory rate 15, heart rate 79."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.55,
      "end_seconds": 73.98,
      "duration_seconds": 1.43,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.72,
      "end_seconds": 80.24,
      "duration_seconds": 5.52,
      "text": "That's fine, I'll explain it soon. How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.26,
      "end_seconds": 83.59,
      "duration_seconds": 2.33,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.27,
      "end_seconds": 87.06,
      "duration_seconds": 2.79,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.79,
      "end_seconds": 90.35,
      "duration_seconds": 2.56,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.26,
      "end_seconds": 93.78,
      "duration_seconds": 2.52,
      "text": "Any slightly heavy periods as well?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.08,
      "end_seconds": 96.16,
      "duration_seconds": 1.08,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.77,
      "end_seconds": 101.5,
      "duration_seconds": 4.73,
      "text": "Have you noticed breast lumps, smoking or migraine with aura?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.6,
      "end_seconds": 105.38,
      "duration_seconds": 2.78,
      "text": "Erm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.41,
      "end_seconds": 110.18,
      "duration_seconds": 2.77,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.3,
      "end_seconds": 112.43,
      "duration_seconds": 1.13,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.73,
      "end_seconds": 136.05,
      "duration_seconds": 5.32,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 137.96,
      "end_seconds": 141.94,
      "duration_seconds": 3.98,
      "text": "It's metoprolol, 50 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.5,
      "end_seconds": 144.68,
      "duration_seconds": 1.18,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 145.42,
      "end_seconds": 153.46,
      "duration_seconds": 8.04,
      "text": "About about three months. She is on furosemide, every morning, I give it to her."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.24,
      "end_seconds": 157.37,
      "duration_seconds": 2.13,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 159.02,
      "end_seconds": 159.99,
      "duration_seconds": 0.97,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.94,
      "end_seconds": 167.1,
      "duration_seconds": 5.16,
      "text": "I used to take aspirin, but I stopped it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.2,
      "end_seconds": 176.39,
      "duration_seconds": 4.19,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.19,
      "end_seconds": 185.1,
      "duration_seconds": 7.91,
      "text": "I have heart disease, for two years. I have heart failure, for two years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.17,
      "end_seconds": 188.11,
      "duration_seconds": 0.94,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.63,
      "end_seconds": 190.24,
      "duration_seconds": 1.61,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.25,
      "end_seconds": 194.23,
      "duration_seconds": 1.98,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.31,
      "end_seconds": 202.34,
      "duration_seconds": 7.03,
      "text": "Yes, heart disease and heart failure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.24,
      "end_seconds": 219.92,
      "duration_seconds": 2.68,
      "text": "So, do you get out much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.3,
      "end_seconds": 225.51,
      "duration_seconds": 4.21,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.22,
      "end_seconds": 228.4,
      "duration_seconds": 2.18,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.98,
      "end_seconds": 235.97,
      "duration_seconds": 5.99,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.82,
      "end_seconds": 240.5,
      "duration_seconds": 2.68,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.36,
      "end_seconds": 252.71,
      "duration_seconds": 11.35,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.57,
      "end_seconds": 258.27,
      "duration_seconds": 3.7,
      "text": "Right, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.02,
      "end_seconds": 265.08,
      "duration_seconds": 5.06,
      "text": "My grandfather had a stroke. My grandmother had dementia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.35,
      "end_seconds": 283.56,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.16,
      "end_seconds": 286.7,
      "duration_seconds": 1.54,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.72,
      "end_seconds": 291.38,
      "duration_seconds": 3.66,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.15,
      "end_seconds": 294.56,
      "duration_seconds": 1.41,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.69,
      "end_seconds": 309.84,
      "duration_seconds": 2.15,
      "text": "Your blood pressure is normal."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.03,
      "end_seconds": 311.73,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.36,
      "end_seconds": 325.04,
      "duration_seconds": 10.68,
      "text": "Okay, that's enough for me. From what you've told me and what I found, this looks most like suitable for hormonal contraception with no risk factors."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.77,
      "end_seconds": 330.11,
      "duration_seconds": 1.34,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.95,
      "end_seconds": 347.29,
      "duration_seconds": 16.34,
      "text": "Nothing I've seen today points to an emergency. It looks like suitable for hormonal contraception with no risk factors. Just to be sure I understood. You've been wanting contraception for three days, moderate, and no migraine with aura or breast lumps."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.15,
      "end_seconds": 350.07,
      "duration_seconds": 1.92,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.1,
      "end_seconds": 360.24,
      "duration_seconds": 9.14,
      "text": "I'd like you to take levonorgestrel and ethinylestradiol, 150 micrograms and 30 micrograms, once a day, long term. That's for contraception."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.07,
      "end_seconds": 366.69,
      "duration_seconds": 1.62,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.89,
      "end_seconds": 382.62,
      "duration_seconds": 14.73,
      "text": "Take the pill at the same time each day and use condoms if you miss two. One warning sign to remember: you get leg swelling or severe headaches. In that case don't wait."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.22,
      "end_seconds": 386.58,
      "duration_seconds": 3.36,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.16,
      "end_seconds": 390.3,
      "duration_seconds": 2.14,
      "text": "Come back in three months."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.9,
      "end_seconds": 392.5,
      "duration_seconds": 1.6,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.06,
      "end_seconds": 396.95,
      "duration_seconds": 3.89,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.84,
      "end_seconds": 402.44,
      "duration_seconds": 3.6,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.31,
      "end_seconds": 405.63,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}