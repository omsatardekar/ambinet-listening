  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 4.68,
      "duration_seconds": 4.16,
      "text": "well, sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.01,
      "end_seconds": 10.99,
      "duration_seconds": 4.98,
      "text": "you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 18.4,
      "duration_seconds": 6.67,
      "text": "So the thing is, um, I've got a sore ankle."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.11,
      "end_seconds": 21.52,
      "duration_seconds": 2.41,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.25,
      "end_seconds": 27.61,
      "duration_seconds": 4.36,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.15,
      "end_seconds": 36.59,
      "duration_seconds": 8.44,
      "text": "okay, give me more detail on it, whatever comes to mind these questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.66,
      "end_seconds": 64.38,
      "duration_seconds": 25.72,
      "text": "I get some relief from rest and ice it sort of comes and goes it's the not knowing that gets to me i wasn't sure whether to come in at all, uh, to be honest i had a little swelling before that's settled now, though"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.08,
      "end_seconds": 72.27,
      "duration_seconds": 6.19,
      "text": "Have you had a sore ankle before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.23,
      "end_seconds": 81.46,
      "duration_seconds": 7.23,
      "text": "Uh, you know, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.28,
      "end_seconds": 89.02,
      "duration_seconds": 5.74,
      "text": "And what about crack or pop, pain in the foot or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.33,
      "end_seconds": 96.98,
      "duration_seconds": 6.65,
      "text": "No crack or pop, pain in the foot or numbness, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.15,
      "end_seconds": 101.55,
      "duration_seconds": 3.4,
      "text": "And And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.01,
      "end_seconds": 108.32,
      "duration_seconds": 3.31,
      "text": "Oh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.98,
      "end_seconds": 112.87,
      "duration_seconds": 3.89,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.76,
      "end_seconds": 115.31,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.92,
      "end_seconds": 117.9,
      "duration_seconds": 0.98,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.73,
      "end_seconds": 122.49,
      "duration_seconds": 2.76,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.46,
      "end_seconds": 125.81,
      "duration_seconds": 1.35,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.73,
      "end_seconds": 131.34,
      "duration_seconds": 4.61,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.1,
      "end_seconds": 134.88,
      "duration_seconds": 2.78,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.48,
      "end_seconds": 139.39,
      "duration_seconds": 3.91,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.06,
      "end_seconds": 143.87,
      "duration_seconds": 3.81,
      "text": "right, what do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.41,
      "end_seconds": 149.17,
      "duration_seconds": 3.76,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.99,
      "end_seconds": 153.09,
      "duration_seconds": 2.1,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.78,
      "end_seconds": 158.42,
      "duration_seconds": 4.64,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.01,
      "end_seconds": 171.09,
      "duration_seconds": 2.08,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.43,
      "end_seconds": 175.67,
      "duration_seconds": 3.24,
      "text": "Levetiracetam, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.34,
      "end_seconds": 186.85,
      "duration_seconds": 3.51,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.12,
      "end_seconds": 193.14,
      "duration_seconds": 5.02,
      "text": "Oh, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.98,
      "end_seconds": 197.11,
      "duration_seconds": 3.13,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.87,
      "end_seconds": 200.75,
      "duration_seconds": 2.88,
      "text": "Erm, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.15,
      "end_seconds": 219.59,
      "duration_seconds": 2.44,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.46,
      "end_seconds": 226.67,
      "duration_seconds": 6.21,
      "text": "Epilepsy, for two years. I've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.75,
      "end_seconds": 232.6,
      "duration_seconds": 3.85,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 246.83,
      "duration_seconds": 2.4,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.55,
      "end_seconds": 278.1,
      "duration_seconds": 11.55,
      "text": "Okay: height 166 centimetres, pulse is 66 beats a minute. And weight 68 kilos, temperature 36.5, saturation 99 percent, pressure 109 over 76."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.04,
      "end_seconds": 283.18,
      "duration_seconds": 2.14,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.17,
      "end_seconds": 285.2,
      "duration_seconds": 1.03,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.15,
      "end_seconds": 289.14,
      "duration_seconds": 1.99,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.14,
      "end_seconds": 304.42,
      "duration_seconds": 7.28,
      "text": "there's mild swelling over the outside of the ankle, and you can put your weight on it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.88,
      "end_seconds": 306.9,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.82,
      "end_seconds": 335.95,
      "duration_seconds": 24.13,
      "text": "thank you, you can get dressed. Putting it all together, it points towards a mild ankle sprain. That's my thinking for now, and it may change as we learn more. A minor fracture is still possible. For now, no new medicines or tests are needed. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.84,
      "end_seconds": 338.47,
      "duration_seconds": 1.63,
      "text": "That's clear, thanks."
    }
  ]
}