{
  "schema_version": "1.0",
  "encounter_id": "01421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 5.1,
      "duration_seconds": 4.55,
      "text": "Sorry I'm a little late, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.01,
      "end_seconds": 10.86,
      "duration_seconds": 3.85,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.2,
      "end_seconds": 17.87,
      "duration_seconds": 5.67,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.74,
      "end_seconds": 22.99,
      "duration_seconds": 3.25,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.73,
      "end_seconds": 36.02,
      "duration_seconds": 12.29,
      "text": "Um, so... a tight band around my head. That's why I came. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.82,
      "end_seconds": 40.83,
      "duration_seconds": 3.01,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.82,
      "end_seconds": 45.55,
      "duration_seconds": 2.73,
      "text": "I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 47.32,
      "end_seconds": 51.35,
      "duration_seconds": 4.03,
      "text": "Mm, it was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.29,
      "end_seconds": 58.06,
      "duration_seconds": 4.77,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.01,
      "end_seconds": 61.23,
      "duration_seconds": 2.22,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.93,
      "end_seconds": 67.46,
      "duration_seconds": 4.53,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.47,
      "end_seconds": 81.84,
      "duration_seconds": 13.37,
      "text": "A five out of ten, I suppose. Honestly, a couple of times a week. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.84,
      "end_seconds": 85.22,
      "duration_seconds": 2.38,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.9,
      "end_seconds": 96.67,
      "duration_seconds": 10.77,
      "text": "Uh, it usually comes with a stiff neck. I've also had tired eyes. The stiff neck? That's been for ten days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.85,
      "end_seconds": 109.75,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.09,
      "end_seconds": 121.3,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.77,
      "end_seconds": 142.1,
      "duration_seconds": 9.33,
      "text": "Okay: BP is 123 over 81, saturation 99 percent. And pulse is 73 beats a minute, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.14,
      "end_seconds": 148.94,
      "duration_seconds": 4.8,
      "text": "Okay, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.54,
      "end_seconds": 150.49,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 153.92,
      "duration_seconds": 2.09,
      "text": "Alright, look straight ahead."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.82,
      "end_seconds": 175.36,
      "duration_seconds": 5.54,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.52,
      "end_seconds": 177.56,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.86,
      "end_seconds": 187.14,
      "duration_seconds": 7.28,
      "text": "Good, you can sit up again. Did you get sickness, sensitivity to light, blurred vision or weakness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.16,
      "end_seconds": 195.05,
      "duration_seconds": 6.89,
      "text": "Sorry, um, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.94,
      "end_seconds": 199.41,
      "duration_seconds": 2.47,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.11,
      "end_seconds": 202.19,
      "duration_seconds": 1.08,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.41,
      "end_seconds": 206.4,
      "duration_seconds": 2.99,
      "text": "Okay, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.04,
      "end_seconds": 213.04,
      "duration_seconds": 1.0,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.06,
      "end_seconds": 218.73,
      "duration_seconds": 4.67,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.2,
      "end_seconds": 222.3,
      "duration_seconds": 2.1,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.09,
      "end_seconds": 242.04,
      "duration_seconds": 2.95,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.67,
      "end_seconds": 251.8,
      "duration_seconds": 9.13,
      "text": "Yes, um, I had a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.05,
      "end_seconds": 255.09,
      "duration_seconds": 2.04,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.84,
      "end_seconds": 259.36,
      "duration_seconds": 2.52,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.2,
      "end_seconds": 262.71,
      "duration_seconds": 2.51,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.5,
      "end_seconds": 267.51,
      "duration_seconds": 4.01,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.53,
      "end_seconds": 272.11,
      "duration_seconds": 2.58,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.38,
      "end_seconds": 277.53,
      "duration_seconds": 4.15,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.23,
      "end_seconds": 280.47,
      "duration_seconds": 2.24,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.31,
      "end_seconds": 297.84,
      "duration_seconds": 11.53,
      "text": "I've had diabetes for about a year now. I looked a few things up online, um, and that probably didn't help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.85,
      "end_seconds": 304.66,
      "duration_seconds": 5.81,
      "text": "Alright, diabetes, that matches what I have here. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.45,
      "end_seconds": 309.9,
      "duration_seconds": 4.45,
      "text": "Oh, you know, yes, cat fur. I get sneezing."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.47,
      "end_seconds": 314.28,
      "duration_seconds": 2.81,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 314.89,
      "end_seconds": 321.6,
      "duration_seconds": 6.71,
      "text": "I mean, he takes Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.2,
      "end_seconds": 333.42,
      "duration_seconds": 11.22,
      "text": "Taking everything into account, my working impression is tension-type headache. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.64,
      "end_seconds": 374.26,
      "duration_seconds": 25.62,
      "text": "We should do an eye test for eye strain. Take screen breaks every hour and try regular neck stretches. Keep an eye out, and if the headache becomes sudden and severe, call us the same day or go to emergency. Book a review in four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.88,
      "end_seconds": 378.86,
      "duration_seconds": 2.98,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}