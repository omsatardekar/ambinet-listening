{
  "schema_version": "1.0",
  "encounter_id": "01109",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 2.79,
      "duration_seconds": 1.9,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.66,
      "end_seconds": 9.45,
      "duration_seconds": 4.79,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.54,
      "end_seconds": 23.98,
      "duration_seconds": 12.44,
      "text": "Um, um, so... my face drooping on one side. That's why I came. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.01,
      "end_seconds": 27.28,
      "duration_seconds": 1.27,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.66,
      "end_seconds": 30.83,
      "duration_seconds": 2.17,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.46,
      "end_seconds": 35.38,
      "duration_seconds": 2.92,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.78,
      "end_seconds": 49.45,
      "duration_seconds": 12.67,
      "text": "Actually, I'd call it moderate. Well, I've also had weakness in my right arm, since last Tuesday. I've had slurred speech too, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.82,
      "end_seconds": 57.61,
      "duration_seconds": 2.79,
      "text": "Has there been a sudden headache too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.44,
      "end_seconds": 62.47,
      "duration_seconds": 4.03,
      "text": "Yes, uh, for about a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.43,
      "end_seconds": 65.9,
      "duration_seconds": 2.47,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.61,
      "end_seconds": 71.54,
      "duration_seconds": 3.93,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 79.42,
      "duration_seconds": 6.59,
      "text": "Have you had your face drooping on one side before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.65,
      "end_seconds": 88.98,
      "duration_seconds": 5.33,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.02,
      "end_seconds": 93.4,
      "duration_seconds": 2.38,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.15,
      "end_seconds": 100.76,
      "duration_seconds": 5.61,
      "text": "Well, I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.49,
      "end_seconds": 114.54,
      "duration_seconds": 2.05,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.5,
      "end_seconds": 120.29,
      "duration_seconds": 3.79,
      "text": "Ramipril, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.29,
      "end_seconds": 124.41,
      "duration_seconds": 2.12,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.99,
      "end_seconds": 135.78,
      "duration_seconds": 7.79,
      "text": "It's 5 milligrams. Apixaban. I take it 5 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.42,
      "end_seconds": 140.44,
      "duration_seconds": 4.02,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.24,
      "end_seconds": 146.96,
      "duration_seconds": 4.72,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.18,
      "end_seconds": 152.27,
      "duration_seconds": 4.09,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.91,
      "end_seconds": 165.75,
      "duration_seconds": 12.84,
      "text": "I used to drink heavily but I stopped four years ago. I swim twice a week. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.26,
      "end_seconds": 170.38,
      "duration_seconds": 4.12,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.91,
      "end_seconds": 178.87,
      "duration_seconds": 6.96,
      "text": "Let me think, I've had high blood pressure for two years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.64,
      "end_seconds": 180.62,
      "duration_seconds": 0.98,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.58,
      "end_seconds": 188.43,
      "duration_seconds": 5.85,
      "text": "So, I have an irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.28,
      "end_seconds": 196.07,
      "duration_seconds": 6.79,
      "text": "Ah. Right, so an irregular heartbeat is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.39,
      "end_seconds": 217.46,
      "duration_seconds": 3.07,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.97,
      "end_seconds": 225.15,
      "duration_seconds": 6.18,
      "text": "My father had bowel cancer. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.08,
      "end_seconds": 231.33,
      "duration_seconds": 4.25,
      "text": "Have you noticed loss of consciousness, fever or seizure?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.96,
      "end_seconds": 236.16,
      "duration_seconds": 3.2,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.19,
      "end_seconds": 240.05,
      "duration_seconds": 2.86,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.33,
      "end_seconds": 242.94,
      "duration_seconds": 1.61,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.65,
      "end_seconds": 245.82,
      "duration_seconds": 2.17,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.34,
      "end_seconds": 254.34,
      "duration_seconds": 5.0,
      "text": "Let me think, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.8,
      "end_seconds": 260.44,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.17,
      "end_seconds": 276.63,
      "duration_seconds": 2.46,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.01,
      "end_seconds": 300.62,
      "duration_seconds": 11.61,
      "text": "Okay: height 179 centimetres, weight 69 kilos, blood pressure 161 over 100, temperature is 36.9 degrees, BMI works out to 21.5, pulse 94."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.67,
      "end_seconds": 304.71,
      "duration_seconds": 2.04,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.61,
      "end_seconds": 308.06,
      "duration_seconds": 2.45,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.51,
      "end_seconds": 327.12,
      "duration_seconds": 5.61,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.99,
      "end_seconds": 344.51,
      "duration_seconds": 1.52,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.64,
      "end_seconds": 361.79,
      "duration_seconds": 14.15,
      "text": "Thank you, you can get dressed. Taking everything into account, it fits best with a possible stroke, within the treatment window. I can't rule out a migraine with aura yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.7,
      "end_seconds": 366.25,
      "duration_seconds": 1.55,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.95,
      "end_seconds": 389.94,
      "duration_seconds": 22.99,
      "text": "I understand the worry. At the moment I'd say it's a possible stroke, within the treatment window, and we'll know more once the an urgent CT scan of the head is back. We should do an urgent CT scan of the head for possible stroke. We should do a blood sugar test for stroke symptoms."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.54,
      "end_seconds": 396.95,
      "duration_seconds": 5.41,
      "text": "Erm, you know, where would I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.72,
      "end_seconds": 415.93,
      "duration_seconds": 17.21,
      "text": "Call an ambulance now, you need hospital immediately. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.97,
      "end_seconds": 421.91,
      "duration_seconds": 3.94,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}