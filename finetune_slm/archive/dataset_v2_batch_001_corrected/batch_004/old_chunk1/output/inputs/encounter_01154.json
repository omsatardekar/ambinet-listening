{
  "schema_version": "1.0",
  "encounter_id": "01154",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 7.58,
      "duration_seconds": 6.34,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.38,
      "end_seconds": 13.6,
      "duration_seconds": 4.22,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.08,
      "end_seconds": 22.41,
      "duration_seconds": 7.33,
      "text": "Um, so so the thing is, I've got being very thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.77,
      "end_seconds": 28.36,
      "duration_seconds": 1.59,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.99,
      "end_seconds": 32.72,
      "duration_seconds": 2.73,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.18,
      "end_seconds": 37.39,
      "duration_seconds": 3.21,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.96,
      "end_seconds": 43.7,
      "duration_seconds": 4.74,
      "text": "Okay, so pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.46,
      "end_seconds": 49.06,
      "duration_seconds": 3.6,
      "text": "What about tummy pain, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.1,
      "end_seconds": 54.4,
      "duration_seconds": 3.3,
      "text": "Yeah, yes, for ten days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.74,
      "end_seconds": 58.63,
      "duration_seconds": 2.89,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.41,
      "end_seconds": 64.23,
      "duration_seconds": 3.82,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.02,
      "end_seconds": 67.91,
      "duration_seconds": 2.89,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.53,
      "end_seconds": 71.84,
      "duration_seconds": 2.31,
      "text": "Diabetes, for two years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.69,
      "end_seconds": 82.97,
      "duration_seconds": 6.28,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.03,
      "end_seconds": 99.1,
      "duration_seconds": 2.07,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.61,
      "end_seconds": 104.36,
      "duration_seconds": 4.75,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.65,
      "end_seconds": 108.55,
      "duration_seconds": 2.9,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.45,
      "end_seconds": 112.92,
      "duration_seconds": 3.47,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.45,
      "end_seconds": 116.31,
      "duration_seconds": 2.86,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.04,
      "end_seconds": 119.18,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.32,
      "end_seconds": 123.51,
      "duration_seconds": 3.19,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.5,
      "end_seconds": 130.27,
      "duration_seconds": 5.77,
      "text": "Sitagliptin, 100 milligrams, maybe, once a day for my sugar."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.27,
      "end_seconds": 135.33,
      "duration_seconds": 4.06,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.24,
      "end_seconds": 143.99,
      "duration_seconds": 7.75,
      "text": "no, it's at home i'd been on glimepiride, not any more though, I stopped"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.22,
      "end_seconds": 150.04,
      "duration_seconds": 4.82,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.37,
      "end_seconds": 156.27,
      "duration_seconds": 4.9,
      "text": "yes, uh, I'm allergic to to grass pollen"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.78,
      "end_seconds": 160.61,
      "duration_seconds": 3.83,
      "text": "Have you had any chest pain or cough?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.24,
      "end_seconds": 165.42,
      "duration_seconds": 4.18,
      "text": "hmm, no, none that I've noticed"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.12,
      "end_seconds": 170.9,
      "duration_seconds": 4.78,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.18,
      "end_seconds": 174.41,
      "duration_seconds": 2.23,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.6,
      "end_seconds": 195.61,
      "duration_seconds": 4.01,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.65,
      "end_seconds": 206.27,
      "duration_seconds": 2.62,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.24,
      "end_seconds": 226.63,
      "duration_seconds": 10.39,
      "text": "Okay: oxygen saturation is 96 percent, blood pressure 138 over 80, respiratory rate 19. And temp 36.8 degrees, pulse is 113 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.29,
      "end_seconds": 229.06,
      "duration_seconds": 1.77,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.43,
      "end_seconds": 233.2,
      "duration_seconds": 2.77,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.18,
      "end_seconds": 238.03,
      "duration_seconds": 2.85,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.97,
      "end_seconds": 241.17,
      "duration_seconds": 2.2,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.57,
      "end_seconds": 259.29,
      "duration_seconds": 4.72,
      "text": "You are dry, breathing deeply and and your breath smells fruity."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.66,
      "end_seconds": 282.07,
      "duration_seconds": 19.41,
      "text": "You can relax now. Okay, so my impression is this: I can't pin this down yet. We're looking at diabetic ketoacidosis or a severe infection. Let me repeat that back to make sure. You've had being very thirsty for three days, mild, and no cough or chest pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.19,
      "end_seconds": 283.89,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.68,
      "end_seconds": 311.86,
      "duration_seconds": 11.18,
      "text": "I'd like to arrange blood gas and electrolytes for DKA. I think a blood sugar and ketone test makes sense here, for thirst and vomiting"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.82,
      "end_seconds": 315.72,
      "duration_seconds": 2.9,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.81,
      "end_seconds": 337.7,
      "duration_seconds": 17.89,
      "text": "you need to go to hospital now for insulin and fluids i'll also refer you to the emergency team and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.99,
      "end_seconds": 340.14,
      "duration_seconds": 1.15,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.07,
      "end_seconds": 352.75,
      "duration_seconds": 11.68,
      "text": "one warning sign to remember: you cannot get there now. In that case don't wait. I'll want another look straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.24,
      "end_seconds": 357.53,
      "duration_seconds": 3.29,
      "text": "I think I understand everything. Thanks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.45,
      "end_seconds": 359.66,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}