{
  "schema_version": "1.0",
  "encounter_id": "01295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.33,
      "duration_seconds": 3.8,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.57,
      "end_seconds": 9.93,
      "duration_seconds": 4.36,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.58,
      "end_seconds": 14.52,
      "duration_seconds": 2.94,
      "text": "It's, It's a high fever, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.16,
      "end_seconds": 18.06,
      "duration_seconds": 2.9,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.89,
      "end_seconds": 33.11,
      "duration_seconds": 2.22,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.55,
      "end_seconds": 57.41,
      "duration_seconds": 10.86,
      "text": "Okay: pulse 88, respiratory rate 17, blood pressure 104 over 71. And SpO2 96 percent on room air. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.78,
      "end_seconds": 70.51,
      "duration_seconds": 11.73,
      "text": "Yeah, probably three days. Yeah. I didn't want to to make a fuss, you know. I've, I've also had hating the light, since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.26,
      "end_seconds": 74.59,
      "duration_seconds": 2.33,
      "text": "Any cough or recent head injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.56,
      "end_seconds": 82.96,
      "duration_seconds": 2.4,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.82,
      "end_seconds": 88.08,
      "duration_seconds": 3.26,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.11,
      "end_seconds": 90.67,
      "duration_seconds": 1.56,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.16,
      "end_seconds": 94.43,
      "duration_seconds": 2.27,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.26,
      "end_seconds": 97.79,
      "duration_seconds": 1.53,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.71,
      "end_seconds": 102.16,
      "duration_seconds": 2.45,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.79,
      "end_seconds": 106.13,
      "duration_seconds": 2.34,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.61,
      "end_seconds": 126.95,
      "duration_seconds": 4.34,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.04,
      "end_seconds": 131.66,
      "duration_seconds": 3.62,
      "text": "Telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.36,
      "end_seconds": 136.57,
      "duration_seconds": 3.21,
      "text": "how long has that been going on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.14,
      "end_seconds": 139.56,
      "duration_seconds": 1.42,
      "text": "Six months now"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.33,
      "end_seconds": 144.63,
      "duration_seconds": 3.3,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.91,
      "end_seconds": 151.11,
      "duration_seconds": 5.2,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.29,
      "end_seconds": 172.68,
      "duration_seconds": 3.39,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.87,
      "end_seconds": 182.08,
      "duration_seconds": 5.21,
      "text": "I mean, you know, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.84,
      "end_seconds": 202.48,
      "duration_seconds": 3.64,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.34,
      "end_seconds": 206.96,
      "duration_seconds": 3.62,
      "text": "Yes, wheat, it gives me bloating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.65,
      "end_seconds": 209.67,
      "duration_seconds": 2.02,
      "text": "Alright, do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.7,
      "end_seconds": 218.6,
      "duration_seconds": 2.9,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.9,
      "end_seconds": 221.8,
      "duration_seconds": 1.9,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.47,
      "end_seconds": 226.49,
      "duration_seconds": 4.02,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 230.88,
      "duration_seconds": 3.77,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.47,
      "end_seconds": 235.54,
      "duration_seconds": 4.07,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.8,
      "end_seconds": 238.91,
      "duration_seconds": 2.11,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.09,
      "end_seconds": 244.3,
      "duration_seconds": 4.21,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.19,
      "end_seconds": 247.9,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.98,
      "end_seconds": 253.54,
      "duration_seconds": 3.56,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 278.94,
      "duration_seconds": 24.3,
      "text": "So, based on your history, my working impression is possible bacterial meningitis. I'm going to order a lumbar puncture, for possible meningitis. What I'm giving you is benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. Call an ambulance now, this is an emergency. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.92,
      "end_seconds": 283.56,
      "duration_seconds": 2.64,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.56,
      "end_seconds": 295.86,
      "duration_seconds": 10.3,
      "text": "Let's hold off on blood cultures for now, and if there's no change in two weeks we can revisit it. Come back straight away."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.15,
      "end_seconds": 297.85,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.04,
      "end_seconds": 305.0,
      "duration_seconds": 5.96,
      "text": "let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.87,
      "end_seconds": 317.14,
      "duration_seconds": 10.27,
      "text": "So, um, I take the benzylpenicillin, 1.2 grams, once now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.59,
      "end_seconds": 323.13,
      "duration_seconds": 4.54,
      "text": "yes, exactly right have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.71,
      "end_seconds": 328.19,
      "duration_seconds": 3.48,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}