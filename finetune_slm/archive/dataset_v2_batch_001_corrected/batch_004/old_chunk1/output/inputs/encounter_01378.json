{
  "schema_version": "1.0",
  "encounter_id": "01378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 2.98,
      "duration_seconds": 1.71,
      "text": "good afternoon, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.55,
      "end_seconds": 8.29,
      "duration_seconds": 3.74,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.72,
      "end_seconds": 18.58,
      "duration_seconds": 8.86,
      "text": "I wanted to get a runny nose looked at. Sorry, I know I'm rambling a a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.84,
      "end_seconds": 23.85,
      "duration_seconds": 4.01,
      "text": "When was the the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.9,
      "end_seconds": 35.43,
      "duration_seconds": 10.53,
      "text": "It's been going on for about two weeks. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.91,
      "end_seconds": 39.39,
      "duration_seconds": 3.48,
      "text": "Yes, carry on. Has there been sneezing too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.42,
      "end_seconds": 46.55,
      "duration_seconds": 4.13,
      "text": "Yes, actually. About sneezing, I'd say mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.99,
      "end_seconds": 50.55,
      "duration_seconds": 2.56,
      "text": "Have you had a mild cough?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.2,
      "end_seconds": 57.16,
      "duration_seconds": 3.96,
      "text": "Yes, you know, about the same, two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.68,
      "end_seconds": 61.55,
      "duration_seconds": 2.87,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.23,
      "end_seconds": 65.04,
      "duration_seconds": 2.81,
      "text": "Honey and lemon helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.4,
      "end_seconds": 70.14,
      "duration_seconds": 4.74,
      "text": "Mm-hmm. So, is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.23,
      "end_seconds": 72.43,
      "duration_seconds": 1.2,
      "text": "Severe, really"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.94,
      "end_seconds": 75.14,
      "duration_seconds": 2.2,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.21,
      "end_seconds": 79.46,
      "duration_seconds": 3.25,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.16,
      "end_seconds": 98.8,
      "duration_seconds": 3.64,
      "text": "any chest pain or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.88,
      "end_seconds": 105.51,
      "duration_seconds": 5.63,
      "text": "okay, so I haven't had chest pain or shortness of breath, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.23,
      "end_seconds": 110.54,
      "duration_seconds": 3.31,
      "text": "Any fever or ear pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.15,
      "end_seconds": 116.59,
      "duration_seconds": 4.44,
      "text": "I haven't had fever or ear pain, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.81,
      "end_seconds": 121.0,
      "duration_seconds": 3.19,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.64,
      "end_seconds": 123.78,
      "duration_seconds": 2.14,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.52,
      "end_seconds": 127.69,
      "duration_seconds": 3.17,
      "text": "So, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.87,
      "end_seconds": 129.94,
      "duration_seconds": 1.07,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.66,
      "end_seconds": 132.34,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.27,
      "end_seconds": 137.93,
      "duration_seconds": 3.66,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.48,
      "end_seconds": 139.79,
      "duration_seconds": 1.31,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.25,
      "end_seconds": 147.72,
      "duration_seconds": 3.47,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.26,
      "end_seconds": 150.8,
      "duration_seconds": 2.54,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.13,
      "end_seconds": 156.63,
      "duration_seconds": 4.5,
      "text": "It's pantoprazole, 40 milligrams, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.92,
      "end_seconds": 158.5,
      "duration_seconds": 1.58,
      "text": "yes, carry on"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.92,
      "end_seconds": 162.35,
      "duration_seconds": 2.43,
      "text": "It's throat lozenges, when needed."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.06,
      "end_seconds": 165.4,
      "duration_seconds": 1.34,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.05,
      "end_seconds": 168.25,
      "duration_seconds": 2.2,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.92,
      "end_seconds": 173.38,
      "duration_seconds": 4.46,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.27,
      "end_seconds": 177.19,
      "duration_seconds": 1.92,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.93,
      "end_seconds": 181.88,
      "duration_seconds": 3.95,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.45,
      "end_seconds": 185.51,
      "duration_seconds": 2.06,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 196.46,
      "duration_seconds": 10.41,
      "text": "Ah. Alright, acid reflux, that matches what I have here. Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.32,
      "end_seconds": 201.63,
      "duration_seconds": 3.31,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.06,
      "end_seconds": 205.35,
      "duration_seconds": 2.29,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.68,
      "end_seconds": 218.56,
      "duration_seconds": 2.88,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.97,
      "end_seconds": 243.37,
      "duration_seconds": 10.4,
      "text": "Okay: temp 36.9 degrees, respiratory rate 15, saturation 98 percent, pulse is 71 beats a minute, blood pressure 117 over 70."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.2,
      "end_seconds": 248.83,
      "duration_seconds": 3.63,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.78,
      "end_seconds": 252.6,
      "duration_seconds": 2.82,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.57,
      "end_seconds": 276.21,
      "duration_seconds": 4.64,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.51,
      "end_seconds": 282.33,
      "duration_seconds": 2.82,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.05,
      "end_seconds": 297.25,
      "duration_seconds": 7.2,
      "text": "Having listened and examined, I think we're dealing with a simple viral cold at this stage."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.51,
      "end_seconds": 301.41,
      "duration_seconds": 2.9,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.37,
      "end_seconds": 309.28,
      "duration_seconds": 6.91,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.73,
      "end_seconds": 339.11,
      "duration_seconds": 12.38,
      "text": "rest, plenty of fluids, and paracetamol if you ache please come and see me if it is not better in ten days anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.09,
      "end_seconds": 343.72,
      "duration_seconds": 3.63,
      "text": "Well, um, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.57,
      "end_seconds": 346.84,
      "duration_seconds": 1.27,
      "text": "Look after yourself."
    }
  ]
}