{
  "schema_version": "1.0",
  "encounter_id": "01207",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.34,
      "end_seconds": 8.47,
      "duration_seconds": 7.13,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.78,
      "end_seconds": 14.94,
      "duration_seconds": 5.16,
      "text": "Alright, good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.95,
      "end_seconds": 21.09,
      "duration_seconds": 4.14,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.75,
      "end_seconds": 26.99,
      "duration_seconds": 4.24,
      "text": "Alright, that's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.96,
      "end_seconds": 32.07,
      "duration_seconds": 3.11,
      "text": "He's been having no real problems, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 37.34,
      "duration_seconds": 3.19,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.96,
      "end_seconds": 41.53,
      "duration_seconds": 3.57,
      "text": "It's been two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.64,
      "end_seconds": 48.4,
      "duration_seconds": 2.76,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.12,
      "end_seconds": 52.13,
      "duration_seconds": 3.01,
      "text": "Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.22,
      "end_seconds": 56.27,
      "duration_seconds": 2.05,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.08,
      "end_seconds": 77.61,
      "duration_seconds": 20.53,
      "text": "It, It usually comes with a bit of back stiffness. Erm, I've had an occasional headache too, for about four days. About occasional headache, honestly, every other day. The, The bit of back stiffness? That's been for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.72,
      "end_seconds": 80.8,
      "duration_seconds": 2.08,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 82.35,
      "end_seconds": 85.06,
      "duration_seconds": 2.71,
      "text": "It settles a little with stretching."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.13,
      "end_seconds": 90.55,
      "duration_seconds": 4.42,
      "text": "Did you get weight loss, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.22,
      "end_seconds": 98.41,
      "duration_seconds": 6.19,
      "text": "No weight loss, shortness of breath or chest pain, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.09,
      "end_seconds": 102.54,
      "duration_seconds": 3.45,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.08,
      "end_seconds": 104.06,
      "duration_seconds": 0.98,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.21,
      "end_seconds": 108.21,
      "duration_seconds": 3.0,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.33,
      "end_seconds": 113.98,
      "duration_seconds": 4.65,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.85,
      "end_seconds": 118.76,
      "duration_seconds": 3.91,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.82,
      "end_seconds": 131.7,
      "duration_seconds": 10.88,
      "text": "I take rosuvastatin, 10 milligrams, at night for my cholesterol. Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 132.98,
      "end_seconds": 143.08,
      "duration_seconds": 10.1,
      "text": "Doctor, I think the last prescription for the alendronate was 35 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.97,
      "end_seconds": 148.51,
      "duration_seconds": 3.54,
      "text": "I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.57,
      "end_seconds": 153.5,
      "duration_seconds": 2.93,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.37,
      "end_seconds": 158.79,
      "duration_seconds": 4.42,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.72,
      "end_seconds": 167.44,
      "duration_seconds": 6.72,
      "text": "I have high cholesterol, for nearly five years. I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.84,
      "end_seconds": 176.55,
      "duration_seconds": 7.71,
      "text": "Alright, high cholesterol, that matches what I have here. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.13,
      "end_seconds": 190.41,
      "duration_seconds": 13.28,
      "text": "Plasters. I come out in... well, a red itchy rash. Yes, cat fur. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.78,
      "end_seconds": 207.27,
      "duration_seconds": 2.49,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.17,
      "end_seconds": 228.7,
      "duration_seconds": 20.53,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. I'm vegetarian and have been for years. I look after my grandchildren most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.34,
      "end_seconds": 240.06,
      "duration_seconds": 2.72,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.08,
      "end_seconds": 247.58,
      "duration_seconds": 5.5,
      "text": "So, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 248.4,
      "end_seconds": 258.42,
      "duration_seconds": 10.02,
      "text": "Doctor, I've got the readings for you. Pulse is 74 beats a minute, temperature 36.4, BP is 118 over 73, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.9,
      "end_seconds": 262.85,
      "duration_seconds": 1.95,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.17,
      "end_seconds": 268.51,
      "duration_seconds": 3.34,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.2,
      "end_seconds": 277.76,
      "duration_seconds": 1.56,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.15,
      "end_seconds": 280.9,
      "duration_seconds": 1.75,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.56,
      "end_seconds": 298.93,
      "duration_seconds": 2.37,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 300.9,
      "end_seconds": 302.57,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.79,
      "end_seconds": 316.06,
      "duration_seconds": 10.27,
      "text": "Good, you can sit up again. From what you've told me and what I found, it points towards a healthy adult with no worrying findings."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 317.85,
      "end_seconds": 320.15,
      "duration_seconds": 2.3,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.76,
      "end_seconds": 357.84,
      "duration_seconds": 33.08,
      "text": "Nothing I've seen today points to an emergency. It looks like a healthy adult with no worrying findings, but I'd like to confirm. We should do a fasting sugar test for routine check. I'd like to arrange a cholesterol blood test for routine check. Keep up regular exercise and a balanced diet. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.43,
      "end_seconds": 362.71,
      "duration_seconds": 3.28,
      "text": "I'll want another look in twelve months."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 363.99,
      "end_seconds": 366.33,
      "duration_seconds": 2.34,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.32,
      "end_seconds": 374.63,
      "duration_seconds": 7.31,
      "text": "Okay, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 375.27,
      "end_seconds": 380.21,
      "duration_seconds": 4.94,
      "text": "So, I come back in twelve months. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.77,
      "end_seconds": 385.64,
      "duration_seconds": 3.87,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.26,
      "end_seconds": 390.14,
      "duration_seconds": 2.88,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.83,
      "end_seconds": 393.18,
      "duration_seconds": 1.35,
      "text": "Look after yourself."
    }
  ]
}