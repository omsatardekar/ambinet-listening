{
  "schema_version": "1.0",
  "encounter_id": "01215",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.7,
      "duration_seconds": 3.4,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.43,
      "end_seconds": 10.37,
      "duration_seconds": 3.94,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.83,
      "end_seconds": 16.07,
      "duration_seconds": 4.24,
      "text": "It's sharp pain when I breathe in, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.06,
      "end_seconds": 23.07,
      "duration_seconds": 2.01,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.01,
      "end_seconds": 26.68,
      "duration_seconds": 2.67,
      "text": "I'd say every other day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.44,
      "end_seconds": 31.84,
      "duration_seconds": 3.4,
      "text": "Have you been coughing up a little blood?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.5,
      "end_seconds": 33.98,
      "duration_seconds": 1.48,
      "text": "Yes, since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.61,
      "end_seconds": 42.52,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.18,
      "end_seconds": 50.29,
      "duration_seconds": 3.11,
      "text": "Okay, so I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.44,
      "end_seconds": 58.6,
      "duration_seconds": 3.16,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.52,
      "end_seconds": 73.97,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.74,
      "end_seconds": 95.55,
      "duration_seconds": 8.81,
      "text": "Okay: temp 36.7 degrees, respiratory rate 24, oxygen saturation is 90 percent, BP is 135 over 82, pulse 101."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.61,
      "end_seconds": 99.83,
      "duration_seconds": 2.22,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.11,
      "end_seconds": 105.65,
      "duration_seconds": 4.54,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.41,
      "end_seconds": 112.46,
      "duration_seconds": 4.05,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.45,
      "end_seconds": 116.97,
      "duration_seconds": 2.52,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.17,
      "end_seconds": 133.48,
      "duration_seconds": 6.31,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.03,
      "end_seconds": 141.41,
      "duration_seconds": 2.38,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.75,
      "end_seconds": 155.77,
      "duration_seconds": 4.02,
      "text": "A few quick ones: chest tightness, fever or wheeze?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.94,
      "end_seconds": 161.74,
      "duration_seconds": 4.8,
      "text": "No chest tightness, fever or wheeze, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.11,
      "end_seconds": 165.36,
      "duration_seconds": 3.25,
      "text": "Yes. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.46,
      "end_seconds": 167.98,
      "duration_seconds": 1.52,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.23,
      "end_seconds": 175.01,
      "duration_seconds": 3.78,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.35,
      "end_seconds": 177.76,
      "duration_seconds": 1.41,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.79,
      "end_seconds": 182.21,
      "duration_seconds": 3.42,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.32,
      "end_seconds": 187.91,
      "duration_seconds": 4.59,
      "text": "Yes, diabetes. I've had migraines for nearly five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.09,
      "end_seconds": 200.88,
      "duration_seconds": 8.79,
      "text": "Alright, diabetes, that matches what I have here. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.57,
      "end_seconds": 218.38,
      "duration_seconds": 16.81,
      "text": "I only drink at family occasions. No, I've never smoked in my life. Lots of rice, lentils and some fruit. Not much, I mostly stay in these days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.24,
      "end_seconds": 225.02,
      "duration_seconds": 2.78,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.06,
      "end_seconds": 242.53,
      "duration_seconds": 15.47,
      "text": "I, I take sitagliptin, 100 milligrams, once a day for my sugar. Though honestly, um, some days I forget to take it. Sumatriptan, when needed for my migraines."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.51,
      "end_seconds": 245.47,
      "duration_seconds": 1.96,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.39,
      "end_seconds": 252.12,
      "duration_seconds": 4.73,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.42,
      "end_seconds": 256.71,
      "duration_seconds": 3.29,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.63,
      "end_seconds": 261.04,
      "duration_seconds": 2.41,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.48,
      "end_seconds": 277.55,
      "duration_seconds": 4.07,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.43,
      "end_seconds": 280.9,
      "duration_seconds": 2.47,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.25,
      "end_seconds": 315.54,
      "duration_seconds": 26.29,
      "text": "Taking everything into account, I don't have a clear answer today: a possible blood clot in the lung is possible, and so is a chest infection. A CT scan of the chest is what I'd like next, for breathlessness. You need to go to hospital now for a scan. I think the medical team should see you too."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.49,
      "end_seconds": 319.45,
      "duration_seconds": 2.96,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.37,
      "end_seconds": 326.24,
      "duration_seconds": 4.87,
      "text": "I'd like you back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.82,
      "end_seconds": 330.16,
      "duration_seconds": 3.34,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}