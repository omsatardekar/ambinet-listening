{
  "schema_version": "1.0",
  "encounter_id": "01061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.49,
      "duration_seconds": 2.86,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.39,
      "end_seconds": 6.47,
      "duration_seconds": 1.08,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.1,
      "end_seconds": 17.16,
      "duration_seconds": 7.06,
      "text": "Hmm, uh, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.39,
      "end_seconds": 20.8,
      "duration_seconds": 2.41,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.04,
      "end_seconds": 30.48,
      "duration_seconds": 6.44,
      "text": "Doctor, it's burning when I pass urine. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.36,
      "end_seconds": 38.38,
      "duration_seconds": 7.02,
      "text": "What's the timeline, when did it begin? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.8,
      "end_seconds": 47.97,
      "duration_seconds": 8.17,
      "text": "Hmm, about... well, one week. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.48,
      "end_seconds": 49.22,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.83,
      "end_seconds": 67.95,
      "duration_seconds": 18.12,
      "text": "Ah, you know, and I've been going to the toilet often as well, since yesterday. I did have a dull ache low in my tummy at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.79,
      "end_seconds": 77.22,
      "duration_seconds": 7.43,
      "text": "Have you had burning when you pass urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.38,
      "end_seconds": 92.65,
      "duration_seconds": 9.27,
      "text": "Actually, you know, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.84,
      "end_seconds": 96.39,
      "duration_seconds": 2.55,
      "text": "Has there been any back pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.37,
      "end_seconds": 102.2,
      "duration_seconds": 4.83,
      "text": "Let me think, no, I haven't had any back pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.74,
      "end_seconds": 109.73,
      "duration_seconds": 6.99,
      "text": "Mm-hmm. Okay, have you noticed blood in the urine, vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.02,
      "end_seconds": 113.26,
      "duration_seconds": 2.24,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.11,
      "end_seconds": 119.08,
      "duration_seconds": 3.97,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 122.13,
      "duration_seconds": 2.46,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 127.18,
      "duration_seconds": 3.54,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.24,
      "end_seconds": 134.41,
      "duration_seconds": 3.17,
      "text": "No, um, nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.26,
      "end_seconds": 151.74,
      "duration_seconds": 2.48,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.53,
      "end_seconds": 159.39,
      "duration_seconds": 6.86,
      "text": "I have high cholesterol. I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.15,
      "end_seconds": 171.66,
      "duration_seconds": 10.51,
      "text": "Sure. Yes, high cholesterol is known to us, good to have that clear. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.39,
      "end_seconds": 182.44,
      "duration_seconds": 9.05,
      "text": "Okay, so yes, wheat. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.89,
      "end_seconds": 187.07,
      "duration_seconds": 3.18,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.9,
      "end_seconds": 196.21,
      "duration_seconds": 7.31,
      "text": "I take atorvastatin, 20 milligrams, at night. Ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.98,
      "end_seconds": 201.19,
      "duration_seconds": 4.21,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.66,
      "end_seconds": 206.4,
      "duration_seconds": 3.74,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.02,
      "end_seconds": 218.05,
      "duration_seconds": 2.03,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.81,
      "end_seconds": 221.56,
      "duration_seconds": 2.75,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.41,
      "end_seconds": 224.62,
      "duration_seconds": 1.21,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.24,
      "end_seconds": 229.44,
      "duration_seconds": 3.2,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.7,
      "end_seconds": 232.94,
      "duration_seconds": 2.24,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.51,
      "end_seconds": 237.83,
      "duration_seconds": 4.32,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.77,
      "end_seconds": 244.01,
      "duration_seconds": 4.24,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.63,
      "end_seconds": 249.45,
      "duration_seconds": 3.82,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.61,
      "end_seconds": 254.27,
      "duration_seconds": 3.66,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.88,
      "end_seconds": 257.68,
      "duration_seconds": 1.8,
      "text": "Okay, nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.92,
      "end_seconds": 270.08,
      "duration_seconds": 5.16,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.72,
      "end_seconds": 274.4,
      "duration_seconds": 1.68,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.61,
      "end_seconds": 315.76,
      "duration_seconds": 29.15,
      "text": "Okay, thinking it through, I'm honestly not certain yet. It could be an uncomplicated urinary infection, or it might be vaginal irritation. I'll request a urine dipstick, it'll help with burning urine. Let's use nitrofurantoin, 100 milligrams, twice a day, three days. You take it by mouth. That should help with urinary infection. Drink plenty of water and avoid holding urine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.25,
      "end_seconds": 326.28,
      "duration_seconds": 8.03,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 327.73,
      "end_seconds": 330.47,
      "duration_seconds": 2.74,
      "text": "Ah, thank you, that's clear."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.22,
      "end_seconds": 340.81,
      "duration_seconds": 9.59,
      "text": "Let's plan a check if it is not better in three days. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.49,
      "end_seconds": 345.97,
      "duration_seconds": 3.48,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.15,
      "end_seconds": 348.42,
      "duration_seconds": 1.27,
      "text": "Goodbye for now."
    }
  ]
}