{
  "schema_version": "1.0",
  "encounter_id": "01354",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 6.2,
      "duration_seconds": 5.0,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.86,
      "end_seconds": 11.71,
      "duration_seconds": 3.85,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.72,
      "end_seconds": 18.18,
      "duration_seconds": 5.46,
      "text": "Um, so... severe lower back pain. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.5,
      "end_seconds": 22.15,
      "duration_seconds": 2.65,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.7,
      "end_seconds": 35.72,
      "duration_seconds": 3.02,
      "text": "That's it, just a a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.36,
      "end_seconds": 61.51,
      "duration_seconds": 11.15,
      "text": "Okay: pressure 114 over 75, pulse 82. And And SpO2 99 percent on room air, temp 36.4 degrees. How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.29,
      "end_seconds": 66.98,
      "duration_seconds": 3.69,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.55,
      "end_seconds": 76.65,
      "duration_seconds": 8.1,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.21,
      "end_seconds": 112.39,
      "duration_seconds": 35.18,
      "text": "Yes, bending. That makes it worse. A four out of ten, I suppose. It happens on and off. As for trouble passing urine, I honestly can't say when that began. It might have been last month or the month before. And, And numbness between my legs, too. As for numbness between my legs, maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.34,
      "end_seconds": 115.77,
      "duration_seconds": 2.43,
      "text": "Any recent fall or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.34,
      "end_seconds": 119.43,
      "duration_seconds": 3.09,
      "text": "None of those, uh, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.24,
      "end_seconds": 123.03,
      "duration_seconds": 2.79,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.72,
      "end_seconds": 127.24,
      "duration_seconds": 2.52,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.09,
      "end_seconds": 131.34,
      "duration_seconds": 3.25,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.71,
      "end_seconds": 134.31,
      "duration_seconds": 1.6,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.08,
      "end_seconds": 138.34,
      "duration_seconds": 2.26,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.21,
      "end_seconds": 144.64,
      "duration_seconds": 5.43,
      "text": "Yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.82,
      "end_seconds": 151.0,
      "duration_seconds": 5.18,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.5,
      "end_seconds": 156.38,
      "duration_seconds": 3.88,
      "text": "It's sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.63,
      "end_seconds": 158.84,
      "duration_seconds": 1.21,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.27,
      "end_seconds": 162.39,
      "duration_seconds": 2.12,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.81,
      "end_seconds": 168.07,
      "duration_seconds": 4.26,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.8,
      "end_seconds": 172.9,
      "duration_seconds": 3.1,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.51,
      "end_seconds": 185.9,
      "duration_seconds": 2.39,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.02,
      "end_seconds": 195.12,
      "duration_seconds": 8.1,
      "text": "I've had diabetes for five years now. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.18,
      "end_seconds": 204.58,
      "duration_seconds": 7.4,
      "text": "Alright, diabetes, that matches what I have here. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.28,
      "end_seconds": 207.93,
      "duration_seconds": 2.65,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.05,
      "end_seconds": 214.48,
      "duration_seconds": 5.43,
      "text": "Let's talk a a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.09,
      "end_seconds": 226.88,
      "duration_seconds": 10.79,
      "text": "I look after my grandchildren most days. I swim twice a week. I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.33,
      "end_seconds": 231.2,
      "duration_seconds": 2.87,
      "text": "let's move on to the examination"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.46,
      "end_seconds": 235.05,
      "duration_seconds": 2.59,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.7,
      "end_seconds": 251.44,
      "duration_seconds": 5.74,
      "text": "you have numbness in the saddle area and your leg strength is reduced"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.12,
      "end_seconds": 259.65,
      "duration_seconds": 2.53,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.24,
      "end_seconds": 304.92,
      "duration_seconds": 35.68,
      "text": "Let me tell you where I've got to. My working impression is possible cauda equina syndrome needing an urgent scan. The reason I say that is that your story and my examination fit together. It could also be a large disc prolapse, so we'll keep that open. We should do an urgent MRI of the spine for possible cauda equina. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 305.9,
      "end_seconds": 310.5,
      "duration_seconds": 4.6,
      "text": "We have a slot Friday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.3,
      "end_seconds": 312.22,
      "duration_seconds": 0.92,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.36,
      "end_seconds": 319.66,
      "duration_seconds": 6.3,
      "text": "You need to go to hospital now for an emergency scan. Let's review you straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.35,
      "end_seconds": 323.6,
      "duration_seconds": 2.25,
      "text": "good, I'll return then"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.17,
      "end_seconds": 328.66,
      "duration_seconds": 4.49,
      "text": "is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.18,
      "end_seconds": 331.75,
      "duration_seconds": 1.57,
      "text": "That's clear, thanks."
    }
  ]
}