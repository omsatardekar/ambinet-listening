{
  "schema_version": "1.0",
  "encounter_id": "01128",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.23,
      "duration_seconds": 3.26,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.88,
      "end_seconds": 9.38,
      "duration_seconds": 4.5,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.38,
      "end_seconds": 14.96,
      "duration_seconds": 4.58,
      "text": "I wanted to get being very thirsty looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.89,
      "end_seconds": 21.78,
      "duration_seconds": 4.89,
      "text": "Since when exactly? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.88,
      "end_seconds": 36.77,
      "duration_seconds": 13.89,
      "text": "I've had it since last Tuesday. As for passing a lot of urine, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.81,
      "end_seconds": 41.56,
      "duration_seconds": 2.75,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.22,
      "end_seconds": 43.79,
      "duration_seconds": 1.57,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.18,
      "end_seconds": 49.07,
      "duration_seconds": 3.89,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.38,
      "end_seconds": 57.74,
      "duration_seconds": 2.36,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.02,
      "end_seconds": 60.32,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.31,
      "end_seconds": 62.78,
      "duration_seconds": 1.47,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.73,
      "end_seconds": 66.32,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.37,
      "end_seconds": 71.11,
      "duration_seconds": 3.74,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.1,
      "end_seconds": 74.36,
      "duration_seconds": 1.26,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.99,
      "end_seconds": 78.37,
      "duration_seconds": 3.38,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.66,
      "end_seconds": 81.7,
      "duration_seconds": 2.04,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.4,
      "end_seconds": 86.35,
      "duration_seconds": 3.95,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.84,
      "end_seconds": 91.35,
      "duration_seconds": 3.51,
      "text": "Okay, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.03,
      "end_seconds": 95.84,
      "duration_seconds": 3.81,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.06,
      "end_seconds": 108.12,
      "duration_seconds": 3.06,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.0,
      "end_seconds": 112.84,
      "duration_seconds": 2.84,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.38,
      "end_seconds": 118.25,
      "duration_seconds": 3.87,
      "text": "Have you had any chest pain or cough?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.58,
      "end_seconds": 123.34,
      "duration_seconds": 3.76,
      "text": "I haven't had chest pain or cough, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.25,
      "end_seconds": 128.67,
      "duration_seconds": 3.42,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.38,
      "end_seconds": 135.34,
      "duration_seconds": 4.96,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.64,
      "end_seconds": 139.6,
      "duration_seconds": 2.96,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.53,
      "end_seconds": 145.63,
      "duration_seconds": 4.1,
      "text": "Erm, you know, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.55,
      "end_seconds": 157.67,
      "duration_seconds": 2.12,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 167.21,
      "duration_seconds": 2.18,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.81,
      "end_seconds": 193.77,
      "duration_seconds": 7.96,
      "text": "Okay: respiratory rate 18, heart rate 105, pressure 114 over 73. And oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.74,
      "end_seconds": 201.12,
      "duration_seconds": 5.38,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.73,
      "end_seconds": 205.34,
      "duration_seconds": 2.61,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.93,
      "end_seconds": 228.93,
      "duration_seconds": 5.0,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.14,
      "end_seconds": 249.86,
      "duration_seconds": 18.72,
      "text": "Okay, that's enough for me. From what you've told me and what I found, it points towards diabetic ketoacidosis. I want to be honest that this is an impression, not a final answer. We shouldn't forget a severe infection."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.34,
      "end_seconds": 255.5,
      "duration_seconds": 4.16,
      "text": "Let me think, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.18,
      "end_seconds": 264.36,
      "duration_seconds": 7.18,
      "text": "I can't promise yet, but most people with diabetic ketoacidosis do well once it's treated properly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.97,
      "end_seconds": 293.9,
      "duration_seconds": 21.93,
      "text": "We should do a blood sugar and ketone test for thirst and vomiting. I think blood gas and electrolytes makes sense here, for DKA. You need to go to hospital now for insulin and fluids. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.46,
      "end_seconds": 295.16,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.8,
      "end_seconds": 300.31,
      "duration_seconds": 3.51,
      "text": "I'd like to see you again straight away."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.03,
      "end_seconds": 303.32,
      "duration_seconds": 2.29,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 309.85,
      "duration_seconds": 5.16,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.39,
      "end_seconds": 315.43,
      "duration_seconds": 4.04,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}