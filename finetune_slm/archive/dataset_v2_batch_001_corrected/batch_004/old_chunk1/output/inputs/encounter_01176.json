{
  "schema_version": "1.0",
  "encounter_id": "01176",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.48,
      "duration_seconds": 4.62,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 10.01,
      "duration_seconds": 3.89,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.68,
      "end_seconds": 17.35,
      "duration_seconds": 6.67,
      "text": "Doctor, it's shaking chills and a high temperature. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.25,
      "end_seconds": 21.38,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.99,
      "end_seconds": 26.2,
      "duration_seconds": 3.21,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.26,
      "end_seconds": 30.13,
      "duration_seconds": 2.87,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.74,
      "end_seconds": 32.65,
      "duration_seconds": 1.91,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.09,
      "end_seconds": 37.89,
      "duration_seconds": 3.8,
      "text": "What about very little urine, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.33,
      "end_seconds": 42.59,
      "duration_seconds": 3.26,
      "text": "Yes, about the same, three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.03,
      "end_seconds": 47.49,
      "duration_seconds": 3.46,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.53,
      "end_seconds": 49.67,
      "duration_seconds": 1.14,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.99,
      "end_seconds": 57.75,
      "duration_seconds": 6.76,
      "text": "Have you had shaking chills and a high temperature before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.27,
      "end_seconds": 66.72,
      "duration_seconds": 7.45,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.3,
      "end_seconds": 70.65,
      "duration_seconds": 3.35,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.87,
      "end_seconds": 80.23,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.75,
      "end_seconds": 101.78,
      "duration_seconds": 8.03,
      "text": "Okay: heart rate 97, respiratory rate 18, temp 39.3 degrees. And blood pressure 124 over 75."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.34,
      "end_seconds": 106.73,
      "duration_seconds": 3.39,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.64,
      "end_seconds": 109.08,
      "duration_seconds": 1.44,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.04,
      "end_seconds": 135.91,
      "duration_seconds": 7.87,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.4,
      "end_seconds": 141.62,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.65,
      "end_seconds": 153.63,
      "duration_seconds": 2.98,
      "text": "Any rash, stiff neck or chest pain?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.49,
      "end_seconds": 161.01,
      "duration_seconds": 5.52,
      "text": "I haven't had rash, stiff neck or chest pain, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.53,
      "end_seconds": 163.19,
      "duration_seconds": 1.66,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.67,
      "end_seconds": 166.15,
      "duration_seconds": 1.48,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.56,
      "end_seconds": 169.58,
      "duration_seconds": 2.02,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.43,
      "end_seconds": 172.92,
      "duration_seconds": 2.49,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.93,
      "end_seconds": 176.25,
      "duration_seconds": 2.32,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.22,
      "end_seconds": 179.96,
      "duration_seconds": 2.74,
      "text": "Heart failure, for five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.01,
      "end_seconds": 183.97,
      "duration_seconds": 2.96,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.57,
      "end_seconds": 198.46,
      "duration_seconds": 9.89,
      "text": "I've had arthritis in my knees, yes. I told my wife I'd come today. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.42,
      "end_seconds": 206.95,
      "duration_seconds": 6.53,
      "text": "Alright, heart failure, that matches what I have here. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.97,
      "end_seconds": 219.15,
      "duration_seconds": 7.18,
      "text": "Spironolactone, 25 milligrams, once a day. I take diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.24,
      "end_seconds": 222.59,
      "duration_seconds": 2.35,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.1,
      "end_seconds": 232.74,
      "duration_seconds": 8.64,
      "text": "I only drink at family occasions. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.23,
      "end_seconds": 252.67,
      "duration_seconds": 11.44,
      "text": "So where does that leave us? I'd lean towards possible sepsis needing urgent treatment. It could also be a severe urine or chest infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.94,
      "end_seconds": 285.07,
      "duration_seconds": 17.13,
      "text": "Let's get lactate and blood tests, for sepsis. Let's get a chest X-ray, for fever. I want to admit you to hospital now for fluids and antibiotics. I'll also refer you to the emergency team."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.12,
      "end_seconds": 288.6,
      "duration_seconds": 2.48,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.4,
      "end_seconds": 295.92,
      "duration_seconds": 6.52,
      "text": "Please don't wait if you cannot be brought in today. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.27,
      "end_seconds": 298.81,
      "duration_seconds": 1.54,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.78,
      "end_seconds": 306.11,
      "duration_seconds": 3.33,
      "text": "Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.1,
      "end_seconds": 310.1,
      "duration_seconds": 3.0,
      "text": "Great, thank you for your help."
    }
  ]
}