    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.19,
      "end_seconds": 229.44,
      "duration_seconds": 5.25,
      "text": "let me check a few things. Any feeling cold or constipation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.9,
      "end_seconds": 236.36,
      "duration_seconds": 3.46,
      "text": "mm, no, none that I've noticed"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.45,
      "end_seconds": 240.72,
      "duration_seconds": 3.27,
      "text": "Did you get palpitations or weight change?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.58,
      "end_seconds": 247.45,
      "duration_seconds": 4.87,
      "text": "no palpitations or weight change, none of it it"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.81,
      "end_seconds": 252.62,
      "duration_seconds": 3.81,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.57,
      "end_seconds": 255.82,
      "duration_seconds": 2.25,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.75,
      "end_seconds": 262.66,
      "duration_seconds": 4.91,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.64,
      "end_seconds": 274.78,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.53,
      "end_seconds": 306.06,
      "duration_seconds": 9.53,
      "text": "Okay: temperature is 36.6 degrees, oxygen saturation is 98 percent, pressure 111 over 76. And heart rate 80."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.01,
      "end_seconds": 311.08,
      "duration_seconds": 2.07,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.79,
      "end_seconds": 313.02,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.3,
      "end_seconds": 318.15,
      "duration_seconds": 3.85,
      "text": "Okay, take a a deep breath for me."
