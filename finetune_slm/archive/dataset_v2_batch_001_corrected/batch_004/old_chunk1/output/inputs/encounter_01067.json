    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.13,
      "end_seconds": 36.26,
      "duration_seconds": 3.13,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.44,
      "end_seconds": 40.42,
      "duration_seconds": 2.98,
      "text": "ever since... since last Tuesday, really"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.47,
      "end_seconds": 45.19,
      "duration_seconds": 2.72,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.26,
      "end_seconds": 56.18,
      "duration_seconds": 8.92,
      "text": "It usually comes with slightly dry skin. The slightly dry skin? That's been for two days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.81,
      "end_seconds": 62.22,
      "duration_seconds": 4.41,
      "text": "have you been feeling well at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.65,
      "end_seconds": 68.45,
      "duration_seconds": 4.8,
      "text": "I had a similar thing last year. It went away"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.05,
      "end_seconds": 72.41,
      "duration_seconds": 2.36,
      "text": "have you got any known allergies?"
