    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.94,
      "end_seconds": 84.06,
      "duration_seconds": 10.12,
      "text": "right I think I reacted to some antibiotic once years ago i don't remember which one or what happened exactly"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.68,
      "end_seconds": 89.64,
      "duration_seconds": 3.96,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.75,
      "end_seconds": 93.09,
      "duration_seconds": 2.34,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.9,
      "end_seconds": 95.6,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.52,
      "end_seconds": 104.78,
      "duration_seconds": 7.26,
      "text": "Acid reflux, for five years i've, I've had anxiety for two years now"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.85,
      "end_seconds": 112.26,
      "duration_seconds": 6.41,
      "text": "right, so acid reflux is already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.64,
      "end_seconds": 125.01,
      "duration_seconds": 2.37,
      "text": "do you work outside the home?"
