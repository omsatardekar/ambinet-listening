    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.21,
      "end_seconds": 192.24,
      "duration_seconds": 6.03,
      "text": "I take omeprazole 20 milligrams once a day for the reflux"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.57,
      "end_seconds": 197.69,
      "duration_seconds": 5.12,
      "text": "right, right so, did you ever have any procedures done?"
