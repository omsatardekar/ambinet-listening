    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.75,
      "end_seconds": 31.3,
      "duration_seconds": 6.55,
      "text": "It's been feeling well, doctor. He didn't wanna come, but I insisted."
