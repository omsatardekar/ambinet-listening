    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.31,
      "end_seconds": 176.81,
      "duration_seconds": 3.5,
      "text": "I'm on Thyronorm, 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 177.66,
      "end_seconds": 184.11,
      "duration_seconds": 6.45,
      "text": "that's what's prescribed but I'm not sure he takes it every day"
