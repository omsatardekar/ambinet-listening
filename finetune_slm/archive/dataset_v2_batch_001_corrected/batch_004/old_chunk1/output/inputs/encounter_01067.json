    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.26,
      "end_seconds": 19.56,
      "duration_seconds": 3.3,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.45,
      "end_seconds": 23.97,
      "duration_seconds": 2.52,
      "text": "Absolutely come and sit beside them."
