      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.93,
      "end_seconds": 371.19,
      "duration_seconds": 17.26,
      "text": "It's reasonable to be concerned, but right now well-controlled thyroid replacement is my leading thought, not anything worse. I'm sending you for a thyroid blood test cos of annual review. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.37,
      "end_seconds": 375.16,
      "duration_seconds": 2.79,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.61,
      "end_seconds": 381.16,
      "duration_seconds": 4.55,
      "text": "okay, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.13,
