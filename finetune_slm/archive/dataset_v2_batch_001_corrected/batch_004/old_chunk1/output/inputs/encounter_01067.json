    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.72,
      "end_seconds": 132.94,
      "duration_seconds": 4.22,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.37,
      "end_seconds": 135.55,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.37,
      "end_seconds": 139.43,
      "duration_seconds": 3.06,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.23,
      "end_seconds": 160.45,
      "duration_seconds": 5.22,
      "text": "right, any inherited conditions that you know of in the the family?"
