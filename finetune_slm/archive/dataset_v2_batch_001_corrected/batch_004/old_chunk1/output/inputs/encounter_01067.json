    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.48,
      "end_seconds": 337.87,
      "duration_seconds": 5.39,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.72,
      "end_seconds": 348.98,
      "duration_seconds": 8.26,
      "text": "you can relax now. From what you've told me and what I found, this is probably well-controlled thyroid replacement"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.97,
      "end_seconds": 352.2,
      "duration_seconds": 2.23,
      "text": "Is it dangerous doctor?"
