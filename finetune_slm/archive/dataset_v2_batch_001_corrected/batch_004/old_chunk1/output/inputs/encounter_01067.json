      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 207.6,
      "duration_seconds": 7.83,
      "text": "I had keyhole surgery on my gallbladder two years back sorry, I know I'm rambling a bit"
