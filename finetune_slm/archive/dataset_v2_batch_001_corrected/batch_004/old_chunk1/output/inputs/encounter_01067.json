    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.3,
      "end_seconds": 167.13,
      "duration_seconds": 4.83,
      "text": "My aunt has rheumatoid arthritis. My mother had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.64,
      "end_seconds": 172.08,
      "duration_seconds": 4.44,
      "text": "right, what do you take on a normal day?"
