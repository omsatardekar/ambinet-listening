{
  "schema_version": "1.0",
  "encounter_id": "01003",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 4.07,
      "duration_seconds": 3.05,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.96,
      "end_seconds": 10.44,
      "duration_seconds": 5.48,
      "text": "You're alright, take a a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.22,
      "end_seconds": 17.09,
      "duration_seconds": 5.87,
      "text": "So the thing is, I've got a dry cough in the evenings."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.67,
      "end_seconds": 20.57,
      "duration_seconds": 1.9,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.34,
      "end_seconds": 23.76,
      "duration_seconds": 2.42,
      "text": "it's been three days now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.58,
      "end_seconds": 37.03,
      "duration_seconds": 11.45,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.31,
      "end_seconds": 46.64,
      "duration_seconds": 4.33,
      "text": "it's worse with pollen season i'd say moderate"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.39,
      "end_seconds": 49.41,
      "duration_seconds": 2.02,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.21,
      "end_seconds": 68.74,
      "duration_seconds": 15.53,
      "text": "Itchy eyes goes along with it, most of the time. The Itchy eyes? That's been since Monday. As for Itchy eyes, moderate, really. I notice it more with outdoors."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.67,
      "end_seconds": 73.27,
      "duration_seconds": 2.6,
      "text": "and what about wheeze or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.21,
      "end_seconds": 78.3,
      "duration_seconds": 4.09,
      "text": "I haven't had wheeze or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.5,
      "end_seconds": 85.76,
      "duration_seconds": 3.26,
      "text": "Has there been any shortness of breath?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.82,
      "end_seconds": 92.46,
      "duration_seconds": 4.64,
      "text": "No, I haven't had any shortness of breath."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.02,
      "end_seconds": 96.78,
      "duration_seconds": 3.76,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.17,
      "end_seconds": 104.16,
      "duration_seconds": 1.99,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.08,
      "end_seconds": 109.21,
      "duration_seconds": 4.13,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.7,
      "end_seconds": 112.36,
      "duration_seconds": 1.66,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.24,
      "end_seconds": 116.8,
      "duration_seconds": 3.56,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.51,
      "end_seconds": 121.37,
      "duration_seconds": 3.86,
      "text": "I had a bunion operation six years ago"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.6,
      "end_seconds": 133.77,
      "duration_seconds": 5.17,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.55,
      "end_seconds": 140.27,
      "duration_seconds": 5.72,
      "text": "I'm allergic to nickel, I get a rash on my skin."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.47,
      "end_seconds": 145.01,
      "duration_seconds": 3.54,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 154.42,
      "duration_seconds": 7.75,
      "text": "It's hydrocortisone cream, when needed for the eczema. It's loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.4,
      "end_seconds": 174.16,
      "duration_seconds": 3.76,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.0,
      "end_seconds": 185.1,
      "duration_seconds": 9.1,
      "text": "I've had eczema, yes. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.89,
      "end_seconds": 196.27,
      "duration_seconds": 10.38,
      "text": "Sure. Yes, eczema is known to us, good to have that clear. Let's talk a a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.29,
      "end_seconds": 218.92,
      "duration_seconds": 21.63,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. I'm a bus driver, so I sit for long hours. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.61,
      "end_seconds": 222.49,
      "duration_seconds": 2.88,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.66,
      "end_seconds": 232.32,
      "duration_seconds": 2.66,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.92,
      "end_seconds": 256.89,
      "duration_seconds": 8.97,
      "text": "Okay: temperature is 37.0 degrees, saturation 97 percent. And respiratory rate 18, pressure 110 over 80, heart rate 77."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.24,
      "end_seconds": 262.04,
      "duration_seconds": 3.8,
      "text": "now I'm gonna do a a short physical check"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.76,
      "end_seconds": 264.88,
      "duration_seconds": 1.12,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.24,
      "end_seconds": 268.74,
      "duration_seconds": 2.5,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.38,
      "end_seconds": 281.44,
      "duration_seconds": 5.06,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.53,
      "end_seconds": 289.08,
      "duration_seconds": 2.55,
      "text": "good, you can sit up again"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.13,
      "end_seconds": 309.06,
      "duration_seconds": 11.93,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be seasonal hay fever causing the cough, or it might be early asthma."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.17,
      "end_seconds": 313.06,
      "duration_seconds": 2.89,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.64,
      "end_seconds": 328.05,
      "duration_seconds": 14.41,
      "text": "Nothing I've seen today points to an emergency. It looks like seasonal hay fever causing the cough. Keep windows closed on high-pollen days and wash your hair at night. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.36,
      "end_seconds": 333.85,
      "duration_seconds": 4.49,
      "text": "Let me think, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.83,
      "end_seconds": 336.0,
      "duration_seconds": 1.17,
      "text": "See you soon."
    }
  ]
}