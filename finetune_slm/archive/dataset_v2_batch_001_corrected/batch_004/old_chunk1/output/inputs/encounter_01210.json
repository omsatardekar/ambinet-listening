      "role": "DOCTOR",
      "start_seconds": 266.04,
      "end_seconds": 281.01,
      "duration_seconds": 14.97,
      "text": "Let me tell you where I've got to. This looks most like a severe deep skin infection needing urgent surgery review. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.73,
      "end_seconds": 284.91,
      "duration_seconds": 2.18,
      "text": "will it clear up?"
