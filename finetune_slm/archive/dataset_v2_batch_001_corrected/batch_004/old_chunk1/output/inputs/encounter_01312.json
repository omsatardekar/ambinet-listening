{
  "schema_version": "1.0",
  "encounter_id": "01312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.93,
      "duration_seconds": 3.77,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.98,
      "end_seconds": 10.46,
      "duration_seconds": 4.48,
      "text": "yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.11,
      "end_seconds": 21.22,
      "duration_seconds": 10.11,
      "text": "I've been dealing with a dry cough in the evenings. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.74,
      "end_seconds": 25.13,
      "duration_seconds": 3.39,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.22,
      "end_seconds": 38.52,
      "duration_seconds": 8.3,
      "text": "Since last Tuesday, that's when it began i've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.13,
      "end_seconds": 51.51,
      "duration_seconds": 9.38,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.09,
      "end_seconds": 62.97,
      "duration_seconds": 10.88,
      "text": "I'd say severe. Only antihistamine, and it's not much. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.83,
      "end_seconds": 66.83,
      "duration_seconds": 2.0,
      "text": "Have you had sneezing fits?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.49,
      "end_seconds": 86.28,
      "duration_seconds": 13.79,
      "text": "Yes, about the same, two weeks. With sneezing fits, it feels moderate to me. Itchy eyes was there, uh, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.39,
      "end_seconds": 89.85,
      "duration_seconds": 2.46,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.42,
      "end_seconds": 105.9,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.48,
      "end_seconds": 136.91,
      "duration_seconds": 10.43,
      "text": "Okay: SpO2 98 percent on room air, respiratory rate 16, heart rate 81, temp 36.5 degrees, blood pressure 114 over 79."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.94,
      "end_seconds": 139.93,
      "duration_seconds": 1.99,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.0,
      "end_seconds": 144.53,
      "duration_seconds": 2.53,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.87,
      "end_seconds": 150.73,
      "duration_seconds": 4.86,
      "text": "I'll examine you in a a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.48,
      "end_seconds": 154.43,
      "duration_seconds": 1.95,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.17,
      "end_seconds": 175.06,
      "duration_seconds": 4.89,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.82,
      "end_seconds": 181.65,
      "duration_seconds": 1.83,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.21,
      "end_seconds": 195.18,
      "duration_seconds": 4.97,
      "text": "A few quick ones: shortness of breath, fever or wheeze?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.11,
      "end_seconds": 201.67,
      "duration_seconds": 4.56,
      "text": "no, no shortness of breath, fever or wheeze"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.95,
      "end_seconds": 204.29,
      "duration_seconds": 2.34,
      "text": "Understood. Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.9,
      "end_seconds": 206.31,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.21,
      "end_seconds": 210.47,
      "duration_seconds": 2.26,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.16,
      "end_seconds": 213.62,
      "duration_seconds": 2.46,
      "text": "nothing there, um, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.63,
      "end_seconds": 227.21,
      "duration_seconds": 2.58,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.27,
      "end_seconds": 232.09,
      "duration_seconds": 2.82,
      "text": "no, not that I know of"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.31,
      "end_seconds": 235.71,
      "duration_seconds": 2.4,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.0,
      "end_seconds": 239.25,
      "duration_seconds": 2.25,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.21,
      "end_seconds": 244.87,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.35,
      "end_seconds": 248.93,
      "duration_seconds": 2.58,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.21,
      "end_seconds": 252.99,
      "duration_seconds": 2.78,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.11,
      "end_seconds": 258.6,
      "duration_seconds": 4.49,
      "text": "I've had migraines, yes. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.54,
      "end_seconds": 262.11,
      "duration_seconds": 1.57,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.03,
      "end_seconds": 271.27,
      "duration_seconds": 7.24,
      "text": "Right, so arthritis in your knees is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.78,
      "end_seconds": 281.25,
      "duration_seconds": 1.47,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.14,
      "end_seconds": 286.38,
      "duration_seconds": 3.24,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.97,
      "end_seconds": 291.42,
      "duration_seconds": 3.45,
      "text": "what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.34,
      "end_seconds": 298.84,
      "duration_seconds": 6.5,
      "text": "Propranolol, 40 milligrams, twice a day. I'm on naproxen, twice a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.26,
      "end_seconds": 302.39,
      "duration_seconds": 2.13,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.67,
      "end_seconds": 308.16,
      "duration_seconds": 4.49,
      "text": "250 milligrams. It's, It's loratadine, once a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.96,
      "end_seconds": 311.76,
      "duration_seconds": 2.8,
      "text": "so, do you know the dose?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.36,
      "end_seconds": 313.42,
      "duration_seconds": 1.06,
      "text": "10 milligrams."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.69,
      "end_seconds": 318.49,
      "duration_seconds": 3.8,
      "text": "alright, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.55,
      "end_seconds": 322.92,
      "duration_seconds": 3.37,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.3,
      "end_seconds": 340.59,
      "duration_seconds": 14.29,
      "text": "let me tell you where I've got to. This is probably seasonal hay fever causing the cough. I want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.24,
      "end_seconds": 344.31,
      "duration_seconds": 2.07,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.47,
      "end_seconds": 368.84,
      "duration_seconds": 23.37,
      "text": "nothing I've seen today points to an emergency. It looks like seasonal hay fever causing the cough. The treatment will be fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever. Keep windows closed on high-pollen days and wash your hair at night. Come back in a month"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 369.75,
      "end_seconds": 373.58,
      "duration_seconds": 3.83,
      "text": "Come by reception afterwards and I'll fix the appointment."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.58,
      "end_seconds": 379.11,
      "duration_seconds": 3.53,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.19,
      "end_seconds": 383.63,
      "duration_seconds": 3.44,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.35,
      "end_seconds": 388.9,
      "duration_seconds": 3.55,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.7,
      "end_seconds": 391.16,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}