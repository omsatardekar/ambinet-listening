{
  "schema_version": "1.0",
  "encounter_id": "01148",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.1,
      "end_seconds": 6.55,
      "duration_seconds": 5.45,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.18,
      "end_seconds": 12.26,
      "duration_seconds": 4.08,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.76,
      "end_seconds": 19.9,
      "duration_seconds": 6.14,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 20.69,
      "end_seconds": 24.93,
      "duration_seconds": 4.24,
      "text": "So the thing is, I've got bloating after meals."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.99,
      "end_seconds": 32.61,
      "duration_seconds": 6.62,
      "text": "Has this been going on for long? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 51.98,
      "duration_seconds": 17.73,
      "text": "For about three months, I'd say. I've also had loose stools now and then, for three days. I did have a lot of wind at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.29,
      "end_seconds": 63.74,
      "duration_seconds": 4.45,
      "text": "Have you noticed blood in the stool or weight loss?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.28,
      "end_seconds": 66.82,
      "duration_seconds": 2.54,
      "text": "Right, nope, nothing like that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.9,
      "end_seconds": 70.64,
      "duration_seconds": 2.74,
      "text": "Have you noticed vomiting or night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.68,
      "end_seconds": 75.35,
      "duration_seconds": 2.67,
      "text": "Yeah, nope, nothing like that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.23,
      "end_seconds": 79.36,
      "duration_seconds": 3.13,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.95,
      "end_seconds": 82.66,
      "duration_seconds": 2.71,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.08,
      "end_seconds": 97.58,
      "duration_seconds": 2.5,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.34,
      "end_seconds": 103.33,
      "duration_seconds": 3.99,
      "text": "Fluoxetine, 20 milligrams, every morning for my mood."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 105.1,
      "end_seconds": 113.45,
      "duration_seconds": 8.35,
      "text": "Doctor, I think the last prescription for the fluoxetine was 40 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.63,
      "end_seconds": 119.61,
      "duration_seconds": 4.98,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.19,
      "end_seconds": 133.9,
      "duration_seconds": 12.71,
      "text": "I don't think I have it with me. Peppermint capsules. I take it after meals. I'd been on mirtazapine, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.61,
      "end_seconds": 137.78,
      "duration_seconds": 2.17,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.62,
      "end_seconds": 143.25,
      "duration_seconds": 4.63,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.18,
      "end_seconds": 146.35,
      "duration_seconds": 2.17,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.02,
      "end_seconds": 153.86,
      "duration_seconds": 5.84,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.95,
      "end_seconds": 160.31,
      "duration_seconds": 4.36,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.53,
      "end_seconds": 164.79,
      "duration_seconds": 3.26,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.78,
      "end_seconds": 170.06,
      "duration_seconds": 3.28,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.16,
      "end_seconds": 176.96,
      "duration_seconds": 4.8,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.52,
      "end_seconds": 181.33,
      "duration_seconds": 2.81,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.69,
      "end_seconds": 185.64,
      "duration_seconds": 2.95,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.01,
      "end_seconds": 193.12,
      "duration_seconds": 3.11,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.79,
      "end_seconds": 195.14,
      "duration_seconds": 1.35,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.13,
      "end_seconds": 197.83,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.76,
      "end_seconds": 201.03,
      "duration_seconds": 2.27,
      "text": "I've had depression, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.4,
      "end_seconds": 203.1,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 220.74,
      "end_seconds": 232.53,
      "duration_seconds": 11.79,
      "text": "Here are the numbers, doctor. Temp 36.8 degrees, BP is 122 over 70, SpO2 99 percent on room air, pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.53,
      "end_seconds": 235.23,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.3,
      "end_seconds": 240.61,
      "duration_seconds": 4.31,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.6,
      "end_seconds": 242.69,
      "duration_seconds": 1.09,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.21,
      "end_seconds": 246.23,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.26,
      "end_seconds": 259.31,
      "duration_seconds": 6.05,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.01,
      "end_seconds": 275.42,
      "duration_seconds": 12.41,
      "text": "That's the examination finished. Taking everything into account, I'd lean towards a functional bowel pattern, with no alarm features. I'd also keep irritable bowel syndrome in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 276.36,
      "end_seconds": 280.08,
      "duration_seconds": 3.72,
      "text": "Hmm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.72,
      "end_seconds": 300.13,
      "duration_seconds": 19.41,
      "text": "It's reasonable to be concerned, but right now a functional bowel pattern, with no alarm features is my leading thought, not anything worse. So, to recap quickly. You've had bloating after meals for about three months, and no night-time diarrhoea or weight loss."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.5,
      "end_seconds": 303.1,
      "duration_seconds": 1.6,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.66,
      "end_seconds": 336.71,
      "duration_seconds": 33.05,
      "text": "I'd like to arrange a coeliac blood test for bloating. Try smaller meals and keep a food and symptom diary for four weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and if you see blood in the stool or lose weight, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 339.85,
      "end_seconds": 342.56,
      "duration_seconds": 2.71,
      "text": "Alright, you know, I follow."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.55,
      "end_seconds": 347.12,
      "duration_seconds": 2.57,
      "text": "Let's review you in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 347.83,
      "end_seconds": 348.53,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.35,
      "end_seconds": 354.69,
      "duration_seconds": 4.34,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 355.92,
      "end_seconds": 359.44,
      "duration_seconds": 3.52,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}