{
  "schema_version": "1.0",
  "encounter_id": "01466",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.95,
      "end_seconds": 5.93,
      "duration_seconds": 4.98,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 10.43,
      "duration_seconds": 3.52,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.58,
      "end_seconds": 15.88,
      "duration_seconds": 4.3,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.91,
      "end_seconds": 20.91,
      "duration_seconds": 4.0,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.25,
      "end_seconds": 28.43,
      "duration_seconds": 6.18,
      "text": "Yeah, it's severe lower back pain. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.33,
      "end_seconds": 33.61,
      "duration_seconds": 3.28,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.41,
      "end_seconds": 38.24,
      "duration_seconds": 2.83,
      "text": "It's been like this since Monday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.27,
      "end_seconds": 48.9,
      "duration_seconds": 8.63,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.73,
      "end_seconds": 59.08,
      "duration_seconds": 8.35,
      "text": "It comes and goes. I'd give it a five, out of ten. Bending definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.77,
      "end_seconds": 65.29,
      "duration_seconds": 5.52,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 65.39,
      "end_seconds": 72.45,
      "duration_seconds": 7.06,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.84,
      "end_seconds": 76.12,
      "duration_seconds": 2.28,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 77.96,
      "end_seconds": 106.25,
      "duration_seconds": 28.29,
      "text": "I've also had numbness between my legs, for three weeks. And trouble passing urine as well, since Monday. With trouble passing urine, pretty severe, if I'm being honest. As for weakness in both legs, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.84,
      "end_seconds": 113.91,
      "duration_seconds": 6.07,
      "text": "Have you had severe lower back pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.19,
      "end_seconds": 120.77,
      "duration_seconds": 5.58,
      "text": "Um, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.77,
      "end_seconds": 132.56,
      "duration_seconds": 2.79,
      "text": "Did you get recent fall or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.94,
      "end_seconds": 138.42,
      "duration_seconds": 4.48,
      "text": "No recent fall or fever, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 141.67,
      "duration_seconds": 2.21,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.54,
      "end_seconds": 144.93,
      "duration_seconds": 2.39,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.31,
      "end_seconds": 148.89,
      "duration_seconds": 2.58,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.81,
      "end_seconds": 153.44,
      "duration_seconds": 3.63,
      "text": "Um, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.68,
      "end_seconds": 162.73,
      "duration_seconds": 4.05,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.69,
      "end_seconds": 175.2,
      "duration_seconds": 11.51,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.52,
      "end_seconds": 183.4,
      "duration_seconds": 0.88,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.39,
      "end_seconds": 188.69,
      "duration_seconds": 3.3,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.38,
      "end_seconds": 192.33,
      "duration_seconds": 1.95,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.15,
      "end_seconds": 199.91,
      "duration_seconds": 5.76,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.84,
      "end_seconds": 203.0,
      "duration_seconds": 2.16,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.46,
      "end_seconds": 212.53,
      "duration_seconds": 5.07,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.16,
      "end_seconds": 215.42,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.12,
      "end_seconds": 219.12,
      "duration_seconds": 2.0,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.19,
      "end_seconds": 225.13,
      "duration_seconds": 4.94,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 226.25,
      "end_seconds": 233.45,
      "duration_seconds": 7.2,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.23,
      "end_seconds": 237.61,
      "duration_seconds": 2.38,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.81,
      "end_seconds": 260.58,
      "duration_seconds": 21.77,
      "text": "For the anxiety, I believe. My son sets them out for me, I just take what I'm given. It's Seretide inhaler, twice a day for my asthma. I take lansoprazole, 30 milligrams, maybe, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.7,
      "end_seconds": 265.29,
      "duration_seconds": 3.59,
      "text": "Alright, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.12,
      "end_seconds": 271.05,
      "duration_seconds": 3.93,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.04,
      "end_seconds": 281.88,
      "duration_seconds": 8.84,
      "text": "Anything in your past medical history I should know? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.96,
      "end_seconds": 296.62,
      "duration_seconds": 9.66,
      "text": "I've got anxiety. I'd rather not end up on lots of tablets if I can avoid it. I've had asthma, yes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.18,
      "end_seconds": 298.05,
      "duration_seconds": 0.87,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 299.72,
      "end_seconds": 303.22,
      "duration_seconds": 3.5,
      "text": "Acid reflux, for about a year."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.53,
      "end_seconds": 309.26,
      "duration_seconds": 2.73,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.79,
      "end_seconds": 318.65,
      "duration_seconds": 7.86,
      "text": "Yes, acid reflux is known to us, good to have that clear. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 319.82,
      "end_seconds": 323.98,
      "duration_seconds": 4.16,
      "text": "My brother has epilepsy. My son has asthma."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 325.9,
      "end_seconds": 339.35,
      "duration_seconds": 13.45,
      "text": "Doctor, I've got the readings for you. Temperature is 36.7 degrees, respiratory rate 17, pressure 126 over 80. Oxygen saturation is 97 percent, pulse is 79 beats a minute."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.92,
      "end_seconds": 341.62,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.3,
      "end_seconds": 348.47,
      "duration_seconds": 4.17,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.21,
      "end_seconds": 352.56,
      "duration_seconds": 2.35,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.88,
      "end_seconds": 377.19,
      "duration_seconds": 6.31,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 377.77,
      "end_seconds": 379.35,
      "duration_seconds": 1.58,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.55,
      "end_seconds": 407.28,
      "duration_seconds": 25.73,
      "text": "That's all I needed to check. Right, here's what I'm thinking. The most likely explanation is possible cauda equina syndrome needing an urgent scan. It could also be a large disc prolapse, so we'll keep that open. I think an urgent MRI of the spine makes sense here, for possible cauda equina."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 408.83,
      "end_seconds": 413.32,
      "duration_seconds": 4.49,
      "text": "We have a slot Tuesday at 2 pm, if that works."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.29,
      "end_seconds": 417.62,
      "duration_seconds": 2.33,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.59,
      "end_seconds": 444.03,
      "duration_seconds": 23.44,
      "text": "You need to go to hospital now for an emergency scan. I'm going to send a referral to the spinal team. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the numbness spreads, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 446.03,
      "end_seconds": 447.99,
      "duration_seconds": 1.96,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.75,
      "end_seconds": 454.89,
      "duration_seconds": 5.14,
      "text": "We'll catch up straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 455.72,
      "end_seconds": 457.76,
      "duration_seconds": 2.04,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 459.47,
      "end_seconds": 460.84,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}