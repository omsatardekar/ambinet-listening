{
  "schema_version": "1.0",
  "encounter_id": "01294",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.0,
      "duration_seconds": 3.87,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.88,
      "end_seconds": 10.16,
      "duration_seconds": 4.28,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.85,
      "end_seconds": 23.55,
      "duration_seconds": 11.7,
      "text": "I've been feeling well. I kept putting it off, which I know isn't sensible. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.63,
      "end_seconds": 29.18,
      "duration_seconds": 3.55,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.01,
      "end_seconds": 34.34,
      "duration_seconds": 3.33,
      "text": "I've had it for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.14,
      "end_seconds": 42.5,
      "duration_seconds": 3.36,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.11,
      "end_seconds": 44.3,
      "duration_seconds": 1.19,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.09,
      "end_seconds": 48.91,
      "duration_seconds": 2.82,
      "text": "Has there been slightly dry skin too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.93,
      "end_seconds": 53.56,
      "duration_seconds": 3.63,
      "text": "Yes, about the same, two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.02,
      "end_seconds": 59.88,
      "duration_seconds": 4.86,
      "text": "Have you been feeling well at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.76,
      "end_seconds": 70.71,
      "duration_seconds": 8.95,
      "text": "Mm, uh, I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.92,
      "end_seconds": 91.3,
      "duration_seconds": 3.38,
      "text": "Have you had constipation, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.5,
      "end_seconds": 94.72,
      "duration_seconds": 2.22,
      "text": "No, none, no constipation."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.32,
      "end_seconds": 101.52,
      "duration_seconds": 6.2,
      "text": "Let me check a few things. Any palpitations, weight change or feeling cold?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.36,
      "end_seconds": 107.26,
      "duration_seconds": 4.9,
      "text": "No palpitations, weight change or feeling cold, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.56,
      "end_seconds": 113.51,
      "duration_seconds": 5.95,
      "text": "Yes, carry on. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.19,
      "end_seconds": 117.1,
      "duration_seconds": 2.91,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.4,
      "end_seconds": 124.89,
      "duration_seconds": 2.49,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.72,
      "end_seconds": 127.65,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.65,
      "end_seconds": 134.7,
      "duration_seconds": 5.05,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.57,
      "end_seconds": 157.76,
      "duration_seconds": 21.19,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. I'm a bus driver, so I sit for long hours. I grab fast food at lunch most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.79,
      "end_seconds": 162.83,
      "duration_seconds": 3.04,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.17,
      "end_seconds": 171.75,
      "duration_seconds": 4.58,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.78,
      "end_seconds": 180.0,
      "duration_seconds": 4.22,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.05,
      "end_seconds": 183.85,
      "duration_seconds": 2.8,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.78,
      "end_seconds": 187.45,
      "duration_seconds": 2.67,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.52,
      "end_seconds": 193.35,
      "duration_seconds": 3.83,
      "text": "I've had gout for two years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.21,
      "end_seconds": 195.23,
      "duration_seconds": 1.02,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.48,
      "end_seconds": 198.98,
      "duration_seconds": 2.5,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.29,
      "end_seconds": 201.66,
      "duration_seconds": 1.37,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 207.7,
      "duration_seconds": 4.14,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.15,
      "end_seconds": 213.85,
      "duration_seconds": 4.7,
      "text": "I take febuxostat, once a day for the gout."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.48,
      "end_seconds": 217.62,
      "duration_seconds": 2.14,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.49,
      "end_seconds": 220.47,
      "duration_seconds": 0.98,
      "text": "80 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.21,
      "end_seconds": 224.14,
      "duration_seconds": 2.93,
      "text": "Right, roughly how long on that one?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.11,
      "end_seconds": 229.39,
      "duration_seconds": 3.28,
      "text": "For six months. Metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.12,
      "end_seconds": 233.47,
      "duration_seconds": 2.35,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.51,
      "end_seconds": 240.5,
      "duration_seconds": 4.99,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.71,
      "end_seconds": 245.15,
      "duration_seconds": 3.44,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.21,
      "end_seconds": 251.45,
      "duration_seconds": 2.24,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.58,
      "end_seconds": 269.97,
      "duration_seconds": 3.39,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.38,
      "end_seconds": 281.11,
      "duration_seconds": 2.73,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.2,
      "end_seconds": 311.19,
      "duration_seconds": 11.99,
      "text": "Okay: pulse is 80 beats a minute, temperature 36.7, height 162 centimetres. And SpO2 97 percent on room air, weight 96 kilos, blood pressure 110 over 80."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.72,
      "end_seconds": 316.37,
      "duration_seconds": 3.65,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.59,
      "end_seconds": 320.5,
      "duration_seconds": 2.91,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.75,
      "end_seconds": 333.18,
      "duration_seconds": 4.43,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.76,
      "end_seconds": 341.26,
      "duration_seconds": 2.5,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.57,
      "end_seconds": 383.53,
      "duration_seconds": 25.96,
      "text": "Right, here's what I'm thinking. The most likely explanation is well-controlled thyroid replacement. I'm going to order a thyroid blood test, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. I'd like you back in twelve months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.72,
      "end_seconds": 390.47,
      "duration_seconds": 4.75,
      "text": "Great, you know, thank you for your help."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.02,
      "end_seconds": 393.93,
      "duration_seconds": 1.91,
      "text": "Have a good day."
    }
  ]
}