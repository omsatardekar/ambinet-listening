{
  "schema_version": "1.0",
  "encounter_id": "01340",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.65,
      "duration_seconds": 3.7,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 10.04,
      "duration_seconds": 3.69,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.47,
      "end_seconds": 17.59,
      "duration_seconds": 6.12,
      "text": "Yeah, uh, it's a runny nose. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.32,
      "end_seconds": 21.46,
      "duration_seconds": 3.14,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.7,
      "end_seconds": 27.98,
      "duration_seconds": 5.28,
      "text": "Around three weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.95,
      "end_seconds": 32.68,
      "duration_seconds": 3.73,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.65,
      "end_seconds": 48.15,
      "duration_seconds": 14.5,
      "text": "Mostly severe. And a scratchy throat as well, since Friday. About scratchy throat, I notice it more with swallowing. Oh, and sneezing. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.91,
      "end_seconds": 53.11,
      "duration_seconds": 3.2,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.59,
      "end_seconds": 59.25,
      "duration_seconds": 1.66,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.2,
      "end_seconds": 71.79,
      "duration_seconds": 6.59,
      "text": "Let me check a few things. Any shortness of breath, fever or ear pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.79,
      "end_seconds": 75.33,
      "duration_seconds": 2.54,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.24,
      "end_seconds": 78.69,
      "duration_seconds": 2.45,
      "text": "Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.45,
      "end_seconds": 81.65,
      "duration_seconds": 2.2,
      "text": "No, no chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.81,
      "end_seconds": 86.44,
      "duration_seconds": 3.63,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.96,
      "end_seconds": 92.38,
      "duration_seconds": 4.42,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.42,
      "end_seconds": 97.47,
      "duration_seconds": 4.05,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.91,
      "end_seconds": 101.15,
      "duration_seconds": 2.24,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.16,
      "end_seconds": 105.71,
      "duration_seconds": 2.55,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.36,
      "end_seconds": 112.17,
      "duration_seconds": 5.81,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.66,
      "end_seconds": 126.62,
      "duration_seconds": 3.96,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.0,
      "end_seconds": 135.69,
      "duration_seconds": 7.69,
      "text": "Well, something called thyr... Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.78,
      "end_seconds": 142.6,
      "duration_seconds": 4.82,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.65,
      "end_seconds": 147.32,
      "duration_seconds": 3.67,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 161.5,
      "duration_seconds": 4.2,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.08,
      "end_seconds": 167.13,
      "duration_seconds": 4.05,
      "text": "Yes, cat fur, it gives me wheezing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.92,
      "end_seconds": 181.63,
      "duration_seconds": 2.71,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.71,
      "end_seconds": 185.14,
      "duration_seconds": 2.43,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.22,
      "end_seconds": 190.14,
      "duration_seconds": 2.92,
      "text": "Ah. Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.55,
      "end_seconds": 195.91,
      "duration_seconds": 4.36,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.63,
      "end_seconds": 203.9,
      "duration_seconds": 3.27,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.72,
      "end_seconds": 208.08,
      "duration_seconds": 3.36,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.65,
      "end_seconds": 214.7,
      "duration_seconds": 2.05,
      "text": "Alright, and your job?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.77,
      "end_seconds": 220.41,
      "duration_seconds": 3.64,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.22,
      "end_seconds": 229.25,
      "duration_seconds": 3.03,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.32,
      "end_seconds": 232.6,
      "duration_seconds": 2.28,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.67,
      "end_seconds": 237.96,
      "duration_seconds": 3.29,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.69,
      "end_seconds": 251.72,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.16,
      "end_seconds": 270.46,
      "duration_seconds": 8.3,
      "text": "Okay: temperature 36.8, oxygen saturation is 97 percent. And pressure 112 over 72, heart rate 78."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.14,
      "end_seconds": 274.25,
      "duration_seconds": 2.11,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.97,
      "end_seconds": 278.35,
      "duration_seconds": 2.38,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.41,
      "end_seconds": 292.36,
      "duration_seconds": 4.95,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.7,
      "end_seconds": 312.34,
      "duration_seconds": 16.64,
      "text": "You can sit up now. From what you've told me and what I found, my working impression is a simple viral cold. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.73,
      "end_seconds": 317.03,
      "duration_seconds": 3.3,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.95,
      "end_seconds": 337.01,
      "duration_seconds": 18.06,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold. Rest, plenty of fluids, and paracetamol if you ache. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.97,
      "end_seconds": 341.15,
      "duration_seconds": 3.18,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.53,
      "end_seconds": 351.84,
      "duration_seconds": 9.31,
      "text": "I'll want another look if it is not better in ten days. So, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.99,
      "end_seconds": 354.54,
      "duration_seconds": 1.55,
      "text": "That's clear, thanks."
    }
  ]
}