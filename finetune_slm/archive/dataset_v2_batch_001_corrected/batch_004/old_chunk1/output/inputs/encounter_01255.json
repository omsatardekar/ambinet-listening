{
  "schema_version": "1.0",
  "encounter_id": "01255",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 8.36,
      "duration_seconds": 7.81,
      "text": "Okay, so doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.16,
      "end_seconds": 16.16,
      "duration_seconds": 5.0,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.86,
      "end_seconds": 28.65,
      "duration_seconds": 11.79,
      "text": "Honestly, it's my throat closing up, and my family pushed me to come. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.0,
      "end_seconds": 34.89,
      "duration_seconds": 5.89,
      "text": "Yes, carry on. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.24,
      "end_seconds": 41.49,
      "duration_seconds": 5.25,
      "text": "Honestly, a few times a day. Severe, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.21,
      "end_seconds": 46.11,
      "duration_seconds": 2.9,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.07,
      "end_seconds": 67.88,
      "duration_seconds": 19.81,
      "text": "Hives all over goes along with it, most of the time. And I've been feeling faint as well. Hmm, um, with feeling faint, it's on and off. The hives all over? That's been for two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.05,
      "end_seconds": 82.83,
      "duration_seconds": 2.78,
      "text": "Any recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.38,
      "end_seconds": 85.69,
      "duration_seconds": 2.31,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.48,
      "end_seconds": 91.86,
      "duration_seconds": 3.38,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.71,
      "end_seconds": 100.08,
      "duration_seconds": 3.37,
      "text": "Mm, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.21,
      "end_seconds": 103.33,
      "duration_seconds": 2.12,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.04,
      "end_seconds": 105.77,
      "duration_seconds": 1.73,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.6,
      "end_seconds": 110.55,
      "duration_seconds": 2.95,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.67,
      "end_seconds": 125.26,
      "duration_seconds": 13.59,
      "text": "My husband and I live above the shop. I grab fast food at lunch most days. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.03,
      "end_seconds": 129.98,
      "duration_seconds": 2.95,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.06,
      "end_seconds": 137.72,
      "duration_seconds": 3.66,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.59,
      "end_seconds": 143.0,
      "duration_seconds": 3.41,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.36,
      "end_seconds": 147.42,
      "duration_seconds": 3.06,
      "text": "Erm, my son has asthma."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.13,
      "end_seconds": 152.65,
      "duration_seconds": 3.52,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.8,
      "end_seconds": 156.84,
      "duration_seconds": 3.04,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.24,
      "end_seconds": 167.86,
      "duration_seconds": 3.62,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.17,
      "end_seconds": 174.99,
      "duration_seconds": 5.82,
      "text": "Let me think, um, no, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.9,
      "end_seconds": 178.91,
      "duration_seconds": 2.01,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.77,
      "end_seconds": 187.16,
      "duration_seconds": 6.39,
      "text": "Yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.86,
      "end_seconds": 207.43,
      "duration_seconds": 2.57,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.35,
      "end_seconds": 216.66,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.3,
      "end_seconds": 244.88,
      "duration_seconds": 8.58,
      "text": "Okay: pressure 93 over 58, temp 36.7 degrees, oxygen saturation is 99 percent, pulse is 105 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.53,
      "end_seconds": 250.24,
      "duration_seconds": 2.71,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.9,
      "end_seconds": 253.25,
      "duration_seconds": 1.35,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.87,
      "end_seconds": 258.28,
      "duration_seconds": 3.41,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.56,
      "end_seconds": 277.88,
      "duration_seconds": 6.32,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.0,
      "end_seconds": 293.5,
      "duration_seconds": 12.5,
      "text": "Good, you can sit up again. Having listened and examined, it's hard to say. Anaphylaxis is one possibility and a severe allergic reaction another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.02,
      "end_seconds": 300.33,
      "duration_seconds": 2.31,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.27,
      "end_seconds": 319.84,
      "duration_seconds": 18.57,
      "text": "It's reasonable to be concerned, but right now anaphylaxis is my leading thought, not anything worse. I want monitoring done, that's for anaphylaxis. I'm prescribing adrenaline, 0.5 milligrams, once now, single dose. That should help with anaphylaxis."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.51,
      "end_seconds": 322.76,
      "duration_seconds": 2.25,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.11,
      "end_seconds": 341.53,
      "duration_seconds": 17.42,
      "text": "Lie flat with your legs raised, I am giving the injection now. I'm going to send a referral to the emergency team. The thing that would worry me is if the symptoms return. If that happens, go to emergency. Let's review you straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.28,
      "end_seconds": 344.54,
      "duration_seconds": 2.26,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.65,
      "end_seconds": 351.2,
      "duration_seconds": 5.55,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.12,
      "end_seconds": 355.42,
      "duration_seconds": 3.3,
      "text": "Erm, alright, thanks, take care."
    }
  ]
}