{
  "schema_version": "1.0",
  "encounter_id": "01146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 5.38,
      "duration_seconds": 4.19,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.67,
      "end_seconds": 10.68,
      "duration_seconds": 4.01,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.99,
      "end_seconds": 18.15,
      "duration_seconds": 6.16,
      "text": "Yeah, doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.73,
      "end_seconds": 22.17,
      "duration_seconds": 3.44,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.09,
      "end_seconds": 27.91,
      "duration_seconds": 4.82,
      "text": "Doctor, it's being very thirsty. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.42,
      "end_seconds": 30.74,
      "duration_seconds": 2.32,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.5,
      "end_seconds": 34.91,
      "duration_seconds": 2.41,
      "text": "For six months, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.5,
      "end_seconds": 39.43,
      "duration_seconds": 2.93,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.47,
      "end_seconds": 46.52,
      "duration_seconds": 5.05,
      "text": "Yeah, um, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.25,
      "end_seconds": 51.14,
      "duration_seconds": 2.89,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.98,
      "end_seconds": 58.48,
      "duration_seconds": 6.5,
      "text": "When it starts I tend to get deep fast breathing as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.36,
      "end_seconds": 67.01,
      "duration_seconds": 7.65,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 67.11,
      "end_seconds": 72.31,
      "duration_seconds": 5.2,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.39,
      "end_seconds": 80.55,
      "duration_seconds": 7.16,
      "text": "I was getting to that! The deep fast breathing? That's been since last night."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.2,
      "end_seconds": 84.31,
      "duration_seconds": 3.11,
      "text": "A few quick ones: cough or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.46,
      "end_seconds": 98.24,
      "duration_seconds": 12.78,
      "text": "No, no cough, no chest pain. I was passing a lot of urine at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 102.53,
      "duration_seconds": 3.78,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.07,
      "end_seconds": 106.05,
      "duration_seconds": 1.98,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.88,
      "end_seconds": 112.26,
      "duration_seconds": 4.38,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.4,
      "end_seconds": 135.35,
      "duration_seconds": 21.95,
      "text": "Erm, I've had diabetes, yes. I didn't want to make a fuss, you know. I have heart failure, for nearly five years. Asthma, for five years. I've got migraines. I've had an irregular heartbeat, yes. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.55,
      "end_seconds": 142.91,
      "duration_seconds": 6.36,
      "text": "Okay, I can see diabetes and heart failure in your file as well."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.13,
      "end_seconds": 160.56,
      "duration_seconds": 1.43,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.75,
      "end_seconds": 165.53,
      "duration_seconds": 3.78,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.16,
      "end_seconds": 169.18,
      "duration_seconds": 2.02,
      "text": "Okay, are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.38,
      "end_seconds": 173.66,
      "duration_seconds": 3.28,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.52,
      "end_seconds": 177.55,
      "duration_seconds": 2.03,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.9,
      "end_seconds": 184.08,
      "duration_seconds": 5.18,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.7,
      "end_seconds": 201.54,
      "duration_seconds": 3.84,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 202.23,
      "end_seconds": 223.41,
      "duration_seconds": 21.18,
      "text": "It's metformin, 500 milligrams, twice a day for my sugar, doctor. He is on metoprolol, 50 milligrams, twice a day for my heart, I give it to him. It's Foracort inhaler, twice a day, doctor. Um, he takes sumatriptan, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.24,
      "end_seconds": 227.66,
      "duration_seconds": 2.42,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 229.22,
      "end_seconds": 230.15,
      "duration_seconds": 0.93,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.9,
      "end_seconds": 238.05,
      "duration_seconds": 4.15,
      "text": "I was on furosemide before. I stopped taking it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.29,
      "end_seconds": 243.99,
      "duration_seconds": 4.7,
      "text": "Okay, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.42,
      "end_seconds": 247.73,
      "duration_seconds": 2.31,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.46,
      "end_seconds": 251.31,
      "duration_seconds": 2.85,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.06,
      "end_seconds": 264.12,
      "duration_seconds": 11.06,
      "text": "I think I reacted to some antibiotic once, you know, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.32,
      "end_seconds": 267.93,
      "duration_seconds": 2.61,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.55,
      "end_seconds": 280.95,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.99,
      "end_seconds": 310.2,
      "duration_seconds": 13.21,
      "text": "Okay: height 154 centimetres, BMI works out to 24.0. And weight 57 kilos, saturation 99 percent, respiratory rate 20, pulse is 117 beats a minute, BP is 123 over 78."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.87,
      "end_seconds": 312.54,
      "duration_seconds": 1.67,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.51,
      "end_seconds": 316.42,
      "duration_seconds": 2.91,
      "text": "Alright, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.93,
      "end_seconds": 321.68,
      "duration_seconds": 3.75,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.2,
      "end_seconds": 324.51,
      "duration_seconds": 1.31,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.73,
      "end_seconds": 336.97,
      "duration_seconds": 4.24,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.75,
      "end_seconds": 370.68,
      "duration_seconds": 29.93,
      "text": "You can relax now. So where does that leave us? I'd lean towards diabetic ketoacidosis. Another possibility is a severe infection. Blood gas and electrolytes is what I'd like next, for DKA. We should do a blood sugar and ketone test for thirst and vomiting. You need to go to hospital now for insulin and fluids. We'll refer you to the emergency team. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.52,
      "end_seconds": 377.57,
      "duration_seconds": 3.05,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.53,
      "end_seconds": 379.73,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}