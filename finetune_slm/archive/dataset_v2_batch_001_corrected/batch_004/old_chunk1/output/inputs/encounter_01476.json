{
  "schema_version": "1.0",
  "encounter_id": "01476",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 6.08,
      "duration_seconds": 5.56,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 12.78,
      "duration_seconds": 4.73,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.43,
      "end_seconds": 20.14,
      "duration_seconds": 5.71,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.01,
      "end_seconds": 28.14,
      "duration_seconds": 7.13,
      "text": "Um, uh, so... a tight band around my head. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.78,
      "end_seconds": 31.14,
      "duration_seconds": 2.36,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.55,
      "end_seconds": 44.25,
      "duration_seconds": 11.7,
      "text": "I'm on febuxostat, 80 milligrams, once a day. Atorvastatin. I take it 20 milligrams, at night. Glibenclamide, 5 milligrams, before breakfast"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 46.15,
      "end_seconds": 53.89,
      "duration_seconds": 7.74,
      "text": "she is supposed to take it before breakfast, but I can't say she always does"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.79,
      "end_seconds": 61.34,
      "duration_seconds": 5.55,
      "text": "I take Thyronorm, 50 micrograms, maybe, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.02,
      "end_seconds": 67.8,
      "duration_seconds": 4.78,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.48,
      "end_seconds": 73.27,
      "duration_seconds": 3.79,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.43,
      "end_seconds": 77.65,
      "duration_seconds": 3.22,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.57,
      "end_seconds": 86.37,
      "duration_seconds": 6.8,
      "text": "well, um, it's... hard to say, it's kind of.. i don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.63,
      "end_seconds": 93.4,
      "duration_seconds": 5.77,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.9,
      "end_seconds": 104.85,
      "duration_seconds": 5.95,
      "text": "Sorry, what was I saying, about a five out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.86,
      "end_seconds": 108.61,
      "duration_seconds": 2.75,
      "text": "So, how frequently does it come?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.46,
      "end_seconds": 113.04,
      "duration_seconds": 2.58,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.32,
      "end_seconds": 116.77,
      "duration_seconds": 2.45,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.82,
      "end_seconds": 123.71,
      "duration_seconds": 4.89,
      "text": "Tired eyes goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.68,
      "end_seconds": 128.44,
      "duration_seconds": 2.76,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.79,
      "end_seconds": 138.55,
      "duration_seconds": 7.76,
      "text": "Well, uh, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.79,
      "end_seconds": 145.22,
      "duration_seconds": 5.43,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.98,
      "end_seconds": 151.77,
      "duration_seconds": 5.79,
      "text": "Sorry, what was I saying, a eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.17,
      "end_seconds": 156.07,
      "duration_seconds": 2.9,
      "text": "Have you noticed weakness or sickness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.92,
      "end_seconds": 168.61,
      "duration_seconds": 10.69,
      "text": "Ah, no, no weakness, no sickness. I did have a stiff neck at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.58,
      "end_seconds": 174.16,
      "duration_seconds": 3.58,
      "text": "any sensitivity to light or blurred vision at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.74,
      "end_seconds": 180.92,
      "duration_seconds": 5.18,
      "text": "No sensitivity to light or blurred vision, none of it."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.8,
      "end_seconds": 184.05,
      "duration_seconds": 2.25,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.49,
      "end_seconds": 187.89,
      "duration_seconds": 2.4,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.48,
      "end_seconds": 191.92,
      "duration_seconds": 3.44,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.64,
      "end_seconds": 196.25,
      "duration_seconds": 3.61,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.71,
      "end_seconds": 202.11,
      "duration_seconds": 4.4,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.09,
      "end_seconds": 213.47,
      "duration_seconds": 10.38,
      "text": "I think I reacted to some antibiotic once, years ago i don't remember which one, or what happened exactly"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.1,
      "end_seconds": 217.96,
      "duration_seconds": 2.86,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.68,
      "end_seconds": 224.13,
      "duration_seconds": 4.45,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.19,
      "end_seconds": 228.59,
      "duration_seconds": 2.4,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.45,
      "end_seconds": 232.92,
      "duration_seconds": 2.47,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.07,
      "end_seconds": 236.94,
      "duration_seconds": 2.87,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.33,
      "end_seconds": 243.75,
      "duration_seconds": 3.42,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.81,
      "end_seconds": 251.18,
      "duration_seconds": 6.37,
      "text": "Any health conditions I should have on record? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.81,
      "end_seconds": 265.59,
      "duration_seconds": 10.78,
      "text": "I've had gout for nearly five years now. I've had high cholesterol for nearly five years now. I, I have diabetes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.43,
      "end_seconds": 268.36,
      "duration_seconds": 0.93,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.27,
      "end_seconds": 274.24,
      "duration_seconds": 4.97,
      "text": "I have an underactive thyroid, for nearly five years."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.52,
      "end_seconds": 282.68,
      "duration_seconds": 7.16,
      "text": "right, so gout and high cholesterol are already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.12,
      "end_seconds": 292.97,
      "duration_seconds": 2.85,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.6,
      "end_seconds": 305.44,
      "duration_seconds": 2.84,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.32,
      "end_seconds": 324.92,
      "duration_seconds": 3.6,
      "text": "Okay: pulse 65, BP is 124 over 76."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.91,
      "end_seconds": 329.93,
      "duration_seconds": 3.02,
      "text": "let's move on to to the examination"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.89,
      "end_seconds": 333.84,
      "duration_seconds": 1.95,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.75,
      "end_seconds": 348.27,
      "duration_seconds": 6.52,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.02,
      "end_seconds": 353.25,
      "duration_seconds": 2.23,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.63,
      "end_seconds": 377.73,
      "duration_seconds": 13.1,
      "text": "So where does that leave us? I don't have a clear answer today: tension-type headache is possible, and so is eye strain. I'm going to order an eye test, for eye strain."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 378.52,
      "end_seconds": 381.21,
      "duration_seconds": 2.69,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.09,
      "end_seconds": 383.99,
      "duration_seconds": 0.9,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.05,
      "end_seconds": 405.92,
      "duration_seconds": 20.87,
      "text": "take screen breaks every hour and try regular neck stretches. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.38,
      "end_seconds": 408.48,
      "duration_seconds": 1.1,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.96,
      "end_seconds": 422.59,
      "duration_seconds": 12.63,
      "text": "One warning sign to remember: the headache becomes sudden and severe. In that case don't wait. Book a review in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 424.4,
      "end_seconds": 427.26,
      "duration_seconds": 2.86,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.49,
      "end_seconds": 429.8,
      "duration_seconds": 1.31,
      "text": "Look after yourself."
    }
  ]
}