{
  "schema_version": "1.0",
  "encounter_id": "01356",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 6.96,
      "duration_seconds": 6.22,
      "text": "Oh, um, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.58,
      "end_seconds": 11.76,
      "duration_seconds": 4.18,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.72,
      "end_seconds": 22.56,
      "duration_seconds": 9.84,
      "text": "Yeah, you know, it's my face drooping on one side. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.29,
      "end_seconds": 30.6,
      "duration_seconds": 7.31,
      "text": "Has this been going on for long? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.61,
      "end_seconds": 42.19,
      "duration_seconds": 9.58,
      "text": "Mm, I've had it since this morning. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.83,
      "end_seconds": 46.28,
      "duration_seconds": 2.45,
      "text": "Any a sudden headache as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.73,
      "end_seconds": 50.28,
      "duration_seconds": 2.55,
      "text": "Yes, for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 54.05,
      "duration_seconds": 2.48,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.26,
      "end_seconds": 64.77,
      "duration_seconds": 9.51,
      "text": "I've had an irregular heartbeat for nearly five years now. I've, I've got high blood pressure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.77,
      "end_seconds": 77.37,
      "duration_seconds": 10.6,
      "text": "Mm-hmm. Yes, an irregular heartbeat is known to us, good to have that clear. Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.4,
      "end_seconds": 94.11,
      "duration_seconds": 14.71,
      "text": "So, I take bisoprolol, 2.5 milligrams, once a day. Actually, you know, I take losartan, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.63,
      "end_seconds": 97.59,
      "duration_seconds": 1.96,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.34,
      "end_seconds": 99.32,
      "duration_seconds": 0.98,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.75,
      "end_seconds": 103.68,
      "duration_seconds": 2.93,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.85,
      "end_seconds": 115.02,
      "duration_seconds": 6.17,
      "text": "So, just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.54,
      "end_seconds": 127.78,
      "duration_seconds": 1.24,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.83,
      "end_seconds": 133.39,
      "duration_seconds": 4.56,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.21,
      "end_seconds": 135.76,
      "duration_seconds": 1.55,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.87,
      "end_seconds": 139.37,
      "duration_seconds": 2.5,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.75,
      "end_seconds": 143.58,
      "duration_seconds": 2.83,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.53,
      "end_seconds": 149.42,
      "duration_seconds": 3.89,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.19,
      "end_seconds": 152.89,
      "duration_seconds": 1.7,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.76,
      "end_seconds": 159.24,
      "duration_seconds": 4.48,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.35,
      "end_seconds": 181.18,
      "duration_seconds": 3.83,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.71,
      "end_seconds": 184.57,
      "duration_seconds": 2.86,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.2,
      "end_seconds": 190.74,
      "duration_seconds": 4.54,
      "text": "Let me check a few things. Any seizure or fever?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.74,
      "end_seconds": 198.02,
      "duration_seconds": 6.28,
      "text": "Let me think, you know, no seizure or fever, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.95,
      "end_seconds": 203.13,
      "duration_seconds": 3.18,
      "text": "Have you had any loss of consciousness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.69,
      "end_seconds": 209.32,
      "duration_seconds": 5.63,
      "text": "Yeah, no, I haven't had any loss of consciousness."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.07,
      "end_seconds": 214.19,
      "duration_seconds": 4.12,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.86,
      "end_seconds": 221.06,
      "duration_seconds": 5.2,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.16,
      "end_seconds": 226.23,
      "duration_seconds": 3.07,
      "text": "So, has your skin been okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.73,
      "end_seconds": 227.91,
      "duration_seconds": 1.18,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.64,
      "end_seconds": 231.08,
      "duration_seconds": 2.44,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.79,
      "end_seconds": 243.22,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.85,
      "end_seconds": 265.55,
      "duration_seconds": 4.7,
      "text": "Okay: pulse 73, pressure 157 over 99, saturation 97 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.99,
      "end_seconds": 272.51,
      "duration_seconds": 4.52,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.54,
      "end_seconds": 276.02,
      "duration_seconds": 1.48,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.14,
      "end_seconds": 279.9,
      "duration_seconds": 2.76,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.45,
      "end_seconds": 298.74,
      "duration_seconds": 6.29,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.71,
      "end_seconds": 319.66,
      "duration_seconds": 17.95,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. I'd lean towards a possible stroke, within the treatment window. So, to recap quickly. You've had your face drooping on one side, since this morning, and no fever or seizure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.14,
      "end_seconds": 324.84,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.14,
      "end_seconds": 346.03,
      "duration_seconds": 5.89,
      "text": "Call an ambulance now, you need hospital immediately. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.22,
      "end_seconds": 348.98,
      "duration_seconds": 1.76,
      "text": "That's clear, thanks."
    }
  ]
}