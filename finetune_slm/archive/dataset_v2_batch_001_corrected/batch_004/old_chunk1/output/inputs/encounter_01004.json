{
  "schema_version": "1.0",
  "encounter_id": "01004",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 5.27,
      "duration_seconds": 4.76,
      "text": "Good morning, grab a seat. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.82,
      "end_seconds": 10.91,
      "duration_seconds": 5.09,
      "text": "So the thing is, I've got crushing chest pain."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.36,
      "end_seconds": 15.84,
      "duration_seconds": 3.48,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.25,
      "end_seconds": 24.53,
      "duration_seconds": 7.28,
      "text": "It's been six months now. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.26,
      "end_seconds": 40.1,
      "duration_seconds": 14.84,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.3,
      "end_seconds": 48.73,
      "duration_seconds": 7.43,
      "text": "It's mild, honestly. Only rest, and it's not much. Yes, exertion. That makes it worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.15,
      "end_seconds": 61.85,
      "duration_seconds": 3.7,
      "text": "And what about leg swelling, fever or cough?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.73,
      "end_seconds": 68.78,
      "duration_seconds": 5.05,
      "text": "I haven't had leg swelling, fever or cough, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.86,
      "end_seconds": 72.67,
      "duration_seconds": 1.81,
      "text": "okay, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.62,
      "end_seconds": 79.55,
      "duration_seconds": 1.93,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.39,
      "end_seconds": 84.2,
      "duration_seconds": 2.81,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.78,
      "end_seconds": 94.17,
      "duration_seconds": 4.39,
      "text": "Ah, uh, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.36,
      "end_seconds": 100.16,
      "duration_seconds": 4.8,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.72,
      "end_seconds": 104.14,
      "duration_seconds": 2.42,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.93,
      "end_seconds": 107.27,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.92,
      "end_seconds": 115.58,
      "duration_seconds": 4.66,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.84,
      "end_seconds": 119.21,
      "duration_seconds": 2.37,
      "text": "Right, who lives with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.5,
      "end_seconds": 123.13,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.34,
      "end_seconds": 136.26,
      "duration_seconds": 2.92,
      "text": "is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.13,
      "end_seconds": 138.16,
      "duration_seconds": 1.03,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.24,
      "end_seconds": 149.63,
      "duration_seconds": 3.39,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.5,
      "end_seconds": 153.26,
      "duration_seconds": 1.76,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.61,
      "end_seconds": 167.48,
      "duration_seconds": 3.87,
      "text": "right, I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.78,
      "end_seconds": 179.21,
      "duration_seconds": 2.43,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.88,
      "end_seconds": 198.76,
      "duration_seconds": 8.88,
      "text": "okay: heart rate 123, saturation 97 percent, respiratory rate 16, temperature is 36.7 degrees, pressure 125 over 87."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.6,
      "end_seconds": 201.95,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.2,
      "end_seconds": 207.94,
      "duration_seconds": 2.74,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.58,
      "end_seconds": 213.75,
      "duration_seconds": 4.17,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.84,
      "end_seconds": 217.48,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.92,
      "end_seconds": 220.25,
      "duration_seconds": 1.33,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.35,
      "end_seconds": 232.36,
      "duration_seconds": 5.01,
      "text": "you are pale and sweaty, and your pulse is fast"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.62,
      "end_seconds": 242.28,
      "duration_seconds": 7.66,
      "text": "You can relax now. Putting it all together, this looks most like a possible heart attack."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.63,
      "end_seconds": 247.08,
      "duration_seconds": 3.45,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.79,
      "end_seconds": 267.51,
      "duration_seconds": 18.72,
      "text": "I can't promise yet, but most people with a possible heart attack do well once it's treated properly just to be sure I understood you've had crushing chest pain for six months, mild, and no fever or leg swelling"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.59,
      "end_seconds": 270.29,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.52,
      "end_seconds": 296.58,
      "duration_seconds": 25.06,
      "text": "I'm sending you for an ECG cos of chest pain. I'd like you to take aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. It's a commonly used medicine and most people tolerate it well. Stay lying down and do not eat or drink. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.17,
      "end_seconds": 303.11,
      "duration_seconds": 2.94,
      "text": "ah, I can manage that that"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.68,
      "end_seconds": 310.82,
      "duration_seconds": 4.14,
      "text": "Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.31,
      "end_seconds": 314.34,
      "duration_seconds": 2.03,
      "text": "Alright, thanks, take care."
    }
  ]
}