{
  "schema_version": "1.0",
  "encounter_id": "01006",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 4.85,
      "duration_seconds": 3.68,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 9.87,
      "duration_seconds": 3.93,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.41,
      "end_seconds": 16.6,
      "duration_seconds": 6.19,
      "text": "I've been feeling faint, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.91,
      "end_seconds": 21.39,
      "duration_seconds": 3.48,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.72,
      "end_seconds": 29.58,
      "duration_seconds": 6.86,
      "text": "Three weeks, I think... sorry, about two weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.78,
      "end_seconds": 39.02,
      "duration_seconds": 9.24,
      "text": "Ah. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.86,
      "end_seconds": 46.6,
      "duration_seconds": 6.74,
      "text": "It happens every other day. Standing definitely sets it off. I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.39,
      "end_seconds": 50.35,
      "duration_seconds": 2.96,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.34,
      "end_seconds": 54.47,
      "duration_seconds": 2.13,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.41,
      "end_seconds": 58.43,
      "duration_seconds": 2.02,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.58,
      "end_seconds": 62.16,
      "duration_seconds": 2.58,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.97,
      "end_seconds": 66.32,
      "duration_seconds": 3.35,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.15,
      "end_seconds": 70.87,
      "duration_seconds": 2.72,
      "text": "Yes, I'm allergic to nickel."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.55,
      "end_seconds": 84.44,
      "duration_seconds": 2.89,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.15,
      "end_seconds": 90.01,
      "duration_seconds": 3.86,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.98,
      "end_seconds": 93.56,
      "duration_seconds": 1.58,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.21,
      "end_seconds": 98.27,
      "duration_seconds": 4.06,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.59,
      "end_seconds": 115.76,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.37,
      "end_seconds": 119.63,
      "duration_seconds": 3.26,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.14,
      "end_seconds": 125.21,
      "duration_seconds": 4.07,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.34,
      "end_seconds": 128.56,
      "duration_seconds": 2.22,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.08,
      "end_seconds": 132.46,
      "duration_seconds": 3.38,
      "text": "Have you noticed fever or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.49,
      "end_seconds": 138.41,
      "duration_seconds": 3.92,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.32,
      "end_seconds": 143.07,
      "duration_seconds": 2.75,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.16,
      "end_seconds": 146.11,
      "duration_seconds": 1.95,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.73,
      "end_seconds": 149.63,
      "duration_seconds": 2.9,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.43,
      "end_seconds": 158.37,
      "duration_seconds": 1.94,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.38,
      "end_seconds": 185.2,
      "duration_seconds": 9.82,
      "text": "Okay: pulse 124, SpO2 99 percent on room air, blood pressure 137 over 78. And temperature is 37.0 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.88,
      "end_seconds": 190.21,
      "duration_seconds": 3.33,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.77,
      "end_seconds": 193.64,
      "duration_seconds": 1.87,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.36,
      "end_seconds": 213.48,
      "duration_seconds": 6.12,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.05,
      "end_seconds": 219.91,
      "duration_seconds": 2.86,
      "text": "Right, that's all I needed to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.21,
      "end_seconds": 241.49,
      "duration_seconds": 12.28,
      "text": "From what you've told me and what I found, I can't pin this down yet. We're looking at a possible bleeding stomach ulcer or a bleed from the gullet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.05,
      "end_seconds": 246.01,
      "duration_seconds": 3.96,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.1,
      "end_seconds": 258.56,
      "duration_seconds": 10.46,
      "text": "I understand the worry. At the moment I'd say it's a possible bleeding stomach ulcer, and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.52,
      "end_seconds": 282.02,
      "duration_seconds": 8.5,
      "text": "I think urgent blood tests makes sense here, for bleeding. I'm going to order an endoscopy, for bleeding."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.92,
      "end_seconds": 284.88,
      "duration_seconds": 1.96,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.44,
      "end_seconds": 294.76,
      "duration_seconds": 8.32,
      "text": "Please stop the ibuprofen and do not eat or drink. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.03,
      "end_seconds": 296.73,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.52,
      "end_seconds": 309.27,
      "duration_seconds": 10.75,
      "text": "The thing that would worry me is if you vomit again. If that happens, go to emergency. I'll want another look straight away."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.89,
      "end_seconds": 315.14,
      "duration_seconds": 2.25,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.15,
      "end_seconds": 318.96,
      "duration_seconds": 2.81,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.67,
      "end_seconds": 321.61,
      "duration_seconds": 1.94,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.17,
      "end_seconds": 324.5,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}