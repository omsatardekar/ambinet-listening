{
  "schema_version": "1.0",
  "encounter_id": "01114",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.52,
      "duration_seconds": 3.83,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.66,
      "end_seconds": 10.08,
      "duration_seconds": 4.42,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.92,
      "end_seconds": 20.75,
      "duration_seconds": 9.83,
      "text": "Mainly shaking chills and a high temperature. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.01,
      "end_seconds": 25.8,
      "duration_seconds": 3.79,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.14,
      "end_seconds": 36.96,
      "duration_seconds": 4.82,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.98,
      "end_seconds": 40.68,
      "duration_seconds": 1.7,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.83,
      "end_seconds": 51.36,
      "duration_seconds": 9.53,
      "text": "I, I get some relief from blankets. I've also had a racing heart, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.27,
      "end_seconds": 67.9,
      "duration_seconds": 2.63,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.73,
      "end_seconds": 74.5,
      "duration_seconds": 4.77,
      "text": "Okay, so just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.26,
      "end_seconds": 79.95,
      "duration_seconds": 4.69,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.16,
      "end_seconds": 88.59,
      "duration_seconds": 4.43,
      "text": "Yeah, it's sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.67,
      "end_seconds": 93.88,
      "duration_seconds": 4.21,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.63,
      "end_seconds": 98.25,
      "duration_seconds": 3.62,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.78,
      "end_seconds": 103.52,
      "duration_seconds": 3.74,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.61,
      "end_seconds": 119.88,
      "duration_seconds": 14.27,
      "text": "Yes, diabetes. I wasn't sure whether to come in at all, to be honest. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.94,
      "end_seconds": 124.89,
      "duration_seconds": 2.95,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.45,
      "end_seconds": 130.93,
      "duration_seconds": 4.48,
      "text": "Mm, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.2,
      "end_seconds": 134.66,
      "duration_seconds": 2.46,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.34,
      "end_seconds": 139.91,
      "duration_seconds": 4.57,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.35,
      "end_seconds": 142.7,
      "duration_seconds": 1.35,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.4,
      "end_seconds": 148.84,
      "duration_seconds": 4.44,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.89,
      "end_seconds": 154.72,
      "duration_seconds": 3.83,
      "text": "And what about rash, chest pain or stiff neck?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 159.68,
      "duration_seconds": 3.2,
      "text": "Oh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.41,
      "end_seconds": 163.33,
      "duration_seconds": 2.92,
      "text": "Right, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.6,
      "end_seconds": 171.23,
      "duration_seconds": 4.63,
      "text": "Um, uh, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.3,
      "end_seconds": 176.26,
      "duration_seconds": 2.96,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.89,
      "end_seconds": 179.91,
      "duration_seconds": 3.02,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.42,
      "end_seconds": 184.61,
      "duration_seconds": 4.19,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.92,
      "end_seconds": 194.42,
      "duration_seconds": 2.5,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.94,
      "end_seconds": 209.74,
      "duration_seconds": 4.8,
      "text": "Okay: pulse 93, pressure 125 over 71, temp 39.2 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.0,
      "end_seconds": 214.1,
      "duration_seconds": 3.1,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.93,
      "end_seconds": 223.67,
      "duration_seconds": 1.74,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.83,
      "end_seconds": 226.13,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.97,
      "end_seconds": 248.17,
      "duration_seconds": 7.2,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.55,
      "end_seconds": 255.46,
      "duration_seconds": 1.91,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.64,
      "end_seconds": 269.81,
      "duration_seconds": 4.17,
      "text": "I'll request a chest X-ray, it'll help with fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.97,
      "end_seconds": 274.59,
      "duration_seconds": 3.62,
      "text": "So, where would I go for that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.72,
      "end_seconds": 281.86,
      "duration_seconds": 6.14,
      "text": "I think blood cultures makes sense here, for fever with low blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.44,
      "end_seconds": 286.1,
      "duration_seconds": 2.66,
      "text": "Erm, is that done today?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.56,
      "end_seconds": 311.47,
      "duration_seconds": 20.91,
      "text": "Let's book lactate and blood tests to look into sepsis. I want to admit you to hospital now for fluids and antibiotics. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.87,
      "end_seconds": 322.49,
      "duration_seconds": 10.62,
      "text": "Mm, okay. If you cannot be brought in today, or you feel really unwell, please come to the emergency department. Book a review straight away."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.52,
      "end_seconds": 328.71,
      "duration_seconds": 4.19,
      "text": "I, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.23,
      "end_seconds": 331.61,
      "duration_seconds": 2.38,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.23,
      "end_seconds": 335.25,
      "duration_seconds": 3.02,
      "text": "That's clear, um, thanks."
    }
  ]
}