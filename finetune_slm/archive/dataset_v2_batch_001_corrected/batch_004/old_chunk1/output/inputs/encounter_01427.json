{
  "schema_version": "1.0",
  "encounter_id": "01427",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 5.29,
      "duration_seconds": 3.92,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.32,
      "end_seconds": 10.11,
      "duration_seconds": 3.79,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.3,
      "end_seconds": 23.27,
      "duration_seconds": 8.97,
      "text": "So the thing is, I've got my throat closing up. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.35,
      "end_seconds": 33.82,
      "duration_seconds": 4.47,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.68,
      "end_seconds": 44.76,
      "duration_seconds": 2.08,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.05,
      "end_seconds": 72.31,
      "duration_seconds": 8.26,
      "text": "Okay: blood pressure 101 over 64, respiratory rate 20, pulse 95. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.03,
      "end_seconds": 82.72,
      "duration_seconds": 6.69,
      "text": "It's been two weeks now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.48,
      "end_seconds": 87.04,
      "duration_seconds": 2.56,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.87,
      "end_seconds": 92.07,
      "duration_seconds": 3.2,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.65,
      "end_seconds": 100.35,
      "duration_seconds": 3.7,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.58,
      "end_seconds": 102.67,
      "duration_seconds": 1.09,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.93,
      "end_seconds": 106.58,
      "duration_seconds": 2.65,
      "text": "So, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.27,
      "end_seconds": 110.61,
      "duration_seconds": 3.34,
      "text": "Mm, it usually comes with wheezing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.36,
      "end_seconds": 113.65,
      "duration_seconds": 2.29,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.61,
      "end_seconds": 126.19,
      "duration_seconds": 10.58,
      "text": "Yes, you know, for about three months. The wheezing? That's been for five days. With wheezing, I'd say all the time."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.63,
      "end_seconds": 146.03,
      "duration_seconds": 4.4,
      "text": "A few quick ones: chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.7,
      "end_seconds": 150.98,
      "duration_seconds": 4.28,
      "text": "I haven't had chest pain or recent illness, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.89,
      "end_seconds": 154.74,
      "duration_seconds": 2.85,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.49,
      "end_seconds": 156.96,
      "duration_seconds": 1.47,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.74,
      "end_seconds": 160.53,
      "duration_seconds": 2.79,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.86,
      "end_seconds": 165.08,
      "duration_seconds": 3.22,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.07,
      "end_seconds": 167.27,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.91,
      "end_seconds": 169.61,
      "duration_seconds": 1.7,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.22,
      "end_seconds": 186.15,
      "duration_seconds": 4.93,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.64,
      "end_seconds": 190.45,
      "duration_seconds": 2.81,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.57,
      "end_seconds": 193.98,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.39,
      "end_seconds": 197.77,
      "duration_seconds": 2.38,
      "text": "Yes, kiwi. I get hives."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.81,
      "end_seconds": 220.59,
      "duration_seconds": 4.78,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.79,
      "end_seconds": 237.59,
      "duration_seconds": 11.8,
      "text": "I grab fast food at lunch most days. I live with my elderly mother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.59,
      "end_seconds": 243.88,
      "duration_seconds": 5.29,
      "text": "Right, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.1,
      "end_seconds": 246.51,
      "duration_seconds": 1.41,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.06,
      "end_seconds": 267.14,
      "duration_seconds": 7.08,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.53,
      "end_seconds": 288.88,
      "duration_seconds": 16.35,
      "text": "Okay, that's enough for me. Okay, thinking it through, it fits best with anaphylaxis. I want to be honest that this is an impression, not a final answer. I'm going to order monitoring, for anaphylaxis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.65,
      "end_seconds": 292.48,
      "duration_seconds": 2.83,
      "text": "Mm, do I need to prepare?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.48,
      "end_seconds": 321.97,
      "duration_seconds": 27.49,
      "text": "I'll start you on adrenaline, 0.5 milligrams, once now, single dose. That should help with anaphylaxis. Lie flat with your legs raised, I am giving the injection now. Keep an eye out, and if the symptoms return, call us the same day or go to emergency. We'll catch up straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.03,
      "end_seconds": 327.51,
      "duration_seconds": 3.48,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}