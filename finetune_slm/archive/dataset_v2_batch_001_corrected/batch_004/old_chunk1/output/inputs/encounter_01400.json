      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 145.42,
      "end_seconds": 154.83,
      "duration_seconds": 9.41,
      "text": "I walk the dog every morning. I look after my grandchildren most days. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 155.85,
      "end_seconds": 166.2,
      "duration_seconds": 10.35,
      "text": "okay, so the vitals from earlier heart rate 123, blood pressure 126 over 83, temperature 36.6, oxygen saturation is 96 percent"
    },
