      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.95,
      "end_seconds": 236.91,
      "duration_seconds": 8.96,
      "text": "let me tell you where I've got to i think we're dealing with a possible ectopic pregnancy at this stage"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.04,
      "end_seconds": 244.23,
      "duration_seconds": 3.19,
      "text": "is there something to worry about?"
