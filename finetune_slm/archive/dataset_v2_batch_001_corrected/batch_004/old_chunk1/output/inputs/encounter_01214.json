{
  "schema_version": "1.0",
  "encounter_id": "01214",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.05,
      "duration_seconds": 3.28,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.92,
      "end_seconds": 10.1,
      "duration_seconds": 4.18,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 17.55,
      "duration_seconds": 5.84,
      "text": "yeah, it's hives all over i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.41,
      "end_seconds": 21.44,
      "duration_seconds": 3.03,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.98,
      "end_seconds": 26.64,
      "duration_seconds": 3.66,
      "text": "it's been going on for six months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.7,
      "end_seconds": 34.11,
      "duration_seconds": 5.41,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.4,
      "end_seconds": 39.15,
      "duration_seconds": 3.75,
      "text": "I'd say once or twice a day"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.01,
      "end_seconds": 46.59,
      "duration_seconds": 3.58,
      "text": "how strong would you say it it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.84,
      "end_seconds": 53.3,
      "duration_seconds": 1.46,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.84,
      "end_seconds": 57.71,
      "duration_seconds": 2.87,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.88,
      "end_seconds": 70.53,
      "duration_seconds": 11.65,
      "text": "It usually comes with swollen lips. The swollen lips? That's been for about a week. About swollen lips it happens once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.3,
      "end_seconds": 76.07,
      "duration_seconds": 4.77,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.72,
      "end_seconds": 78.45,
      "duration_seconds": 1.73,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.62,
      "end_seconds": 90.14,
      "duration_seconds": 2.52,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.95,
      "end_seconds": 93.7,
      "duration_seconds": 1.75,
      "text": "nothing regular, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.3,
      "end_seconds": 99.85,
      "duration_seconds": 5.55,
      "text": "Alright, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.22,
      "end_seconds": 106.05,
      "duration_seconds": 2.83,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.55,
      "end_seconds": 108.23,
      "duration_seconds": 1.68,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.56,
      "end_seconds": 113.29,
      "duration_seconds": 3.73,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.21,
      "end_seconds": 118.51,
      "duration_seconds": 4.3,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.31,
      "end_seconds": 123.27,
      "duration_seconds": 3.96,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.47,
      "end_seconds": 143.62,
      "duration_seconds": 5.15,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.52,
      "end_seconds": 148.14,
      "duration_seconds": 3.62,
      "text": "no not that that I know of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.98,
      "end_seconds": 153.92,
      "duration_seconds": 3.94,
      "text": "Any chest pain or recent illness at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.74,
      "end_seconds": 157.93,
      "duration_seconds": 2.19,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.58,
      "end_seconds": 162.84,
      "duration_seconds": 4.26,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.38,
      "end_seconds": 166.66,
      "duration_seconds": 2.28,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.59,
      "end_seconds": 169.96,
      "duration_seconds": 2.37,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.59,
      "end_seconds": 179.42,
      "duration_seconds": 2.83,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.08,
      "end_seconds": 206.19,
      "duration_seconds": 5.11,
      "text": "Okay: BP is 94 over 62, heart rate 112, respiratory rate 20."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.75,
      "end_seconds": 209.37,
      "duration_seconds": 1.62,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.0,
      "end_seconds": 214.24,
      "duration_seconds": 3.24,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.07,
      "end_seconds": 232.32,
      "duration_seconds": 7.25,
      "text": "let me tell you where I've got to i think we're dealing with anaphylaxis at this stage"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.71,
      "end_seconds": 236.91,
      "duration_seconds": 3.2,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.96,
      "end_seconds": 246.39,
      "duration_seconds": 7.43,
      "text": "Nothing I've seen today points to an emergency. It looks like anaphylaxis, but I'd like to to confirm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.55,
      "end_seconds": 262.62,
      "duration_seconds": 9.07,
      "text": "I want monitoring done, that's for anaphylaxis. Let's use adrenaline, 0.5 milligrams, once now, single dose. That should help with anaphylaxis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.11,
      "end_seconds": 272.2,
      "duration_seconds": 4.09,
      "text": "alright, I'll pick it it up today"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.15,
      "end_seconds": 286.04,
      "duration_seconds": 11.89,
      "text": "Lie flat with your legs raised, I am giving the injection now. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.53,
      "end_seconds": 290.4,
      "duration_seconds": 2.87,
      "text": "alright, you know, thank you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.11,
      "end_seconds": 301.33,
      "duration_seconds": 7.22,
      "text": "please come and see me straight away i think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.79,
      "end_seconds": 305.63,
      "duration_seconds": 2.84,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}