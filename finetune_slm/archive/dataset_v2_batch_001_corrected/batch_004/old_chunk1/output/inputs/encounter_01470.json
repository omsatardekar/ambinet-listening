{
  "schema_version": "1.0",
  "encounter_id": "01470",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 3.94,
      "duration_seconds": 3.33,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.69,
      "duration_seconds": 4.51,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.71,
      "end_seconds": 16.34,
      "duration_seconds": 3.63,
      "text": "I've been dealing with a runny nose"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.88,
      "end_seconds": 19.82,
      "duration_seconds": 1.94,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.66,
      "end_seconds": 22.9,
      "duration_seconds": 2.24,
      "text": "I've had it since Monday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.09,
      "end_seconds": 26.61,
      "duration_seconds": 2.52,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.61,
      "end_seconds": 31.78,
      "duration_seconds": 3.17,
      "text": "only tissues, and it's not much"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.21,
      "end_seconds": 32.99,
      "duration_seconds": 0.78,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.88,
      "end_seconds": 48.63,
      "duration_seconds": 3.75,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.67,
      "end_seconds": 56.7,
      "duration_seconds": 6.03,
      "text": "Sorry, what was I saying, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.86,
      "end_seconds": 78.52,
      "duration_seconds": 3.66,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.48,
      "end_seconds": 81.71,
      "duration_seconds": 2.23,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.65,
      "end_seconds": 94.95,
      "duration_seconds": 3.3,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.89,
      "end_seconds": 99.7,
      "duration_seconds": 2.81,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.67,
      "end_seconds": 103.01,
      "duration_seconds": 1.34,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 107.7,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.21,
      "end_seconds": 111.06,
      "duration_seconds": 2.85,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.27,
      "end_seconds": 115.92,
      "duration_seconds": 3.65,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.36,
      "end_seconds": 122.23,
      "duration_seconds": 4.87,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.99,
      "end_seconds": 130.04,
      "duration_seconds": 7.05,
      "text": "It's throat lozenges, when needed. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.6,
      "end_seconds": 147.42,
      "duration_seconds": 4.82,
      "text": "a few quick ones: ear pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.53,
      "end_seconds": 157.99,
      "duration_seconds": 5.46,
      "text": "No ear pain or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.63,
      "end_seconds": 161.9,
      "duration_seconds": 3.27,
      "text": "A few quick ones: fever or chest pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.77,
      "end_seconds": 165.09,
      "duration_seconds": 2.32,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.79,
      "end_seconds": 174.74,
      "duration_seconds": 3.95,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.15,
      "end_seconds": 181.1,
      "duration_seconds": 4.95,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.84,
      "end_seconds": 186.26,
      "duration_seconds": 3.42,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.82,
      "end_seconds": 202.65,
      "duration_seconds": 2.83,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.68,
      "end_seconds": 225.93,
      "duration_seconds": 8.25,
      "text": "Okay: blood pressure 116 over 76, SpO2 97 percent on room air. And pulse 82, temperature 36.6."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.9,
      "end_seconds": 231.75,
      "duration_seconds": 3.85,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.63,
      "end_seconds": 234.33,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.26,
      "end_seconds": 236.43,
      "duration_seconds": 1.17,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.24,
      "end_seconds": 257.31,
      "duration_seconds": 5.07,
      "text": "your throat is a little red and your chest is clear"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.57,
      "end_seconds": 267.71,
      "duration_seconds": 8.14,
      "text": "Thank you, you can get dressed. Okay, thinking it through, it fits best with a simple viral cold."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.35,
      "end_seconds": 271.19,
      "duration_seconds": 2.84,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.45,
      "end_seconds": 303.4,
      "duration_seconds": 30.95,
      "text": "I understand the worry. At the moment I'd say it's a simple viral cold, and we'll watch how it goes. Rest, plenty of fluids, and paracetamol if you ache. If you develop a high fever or trouble breathing, or you feel really unwell, please come to the emergency department. I'd like you back if it is not better in ten days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.49,
      "end_seconds": 308.96,
      "duration_seconds": 3.47,
      "text": "great, thank you for your help"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.84,
      "end_seconds": 312.05,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}