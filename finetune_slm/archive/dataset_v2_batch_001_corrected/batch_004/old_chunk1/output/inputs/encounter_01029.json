    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.7,
      "end_seconds": 87.99,
      "duration_seconds": 1.29,
      "text": "Are you active?"
