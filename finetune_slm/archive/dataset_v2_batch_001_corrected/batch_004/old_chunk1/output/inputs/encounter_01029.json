    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.57,
      "end_seconds": 107.93,
      "duration_seconds": 4.36,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.16,
      "end_seconds": 111.6,
      "duration_seconds": 2.44,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.44,
      "end_seconds": 114.62,
      "duration_seconds": 2.18,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.54,
      "end_seconds": 119.26,
      "duration_seconds": 2.72,
      "text": "no, I'm not on anything"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.11,
      "end_seconds": 140.93,
      "duration_seconds": 4.82,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.54,
      "end_seconds": 143.31,
      "duration_seconds": 1.77,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.42,
      "end_seconds": 154.88,
      "duration_seconds": 2.46,
      "text": "let's start with the basic checks"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.94,
      "end_seconds": 168.38,
      "duration_seconds": 2.44,
      "text": "okay this won't take long.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.29,
      "end_seconds": 192.84,
      "duration_seconds": 10.55,
      "text": "Okay: BP is 122 over 76, SpO2 96 percent on room air, temp 36.7 degrees, pulse is 125 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.76,
      "end_seconds": 200.21,
      "duration_seconds": 5.45,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.87,
      "end_seconds": 218.98,
      "duration_seconds": 1.11,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.87,
      "end_seconds": 222.64,
      "duration_seconds": 1.77,
      "text": "Right, look straight ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.68,
      "end_seconds": 244.78,
      "duration_seconds": 4.1,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.63,
      "end_seconds": 256.08,
      "duration_seconds": 6.45,
      "text": "All finished, thank you. Okay, thinking it through, my working impression is diabetic ketoacidosis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.03,
      "end_seconds": 259.34,
      "duration_seconds": 2.31,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.6,
      "end_seconds": 273.66,
      "duration_seconds": 12.06,
      "text": "I can't promise yet, but most people with diabetic ketoacidosis do well once it's treated properly. I want a blood sugar and ketone test done, that's for thirst and vomiting."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 275.6,
      "end_seconds": 278.29,
      "duration_seconds": 2.69,
      "text": "The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.61,
      "end_seconds": 288.6,
      "duration_seconds": 6.99,
      "text": "You need to go to hospital now for insulin and fluids. Book a review straight away."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.49,
      "end_seconds": 292.61,
      "duration_seconds": 2.12,
      "text": "I can manage that"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.59,
      "end_seconds": 297.31,
      "duration_seconds": 3.72,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.11,
      "end_seconds": 300.97,
      "duration_seconds": 2.86,
      "text": "I think I understand everything. Thanks."
    },
