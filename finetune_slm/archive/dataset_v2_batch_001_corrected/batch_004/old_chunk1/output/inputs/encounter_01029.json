    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.92,
      "end_seconds": 94.11,
      "duration_seconds": 3.19,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.0,
      "end_seconds": 97.93,
      "duration_seconds": 1.93,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.93,
      "end_seconds": 102.98,
      "duration_seconds": 4.05,
      "text": "I grab fast food at lunch most days."
