      "role": "DOCTOR",
      "start_seconds": 70.98,
      "end_seconds": 72.22,
      "duration_seconds": 1.24,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.46,
      "end_seconds": 76.7,
      "duration_seconds": 3.24,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.63,
      "end_seconds": 80.73,
      "duration_seconds": 3.1,
      "text": "What do you do during the day?"
