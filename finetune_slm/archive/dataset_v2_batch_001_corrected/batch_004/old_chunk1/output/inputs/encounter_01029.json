    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.38,
      "end_seconds": 84.61,
      "duration_seconds": 3.23,
      "text": "I look after my grandchildren most days."
