      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.14,
      "end_seconds": 42.61,
      "duration_seconds": 2.47,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.45,
      "end_seconds": 51.15,
      "duration_seconds": 2.7,
      "text": "nothing on the skin, no"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.15,
      "end_seconds": 65.08,
      "duration_seconds": 1.93,
      "text": "Do you drink alcohol?"
