{
  "schema_version": "1.0",
  "encounter_id": "01222",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.97,
      "end_seconds": 7.52,
      "duration_seconds": 6.55,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.46,
      "end_seconds": 13.64,
      "duration_seconds": 4.18,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.32,
      "end_seconds": 20.11,
      "duration_seconds": 5.79,
      "text": "Uh, so the thing is, I've got shoulder tip pain."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 20.63,
      "end_seconds": 27.51,
      "duration_seconds": 6.88,
      "text": "Doctor, I've got the readings for you. Heart rate 122, pressure 112 over 70, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.79,
      "end_seconds": 29.85,
      "duration_seconds": 1.06,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.61,
      "end_seconds": 50.72,
      "duration_seconds": 4.11,
      "text": "So, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.34,
      "end_seconds": 54.18,
      "duration_seconds": 2.84,
      "text": "It's been two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.01,
      "end_seconds": 59.99,
      "duration_seconds": 4.98,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.32,
      "end_seconds": 68.46,
      "duration_seconds": 7.14,
      "text": "About a four out of ten. It happens a few times a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.16,
      "end_seconds": 73.06,
      "duration_seconds": 2.9,
      "text": "Any light vaginal bleeding as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 96.45,
      "duration_seconds": 22.26,
      "text": "Um, yes, for about three months. As for sharp pain low on one side, I honestly can't say when that began. It might have been last month or the month before. As for sharp pain low on one side, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.55,
      "end_seconds": 100.31,
      "duration_seconds": 2.76,
      "text": "Have you noticed fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 102.24,
      "end_seconds": 106.07,
      "duration_seconds": 3.83,
      "text": "No, um, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.02,
      "end_seconds": 110.73,
      "duration_seconds": 2.71,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.26,
      "end_seconds": 115.99,
      "duration_seconds": 1.73,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.61,
      "end_seconds": 119.58,
      "duration_seconds": 1.97,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.21,
      "end_seconds": 122.22,
      "duration_seconds": 1.01,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.6,
      "end_seconds": 132.78,
      "duration_seconds": 1.18,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.55,
      "end_seconds": 138.41,
      "duration_seconds": 3.86,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.95,
      "end_seconds": 141.94,
      "duration_seconds": 1.99,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.96,
      "end_seconds": 148.11,
      "duration_seconds": 5.15,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.97,
      "end_seconds": 150.92,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.59,
      "end_seconds": 156.42,
      "duration_seconds": 3.83,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.42,
      "end_seconds": 160.74,
      "duration_seconds": 2.32,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.42,
      "end_seconds": 172.71,
      "duration_seconds": 9.29,
      "text": "Lansoprazole. I take it 30 milligrams, before breakfast for my acidity. I used to take omeprazole, but I stopped it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.76,
      "end_seconds": 186.29,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.74,
      "end_seconds": 191.26,
      "duration_seconds": 3.52,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.92,
      "end_seconds": 196.64,
      "duration_seconds": 3.72,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.23,
      "end_seconds": 199.22,
      "duration_seconds": 1.99,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.82,
      "end_seconds": 202.16,
      "duration_seconds": 2.34,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.87,
      "end_seconds": 205.09,
      "duration_seconds": 2.22,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.16,
      "end_seconds": 213.45,
      "duration_seconds": 7.29,
      "text": "Okay, I can see acid reflux in your file as well. Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.97,
      "end_seconds": 223.94,
      "duration_seconds": 8.97,
      "text": "I had my tonsils removed as a teenager. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.35,
      "end_seconds": 227.53,
      "duration_seconds": 2.18,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.39,
      "end_seconds": 229.72,
      "duration_seconds": 1.33,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.34,
      "end_seconds": 243.07,
      "duration_seconds": 4.73,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.83,
      "end_seconds": 246.54,
      "duration_seconds": 1.71,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.38,
      "end_seconds": 260.82,
      "duration_seconds": 10.44,
      "text": "Good, you can sit up again. Let me tell you where I've got to. I think we're dealing with a possible ectopic pregnancy at this stage."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.71,
      "end_seconds": 265.84,
      "duration_seconds": 3.13,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.25,
      "end_seconds": 275.19,
      "duration_seconds": 7.94,
      "text": "I can't promise yet, but most people with a possible ectopic pregnancy do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 276.08,
      "end_seconds": 282.69,
      "duration_seconds": 6.61,
      "text": "Doctor, I did a pregnancy test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.27,
      "end_seconds": 298.94,
      "duration_seconds": 14.67,
      "text": "Thanks, that helps. I think an urgent pelvic scan makes sense here, for possible ectopic. You need to go to the hospital now for an emergency scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.01,
      "end_seconds": 303.53,
      "duration_seconds": 3.52,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}