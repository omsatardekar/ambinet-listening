{
  "schema_version": "1.0",
  "encounter_id": "01159",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 6.53,
      "duration_seconds": 5.86,
      "text": "Ah, uh, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.5,
      "end_seconds": 13.36,
      "duration_seconds": 4.86,
      "text": "Right, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.92,
      "end_seconds": 18.93,
      "duration_seconds": 4.01,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.65,
      "end_seconds": 22.64,
      "duration_seconds": 2.99,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.99,
      "end_seconds": 35.82,
      "duration_seconds": 11.83,
      "text": "Honestly, it's a blocked ear, and my family pushed me to come. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.08,
      "end_seconds": 42.0,
      "duration_seconds": 2.92,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.12,
      "end_seconds": 46.81,
      "duration_seconds": 3.69,
      "text": "Ever since... since last night, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.73,
      "end_seconds": 52.31,
      "duration_seconds": 3.58,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.56,
      "end_seconds": 74.74,
      "duration_seconds": 19.18,
      "text": "Erm, a five out of ten, I suppose. Sorry, what was I saying, and there's a feeling of fullness as well, about a week now. Okay, so about feeling of fullness, severe, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 75.74,
      "end_seconds": 78.21,
      "duration_seconds": 2.47,
      "text": "Mm, that's what happened, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 79.61,
      "end_seconds": 87.7,
      "duration_seconds": 8.09,
      "text": "Okay, so the vitals from earlier. Heart rate 69, pressure 109 over 68, saturation 97 percent. Temp 36.5 degrees."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.27,
      "end_seconds": 89.97,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.56,
      "end_seconds": 93.85,
      "duration_seconds": 2.29,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.95,
      "end_seconds": 97.77,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.0,
      "end_seconds": 110.81,
      "duration_seconds": 4.81,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.98,
      "end_seconds": 117.07,
      "duration_seconds": 2.09,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.11,
      "end_seconds": 134.14,
      "duration_seconds": 4.03,
      "text": "And what about discharge, ringing, ear pain or dizziness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.95,
      "end_seconds": 150.46,
      "duration_seconds": 14.51,
      "text": "No, no discharge, no ringing, no ear pain. I did have muffled hearing on one side at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.48,
      "end_seconds": 153.03,
      "duration_seconds": 1.55,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.98,
      "end_seconds": 156.57,
      "duration_seconds": 1.59,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.67,
      "end_seconds": 161.44,
      "duration_seconds": 3.77,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.15,
      "end_seconds": 170.04,
      "duration_seconds": 6.89,
      "text": "Ah, you know, I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 172.11,
      "end_seconds": 182.38,
      "duration_seconds": 10.27,
      "text": "Doctor, I think the last prescription for the metoprolol was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.0,
      "end_seconds": 186.71,
      "duration_seconds": 3.71,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.21,
      "end_seconds": 197.8,
      "duration_seconds": 9.59,
      "text": "I don't think I have it with me. I'm on olive oil drops, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.51,
      "end_seconds": 203.58,
      "duration_seconds": 2.07,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.26,
      "end_seconds": 208.66,
      "duration_seconds": 4.4,
      "text": "Heart disease, for two years. Yes, epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.23,
      "end_seconds": 213.52,
      "duration_seconds": 4.29,
      "text": "Alright, heart disease, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.41,
      "end_seconds": 229.7,
      "duration_seconds": 1.29,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.39,
      "end_seconds": 235.62,
      "duration_seconds": 4.23,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.58,
      "end_seconds": 238.39,
      "duration_seconds": 0.81,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.25,
      "end_seconds": 247.24,
      "duration_seconds": 3.99,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.52,
      "end_seconds": 249.81,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.64,
      "end_seconds": 254.8,
      "duration_seconds": 3.16,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.36,
      "end_seconds": 259.15,
      "duration_seconds": 2.79,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.83,
      "end_seconds": 265.84,
      "duration_seconds": 5.01,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.81,
      "end_seconds": 272.07,
      "duration_seconds": 4.26,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.08,
      "end_seconds": 275.15,
      "duration_seconds": 2.07,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.68,
      "end_seconds": 289.03,
      "duration_seconds": 12.35,
      "text": "Okay, so my impression is this: I'd lean towards earwax blocking the ear. It could also be a middle ear fluid, so we'll keep that open."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.66,
      "end_seconds": 292.94,
      "duration_seconds": 2.28,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.65,
      "end_seconds": 325.42,
      "duration_seconds": 30.77,
      "text": "Nothing I've seen today points to an emergency. It looks like earwax blocking the ear, but I'd like to confirm. Ear irrigation is what I'd like next, for wax. I'd rather check than guess, and this is the quickest way to know more. Use the olive oil drops for a week and then we'll syringe the ear. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.95,
      "end_seconds": 335.03,
      "duration_seconds": 8.08,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.6,
      "end_seconds": 337.48,
      "duration_seconds": 1.88,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.1,
      "end_seconds": 347.1,
      "duration_seconds": 9.0,
      "text": "I'd like you back in one week. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.12,
      "end_seconds": 351.98,
      "duration_seconds": 2.86,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.9,
      "end_seconds": 356.23,
      "duration_seconds": 2.33,
      "text": "So, have a good day."
    }
  ]
}