{
  "schema_version": "1.0",
  "encounter_id": "01369",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.05,
      "duration_seconds": 3.29,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.27,
      "end_seconds": 13.59,
      "duration_seconds": 5.32,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.89,
      "end_seconds": 20.99,
      "duration_seconds": 6.1,
      "text": "Honestly, it's a sore ankle, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.85,
      "end_seconds": 25.82,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.2,
      "end_seconds": 35.49,
      "duration_seconds": 3.29,
      "text": "It's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.33,
      "end_seconds": 46.5,
      "duration_seconds": 9.17,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.62,
      "end_seconds": 51.56,
      "duration_seconds": 3.94,
      "text": "Severe, really. I notice it more with walking."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.37,
      "end_seconds": 56.23,
      "duration_seconds": 2.86,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.32,
      "end_seconds": 61.58,
      "duration_seconds": 3.26,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.36,
      "end_seconds": 74.14,
      "duration_seconds": 2.78,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.51,
      "end_seconds": 78.52,
      "duration_seconds": 3.01,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.56,
      "end_seconds": 84.41,
      "duration_seconds": 3.85,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.01,
      "end_seconds": 87.75,
      "duration_seconds": 1.74,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.1,
      "end_seconds": 97.69,
      "duration_seconds": 4.59,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.35,
      "end_seconds": 114.19,
      "duration_seconds": 14.84,
      "text": "I smoke roughly a pack every two days. My partner and our baby. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.64,
      "end_seconds": 133.62,
      "duration_seconds": 5.98,
      "text": "A few quick ones: numbness, pain in the foot or crack or pop?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.17,
      "end_seconds": 141.42,
      "duration_seconds": 6.25,
      "text": "No, no numbness, pain in the foot or crack or pop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.32,
      "end_seconds": 146.68,
      "duration_seconds": 3.36,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.97,
      "end_seconds": 152.23,
      "duration_seconds": 4.26,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.57,
      "end_seconds": 156.48,
      "duration_seconds": 2.91,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 167.71,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.56,
      "end_seconds": 197.72,
      "duration_seconds": 10.16,
      "text": "Okay: temperature 36.7, pulse is 77 beats a minute, blood pressure 112 over 69, respiratory rate 18, saturation 99 percent."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.84,
      "end_seconds": 202.91,
      "duration_seconds": 3.07,
      "text": "So, may I examine you now?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.8,
      "end_seconds": 207.45,
      "duration_seconds": 2.65,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.11,
      "end_seconds": 226.18,
      "duration_seconds": 7.07,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.64,
      "end_seconds": 233.32,
      "duration_seconds": 2.68,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.0,
      "end_seconds": 266.64,
      "duration_seconds": 17.64,
      "text": "Okay, thinking it through, it fits best with a mild ankle sprain. Let me repeat that back to make sure. You've had a sore ankle for six months, severe, and no numbness or crack or pop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.55,
      "end_seconds": 268.25,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.58,
      "end_seconds": 285.58,
      "duration_seconds": 16.0,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. Please don't wait if you cannot put weight on it. That's when to be seen urgently. Come back if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.57,
      "end_seconds": 288.87,
      "duration_seconds": 2.3,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.74,
      "end_seconds": 294.38,
      "duration_seconds": 3.64,
      "text": "What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.12,
      "end_seconds": 303.32,
      "duration_seconds": 7.2,
      "text": "So, I come back if it is not better in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.99,
      "end_seconds": 310.91,
      "duration_seconds": 6.92,
      "text": "Okay, yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.47,
      "end_seconds": 315.46,
      "duration_seconds": 3.99,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}