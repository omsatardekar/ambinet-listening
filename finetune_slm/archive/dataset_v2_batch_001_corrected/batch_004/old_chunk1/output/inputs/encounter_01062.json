  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.58,
      "duration_seconds": 5.45,
      "text": "So, uh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.17,
      "end_seconds": 12.53,
      "duration_seconds": 4.36,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.93,
      "end_seconds": 20.4,
      "duration_seconds": 6.47,
      "text": "Morning, um, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.19,
      "end_seconds": 35.53,
      "duration_seconds": 10.34,
      "text": "I mean, mainly being very thirsty. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.43,
      "end_seconds": 41.54,
      "duration_seconds": 5.11,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.76,
      "end_seconds": 70.39,
      "duration_seconds": 27.63,
      "text": "Ah, pretty moderate, if I'm being honest. It settles a little with water. And deep fast breathing, too. Sorry, you know, what was I saying, and I've been passing a lot of urine as well. Hmm, about passing a lot of urine, I'd call it mild."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.48,
      "end_seconds": 74.73,
      "duration_seconds": 3.25,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.69,
      "end_seconds": 91.11,
      "duration_seconds": 2.42,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.89,
      "end_seconds": 116.86,
      "duration_seconds": 13.97,
      "text": "Okay: weight 55 kilos, BMI works out to 24.1, pulse is 115 beats a a minute, height 151 centimetres, saturation 99 percent, temperature is 36.7 degrees, blood pressure 131 over 72."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.51,
      "end_seconds": 119.24,
      "duration_seconds": 1.73,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.55,
      "end_seconds": 122.79,
      "duration_seconds": 2.24,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.36,
      "end_seconds": 129.36,
      "duration_seconds": 4.0,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.49,
      "end_seconds": 131.72,
      "duration_seconds": 1.23,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.48,
      "end_seconds": 134.95,
      "duration_seconds": 1.47,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.85,
      "end_seconds": 146.96,
      "duration_seconds": 4.11,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.8,
      "end_seconds": 154.71,
      "duration_seconds": 1.91,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.26,
      "end_seconds": 170.1,
      "duration_seconds": 2.84,
      "text": "did you get chest pain or cough?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.6,
      "end_seconds": 174.75,
      "duration_seconds": 4.15,
      "text": "Right, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.77,
      "end_seconds": 179.23,
      "duration_seconds": 2.46,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.95,
      "end_seconds": 182.7,
      "duration_seconds": 2.75,
      "text": "actually, no, all normal there"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.72,
      "end_seconds": 194.6,
      "duration_seconds": 2.88,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.77,
      "end_seconds": 196.9,
      "duration_seconds": 1.13,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.51,
      "end_seconds": 207.1,
      "duration_seconds": 9.59,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 209.01,
      "end_seconds": 216.99,
      "duration_seconds": 7.98,
      "text": "He is on Glycomet, 500 milligrams, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.05,
      "end_seconds": 225.84,
      "duration_seconds": 6.79,
      "text": "Erm, um, I was on sitagliptin before. I stopped taking it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.4,
      "end_seconds": 227.81,
      "duration_seconds": 1.41,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.65,
      "end_seconds": 234.28,
      "duration_seconds": 4.63,
      "text": "nothing, uh, I haven't had any operations"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.09,
      "end_seconds": 255.82,
      "duration_seconds": 2.73,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.42,
      "end_seconds": 277.06,
      "duration_seconds": 15.64,
      "text": "I've never touched a cigarette. I drink a lot of tea and snack through the day. My husband and I live above the shop. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.54,
      "end_seconds": 285.04,
      "duration_seconds": 3.5,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.38,
      "end_seconds": 289.31,
      "duration_seconds": 2.93,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.53,
      "end_seconds": 296.96,
      "duration_seconds": 6.43,
      "text": "From what you've told me and what I found, the most likely explanation is diabetic ketoacidosis."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.65,
      "end_seconds": 301.19,
      "duration_seconds": 3.54,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.52,
      "end_seconds": 321.03,
      "duration_seconds": 18.51,
      "text": "Nothing I've seen today points to an emergency. It looks like diabetic ketoacidosis, but I'd like to confirm. Blood gas and electrolytes is what I'd like next, for DKA. I'd like to arrange a blood sugar and ketone test for thirst and vomiting."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.82,
      "end_seconds": 325.52,
      "duration_seconds": 2.7,
      "text": "how long will it take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.83,
      "end_seconds": 339.18,
      "duration_seconds": 12.35,
      "text": "you need to go to hospital now for insulin and fluids. Come back or go to emergency straight away if you cannot get there now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.12,
      "end_seconds": 343.73,
      "duration_seconds": 3.61,
      "text": "Okay, so thank you, that's clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.93,
      "end_seconds": 349.76,
      "duration_seconds": 4.83,
      "text": "Come back straight away. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.53,
      "end_seconds": 353.0,
      "duration_seconds": 2.47,
      "text": "alright, thanks, take care"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.56,
      "end_seconds": 356.37,
      "duration_seconds": 1.81,
      "text": "Alright, goodbye for now."
    }
  ]
