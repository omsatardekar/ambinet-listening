{
  "schema_version": "1.0",
  "encounter_id": "01346",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 6.4,
      "duration_seconds": 5.4,
      "text": "Yeah, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.63,
      "end_seconds": 13.44,
      "duration_seconds": 3.81,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.82,
      "end_seconds": 17.76,
      "duration_seconds": 2.94,
      "text": "So, I've been feeling faint, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.86,
      "end_seconds": 27.76,
      "duration_seconds": 3.9,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.83,
      "end_seconds": 31.74,
      "duration_seconds": 2.91,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.13,
      "end_seconds": 36.27,
      "duration_seconds": 4.14,
      "text": "I see, go ahead okay, have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.8,
      "end_seconds": 41.27,
      "duration_seconds": 3.47,
      "text": "Mm, I notice it more with standing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.96,
      "end_seconds": 45.2,
      "duration_seconds": 2.24,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.06,
      "end_seconds": 52.51,
      "duration_seconds": 5.45,
      "text": "Stomach pain goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.51,
      "end_seconds": 59.89,
      "duration_seconds": 2.38,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.51,
      "end_seconds": 69.11,
      "duration_seconds": 7.6,
      "text": "Honestly, a few times a day. Uh, I've also had black tarry stools."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.77,
      "end_seconds": 86.49,
      "duration_seconds": 4.72,
      "text": "So, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.06,
      "end_seconds": 90.03,
      "duration_seconds": 2.97,
      "text": "Right, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.99,
      "end_seconds": 94.68,
      "duration_seconds": 2.69,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.65,
      "end_seconds": 114.82,
      "duration_seconds": 16.17,
      "text": "Paracetamol. I take it 650 milligrams, when needed for the knee pain. Atorvastatin, 20 milligrams, at night. I didn't want to bother you but it keeps coming back"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.38,
      "end_seconds": 118.76,
      "duration_seconds": 2.38,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.99,
      "end_seconds": 125.12,
      "duration_seconds": 5.13,
      "text": "I've had arthritis in my knees for five years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.61,
      "end_seconds": 127.7,
      "duration_seconds": 1.09,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.43,
      "end_seconds": 133.5,
      "duration_seconds": 5.07,
      "text": "hmm, I have high cholesterol, for about ten years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.04,
      "end_seconds": 135.86,
      "duration_seconds": 1.82,
      "text": "Okay, and besides that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.79,
      "end_seconds": 139.16,
      "duration_seconds": 1.37,
      "text": "I've got gout."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.19,
      "end_seconds": 148.88,
      "duration_seconds": 7.69,
      "text": "Okay, I can see arthritis in your knees and high cholesterol in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.76,
      "end_seconds": 153.22,
      "duration_seconds": 3.46,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.74,
      "end_seconds": 167.7,
      "duration_seconds": 4.96,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.67,
      "end_seconds": 185.78,
      "duration_seconds": 17.11,
      "text": "I only drink at family occasions. No, I've never smoked in my life. I'm vegetarian and have been for years. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.17,
      "end_seconds": 189.94,
      "duration_seconds": 2.77,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.18,
      "end_seconds": 193.78,
      "duration_seconds": 2.6,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.43,
      "end_seconds": 199.8,
      "duration_seconds": 4.37,
      "text": "let me check a few things any fever or chest pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.65,
      "end_seconds": 203.59,
      "duration_seconds": 2.94,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.8,
      "end_seconds": 208.27,
      "duration_seconds": 3.47,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.05,
      "end_seconds": 211.9,
      "duration_seconds": 2.85,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.62,
      "end_seconds": 216.01,
      "duration_seconds": 3.39,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.92,
      "end_seconds": 227.54,
      "duration_seconds": 3.62,
      "text": "so, that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.03,
      "end_seconds": 255.15,
      "duration_seconds": 12.12,
      "text": "Okay: BP is 115 over 75, weight 71 kilos, height 176 centimetres, BMI works out to 22.9, temp 37.1 degrees, pulse 113."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.94,
      "end_seconds": 261.99,
      "duration_seconds": 4.05,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.81,
      "end_seconds": 263.85,
      "duration_seconds": 1.04,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.99,
      "end_seconds": 266.27,
      "duration_seconds": 1.28,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.3,
      "end_seconds": 289.88,
      "duration_seconds": 7.58,
      "text": "You look pale, your pulse is fast and and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.8,
      "end_seconds": 311.29,
      "duration_seconds": 16.49,
      "text": "Thank you, you can get dressed. Let me tell you where I've got to. This looks most like a possible bleeding stomach ulcer. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.85,
      "end_seconds": 343.12,
      "duration_seconds": 15.27,
      "text": "I'm sending you for urgent blood tests because of bleeding please stop the ibuprofen and do not eat or drink see me again straight away anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.08,
      "end_seconds": 349.15,
      "duration_seconds": 2.07,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.5,
      "end_seconds": 353.31,
      "duration_seconds": 1.81,
      "text": "Have a good day."
    }
  ]
}