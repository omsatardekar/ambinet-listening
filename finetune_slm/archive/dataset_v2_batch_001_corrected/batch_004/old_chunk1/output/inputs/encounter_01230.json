    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.68,
      "end_seconds": 199.79,
      "duration_seconds": 4.11,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.62,
      "end_seconds": 202.64,
      "duration_seconds": 2.02,
      "text": "I've, I've got diabetes."
