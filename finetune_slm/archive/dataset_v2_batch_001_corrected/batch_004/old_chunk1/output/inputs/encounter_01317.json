{
  "schema_version": "1.0",
  "encounter_id": "01317",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 5.06,
      "duration_seconds": 4.45,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 9.96,
      "duration_seconds": 3.84,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.37,
      "end_seconds": 17.69,
      "duration_seconds": 6.32,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.55,
      "end_seconds": 23.17,
      "duration_seconds": 3.62,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.2,
      "end_seconds": 32.02,
      "duration_seconds": 7.82,
      "text": "Oh, honestly, it's my face drooping on one side, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.89,
      "end_seconds": 37.18,
      "duration_seconds": 3.29,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.24,
      "end_seconds": 39.78,
      "duration_seconds": 1.54,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.73,
      "end_seconds": 45.16,
      "duration_seconds": 3.43,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.0,
      "end_seconds": 47.71,
      "duration_seconds": 1.71,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.21,
      "end_seconds": 51.46,
      "duration_seconds": 2.25,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.16,
      "end_seconds": 58.68,
      "duration_seconds": 6.52,
      "text": "When it starts I tend to get weakness in my right arm as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.4,
      "end_seconds": 63.64,
      "duration_seconds": 4.24,
      "text": "What about a sudden headache, have you noticed that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.63,
      "end_seconds": 74.04,
      "duration_seconds": 9.41,
      "text": "Yes, since Monday. I've also had slurred speech, for three weeks. With weakness in my right arm, mild, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.84,
      "end_seconds": 93.13,
      "duration_seconds": 4.29,
      "text": "Right, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.06,
      "end_seconds": 99.23,
      "duration_seconds": 5.17,
      "text": "My sister had breast cancer. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.98,
      "end_seconds": 104.94,
      "duration_seconds": 4.96,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.95,
      "end_seconds": 124.75,
      "duration_seconds": 17.8,
      "text": "I take warfarin, 3 milligrams, in the evening for the blood thinning. I just want to get back to normal, really. I take ramipril, 5 milligrams, every morning. Before this I was on telmisartan; that's been stopped."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.2,
      "end_seconds": 128.48,
      "duration_seconds": 2.28,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.48,
      "end_seconds": 134.95,
      "duration_seconds": 4.47,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.75,
      "end_seconds": 149.17,
      "duration_seconds": 4.42,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.67,
      "end_seconds": 152.86,
      "duration_seconds": 2.19,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 154.92,
      "end_seconds": 162.68,
      "duration_seconds": 7.76,
      "text": "Hold on, doctor, I think she reacted to erythromycin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.58,
      "end_seconds": 166.52,
      "duration_seconds": 2.94,
      "text": "Right, I don't remember that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.59,
      "end_seconds": 171.63,
      "duration_seconds": 3.04,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.79,
      "end_seconds": 185.55,
      "duration_seconds": 1.76,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.83,
      "end_seconds": 188.4,
      "duration_seconds": 1.57,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.87,
      "end_seconds": 191.26,
      "duration_seconds": 1.39,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.82,
      "end_seconds": 194.6,
      "duration_seconds": 2.78,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.56,
      "end_seconds": 198.56,
      "duration_seconds": 2.0,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.34,
      "end_seconds": 203.74,
      "duration_seconds": 4.4,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.6,
      "end_seconds": 208.85,
      "duration_seconds": 3.25,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.4,
      "end_seconds": 213.57,
      "duration_seconds": 3.17,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.49,
      "end_seconds": 219.07,
      "duration_seconds": 3.58,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.48,
      "end_seconds": 224.42,
      "duration_seconds": 3.94,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.09,
      "end_seconds": 228.48,
      "duration_seconds": 2.39,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.57,
      "end_seconds": 235.26,
      "duration_seconds": 5.69,
      "text": "I've had an irregular heartbeat, yes. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.23,
      "end_seconds": 238.63,
      "duration_seconds": 1.4,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.67,
      "end_seconds": 250.55,
      "duration_seconds": 10.88,
      "text": "Okay, I can see an irregular heartbeat and high blood pressure in your file as well. Have you noticed loss of consciousness or fever?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.47,
      "end_seconds": 258.41,
      "duration_seconds": 1.94,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.38,
      "end_seconds": 262.73,
      "duration_seconds": 2.35,
      "text": "And seizure, any of that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.76,
      "end_seconds": 267.9,
      "duration_seconds": 3.14,
      "text": "Not that I've noticed, no seizure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.95,
      "end_seconds": 273.27,
      "duration_seconds": 3.32,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.34,
      "end_seconds": 276.34,
      "duration_seconds": 2.0,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.21,
      "end_seconds": 279.74,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.1,
      "end_seconds": 295.02,
      "duration_seconds": 2.92,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.88,
      "end_seconds": 324.31,
      "duration_seconds": 8.43,
      "text": "Okay: blood pressure 163 over 89, temp 36.5 degrees, pulse is 79 beats a minute, respiratory rate 16."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.18,
      "end_seconds": 327.55,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.85,
      "end_seconds": 356.0,
      "duration_seconds": 25.15,
      "text": "They help me see the whole picture, more shortly. Going by what you've described, my working impression is a possible stroke, within the treatment window. I'd also keep a migraine with aura in mind. I'll request a blood sugar test, it'll help with stroke symptoms. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.72,
      "end_seconds": 359.19,
      "duration_seconds": 1.47,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.26,
      "end_seconds": 386.09,
      "duration_seconds": 24.83,
      "text": "An urgent CT scan of the head is what I'd like next, for possible stroke. Call an ambulance now, you need hospital immediately. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. I'm going to send a referral to the stroke team. See me again straight away."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.89,
      "end_seconds": 389.25,
      "duration_seconds": 2.36,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.74,
      "end_seconds": 395.43,
      "duration_seconds": 2.69,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.22,
      "end_seconds": 399.43,
      "duration_seconds": 2.21,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.77,
      "end_seconds": 402.2,
      "duration_seconds": 1.43,
      "text": "Goodbye for now."
    }
  ]
}