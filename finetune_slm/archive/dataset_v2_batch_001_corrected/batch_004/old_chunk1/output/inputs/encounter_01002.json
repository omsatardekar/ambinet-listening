{
  "schema_version": "1.0",
  "encounter_id": "01002",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.96,
      "end_seconds": 4.81,
      "duration_seconds": 3.85,
      "text": "Morning, doctor. I've settled them in, ready when you are."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.62,
      "duration_seconds": 4.13,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.49,
      "end_seconds": 19.65,
      "duration_seconds": 6.16,
      "text": "It's skipped beats. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.33,
      "end_seconds": 23.77,
      "duration_seconds": 3.44,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.1,
      "end_seconds": 28.63,
      "duration_seconds": 3.53,
      "text": "Hmm, it's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.15,
      "end_seconds": 35.13,
      "duration_seconds": 4.98,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.89,
      "end_seconds": 69.14,
      "duration_seconds": 33.25,
      "text": "I notice it more with lying down and caffeine. Deep breaths helps a bit. I'd give it a three, uh, out of ten. I told myself I'd wait and see, and here I am. I'm hoping you can tell me something definite. Actually, I've had a flutter in my chest too, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.18,
      "end_seconds": 74.44,
      "duration_seconds": 3.26,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.77,
      "end_seconds": 92.24,
      "duration_seconds": 16.47,
      "text": "Ah, pretty mild, if I'm being honest. Oh, you know, and being a bit anxious. That's been about the same, about three months. As for being a bit anxious, it's moderate, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.46,
      "end_seconds": 93.22,
      "duration_seconds": 0.76,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.19,
      "end_seconds": 112.8,
      "duration_seconds": 3.61,
      "text": "Have you had any shortness of breath or fainting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.5,
      "end_seconds": 119.6,
      "duration_seconds": 5.1,
      "text": "I haven't had shortness of breath or fainting, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.33,
      "end_seconds": 124.43,
      "duration_seconds": 3.1,
      "text": "Did you get chest pain or dizziness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 125.38,
      "end_seconds": 129.24,
      "duration_seconds": 3.86,
      "text": "Erm, um, nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.05,
      "end_seconds": 135.77,
      "duration_seconds": 4.72,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.22,
      "end_seconds": 142.23,
      "duration_seconds": 5.01,
      "text": "Okay, uh, so bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.59,
      "end_seconds": 160.3,
      "duration_seconds": 3.71,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.99,
      "end_seconds": 166.23,
      "duration_seconds": 4.24,
      "text": "No, uh, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.07,
      "end_seconds": 172.04,
      "duration_seconds": 4.97,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.61,
      "end_seconds": 177.21,
      "duration_seconds": 4.6,
      "text": "I take metoprolol, 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.37,
      "end_seconds": 179.54,
      "duration_seconds": 1.17,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.55,
      "end_seconds": 189.23,
      "duration_seconds": 8.68,
      "text": "About two years. Uh, I take iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.05,
      "end_seconds": 193.5,
      "duration_seconds": 2.45,
      "text": "Alright, how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.58,
      "end_seconds": 199.61,
      "duration_seconds": 4.03,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.49,
      "end_seconds": 204.63,
      "duration_seconds": 3.14,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.25,
      "end_seconds": 210.55,
      "duration_seconds": 4.3,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.98,
      "end_seconds": 223.19,
      "duration_seconds": 7.21,
      "text": "Do you have any long-term conditions? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.99,
      "end_seconds": 241.94,
      "duration_seconds": 17.95,
      "text": "Heart disease, for nearly five years. I've got low haemoglobin. I, I have high blood pressure. My sister suggested writing things down, but I forgot. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.75,
      "end_seconds": 251.63,
      "duration_seconds": 7.88,
      "text": "Yes, low haemoglobin and high blood pressure are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 253.62,
      "end_seconds": 263.56,
      "duration_seconds": 9.94,
      "text": "Here are the numbers, doctor. Heart rate 68, oxygen saturation is 99 percent, height 163 centimetres, pressure 111 over 82, weight 67 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.4,
      "end_seconds": 266.97,
      "duration_seconds": 1.57,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.64,
      "end_seconds": 272.89,
      "duration_seconds": 4.25,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.79,
      "end_seconds": 284.78,
      "duration_seconds": 0.99,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.33,
      "end_seconds": 287.91,
      "duration_seconds": 1.58,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.48,
      "end_seconds": 308.34,
      "duration_seconds": 4.86,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.69,
      "end_seconds": 321.73,
      "duration_seconds": 9.04,
      "text": "That's the examination finished. Putting it all together, this is probably harmless extra heartbeats. We shouldn't forget an anxiety-related palpitation."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.61,
      "end_seconds": 328.77,
      "duration_seconds": 3.16,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.7,
      "end_seconds": 357.9,
      "duration_seconds": 27.2,
      "text": "I understand the worry. At the moment I'd say it's harmless extra heartbeats, and we'll know more once the an ECG is back. I think an ECG makes sense here, for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens. See me again if it carries on after a month. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 359.92,
      "end_seconds": 363.49,
      "duration_seconds": 3.57,
      "text": "Thank you, you know, doctor, goodbye."
    }
  ]
}