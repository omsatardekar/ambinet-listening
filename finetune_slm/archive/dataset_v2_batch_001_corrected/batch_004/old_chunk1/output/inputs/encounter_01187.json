{
  "schema_version": "1.0",
  "encounter_id": "01187",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.35,
      "end_seconds": 5.26,
      "duration_seconds": 3.91,
      "text": "Sorry I'm a little late, you know, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 12.02,
      "duration_seconds": 5.36,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.96,
      "end_seconds": 23.14,
      "duration_seconds": 9.18,
      "text": "I'm here because of a high fever. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.94,
      "end_seconds": 26.97,
      "duration_seconds": 3.03,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.61,
      "end_seconds": 36.54,
      "duration_seconds": 8.93,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.02,
      "end_seconds": 43.8,
      "duration_seconds": 2.78,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.92,
      "end_seconds": 52.71,
      "duration_seconds": 7.79,
      "text": "I'd say a few times a day. I've also had pain much worse than it looks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.93,
      "end_seconds": 59.34,
      "duration_seconds": 5.41,
      "text": "What about a red hot swelling on your leg, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.04,
      "end_seconds": 64.07,
      "duration_seconds": 3.03,
      "text": "Yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.74,
      "end_seconds": 66.72,
      "duration_seconds": 1.98,
      "text": "Any dark blisters as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.03,
      "end_seconds": 69.12,
      "duration_seconds": 1.09,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.58,
      "end_seconds": 76.69,
      "duration_seconds": 6.11,
      "text": "Have you had a high fever before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.67,
      "end_seconds": 83.21,
      "duration_seconds": 5.54,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.08,
      "end_seconds": 87.14,
      "duration_seconds": 3.06,
      "text": "And what about cut or insect bite?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.44,
      "end_seconds": 92.63,
      "duration_seconds": 4.19,
      "text": "I haven't had cut or insect bite, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.47,
      "end_seconds": 96.66,
      "duration_seconds": 2.19,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.23,
      "end_seconds": 99.91,
      "duration_seconds": 1.68,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.21,
      "end_seconds": 114.3,
      "duration_seconds": 3.09,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.57,
      "end_seconds": 122.3,
      "duration_seconds": 6.73,
      "text": "My father had bowel cancer. I mean, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.16,
      "end_seconds": 125.98,
      "duration_seconds": 1.82,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.39,
      "end_seconds": 133.61,
      "duration_seconds": 6.22,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.41,
      "end_seconds": 136.87,
      "duration_seconds": 1.46,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.54,
      "end_seconds": 141.63,
      "duration_seconds": 4.09,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.15,
      "end_seconds": 146.55,
      "duration_seconds": 3.4,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.3,
      "end_seconds": 151.89,
      "duration_seconds": 4.59,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.13,
      "end_seconds": 154.78,
      "duration_seconds": 1.65,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.48,
      "end_seconds": 160.32,
      "duration_seconds": 3.84,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.99,
      "end_seconds": 163.2,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.21,
      "end_seconds": 169.17,
      "duration_seconds": 3.96,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.25,
      "end_seconds": 190.1,
      "duration_seconds": 2.85,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.8,
      "end_seconds": 208.13,
      "duration_seconds": 17.33,
      "text": "Let me think, um, I have diabetes, for about ten years. Sorry, I know I'm rambling a bit. I thought it would sort itself out, but it hasn't. I've had gout, yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.52,
      "end_seconds": 210.91,
      "duration_seconds": 1.39,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.23,
      "end_seconds": 217.77,
      "duration_seconds": 5.54,
      "text": "High blood pressure, for five years. I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.7,
      "end_seconds": 227.63,
      "duration_seconds": 8.93,
      "text": "Okay, I can see diabetes in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.31,
      "end_seconds": 233.03,
      "duration_seconds": 3.72,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.94,
      "end_seconds": 237.1,
      "duration_seconds": 2.16,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.38,
      "end_seconds": 245.26,
      "duration_seconds": 6.88,
      "text": "So, just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.54,
      "end_seconds": 248.57,
      "duration_seconds": 2.03,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.52,
      "end_seconds": 258.24,
      "duration_seconds": 8.72,
      "text": "Metformin, 500 milligrams, twice a day for my sugar. I take diclofenac, 50 milligrams, when needed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.67,
      "end_seconds": 262.24,
      "duration_seconds": 2.57,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.09,
      "end_seconds": 278.37,
      "duration_seconds": 2.28,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.52,
      "end_seconds": 308.46,
      "duration_seconds": 10.94,
      "text": "Okay: height 162 centimetres, heart rate 100, saturation 96 percent, pressure 117 over 80, BMI works out to 20.6, weight 54 kilos."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.38,
      "end_seconds": 310.77,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.81,
      "end_seconds": 316.35,
      "duration_seconds": 4.54,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.81,
      "end_seconds": 320.63,
      "duration_seconds": 2.82,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.6,
      "end_seconds": 324.18,
      "duration_seconds": 1.58,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.7,
      "end_seconds": 328.27,
      "duration_seconds": 2.57,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.72,
      "end_seconds": 346.8,
      "duration_seconds": 7.08,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.92,
      "end_seconds": 348.83,
      "duration_seconds": 0.91,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.68,
      "end_seconds": 369.04,
      "duration_seconds": 15.36,
      "text": "You can relax now. Taking everything into account, it's hard to say. A severe deep skin infection needing urgent surgery review is one possibility and severe cellulitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.07,
      "end_seconds": 375.11,
      "duration_seconds": 4.04,
      "text": "Mm, is there something to worry about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.39,
      "end_seconds": 390.52,
      "duration_seconds": 12.13,
      "text": "I understand the worry. At the moment I'd say it's a severe deep skin infection needing urgent surgery review, and we'll know more once the urgent blood tests is back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.91,
      "end_seconds": 428.27,
      "duration_seconds": 26.36,
      "text": "We should do urgent blood tests for severe skin infection. I'd like to arrange an urgent surgical review for possible necrotising infection. I am sending you to hospital now, do not wait. I'm going to send a referral to the surgical team. One warning sign to remember: you cannot go now. In that case don't wait. Let's plan a check straight away."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.89,
      "end_seconds": 430.59,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.1,
      "end_seconds": 435.85,
      "duration_seconds": 3.75,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 439.71,
      "end_seconds": 443.02,
      "duration_seconds": 3.31,
      "text": "Hmm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 443.9,
      "end_seconds": 445.1,
      "duration_seconds": 1.2,
      "text": "All the best."
    }
  ]
}