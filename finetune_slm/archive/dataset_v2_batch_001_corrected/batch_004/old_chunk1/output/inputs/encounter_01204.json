{
  "schema_version": "1.0",
  "encounter_id": "01204",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.29,
      "duration_seconds": 4.43,
      "text": "morning, um, doctor is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 11.62,
      "duration_seconds": 4.86,
      "text": "You're alright take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.15,
      "end_seconds": 28.37,
      "duration_seconds": 15.22,
      "text": "yeah, doctor, it's vomiting it's getting on my nerves now i just want to get back to normal, really i'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.09,
      "end_seconds": 37.66,
      "duration_seconds": 7.57,
      "text": "Are you taking anything regularly, including from the pharmacy? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.05,
      "end_seconds": 43.8,
      "duration_seconds": 4.75,
      "text": "It's glibenclamide, 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.46,
      "end_seconds": 48.43,
      "duration_seconds": 2.97,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.25,
      "end_seconds": 57.24,
      "duration_seconds": 6.99,
      "text": "About... well, about four days. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.1,
      "end_seconds": 62.63,
      "duration_seconds": 3.53,
      "text": "A A few quick ones: cough or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.35,
      "end_seconds": 67.12,
      "duration_seconds": 3.77,
      "text": "No cough or chest pain, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.16,
      "end_seconds": 71.95,
      "duration_seconds": 2.79,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.2,
      "end_seconds": 75.39,
      "duration_seconds": 2.19,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.69,
      "end_seconds": 80.72,
      "duration_seconds": 4.03,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.67,
      "end_seconds": 83.36,
      "duration_seconds": 1.69,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.88,
      "end_seconds": 87.66,
      "duration_seconds": 3.78,
      "text": "okay, a a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.99,
      "end_seconds": 107.04,
      "duration_seconds": 14.05,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I'm a plumber, lots of bending and kneeling. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.42,
      "end_seconds": 123.09,
      "duration_seconds": 1.67,
      "text": "Right, any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.74,
      "end_seconds": 125.72,
      "duration_seconds": 1.98,
      "text": "No not at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.52,
      "end_seconds": 144.35,
      "duration_seconds": 2.83,
      "text": "so have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.21,
      "end_seconds": 155.35,
      "duration_seconds": 9.14,
      "text": "I, I was told I'm allergic to to tramadol, but I don't remember what reaction I had"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.02,
      "end_seconds": 179.57,
      "duration_seconds": 5.55,
      "text": "alright, what conditions have you been treated for in the the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.13,
      "end_seconds": 183.56,
      "duration_seconds": 2.43,
      "text": "so I've had diabetes yes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.36,
      "end_seconds": 188.55,
      "duration_seconds": 4.19,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.95,
      "end_seconds": 197.0,
      "duration_seconds": 2.05,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.4,
      "end_seconds": 225.31,
      "duration_seconds": 10.91,
      "text": "okay: weight 97 kilos respiratory rate 17. And temperature is 36.5 degrees blood pressure 129 over 81 pulse is 120 beats a a minute height 170 centimetres"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.16,
      "end_seconds": 231.33,
      "duration_seconds": 4.17,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.92,
      "end_seconds": 232.98,
      "duration_seconds": 1.06,
      "text": "of course"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.39,
      "end_seconds": 236.43,
      "duration_seconds": 2.04,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.56,
      "end_seconds": 251.6,
      "duration_seconds": 5.04,
      "text": "You are dry, breathing deeply and and your breath smells fruity."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.2,
      "end_seconds": 256.05,
      "duration_seconds": 2.85,
      "text": "yes, you know, that's fine"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.89,
      "end_seconds": 271.91,
      "duration_seconds": 13.02,
      "text": "That's the examination finished. So where does that leave us? This looks most like diabetic ketoacidosis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.75,
      "end_seconds": 293.36,
      "duration_seconds": 6.61,
      "text": "I'm sending you for a blood sugar and ketone test because of thirst and vomiting"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.96,
      "end_seconds": 296.64,
      "duration_seconds": 1.68,
      "text": "does it hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.25,
      "end_seconds": 305.91,
      "duration_seconds": 7.66,
      "text": "You need to go to to hospital now for insulin and fluids. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.3,
      "end_seconds": 309.72,
      "duration_seconds": 2.42,
      "text": "alright, uh, thank you"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.3,
      "end_seconds": 316.42,
      "duration_seconds": 5.12,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.31,
      "end_seconds": 320.2,
      "duration_seconds": 2.89,
      "text": "great, thank you for your help"
    }
  ]
}