{
  "schema_version": "1.0",
  "encounter_id": "01055",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.44,
      "duration_seconds": 6.17,
      "text": "Well, you know, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.81,
      "end_seconds": 13.94,
      "duration_seconds": 5.13,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.62,
      "end_seconds": 20.03,
      "duration_seconds": 4.41,
      "text": "well, I've been dealing with skipped beats"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.62,
      "end_seconds": 25.04,
      "duration_seconds": 3.42,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.76,
      "end_seconds": 28.33,
      "duration_seconds": 2.57,
      "text": "about... well, three weeks"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.42,
      "end_seconds": 40.88,
      "duration_seconds": 11.46,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps these questions might sound routine, but they matter"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.98,
      "end_seconds": 54.53,
      "duration_seconds": 11.55,
      "text": "Mostly severe. I'd say on and off. Okay, you know, so I've also had a flutter in my chest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.2,
      "end_seconds": 75.72,
      "duration_seconds": 5.52,
      "text": "let me check a few things. Any shortness of breath, fainting or dizziness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.59,
      "end_seconds": 80.26,
      "duration_seconds": 2.67,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.52,
      "end_seconds": 85.49,
      "duration_seconds": 3.97,
      "text": "Have you had chest pain, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.47,
      "end_seconds": 89.92,
      "duration_seconds": 3.45,
      "text": "No, uh, no chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.06,
      "end_seconds": 93.31,
      "duration_seconds": 2.25,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.21,
      "end_seconds": 104.5,
      "duration_seconds": 5.29,
      "text": "Sorry, what was I saying, no, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.6,
      "end_seconds": 115.32,
      "duration_seconds": 2.72,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.89,
      "end_seconds": 122.39,
      "duration_seconds": 6.5,
      "text": "I had a cataract operation in my left eye about a year ago"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.07,
      "end_seconds": 130.5,
      "duration_seconds": 3.43,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.71,
      "end_seconds": 144.37,
      "duration_seconds": 12.66,
      "text": "Sorry, what was I saying, I've had an enlarged prostate for two years now. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.43,
      "end_seconds": 149.38,
      "duration_seconds": 2.95,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.48,
      "end_seconds": 153.53,
      "duration_seconds": 3.05,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.29,
      "end_seconds": 156.36,
      "duration_seconds": 2.07,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.98,
      "end_seconds": 161.05,
      "duration_seconds": 4.07,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.98,
      "end_seconds": 163.63,
      "duration_seconds": 1.65,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.57,
      "end_seconds": 167.0,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.84,
      "end_seconds": 171.48,
      "duration_seconds": 2.64,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.9,
      "end_seconds": 176.43,
      "duration_seconds": 3.53,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.1,
      "end_seconds": 199.43,
      "duration_seconds": 7.33,
      "text": "right, do you take any prescribed or over-the-counter medicines? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.31,
      "end_seconds": 208.19,
      "duration_seconds": 4.88,
      "text": "I, I take tamsulosin, 0.4 milligrams, at night"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.71,
      "end_seconds": 213.54,
      "duration_seconds": 4.83,
      "text": "Hm, okay. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.86,
      "end_seconds": 229.33,
      "duration_seconds": 2.47,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.1,
      "end_seconds": 258.37,
      "duration_seconds": 11.27,
      "text": "okay: oxygen saturation is 98 percent, respiratory rate 14. And blood pressure 128 over 68, temperature 36.7, pulse is 76 beats a minute"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.79,
      "end_seconds": 261.52,
      "duration_seconds": 1.73,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.04,
      "end_seconds": 265.4,
      "duration_seconds": 2.36,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.63,
      "end_seconds": 270.5,
      "duration_seconds": 3.87,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.63,
      "end_seconds": 273.4,
      "duration_seconds": 1.77,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.31,
      "end_seconds": 276.49,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.39,
      "end_seconds": 288.9,
      "duration_seconds": 4.51,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.8,
      "end_seconds": 305.96,
      "duration_seconds": 12.16,
      "text": "All finished, thank you. Let me tell you where I've got to. I don't have a clear answer today: harmless extra heartbeats is possible, and so is an anxiety-related palpitation."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.89,
      "end_seconds": 311.48,
      "duration_seconds": 3.59,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.05,
      "end_seconds": 322.97,
      "duration_seconds": 10.92,
      "text": "Nothing I've seen today points to an emergency. It looks like harmless extra heartbeats, but I'd like to confirm. I'll request an ECG, it'll help with palpitations."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.75,
      "end_seconds": 326.91,
      "duration_seconds": 3.16,
      "text": "Do I need to to prepare?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.41,
      "end_seconds": 331.74,
      "duration_seconds": 4.33,
      "text": "I'd like you back if it carries on after a month"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.74,
      "end_seconds": 334.97,
      "duration_seconds": 2.23,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.33,
      "end_seconds": 341.59,
      "duration_seconds": 5.26,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.8,
      "end_seconds": 347.27,
      "duration_seconds": 4.47,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.96,
      "end_seconds": 350.3,
      "duration_seconds": 1.34,
      "text": "All the best."
    }
  ]
}