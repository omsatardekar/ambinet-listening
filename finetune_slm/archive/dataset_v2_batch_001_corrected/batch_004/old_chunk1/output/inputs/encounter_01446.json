{
  "schema_version": "1.0",
  "encounter_id": "01446",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.25,
      "end_seconds": 4.58,
      "duration_seconds": 3.33,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.13,
      "end_seconds": 10.63,
      "duration_seconds": 5.5,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.62,
      "end_seconds": 17.34,
      "duration_seconds": 5.72,
      "text": "morning, doctor i'll stay and and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.31,
      "end_seconds": 22.35,
      "duration_seconds": 4.04,
      "text": "Right, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.2,
      "end_seconds": 29.53,
      "duration_seconds": 6.33,
      "text": "honestly, it's skipped beats, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.12,
      "end_seconds": 33.58,
      "duration_seconds": 2.46,
      "text": "Did it it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.25,
      "end_seconds": 39.12,
      "duration_seconds": 3.87,
      "text": "I've, I've had it since last night."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.21,
      "end_seconds": 48.63,
      "duration_seconds": 8.42,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.41,
      "end_seconds": 65.96,
      "duration_seconds": 15.55,
      "text": "it's on and off. I'd call it moderate. There's a flutter in my chest as well. There was being a bit anxious, yes, but that went away"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.07,
      "end_seconds": 87.58,
      "duration_seconds": 3.51,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.44,
      "end_seconds": 93.95,
      "duration_seconds": 5.51,
      "text": "Anxiety, for five years. Yes, depression. I've got low haemoglobin"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.33,
      "end_seconds": 107.29,
      "duration_seconds": 11.96,
      "text": "right, right alright, anxiety and low haemoglobin, that matches what I have here okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.98,
      "end_seconds": 119.23,
      "duration_seconds": 11.25,
      "text": "Sorry, what was I saying, yes, erythromycin, it gives me a rash. I'm allergic to milk, I get stomach cramps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.22,
      "end_seconds": 141.05,
      "duration_seconds": 4.83,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.19,
      "end_seconds": 149.1,
      "duration_seconds": 2.91,
      "text": "yeah, my sister had breast cancer"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.8,
      "end_seconds": 153.11,
      "duration_seconds": 3.31,
      "text": "right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.64,
      "end_seconds": 159.28,
      "duration_seconds": 4.64,
      "text": "I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.03,
      "end_seconds": 166.78,
      "duration_seconds": 2.75,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.48,
      "end_seconds": 174.07,
      "duration_seconds": 6.59,
      "text": "About a year now. Sertraline. I take it once a day for my mood."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.94,
      "end_seconds": 177.48,
      "duration_seconds": 2.54,
      "text": "Do you know the the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.32,
      "end_seconds": 196.07,
      "duration_seconds": 16.75,
      "text": "50 milligrams, I think that's what's on the box. Right, you know, I'm on iron tablets, once a day. Erm, I'm on herbal calming tea, in the evening. Mirtazapine I don't take anymore."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.68,
      "end_seconds": 200.2,
      "duration_seconds": 2.52,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.47,
      "end_seconds": 214.94,
      "duration_seconds": 13.47,
      "text": "Not much, I mostly stay in these days. I work in accounts at a hospital. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.75,
      "end_seconds": 219.4,
      "duration_seconds": 3.65,
      "text": "did you get fainting, chest pain or dizziness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.91,
      "end_seconds": 223.7,
      "duration_seconds": 2.79,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.37,
      "end_seconds": 228.55,
      "duration_seconds": 4.18,
      "text": "Have you had shortness of breath, by any chance?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.64,
      "end_seconds": 236.54,
      "duration_seconds": 5.9,
      "text": "no, you know, I haven't had any shortness of breath"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 240.49,
      "duration_seconds": 3.38,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.73,
      "end_seconds": 243.54,
      "duration_seconds": 1.81,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.44,
      "end_seconds": 247.62,
      "duration_seconds": 3.18,
      "text": "alright, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.91,
      "end_seconds": 251.13,
      "duration_seconds": 2.22,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.15,
      "end_seconds": 256.96,
      "duration_seconds": 4.81,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.86,
      "end_seconds": 272.94,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.65,
      "end_seconds": 299.7,
      "duration_seconds": 8.05,
      "text": "Okay: BP is 108 over 71, temp 36.4 degrees, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.03,
      "end_seconds": 303.24,
      "duration_seconds": 2.21,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.2,
      "end_seconds": 304.9,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.3,
      "end_seconds": 308.4,
      "duration_seconds": 2.1,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.58,
      "end_seconds": 323.21,
      "duration_seconds": 4.63,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.51,
      "end_seconds": 337.67,
      "duration_seconds": 10.16,
      "text": "That's all I needed to check. Having listened and examined, I'd lean towards harmless extra heartbeats. An anxiety-related palpitation is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.54,
      "end_seconds": 341.55,
      "duration_seconds": 3.01,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.55,
      "end_seconds": 350.84,
      "duration_seconds": 8.29,
      "text": "I can't promise yet, but most people with harmless extra heartbeats do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.6,
      "end_seconds": 375.01,
      "duration_seconds": 5.41,
      "text": "Let's get an ECG, for palpitations. Alright, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 376.83,
      "end_seconds": 380.3,
      "duration_seconds": 3.47,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.32,
      "end_seconds": 383.55,
      "duration_seconds": 1.23,
      "text": "Look after yourself."
    }
  ]
}