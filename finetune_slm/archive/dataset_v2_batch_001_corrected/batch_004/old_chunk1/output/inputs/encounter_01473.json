{
  "schema_version": "1.0",
  "encounter_id": "01473",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.28,
      "end_seconds": 5.74,
      "duration_seconds": 4.46,
      "text": "Erm, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.61,
      "end_seconds": 10.52,
      "duration_seconds": 3.91,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.43,
      "end_seconds": 19.32,
      "duration_seconds": 4.89,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.87,
      "end_seconds": 23.8,
      "duration_seconds": 2.93,
      "text": "absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.3,
      "end_seconds": 30.46,
      "duration_seconds": 5.16,
      "text": "doctor, it's a blocked ear. That's what we're worried about"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.0,
      "end_seconds": 34.98,
      "duration_seconds": 1.98,
      "text": "So, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.73,
      "end_seconds": 38.18,
      "duration_seconds": 2.45,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 38.8,
      "end_seconds": 41.95,
      "duration_seconds": 3.15,
      "text": "It was closer to three weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.15,
      "end_seconds": 49.39,
      "duration_seconds": 4.24,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.88,
      "end_seconds": 52.97,
      "duration_seconds": 2.09,
      "text": "yeah, you know, roughly"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.5,
      "end_seconds": 58.26,
      "duration_seconds": 3.76,
      "text": "Has there been a feeling of fullness too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.25,
      "end_seconds": 69.51,
      "duration_seconds": 9.26,
      "text": "yes, since yesterday oh, and muffled hearing on one side that's been about the same, about a month"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.72,
      "end_seconds": 76.63,
      "duration_seconds": 5.91,
      "text": "Have you had a blocked ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.68,
      "end_seconds": 85.29,
      "duration_seconds": 6.61,
      "text": "well, um, a bit, last winter it settled by itself back then"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.36,
      "end_seconds": 98.22,
      "duration_seconds": 2.86,
      "text": "and what about ringing or dizziness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.06,
      "end_seconds": 102.94,
      "duration_seconds": 3.88,
      "text": "No ringing or dizziness, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.67,
      "end_seconds": 107.39,
      "duration_seconds": 3.72,
      "text": "Have you had any ear pain or discharge?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.15,
      "end_seconds": 112.44,
      "duration_seconds": 4.29,
      "text": "I haven't had ear pain or discharge, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.05,
      "end_seconds": 115.34,
      "duration_seconds": 2.29,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.03,
      "end_seconds": 118.96,
      "duration_seconds": 1.93,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.65,
      "end_seconds": 123.54,
      "duration_seconds": 2.89,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.11,
      "end_seconds": 125.51,
      "duration_seconds": 1.4,
      "text": "nothing else aches"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.13,
      "end_seconds": 128.09,
      "duration_seconds": 1.96,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.86,
      "end_seconds": 140.14,
      "duration_seconds": 7.28,
      "text": "I have high blood pressure, for two years. I've had depression for nearly five years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.66,
      "end_seconds": 159.03,
      "duration_seconds": 5.37,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.26,
      "end_seconds": 178.38,
      "duration_seconds": 18.12,
      "text": "I quit smoking around ten years ago. I used to drink heavily but I stopped four years ago. I'm a plumber, lots of bending and kneeling. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.74,
      "end_seconds": 182.08,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.97,
      "end_seconds": 184.68,
      "duration_seconds": 1.71,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.63,
      "end_seconds": 203.71,
      "duration_seconds": 5.08,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.55,
      "end_seconds": 209.75,
      "duration_seconds": 5.2,
      "text": "Plasters i come out in... well, a red itchy rash"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.79,
      "end_seconds": 216.22,
      "duration_seconds": 2.43,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.85,
      "end_seconds": 222.16,
      "duration_seconds": 4.31,
      "text": "I'm on telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.38,
      "end_seconds": 224.59,
      "duration_seconds": 1.21,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.32,
      "end_seconds": 236.17,
      "duration_seconds": 10.85,
      "text": "About a year now. I take sertraline, 50 milligrams, once a day. I'm on olive oil drops, twice a day"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.59,
      "end_seconds": 242.48,
      "duration_seconds": 5.89,
      "text": "okay, go on can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.13,
      "end_seconds": 254.46,
      "duration_seconds": 2.33,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.61,
      "end_seconds": 275.29,
      "duration_seconds": 6.68,
      "text": "Okay: respiratory rate 15, saturation 99 percent. And heart rate 81, blood pressure 118 over 81."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.54,
      "end_seconds": 278.82,
      "duration_seconds": 2.28,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.63,
      "end_seconds": 285.05,
      "duration_seconds": 4.42,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.64,
      "end_seconds": 292.0,
      "duration_seconds": 4.36,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.74,
      "end_seconds": 295.8,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.19,
      "end_seconds": 312.09,
      "duration_seconds": 3.9,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.11,
      "end_seconds": 331.17,
      "duration_seconds": 15.06,
      "text": "That's the examination finished. Taking everything into account, my working impression is earwax blocking the ear. The reason I say that is that your story and my examination fit together. I want ear irrigation done, that's for wax."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.08,
      "end_seconds": 333.18,
      "duration_seconds": 1.1,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.47,
      "end_seconds": 356.59,
      "duration_seconds": 19.12,
      "text": "Use the olive oil drops for a week and then we'll syringe the ear. Please don't wait if you get ear pain or dizziness. That's when to be seen urgently. Book a review in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.63,
      "end_seconds": 363.86,
      "duration_seconds": 2.23,
      "text": "thank you, doctor, goodbye"
    }
  ]
}