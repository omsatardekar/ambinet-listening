{
  "schema_version": "1.0",
  "encounter_id": "01244",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 3.71,
      "duration_seconds": 3.01,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 10.6,
      "duration_seconds": 5.06,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.6,
      "end_seconds": 17.47,
      "duration_seconds": 5.87,
      "text": "Honestly, it's a blocked ear, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.1,
      "end_seconds": 22.15,
      "duration_seconds": 3.05,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.62,
      "end_seconds": 28.6,
      "duration_seconds": 4.98,
      "text": "Around six months... no wait, it's more like two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.52,
      "end_seconds": 33.57,
      "duration_seconds": 3.05,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.61,
      "end_seconds": 40.71,
      "duration_seconds": 5.1,
      "text": "Uh, I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.07,
      "end_seconds": 44.18,
      "duration_seconds": 2.11,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.03,
      "end_seconds": 48.19,
      "duration_seconds": 2.16,
      "text": "It's worse with showering."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.7,
      "end_seconds": 66.58,
      "duration_seconds": 2.88,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.1,
      "end_seconds": 71.24,
      "duration_seconds": 3.14,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.65,
      "end_seconds": 83.38,
      "duration_seconds": 3.73,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.69,
      "end_seconds": 89.02,
      "duration_seconds": 4.33,
      "text": "I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.48,
      "end_seconds": 90.26,
      "duration_seconds": 0.78,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.28,
      "end_seconds": 94.38,
      "duration_seconds": 3.1,
      "text": "Olive oil drops, twice a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.03,
      "end_seconds": 98.25,
      "duration_seconds": 2.22,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.15,
      "end_seconds": 104.3,
      "duration_seconds": 4.15,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.96,
      "end_seconds": 107.78,
      "duration_seconds": 2.82,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.42,
      "end_seconds": 111.84,
      "duration_seconds": 3.42,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.74,
      "end_seconds": 117.48,
      "duration_seconds": 3.74,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.89,
      "end_seconds": 125.84,
      "duration_seconds": 6.95,
      "text": "I was told I'm allergic to amoxicillin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.67,
      "end_seconds": 131.42,
      "duration_seconds": 3.75,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.79,
      "end_seconds": 135.65,
      "duration_seconds": 2.86,
      "text": "Erm, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.6,
      "end_seconds": 142.42,
      "duration_seconds": 4.82,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.35,
      "end_seconds": 148.99,
      "duration_seconds": 4.64,
      "text": "I mean, I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 158.31,
      "duration_seconds": 7.55,
      "text": "Hm, okay. Alright, acid reflux, that matches what I have here. Any sign of discharge?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.7,
      "end_seconds": 162.7,
      "duration_seconds": 3.0,
      "text": "No, I haven't had any discharge."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.68,
      "end_seconds": 168.46,
      "duration_seconds": 3.78,
      "text": "So, have you noticed ringing, dizziness or ear pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.11,
      "end_seconds": 171.92,
      "duration_seconds": 2.81,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.02,
      "end_seconds": 175.44,
      "duration_seconds": 2.42,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.55,
      "end_seconds": 178.11,
      "duration_seconds": 1.56,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.49,
      "end_seconds": 193.72,
      "duration_seconds": 2.23,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.71,
      "end_seconds": 205.85,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.63,
      "end_seconds": 232.97,
      "duration_seconds": 8.34,
      "text": "Okay: temperature 36.9, pulse 67, SpO2 99 percent on room air, BP is 124 over 72."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.67,
      "end_seconds": 236.17,
      "duration_seconds": 1.5,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.63,
      "end_seconds": 240.13,
      "duration_seconds": 2.5,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.36,
      "end_seconds": 245.76,
      "duration_seconds": 4.4,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.87,
      "end_seconds": 263.57,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.66,
      "end_seconds": 266.48,
      "duration_seconds": 1.82,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.85,
      "end_seconds": 285.08,
      "duration_seconds": 4.23,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.72,
      "end_seconds": 302.15,
      "duration_seconds": 12.43,
      "text": "That's the examination finished. Okay, so my impression is this: It fits best with earwax blocking the ear. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.48,
      "end_seconds": 306.9,
      "duration_seconds": 3.42,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.1,
      "end_seconds": 326.2,
      "duration_seconds": 18.1,
      "text": "I understand the worry. At the moment I'd say it's earwax blocking the ear, and we'll know more once the ear irrigation is back. Let's book ear irrigation to look into wax. Use the olive oil drops for a week and then we'll syringe the ear."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.59,
      "end_seconds": 343.84,
      "duration_seconds": 17.25,
      "text": "Yes. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. Come back in one week. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.22,
      "end_seconds": 348.63,
      "duration_seconds": 3.41,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}