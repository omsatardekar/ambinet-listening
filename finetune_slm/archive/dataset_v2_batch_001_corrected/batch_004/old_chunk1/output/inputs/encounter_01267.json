{
  "schema_version": "1.0",
  "encounter_id": "01267",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 3.99,
      "duration_seconds": 3.22,
      "text": "hello doctor. I think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.08,
      "end_seconds": 10.57,
      "duration_seconds": 4.49,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.4,
      "end_seconds": 16.27,
      "duration_seconds": 2.87,
      "text": "it's my throat closing up, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.73,
      "end_seconds": 20.97,
      "duration_seconds": 3.24,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.62,
      "end_seconds": 29.51,
      "duration_seconds": 6.89,
      "text": "Probably about a week. Yeah. Okay, so and I've been feeling faint as well."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.21,
      "end_seconds": 35.44,
      "duration_seconds": 5.23,
      "text": "is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.11,
      "end_seconds": 38.85,
      "duration_seconds": 2.74,
      "text": "it sort of comes and goes"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.67,
      "end_seconds": 41.68,
      "duration_seconds": 2.01,
      "text": "have you had swollen lips?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.93,
      "end_seconds": 46.11,
      "duration_seconds": 3.18,
      "text": "yes, about the same, ten days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.87,
      "end_seconds": 53.88,
      "duration_seconds": 6.01,
      "text": "Have you had your throat closing up before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.45,
      "end_seconds": 62.33,
      "duration_seconds": 7.88,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.57,
      "end_seconds": 72.03,
      "duration_seconds": 4.46,
      "text": "Right have you had any recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.68,
      "end_seconds": 77.54,
      "duration_seconds": 4.86,
      "text": "I haven't had recent illness or chest pain, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.9,
      "end_seconds": 83.49,
      "duration_seconds": 5.59,
      "text": "Yes, carry on. Okay, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.84,
      "end_seconds": 87.08,
      "duration_seconds": 2.24,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.03,
      "end_seconds": 96.32,
      "duration_seconds": 5.29,
      "text": "tell me about your routine, work, habits, that that sort of thing"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.09,
      "end_seconds": 108.22,
      "duration_seconds": 10.13,
      "text": "Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling. I live with my elderly mother"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.07,
      "end_seconds": 127.43,
      "duration_seconds": 3.36,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.3,
      "end_seconds": 133.21,
      "duration_seconds": 4.91,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.26,
      "end_seconds": 139.54,
      "duration_seconds": 4.28,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.58,
      "end_seconds": 143.59,
      "duration_seconds": 2.01,
      "text": "my grandmother had dementia"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.65,
      "end_seconds": 164.08,
      "duration_seconds": 4.43,
      "text": "are you taking anything regularly, including from the the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.16,
      "end_seconds": 170.62,
      "duration_seconds": 4.46,
      "text": "Foracort inhaler. I take it twice a day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.45,
      "end_seconds": 175.74,
      "duration_seconds": 4.29,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.04,
      "end_seconds": 181.51,
      "duration_seconds": 4.47,
      "text": "actually, no, nothing as far as I know"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.54,
      "end_seconds": 187.19,
      "duration_seconds": 3.65,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.82,
      "end_seconds": 191.38,
      "duration_seconds": 3.56,
      "text": "I have asthma for about a year"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.62,
      "end_seconds": 195.35,
      "duration_seconds": 2.73,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.76,
      "end_seconds": 203.75,
      "duration_seconds": 1.99,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.28,
      "end_seconds": 228.25,
      "duration_seconds": 5.97,
      "text": "okay: pressure 103 over 63, pulse 95, temp 37.1 degrees, saturation 98 percent"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.84,
      "end_seconds": 230.87,
      "duration_seconds": 2.03,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.51,
      "end_seconds": 234.1,
      "duration_seconds": 2.59,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.01,
      "end_seconds": 240.87,
      "duration_seconds": 3.86,
      "text": "Let me look at the area I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.73,
      "end_seconds": 246.63,
      "duration_seconds": 3.9,
      "text": "so, stay as you are for a moment"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.47,
      "end_seconds": 268.72,
      "duration_seconds": 7.25,
      "text": "Your lips are swollen you have hives you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.79,
      "end_seconds": 281.45,
      "duration_seconds": 1.66,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.61,
      "end_seconds": 302.09,
      "duration_seconds": 16.48,
      "text": "Okay you can sit up now. Taking everything into account it's hard to say. Anaphylaxis is one possibility and a severe allergic reaction another and I'd rather not commit yet. Let's get monitoring for Anaphylaxis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 303.83,
      "end_seconds": 306.12,
      "duration_seconds": 2.29,
      "text": "The earliest is Monday 2 pm."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.12,
      "end_seconds": 310.35,
      "duration_seconds": 3.23,
      "text": "okay, um, I'll be there"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.25,
      "end_seconds": 317.76,
      "duration_seconds": 6.51,
      "text": "for this, adrenaline, 0.5 milligrams, once now, single dose it's for anaphylaxis"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.79,
      "end_seconds": 322.35,
      "duration_seconds": 2.56,
      "text": "erm fine I'll begin it"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.19,
      "end_seconds": 332.01,
      "duration_seconds": 8.82,
      "text": "lie flat with your legs raised I am giving the injection now i think the emergency team should see you too"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.41,
      "end_seconds": 335.87,
      "duration_seconds": 2.46,
      "text": "sure, where do I go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.08,
      "end_seconds": 342.32,
      "duration_seconds": 5.24,
      "text": "If the symptoms return, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.81,
      "end_seconds": 345.81,
      "duration_seconds": 2.0,
      "text": "Thank you that's clear."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.39,
      "end_seconds": 349.86,
      "duration_seconds": 3.47,
      "text": "I'd like to see you again straight away"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.71,
      "end_seconds": 353.75,
      "duration_seconds": 2.04,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.42,
      "end_seconds": 357.41,
      "duration_seconds": 2.99,
      "text": "Does all of that that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.95,
      "end_seconds": 362.16,
      "duration_seconds": 3.21,
      "text": "right I'll do that. Thank you doctor"
    }
  ]
}