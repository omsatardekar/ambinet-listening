{
  "schema_version": "1.0",
  "encounter_id": "01433",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 4.5,
      "duration_seconds": 3.94,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 10.13,
      "duration_seconds": 4.19,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.95,
      "end_seconds": 16.79,
      "duration_seconds": 5.84,
      "text": "Yeah, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.79,
      "end_seconds": 23.93,
      "duration_seconds": 6.14,
      "text": "Yeah, it's a swollen painful calf. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.99,
      "end_seconds": 28.81,
      "duration_seconds": 2.82,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.6,
      "end_seconds": 34.49,
      "duration_seconds": 4.89,
      "text": "About three weeks, uh, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.68,
      "end_seconds": 41.17,
      "duration_seconds": 5.49,
      "text": "So, I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.78,
      "end_seconds": 47.18,
      "duration_seconds": 4.4,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.13,
      "end_seconds": 53.16,
      "duration_seconds": 4.03,
      "text": "I, I suppose so, you know, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.82,
      "end_seconds": 63.89,
      "duration_seconds": 10.07,
      "text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.34,
      "end_seconds": 74.88,
      "duration_seconds": 9.54,
      "text": "Let me think, mostly mild. It happens every other day. So, there's sudden shortness of breath as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.89,
      "end_seconds": 80.01,
      "duration_seconds": 3.12,
      "text": "Have you been coughing up a little blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.28,
      "end_seconds": 84.64,
      "duration_seconds": 3.36,
      "text": "Ah, yeah. Ten days, I'd say."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.18,
      "end_seconds": 89.14,
      "duration_seconds": 3.96,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.43,
      "end_seconds": 92.88,
      "duration_seconds": 2.45,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 93.86,
      "end_seconds": 103.11,
      "duration_seconds": 9.25,
      "text": "Actually, I remember she had some kind of reaction to trimethoprim before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.81,
      "end_seconds": 105.96,
      "duration_seconds": 2.15,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.35,
      "end_seconds": 112.5,
      "duration_seconds": 5.15,
      "text": "Okay, I'll note both of those. What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.46,
      "end_seconds": 120.47,
      "duration_seconds": 6.01,
      "text": "I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.59,
      "end_seconds": 122.29,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.36,
      "end_seconds": 126.58,
      "duration_seconds": 2.22,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.53,
      "end_seconds": 134.97,
      "duration_seconds": 7.44,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.64,
      "end_seconds": 146.52,
      "duration_seconds": 3.88,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.37,
      "end_seconds": 156.27,
      "duration_seconds": 8.9,
      "text": "My daughter has type 1 diabetes. Sorry, what was I saying, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.13,
      "end_seconds": 168.65,
      "duration_seconds": 4.52,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.53,
      "end_seconds": 175.9,
      "duration_seconds": 6.37,
      "text": "It's, It's something called hydr... hydrochlorothiazide, 12.5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.74,
      "end_seconds": 181.52,
      "duration_seconds": 4.78,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.86,
      "end_seconds": 187.52,
      "duration_seconds": 4.66,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.81,
      "end_seconds": 192.04,
      "duration_seconds": 3.23,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.32,
      "end_seconds": 206.15,
      "duration_seconds": 12.83,
      "text": "I look after my grandchildren most days. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.83,
      "end_seconds": 209.36,
      "duration_seconds": 2.53,
      "text": "Any wheeze or fever at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.85,
      "end_seconds": 214.22,
      "duration_seconds": 3.37,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.71,
      "end_seconds": 217.43,
      "duration_seconds": 1.72,
      "text": "What about chest tightness?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.98,
      "end_seconds": 221.12,
      "duration_seconds": 2.14,
      "text": "No. No chest tightness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 226.9,
      "duration_seconds": 4.26,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.82,
      "end_seconds": 229.52,
      "duration_seconds": 1.7,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.11,
      "end_seconds": 232.55,
      "duration_seconds": 2.44,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.64,
      "end_seconds": 236.64,
      "duration_seconds": 3.0,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.35,
      "end_seconds": 239.74,
      "duration_seconds": 2.39,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.04,
      "end_seconds": 255.47,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.12,
      "end_seconds": 278.95,
      "duration_seconds": 9.83,
      "text": "Okay: pulse is 96 beats a minute, oxygen saturation is 94 percent, temperature 37.1, respiratory rate 26, BP is 142 over 87."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.72,
      "end_seconds": 282.42,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.96,
      "end_seconds": 286.59,
      "duration_seconds": 2.63,
      "text": "Okay, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.17,
      "end_seconds": 293.11,
      "duration_seconds": 3.94,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.75,
      "end_seconds": 297.57,
      "duration_seconds": 2.82,
      "text": "Okay, I'm just checking this side."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.71,
      "end_seconds": 319.86,
      "duration_seconds": 6.15,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.46,
      "end_seconds": 336.89,
      "duration_seconds": 14.43,
      "text": "Good, you can sit up again. Taking everything into account, it fits best with a possible blood clot in the lung. A chest infection is also on my list."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.16,
      "end_seconds": 376.97,
      "duration_seconds": 30.81,
      "text": "We should do a D-dimer blood test for possible clot. Let's get a CT scan of the chest, for breathlessness. You need to go to hospital now for a scan. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and if you feel faint, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.08,
      "end_seconds": 380.62,
      "duration_seconds": 2.54,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.24,
      "end_seconds": 383.81,
      "duration_seconds": 2.57,
      "text": "I'd like you back straight away."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.91,
      "end_seconds": 386.61,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.58,
      "end_seconds": 392.37,
      "duration_seconds": 3.79,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 393.59,
      "end_seconds": 397.34,
      "duration_seconds": 3.75,
      "text": "Alright, um, thanks, take care."
    }
  ]
}