  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 4.31,
      "duration_seconds": 3.69,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.95,
      "end_seconds": 8.97,
      "duration_seconds": 3.02,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.62,
      "end_seconds": 13.37,
      "duration_seconds": 2.75,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.96,
      "end_seconds": 19.8,
      "duration_seconds": 4.84,
      "text": "Well, I've been having pain much worse than it looks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.72,
      "end_seconds": 24.25,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.77,
      "end_seconds": 40.11,
      "duration_seconds": 2.34,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.18,
      "end_seconds": 75.1,
      "duration_seconds": 21.92,
      "text": "Okay: weight 93 kilos, blood pressure 116 over 74, respiratory rate 19, oxygen saturation is 98 percent, BMI works out to 36.8, temp 39.3 degrees, pulse is 97 beats a minute, height 159 centimetres. Right, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.78,
      "end_seconds": 80.16,
      "duration_seconds": 2.38,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.57,
      "end_seconds": 86.0,
      "duration_seconds": 5.43,
      "text": "Okay, go on. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.95,
      "end_seconds": 87.99,
      "duration_seconds": 1.04,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.87,
      "end_seconds": 92.84,
      "duration_seconds": 2.97,
      "text": "Have you noticed insect bite or cut?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.87,
      "end_seconds": 96.29,
      "duration_seconds": 2.42,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.29,
      "end_seconds": 100.72,
      "duration_seconds": 3.43,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.07,
      "end_seconds": 103.68,
      "duration_seconds": 1.61,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.5,
      "end_seconds": 118.54,
      "duration_seconds": 2.04,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.27,
      "end_seconds": 123.12,
      "duration_seconds": 2.85,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.5,
      "end_seconds": 143.3,
      "duration_seconds": 3.8,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.0,
      "end_seconds": 146.01,
      "duration_seconds": 2.01,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.69,
      "end_seconds": 163.52,
      "duration_seconds": 2.83,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.24,
      "end_seconds": 180.99,
      "duration_seconds": 15.75,
      "text": "I used to drink heavily but I stopped four years ago. I smoke roughly a pack every two days. I live with my elderly mother. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.52,
      "end_seconds": 186.51,
      "duration_seconds": 3.99,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.84,
      "end_seconds": 189.79,
      "duration_seconds": 1.95,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.67,
      "end_seconds": 196.11,
      "duration_seconds": 5.44,
      "text": "So, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.05,
      "end_seconds": 200.99,
      "duration_seconds": 3.94,
      "text": "I'm allergic to wheat, I get bloating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.37,
      "end_seconds": 204.84,
      "duration_seconds": 2.47,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.73,
      "end_seconds": 207.5,
      "duration_seconds": 1.77,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.34,
      "end_seconds": 209.75,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.13,
      "end_seconds": 227.22,
      "duration_seconds": 7.09,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.11,
      "end_seconds": 234.97,
      "duration_seconds": 2.86,
      "text": "So, that's all I needed to check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.92,
      "end_seconds": 265.24,
      "duration_seconds": 11.32,
      "text": "Taking everything into account, I can't pin this down yet. We're looking at a severe deep skin infection needing urgent surgery review or severe cellulitis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.66,
      "end_seconds": 268.76,
      "duration_seconds": 2.1,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.44,
      "end_seconds": 284.24,
      "duration_seconds": 14.8,
      "text": "I can't promise yet, but most people with a severe deep skin infection needing urgent surgery review do well once it's treated properly. Let's get an urgent surgical review, for possible necrotising infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 285.05,
      "end_seconds": 286.92,
      "duration_seconds": 1.87,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.0,
      "end_seconds": 302.78,
      "duration_seconds": 13.78,
      "text": "I am sending you to hospital now, do not wait. Don't skip meals, and try to eat smaller portions more often through the day. Please come and see me straight away."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.87,
      "end_seconds": 305.57,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.71,
      "end_seconds": 313.88,
      "duration_seconds": 4.17,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.36,
      "end_seconds": 317.08,
      "duration_seconds": 1.72,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.47,
      "end_seconds": 324.53,
      "duration_seconds": 2.06,
      "text": "Okay, see you soon."
    }
  ]
}