{
  "schema_version": "1.0",
  "encounter_id": "01324",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 7.47,
      "duration_seconds": 6.73,
      "text": "Yeah, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.05,
      "end_seconds": 13.42,
      "duration_seconds": 4.37,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.25,
      "end_seconds": 22.57,
      "duration_seconds": 8.32,
      "text": "Doctor, it's sharp pain low on one side. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.89,
      "end_seconds": 26.46,
      "duration_seconds": 2.57,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.24,
      "end_seconds": 39.04,
      "duration_seconds": 2.8,
      "text": "so, sit still for a moment.."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.46,
      "end_seconds": 60.33,
      "duration_seconds": 6.87,
      "text": "okay: pressure 126 over 88, pulse 109. And respiratory rate 19, saturation 97 percent"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.09,
      "end_seconds": 63.88,
      "duration_seconds": 1.79,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.6,
      "end_seconds": 70.86,
      "duration_seconds": 6.26,
      "text": "We'll look at it together shortly. Alright, rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.38,
      "end_seconds": 74.48,
      "duration_seconds": 3.1,
      "text": "pretty mild, if I'm being honest"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.95,
      "end_seconds": 81.5,
      "duration_seconds": 5.55,
      "text": "so, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.07,
      "end_seconds": 84.56,
      "duration_seconds": 2.49,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.59,
      "end_seconds": 91.18,
      "duration_seconds": 2.59,
      "text": "have you had shoulder tip pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.18,
      "end_seconds": 99.13,
      "duration_seconds": 5.95,
      "text": "Yeah, um, that too. And light vaginal bleeding, too."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.11,
      "end_seconds": 103.43,
      "duration_seconds": 3.32,
      "text": "A few quick ones: fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.32,
      "end_seconds": 110.14,
      "duration_seconds": 5.82,
      "text": "Okay, so I haven't had fever or vaginal discharge, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.03,
      "end_seconds": 115.07,
      "duration_seconds": 4.04,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.67,
      "end_seconds": 119.27,
      "duration_seconds": 2.6,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.26,
      "end_seconds": 126.74,
      "duration_seconds": 5.48,
      "text": "So, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.38,
      "end_seconds": 133.59,
      "duration_seconds": 5.21,
      "text": "Sorry, what was I saying, no weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.91,
      "end_seconds": 137.65,
      "duration_seconds": 2.74,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.9,
      "end_seconds": 144.75,
      "duration_seconds": 5.85,
      "text": "Yes, depression. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.74,
      "end_seconds": 167.19,
      "duration_seconds": 3.45,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.52,
      "end_seconds": 171.59,
      "duration_seconds": 3.07,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.32,
      "end_seconds": 175.38,
      "duration_seconds": 2.06,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.13,
      "end_seconds": 178.68,
      "duration_seconds": 2.55,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.46,
      "end_seconds": 185.72,
      "duration_seconds": 5.26,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.19,
      "end_seconds": 200.82,
      "duration_seconds": 13.63,
      "text": "Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.96,
      "end_seconds": 207.29,
      "duration_seconds": 5.33,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.28,
      "end_seconds": 210.46,
      "duration_seconds": 1.18,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.06,
      "end_seconds": 214.49,
      "duration_seconds": 2.43,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.31,
      "end_seconds": 230.56,
      "duration_seconds": 5.25,
      "text": "Your tummy is tender low on the right and and you look pale."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.02,
      "end_seconds": 237.52,
      "duration_seconds": 1.5,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.33,
      "end_seconds": 241.92,
      "duration_seconds": 1.59,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.68,
      "end_seconds": 273.42,
      "duration_seconds": 13.74,
      "text": "Okay, thinking it through, I think we're dealing with a possible ectopic pregnancy at this stage. It could also be a ruptured ovarian cyst, so we'll keep that open."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.93,
      "end_seconds": 278.68,
      "duration_seconds": 3.75,
      "text": "Okay, so is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.63,
      "end_seconds": 301.66,
      "duration_seconds": 21.03,
      "text": "It's reasonable to be concerned, but right now a possible ectopic pregnancy is my leading thought, not anything worse. Let me repeat that back to make sure. You've had sharp pain low on one side, mild, and no vaginal discharge or fever."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.46,
      "end_seconds": 307.52,
      "duration_seconds": 4.06,
      "text": "Let me think, yes, you've got it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.59,
      "end_seconds": 325.77,
      "duration_seconds": 10.18,
      "text": "I want an urgent pelvic scan done, that's for possible ectopic. Let's book a pregnancy test to look into pelvic pain and bleeding."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.5,
      "end_seconds": 329.66,
      "duration_seconds": 3.16,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.4,
      "end_seconds": 356.5,
      "duration_seconds": 23.1,
      "text": "You need to go to the hospital now for an emergency scan. If the pain gets worse or you faint, or you feel really unwell, please come to the emergency department. Let's plan a check straight away. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.84,
      "end_seconds": 364.74,
      "duration_seconds": 6.9,
      "text": "So, you know, I come back straight away. Is that that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.8,
      "end_seconds": 371.14,
      "duration_seconds": 5.34,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.85,
      "end_seconds": 376.32,
      "duration_seconds": 3.47,
      "text": "I think I understand everything. Thanks."
    }
  ]
}