{
  "schema_version": "1.0",
  "encounter_id": "01338",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.31,
      "end_seconds": 7.38,
      "duration_seconds": 6.07,
      "text": "Afternoon, thanks for coming in. Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.87,
      "end_seconds": 15.35,
      "duration_seconds": 6.48,
      "text": "mm, first time with this one, yes. A friend recommended it"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.93,
      "end_seconds": 22.73,
      "duration_seconds": 3.8,
      "text": "Right, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.42,
      "end_seconds": 36.33,
      "duration_seconds": 11.91,
      "text": "Doctor, it's weakness in my right arm. It's getting on my nerves now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.19,
      "end_seconds": 44.06,
      "duration_seconds": 2.87,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.74,
      "end_seconds": 52.96,
      "duration_seconds": 8.22,
      "text": "It's been about two weeks now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.28,
      "end_seconds": 58.36,
      "duration_seconds": 5.08,
      "text": "Yes, carry on. Have you noticed loss of consciousness, seizure or fever?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.38,
      "end_seconds": 66.78,
      "duration_seconds": 6.4,
      "text": "erm, no loss of consciousness, seizure or fever, none of it"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.84,
      "end_seconds": 70.9,
      "duration_seconds": 2.06,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.33,
      "end_seconds": 75.8,
      "duration_seconds": 3.47,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.59,
      "end_seconds": 81.03,
      "duration_seconds": 3.44,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.44,
      "end_seconds": 86.58,
      "duration_seconds": 4.14,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.34,
      "end_seconds": 93.57,
      "duration_seconds": 5.23,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.43,
      "end_seconds": 98.29,
      "duration_seconds": 3.86,
      "text": "Wheat. I come out in... well, bloating"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.0,
      "end_seconds": 101.35,
      "duration_seconds": 2.35,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.27,
      "end_seconds": 105.5,
      "duration_seconds": 3.23,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.0,
      "end_seconds": 110.25,
      "duration_seconds": 3.25,
      "text": "Okay, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.77,
      "end_seconds": 115.26,
      "duration_seconds": 3.49,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.75,
      "end_seconds": 119.02,
      "duration_seconds": 2.27,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.04,
      "end_seconds": 125.47,
      "duration_seconds": 4.43,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.18,
      "end_seconds": 129.39,
      "duration_seconds": 3.21,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.77,
      "end_seconds": 134.86,
      "duration_seconds": 4.09,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.32,
      "end_seconds": 154.7,
      "duration_seconds": 3.38,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.19,
      "end_seconds": 162.19,
      "duration_seconds": 3.0,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.62,
      "end_seconds": 167.35,
      "duration_seconds": 3.73,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.57,
      "end_seconds": 171.06,
      "duration_seconds": 2.49,
      "text": "No, uh, no conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 184.18,
      "duration_seconds": 2.95,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.61,
      "end_seconds": 193.19,
      "duration_seconds": 2.58,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.36,
      "end_seconds": 219.81,
      "duration_seconds": 5.45,
      "text": "Okay: temperature is 36.6 degrees, pulse 81, blood pressure 149 over 90."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.85,
      "end_seconds": 225.32,
      "duration_seconds": 4.47,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.77,
      "end_seconds": 238.74,
      "duration_seconds": 0.97,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.58,
      "end_seconds": 241.73,
      "duration_seconds": 2.15,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.88,
      "end_seconds": 257.49,
      "duration_seconds": 5.61,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.52,
      "end_seconds": 261.31,
      "duration_seconds": 1.79,
      "text": "that's the examination finished"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.64,
      "end_seconds": 274.65,
      "duration_seconds": 6.01,
      "text": "Having listened and examined, this is probably a possible stroke, within the treatment window."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 277.86,
      "end_seconds": 279.66,
      "duration_seconds": 1.8,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.38,
      "end_seconds": 298.57,
      "duration_seconds": 17.19,
      "text": "I understand the the worry. At the moment I'd say it's a possible stroke, within the treatment window, and we'll watch how it goes. Let's get you seen by the stroke team, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.14,
      "end_seconds": 300.88,
      "duration_seconds": 1.74,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.15,
      "end_seconds": 306.53,
      "duration_seconds": 4.38,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.15,
      "end_seconds": 312.54,
      "duration_seconds": 4.39,
      "text": "Great, uh, thank you for your help."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.1,
      "end_seconds": 314.69,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}