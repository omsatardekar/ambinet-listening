    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.57,
      "end_seconds": 260.59,
      "duration_seconds": 3.02,
      "text": "no, I don't take any tablets"
