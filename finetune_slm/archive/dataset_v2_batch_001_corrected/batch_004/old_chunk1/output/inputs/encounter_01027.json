    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.25,
      "end_seconds": 223.05,
      "duration_seconds": 2.8,
      "text": "have you had any previous surgeries?"
