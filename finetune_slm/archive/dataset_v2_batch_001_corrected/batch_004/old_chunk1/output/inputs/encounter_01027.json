    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.82,
      "end_seconds": 278.02,
      "duration_seconds": 14.2,
      "text": "let me tell you where I've got to. It fits best with a minor clean wound that needs only dressing. I want to be honest that this is an impression, not a final answer"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.37,
      "end_seconds": 282.38,
      "duration_seconds": 3.01,
      "text": "yeah, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.72,
      "end_seconds": 303.08,
      "duration_seconds": 19.36,
      "text": "I understand the worry. At the moment I'd say it's a minor clean wound that needs only dressing, and we'll watch how it goes. I'll close it with adhesive strips and keep it dry for two days. Come back if it looks red or swollen."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.78,
      "end_seconds": 305.48,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.09,
      "end_seconds": 310.26,
      "duration_seconds": 3.17,
      "text": "anything else on your mind before you go?"
