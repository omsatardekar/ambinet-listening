      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.24,
      "end_seconds": 86.88,
      "duration_seconds": 8.64,
      "text": "okay: pressure 118 over 68 heart rate 66 temperature 36.9. And SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.01,
      "end_seconds": 89.99,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.49,
      "end_seconds": 102.14,
      "duration_seconds": 1.65,
      "text": "yeah no problem"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.92,
      "end_seconds": 105.19,
      "duration_seconds": 1.27,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.36,
      "end_seconds": 123.83,
      "duration_seconds": 6.47,
      "text": "it's a clean shallow cut, no longer bleeding, and the finger moves normally"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.89,
      "end_seconds": 127.5,
      "duration_seconds": 1.61,
      "text": "That's the examination finished."
    },
