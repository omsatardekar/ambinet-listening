    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.02,
      "end_seconds": 239.14,
      "duration_seconds": 2.12,
      "text": "Do you live by yourself?"
