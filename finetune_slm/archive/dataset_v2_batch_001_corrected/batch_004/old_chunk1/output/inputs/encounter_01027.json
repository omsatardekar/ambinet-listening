    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.49,
      "end_seconds": 37.63,
      "duration_seconds": 4.14,
      "text": "okay, go on. Has there been a little bleeding too?"
    },
