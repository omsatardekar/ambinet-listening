      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.8,
      "end_seconds": 255.56,
      "duration_seconds": 2.76,
      "text": "are you on any regular medication?"
