      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.07,
      "end_seconds": 148.0,
      "duration_seconds": 2.93,
      "text": "And what about numbness or dirty blade?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.96,
      "end_seconds": 153.18,
      "duration_seconds": 4.22,
      "text": "ah um no no numbness or dirty blade"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 158.64,
      "duration_seconds": 4.17,
      "text": "Alright anything with your heart like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.67,
      "end_seconds": 162.22,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
