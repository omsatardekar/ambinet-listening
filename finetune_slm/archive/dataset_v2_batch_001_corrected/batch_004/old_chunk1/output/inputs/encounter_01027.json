      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.46,
      "end_seconds": 201.74,
      "duration_seconds": 4.28,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.63,
      "end_seconds": 205.25,
      "duration_seconds": 1.62,
      "text": "No, no conditions."
