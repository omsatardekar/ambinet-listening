    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.35,
      "end_seconds": 233.66,
      "duration_seconds": 4.31,
      "text": "I'll have a glass of wine with dinner"
