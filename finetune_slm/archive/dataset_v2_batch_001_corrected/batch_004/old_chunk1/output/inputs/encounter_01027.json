      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.15,
      "end_seconds": 41.33,
      "duration_seconds": 3.18,
      "text": "Yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.75,
      "end_seconds": 47.72,
      "duration_seconds": 5.97,
      "text": "Okay, go on. Can I check a few measurements before we carry on?"
