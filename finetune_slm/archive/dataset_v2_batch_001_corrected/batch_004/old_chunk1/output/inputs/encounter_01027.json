      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.65,
      "end_seconds": 188.2,
      "duration_seconds": 4.55,
      "text": "Um, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.74,
      "end_seconds": 192.05,
      "duration_seconds": 3.31,
      "text": "Is there anything relevant on the family side?"
