    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.3,
      "end_seconds": 56.55,
      "duration_seconds": 2.25,
      "text": "Sit still for a moment..."
    },
