{
  "schema_version": "1.0",
  "encounter_id": "01266",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.49,
      "duration_seconds": 3.37,
      "text": "hello, doctor. I think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 8.94,
      "duration_seconds": 3.5,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.44,
      "end_seconds": 22.08,
      "duration_seconds": 11.64,
      "text": "Honestly, it's a severe headache, and my family pushed me to come. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.68,
      "end_seconds": 26.14,
      "duration_seconds": 3.46,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.06,
      "end_seconds": 31.22,
      "duration_seconds": 3.16,
      "text": "It's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.39,
      "end_seconds": 35.59,
      "duration_seconds": 3.2,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.74,
      "end_seconds": 40.81,
      "duration_seconds": 1.07,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.24,
      "end_seconds": 44.23,
      "duration_seconds": 1.99,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.37,
      "end_seconds": 55.65,
      "duration_seconds": 10.28,
      "text": "When it starts I tend to to get a high fever as well. The high fever? That's been for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.31,
      "end_seconds": 59.73,
      "duration_seconds": 3.42,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 74.96,
      "duration_seconds": 2.44,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.8,
      "end_seconds": 98.48,
      "duration_seconds": 6.68,
      "text": "okay: respiratory rate 18, blood pressure 116 over 71, oxygen saturation is 98 percent, pulse 103."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.12,
      "end_seconds": 101.55,
      "duration_seconds": 1.43,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.56,
      "end_seconds": 105.86,
      "duration_seconds": 2.3,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.74,
      "end_seconds": 111.94,
      "duration_seconds": 3.2,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.52,
      "end_seconds": 131.64,
      "duration_seconds": 1.12,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.57,
      "end_seconds": 135.89,
      "duration_seconds": 2.32,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.79,
      "end_seconds": 155.74,
      "duration_seconds": 7.95,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.08,
      "end_seconds": 159.78,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 172.33,
      "duration_seconds": 6.91,
      "text": "Alright, that's the examination finished. Okay, a few quick ones: cough or recent head injury?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.27,
      "end_seconds": 178.26,
      "duration_seconds": 4.99,
      "text": "I haven't had cough or recent head injury, no"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.97,
      "end_seconds": 181.93,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.24,
      "end_seconds": 186.9,
      "duration_seconds": 3.66,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.75,
      "end_seconds": 192.66,
      "duration_seconds": 3.91,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.95,
      "end_seconds": 196.2,
      "duration_seconds": 2.25,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.96,
      "end_seconds": 211.23,
      "duration_seconds": 1.27,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.9,
      "end_seconds": 215.24,
      "duration_seconds": 2.34,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.02,
      "end_seconds": 220.91,
      "duration_seconds": 3.89,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.66,
      "end_seconds": 223.12,
      "duration_seconds": 1.46,
      "text": "I've got asthma"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.47,
      "end_seconds": 232.79,
      "duration_seconds": 8.32,
      "text": "Alright, asthma, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.04,
      "end_seconds": 245.5,
      "duration_seconds": 11.46,
      "text": "I hardly move around during the day. I grab fast food at lunch most days. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.04,
      "end_seconds": 248.57,
      "duration_seconds": 2.53,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.62,
      "end_seconds": 255.41,
      "duration_seconds": 5.79,
      "text": "Seretide inhaler i take it twice a day for my asthma"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.62,
      "end_seconds": 257.04,
      "duration_seconds": 1.42,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.56,
      "end_seconds": 284.45,
      "duration_seconds": 13.89,
      "text": "okay, so my impression is this: I think we're dealing with possible bacterial meningitis at this stage. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.41,
      "end_seconds": 288.72,
      "duration_seconds": 3.31,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.24,
      "end_seconds": 309.15,
      "duration_seconds": 19.91,
      "text": "I can't promise yet, but most people with possible bacterial meningitis do well once it's treated properly. Let's get blood cultures, for possible meningitis. I'm going to order a lumbar puncture, for possible meningitis. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.87,
      "end_seconds": 313.26,
      "duration_seconds": 2.39,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.28,
      "end_seconds": 329.82,
      "duration_seconds": 14.54,
      "text": "I'll start you on benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.36,
      "end_seconds": 332.57,
      "duration_seconds": 1.21,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.29,
      "end_seconds": 344.25,
      "duration_seconds": 9.96,
      "text": "Call an ambulance now, this is an emergency. We'll refer you to the emergency team. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.0,
      "end_seconds": 349.35,
      "duration_seconds": 3.35,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}