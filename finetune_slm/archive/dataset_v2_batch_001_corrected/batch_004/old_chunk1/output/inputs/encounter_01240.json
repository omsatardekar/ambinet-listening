{
  "schema_version": "1.0",
  "encounter_id": "01240",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 7.25,
      "duration_seconds": 6.63,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 13.95,
      "duration_seconds": 5.07,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.14,
      "end_seconds": 24.51,
      "duration_seconds": 9.37,
      "text": "Mm, so the thing is, I've got difficulty swallowing. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.39,
      "end_seconds": 28.64,
      "duration_seconds": 2.25,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.33,
      "end_seconds": 33.4,
      "duration_seconds": 3.07,
      "text": "For two months, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.26,
      "end_seconds": 37.0,
      "duration_seconds": 2.74,
      "text": "Have you had a severe sore throat?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.56,
      "end_seconds": 54.32,
      "duration_seconds": 15.76,
      "text": "Yes, for one week. As for severe sore throat, I'd give it a three, out of ten. Drooling was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.83,
      "end_seconds": 56.05,
      "duration_seconds": 1.22,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.31,
      "end_seconds": 62.22,
      "duration_seconds": 4.91,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.49,
      "end_seconds": 64.7,
      "duration_seconds": 1.21,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.52,
      "end_seconds": 68.37,
      "duration_seconds": 2.85,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.13,
      "end_seconds": 71.24,
      "duration_seconds": 2.11,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.6,
      "end_seconds": 77.39,
      "duration_seconds": 4.79,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.17,
      "end_seconds": 82.16,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.03,
      "end_seconds": 87.08,
      "duration_seconds": 3.05,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.78,
      "end_seconds": 92.82,
      "duration_seconds": 4.04,
      "text": "Okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.12,
      "end_seconds": 98.32,
      "duration_seconds": 4.2,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.93,
      "end_seconds": 102.66,
      "duration_seconds": 2.73,
      "text": "Right, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.31,
      "end_seconds": 108.01,
      "duration_seconds": 3.7,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.27,
      "end_seconds": 112.5,
      "duration_seconds": 3.23,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.08,
      "end_seconds": 122.46,
      "duration_seconds": 9.38,
      "text": "I have low haemoglobin, for five years. Depression, for about ten years. I've got asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.16,
      "end_seconds": 125.75,
      "duration_seconds": 2.59,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.77,
      "end_seconds": 136.34,
      "duration_seconds": 8.57,
      "text": "Okay, I can see asthma in your file as well. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.24,
      "end_seconds": 149.68,
      "duration_seconds": 12.44,
      "text": "I think I reacted to some antibiotic once, uh, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.95,
      "end_seconds": 168.58,
      "duration_seconds": 4.63,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.08,
      "end_seconds": 201.89,
      "duration_seconds": 32.81,
      "text": "I'm on iron tablets, once a day for my blood count. I take sertraline, 50 milligrams, once a day for my mood. I'm on Seretide inhaler, twice a day. I didn't want to bother you but it keeps coming back. I thought it would sort itself out, but it hasn't. I'd been on mirtazapine, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.94,
      "end_seconds": 207.41,
      "duration_seconds": 3.47,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.78,
      "end_seconds": 214.62,
      "duration_seconds": 5.84,
      "text": "My father had bowel cancer. Erm, my mother had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.11,
      "end_seconds": 222.01,
      "duration_seconds": 2.9,
      "text": "And what about cough or rash?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.85,
      "end_seconds": 226.04,
      "duration_seconds": 3.19,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.81,
      "end_seconds": 229.83,
      "duration_seconds": 3.02,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.86,
      "end_seconds": 234.69,
      "duration_seconds": 2.83,
      "text": "Oh, no, joints are fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.94,
      "end_seconds": 238.71,
      "duration_seconds": 2.77,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.24,
      "end_seconds": 241.92,
      "duration_seconds": 1.68,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.91,
      "end_seconds": 246.27,
      "duration_seconds": 3.36,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.77,
      "end_seconds": 262.53,
      "duration_seconds": 2.76,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.42,
      "end_seconds": 289.25,
      "duration_seconds": 4.83,
      "text": "Okay: saturation 92 percent, pressure 138 over 87, pulse 84."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.28,
      "end_seconds": 293.04,
      "duration_seconds": 2.76,
      "text": "Well, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.32,
      "end_seconds": 297.95,
      "duration_seconds": 3.63,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.07,
      "end_seconds": 323.5,
      "duration_seconds": 9.43,
      "text": "So, based on your history, I'd lean towards a possible airway infection that needs emergency care. Severe tonsillitis is also on my list."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.26,
      "end_seconds": 328.75,
      "duration_seconds": 3.49,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.44,
      "end_seconds": 350.12,
      "duration_seconds": 20.68,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible airway infection that needs emergency care, but I'd like to confirm. Let me just check I've got this right. You've had difficulty swallowing for two months, and no rash or cough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.33,
      "end_seconds": 353.74,
      "duration_seconds": 2.41,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.83,
      "end_seconds": 372.0,
      "duration_seconds": 5.17,
      "text": "I'm going to order an urgent airway assessment, for stridor and drooling."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 373.5,
      "end_seconds": 376.91,
      "duration_seconds": 3.41,
      "text": "I can book that for Friday at 9 am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.98,
      "end_seconds": 396.76,
      "duration_seconds": 17.78,
      "text": "Do not lie flat, I am calling an ambulance now. Keep an eye out, and if the breathing gets harder, call us the same day or go to emergency. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.74,
      "end_seconds": 401.55,
      "duration_seconds": 2.81,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.59,
      "end_seconds": 409.01,
      "duration_seconds": 1.42,
      "text": "Goodbye for now."
    }
  ]
}