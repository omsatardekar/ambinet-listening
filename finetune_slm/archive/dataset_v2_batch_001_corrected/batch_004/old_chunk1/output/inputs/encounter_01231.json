{
  "schema_version": "1.0",
  "encounter_id": "01231",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.14,
      "end_seconds": 6.1,
      "duration_seconds": 4.96,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.78,
      "end_seconds": 12.62,
      "duration_seconds": 4.84,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.64,
      "end_seconds": 20.79,
      "duration_seconds": 6.15,
      "text": "Doctor, it's a sore ankle. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.48,
      "end_seconds": 26.24,
      "duration_seconds": 3.76,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.63,
      "end_seconds": 38.54,
      "duration_seconds": 10.91,
      "text": "Well, it's been one week, I'm fairly sure. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.48,
      "end_seconds": 45.34,
      "duration_seconds": 4.86,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 54.44,
      "duration_seconds": 7.44,
      "text": "Well, honestly, a few times a day. It's worse with walking. It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.36,
      "end_seconds": 60.12,
      "duration_seconds": 3.76,
      "text": "What about a little swelling, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 62.2,
      "end_seconds": 64.35,
      "duration_seconds": 2.15,
      "text": "Mm, uh, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.01,
      "end_seconds": 73.55,
      "duration_seconds": 8.54,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.35,
      "end_seconds": 79.56,
      "duration_seconds": 4.21,
      "text": "Mild, I'd say. I get some relief from elevation."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.16,
      "end_seconds": 82.03,
      "duration_seconds": 1.87,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 92.71,
      "end_seconds": 100.17,
      "duration_seconds": 7.46,
      "text": "Doctor, I've got the readings for you. Oxygen saturation is 98 percent, blood pressure 114 over 74, pulse 76."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.17,
      "end_seconds": 102.26,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.42,
      "end_seconds": 107.72,
      "duration_seconds": 3.3,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.45,
      "end_seconds": 109.99,
      "duration_seconds": 1.54,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.4,
      "end_seconds": 112.58,
      "duration_seconds": 1.18,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.51,
      "end_seconds": 136.45,
      "duration_seconds": 6.94,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.55,
      "end_seconds": 140.53,
      "duration_seconds": 1.98,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.65,
      "end_seconds": 149.12,
      "duration_seconds": 1.47,
      "text": "Nothing like numbness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.14,
      "end_seconds": 152.86,
      "duration_seconds": 1.72,
      "text": "No numbness, thankfully."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.28,
      "end_seconds": 158.52,
      "duration_seconds": 5.24,
      "text": "Mm, okay. Have you noticed crack or pop or pain in the foot?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.39,
      "end_seconds": 161.55,
      "duration_seconds": 2.16,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.9,
      "end_seconds": 165.48,
      "duration_seconds": 2.58,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.84,
      "end_seconds": 171.9,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.72,
      "end_seconds": 175.26,
      "duration_seconds": 2.54,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.23,
      "end_seconds": 179.87,
      "duration_seconds": 2.64,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.04,
      "end_seconds": 193.31,
      "duration_seconds": 4.27,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.46,
      "end_seconds": 197.86,
      "duration_seconds": 3.4,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.58,
      "end_seconds": 201.14,
      "duration_seconds": 2.56,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.12,
      "end_seconds": 218.64,
      "duration_seconds": 15.52,
      "text": "I take escitalopram, 10 milligrams, once a day. Um, I do miss it now and then, to be fair. It's ibuprofen gel, three times a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.22,
      "end_seconds": 223.97,
      "duration_seconds": 4.75,
      "text": "Yes. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 224.83,
      "end_seconds": 227.07,
      "duration_seconds": 2.24,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.19,
      "end_seconds": 233.41,
      "duration_seconds": 5.22,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 234.51,
      "end_seconds": 253.54,
      "duration_seconds": 19.03,
      "text": "I used to drink heavily but I stopped four years ago. No, I've never smoked in my life. I'm a plumber, lots of bending and kneeling. I hardly move around during the day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.56,
      "end_seconds": 256.86,
      "duration_seconds": 2.3,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.58,
      "end_seconds": 261.43,
      "duration_seconds": 2.85,
      "text": "Mm, I've had anxiety, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.16,
      "end_seconds": 264.47,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.12,
      "end_seconds": 268.53,
      "duration_seconds": 3.41,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.99,
      "end_seconds": 282.39,
      "duration_seconds": 12.4,
      "text": "Having listened and examined, this looks most like a mild ankle sprain. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.09,
      "end_seconds": 286.1,
      "duration_seconds": 2.01,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.15,
      "end_seconds": 308.52,
      "duration_seconds": 17.37,
      "text": "Nothing I've seen today points to an emergency. It looks like a mild ankle sprain. Rest, ice, a compression bandage and keep it raised for two days. I'd like you back if it is not better in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 309.62,
      "end_seconds": 311.57,
      "duration_seconds": 1.95,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.73,
      "end_seconds": 318.07,
      "duration_seconds": 5.34,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 320.08,
      "end_seconds": 324.05,
      "duration_seconds": 3.97,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}