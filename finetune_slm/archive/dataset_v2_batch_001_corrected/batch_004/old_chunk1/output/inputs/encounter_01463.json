{
  "schema_version": "1.0",
  "encounter_id": "01463",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.41,
      "duration_seconds": 3.41,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.28,
      "end_seconds": 10.15,
      "duration_seconds": 4.87,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.42,
      "end_seconds": 21.29,
      "duration_seconds": 6.87,
      "text": "Yeah, it's my face drooping on one side. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.7,
      "end_seconds": 26.98,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.32,
      "end_seconds": 33.72,
      "duration_seconds": 5.4,
      "text": "I'd say about two weeks. Actually, no, closer to three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.75,
      "end_seconds": 37.47,
      "duration_seconds": 2.72,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.57,
      "end_seconds": 41.04,
      "duration_seconds": 1.47,
      "text": "I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.3,
      "end_seconds": 44.27,
      "duration_seconds": 1.97,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.92,
      "end_seconds": 48.42,
      "duration_seconds": 3.5,
      "text": "It usually comes with a sudden headache."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.29,
      "end_seconds": 52.66,
      "duration_seconds": 2.37,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.59,
      "end_seconds": 56.49,
      "duration_seconds": 2.9,
      "text": "It, It happens all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.2,
      "end_seconds": 76.08,
      "duration_seconds": 3.88,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.84,
      "end_seconds": 79.5,
      "duration_seconds": 1.66,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.15,
      "end_seconds": 84.06,
      "duration_seconds": 2.91,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.95,
      "end_seconds": 87.43,
      "duration_seconds": 2.48,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.67,
      "end_seconds": 96.47,
      "duration_seconds": 2.8,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.96,
      "end_seconds": 101.75,
      "duration_seconds": 3.79,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 107.02,
      "duration_seconds": 4.43,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.16,
      "end_seconds": 112.19,
      "duration_seconds": 4.03,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.11,
      "end_seconds": 116.07,
      "duration_seconds": 1.96,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.43,
      "end_seconds": 121.43,
      "duration_seconds": 4.0,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.85,
      "end_seconds": 125.27,
      "duration_seconds": 2.42,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.74,
      "end_seconds": 130.81,
      "duration_seconds": 4.07,
      "text": "Oh, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.45,
      "end_seconds": 136.3,
      "duration_seconds": 4.85,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.2,
      "end_seconds": 141.7,
      "duration_seconds": 3.5,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.93,
      "end_seconds": 145.67,
      "duration_seconds": 2.74,
      "text": "A few quick ones: fever or seizure?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.67,
      "end_seconds": 150.74,
      "duration_seconds": 4.07,
      "text": "I haven't had fever or seizure, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.8,
      "end_seconds": 155.07,
      "duration_seconds": 2.27,
      "text": "How about loss of consciousness?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.86,
      "end_seconds": 159.21,
      "duration_seconds": 2.35,
      "text": "No loss of consciousness, thankfully."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.71,
      "end_seconds": 162.61,
      "duration_seconds": 2.9,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.33,
      "end_seconds": 165.43,
      "duration_seconds": 1.1,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.27,
      "end_seconds": 168.73,
      "duration_seconds": 2.46,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.73,
      "end_seconds": 182.39,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.11,
      "end_seconds": 206.07,
      "duration_seconds": 13.96,
      "text": "Okay: pressure 170 over 91, pulse is 82 beats a minute, weight 68 kilos, BMI works out to 26.9, height 159 centimetres, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.79,
      "end_seconds": 213.22,
      "duration_seconds": 4.43,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.52,
      "end_seconds": 232.17,
      "duration_seconds": 1.65,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.33,
      "end_seconds": 234.64,
      "duration_seconds": 1.31,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.82,
      "end_seconds": 258.07,
      "duration_seconds": 6.25,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.96,
      "end_seconds": 266.56,
      "duration_seconds": 2.6,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.64,
      "end_seconds": 293.17,
      "duration_seconds": 11.53,
      "text": "Let me just check I've got this right. You've had your face drooping on one side for three weeks, severe, and no loss of consciousness or seizure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.75,
      "end_seconds": 296.77,
      "duration_seconds": 2.02,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.89,
      "end_seconds": 328.84,
      "duration_seconds": 14.95,
      "text": "An urgent CT scan of the head is what I'd like next, for possible stroke. Call an ambulance now, you need hospital immediately. Book a review straight away. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.76,
      "end_seconds": 334.1,
      "duration_seconds": 3.34,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}