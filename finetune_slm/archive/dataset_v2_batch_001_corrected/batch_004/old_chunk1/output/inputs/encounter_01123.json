{
  "schema_version": "1.0",
  "encounter_id": "01123",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 5.0,
      "duration_seconds": 4.01,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 10.22,
      "duration_seconds": 4.51,
      "text": "So, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.61,
      "end_seconds": 16.9,
      "duration_seconds": 5.29,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.99,
      "end_seconds": 22.77,
      "duration_seconds": 3.78,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.25,
      "end_seconds": 34.57,
      "duration_seconds": 6.32,
      "text": "So the thing is, I've got sharp pain low on one side."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.19,
      "end_seconds": 37.07,
      "duration_seconds": 1.88,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.82,
      "end_seconds": 41.37,
      "duration_seconds": 2.55,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.0,
      "end_seconds": 46.96,
      "duration_seconds": 3.96,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.92,
      "end_seconds": 55.68,
      "duration_seconds": 7.76,
      "text": "Maybe a four out of ten on a bad day. I've also been feeling faint."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.12,
      "end_seconds": 59.92,
      "duration_seconds": 2.8,
      "text": "Any shoulder tip pain as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.95,
      "end_seconds": 67.7,
      "duration_seconds": 6.75,
      "text": "Yes, about the same, two weeks. About shoulder tip pain, honestly, every other day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.74,
      "end_seconds": 71.99,
      "duration_seconds": 3.25,
      "text": "Have you noticed vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.8,
      "end_seconds": 75.91,
      "duration_seconds": 3.11,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.28,
      "end_seconds": 79.34,
      "duration_seconds": 3.06,
      "text": "Mm-hmm. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.37,
      "end_seconds": 81.3,
      "duration_seconds": 0.93,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.41,
      "end_seconds": 85.86,
      "duration_seconds": 3.45,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.33,
      "end_seconds": 89.83,
      "duration_seconds": 2.5,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.87,
      "end_seconds": 93.24,
      "duration_seconds": 2.37,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.79,
      "end_seconds": 114.94,
      "duration_seconds": 20.15,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. No, I share a house with my brother. I retired from the post office two years ago. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.09,
      "end_seconds": 128.67,
      "duration_seconds": 2.58,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.51,
      "end_seconds": 136.46,
      "duration_seconds": 5.95,
      "text": "Not currently, but as a youngster tramadol gave me feeling very drowsy."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.78,
      "end_seconds": 148.89,
      "duration_seconds": 4.11,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.42,
      "end_seconds": 159.66,
      "duration_seconds": 9.24,
      "text": "I have high cholesterol, for about a year. I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.42,
      "end_seconds": 162.12,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.58,
      "end_seconds": 168.12,
      "duration_seconds": 1.54,
      "text": "Yes, thin bones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.1,
      "end_seconds": 170.27,
      "duration_seconds": 1.17,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.04,
      "end_seconds": 173.8,
      "duration_seconds": 1.76,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.86,
      "end_seconds": 185.57,
      "duration_seconds": 10.71,
      "text": "Yes, high cholesterol and high blood pressure are known to us, good to have that clear. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.78,
      "end_seconds": 208.16,
      "duration_seconds": 21.38,
      "text": "Atorvastatin, 20 milligrams, at night. It's amlodipine, 5 milligrams, once a day for my pressure. Alendronate. I take it 70 milligrams, once a week for my bones. Aspirin. I take it 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.01,
      "end_seconds": 212.58,
      "duration_seconds": 2.57,
      "text": "So, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.17,
      "end_seconds": 221.11,
      "duration_seconds": 6.94,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.8,
      "end_seconds": 227.19,
      "duration_seconds": 4.39,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.83,
      "end_seconds": 240.96,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.28,
      "end_seconds": 243.59,
      "duration_seconds": 1.31,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.1,
      "end_seconds": 267.09,
      "duration_seconds": 4.99,
      "text": "Your tummy is tender low on the right and you look pale."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.13,
      "end_seconds": 270.16,
      "duration_seconds": 1.03,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.07,
      "end_seconds": 293.0,
      "duration_seconds": 18.93,
      "text": "So, thank you, you can get dressed. Let's get a pregnancy test, for pelvic pain and bleeding. You need to go to the hospital now for an emergency scan. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.02,
      "end_seconds": 298.45,
      "duration_seconds": 3.43,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.62,
      "end_seconds": 305.32,
      "duration_seconds": 1.7,
      "text": "Okay, look after yourself."
    }
  ]
}