{
  "schema_version": "1.0",
  "encounter_id": "01477",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 5.9,
      "duration_seconds": 5.28,
      "text": "I mean, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.54,
      "end_seconds": 10.47,
      "duration_seconds": 3.93,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 17.79,
      "duration_seconds": 6.1,
      "text": "Ah, you know, I've been dealing with my throat closing up."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.8,
      "end_seconds": 23.98,
      "duration_seconds": 4.18,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.79,
      "end_seconds": 34.08,
      "duration_seconds": 2.29,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.06,
      "end_seconds": 56.46,
      "duration_seconds": 8.4,
      "text": "Okay: pulse 107, BP is 96 over 63, respiratory rate 17, temp 37.0 degrees. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.96,
      "end_seconds": 62.67,
      "duration_seconds": 5.71,
      "text": "Around six months... no wait, it's more like two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.41,
      "end_seconds": 67.92,
      "duration_seconds": 3.51,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.87,
      "end_seconds": 75.87,
      "duration_seconds": 6.0,
      "text": "Right, maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.36,
      "end_seconds": 79.55,
      "duration_seconds": 3.19,
      "text": "Sure. Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.3,
      "end_seconds": 85.57,
      "duration_seconds": 4.27,
      "text": "I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.26,
      "end_seconds": 89.51,
      "duration_seconds": 2.25,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.38,
      "end_seconds": 101.08,
      "duration_seconds": 9.7,
      "text": "Wheezing goes along with it, most of the time. Right, the wheezing? That's been since Friday."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.92,
      "end_seconds": 107.89,
      "duration_seconds": 5.97,
      "text": "Have you had your throat closing up before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.85,
      "end_seconds": 116.81,
      "duration_seconds": 6.96,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.68,
      "end_seconds": 121.89,
      "duration_seconds": 3.21,
      "text": "Did you get recent illness or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.07,
      "end_seconds": 127.33,
      "duration_seconds": 4.26,
      "text": "Oh, uh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.75,
      "end_seconds": 132.88,
      "duration_seconds": 5.13,
      "text": "Right, right. Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.28,
      "end_seconds": 135.76,
      "duration_seconds": 1.48,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.39,
      "end_seconds": 141.22,
      "duration_seconds": 3.83,
      "text": "Alright, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.97,
      "end_seconds": 143.16,
      "duration_seconds": 1.19,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.96,
      "end_seconds": 153.39,
      "duration_seconds": 2.43,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.73,
      "end_seconds": 161.2,
      "duration_seconds": 6.47,
      "text": "Yes, asthma. I, I have heart failure, for two years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.03,
      "end_seconds": 172.28,
      "duration_seconds": 9.25,
      "text": "Yes, asthma is known to us, good to have that clear. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.04,
      "end_seconds": 177.76,
      "duration_seconds": 3.72,
      "text": "Not to my knowledge, uh, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.18,
      "end_seconds": 181.53,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.48,
      "end_seconds": 210.48,
      "duration_seconds": 28.0,
      "text": "Well, I take Asthalin inhaler, when needed. I took the morning off to come in today. I'd rather know what's going on than keep guessing. Carvedilol. I take it 6.25 milligrams, twice a day for my heart. My sister suggested writing things down, but I forgot. I was on furosemide before. I stopped taking it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.13,
      "end_seconds": 228.15,
      "duration_seconds": 3.02,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.34,
      "end_seconds": 235.31,
      "duration_seconds": 5.97,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.15,
      "end_seconds": 239.09,
      "duration_seconds": 1.94,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.85,
      "end_seconds": 243.72,
      "duration_seconds": 2.87,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.87,
      "end_seconds": 248.26,
      "duration_seconds": 3.39,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.92,
      "end_seconds": 250.64,
      "duration_seconds": 1.72,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.61,
      "end_seconds": 253.85,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.92,
      "end_seconds": 272.82,
      "duration_seconds": 6.9,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.33,
      "end_seconds": 278.12,
      "duration_seconds": 2.79,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.18,
      "end_seconds": 288.9,
      "duration_seconds": 3.72,
      "text": "Monitoring is what I'd like next, for anaphylaxis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.7,
      "end_seconds": 290.83,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.64,
      "end_seconds": 298.24,
      "duration_seconds": 6.6,
      "text": "I'm prescribing adrenaline, 0.5 milligrams, once now, single dose. That's for anaphylaxis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.34,
      "end_seconds": 302.06,
      "duration_seconds": 1.72,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.43,
      "end_seconds": 309.32,
      "duration_seconds": 5.89,
      "text": "Lie flat with your legs raised, I am giving the injection now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 316.36,
      "duration_seconds": 6.8,
      "text": "Mm-hmm. Let's review you straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.29,
      "end_seconds": 321.28,
      "duration_seconds": 3.99,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}