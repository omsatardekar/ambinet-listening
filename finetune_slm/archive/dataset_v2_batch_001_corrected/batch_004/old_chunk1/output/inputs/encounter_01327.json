{
  "schema_version": "1.0",
  "encounter_id": "01327",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.21,
      "end_seconds": 7.28,
      "duration_seconds": 6.07,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.61,
      "end_seconds": 12.94,
      "duration_seconds": 4.33,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.72,
      "end_seconds": 23.52,
      "duration_seconds": 9.8,
      "text": "Actually, thank you for fitting us in, doctor. Doctor, it's been feeling well. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.85,
      "end_seconds": 27.72,
      "duration_seconds": 2.87,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 31.19,
      "end_seconds": 34.2,
      "duration_seconds": 3.01,
      "text": "I've had it since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 37.89,
      "duration_seconds": 2.88,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.78,
      "end_seconds": 48.53,
      "duration_seconds": 9.75,
      "text": "Severe, really. I've had slightly dry skin too, for three days. With slightly dry skin, about a four out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.59,
      "end_seconds": 66.31,
      "duration_seconds": 4.72,
      "text": "A few quick ones: palpitations, feeling cold or weight change?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 67.33,
      "end_seconds": 69.84,
      "duration_seconds": 2.51,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.4,
      "end_seconds": 72.8,
      "duration_seconds": 1.4,
      "text": "What about constipation?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.35,
      "end_seconds": 75.75,
      "duration_seconds": 2.4,
      "text": "I haven't noticed any constipation."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.41,
      "end_seconds": 78.87,
      "duration_seconds": 2.46,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 83.36,
      "end_seconds": 87.11,
      "duration_seconds": 3.75,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.77,
      "end_seconds": 92.12,
      "duration_seconds": 4.35,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.12,
      "end_seconds": 95.82,
      "duration_seconds": 2.7,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.62,
      "end_seconds": 112.45,
      "duration_seconds": 4.83,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.26,
      "end_seconds": 124.32,
      "duration_seconds": 10.06,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.3,
      "end_seconds": 130.55,
      "duration_seconds": 2.25,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.98,
      "end_seconds": 136.02,
      "duration_seconds": 4.04,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.91,
      "end_seconds": 140.96,
      "duration_seconds": 3.05,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 146.66,
      "end_seconds": 150.59,
      "duration_seconds": 3.93,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.42,
      "end_seconds": 156.28,
      "duration_seconds": 2.86,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.89,
      "end_seconds": 161.78,
      "duration_seconds": 3.89,
      "text": "I have an underactive thyroid. Yes, epilepsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.52,
      "end_seconds": 172.7,
      "duration_seconds": 10.18,
      "text": "Understood. Okay, I can see an underactive thyroid in your file as well. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.73,
      "end_seconds": 181.65,
      "duration_seconds": 7.92,
      "text": "It's Eltroxin, 100 micrograms, every morning. Mm, I take lamotrigine, 100 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 187.76,
      "end_seconds": 193.13,
      "duration_seconds": 5.37,
      "text": "That's what's prescribed, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.52,
      "end_seconds": 197.36,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.4,
      "end_seconds": 202.73,
      "duration_seconds": 3.33,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 203.28,
      "end_seconds": 216.72,
      "duration_seconds": 13.44,
      "text": "Here are the numbers, doctor. Weight 58 kilos, pulse is 86 beats a minute, temperature 36.6, height 186 centimetres, blood pressure 109 over 77, BMI works out to 16.8."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.39,
      "end_seconds": 219.09,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.62,
      "end_seconds": 224.21,
      "duration_seconds": 2.59,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.31,
      "end_seconds": 226.7,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.2,
      "end_seconds": 248.58,
      "duration_seconds": 4.38,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.12,
      "end_seconds": 253.18,
      "duration_seconds": 2.06,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.53,
      "end_seconds": 283.45,
      "duration_seconds": 11.92,
      "text": "Okay, thinking it through, I think we're dealing with well-controlled thyroid replacement at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 287.07,
      "end_seconds": 289.75,
      "duration_seconds": 2.68,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.96,
      "end_seconds": 310.6,
      "duration_seconds": 17.64,
      "text": "Nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement, but I'd like to confirm. Let me just check I've got this right. You've been feeling well, since last night, severe, and no feeling cold or palpitations."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 312.24,
      "end_seconds": 313.88,
      "duration_seconds": 1.64,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.93,
      "end_seconds": 330.07,
      "duration_seconds": 14.14,
      "text": "A thyroid blood test is what I'd like next, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. We'll catch up in twelve months."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.75,
      "end_seconds": 332.67,
      "duration_seconds": 1.92,
      "text": "Alright, I'll be back."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.41,
      "end_seconds": 337.87,
      "duration_seconds": 4.46,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 338.98,
      "end_seconds": 341.35,
      "duration_seconds": 2.37,
      "text": "Thank you, that's helpful."
    }
  ]
}