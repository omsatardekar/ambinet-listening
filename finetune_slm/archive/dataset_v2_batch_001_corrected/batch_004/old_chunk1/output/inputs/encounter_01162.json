{
  "schema_version": "1.0",
  "encounter_id": "01162",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.91,
      "end_seconds": 2.62,
      "duration_seconds": 1.71,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.18,
      "end_seconds": 4.4,
      "duration_seconds": 1.22,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.44,
      "end_seconds": 11.15,
      "duration_seconds": 4.71,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.38,
      "end_seconds": 14.17,
      "duration_seconds": 1.79,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.61,
      "end_seconds": 26.85,
      "duration_seconds": 6.24,
      "text": "So the thing is, I've got a cut on my finger."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.68,
      "end_seconds": 30.9,
      "duration_seconds": 3.22,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.69,
      "end_seconds": 37.45,
      "duration_seconds": 4.76,
      "text": "Yeah, um, about two weeks, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.52,
      "end_seconds": 44.27,
      "duration_seconds": 4.75,
      "text": "I, I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.34,
      "end_seconds": 49.55,
      "duration_seconds": 4.21,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.33,
      "end_seconds": 57.69,
      "duration_seconds": 3.36,
      "text": "Okay, so that sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.51,
      "end_seconds": 65.68,
      "duration_seconds": 3.17,
      "text": "Has there been a little bleeding too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.58,
      "end_seconds": 69.05,
      "duration_seconds": 1.47,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.33,
      "end_seconds": 74.62,
      "duration_seconds": 4.29,
      "text": "Right, a few quick ones: dirty blade or numbness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 75.48,
      "end_seconds": 78.0,
      "duration_seconds": 2.52,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.49,
      "end_seconds": 82.2,
      "duration_seconds": 2.71,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.76,
      "end_seconds": 84.3,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.33,
      "end_seconds": 102.05,
      "duration_seconds": 2.72,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.64,
      "end_seconds": 113.82,
      "duration_seconds": 11.18,
      "text": "Um, it's lansoprazole, 30 milligrams, before breakfast. Alendronate. I take it 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.39,
      "end_seconds": 119.8,
      "duration_seconds": 4.41,
      "text": "So, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.12,
      "end_seconds": 131.53,
      "duration_seconds": 7.41,
      "text": "Mm, no, it's at home. I was on omeprazole before. I stopped taking it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.02,
      "end_seconds": 137.74,
      "duration_seconds": 4.72,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.03,
      "end_seconds": 142.22,
      "duration_seconds": 3.19,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.02,
      "end_seconds": 145.73,
      "duration_seconds": 1.71,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.45,
      "end_seconds": 150.27,
      "duration_seconds": 3.82,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.94,
      "end_seconds": 153.31,
      "duration_seconds": 1.37,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.52,
      "end_seconds": 158.83,
      "duration_seconds": 4.31,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.48,
      "end_seconds": 167.68,
      "duration_seconds": 4.2,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.69,
      "end_seconds": 172.27,
      "duration_seconds": 3.58,
      "text": "I've got acid reflux. I've got thin bones."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.41,
      "end_seconds": 181.93,
      "duration_seconds": 4.52,
      "text": "Alright, acid reflux, that matches what I have here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.45,
      "end_seconds": 195.81,
      "duration_seconds": 3.36,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.47,
      "end_seconds": 203.02,
      "duration_seconds": 6.55,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.11,
      "end_seconds": 209.42,
      "duration_seconds": 4.31,
      "text": "Alright, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.49,
      "end_seconds": 217.44,
      "duration_seconds": 5.95,
      "text": "My daughter has type 1 diabetes. My sister had breast cancer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 230.22,
      "end_seconds": 240.89,
      "duration_seconds": 10.67,
      "text": "Okay, so the vitals from earlier. Pulse is 71 beats a minute, BP is 123 over 78, temperature 36.6, saturation 98 percent."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.88,
      "end_seconds": 243.89,
      "duration_seconds": 1.01,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.89,
      "end_seconds": 248.51,
      "duration_seconds": 3.62,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 250.92,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.85,
      "end_seconds": 268.33,
      "duration_seconds": 5.48,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.58,
      "end_seconds": 280.87,
      "duration_seconds": 10.29,
      "text": "Okay, you can sit up now. Having listened and examined, this is probably a minor clean wound that needs only dressing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.62,
      "end_seconds": 285.37,
      "duration_seconds": 2.75,
      "text": "Mm, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.76,
      "end_seconds": 303.12,
      "duration_seconds": 16.36,
      "text": "Nothing I've seen today points to an emergency. It looks like a minor clean wound that needs only dressing. Stop me if I've got anything wrong. You've had a cut on your finger, and no dirty blade or numbness."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.95,
      "end_seconds": 304.65,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.6,
      "end_seconds": 320.2,
      "duration_seconds": 13.6,
      "text": "I'll close it with adhesive strips and keep it dry for two days. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.94,
      "end_seconds": 324.38,
      "duration_seconds": 3.44,
      "text": "Oh, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.29,
      "end_seconds": 345.02,
      "duration_seconds": 18.73,
      "text": "Come back or go to emergency straight away if the finger turns red, hot or swollen. Let's plan a check if it looks red or swollen. So, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.09,
      "end_seconds": 353.31,
      "duration_seconds": 7.22,
      "text": "So, I come back if it looks red or swollen. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.02,
      "end_seconds": 359.48,
      "duration_seconds": 4.46,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 360.62,
      "end_seconds": 364.05,
      "duration_seconds": 3.43,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}