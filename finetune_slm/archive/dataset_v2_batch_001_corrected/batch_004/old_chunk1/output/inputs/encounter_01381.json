{
  "schema_version": "1.0",
  "encounter_id": "01381",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 5.8,
      "duration_seconds": 4.96,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.38,
      "end_seconds": 13.26,
      "duration_seconds": 4.88,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.03,
      "end_seconds": 18.59,
      "duration_seconds": 3.56,
      "text": "Well, I've been having a high fever."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.57,
      "end_seconds": 22.06,
      "duration_seconds": 2.49,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.09,
      "end_seconds": 26.54,
      "duration_seconds": 2.45,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.23,
      "end_seconds": 32.04,
      "duration_seconds": 1.81,
      "text": "Okay, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.79,
      "end_seconds": 39.32,
      "duration_seconds": 5.53,
      "text": "Let me think, it's been going on for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.18,
      "end_seconds": 42.7,
      "duration_seconds": 2.52,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.21,
      "end_seconds": 49.01,
      "duration_seconds": 5.8,
      "text": "It's a couple of times a week. Oh, and dark blisters."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.03,
      "end_seconds": 54.12,
      "duration_seconds": 3.09,
      "text": "And what about insect bite or cut?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.01,
      "end_seconds": 58.87,
      "duration_seconds": 2.86,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.52,
      "end_seconds": 63.65,
      "duration_seconds": 4.13,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.84,
      "end_seconds": 67.47,
      "duration_seconds": 2.63,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.2,
      "end_seconds": 71.61,
      "duration_seconds": 3.41,
      "text": "Okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.6,
      "end_seconds": 75.55,
      "duration_seconds": 2.95,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.7,
      "end_seconds": 91.33,
      "duration_seconds": 4.63,
      "text": "Okay, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.93,
      "end_seconds": 100.86,
      "duration_seconds": 3.93,
      "text": "Yes, wheat, it gives me itchy skin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.38,
      "end_seconds": 105.26,
      "duration_seconds": 3.88,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.49,
      "end_seconds": 110.29,
      "duration_seconds": 1.8,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.51,
      "end_seconds": 125.31,
      "duration_seconds": 4.8,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.31,
      "end_seconds": 129.45,
      "duration_seconds": 3.14,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.77,
      "end_seconds": 144.06,
      "duration_seconds": 2.29,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.43,
      "end_seconds": 150.09,
      "duration_seconds": 4.66,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.87,
      "end_seconds": 155.29,
      "duration_seconds": 3.42,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.25,
      "end_seconds": 160.47,
      "duration_seconds": 3.22,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.94,
      "end_seconds": 175.15,
      "duration_seconds": 4.21,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.16,
      "end_seconds": 188.81,
      "duration_seconds": 3.65,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.52,
      "end_seconds": 214.13,
      "duration_seconds": 7.61,
      "text": "Okay: temperature 38.6, BP is 120 over 72, saturation 95 percent, heart rate 102."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.43,
      "end_seconds": 216.83,
      "duration_seconds": 1.4,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.69,
      "end_seconds": 220.97,
      "duration_seconds": 3.28,
      "text": "So, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.15,
      "end_seconds": 226.77,
      "duration_seconds": 3.62,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.33,
      "end_seconds": 231.53,
      "duration_seconds": 3.2,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.74,
      "end_seconds": 254.14,
      "duration_seconds": 7.4,
      "text": "The skin on your leg is dusky with blisters and is very tender, and you are feverish."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.74,
      "end_seconds": 260.67,
      "duration_seconds": 0.93,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.46,
      "end_seconds": 283.81,
      "duration_seconds": 17.35,
      "text": "You can relax now. So, based on the history and the examination, my working impression is a severe deep skin infection needing urgent surgery review. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.72,
      "end_seconds": 288.5,
      "duration_seconds": 2.78,
      "text": "Hmm, will it clear up?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.38,
      "end_seconds": 318.12,
      "duration_seconds": 28.74,
      "text": "It's reasonable to be concerned, but right now a severe deep skin infection needing urgent surgery review is my leading thought, not anything worse. I think an urgent surgical review makes sense here, for possible necrotising infection. I'd like to arrange urgent blood tests for severe skin infection. I am sending you to hospital now, do not wait. We'll refer you to the surgical team."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.36,
      "end_seconds": 322.22,
      "duration_seconds": 2.86,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.06,
      "end_seconds": 331.76,
      "duration_seconds": 8.7,
      "text": "The thing that would worry me is if you cannot go now. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.31,
      "end_seconds": 335.91,
      "duration_seconds": 1.6,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.26,
      "end_seconds": 344.39,
      "duration_seconds": 7.13,
      "text": "Please come and see me straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.05,
      "end_seconds": 352.52,
      "duration_seconds": 3.47,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.02,
      "end_seconds": 355.38,
      "duration_seconds": 1.36,
      "text": "Goodbye for now."
    }
  ]
}