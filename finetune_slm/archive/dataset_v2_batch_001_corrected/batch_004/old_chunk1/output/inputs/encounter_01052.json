{
  "schema_version": "1.0",
  "encounter_id": "01052",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 5.71,
      "duration_seconds": 5.08,
      "text": "right, you know, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.48,
      "end_seconds": 11.43,
      "duration_seconds": 3.95,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.5,
      "end_seconds": 21.02,
      "duration_seconds": 7.52,
      "text": "Doctor, you know, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.46,
      "end_seconds": 26.35,
      "duration_seconds": 3.89,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.33,
      "end_seconds": 31.59,
      "duration_seconds": 4.26,
      "text": "I've been dealing with weakness in my right arm"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.32,
      "end_seconds": 35.63,
      "duration_seconds": 3.31,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 43.34,
      "duration_seconds": 2.63,
      "text": "Ever since... since yesterday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.74,
      "end_seconds": 47.83,
      "duration_seconds": 4.09,
      "text": "understood rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.7,
      "end_seconds": 56.15,
      "duration_seconds": 7.45,
      "text": "Pretty moderate, if I'm being honest. I had slurred speech before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.0,
      "end_seconds": 61.45,
      "duration_seconds": 3.45,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.53,
      "end_seconds": 69.77,
      "duration_seconds": 2.24,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.58,
      "end_seconds": 96.88,
      "duration_seconds": 6.3,
      "text": "okay: pulse 81, respiratory rate 17, BP is 162 over 97. And saturation 98 percent"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.91,
      "end_seconds": 100.38,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.68,
      "end_seconds": 104.18,
      "duration_seconds": 2.5,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.04,
      "end_seconds": 111.01,
      "duration_seconds": 3.97,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.95,
      "end_seconds": 130.99,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.48,
      "end_seconds": 135.48,
      "duration_seconds": 3.0,
      "text": "I'll listen to to your chest now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.43,
      "end_seconds": 152.02,
      "duration_seconds": 6.59,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.08,
      "end_seconds": 161.08,
      "duration_seconds": 6.0,
      "text": "You can relax now. Did you get loss of consciousness, fever or seizure?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.69,
      "end_seconds": 165.22,
      "duration_seconds": 2.53,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.46,
      "end_seconds": 169.58,
      "duration_seconds": 3.12,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.48,
      "end_seconds": 174.71,
      "duration_seconds": 3.23,
      "text": "Nothing on the the skin, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.06,
      "end_seconds": 180.58,
      "duration_seconds": 4.52,
      "text": "Any inherited conditions that that you know of in the family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.14,
      "end_seconds": 183.39,
      "duration_seconds": 2.25,
      "text": "my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.14,
      "end_seconds": 186.8,
      "duration_seconds": 1.66,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.41,
      "end_seconds": 189.65,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.68,
      "end_seconds": 193.04,
      "duration_seconds": 1.36,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.29,
      "end_seconds": 200.75,
      "duration_seconds": 3.46,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.77,
      "end_seconds": 208.32,
      "duration_seconds": 2.55,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.17,
      "end_seconds": 212.58,
      "duration_seconds": 3.41,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.56,
      "end_seconds": 223.5,
      "duration_seconds": 1.94,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.43,
      "end_seconds": 228.33,
      "duration_seconds": 2.9,
      "text": "no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.95,
      "end_seconds": 249.85,
      "duration_seconds": 2.9,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.66,
      "end_seconds": 261.96,
      "duration_seconds": 10.3,
      "text": "So, yes, plasters. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.74,
      "end_seconds": 265.66,
      "duration_seconds": 2.92,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.54,
      "end_seconds": 270.16,
      "duration_seconds": 2.62,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.7,
      "end_seconds": 274.26,
      "duration_seconds": 3.56,
      "text": "mm-hmm have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.1,
      "end_seconds": 277.16,
      "duration_seconds": 2.06,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.08,
      "end_seconds": 294.5,
      "duration_seconds": 16.42,
      "text": "Let me tell you where I've got to. The most likely explanation is a possible stroke, within the treatment window. I want to be honest that this is an impression, not a final answer. A migraine with aura is still possible."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.06,
      "end_seconds": 298.81,
      "duration_seconds": 3.75,
      "text": "Well, what are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.58,
      "end_seconds": 314.6,
      "duration_seconds": 14.02,
      "text": "I understand the worry. At the moment I'd say it's a possible stroke, within the treatment window, and we'll watch how it goes. Call an ambulance now, you need hospital immediately."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.86,
      "end_seconds": 323.73,
      "duration_seconds": 8.87,
      "text": "I follow. Come back or go to emergency straight away if the symptoms change. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.74,
      "end_seconds": 328.7,
      "duration_seconds": 3.96,
      "text": "So, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.5,
      "end_seconds": 332.36,
      "duration_seconds": 1.86,
      "text": "Alright, goodbye for now."
    }
  ]
}