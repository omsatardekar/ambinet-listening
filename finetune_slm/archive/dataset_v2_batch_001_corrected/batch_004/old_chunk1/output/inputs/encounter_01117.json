{
  "schema_version": "1.0",
  "encounter_id": "01117",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.26,
      "end_seconds": 3.49,
      "duration_seconds": 2.23,
      "text": "hi, sit anywhere you like"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.32,
      "end_seconds": 6.51,
      "duration_seconds": 2.19,
      "text": "hello, uh, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.44,
      "end_seconds": 15.01,
      "duration_seconds": 6.57,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.99,
      "end_seconds": 26.13,
      "duration_seconds": 6.14,
      "text": "that's fine, sit down we'll go through it together weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.32,
      "end_seconds": 33.9,
      "duration_seconds": 6.58,
      "text": "It has. I got caught in the the rain walking over."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.04,
      "end_seconds": 36.25,
      "duration_seconds": 1.21,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.59,
      "end_seconds": 40.53,
      "duration_seconds": 2.94,
      "text": "we came because of vomiting blood"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.39,
      "end_seconds": 47.61,
      "duration_seconds": 5.22,
      "text": "Did it come on recently? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.25,
      "end_seconds": 51.83,
      "duration_seconds": 3.58,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.12,
      "end_seconds": 55.72,
      "duration_seconds": 2.6,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.56,
      "end_seconds": 64.51,
      "duration_seconds": 3.95,
      "text": "It's a couple of times a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.22,
      "end_seconds": 68.73,
      "duration_seconds": 3.51,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.8,
      "end_seconds": 72.32,
      "duration_seconds": 1.52,
      "text": "I'd say mild"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.34,
      "end_seconds": 76.06,
      "duration_seconds": 2.72,
      "text": "So, have you been feeling faint?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.92,
      "end_seconds": 99.68,
      "duration_seconds": 21.76,
      "text": "yes, uh, for five days with feeling faint, it happens every other day oh, and black tarry stools i mean, with black tarry stools, maybe a five out of ten on a bad day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.18,
      "end_seconds": 104.58,
      "duration_seconds": 3.4,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.11,
      "end_seconds": 114.28,
      "duration_seconds": 4.17,
      "text": "Ah, no, no fever or chest pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.08,
      "end_seconds": 118.87,
      "duration_seconds": 3.79,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.92,
      "end_seconds": 123.03,
      "duration_seconds": 2.11,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.34,
      "end_seconds": 137.9,
      "duration_seconds": 4.56,
      "text": "Right, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 138.49,
      "end_seconds": 151.8,
      "duration_seconds": 13.31,
      "text": "oh, he is on lansoprazole, 30 milligrams, before breakfast, I give it to him. He takes ibuprofen, 400 milligrams, three times a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.26,
      "end_seconds": 155.88,
      "duration_seconds": 2.62,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.0,
      "end_seconds": 162.22,
      "duration_seconds": 5.22,
      "text": "Well, I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.56,
      "end_seconds": 166.85,
      "duration_seconds": 3.29,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.57,
      "end_seconds": 171.95,
      "duration_seconds": 4.38,
      "text": "I've had acid reflux for two years now"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.82,
      "end_seconds": 184.15,
      "duration_seconds": 1.33,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.04,
      "end_seconds": 190.96,
      "duration_seconds": 4.92,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.8,
      "end_seconds": 193.45,
      "duration_seconds": 1.65,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.92,
      "end_seconds": 196.85,
      "duration_seconds": 1.93,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.19,
      "end_seconds": 200.61,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.34,
      "end_seconds": 205.85,
      "duration_seconds": 4.51,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 210.07,
      "duration_seconds": 2.54,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.71,
      "end_seconds": 214.51,
      "duration_seconds": 3.8,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.12,
      "end_seconds": 218.14,
      "duration_seconds": 2.02,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.96,
      "end_seconds": 224.9,
      "duration_seconds": 4.94,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.65,
      "end_seconds": 228.39,
      "duration_seconds": 2.74,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.38,
      "end_seconds": 232.34,
      "duration_seconds": 1.96,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.76,
      "end_seconds": 235.96,
      "duration_seconds": 2.2,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.7,
      "end_seconds": 250.49,
      "duration_seconds": 2.79,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.07,
      "end_seconds": 279.51,
      "duration_seconds": 13.44,
      "text": "okay: temperature is 36.8 degrees, weight 55 kilos, BMI works out to 20.4. And heart rate 123, blood pressure 117 over 78, height 164 centimetres"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.9,
      "end_seconds": 284.38,
      "duration_seconds": 3.48,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.96,
      "end_seconds": 286.13,
      "duration_seconds": 1.17,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.06,
      "end_seconds": 290.33,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.52,
      "end_seconds": 312.99,
      "duration_seconds": 6.47,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.86,
      "end_seconds": 330.85,
      "duration_seconds": 12.99,
      "text": "please sit back down. Right, here's what I'm thinking. The most likely explanation is a possible bleeding stomach ulcer. We shouldn't forget a bleed from the gullet"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.51,
      "end_seconds": 362.69,
      "duration_seconds": 19.18,
      "text": "Urgent blood tests is what I'd like next, for bleeding. Please stop the ibuprofen and do not eat or drink. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.28,
      "end_seconds": 370.16,
      "duration_seconds": 6.88,
      "text": "Ah. Come back or go to emergency straight away if you vomit again. Come back straight away."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.01,
      "end_seconds": 375.29,
      "duration_seconds": 3.28,
      "text": "Um, good, I'll return then."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.8,
      "end_seconds": 378.32,
      "duration_seconds": 2.52,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.71,
      "end_seconds": 381.48,
      "duration_seconds": 1.77,
      "text": "That's clear, thanks."
    }
  ]
}