{
  "schema_version": "1.0",
  "encounter_id": "01500",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 6.14,
      "duration_seconds": 4.92,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.03,
      "end_seconds": 12.97,
      "duration_seconds": 4.94,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.85,
      "end_seconds": 19.94,
      "duration_seconds": 5.09,
      "text": "so, I've been passing a lot of urine, doctor"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.85,
      "end_seconds": 23.16,
      "duration_seconds": 2.31,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.81,
      "end_seconds": 44.54,
      "duration_seconds": 20.73,
      "text": "Ten days, I think... sorry, two days, I got that wrong. My sister suggested writing things down, but I forgot. Oh, you know, and and tummy pain. That's been about the same, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 45.14,
      "end_seconds": 55.04,
      "duration_seconds": 9.9,
      "text": "Here are the numbers, doctor. BP is 118 over 88, SpO2 96 percent on room air. Pulse 118, temperature 36.8, respiratory rate 20."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.39,
      "end_seconds": 57.09,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.43,
      "end_seconds": 63.0,
      "duration_seconds": 4.57,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.75,
      "end_seconds": 68.77,
      "duration_seconds": 1.02,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.08,
      "end_seconds": 73.11,
      "duration_seconds": 3.03,
      "text": "right, take a deep breath for me"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.1,
      "end_seconds": 86.71,
      "duration_seconds": 4.61,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.52,
      "end_seconds": 96.96,
      "duration_seconds": 5.44,
      "text": "Good, you can sit up again. Did you get cough or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.98,
      "end_seconds": 103.49,
      "duration_seconds": 5.51,
      "text": "erm, I haven't had cough or chest pain, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.73,
      "end_seconds": 107.18,
      "duration_seconds": 2.45,
      "text": "is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.09,
      "end_seconds": 115.17,
      "duration_seconds": 3.08,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.57,
      "end_seconds": 128.34,
      "duration_seconds": 2.77,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.4,
      "end_seconds": 132.99,
      "duration_seconds": 3.59,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.21,
      "end_seconds": 139.12,
      "duration_seconds": 4.91,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.09,
      "end_seconds": 141.89,
      "duration_seconds": 1.8,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.58,
      "end_seconds": 144.36,
      "duration_seconds": 0.78,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.18,
      "end_seconds": 150.21,
      "duration_seconds": 4.03,
      "text": "I have about eight cigarettes in a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.83,
      "end_seconds": 153.48,
      "duration_seconds": 1.65,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.86,
      "end_seconds": 160.72,
      "duration_seconds": 5.86,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.65,
      "end_seconds": 163.93,
      "duration_seconds": 2.28,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.95,
      "end_seconds": 173.83,
      "duration_seconds": 4.88,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.88,
      "end_seconds": 178.63,
      "duration_seconds": 2.75,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.34,
      "end_seconds": 183.2,
      "duration_seconds": 3.86,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.62,
      "end_seconds": 187.74,
      "duration_seconds": 3.12,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.12,
      "end_seconds": 196.94,
      "duration_seconds": 7.82,
      "text": "I've had diabetes, yes. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.98,
      "end_seconds": 198.77,
      "duration_seconds": 0.79,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.89,
      "end_seconds": 214.91,
      "duration_seconds": 11.02,
      "text": "I've had gout, yes. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.42,
      "end_seconds": 220.74,
      "duration_seconds": 5.32,
      "text": "Yes, diabetes is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.38,
      "end_seconds": 242.8,
      "duration_seconds": 3.42,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.31,
      "end_seconds": 248.15,
      "duration_seconds": 3.84,
      "text": "Sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.67,
      "end_seconds": 249.5,
      "duration_seconds": 0.83,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.15,
      "end_seconds": 255.82,
      "duration_seconds": 4.67,
      "text": "Ah, uh, I take febuxostat, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.31,
      "end_seconds": 259.59,
      "duration_seconds": 2.28,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.38,
      "end_seconds": 262.42,
      "duration_seconds": 1.04,
      "text": "80 milligrams."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.04,
      "end_seconds": 286.13,
      "duration_seconds": 8.09,
      "text": "okay, thinking it through, it fits best with diabetic ketoacidosis i can't rule out a severe infection yet"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.06,
      "end_seconds": 293.63,
      "duration_seconds": 5.57,
      "text": "Well, you know, is there something to worry about?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.68,
      "end_seconds": 303.69,
      "duration_seconds": 8.01,
      "text": "it's reasonable to be concerned, but right now diabetic ketoacidosis is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 308.79,
      "end_seconds": 313.76,
      "duration_seconds": 4.97,
      "text": "We've already done a blood sugar and ketone test this morning, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.79,
      "end_seconds": 328.88,
      "duration_seconds": 13.09,
      "text": "okay, I'll take a look at that. You need to go to hospital now for insulin and fluids. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.96,
      "end_seconds": 339.03,
      "duration_seconds": 4.07,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.07,
      "end_seconds": 342.32,
      "duration_seconds": 1.25,
      "text": "All the best."
    }
  ]
}