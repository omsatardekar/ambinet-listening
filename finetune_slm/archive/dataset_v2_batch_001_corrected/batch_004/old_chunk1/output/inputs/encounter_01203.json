{
  "schema_version": "1.0",
  "encounter_id": "01203",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 2.7,
      "duration_seconds": 1.66,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.73,
      "end_seconds": 8.67,
      "duration_seconds": 3.94,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.25,
      "end_seconds": 13.92,
      "duration_seconds": 3.67,
      "text": "I'm here because of a severe headache."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 14.9,
      "end_seconds": 17.69,
      "duration_seconds": 2.79,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.61,
      "end_seconds": 22.4,
      "duration_seconds": 2.79,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.96,
      "end_seconds": 27.23,
      "duration_seconds": 3.27,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.97,
      "end_seconds": 31.36,
      "duration_seconds": 3.39,
      "text": "It's been going on for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.01,
      "end_seconds": 34.83,
      "duration_seconds": 2.82,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.77,
      "end_seconds": 38.03,
      "duration_seconds": 2.26,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.76,
      "end_seconds": 42.71,
      "duration_seconds": 2.95,
      "text": "Has there been a stiff neck too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.1,
      "end_seconds": 45.6,
      "duration_seconds": 1.5,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.47,
      "end_seconds": 61.04,
      "duration_seconds": 3.57,
      "text": "Did you get cough or recent head injury?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.39,
      "end_seconds": 66.84,
      "duration_seconds": 2.45,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.33,
      "end_seconds": 70.69,
      "duration_seconds": 2.36,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.56,
      "end_seconds": 74.48,
      "duration_seconds": 2.92,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.31,
      "end_seconds": 82.2,
      "duration_seconds": 3.89,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.59,
      "end_seconds": 88.19,
      "duration_seconds": 4.6,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.26,
      "end_seconds": 92.74,
      "duration_seconds": 2.48,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.29,
      "end_seconds": 95.45,
      "duration_seconds": 2.16,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.36,
      "end_seconds": 102.01,
      "duration_seconds": 4.65,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.09,
      "end_seconds": 106.13,
      "duration_seconds": 3.04,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.11,
      "end_seconds": 109.59,
      "duration_seconds": 1.48,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.69,
      "end_seconds": 114.26,
      "duration_seconds": 3.57,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.91,
      "end_seconds": 116.65,
      "duration_seconds": 1.74,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.24,
      "end_seconds": 125.62,
      "duration_seconds": 3.38,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.8,
      "end_seconds": 128.85,
      "duration_seconds": 2.05,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.71,
      "end_seconds": 134.06,
      "duration_seconds": 4.35,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.39,
      "end_seconds": 137.96,
      "duration_seconds": 2.57,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.64,
      "end_seconds": 143.47,
      "duration_seconds": 3.83,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.38,
      "end_seconds": 148.41,
      "duration_seconds": 3.03,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.55,
      "end_seconds": 155.24,
      "duration_seconds": 5.69,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 172.06,
      "duration_seconds": 4.21,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.06,
      "end_seconds": 177.57,
      "duration_seconds": 3.51,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.32,
      "end_seconds": 191.69,
      "duration_seconds": 3.37,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.33,
      "end_seconds": 200.86,
      "duration_seconds": 2.53,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.2,
      "end_seconds": 222.86,
      "duration_seconds": 4.66,
      "text": "Okay: pulse 93, blood pressure 126 over 72, saturation 96 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.28,
      "end_seconds": 228.81,
      "duration_seconds": 3.53,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.15,
      "end_seconds": 231.32,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.23,
      "end_seconds": 249.04,
      "duration_seconds": 8.81,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.31,
      "end_seconds": 262.32,
      "duration_seconds": 9.01,
      "text": "All finished, thank you. Okay, thinking it through, I think we're dealing with possible bacterial meningitis at this stage."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.34,
      "end_seconds": 266.69,
      "duration_seconds": 3.35,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.57,
      "end_seconds": 284.74,
      "duration_seconds": 16.17,
      "text": "It's reasonable to be concerned, but right now possible bacterial meningitis is my leading thought, not anything worse. So, to recap quickly. You've had a severe headache for five days, severe, and no recent head injury or cough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.9,
      "end_seconds": 288.21,
      "duration_seconds": 2.31,
      "text": "That's what happened, yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.5,
      "end_seconds": 323.95,
      "duration_seconds": 28.45,
      "text": "A lumbar puncture is what I'd like next, for possible meningitis. It's a routine test and it'll give us a much clearer picture. Let's use benzylpenicillin, 1.2 grams, once now, single dose. It's for possible meningitis. Call an ambulance now, this is an emergency. I'd like you back straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.51,
      "end_seconds": 327.67,
      "duration_seconds": 3.16,
      "text": "I think I understand everything. Thanks."
    }
  ]
}