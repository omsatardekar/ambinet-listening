{
  "schema_version": "1.0",
  "encounter_id": "01292",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 3.03,
      "duration_seconds": 2.52,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.89,
      "end_seconds": 8.97,
      "duration_seconds": 4.08,
      "text": "Morning, uh, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.99,
      "end_seconds": 11.7,
      "duration_seconds": 1.71,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 21.71,
      "duration_seconds": 9.51,
      "text": "Okay, so it's a tight band around my head. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.53,
      "end_seconds": 25.47,
      "duration_seconds": 2.94,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.26,
      "end_seconds": 36.04,
      "duration_seconds": 2.78,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.91,
      "end_seconds": 66.25,
      "duration_seconds": 8.34,
      "text": "Okay: heart rate 65, temperature 36.9, oxygen saturation is 97 percent, BP is 114 over 82."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.95,
      "end_seconds": 77.95,
      "duration_seconds": 2.0,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.3,
      "end_seconds": 86.14,
      "duration_seconds": 2.84,
      "text": "Ever since... since last Tuesday, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.75,
      "end_seconds": 98.8,
      "duration_seconds": 9.05,
      "text": "Alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.56,
      "end_seconds": 114.34,
      "duration_seconds": 13.78,
      "text": "I'd say a couple of times a week. Pretty mild, if I'm being honest. Yes, stress and long screen days. That makes it worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.65,
      "end_seconds": 135.94,
      "duration_seconds": 5.29,
      "text": "Let me check a few things. Any blurred vision or sensitivity to light?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.85,
      "end_seconds": 141.46,
      "duration_seconds": 4.61,
      "text": "No blurred vision or sensitivity to light, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.65,
      "end_seconds": 145.7,
      "duration_seconds": 3.05,
      "text": "Have you had any weakness or sickness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.9,
      "end_seconds": 149.18,
      "duration_seconds": 2.28,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.11,
      "end_seconds": 154.19,
      "duration_seconds": 4.08,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.23,
      "end_seconds": 158.32,
      "duration_seconds": 2.09,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.61,
      "end_seconds": 164.96,
      "duration_seconds": 2.35,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.68,
      "end_seconds": 170.11,
      "duration_seconds": 4.43,
      "text": "I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.2,
      "end_seconds": 185.12,
      "duration_seconds": 3.92,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.82,
      "end_seconds": 191.02,
      "duration_seconds": 5.2,
      "text": "I'm on rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.61,
      "end_seconds": 194.99,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.83,
      "end_seconds": 201.71,
      "duration_seconds": 5.88,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.47,
      "end_seconds": 206.3,
      "duration_seconds": 2.83,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.33,
      "end_seconds": 211.05,
      "duration_seconds": 2.72,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.02,
      "end_seconds": 215.42,
      "duration_seconds": 3.4,
      "text": "So, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.3,
      "end_seconds": 219.53,
      "duration_seconds": 3.23,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.66,
      "end_seconds": 225.68,
      "duration_seconds": 4.02,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.36,
      "end_seconds": 231.31,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 234.84,
      "duration_seconds": 2.47,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.83,
      "end_seconds": 255.03,
      "duration_seconds": 5.2,
      "text": "Your neck and shoulder muscles are tight, and your eye movements are normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.23,
      "end_seconds": 257.85,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.54,
      "end_seconds": 264.37,
      "duration_seconds": 2.83,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.57,
      "end_seconds": 291.54,
      "duration_seconds": 9.97,
      "text": "Taking everything into account, this looks most like tension-type headache. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.18,
      "end_seconds": 296.01,
      "duration_seconds": 2.83,
      "text": "Okay, so will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.78,
      "end_seconds": 326.24,
      "duration_seconds": 29.46,
      "text": "I can't promise yet, but most people with tension-type headache do well once it's treated properly. Let's book an eye test to look into eye strain. Take screen breaks every hour and try regular neck stretches. Don't skip meals, and try to eat smaller portions more often through the day. I'll want another look in four weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.98,
      "end_seconds": 330.29,
      "duration_seconds": 3.31,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}