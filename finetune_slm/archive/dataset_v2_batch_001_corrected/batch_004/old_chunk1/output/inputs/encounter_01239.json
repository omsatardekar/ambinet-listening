{
  "schema_version": "1.0",
  "encounter_id": "01239",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 6.16,
      "duration_seconds": 4.87,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 7.58,
      "end_seconds": 12.63,
      "duration_seconds": 5.05,
      "text": "Well, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.48,
      "end_seconds": 16.16,
      "duration_seconds": 2.68,
      "text": "okay, have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.11,
      "end_seconds": 21.52,
      "duration_seconds": 3.41,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.04,
      "end_seconds": 25.84,
      "duration_seconds": 2.8,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 35.6,
      "duration_seconds": 8.15,
      "text": "Mainly black tarry stools. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.22,
      "end_seconds": 40.05,
      "duration_seconds": 2.83,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.29,
      "end_seconds": 46.19,
      "duration_seconds": 2.9,
      "text": "I've had it for two months"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.52,
      "end_seconds": 51.36,
      "duration_seconds": 4.84,
      "text": "Mm-hmm. Is it a a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.08,
      "end_seconds": 54.54,
      "duration_seconds": 1.46,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.4,
      "end_seconds": 59.13,
      "duration_seconds": 2.73,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.09,
      "end_seconds": 64.77,
      "duration_seconds": 4.68,
      "text": "Vomiting blood goes along with it, most of the time"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.34,
      "end_seconds": 67.38,
      "duration_seconds": 2.04,
      "text": "Have you been feeling faint?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.43,
      "end_seconds": 71.68,
      "duration_seconds": 3.25,
      "text": "Yes, about the same, one week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.12,
      "end_seconds": 74.88,
      "duration_seconds": 1.76,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.61,
      "end_seconds": 82.78,
      "duration_seconds": 7.17,
      "text": "Standing definitely sets it off. And stomach pain as well, since this morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.75,
      "end_seconds": 87.88,
      "duration_seconds": 3.13,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.6,
      "end_seconds": 94.82,
      "duration_seconds": 6.22,
      "text": "I'd say mild. The vomiting blood? That's been for about a month"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.63,
      "end_seconds": 99.47,
      "duration_seconds": 3.84,
      "text": "Have you had any fever or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.65,
      "end_seconds": 103.9,
      "duration_seconds": 3.25,
      "text": "No, no fever or chest pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.68,
      "end_seconds": 109.67,
      "duration_seconds": 4.99,
      "text": "alright, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.64,
      "end_seconds": 112.79,
      "duration_seconds": 2.15,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.98,
      "end_seconds": 118.16,
      "duration_seconds": 4.18,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.68,
      "end_seconds": 127.31,
      "duration_seconds": 7.63,
      "text": "I've got an irregular heartbeat i have migraines, for about ten years i have acid reflux"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.94,
      "end_seconds": 139.19,
      "duration_seconds": 10.25,
      "text": "I see, go ahead. Alright, acid reflux, that matches what I have here. So, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.0,
      "end_seconds": 145.58,
      "duration_seconds": 5.58,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.57,
      "end_seconds": 150.02,
      "duration_seconds": 2.45,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 151.02,
      "end_seconds": 168.16,
      "duration_seconds": 17.14,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I'm vegetarian and have been for years. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.81,
      "end_seconds": 190.49,
      "duration_seconds": 5.68,
      "text": "What's on your current medicine list? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 191.17,
      "end_seconds": 211.23,
      "duration_seconds": 20.06,
      "text": "she takes warfarin, 3 milligrams, in the evening for the blood thinning. It's propranolol, 40 milligrams, twice a day, doctor. It's lansoprazole, 30 milligrams, before breakfast, doctor. It's ibuprofen, 400 milligrams, three times a day, doctor"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.99,
      "end_seconds": 216.33,
      "duration_seconds": 4.34,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.39,
      "end_seconds": 235.64,
      "duration_seconds": 13.25,
      "text": "hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.42,
      "end_seconds": 240.97,
      "duration_seconds": 4.55,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.59,
      "end_seconds": 246.22,
      "duration_seconds": 4.63,
      "text": "My uncle has high cholesterol. My son has asthma."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.44,
      "end_seconds": 255.78,
      "duration_seconds": 2.34,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.23,
      "end_seconds": 270.32,
      "duration_seconds": 2.09,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.42,
      "end_seconds": 290.12,
      "duration_seconds": 5.7,
      "text": "okay: temperature is 36.5 degrees, pressure 117 over 76, pulse 113."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.85,
      "end_seconds": 293.32,
      "duration_seconds": 1.47,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.4,
      "end_seconds": 298.15,
      "duration_seconds": 3.75,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.61,
      "end_seconds": 305.28,
      "duration_seconds": 4.67,
      "text": "let me look at the the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.13,
      "end_seconds": 307.58,
      "duration_seconds": 1.45,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.23,
      "end_seconds": 332.47,
      "duration_seconds": 6.24,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.69,
      "end_seconds": 339.07,
      "duration_seconds": 2.38,
      "text": "So, you can relax now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.88,
      "end_seconds": 367.42,
      "duration_seconds": 9.54,
      "text": "Having listened and examined, this is probably a possible bleeding stomach ulcer. I can't rule out a bleed from the gullet yet."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 368.4,
      "end_seconds": 371.16,
      "duration_seconds": 2.76,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.4,
      "end_seconds": 398.04,
      "duration_seconds": 22.64,
      "text": "It's reasonable to be concerned, but right now a possible bleeding stomach ulcer is my leading thought, not anything worse. I'll request an endoscopy, it'll help with bleeding. I'll request urgent blood tests, it'll help with bleeding. Please stop the ibuprofen and do not eat or drink. I'm going to send a referral to the emergency team."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 399.19,
      "end_seconds": 400.79,
      "duration_seconds": 1.6,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.54,
      "end_seconds": 405.31,
      "duration_seconds": 2.77,
      "text": "does all of that that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 406.43,
      "end_seconds": 409.48,
      "duration_seconds": 3.05,
      "text": "thank you, you know, doctor, goodbye"
    }
  ]
}