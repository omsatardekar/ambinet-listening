{
  "schema_version": "1.0",
  "encounter_id": "01125",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 4.79,
      "duration_seconds": 3.62,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.71,
      "end_seconds": 9.31,
      "duration_seconds": 3.6,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.89,
      "end_seconds": 12.65,
      "duration_seconds": 2.76,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.37,
      "end_seconds": 21.74,
      "duration_seconds": 7.37,
      "text": "Mainly crushing chest pain. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.59,
      "end_seconds": 25.49,
      "duration_seconds": 2.9,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.14,
      "end_seconds": 38.25,
      "duration_seconds": 12.11,
      "text": "Around three days... no wait, uh, it's more like two days. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 52.3,
      "duration_seconds": 12.24,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.09,
      "end_seconds": 68.0,
      "duration_seconds": 14.91,
      "text": "It settles a little with rest. It just comes and goes. Exertion definitely sets it off. Mild, I'd say. I've also had pain going into my left arm, for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.21,
      "end_seconds": 79.25,
      "duration_seconds": 3.04,
      "text": "Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.76,
      "end_seconds": 88.75,
      "duration_seconds": 4.99,
      "text": "Yeah, yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.36,
      "end_seconds": 94.22,
      "duration_seconds": 1.86,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.01,
      "end_seconds": 101.22,
      "duration_seconds": 5.21,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.43,
      "end_seconds": 107.62,
      "duration_seconds": 1.19,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.63,
      "end_seconds": 111.18,
      "duration_seconds": 2.55,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.08,
      "end_seconds": 115.02,
      "duration_seconds": 2.94,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.61,
      "end_seconds": 120.4,
      "duration_seconds": 3.79,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.09,
      "end_seconds": 122.82,
      "duration_seconds": 1.73,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.7,
      "end_seconds": 127.43,
      "duration_seconds": 3.73,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.57,
      "end_seconds": 130.31,
      "duration_seconds": 1.74,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.2,
      "end_seconds": 134.63,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.27,
      "end_seconds": 143.17,
      "duration_seconds": 6.9,
      "text": "Do you have any chronic illnesses? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.11,
      "end_seconds": 152.1,
      "duration_seconds": 6.99,
      "text": "Um, yes, high cholesterol. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.52,
      "end_seconds": 158.93,
      "duration_seconds": 2.41,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.76,
      "end_seconds": 164.34,
      "duration_seconds": 4.58,
      "text": "Simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.37,
      "end_seconds": 176.32,
      "duration_seconds": 2.95,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.41,
      "end_seconds": 179.52,
      "duration_seconds": 2.11,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.9,
      "end_seconds": 186.34,
      "duration_seconds": 5.44,
      "text": "Let me check a few things. Any fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.29,
      "end_seconds": 190.24,
      "duration_seconds": 2.95,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.28,
      "end_seconds": 195.61,
      "duration_seconds": 3.33,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.51,
      "end_seconds": 197.59,
      "duration_seconds": 1.08,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.35,
      "end_seconds": 220.5,
      "duration_seconds": 4.15,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.26,
      "end_seconds": 235.9,
      "duration_seconds": 2.64,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.47,
      "end_seconds": 268.97,
      "duration_seconds": 17.5,
      "text": "Okay: blood pressure 137 over 87, weight 61 kilos, height 166 centimetres, SpO2 97 percent on room air, temp 37.1 degrees, BMI works out to 22.1, pulse is 118 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.38,
      "end_seconds": 318.22,
      "duration_seconds": 33.84,
      "text": "So, based on your history, I think we're dealing with a possible heart attack at this stage. I want to be honest that this is an impression, not a final answer. I want an ECG done, that's for chest pain. I'm going to put you on aspirin, 300 milligrams, once now, single dose. It's for possible heart attack. Stay lying down and do not eat or drink."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.26,
      "end_seconds": 330.06,
      "duration_seconds": 9.8,
      "text": "One warning sign to remember: the pain returns. In that case don't wait. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.55,
      "end_seconds": 333.88,
      "duration_seconds": 2.33,
      "text": "Alright, thanks, take care."
    }
  ]
}