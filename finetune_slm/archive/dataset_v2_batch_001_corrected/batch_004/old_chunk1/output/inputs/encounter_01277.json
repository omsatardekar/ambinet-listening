{
  "schema_version": "1.0",
  "encounter_id": "01277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 5.99,
      "duration_seconds": 4.65,
      "text": "hi doctor, you know, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 12.13,
      "duration_seconds": 4.37,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.64,
      "end_seconds": 18.31,
      "duration_seconds": 5.67,
      "text": "I wanted to get burning when I pass urine looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.72,
      "end_seconds": 22.69,
      "duration_seconds": 2.97,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.52,
      "end_seconds": 25.59,
      "duration_seconds": 2.07,
      "text": "probably three days. Yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.06,
      "end_seconds": 35.15,
      "duration_seconds": 9.09,
      "text": "yes, carry on can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.68,
      "end_seconds": 41.89,
      "duration_seconds": 6.21,
      "text": "Mm, honestly, a few times a day. Drinking water helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.49,
      "end_seconds": 47.4,
      "duration_seconds": 4.91,
      "text": "Has there been a dull ache low in your tummy too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.52,
      "end_seconds": 56.13,
      "duration_seconds": 7.61,
      "text": "Yeah, I've had that since yesterday. With dull ache low in my tummy, it's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.27,
      "end_seconds": 61.13,
      "duration_seconds": 3.86,
      "text": "Have you been going to the toilet often?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.9,
      "end_seconds": 66.19,
      "duration_seconds": 3.29,
      "text": "Yeah, I've had that since this morning."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.03,
      "end_seconds": 73.39,
      "duration_seconds": 6.36,
      "text": "have you had burning when you pass urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.38,
      "end_seconds": 83.2,
      "duration_seconds": 8.82,
      "text": "Yes, something like this happened a couple of years ago, and it it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 84.52,
      "end_seconds": 91.99,
      "duration_seconds": 7.47,
      "text": "Doctor, I've got the readings for you. Pressure 116 over 77, temperature 37.0, heart rate 72."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.32,
      "end_seconds": 94.71,
      "duration_seconds": 1.39,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.57,
      "end_seconds": 102.7,
      "duration_seconds": 5.13,
      "text": "Alright, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.2,
      "end_seconds": 105.84,
      "duration_seconds": 1.64,
      "text": "Does that that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.01,
      "end_seconds": 125.31,
      "duration_seconds": 5.3,
      "text": "your tummy is soft with slight tenderness just above the pubic bone"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.19,
      "end_seconds": 131.66,
      "duration_seconds": 2.47,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.0,
      "end_seconds": 149.45,
      "duration_seconds": 2.45,
      "text": "Any back pain or vaginal discharge?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.16,
      "end_seconds": 152.98,
      "duration_seconds": 2.82,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 158.65,
      "duration_seconds": 4.18,
      "text": "Did you get fever or blood in the urine?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.06,
      "end_seconds": 168.79,
      "duration_seconds": 4.73,
      "text": "I haven't had fever or blood in the urine, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.17,
      "end_seconds": 173.38,
      "duration_seconds": 3.21,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.28,
      "end_seconds": 175.25,
      "duration_seconds": 0.97,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.37,
      "end_seconds": 181.76,
      "duration_seconds": 5.39,
      "text": "tell me about your routine, work, habits, that that sort of thing"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.53,
      "end_seconds": 199.37,
      "duration_seconds": 15.84,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. My partner and our baby. Lots of rice, lentils and some fruit. I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.53,
      "end_seconds": 214.5,
      "duration_seconds": 6.97,
      "text": "Are you taking anything regularly, including from the pharmacy? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.06,
      "end_seconds": 226.32,
      "duration_seconds": 10.26,
      "text": "It's lamotrigine, 100 milligrams, twice a day. It's metoprolol, 50 milligrams, maybe, twice a day for the heart rhythm."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.65,
      "end_seconds": 231.7,
      "duration_seconds": 4.05,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.13,
      "end_seconds": 240.76,
      "duration_seconds": 7.63,
      "text": "No, it's at home. I take ramipril, 5 milligrams, every morning for my blood pressure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 242.04,
      "end_seconds": 247.57,
      "duration_seconds": 5.53,
      "text": "Doctor, our chart from the last visit lists it as 2.5 milligrams."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.3,
      "end_seconds": 251.48,
      "duration_seconds": 3.18,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.09,
      "end_seconds": 258.46,
      "duration_seconds": 6.37,
      "text": "No, I left it at home. I'm on cranberry juice, daily."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.04,
      "end_seconds": 263.09,
      "duration_seconds": 3.05,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.3,
      "end_seconds": 271.19,
      "duration_seconds": 6.89,
      "text": "I've had epilepsy for five years now. I've, I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.26,
      "end_seconds": 276.36,
      "duration_seconds": 1.1,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.67,
      "end_seconds": 279.63,
      "duration_seconds": 1.96,
      "text": "yes, high blood pressure"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.29,
      "end_seconds": 293.1,
      "duration_seconds": 11.81,
      "text": "Yes, an irregular heartbeat and high blood pressure are known to us, good to have that that clear. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.04,
      "end_seconds": 296.24,
      "duration_seconds": 1.2,
      "text": "yes, kiwi"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.02,
      "end_seconds": 299.83,
      "duration_seconds": 2.81,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.37,
      "end_seconds": 305.72,
      "duration_seconds": 5.35,
      "text": "my daughter has type 1 diabetes my uncle has high cholesterol"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.52,
      "end_seconds": 322.89,
      "duration_seconds": 2.37,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.98,
      "end_seconds": 328.81,
      "duration_seconds": 3.83,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.97,
      "end_seconds": 355.16,
      "duration_seconds": 25.19,
      "text": "Taking everything into account, this is probably an uncomplicated urinary infection. I want to be honest that this is an impression, not a final answer. Vaginal irritation is also on my list. For this, nitrofurantoin, 100 milligrams, twice a day, three days. You take it by mouth. It's for urinary infection."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.93,
      "end_seconds": 359.95,
      "duration_seconds": 3.02,
      "text": "should I take that with food?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.64,
      "end_seconds": 374.81,
      "duration_seconds": 13.17,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.72,
      "end_seconds": 377.37,
      "duration_seconds": 1.65,
      "text": "That's clear, thanks."
    }
  ]
}