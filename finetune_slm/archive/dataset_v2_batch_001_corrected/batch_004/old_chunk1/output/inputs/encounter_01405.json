{
  "schema_version": "1.0",
  "encounter_id": "01405",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 3.5,
      "duration_seconds": 2.44,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.06,
      "end_seconds": 5.22,
      "duration_seconds": 1.16,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.77,
      "end_seconds": 7.79,
      "duration_seconds": 2.02,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.17,
      "end_seconds": 11.81,
      "duration_seconds": 2.64,
      "text": "Only about ten minutes, honestly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.48,
      "end_seconds": 14.64,
      "duration_seconds": 2.16,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.16,
      "end_seconds": 21.64,
      "duration_seconds": 6.48,
      "text": "Uh, I've been feeling well, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.06,
      "end_seconds": 26.11,
      "duration_seconds": 3.05,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.13,
      "end_seconds": 29.96,
      "duration_seconds": 1.83,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.73,
      "end_seconds": 33.65,
      "duration_seconds": 2.92,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.42,
      "end_seconds": 44.29,
      "duration_seconds": 9.87,
      "text": "Erm, it usually comes with slightly dry skin. The, The slightly dry skin? That's been for five days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.9,
      "end_seconds": 50.15,
      "duration_seconds": 4.25,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.04,
      "end_seconds": 53.92,
      "duration_seconds": 2.88,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.92,
      "end_seconds": 57.84,
      "duration_seconds": 2.92,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.62,
      "end_seconds": 64.59,
      "duration_seconds": 4.97,
      "text": "I have an underactive thyroid. Yes, thin bones."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 67.05,
      "duration_seconds": 1.49,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.29,
      "end_seconds": 85.02,
      "duration_seconds": 16.73,
      "text": "I've had arthritis in my knees for five years now. I kept putting it off, which I know isn't sensible. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.99,
      "end_seconds": 95.45,
      "duration_seconds": 8.46,
      "text": "Okay, go on. Okay, I can see thin bones in your file as well. Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.47,
      "end_seconds": 101.89,
      "duration_seconds": 5.42,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.92,
      "end_seconds": 104.82,
      "duration_seconds": 1.9,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.79,
      "end_seconds": 110.23,
      "duration_seconds": 4.44,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.75,
      "end_seconds": 113.65,
      "duration_seconds": 1.9,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.55,
      "end_seconds": 118.47,
      "duration_seconds": 2.92,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.19,
      "end_seconds": 122.1,
      "duration_seconds": 2.91,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.62,
      "end_seconds": 128.83,
      "duration_seconds": 5.21,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.02,
      "end_seconds": 149.33,
      "duration_seconds": 4.31,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 154.32,
      "duration_seconds": 4.19,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.66,
      "end_seconds": 176.95,
      "duration_seconds": 5.29,
      "text": "Let's run through your medicines. Just so I get the full picture."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.62,
      "end_seconds": 185.01,
      "duration_seconds": 6.39,
      "text": "I take thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.59,
      "end_seconds": 187.92,
      "duration_seconds": 2.33,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.02,
      "end_seconds": 197.27,
      "duration_seconds": 5.25,
      "text": "Two years now. Alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.09,
      "end_seconds": 201.28,
      "duration_seconds": 2.19,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.33,
      "end_seconds": 208.78,
      "duration_seconds": 5.45,
      "text": "70 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.01,
      "end_seconds": 209.82,
      "duration_seconds": 0.81,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.9,
      "end_seconds": 214.77,
      "duration_seconds": 2.87,
      "text": "It's naproxen, twice a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.86,
      "end_seconds": 219.86,
      "duration_seconds": 3.0,
      "text": "Alright, how much do you take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.09,
      "end_seconds": 226.53,
      "duration_seconds": 5.44,
      "text": "250 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.52,
      "end_seconds": 232.28,
      "duration_seconds": 3.76,
      "text": "Right, a few quick ones: palpitations or feeling cold?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.44,
      "end_seconds": 238.37,
      "duration_seconds": 2.93,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.39,
      "end_seconds": 243.45,
      "duration_seconds": 3.06,
      "text": "Any weight change or constipation at all?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.22,
      "end_seconds": 248.37,
      "duration_seconds": 3.15,
      "text": "No, no weight change or constipation."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.01,
      "end_seconds": 252.29,
      "duration_seconds": 3.28,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.13,
      "end_seconds": 255.88,
      "duration_seconds": 1.75,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.93,
      "end_seconds": 261.44,
      "duration_seconds": 3.51,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.74,
      "end_seconds": 272.93,
      "duration_seconds": 3.19,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.9,
      "end_seconds": 298.76,
      "duration_seconds": 7.86,
      "text": "Okay: pulse 76, oxygen saturation is 97 percent. And temperature is 37.0 degrees, BP is 117 over 76."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.74,
      "end_seconds": 301.28,
      "duration_seconds": 1.54,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.84,
      "end_seconds": 304.64,
      "duration_seconds": 2.8,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.53,
      "end_seconds": 310.34,
      "duration_seconds": 3.81,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.46,
      "end_seconds": 314.93,
      "duration_seconds": 3.47,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.42,
      "end_seconds": 336.45,
      "duration_seconds": 5.03,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.17,
      "end_seconds": 343.32,
      "duration_seconds": 2.15,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.67,
      "end_seconds": 362.52,
      "duration_seconds": 7.85,
      "text": "Let me tell you where I've got to. I think we're dealing with well-controlled thyroid replacement at this stage."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.49,
      "end_seconds": 369.09,
      "duration_seconds": 4.6,
      "text": "Hmm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 369.71,
      "end_seconds": 380.2,
      "duration_seconds": 10.49,
      "text": "Nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement. Keep taking the tablet on an empty stomach, apart from coffee."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.92,
      "end_seconds": 390.14,
      "duration_seconds": 6.22,
      "text": "Do I need a thyroid blood test? I read it might help."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.97,
      "end_seconds": 400.15,
      "duration_seconds": 9.18,
      "text": "Not right now, it wouldn't change what we do today. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 401.73,
      "end_seconds": 405.39,
      "duration_seconds": 3.66,
      "text": "I mean, thank you, that's helpful."
    }
  ]
}