{
  "schema_version": "1.0",
  "encounter_id": "01298",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 4.89,
      "duration_seconds": 3.63,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.0,
      "end_seconds": 10.02,
      "duration_seconds": 4.02,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.19,
      "end_seconds": 31.52,
      "duration_seconds": 20.33,
      "text": "I mean, mainly a severe sore throat. There's a couple of other things, but that's the main one. Sorry, I know I'm rambling a bit. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.83,
      "end_seconds": 42.49,
      "duration_seconds": 9.66,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.24,
      "end_seconds": 57.07,
      "duration_seconds": 12.83,
      "text": "Moderate, I'd say. It's worse with swallowing. Oh, uh, and noisy breathing. With noisy breathing, maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.58,
      "end_seconds": 58.43,
      "duration_seconds": 0.85,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.92,
      "end_seconds": 73.4,
      "duration_seconds": 11.48,
      "text": "Yeah, as for muffled voice, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.62,
      "end_seconds": 81.0,
      "duration_seconds": 6.38,
      "text": "Have you had a severe sore throat before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.59,
      "end_seconds": 87.87,
      "duration_seconds": 6.28,
      "text": "Actually, you know, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.26,
      "end_seconds": 91.98,
      "duration_seconds": 2.72,
      "text": "Any cough or rash at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.25,
      "end_seconds": 96.52,
      "duration_seconds": 3.27,
      "text": "No cough or rash, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 105.05,
      "duration_seconds": 2.46,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.02,
      "end_seconds": 109.2,
      "duration_seconds": 2.18,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.57,
      "end_seconds": 125.98,
      "duration_seconds": 2.41,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.61,
      "end_seconds": 133.59,
      "duration_seconds": 5.98,
      "text": "Let me think, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.49,
      "end_seconds": 139.9,
      "duration_seconds": 4.41,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.62,
      "end_seconds": 146.77,
      "duration_seconds": 5.15,
      "text": "Hmm, yes, grass pollen, it gives me itchy eyes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.43,
      "end_seconds": 149.21,
      "duration_seconds": 1.78,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.0,
      "end_seconds": 155.29,
      "duration_seconds": 5.29,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 158.28,
      "duration_seconds": 0.98,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.26,
      "end_seconds": 162.71,
      "duration_seconds": 3.45,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.74,
      "end_seconds": 166.2,
      "duration_seconds": 1.46,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.86,
      "end_seconds": 170.63,
      "duration_seconds": 3.77,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.08,
      "end_seconds": 173.69,
      "duration_seconds": 1.61,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.75,
      "end_seconds": 181.55,
      "duration_seconds": 2.8,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.57,
      "end_seconds": 186.3,
      "duration_seconds": 2.73,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.08,
      "end_seconds": 192.11,
      "duration_seconds": 4.03,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.12,
      "end_seconds": 197.46,
      "duration_seconds": 3.34,
      "text": "Okay, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.06,
      "end_seconds": 215.41,
      "duration_seconds": 16.35,
      "text": "I have thin bones, for about ten years. I've been reading about it online and it worried me. I've had arthritis in my knees for nearly five years now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.13,
      "end_seconds": 224.4,
      "duration_seconds": 7.27,
      "text": "Alright, thin bones, that matches what I have here. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.5,
      "end_seconds": 239.81,
      "duration_seconds": 13.31,
      "text": "It's alendronate, 70 milligrams, once a week for my bones. I take paracetamol, 650 milligrams, when needed. Before this I was on diclofenac; that's been stopped."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.46,
      "end_seconds": 243.06,
      "duration_seconds": 2.6,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.43,
      "end_seconds": 253.85,
      "duration_seconds": 2.42,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.97,
      "end_seconds": 277.62,
      "duration_seconds": 8.65,
      "text": "Okay: blood pressure 136 over 90, SpO2 90 percent on room air, temperature is 37.5 degrees, heart rate 96."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.33,
      "end_seconds": 284.01,
      "duration_seconds": 3.68,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.06,
      "end_seconds": 286.08,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.98,
      "end_seconds": 289.0,
      "duration_seconds": 2.02,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.76,
      "end_seconds": 309.5,
      "duration_seconds": 4.74,
      "text": "You are sitting forward, drooling, and your breathing is noisy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.78,
      "end_seconds": 311.89,
      "duration_seconds": 1.11,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.45,
      "end_seconds": 319.87,
      "duration_seconds": 2.42,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.15,
      "end_seconds": 342.46,
      "duration_seconds": 11.31,
      "text": "So where does that leave us? This looks most like a possible airway infection that needs emergency care. I'd also keep severe tonsillitis in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.14,
      "end_seconds": 380.13,
      "duration_seconds": 29.99,
      "text": "We should do an urgent airway assessment for stridor and drooling. Do not lie flat, I am calling an ambulance now. If you smoke, this is a good moment to think about stopping, and we can help you with that. If the breathing gets harder, or you feel really unwell, please come to the emergency department. I'd like to see you again straight away. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.02,
      "end_seconds": 382.53,
      "duration_seconds": 1.51,
      "text": "That's clear, thanks."
    }
  ]
}