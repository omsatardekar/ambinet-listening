{
  "schema_version": "1.0",
  "encounter_id": "01257",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 4.2,
      "duration_seconds": 3.01,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.52,
      "end_seconds": 13.02,
      "duration_seconds": 4.5,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.18,
      "end_seconds": 18.56,
      "duration_seconds": 4.38,
      "text": "So, you know, I've been feeling well, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.43,
      "end_seconds": 23.48,
      "duration_seconds": 3.05,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.56,
      "end_seconds": 32.77,
      "duration_seconds": 8.21,
      "text": "It's been going on for two weeks. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.06,
      "end_seconds": 37.3,
      "duration_seconds": 3.24,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.41,
      "end_seconds": 39.64,
      "duration_seconds": 1.23,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.33,
      "end_seconds": 57.79,
      "duration_seconds": 4.46,
      "text": "And what about constipation, weight change or feeling cold?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.87,
      "end_seconds": 64.48,
      "duration_seconds": 4.61,
      "text": "No, no constipation, weight change or feeling cold."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.3,
      "end_seconds": 67.66,
      "duration_seconds": 2.36,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.19,
      "end_seconds": 69.18,
      "duration_seconds": 0.99,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.79,
      "end_seconds": 84.2,
      "duration_seconds": 3.41,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.97,
      "end_seconds": 90.85,
      "duration_seconds": 5.88,
      "text": "So, I've had an underactive thyroid for about ten years now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.01,
      "end_seconds": 96.31,
      "duration_seconds": 1.3,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.84,
      "end_seconds": 107.21,
      "duration_seconds": 10.37,
      "text": "I've had heart disease for about ten years now. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 113.31,
      "duration_seconds": 5.39,
      "text": "Alright, heart disease, that matches what I have here. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.36,
      "end_seconds": 116.85,
      "duration_seconds": 1.49,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.56,
      "end_seconds": 140.8,
      "duration_seconds": 5.24,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.4,
      "end_seconds": 144.94,
      "duration_seconds": 3.54,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.51,
      "end_seconds": 149.27,
      "duration_seconds": 2.76,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.34,
      "end_seconds": 155.17,
      "duration_seconds": 3.83,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.87,
      "end_seconds": 158.2,
      "duration_seconds": 2.33,
      "text": "Right, how are your meals?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.11,
      "end_seconds": 163.82,
      "duration_seconds": 3.71,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.61,
      "end_seconds": 184.8,
      "duration_seconds": 4.19,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.53,
      "end_seconds": 193.94,
      "duration_seconds": 8.41,
      "text": "Thyronorm. I take it 50 micrograms, every morning for my thyroid. Metoprolol, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.56,
      "end_seconds": 197.66,
      "duration_seconds": 2.1,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.1,
      "end_seconds": 200.05,
      "duration_seconds": 0.95,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.87,
      "end_seconds": 205.86,
      "duration_seconds": 3.99,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.62,
      "end_seconds": 208.59,
      "duration_seconds": 1.97,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.6,
      "end_seconds": 213.69,
      "duration_seconds": 4.09,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.29,
      "end_seconds": 226.67,
      "duration_seconds": 2.38,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.84,
      "end_seconds": 258.14,
      "duration_seconds": 11.3,
      "text": "Okay: BP is 127 over 74, temperature is 36.6 degrees, heart rate 75, weight 76 kilos, BMI works out to 26.3, height 170 centimetres."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.25,
      "end_seconds": 262.72,
      "duration_seconds": 3.47,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.97,
      "end_seconds": 266.49,
      "duration_seconds": 2.52,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.67,
      "end_seconds": 287.1,
      "duration_seconds": 4.43,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.75,
      "end_seconds": 303.2,
      "duration_seconds": 13.45,
      "text": "That's all I needed to check. So where does that leave us? I'd lean towards well-controlled thyroid replacement. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.2,
      "end_seconds": 306.56,
      "duration_seconds": 1.36,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.58,
      "end_seconds": 331.54,
      "duration_seconds": 22.96,
      "text": "It's reasonable to be concerned, but right now well-controlled thyroid replacement is my leading thought, not anything worse. Let's get a thyroid blood test, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.13,
      "end_seconds": 333.6,
      "duration_seconds": 1.47,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.42,
      "end_seconds": 335.66,
      "duration_seconds": 1.24,
      "text": "Look after yourself."
    }
  ]
}