{
  "schema_version": "1.0",
  "encounter_id": "01150",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 5.25,
      "duration_seconds": 4.14,
      "text": "Oh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.85,
      "end_seconds": 11.42,
      "duration_seconds": 4.57,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.15,
      "end_seconds": 29.35,
      "duration_seconds": 16.2,
      "text": "So the thing is, um, I've got a dry cough in the evenings. I didn't want to bother you but it keeps coming back. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.43,
      "end_seconds": 33.37,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.92,
      "end_seconds": 38.02,
      "duration_seconds": 4.1,
      "text": "Oh, it's been three days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.95,
      "end_seconds": 41.81,
      "duration_seconds": 2.86,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.6,
      "end_seconds": 46.09,
      "duration_seconds": 2.49,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.59,
      "end_seconds": 47.55,
      "duration_seconds": 0.96,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.94,
      "end_seconds": 53.96,
      "duration_seconds": 5.02,
      "text": "And there's sneezing fits as well, one week now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.51,
      "end_seconds": 58.28,
      "duration_seconds": 3.77,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.86,
      "end_seconds": 60.92,
      "duration_seconds": 1.06,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.9,
      "end_seconds": 64.27,
      "duration_seconds": 2.37,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.75,
      "end_seconds": 67.95,
      "duration_seconds": 2.2,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.68,
      "end_seconds": 72.06,
      "duration_seconds": 3.38,
      "text": "Right, has there been itchy eyes too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.62,
      "end_seconds": 81.27,
      "duration_seconds": 7.65,
      "text": "Yes, for about two weeks. As for itchy eyes, it happens every other day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.26,
      "end_seconds": 85.71,
      "duration_seconds": 3.45,
      "text": "So, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.26,
      "end_seconds": 96.78,
      "duration_seconds": 2.52,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.65,
      "end_seconds": 116.18,
      "duration_seconds": 7.53,
      "text": "Okay: temperature 36.9, pulse 67. And respiratory rate 17, blood pressure 113 over 74, saturation 97 percent."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.19,
      "end_seconds": 119.33,
      "duration_seconds": 2.14,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.15,
      "end_seconds": 122.32,
      "duration_seconds": 1.17,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.13,
      "end_seconds": 125.2,
      "duration_seconds": 2.07,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.2,
      "end_seconds": 143.92,
      "duration_seconds": 5.72,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.76,
      "end_seconds": 151.51,
      "duration_seconds": 1.75,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.12,
      "end_seconds": 166.83,
      "duration_seconds": 3.71,
      "text": "Any shortness of breath, wheeze or fever at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.78,
      "end_seconds": 173.7,
      "duration_seconds": 4.92,
      "text": "I haven't had shortness of breath, wheeze or fever, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.62,
      "end_seconds": 177.83,
      "duration_seconds": 2.21,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.93,
      "end_seconds": 181.05,
      "duration_seconds": 2.12,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.7,
      "end_seconds": 184.79,
      "duration_seconds": 2.09,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.82,
      "end_seconds": 190.29,
      "duration_seconds": 3.47,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.56,
      "end_seconds": 196.1,
      "duration_seconds": 4.54,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.02,
      "end_seconds": 200.07,
      "duration_seconds": 3.05,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.47,
      "end_seconds": 210.77,
      "duration_seconds": 3.3,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.53,
      "end_seconds": 215.32,
      "duration_seconds": 2.79,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.71,
      "end_seconds": 224.12,
      "duration_seconds": 7.41,
      "text": "Tell me about any past illnesses or ongoing conditions. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.97,
      "end_seconds": 228.52,
      "duration_seconds": 2.55,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.17,
      "end_seconds": 236.43,
      "duration_seconds": 6.26,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.69,
      "end_seconds": 256.29,
      "duration_seconds": 1.6,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.19,
      "end_seconds": 260.94,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.24,
      "end_seconds": 265.04,
      "duration_seconds": 2.8,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.59,
      "end_seconds": 269.12,
      "duration_seconds": 3.53,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.76,
      "end_seconds": 277.36,
      "duration_seconds": 2.6,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.52,
      "end_seconds": 282.64,
      "duration_seconds": 4.12,
      "text": "Thyronorm. I take it 50 micrograms, every morning."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.23,
      "end_seconds": 317.63,
      "duration_seconds": 33.4,
      "text": "Okay, so my impression is this: It fits best with seasonal hay fever causing the cough. I'm going to put you on fluticasone nasal spray, 50 micrograms, once a day, for the season. It's for hay fever. Keep windows closed on high-pollen days and wash your hair at night. If you start wheezing, or you feel really unwell, please come to the emergency department. Please come and see me in a month."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 318.55,
      "end_seconds": 322.37,
      "duration_seconds": 3.82,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.22,
      "end_seconds": 323.92,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.8,
      "end_seconds": 328.7,
      "duration_seconds": 2.9,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.83,
      "end_seconds": 333.53,
      "duration_seconds": 3.7,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}