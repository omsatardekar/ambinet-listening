{
  "schema_version": "1.0",
  "encounter_id": "01362",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.18,
      "end_seconds": 7.7,
      "duration_seconds": 6.52,
      "text": "doctor, your next patient is here. I've done the basics, I'll read them out in a moment"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.95,
      "end_seconds": 13.61,
      "duration_seconds": 4.66,
      "text": "thank you good morning, tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.41,
      "end_seconds": 21.76,
      "duration_seconds": 6.35,
      "text": "hello, you know, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.77,
      "end_seconds": 26.37,
      "duration_seconds": 2.6,
      "text": "absolutely come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.02,
      "end_seconds": 35.81,
      "duration_seconds": 7.79,
      "text": "It's been passing a lot of urine doctor. She didn't wanna come but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 37.12,
      "end_seconds": 46.68,
      "duration_seconds": 9.56,
      "text": "doctor, I've got the readings for you height 178 centimetres, weight 55 kilos, temperature is 36.8 degrees, blood pressure 133 over 74, pulse 109."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.86,
      "end_seconds": 51.44,
      "duration_seconds": 3.58,
      "text": "thanks. How long has it been like this?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.55,
      "end_seconds": 60.37,
      "duration_seconds": 7.82,
      "text": "It's been five days now. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.13,
      "end_seconds": 64.38,
      "duration_seconds": 3.25,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.22,
      "end_seconds": 69.11,
      "duration_seconds": 2.89,
      "text": "pretty moderate, if I'm being honest"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.79,
      "end_seconds": 76.18,
      "duration_seconds": 6.39,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 76.28,
      "end_seconds": 82.95,
      "duration_seconds": 6.67,
      "text": "Sorry to cut in doctor quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.48,
      "end_seconds": 89.47,
      "duration_seconds": 4.99,
      "text": "later, thanks please go on any being very thirsty as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.19,
      "end_seconds": 94.74,
      "duration_seconds": 3.55,
      "text": "Hmm, yeah. Two weeks, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.62,
      "end_seconds": 99.0,
      "duration_seconds": 3.38,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.47,
      "end_seconds": 113.88,
      "duration_seconds": 9.41,
      "text": "about a three out of ten i did have deep fast breathing at one point, but that's gone now"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.46,
      "end_seconds": 118.35,
      "duration_seconds": 2.89,
      "text": "and what about chest pain or cough?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.61,
      "end_seconds": 123.85,
      "duration_seconds": 4.24,
      "text": "no chest pain or cough none of it"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.7,
      "end_seconds": 131.8,
      "duration_seconds": 3.1,
      "text": "okay and your skin any changes there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.69,
      "end_seconds": 136.28,
      "duration_seconds": 2.59,
      "text": "Erm, no, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.14,
      "end_seconds": 141.76,
      "duration_seconds": 3.62,
      "text": "on the cardiac side anything I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 143.71,
      "end_seconds": 146.22,
      "duration_seconds": 2.51,
      "text": "no nothing with my heart"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.78,
      "end_seconds": 153.59,
      "duration_seconds": 2.81,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.29,
      "end_seconds": 160.18,
      "duration_seconds": 5.89,
      "text": "my sister had breast cancer um, my father has Parkinson's disease"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.56,
      "end_seconds": 164.77,
      "duration_seconds": 3.21,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.42,
      "end_seconds": 174.43,
      "duration_seconds": 9.01,
      "text": "I have diabetes, for two years a neighbour of mine said I should see someone about it"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.77,
      "end_seconds": 177.28,
      "duration_seconds": 1.51,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 182.24,
      "end_seconds": 186.25,
      "duration_seconds": 4.01,
      "text": "I have COPD. I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.01,
      "end_seconds": 191.26,
      "duration_seconds": 4.25,
      "text": "any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.11,
      "end_seconds": 202.81,
      "duration_seconds": 9.7,
      "text": "sorry what was I saying not currently but as a youngster diclofenac gave me swelling of my lips"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.35,
      "end_seconds": 215.1,
      "duration_seconds": 3.75,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.31,
      "end_seconds": 222.1,
      "duration_seconds": 5.79,
      "text": "I take Glycomet 500 milligrams maybe twice a day for my sugar"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.29,
      "end_seconds": 228.89,
      "duration_seconds": 4.6,
      "text": "did you happen to bring the box or the the paperwork?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.03,
      "end_seconds": 237.53,
      "duration_seconds": 7.5,
      "text": "No, it's at home. Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 238.29,
      "end_seconds": 247.59,
      "duration_seconds": 9.3,
      "text": "doctor, I think the last prescription for the alendronate was 140 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.54,
      "end_seconds": 252.45,
      "duration_seconds": 3.91,
      "text": "hm do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.41,
      "end_seconds": 256.57,
      "duration_seconds": 3.16,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.13,
      "end_seconds": 277.64,
      "duration_seconds": 2.51,
      "text": "have you ever had an operation?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 279.54,
      "end_seconds": 296.11,
      "duration_seconds": 16.57,
      "text": "just my womb taken out, fifteen years ago. I'd rather not end up on lots of tablets if I can avoid it. I'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.41,
      "end_seconds": 298.76,
      "duration_seconds": 1.35,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.05,
      "end_seconds": 308.44,
      "duration_seconds": 4.39,
      "text": "I smoke roughly a pack every two days"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.71,
      "end_seconds": 312.14,
      "duration_seconds": 2.43,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 312.9,
      "end_seconds": 318.4,
      "duration_seconds": 5.5,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.19,
      "end_seconds": 323.17,
      "duration_seconds": 2.98,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 324.78,
      "end_seconds": 328.99,
      "duration_seconds": 4.21,
      "text": "Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.44,
      "end_seconds": 335.48,
      "duration_seconds": 4.04,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.27,
      "end_seconds": 339.96,
      "duration_seconds": 2.69,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.88,
      "end_seconds": 353.29,
      "duration_seconds": 4.41,
      "text": "You are dry breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.15,
      "end_seconds": 382.74,
      "duration_seconds": 24.59,
      "text": "that's all I needed to check. Let me tell you where I've got to. It fits best with diabetic ketoacidosis. We shouldn't forget a severe infection. Stop me if I've got anything wrong. You've been passing a lot of urine for five days, moderate, and no chest pain or cough"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 384.36,
      "end_seconds": 385.87,
      "duration_seconds": 1.51,
      "text": "Mm that's right."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.04,
      "end_seconds": 391.49,
      "duration_seconds": 4.45,
      "text": "I think blood gas and electrolytes makes sense here for DKA."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 392.87,
      "end_seconds": 398.08,
      "duration_seconds": 5.21,
      "text": "I've already done a blood sugar and ketone test, it's ready for you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.18,
      "end_seconds": 419.94,
      "duration_seconds": 19.76,
      "text": "okay I'll take a look at that. You need to go to hospital now for insulin and fluids. Let's get you seen by the emergency team I'll arrange the letter. And please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 421.02,
      "end_seconds": 422.68,
      "duration_seconds": 1.66,
      "text": "alright, I follow"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.51,
      "end_seconds": 441.89,
      "duration_seconds": 16.38,
      "text": "Keep an eye out, and if you cannot get there now, call us the same day or go to emergency. Let's plan a check straight away. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 442.55,
      "end_seconds": 447.55,
      "duration_seconds": 5.0,
      "text": "So I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 452.82,
      "end_seconds": 459.83,
      "duration_seconds": 7.01,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 460.71,
      "end_seconds": 462.08,
      "duration_seconds": 1.37,
      "text": "that's clear thanks"
    }
  ]
}