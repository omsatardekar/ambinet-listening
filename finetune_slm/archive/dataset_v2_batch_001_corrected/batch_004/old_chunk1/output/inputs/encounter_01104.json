{
  "schema_version": "1.0",
  "encounter_id": "01104",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.0,
      "end_seconds": 5.63,
      "duration_seconds": 4.63,
      "text": "doctor, we're ready in room two, I've already taken the observations"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.16,
      "end_seconds": 11.65,
      "duration_seconds": 5.49,
      "text": "great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.34,
      "end_seconds": 17.32,
      "duration_seconds": 4.98,
      "text": "doctor, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.19,
      "end_seconds": 26.04,
      "duration_seconds": 3.85,
      "text": "Good, that'll be useful. Pull up a a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 27.17,
      "end_seconds": 33.28,
      "duration_seconds": 6.11,
      "text": "Doctor, uh, it's a blocked ear. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.56,
      "end_seconds": 42.96,
      "duration_seconds": 3.4,
      "text": "So, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.04,
      "end_seconds": 47.23,
      "duration_seconds": 3.19,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.34,
      "end_seconds": 53.82,
      "duration_seconds": 5.48,
      "text": "right, hm, I'd say more like about two months"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.9,
      "end_seconds": 61.29,
      "duration_seconds": 4.39,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.07,
      "end_seconds": 66.31,
      "duration_seconds": 3.24,
      "text": "I, I suppose so, yes"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.54,
      "end_seconds": 69.69,
      "duration_seconds": 2.15,
      "text": "what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.94,
      "end_seconds": 74.79,
      "duration_seconds": 3.85,
      "text": "Um, showering definitely sets it off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 78.95,
      "duration_seconds": 2.82,
      "text": "have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.63,
      "end_seconds": 87.59,
      "duration_seconds": 6.96,
      "text": "Muffled hearing on one side goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 88.56,
      "end_seconds": 95.68,
      "duration_seconds": 7.12,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 95.78,
      "end_seconds": 102.96,
      "duration_seconds": 7.18,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.26,
      "end_seconds": 107.09,
      "duration_seconds": 2.83,
      "text": "Right, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 108.65,
      "end_seconds": 115.63,
      "duration_seconds": 6.98,
      "text": "The muffled hearing on one side? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.32,
      "end_seconds": 119.08,
      "duration_seconds": 2.76,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 120.4,
      "end_seconds": 127.21,
      "duration_seconds": 6.81,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.88,
      "end_seconds": 134.42,
      "duration_seconds": 5.54,
      "text": "take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.1,
      "end_seconds": 140.73,
      "duration_seconds": 4.63,
      "text": "Let me think, it feels mild to me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.14,
      "end_seconds": 147.76,
      "duration_seconds": 5.62,
      "text": "Have you had a blocked ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 149.37,
      "end_seconds": 160.29,
      "duration_seconds": 10.92,
      "text": "Right, you know, yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 161.99,
      "end_seconds": 164.33,
      "duration_seconds": 2.34,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.44,
      "end_seconds": 168.79,
      "duration_seconds": 3.35,
      "text": "Did you get ear pain or ringing?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 170.37,
      "end_seconds": 183.93,
      "duration_seconds": 13.56,
      "text": "No, no ear pain, no ringing. I did have a feeling of fullness at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.52,
      "end_seconds": 185.97,
      "duration_seconds": 1.45,
      "text": "What about discharge?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.32,
      "end_seconds": 189.95,
      "duration_seconds": 2.63,
      "text": "Not at all, no discharge."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.6,
      "end_seconds": 192.55,
      "duration_seconds": 0.95,
      "text": "Any dizziness?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.7,
      "end_seconds": 197.78,
      "duration_seconds": 4.08,
      "text": "Uh, no, I haven't had any dizziness."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.97,
      "end_seconds": 204.02,
      "duration_seconds": 5.05,
      "text": "actually, doctor, I did notice dizziness he doesn't always say"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.94,
      "end_seconds": 212.88,
      "duration_seconds": 6.94,
      "text": "So, no, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.6,
      "end_seconds": 221.11,
      "duration_seconds": 6.51,
      "text": "alright, I'll note both what you've said and what you've noticed is your chest okay generally?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.59,
      "end_seconds": 224.79,
      "duration_seconds": 2.2,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.19,
      "end_seconds": 228.93,
      "duration_seconds": 2.74,
      "text": "any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.67,
      "end_seconds": 233.51,
      "duration_seconds": 2.84,
      "text": "I, I move fine otherwise."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.67,
      "end_seconds": 239.05,
      "duration_seconds": 4.38,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.05,
      "end_seconds": 253.12,
      "duration_seconds": 12.07,
      "text": "Hmm, it's alendronate, 70 milligrams, once a week. I'm on allopurinol, 100 milligrams, once a day. It's Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 254.57,
      "end_seconds": 262.12,
      "duration_seconds": 7.55,
      "text": "He is supposed to take it twice a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.96,
      "end_seconds": 267.39,
      "duration_seconds": 3.43,
      "text": "So, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.0,
      "end_seconds": 273.69,
      "duration_seconds": 4.69,
      "text": "Okay, so my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.33,
      "end_seconds": 276.61,
      "duration_seconds": 2.28,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 277.19,
      "end_seconds": 291.01,
      "duration_seconds": 13.82,
      "text": "Yes, thin bones. I've had gout for about ten years now. It's the not knowing that gets to me. I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.09,
      "end_seconds": 294.69,
      "duration_seconds": 1.6,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.78,
      "end_seconds": 312.16,
      "duration_seconds": 12.38,
      "text": "Right, so so gout is already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 313.75,
      "end_seconds": 316.75,
      "duration_seconds": 3.0,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.27,
      "end_seconds": 321.19,
      "duration_seconds": 2.92,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 322.28,
      "end_seconds": 329.37,
      "duration_seconds": 7.09,
      "text": "yes, I had a cataract operation in my left eye, about a year ago"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.92,
      "end_seconds": 340.47,
      "duration_seconds": 2.55,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.03,
      "end_seconds": 344.63,
      "duration_seconds": 3.6,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.46,
      "end_seconds": 348.47,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.23,
      "end_seconds": 353.71,
      "duration_seconds": 4.48,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 355.48,
      "end_seconds": 363.49,
      "duration_seconds": 8.01,
      "text": "Here are the numbers, doctor. Heart rate 83, saturation 97 percent, BP is 116 over 78. Temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.89,
      "end_seconds": 366.27,
      "duration_seconds": 1.38,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.14,
      "end_seconds": 372.99,
      "duration_seconds": 3.85,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 373.51,
      "end_seconds": 374.6,
      "duration_seconds": 1.09,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.45,
      "end_seconds": 377.47,
      "duration_seconds": 2.02,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.39,
      "end_seconds": 390.53,
      "duration_seconds": 4.14,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.15,
      "end_seconds": 408.97,
      "duration_seconds": 12.82,
      "text": "that's the examination finished having listened and examined, I think we're dealing with earwax blocking the ear at this stage i'd also keep a middle ear fluid in mind"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 409.47,
      "end_seconds": 412.49,
      "duration_seconds": 3.02,
      "text": "Erm, will it clear up?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.06,
      "end_seconds": 435.08,
      "duration_seconds": 17.02,
      "text": "It's reasonable to be concerned, but right now earwax blocking the ear is my leading thought, not anything worse. Let me just check I've got this right. You've had a blocked ear, and no discharge."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.1,
      "end_seconds": 436.8,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.51,
      "end_seconds": 462.88,
      "duration_seconds": 13.37,
      "text": "Ear irrigation is what I'd like next, for wax. Use the olive oil drops for a week and then we'll syringe the ear. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 464.35,
      "end_seconds": 466.57,
      "duration_seconds": 2.22,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}