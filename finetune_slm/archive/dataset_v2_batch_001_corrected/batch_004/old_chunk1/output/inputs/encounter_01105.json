    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.22,
      "end_seconds": 259.11,
      "duration_seconds": 2.89,
      "text": "what are the odds it's serious?"
