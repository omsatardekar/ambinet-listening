      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.96,
      "end_seconds": 297.52,
      "duration_seconds": 13.56,
      "text": "I'd like you to see the the stroke team as well and I'll write the referral. Please don't wait if the symptoms change. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.42,
      "end_seconds": 299.9,
      "duration_seconds": 1.48,
      "text": "Okay, makes sense."
