{
  "schema_version": "1.0",
  "encounter_id": "01403",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.98,
      "end_seconds": 3.28,
      "duration_seconds": 2.3,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.08,
      "end_seconds": 6.02,
      "duration_seconds": 0.94,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.06,
      "end_seconds": 9.03,
      "duration_seconds": 1.97,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.35,
      "end_seconds": 17.95,
      "duration_seconds": 7.6,
      "text": "yeah, it's a tight band around my head. I don't know what's causing it"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.72,
      "end_seconds": 25.47,
      "duration_seconds": 1.75,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.38,
      "end_seconds": 29.42,
      "duration_seconds": 3.04,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.09,
      "end_seconds": 32.91,
      "duration_seconds": 1.82,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.62,
      "end_seconds": 39.91,
      "duration_seconds": 5.29,
      "text": "It settles a little with a walk and a warm shower."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.06,
      "end_seconds": 60.69,
      "duration_seconds": 3.63,
      "text": "So, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.84,
      "end_seconds": 69.38,
      "duration_seconds": 2.54,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.16,
      "end_seconds": 94.99,
      "duration_seconds": 9.83,
      "text": "okay: respiratory rate 15, temp 36.5 degrees, SpO2 97 percent on room air, heart rate 76, blood pressure 115 over 74."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.65,
      "end_seconds": 97.3,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 98.49,
      "end_seconds": 102.31,
      "duration_seconds": 3.82,
      "text": "Alright, don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.84,
      "end_seconds": 108.56,
      "duration_seconds": 3.72,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.63,
      "end_seconds": 111.33,
      "duration_seconds": 0.7,
      "text": "right"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.28,
      "end_seconds": 114.5,
      "duration_seconds": 2.22,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.68,
      "end_seconds": 137.44,
      "duration_seconds": 6.76,
      "text": "Your neck and shoulder muscles are tight, and and your eye movements are normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.41,
      "end_seconds": 147.64,
      "duration_seconds": 7.23,
      "text": "That's all I needed to check. Have you had any weakness, sickness or sensitivity to light?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.65,
      "end_seconds": 152.26,
      "duration_seconds": 2.61,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.25,
      "end_seconds": 156.56,
      "duration_seconds": 3.31,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.4,
      "end_seconds": 160.06,
      "duration_seconds": 1.66,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.28,
      "end_seconds": 177.66,
      "duration_seconds": 5.38,
      "text": "Okay, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.3,
      "end_seconds": 182.22,
      "duration_seconds": 3.92,
      "text": "No, uh, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 186.31,
      "duration_seconds": 3.36,
      "text": "any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 187.53,
      "end_seconds": 190.66,
      "duration_seconds": 3.13,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.8,
      "end_seconds": 206.83,
      "duration_seconds": 4.03,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.35,
      "end_seconds": 220.25,
      "duration_seconds": 10.9,
      "text": "I swim twice a week. I'm a bus driver, so I sit for long hours. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.63,
      "end_seconds": 224.14,
      "duration_seconds": 2.51,
      "text": "any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.39,
      "end_seconds": 226.56,
      "duration_seconds": 1.17,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.24,
      "end_seconds": 276.49,
      "duration_seconds": 32.25,
      "text": "so, based on the history and the examination, it's hard to say. Tension-type headache is one possibility and eye strain another, and I'd rather not commit yet. I want an eye test done, that's for eye strain. Take screen breaks every hour and try regular neck stretches. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.8,
      "end_seconds": 289.53,
      "duration_seconds": 9.73,
      "text": "One warning sign to remember: the headache becomes sudden and severe. In that case don't wait. I'd like you back in four weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.75,
      "end_seconds": 292.77,
      "duration_seconds": 2.02,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.26,
      "end_seconds": 297.01,
      "duration_seconds": 2.75,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.85,
      "end_seconds": 301.31,
      "duration_seconds": 3.46,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.04,
      "end_seconds": 305.03,
      "duration_seconds": 1.99,
      "text": "Okay, take care now."
    }
  ]
}