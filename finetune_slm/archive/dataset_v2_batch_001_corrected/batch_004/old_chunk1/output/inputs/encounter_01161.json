  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.01,
      "duration_seconds": 2.08,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.54,
      "end_seconds": 7.89,
      "duration_seconds": 4.35,
      "text": "Ah, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.93,
      "end_seconds": 12.98,
      "duration_seconds": 4.05,
      "text": "Erm, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.2,
      "end_seconds": 20.56,
      "duration_seconds": 6.36,
      "text": "That's fine, sit down. We'll go through it together. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.72,
      "end_seconds": 27.23,
      "duration_seconds": 5.51,
      "text": "So the thing is, I've got a sore ankle."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.75,
      "end_seconds": 34.57,
      "duration_seconds": 5.82,
      "text": "When was the first time you noticed it? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.19,
      "end_seconds": 38.34,
      "duration_seconds": 2.15,
      "text": "Probably two months. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.74,
      "end_seconds": 49.0,
      "duration_seconds": 10.26,
      "text": "Hm, okay. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.82,
      "end_seconds": 60.95,
      "duration_seconds": 10.13,
      "text": "It, It happens a couple of times a week. Rest and ice helps a bit. Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.99,
      "end_seconds": 64.45,
      "duration_seconds": 2.46,
      "text": "Any a little swelling as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.22,
      "end_seconds": 66.95,
      "duration_seconds": 1.73,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.38,
      "end_seconds": 76.63,
      "duration_seconds": 2.25,
      "text": "And numbness, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.85,
      "end_seconds": 79.79,
      "duration_seconds": 1.94,
      "text": "No, no numbness."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.63,
      "end_seconds": 86.5,
      "duration_seconds": 4.87,
      "text": "Did you get crack or pop or pain in the foot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.07,
      "end_seconds": 94.18,
      "duration_seconds": 7.11,
      "text": "I haven't had crack or pop or pain in the foot, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.96,
      "end_seconds": 99.49,
      "duration_seconds": 3.53,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.09,
      "end_seconds": 103.46,
      "duration_seconds": 3.37,
      "text": "No, uh, that's all normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.59,
      "end_seconds": 107.56,
      "duration_seconds": 2.97,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.36,
      "end_seconds": 112.25,
      "duration_seconds": 2.89,
      "text": "Right, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.15,
      "end_seconds": 126.25,
      "duration_seconds": 5.1,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.72,
      "end_seconds": 135.95,
      "duration_seconds": 8.23,
      "text": "I was told I'm allergic to walnuts, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.3,
      "end_seconds": 139.68,
      "duration_seconds": 2.38,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.54,
      "end_seconds": 145.33,
      "duration_seconds": 4.79,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.44,
      "end_seconds": 150.41,
      "duration_seconds": 3.97,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.3,
      "end_seconds": 155.71,
      "duration_seconds": 4.41,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.17,
      "end_seconds": 160.31,
      "duration_seconds": 3.14,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.53,
      "end_seconds": 166.58,
      "duration_seconds": 3.05,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.27,
      "end_seconds": 169.77,
      "duration_seconds": 2.5,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.85,
      "end_seconds": 178.88,
      "duration_seconds": 4.03,
      "text": "I have depression, for about a year."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.52,
      "end_seconds": 188.16,
      "duration_seconds": 7.64,
      "text": "Ah. Okay, I can see depression in your file as well. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.81,
      "end_seconds": 213.49,
      "duration_seconds": 23.68,
      "text": "Mm, it's mirtazapine, 15 milligrams, at night. I did try to ignore it for a while. I'm not great at remembering details, so bear with me. Let me think, it's ibuprofen gel, three times a day. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.05,
      "end_seconds": 216.32,
      "duration_seconds": 2.27,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.07,
      "end_seconds": 226.39,
      "duration_seconds": 2.32,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.85,
      "end_seconds": 252.8,
      "duration_seconds": 13.95,
      "text": "Okay: temperature 37.0, respiratory rate 16, weight 63 kilos, BP is 125 over 68, height 163 centimetres, BMI works out to 23.7, oxygen saturation is 99 percent, heart rate 86."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.26,
      "end_seconds": 259.01,
      "duration_seconds": 3.75,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.53,
      "end_seconds": 262.16,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.24,
      "end_seconds": 285.57,
      "duration_seconds": 7.33,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.3,
      "end_seconds": 300.71,
      "duration_seconds": 12.41,
      "text": "Right, that's the examination finished. Okay, thinking it through, I can't pin this down yet. We're looking at a mild ankle sprain or a minor fracture."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.37,
      "end_seconds": 323.12,
      "duration_seconds": 13.75,
      "text": "Rest, ice, a compression bandage and keep it raised for two days. Book a review if it is not better in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.72,
      "end_seconds": 325.56,
      "duration_seconds": 1.84,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.23,
      "end_seconds": 327.96,
      "duration_seconds": 1.73,
      "text": "Right, all the best."
    }
  ]
