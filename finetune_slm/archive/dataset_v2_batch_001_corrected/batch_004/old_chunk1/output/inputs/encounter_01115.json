{
  "schema_version": "1.0",
  "encounter_id": "01115",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 2.24,
      "duration_seconds": 1.58,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.96,
      "end_seconds": 9.51,
      "duration_seconds": 5.55,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.27,
      "end_seconds": 18.08,
      "duration_seconds": 7.81,
      "text": "Mainly sudden shortness of breath. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.75,
      "end_seconds": 20.65,
      "duration_seconds": 1.9,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.31,
      "end_seconds": 24.79,
      "duration_seconds": 2.48,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.74,
      "end_seconds": 30.54,
      "duration_seconds": 3.8,
      "text": "Any sharp pain when you breathe in as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.14,
      "end_seconds": 36.66,
      "duration_seconds": 1.52,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.35,
      "end_seconds": 46.28,
      "duration_seconds": 8.93,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.38,
      "end_seconds": 72.01,
      "duration_seconds": 24.63,
      "text": "Maybe a three out of ten on a bad day. It's on and off. I'm hoping you can tell me something definite. So, and I've been coughing up a little blood as well. With coughing up a little blood, pretty severe, if I'm being honest. It's on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 79.33,
      "duration_seconds": 6.5,
      "text": "Have you had sudden shortness of breath before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.67,
      "end_seconds": 88.21,
      "duration_seconds": 7.54,
      "text": "Yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.32,
      "end_seconds": 109.7,
      "duration_seconds": 4.38,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.2,
      "end_seconds": 126.93,
      "duration_seconds": 15.73,
      "text": "I used to drink heavily but I stopped four years ago. My partner and our baby. I retired from the post office two years ago. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.63,
      "end_seconds": 130.94,
      "duration_seconds": 3.31,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.07,
      "end_seconds": 139.07,
      "duration_seconds": 7.0,
      "text": "Furosemide. I take it 40 milligrams, maybe, every morning for the fluid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.94,
      "end_seconds": 146.04,
      "duration_seconds": 5.1,
      "text": "Alright, do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.8,
      "end_seconds": 148.72,
      "duration_seconds": 1.92,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.31,
      "end_seconds": 153.61,
      "duration_seconds": 4.3,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.26,
      "end_seconds": 158.75,
      "duration_seconds": 3.49,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.76,
      "end_seconds": 166.81,
      "duration_seconds": 6.05,
      "text": "Do you have any long-term conditions? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.91,
      "end_seconds": 173.51,
      "duration_seconds": 2.6,
      "text": "I've, I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.57,
      "end_seconds": 175.27,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.78,
      "end_seconds": 178.86,
      "duration_seconds": 3.08,
      "text": "Heart failure, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.49,
      "end_seconds": 186.03,
      "duration_seconds": 6.54,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.59,
      "end_seconds": 203.61,
      "duration_seconds": 3.02,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.12,
      "end_seconds": 209.06,
      "duration_seconds": 4.94,
      "text": "yes, I had my tonsils removed, as a teenager"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.66,
      "end_seconds": 215.8,
      "duration_seconds": 6.14,
      "text": "Let me check a a few things. Any wheeze, fever or chest tightness?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.17,
      "end_seconds": 221.66,
      "duration_seconds": 4.49,
      "text": "I haven't had wheeze, fever or chest tightness, no"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.06,
      "end_seconds": 226.78,
      "duration_seconds": 4.72,
      "text": "Ah. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.51,
      "end_seconds": 230.61,
      "duration_seconds": 2.1,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.4,
      "end_seconds": 236.84,
      "duration_seconds": 4.44,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.13,
      "end_seconds": 239.52,
      "duration_seconds": 1.39,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.59,
      "end_seconds": 249.71,
      "duration_seconds": 3.12,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.85,
      "end_seconds": 261.58,
      "duration_seconds": 3.73,
      "text": "Okay, that's it, just a a little longer..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 288.61,
      "duration_seconds": 8.66,
      "text": "Okay: respiratory rate 21, blood pressure 134 over 81, pulse is 91 beats a minute, SpO2 91 percent on room air."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.52,
      "end_seconds": 293.56,
      "duration_seconds": 3.04,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.47,
      "end_seconds": 297.77,
      "duration_seconds": 3.3,
      "text": "Okay, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.73,
      "end_seconds": 318.97,
      "duration_seconds": 7.24,
      "text": "Your left calf is swollen and tender, and your oxygen is lower than I'd like."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.37,
      "end_seconds": 351.71,
      "duration_seconds": 29.34,
      "text": "all finished, thank you putting it all together, my working impression is a possible blood clot in the lung a chest infection is also on my list we should do a CT scan of the chest for breathlessness i think a D-dimer blood test makes sense here, for possible clot you need to go to hospital now for a scan"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.19,
      "end_seconds": 369.8,
      "duration_seconds": 16.61,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose book a review straight away right, that's the plan do you wanna ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.09,
      "end_seconds": 374.15,
      "duration_seconds": 3.06,
      "text": "I think I understand everything thanks"
    }
  ]
}