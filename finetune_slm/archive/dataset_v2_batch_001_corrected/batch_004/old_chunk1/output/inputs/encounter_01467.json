{
  "schema_version": "1.0",
  "encounter_id": "01467",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.76,
      "duration_seconds": 4.1,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.41,
      "end_seconds": 13.3,
      "duration_seconds": 3.89,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.27,
      "end_seconds": 19.59,
      "duration_seconds": 5.32,
      "text": "Actually, I wanted to get my throat closing up looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.07,
      "end_seconds": 24.76,
      "duration_seconds": 3.69,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.45,
      "end_seconds": 37.31,
      "duration_seconds": 11.86,
      "text": "Since Friday, that's when it began. I've never really been one for hospitals. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.7,
      "end_seconds": 41.57,
      "duration_seconds": 2.87,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.41,
      "end_seconds": 56.99,
      "duration_seconds": 13.58,
      "text": "A three out of ten, I suppose. I've been feeling faint too, for about a week. With feeling faint, I get some relief from lying down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.82,
      "end_seconds": 68.13,
      "duration_seconds": 2.31,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.61,
      "end_seconds": 72.44,
      "duration_seconds": 2.83,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.11,
      "end_seconds": 77.2,
      "duration_seconds": 3.09,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.09,
      "end_seconds": 80.03,
      "duration_seconds": 1.94,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 98.75,
      "duration_seconds": 8.34,
      "text": "Any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.13,
      "end_seconds": 104.73,
      "duration_seconds": 4.6,
      "text": "Let me think, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.59,
      "end_seconds": 108.5,
      "duration_seconds": 2.91,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.58,
      "end_seconds": 114.67,
      "duration_seconds": 4.09,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.74,
      "end_seconds": 117.44,
      "duration_seconds": 1.7,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.88,
      "end_seconds": 121.62,
      "duration_seconds": 2.74,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.98,
      "end_seconds": 126.51,
      "duration_seconds": 3.53,
      "text": "Any recent illness or chest pain at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.59,
      "end_seconds": 134.07,
      "duration_seconds": 5.48,
      "text": "Ah, no recent illness or chest pain, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.82,
      "end_seconds": 139.81,
      "duration_seconds": 3.99,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.1,
      "end_seconds": 147.83,
      "duration_seconds": 2.73,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.86,
      "end_seconds": 163.23,
      "duration_seconds": 3.37,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.38,
      "end_seconds": 175.72,
      "duration_seconds": 2.34,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.35,
      "end_seconds": 199.51,
      "duration_seconds": 5.16,
      "text": "Okay: BP is 103 over 61, temperature 37.2, heart rate 105."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.01,
      "end_seconds": 204.36,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.45,
      "end_seconds": 208.51,
      "duration_seconds": 3.06,
      "text": "Right, we'll go over that shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.75,
      "end_seconds": 215.05,
      "duration_seconds": 4.3,
      "text": "Alright, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.08,
      "end_seconds": 230.18,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.31,
      "end_seconds": 232.58,
      "duration_seconds": 1.27,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.51,
      "end_seconds": 257.78,
      "duration_seconds": 6.27,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.07,
      "end_seconds": 267.42,
      "duration_seconds": 7.35,
      "text": "You can sit up now. Okay, so my impression is this: It points towards anaphylaxis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.09,
      "end_seconds": 271.35,
      "duration_seconds": 3.26,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.2,
      "end_seconds": 307.91,
      "duration_seconds": 34.71,
      "text": "I understand the worry. At the moment I'd say it's anaphylaxis, and we'll know more once the monitoring is back. Let's get monitoring, for anaphylaxis. I'll start you on adrenaline, 0.5 milligrams, once now, single dose. It's for anaphylaxis. Lie flat with your legs raised, I am giving the injection now. The emergency team would be the right next step, I'll refer you. Come back or go to emergency straight away if the symptoms return."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.68,
      "end_seconds": 311.51,
      "duration_seconds": 1.83,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.19,
      "end_seconds": 315.12,
      "duration_seconds": 1.93,
      "text": "Come back straight away."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.01,
      "end_seconds": 319.96,
      "duration_seconds": 3.95,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.81,
      "end_seconds": 323.72,
      "duration_seconds": 2.91,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.29,
      "end_seconds": 327.92,
      "duration_seconds": 3.63,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}