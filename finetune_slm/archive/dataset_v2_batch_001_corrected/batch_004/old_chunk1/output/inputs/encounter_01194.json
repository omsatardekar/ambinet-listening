{
  "schema_version": "1.0",
  "encounter_id": "01194",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.0,
      "end_seconds": 7.98,
      "duration_seconds": 6.98,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.33,
      "end_seconds": 13.34,
      "duration_seconds": 4.01,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.2,
      "end_seconds": 20.41,
      "duration_seconds": 5.21,
      "text": "Yeah, uh, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 21.52,
      "end_seconds": 35.55,
      "duration_seconds": 14.03,
      "text": "So the thing is, I've got no real problems. I've been reading about it online and it worried me. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 37.8,
      "duration_seconds": 1.24,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.76,
      "end_seconds": 76.16,
      "duration_seconds": 37.4,
      "text": "I've had it for five days. I'm not great at remembering details, so bear with me. Oh, and a bit of back stiffness. About bit of back stiffness, I'd call it moderate. Honestly, once or twice a day. Sitting long definitely sets it off. I get some relief from stretching. And an occasional headache, too. Uh, about occasional headache, I'd say once or twice a day."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.08,
      "end_seconds": 79.52,
      "duration_seconds": 1.44,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.22,
      "end_seconds": 82.8,
      "duration_seconds": 2.58,
      "text": "No chest pain, thankfully."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.85,
      "end_seconds": 88.3,
      "duration_seconds": 4.45,
      "text": "Have you had any weight loss or shortness of breath?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 89.32,
      "end_seconds": 96.16,
      "duration_seconds": 6.84,
      "text": "Uh, no weight loss or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.95,
      "end_seconds": 99.3,
      "duration_seconds": 2.35,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.27,
      "end_seconds": 101.26,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.82,
      "end_seconds": 104.98,
      "duration_seconds": 3.16,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.14,
      "end_seconds": 122.54,
      "duration_seconds": 16.4,
      "text": "Yes, high cholesterol. Okay, so yes, arthritis in my knees. I've been putting this off for weeks. Well, I've had an underactive thyroid, yes. I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.52,
      "end_seconds": 130.1,
      "duration_seconds": 6.58,
      "text": "Alright, arthritis in your knees and an underactive thyroid, that matches what I have here."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.99,
      "end_seconds": 144.19,
      "duration_seconds": 2.2,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 145.05,
      "end_seconds": 153.5,
      "duration_seconds": 8.45,
      "text": "Just my tonsils removed, as a teenager. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.28,
      "end_seconds": 162.11,
      "duration_seconds": 4.83,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.17,
      "end_seconds": 165.94,
      "duration_seconds": 2.77,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 167.22,
      "end_seconds": 175.48,
      "duration_seconds": 8.26,
      "text": "Hold on, doctor, I think she reacted to diclofenac once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.72,
      "end_seconds": 179.48,
      "duration_seconds": 2.76,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.41,
      "end_seconds": 186.75,
      "duration_seconds": 5.34,
      "text": "Okay, I'll note both of those. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 188.18,
      "end_seconds": 204.27,
      "duration_seconds": 16.09,
      "text": "She takes diclofenac, 50 milligrams, when needed. She takes Eltroxin, 100 micrograms, every morning. It's bisoprolol, 2.5 milligrams, once a day for the heart rhythm, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.99,
      "end_seconds": 210.89,
      "duration_seconds": 4.9,
      "text": "I was on paracetamol before. I stopped taking it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.23,
      "end_seconds": 229.06,
      "duration_seconds": 2.83,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.7,
      "end_seconds": 246.46,
      "duration_seconds": 11.76,
      "text": "My partner and our baby. I retired from the post office two years ago. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 248.28,
      "end_seconds": 256.5,
      "duration_seconds": 8.22,
      "text": "Okay, so the vitals from earlier. Temperature 36.7, pulse 65, pressure 111 over 78. Saturation 97 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.43,
      "end_seconds": 259.13,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.67,
      "end_seconds": 265.56,
      "duration_seconds": 3.89,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.89,
      "end_seconds": 269.22,
      "duration_seconds": 2.33,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.09,
      "end_seconds": 290.59,
      "duration_seconds": 2.5,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.73,
      "end_seconds": 292.84,
      "duration_seconds": 1.11,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.67,
      "end_seconds": 298.79,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.23,
      "end_seconds": 318.32,
      "duration_seconds": 7.09,
      "text": "Okay, thinking it through, this is probably a healthy adult with no worrying findings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 320.12,
      "end_seconds": 323.29,
      "duration_seconds": 3.17,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.14,
      "end_seconds": 343.71,
      "duration_seconds": 18.57,
      "text": "It's reasonable to be concerned, but right now a healthy adult with no worrying findings is my leading thought, not anything worse. I'll request a cholesterol blood test, it'll help with routine check. I'm going to order a fasting sugar test, for routine check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 345.43,
      "end_seconds": 347.73,
      "duration_seconds": 2.3,
      "text": "Mm, uh, alright."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.33,
      "end_seconds": 368.08,
      "duration_seconds": 19.75,
      "text": "Keep up regular exercise and a balanced diet. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Do get help quickly if new symptoms appear. Book a review in twelve months. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 369.67,
      "end_seconds": 372.87,
      "duration_seconds": 3.2,
      "text": "Oh, thank you, that's helpful."
    }
  ]
}