{
  "schema_version": "1.0",
  "encounter_id": "01413",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 5.47,
      "duration_seconds": 4.61,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.19,
      "end_seconds": 11.97,
      "duration_seconds": 4.78,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.04,
      "end_seconds": 17.36,
      "duration_seconds": 4.32,
      "text": "I wanted to get a severe headache looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.93,
      "end_seconds": 19.1,
      "duration_seconds": 1.17,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.7,
      "end_seconds": 24.17,
      "duration_seconds": 3.47,
      "text": "I've, I've had it for ten days"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.94,
      "end_seconds": 27.91,
      "duration_seconds": 1.97,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.94,
      "end_seconds": 39.25,
      "duration_seconds": 9.31,
      "text": "A stiff neck goes along with it, most of the time. The, The stiff neck? That's been for two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.83,
      "end_seconds": 41.37,
      "duration_seconds": 1.54,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.53,
      "end_seconds": 51.19,
      "duration_seconds": 8.66,
      "text": "Let me think, and there's a rash that does not fade as well, three days now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.08,
      "end_seconds": 55.6,
      "duration_seconds": 2.52,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.07,
      "end_seconds": 70.68,
      "duration_seconds": 2.61,
      "text": "Nearly done with the the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.1,
      "end_seconds": 95.05,
      "duration_seconds": 8.95,
      "text": "okay: blood pressure 109 over 78, pulse is 108 beats a minute, saturation 97 percent. And temperature is 38.2 degrees"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.71,
      "end_seconds": 99.8,
      "duration_seconds": 2.09,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.41,
      "end_seconds": 103.37,
      "duration_seconds": 1.96,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.24,
      "end_seconds": 128.71,
      "duration_seconds": 7.47,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.24,
      "end_seconds": 140.86,
      "duration_seconds": 6.62,
      "text": "You can sit up now. A few quick ones: cough or recent head injury?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.89,
      "end_seconds": 143.87,
      "duration_seconds": 1.98,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.9,
      "end_seconds": 148.17,
      "duration_seconds": 2.27,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.18,
      "end_seconds": 150.1,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.12,
      "end_seconds": 153.22,
      "duration_seconds": 2.1,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.09,
      "end_seconds": 156.87,
      "duration_seconds": 2.78,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.71,
      "end_seconds": 162.43,
      "duration_seconds": 3.72,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.3,
      "end_seconds": 168.47,
      "duration_seconds": 5.17,
      "text": "Sumatriptan, 50 milligrams, when needed. Propranolol I don't take anymore."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.88,
      "end_seconds": 187.12,
      "duration_seconds": 2.24,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.2,
      "end_seconds": 192.68,
      "duration_seconds": 4.48,
      "text": "yes, I had a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.73,
      "end_seconds": 213.08,
      "duration_seconds": 4.35,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.28,
      "end_seconds": 217.25,
      "duration_seconds": 2.97,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.21,
      "end_seconds": 220.61,
      "duration_seconds": 2.4,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.2,
      "end_seconds": 223.8,
      "duration_seconds": 1.6,
      "text": "I have migraines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.41,
      "end_seconds": 232.09,
      "duration_seconds": 4.68,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.55,
      "end_seconds": 247.29,
      "duration_seconds": 9.74,
      "text": "Lots of rice, lentils and some fruit. I walk the dog every morning. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.47,
      "end_seconds": 271.74,
      "duration_seconds": 7.27,
      "text": "Putting it all together, I think we're dealing with possible bacterial meningitis at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.74,
      "end_seconds": 276.08,
      "duration_seconds": 3.34,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.87,
      "end_seconds": 306.1,
      "duration_seconds": 28.23,
      "text": "Nothing I've seen today points to an emergency. It looks like possible bacterial meningitis, but I'd like to confirm. I'll request a lumbar puncture, it'll help with possible meningitis. What I'm giving you is benzylpenicillin, 1.2 grams, once now, single dose. That should help with possible meningitis. Call an ambulance now, this is an emergency. We'll refer you to the emergency team."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.96,
      "end_seconds": 319.99,
      "duration_seconds": 13.03,
      "text": "Keep an eye out, and if you cannot go now, call us the same day or go to emergency. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.97,
      "end_seconds": 328.63,
      "duration_seconds": 6.66,
      "text": "let me think, um, okay, that makes sense thanks for explaining"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.35,
      "end_seconds": 331.71,
      "duration_seconds": 1.36,
      "text": "all the best"
    }
  ]
}