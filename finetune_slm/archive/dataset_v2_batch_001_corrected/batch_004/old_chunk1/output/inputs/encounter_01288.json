{
  "schema_version": "1.0",
  "encounter_id": "01288",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 3.34,
      "duration_seconds": 2.81,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.28,
      "end_seconds": 9.64,
      "duration_seconds": 4.36,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.68,
      "end_seconds": 16.18,
      "duration_seconds": 4.5,
      "text": "Um, so... bloating after meals. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.02,
      "end_seconds": 19.81,
      "duration_seconds": 2.79,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.61,
      "end_seconds": 25.56,
      "duration_seconds": 2.95,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.33,
      "end_seconds": 32.59,
      "duration_seconds": 6.26,
      "text": "What's the timeline, when did it begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.25,
      "end_seconds": 38.03,
      "duration_seconds": 3.78,
      "text": "it's been two months, I'm fairly sure"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.06,
      "end_seconds": 41.67,
      "duration_seconds": 1.61,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.28,
      "end_seconds": 48.23,
      "duration_seconds": 4.95,
      "text": "Large meals and fizzy drinks definitely sets it off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.54,
      "end_seconds": 54.62,
      "duration_seconds": 5.08,
      "text": "Any weight loss, vomiting or blood in the stool at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.38,
      "end_seconds": 62.2,
      "duration_seconds": 5.82,
      "text": "No, no weight loss, vomiting or blood in the stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.13,
      "end_seconds": 66.94,
      "duration_seconds": 3.81,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.59,
      "end_seconds": 70.01,
      "duration_seconds": 1.42,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.95,
      "end_seconds": 76.67,
      "duration_seconds": 2.72,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.35,
      "end_seconds": 78.49,
      "duration_seconds": 1.14,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.14,
      "end_seconds": 94.76,
      "duration_seconds": 4.62,
      "text": "alright, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.93,
      "end_seconds": 99.51,
      "duration_seconds": 1.58,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.56,
      "end_seconds": 108.61,
      "duration_seconds": 2.05,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.21,
      "end_seconds": 115.87,
      "duration_seconds": 5.66,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.5,
      "end_seconds": 118.95,
      "duration_seconds": 1.45,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.54,
      "end_seconds": 123.09,
      "duration_seconds": 3.55,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.4,
      "end_seconds": 130.71,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.08,
      "end_seconds": 135.89,
      "duration_seconds": 3.81,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.88,
      "end_seconds": 139.59,
      "duration_seconds": 2.71,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.16,
      "end_seconds": 143.73,
      "duration_seconds": 3.57,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.03,
      "end_seconds": 166.57,
      "duration_seconds": 4.54,
      "text": "has anything ever caused you a reaction? I mean any allergies"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.13,
      "end_seconds": 170.37,
      "duration_seconds": 3.24,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.04,
      "end_seconds": 174.08,
      "duration_seconds": 3.04,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.99,
      "end_seconds": 187.49,
      "duration_seconds": 2.5,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.14,
      "end_seconds": 204.3,
      "duration_seconds": 4.16,
      "text": "Okay: pulse 85, pressure 117 over 68, saturation 99 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.56,
      "end_seconds": 207.74,
      "duration_seconds": 2.18,
      "text": "is that that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.65,
      "end_seconds": 211.09,
      "duration_seconds": 2.44,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.41,
      "end_seconds": 217.4,
      "duration_seconds": 4.99,
      "text": "Alright, over here please and and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.08,
      "end_seconds": 220.29,
      "duration_seconds": 1.21,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.63,
      "end_seconds": 223.08,
      "duration_seconds": 1.45,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.39,
      "end_seconds": 247.36,
      "duration_seconds": 5.97,
      "text": "Your tummy is soft and not tender, and and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.57,
      "end_seconds": 262.09,
      "duration_seconds": 12.52,
      "text": "Thank you, you can get dressed. Okay, thinking it through, I think we're dealing with a functional bowel pattern, with no alarm features at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.76,
      "end_seconds": 287.83,
      "duration_seconds": 8.07,
      "text": "Try smaller meals and keep a food and symptom diary for four weeks. Book a review in six weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.31,
      "end_seconds": 290.01,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.13,
      "end_seconds": 296.64,
      "duration_seconds": 5.51,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.49,
      "end_seconds": 303.67,
      "duration_seconds": 2.18,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.27,
      "end_seconds": 305.6,
      "duration_seconds": 1.33,
      "text": "look after yourself"
    }
  ]
}