{
  "schema_version": "1.0",
  "encounter_id": "01032",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.53,
      "duration_seconds": 4.35,
      "text": "Well, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.87,
      "end_seconds": 11.69,
      "duration_seconds": 4.82,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.21,
      "end_seconds": 19.04,
      "duration_seconds": 6.83,
      "text": "Ah, you know, hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.96,
      "end_seconds": 22.66,
      "duration_seconds": 2.7,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.46,
      "end_seconds": 30.82,
      "duration_seconds": 6.36,
      "text": "I, I wanted to get a cut on my finger looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.77,
      "end_seconds": 33.91,
      "duration_seconds": 2.14,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.44,
      "end_seconds": 52.83,
      "duration_seconds": 17.39,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, um, I really can't pin it down. There's a little bleeding as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.77,
      "end_seconds": 61.25,
      "duration_seconds": 6.48,
      "text": "Have you had a cut on your finger before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.88,
      "end_seconds": 70.45,
      "duration_seconds": 7.57,
      "text": "I mean, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.26,
      "end_seconds": 75.69,
      "duration_seconds": 4.43,
      "text": "Let me check a few things. Any numbness or dirty blade?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.41,
      "end_seconds": 83.42,
      "duration_seconds": 6.01,
      "text": "Let me think, um, no, no numbness or dirty blade."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.04,
      "end_seconds": 86.5,
      "duration_seconds": 2.46,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.03,
      "end_seconds": 89.75,
      "duration_seconds": 1.72,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.51,
      "end_seconds": 94.35,
      "duration_seconds": 2.84,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.4,
      "end_seconds": 98.91,
      "duration_seconds": 3.51,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.86,
      "end_seconds": 102.51,
      "duration_seconds": 1.65,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.73,
      "end_seconds": 106.6,
      "duration_seconds": 2.87,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.18,
      "end_seconds": 109.9,
      "duration_seconds": 2.72,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.6,
      "end_seconds": 116.69,
      "duration_seconds": 5.09,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.72,
      "end_seconds": 122.03,
      "duration_seconds": 4.31,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.73,
      "end_seconds": 129.21,
      "duration_seconds": 5.48,
      "text": "Naproxen. I take it 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.08,
      "end_seconds": 132.78,
      "duration_seconds": 2.7,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.42,
      "end_seconds": 139.01,
      "duration_seconds": 5.59,
      "text": "About two years. Atorvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.66,
      "end_seconds": 142.58,
      "duration_seconds": 2.92,
      "text": "Okay, how long have you taken that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.87,
      "end_seconds": 146.1,
      "duration_seconds": 2.23,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.83,
      "end_seconds": 151.14,
      "duration_seconds": 3.31,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 156.84,
      "duration_seconds": 4.67,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 164.7,
      "duration_seconds": 6.67,
      "text": "Any health conditions I should have on record? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.19,
      "end_seconds": 190.28,
      "duration_seconds": 20.09,
      "text": "Sorry, what was I saying, I have arthritis in my knees. I did try to ignore it for a while. I just want to get back to normal, really. Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.61,
      "end_seconds": 197.09,
      "duration_seconds": 5.48,
      "text": "Alright, arthritis in your knees, that matches what I have here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.66,
      "end_seconds": 211.58,
      "duration_seconds": 2.92,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.59,
      "end_seconds": 225.13,
      "duration_seconds": 2.54,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.53,
      "end_seconds": 243.87,
      "duration_seconds": 7.34,
      "text": "Okay: pressure 117 over 70, saturation 99 percent, pulse 66, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.93,
      "end_seconds": 250.37,
      "duration_seconds": 4.44,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.47,
      "end_seconds": 252.64,
      "duration_seconds": 1.17,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.21,
      "end_seconds": 266.56,
      "duration_seconds": 5.35,
      "text": "It's a clean shallow cut, no longer bleeding, and the finger moves normally."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.71,
      "end_seconds": 272.87,
      "duration_seconds": 2.16,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.52,
      "end_seconds": 292.51,
      "duration_seconds": 5.99,
      "text": "Taking everything into account, this is probably a minor clean wound that needs only dressing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.59,
      "end_seconds": 297.93,
      "duration_seconds": 4.34,
      "text": "Ah, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.98,
      "end_seconds": 310.82,
      "duration_seconds": 11.84,
      "text": "I understand the worry. At the moment I'd say it's a minor clean wound that needs only dressing, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.32,
      "end_seconds": 340.04,
      "duration_seconds": 16.72,
      "text": "I'll close it with adhesive strips and keep it dry for two days. One warning sign to remember: the finger turns red, hot or swollen. In that case don't wait. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.94,
      "end_seconds": 346.68,
      "duration_seconds": 4.74,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}