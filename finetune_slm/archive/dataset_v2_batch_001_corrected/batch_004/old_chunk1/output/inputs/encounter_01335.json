      "role": "PATIENT",
      "start_seconds": 85.11,
      "end_seconds": 86.6,
      "duration_seconds": 1.49,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.15,
      "end_seconds": 89.55,
      "duration_seconds": 2.4,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.56,
      "end_seconds": 94.05,
      "duration_seconds": 2.49,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.71,
      "end_seconds": 100.06,
      "duration_seconds": 4.35,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.47,
      "end_seconds": 103.81,
      "duration_seconds": 2.34,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.84,
      "end_seconds": 109.95,
      "duration_seconds": 4.11,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.44,
      "end_seconds": 116.09,
      "duration_seconds": 1.65,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.99,
      "end_seconds": 119.43,
      "duration_seconds": 2.44,
      "text": "Okay, how active are you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.43,
      "end_seconds": 125.13,
      "duration_seconds": 3.7,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.8,
      "end_seconds": 128.42,
      "duration_seconds": 2.62,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.99,
      "end_seconds": 132.2,
      "duration_seconds": 3.21,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.6,
      "end_seconds": 134.98,
      "duration_seconds": 1.38,
      "text": "What's your work?"
    },
