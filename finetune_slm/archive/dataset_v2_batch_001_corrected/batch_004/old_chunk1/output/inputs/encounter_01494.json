{
  "schema_version": "1.0",
  "encounter_id": "01494",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.51,
      "end_seconds": 3.91,
      "duration_seconds": 3.4,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.16,
      "end_seconds": 8.84,
      "duration_seconds": 3.68,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.25,
      "end_seconds": 21.16,
      "duration_seconds": 6.91,
      "text": "Um, so... shaking chills and a high temperature. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.13,
      "end_seconds": 25.67,
      "duration_seconds": 3.54,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.23,
      "end_seconds": 28.99,
      "duration_seconds": 2.76,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.24,
      "end_seconds": 33.19,
      "duration_seconds": 3.95,
      "text": "I follow. Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.21,
      "end_seconds": 36.02,
      "duration_seconds": 1.81,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.87,
      "end_seconds": 43.2,
      "duration_seconds": 6.33,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 43.3,
      "end_seconds": 49.99,
      "duration_seconds": 6.69,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.08,
      "end_seconds": 54.45,
      "duration_seconds": 2.37,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.95,
      "end_seconds": 62.3,
      "duration_seconds": 7.35,
      "text": "I've been feeling confused too. About feeling confused, it feels moderate to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.67,
      "end_seconds": 71.15,
      "duration_seconds": 7.48,
      "text": "Have you had shaking chills and a high temperature before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.7,
      "end_seconds": 77.46,
      "duration_seconds": 4.76,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.35,
      "end_seconds": 82.37,
      "duration_seconds": 4.02,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.69,
      "end_seconds": 92.39,
      "duration_seconds": 4.7,
      "text": "My sister had breast cancer. My mother had a stroke."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.2,
      "end_seconds": 96.62,
      "duration_seconds": 3.42,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.51,
      "end_seconds": 104.35,
      "duration_seconds": 3.84,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.25,
      "end_seconds": 107.1,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.06,
      "end_seconds": 112.01,
      "duration_seconds": 3.95,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.3,
      "end_seconds": 117.49,
      "duration_seconds": 4.19,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.47,
      "end_seconds": 122.03,
      "duration_seconds": 3.56,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.73,
      "end_seconds": 127.58,
      "duration_seconds": 3.85,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.37,
      "end_seconds": 142.35,
      "duration_seconds": 13.98,
      "text": "Glycomet. I take it 500 milligrams, twice a day for my sugar. Uh, I'm on diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 145.89,
      "end_seconds": 151.21,
      "duration_seconds": 5.32,
      "text": "Doctor, our chart from the last visit lists it as 25 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.97,
      "end_seconds": 157.39,
      "duration_seconds": 4.42,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.38,
      "end_seconds": 162.27,
      "duration_seconds": 3.89,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.2,
      "end_seconds": 172.19,
      "duration_seconds": 7.99,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.33,
      "end_seconds": 176.35,
      "duration_seconds": 3.02,
      "text": "So, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.77,
      "end_seconds": 197.57,
      "duration_seconds": 19.8,
      "text": "Mm, for my cholesterol, I believe. My wife sets them out for me, I just take what I'm given. I take alendronate, 70 milligrams, once a week. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.45,
      "end_seconds": 202.69,
      "duration_seconds": 4.24,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.27,
      "end_seconds": 214.02,
      "duration_seconds": 9.75,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.01,
      "end_seconds": 217.62,
      "duration_seconds": 2.61,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.33,
      "end_seconds": 227.63,
      "duration_seconds": 5.3,
      "text": "Diabetes, for two years. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.59,
      "end_seconds": 230.45,
      "duration_seconds": 0.86,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.84,
      "end_seconds": 236.1,
      "duration_seconds": 4.26,
      "text": "I have high cholesterol. I have thin bones."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.07,
      "end_seconds": 246.11,
      "duration_seconds": 8.04,
      "text": "Alright, diabetes and high cholesterol, that matches what I have here. Any stiff neck, rash or chest pain?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.28,
      "end_seconds": 260.19,
      "duration_seconds": 12.91,
      "text": "No, no stiff neck, no rash, no chest pain. I did have very little urine at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.15,
      "end_seconds": 263.35,
      "duration_seconds": 2.2,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.86,
      "end_seconds": 265.78,
      "duration_seconds": 0.92,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.07,
      "end_seconds": 270.79,
      "duration_seconds": 3.72,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.0,
      "end_seconds": 274.74,
      "duration_seconds": 2.74,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 292.19,
      "end_seconds": 301.38,
      "duration_seconds": 9.19,
      "text": "Here are the numbers, doctor. Pressure 125 over 77, temperature 38.8, pulse is 94 beats a minute, saturation 96 percent."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.78,
      "end_seconds": 303.48,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.78,
      "end_seconds": 310.9,
      "duration_seconds": 5.12,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.01,
      "end_seconds": 313.97,
      "duration_seconds": 1.96,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.42,
      "end_seconds": 332.02,
      "duration_seconds": 6.6,
      "text": "You are hot, your heart is racing and your blood pressure is low, which worries me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.42,
      "end_seconds": 359.71,
      "duration_seconds": 25.29,
      "text": "Good, you can sit up again. Okay, thinking it through, the most likely explanation is possible sepsis needing urgent treatment. A severe urine or chest infection is also on my list. Just to be sure I understood. You've had shaking chills and a high temperature, since Monday, and no rash or stiff neck."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.6,
      "end_seconds": 365.1,
      "duration_seconds": 1.5,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.63,
      "end_seconds": 388.8,
      "duration_seconds": 5.17,
      "text": "Lactate and blood tests is what I'd like next, for sepsis."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 389.34,
      "end_seconds": 393.2,
      "duration_seconds": 3.86,
      "text": "I can book that for Friday at 3:30 pm."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.97,
      "end_seconds": 420.67,
      "duration_seconds": 26.7,
      "text": "I want blood cultures done, that's for fever with low blood pressure. I want to admit you to hospital now for fluids and antibiotics. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'd like you to see the emergency team as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 422.74,
      "end_seconds": 425.24,
      "duration_seconds": 2.5,
      "text": "Alright, um, thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 427.12,
      "end_seconds": 443.83,
      "duration_seconds": 16.71,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like you back straight away. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 445.79,
      "end_seconds": 449.12,
      "duration_seconds": 3.33,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.13,
      "end_seconds": 451.46,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}