{
  "schema_version": "1.0",
  "encounter_id": "01119",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 4.96,
      "duration_seconds": 3.85,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 10.92,
      "duration_seconds": 4.67,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.95,
      "end_seconds": 16.23,
      "duration_seconds": 3.28,
      "text": "So, I've been feeling well, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.51,
      "end_seconds": 19.68,
      "duration_seconds": 2.17,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.71,
      "end_seconds": 23.63,
      "duration_seconds": 1.92,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.87,
      "end_seconds": 28.22,
      "duration_seconds": 3.35,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.52,
      "end_seconds": 32.26,
      "duration_seconds": 1.74,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.09,
      "end_seconds": 38.21,
      "duration_seconds": 4.12,
      "text": "A few quick ones: palpitations, feeling cold or constipation?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.79,
      "end_seconds": 45.06,
      "duration_seconds": 5.27,
      "text": "No palpitations, feeling cold or constipation, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.26,
      "end_seconds": 49.29,
      "duration_seconds": 3.03,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.29,
      "end_seconds": 55.1,
      "duration_seconds": 3.81,
      "text": "Bowels are regular, um, nothing odd."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.57,
      "end_seconds": 75.29,
      "duration_seconds": 4.72,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.01,
      "end_seconds": 87.51,
      "duration_seconds": 11.5,
      "text": "I grab fast food at lunch most days. No, I share a house with my brother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.17,
      "end_seconds": 92.65,
      "duration_seconds": 3.48,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.43,
      "end_seconds": 98.8,
      "duration_seconds": 5.37,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.9,
      "end_seconds": 110.72,
      "duration_seconds": 3.82,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.38,
      "end_seconds": 120.03,
      "duration_seconds": 8.65,
      "text": "Mm, I was told I'm allergic to milk, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.51,
      "end_seconds": 124.06,
      "duration_seconds": 2.55,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.36,
      "end_seconds": 129.76,
      "duration_seconds": 4.4,
      "text": "Actually, I have an underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.46,
      "end_seconds": 134.75,
      "duration_seconds": 4.29,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.69,
      "end_seconds": 143.17,
      "duration_seconds": 7.48,
      "text": "Thyronorm, 50 micrograms, every morning for my thyroid. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.28,
      "end_seconds": 158.07,
      "duration_seconds": 2.79,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.82,
      "end_seconds": 171.13,
      "duration_seconds": 2.31,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 196.33,
      "duration_seconds": 11.7,
      "text": "Okay: blood pressure 119 over 68, pulse is 80 beats a minute, SpO2 98 percent on room air. And temperature is 36.7 degrees, respiratory rate 17."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.5,
      "end_seconds": 201.87,
      "duration_seconds": 4.37,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.83,
      "end_seconds": 204.59,
      "duration_seconds": 1.76,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.98,
      "end_seconds": 207.44,
      "duration_seconds": 1.46,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.52,
      "end_seconds": 220.1,
      "duration_seconds": 4.58,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.41,
      "end_seconds": 239.15,
      "duration_seconds": 16.74,
      "text": "Good, you can sit up again. Okay, so my impression is this: I think we're dealing with well-controlled thyroid replacement at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.91,
      "end_seconds": 243.15,
      "duration_seconds": 2.24,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.35,
      "end_seconds": 255.56,
      "duration_seconds": 11.21,
      "text": "I understand the worry. At the moment I'd say it's well-controlled thyroid replacement, and we'll know more once the a thyroid blood test is back."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.56,
      "end_seconds": 289.19,
      "duration_seconds": 23.63,
      "text": "I'm going to order a thyroid blood test, for annual review. Keep taking the tablet on an empty stomach, apart from coffee. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Come back or go to emergency straight away if you notice palpitations or weight change."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.46,
      "end_seconds": 293.79,
      "duration_seconds": 3.33,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.75,
      "end_seconds": 303.81,
      "duration_seconds": 8.06,
      "text": "We'll catch up in twelve months. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.54,
      "end_seconds": 309.17,
      "duration_seconds": 4.63,
      "text": "So, I come back in twelve months. Is that right?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.27,
      "end_seconds": 316.4,
      "duration_seconds": 6.13,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.05,
      "end_seconds": 321.18,
      "duration_seconds": 3.13,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}