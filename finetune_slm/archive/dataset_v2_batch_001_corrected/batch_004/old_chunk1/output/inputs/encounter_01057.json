{
  "schema_version": "1.0",
  "encounter_id": "01057",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 6.78,
      "duration_seconds": 5.75,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.98,
      "end_seconds": 16.64,
      "duration_seconds": 5.66,
      "text": "Okay, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.12,
      "end_seconds": 21.17,
      "duration_seconds": 3.05,
      "text": "So, I've been feeling well, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.26,
      "end_seconds": 25.7,
      "duration_seconds": 3.44,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.8,
      "end_seconds": 29.11,
      "duration_seconds": 2.31,
      "text": "It's been ten days now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.13,
      "end_seconds": 36.08,
      "duration_seconds": 2.95,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.07,
      "end_seconds": 42.49,
      "duration_seconds": 4.42,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.72,
      "end_seconds": 46.5,
      "duration_seconds": 2.78,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.54,
      "end_seconds": 57.01,
      "duration_seconds": 2.47,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.83,
      "end_seconds": 86.82,
      "duration_seconds": 12.99,
      "text": "Okay: blood pressure 118 over 69, height 165 centimetres, BMI works out to 23.9, pulse is 68 beats a minute, temperature is 36.8 degrees, weight 65 kilos."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.2,
      "end_seconds": 89.8,
      "duration_seconds": 1.6,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.63,
      "end_seconds": 93.51,
      "duration_seconds": 2.88,
      "text": "Alright, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 99.63,
      "duration_seconds": 3.61,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.62,
      "end_seconds": 103.07,
      "duration_seconds": 1.45,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.53,
      "end_seconds": 120.87,
      "duration_seconds": 4.34,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.49,
      "end_seconds": 126.95,
      "duration_seconds": 2.46,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.19,
      "end_seconds": 145.97,
      "duration_seconds": 3.78,
      "text": "So, have you had weight change, by any chance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.94,
      "end_seconds": 153.59,
      "duration_seconds": 4.65,
      "text": "Yeah, not that I've noticed, no weight change."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.96,
      "end_seconds": 159.51,
      "duration_seconds": 4.55,
      "text": "Let me check a few things. Any constipation or palpitations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.25,
      "end_seconds": 163.7,
      "duration_seconds": 2.45,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.36,
      "end_seconds": 166.73,
      "duration_seconds": 2.37,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.94,
      "end_seconds": 170.05,
      "duration_seconds": 2.11,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.03,
      "end_seconds": 174.88,
      "duration_seconds": 2.85,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.82,
      "end_seconds": 179.16,
      "duration_seconds": 3.34,
      "text": "Bowels are regular, um, nothing odd."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.58,
      "end_seconds": 184.48,
      "duration_seconds": 3.9,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.47,
      "end_seconds": 189.55,
      "duration_seconds": 3.08,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.02,
      "end_seconds": 201.16,
      "duration_seconds": 2.14,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.87,
      "end_seconds": 206.44,
      "duration_seconds": 3.57,
      "text": "I'm on Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.54,
      "end_seconds": 223.59,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.58,
      "end_seconds": 229.98,
      "duration_seconds": 4.4,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.6,
      "end_seconds": 233.04,
      "duration_seconds": 2.44,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.97,
      "end_seconds": 237.72,
      "duration_seconds": 3.75,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.96,
      "end_seconds": 248.82,
      "duration_seconds": 2.86,
      "text": "Right, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.86,
      "end_seconds": 262.3,
      "duration_seconds": 12.44,
      "text": "So, uh, I've got an underactive thyroid. I did try to ignore it for a while. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.82,
      "end_seconds": 268.23,
      "duration_seconds": 4.41,
      "text": "Okay, thinking it through, it points towards well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.26,
      "end_seconds": 272.5,
      "duration_seconds": 3.24,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.47,
      "end_seconds": 290.92,
      "duration_seconds": 17.45,
      "text": "Nothing I've seen today points to an emergency. It looks like well-controlled thyroid replacement. Keep taking the tablet on an empty stomach, apart from coffee. Please don't wait if you notice palpitations or weight change. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.38,
      "end_seconds": 295.29,
      "duration_seconds": 2.91,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.71,
      "end_seconds": 303.74,
      "duration_seconds": 7.03,
      "text": "We'll catch up in twelve months. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.35,
      "end_seconds": 306.52,
      "duration_seconds": 2.17,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}