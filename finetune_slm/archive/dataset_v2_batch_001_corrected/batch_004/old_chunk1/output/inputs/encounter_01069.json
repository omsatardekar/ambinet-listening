{
  "schema_version": "1.0",
  "encounter_id": "01069",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.29,
      "duration_seconds": 3.52,
      "text": "Erm, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.59,
      "end_seconds": 10.12,
      "duration_seconds": 4.53,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.04,
      "end_seconds": 17.57,
      "duration_seconds": 5.53,
      "text": "Um, so... no real problems. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.8,
      "end_seconds": 22.15,
      "duration_seconds": 3.35,
      "text": "So, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.93,
      "end_seconds": 28.8,
      "duration_seconds": 5.87,
      "text": "About a week, I think... sorry, three weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.4,
      "end_seconds": 33.45,
      "duration_seconds": 4.05,
      "text": "Sure. Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.18,
      "end_seconds": 35.92,
      "duration_seconds": 1.74,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.42,
      "end_seconds": 37.21,
      "duration_seconds": 0.79,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.79,
      "end_seconds": 45.83,
      "duration_seconds": 8.04,
      "text": "Oh, and a bit of back stiffness. That's been about the same, about three months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.24,
      "end_seconds": 49.61,
      "duration_seconds": 2.37,
      "text": "Any an occasional headache as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.64,
      "end_seconds": 53.66,
      "duration_seconds": 3.02,
      "text": "Yes, about the same, three weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.63,
      "end_seconds": 60.71,
      "duration_seconds": 6.08,
      "text": "Have you had no real problems before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.6,
      "end_seconds": 67.81,
      "duration_seconds": 5.21,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.22,
      "end_seconds": 74.27,
      "duration_seconds": 5.05,
      "text": "Any shortness of breath, chest pain or weight loss at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.04,
      "end_seconds": 77.08,
      "duration_seconds": 2.04,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.82,
      "end_seconds": 80.67,
      "duration_seconds": 2.85,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.28,
      "end_seconds": 83.58,
      "duration_seconds": 2.3,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.12,
      "end_seconds": 87.07,
      "duration_seconds": 1.95,
      "text": "Okay, what about alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.42,
      "end_seconds": 92.76,
      "duration_seconds": 4.34,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.53,
      "end_seconds": 96.31,
      "duration_seconds": 2.78,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.13,
      "end_seconds": 101.04,
      "duration_seconds": 3.91,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.83,
      "end_seconds": 106.88,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.54,
      "end_seconds": 111.55,
      "duration_seconds": 4.01,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.44,
      "end_seconds": 114.92,
      "duration_seconds": 1.48,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.54,
      "end_seconds": 118.3,
      "duration_seconds": 2.76,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.89,
      "end_seconds": 128.17,
      "duration_seconds": 2.28,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.66,
      "end_seconds": 140.64,
      "duration_seconds": 7.98,
      "text": "Atorvastatin, 20 milligrams, at night. Ah, before this I was on simvastatin; that's been stopped."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.18,
      "end_seconds": 146.12,
      "duration_seconds": 3.94,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.77,
      "end_seconds": 148.9,
      "duration_seconds": 2.13,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.87,
      "end_seconds": 153.51,
      "duration_seconds": 3.64,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.1,
      "end_seconds": 157.96,
      "duration_seconds": 2.86,
      "text": "High cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.81,
      "end_seconds": 170.29,
      "duration_seconds": 10.48,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today. Okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.02,
      "end_seconds": 174.12,
      "duration_seconds": 3.1,
      "text": "Actually, my mother had a stroke."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.28,
      "end_seconds": 177.93,
      "duration_seconds": 2.65,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.09,
      "end_seconds": 184.12,
      "duration_seconds": 5.03,
      "text": "I, I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.01,
      "end_seconds": 199.39,
      "duration_seconds": 2.38,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.25,
      "end_seconds": 213.73,
      "duration_seconds": 2.48,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.64,
      "end_seconds": 235.83,
      "duration_seconds": 12.19,
      "text": "Okay: SpO2 97 percent on room air, temperature is 36.4 degrees, heart rate 66. And respiratory rate 15, BP is 118 over 76."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.72,
      "end_seconds": 240.69,
      "duration_seconds": 2.97,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.65,
      "end_seconds": 243.63,
      "duration_seconds": 0.98,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.45,
      "end_seconds": 247.91,
      "duration_seconds": 2.46,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.07,
      "end_seconds": 260.41,
      "duration_seconds": 2.34,
      "text": "Your heart and lungs sound normal."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.86,
      "end_seconds": 274.94,
      "duration_seconds": 11.08,
      "text": "That's all I needed to check. So where does that leave us? My working impression is a healthy adult with no worrying findings."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.36,
      "end_seconds": 301.73,
      "duration_seconds": 17.37,
      "text": "I'm going to order a fasting sugar test, for routine check. I'd like to arrange a cholesterol blood test for routine check. Keep up regular exercise and a balanced diet. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.12,
      "end_seconds": 306.26,
      "duration_seconds": 3.14,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.07,
      "end_seconds": 308.29,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}