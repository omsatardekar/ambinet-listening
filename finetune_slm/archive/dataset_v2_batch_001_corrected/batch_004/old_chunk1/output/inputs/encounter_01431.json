{
  "schema_version": "1.0",
  "encounter_id": "01431",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 6.11,
      "duration_seconds": 4.77,
      "text": "Um, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.25,
      "end_seconds": 11.96,
      "duration_seconds": 4.71,
      "text": "So, come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.81,
      "end_seconds": 18.52,
      "duration_seconds": 5.71,
      "text": "Doctor, it's a runny nose. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.04,
      "end_seconds": 21.47,
      "duration_seconds": 2.43,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.2,
      "end_seconds": 29.05,
      "duration_seconds": 5.85,
      "text": "I'd say three days. Actually, no, closer to five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.02,
      "end_seconds": 33.01,
      "duration_seconds": 1.99,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.47,
      "end_seconds": 52.08,
      "duration_seconds": 17.61,
      "text": "Let me think, it usually comes with a mild cough. Right, you know, about mild cough, it happens once or twice a day. I've also had sneezing, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.07,
      "end_seconds": 59.92,
      "duration_seconds": 5.85,
      "text": "Okay, did you get ear pain, shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.98,
      "end_seconds": 66.64,
      "duration_seconds": 5.66,
      "text": "No ear pain, shortness of breath or chest pain, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.02,
      "end_seconds": 70.05,
      "duration_seconds": 2.03,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.14,
      "end_seconds": 74.2,
      "duration_seconds": 3.06,
      "text": "I, I haven't noticed any fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.2,
      "end_seconds": 78.16,
      "duration_seconds": 1.96,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.97,
      "end_seconds": 81.55,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.32,
      "end_seconds": 86.21,
      "duration_seconds": 3.89,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.9,
      "end_seconds": 92.43,
      "duration_seconds": 4.53,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.04,
      "end_seconds": 97.3,
      "duration_seconds": 4.26,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.95,
      "end_seconds": 102.37,
      "duration_seconds": 3.42,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.17,
      "end_seconds": 106.52,
      "duration_seconds": 3.35,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.86,
      "end_seconds": 126.03,
      "duration_seconds": 18.17,
      "text": "I used to drink heavily but I stopped four years ago. No, I've never smoked in my life. I'm a plumber, lots of bending and kneeling. I walk the dog every morning. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.62,
      "end_seconds": 143.36,
      "duration_seconds": 3.74,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.18,
      "end_seconds": 146.97,
      "duration_seconds": 1.79,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.75,
      "end_seconds": 156.66,
      "duration_seconds": 4.91,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.71,
      "end_seconds": 165.56,
      "duration_seconds": 7.85,
      "text": "I take throat lozenges, when needed. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.97,
      "end_seconds": 169.72,
      "duration_seconds": 3.75,
      "text": "Ah. Alright, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.71,
      "end_seconds": 185.89,
      "duration_seconds": 2.18,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.78,
      "end_seconds": 221.4,
      "duration_seconds": 14.62,
      "text": "Okay: respiratory rate 15, BMI works out to 28.2, pulse is 78 beats a minute, BP is 122 over 72, temp 36.5 degrees, weight 66 kilos, height 153 centimetres."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.29,
      "end_seconds": 223.93,
      "duration_seconds": 1.64,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.54,
      "end_seconds": 228.17,
      "duration_seconds": 2.63,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.19,
      "end_seconds": 232.48,
      "duration_seconds": 3.29,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.35,
      "end_seconds": 235.55,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.33,
      "end_seconds": 258.64,
      "duration_seconds": 4.31,
      "text": "Your throat is a little red and your chest is clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.85,
      "end_seconds": 264.48,
      "duration_seconds": 1.63,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 285.62,
      "duration_seconds": 5.67,
      "text": "Right, here's what I'm thinking. I'd lean towards a simple viral cold."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.77,
      "end_seconds": 289.81,
      "duration_seconds": 3.04,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.36,
      "end_seconds": 297.33,
      "duration_seconds": 6.97,
      "text": "Nothing I've seen today points to an emergency. It looks like a simple viral cold."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.76,
      "end_seconds": 317.65,
      "duration_seconds": 6.89,
      "text": "Rest, plenty of fluids, and paracetamol if you ache. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.71,
      "end_seconds": 323.64,
      "duration_seconds": 3.93,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}