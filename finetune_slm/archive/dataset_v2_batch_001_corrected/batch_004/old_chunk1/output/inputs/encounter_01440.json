{
  "schema_version": "1.0",
  "encounter_id": "01440",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.86,
      "end_seconds": 4.17,
      "duration_seconds": 3.31,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.41,
      "end_seconds": 10.82,
      "duration_seconds": 5.41,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.11,
      "end_seconds": 13.82,
      "duration_seconds": 1.71,
      "text": "Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.34,
      "end_seconds": 18.9,
      "duration_seconds": 4.56,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.2,
      "end_seconds": 23.13,
      "duration_seconds": 2.93,
      "text": "Okay, what do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.83,
      "end_seconds": 31.42,
      "duration_seconds": 6.59,
      "text": "Honestly, it's skipped beats, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.97,
      "end_seconds": 33.36,
      "duration_seconds": 1.39,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.22,
      "end_seconds": 44.32,
      "duration_seconds": 10.1,
      "text": "It's been like this since yesterday. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.84,
      "end_seconds": 51.01,
      "duration_seconds": 6.17,
      "text": "Sure. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.82,
      "end_seconds": 65.58,
      "duration_seconds": 12.76,
      "text": "I notice it more with caffeine and lying down. About a five out of ten. And being a bit anxious, too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.16,
      "end_seconds": 67.48,
      "duration_seconds": 1.32,
      "text": "Any chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.86,
      "end_seconds": 72.42,
      "duration_seconds": 3.56,
      "text": "No, I haven't had any chest pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.0,
      "end_seconds": 82.85,
      "duration_seconds": 5.85,
      "text": "Let me check a few things. Any fainting, dizziness or shortness of breath?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.31,
      "end_seconds": 90.5,
      "duration_seconds": 6.19,
      "text": "No fainting, dizziness or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.63,
      "end_seconds": 93.82,
      "duration_seconds": 2.19,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.75,
      "end_seconds": 98.24,
      "duration_seconds": 2.49,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.46,
      "end_seconds": 102.81,
      "duration_seconds": 2.35,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.59,
      "end_seconds": 106.19,
      "duration_seconds": 1.6,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.12,
      "end_seconds": 109.93,
      "duration_seconds": 2.81,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.84,
      "end_seconds": 115.31,
      "duration_seconds": 3.47,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.51,
      "end_seconds": 118.3,
      "duration_seconds": 1.79,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.49,
      "end_seconds": 123.95,
      "duration_seconds": 4.46,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.55,
      "end_seconds": 126.71,
      "duration_seconds": 2.16,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.48,
      "end_seconds": 143.54,
      "duration_seconds": 16.06,
      "text": "Depression, for about ten years. I've been putting this off for weeks. I have eczema, for about ten years. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.27,
      "end_seconds": 155.37,
      "duration_seconds": 10.1,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.32,
      "end_seconds": 159.88,
      "duration_seconds": 2.56,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.45,
      "end_seconds": 162.86,
      "duration_seconds": 2.41,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.47,
      "end_seconds": 175.72,
      "duration_seconds": 12.25,
      "text": "Fluoxetine, 20 milligrams, every morning. I'm on hydrocortisone cream, when needed for the eczema. Herbal calming tea, in the evening."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.41,
      "end_seconds": 179.63,
      "duration_seconds": 3.22,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.85,
      "end_seconds": 189.37,
      "duration_seconds": 2.52,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.69,
      "end_seconds": 207.72,
      "duration_seconds": 8.03,
      "text": "Okay: oxygen saturation is 97 percent, pulse 72. And BP is 109 over 81, respiratory rate 18."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.16,
      "end_seconds": 210.81,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.46,
      "end_seconds": 214.6,
      "duration_seconds": 2.14,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.56,
      "end_seconds": 222.74,
      "duration_seconds": 5.18,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.66,
      "end_seconds": 225.86,
      "duration_seconds": 1.2,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.34,
      "end_seconds": 243.14,
      "duration_seconds": 4.8,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.26,
      "end_seconds": 249.08,
      "duration_seconds": 1.82,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.11,
      "end_seconds": 276.01,
      "duration_seconds": 17.9,
      "text": "Putting it all together, my working impression is harmless extra heartbeats. I can't rule out an anxiety-related palpitation yet. Let me repeat that back to make sure. You've had skipped beats, since yesterday, and no fainting or dizziness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.54,
      "end_seconds": 278.16,
      "duration_seconds": 1.62,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.21,
      "end_seconds": 328.35,
      "duration_seconds": 32.14,
      "text": "We should do an ECG for palpitations. Cut back on coffee and energy drinks and keep a diary of when it happens. Cut down on salt and fried food for now, it really does make a difference. If you faint or have chest pain, or you feel really unwell, please come to the emergency department. I'd like you back if it carries on after a month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.81,
      "end_seconds": 333.85,
      "duration_seconds": 4.04,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.41,
      "end_seconds": 336.66,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}