{
  "schema_version": "1.0",
  "encounter_id": "01025",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 4.6,
      "duration_seconds": 3.3,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.44,
      "end_seconds": 9.95,
      "duration_seconds": 4.51,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.33,
      "end_seconds": 19.3,
      "duration_seconds": 7.97,
      "text": "Right, it's a dry cough in the evenings. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.27,
      "end_seconds": 26.29,
      "duration_seconds": 2.02,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.06,
      "end_seconds": 29.11,
      "duration_seconds": 1.05,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.39,
      "end_seconds": 44.37,
      "duration_seconds": 2.98,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.21,
      "end_seconds": 47.76,
      "duration_seconds": 2.55,
      "text": "Ever since... since Friday, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.76,
      "end_seconds": 58.45,
      "duration_seconds": 8.69,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.93,
      "end_seconds": 67.79,
      "duration_seconds": 7.86,
      "text": "It happens a few times a day. Maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.81,
      "end_seconds": 71.45,
      "duration_seconds": 2.64,
      "text": "Any wheeze or fever at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.8,
      "end_seconds": 76.06,
      "duration_seconds": 3.26,
      "text": "No wheeze or fever, none of it."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.55,
      "end_seconds": 79.93,
      "duration_seconds": 2.38,
      "text": "What about shortness of breath?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.99,
      "end_seconds": 83.95,
      "duration_seconds": 2.96,
      "text": "Nope, no shortness of breath."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.48,
      "end_seconds": 86.92,
      "duration_seconds": 1.44,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.07,
      "end_seconds": 95.5,
      "duration_seconds": 2.43,
      "text": "Actually, no weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.91,
      "end_seconds": 102.26,
      "duration_seconds": 4.35,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.97,
      "end_seconds": 104.41,
      "duration_seconds": 1.44,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.77,
      "end_seconds": 119.53,
      "duration_seconds": 2.76,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.5,
      "end_seconds": 124.83,
      "duration_seconds": 4.33,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.9,
      "end_seconds": 127.61,
      "duration_seconds": 1.71,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.22,
      "end_seconds": 130.81,
      "duration_seconds": 2.59,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.08,
      "end_seconds": 136.63,
      "duration_seconds": 4.55,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.63,
      "end_seconds": 139.19,
      "duration_seconds": 1.56,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.37,
      "end_seconds": 158.83,
      "duration_seconds": 2.46,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.14,
      "end_seconds": 170.2,
      "duration_seconds": 2.06,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.7,
      "end_seconds": 198.26,
      "duration_seconds": 9.56,
      "text": "Okay: pressure 113 over 79, respiratory rate 16, temp 36.8 degrees. And heart rate 85, saturation 99 percent."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.82,
      "end_seconds": 201.28,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.04,
      "end_seconds": 205.43,
      "duration_seconds": 2.39,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.95,
      "end_seconds": 210.41,
      "duration_seconds": 2.46,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.95,
      "end_seconds": 214.42,
      "duration_seconds": 2.47,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.16,
      "end_seconds": 229.2,
      "duration_seconds": 5.04,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.51,
      "end_seconds": 234.11,
      "duration_seconds": 2.6,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.64,
      "end_seconds": 273.31,
      "duration_seconds": 31.67,
      "text": "Okay, so my impression is this: My working impression is seasonal hay fever causing the cough. You'll be taking fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever. Keep windows closed on high-pollen days and wash your hair at night. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.22,
      "end_seconds": 279.47,
      "duration_seconds": 5.25,
      "text": "One warning sign to remember: you start wheezing. In that case don't wait."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.48,
      "end_seconds": 283.1,
      "duration_seconds": 1.62,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.32,
      "end_seconds": 290.72,
      "duration_seconds": 6.4,
      "text": "I'll want another look in a month. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.41,
      "end_seconds": 297.97,
      "duration_seconds": 3.56,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.25,
      "end_seconds": 300.51,
      "duration_seconds": 1.26,
      "text": "All the best."
    }
  ]
}