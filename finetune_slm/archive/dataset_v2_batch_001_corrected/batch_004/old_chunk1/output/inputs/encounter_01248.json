{
  "schema_version": "1.0",
  "encounter_id": "01248",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.58,
      "end_seconds": 6.42,
      "duration_seconds": 5.84,
      "text": "doctor, this one's ready for you everything's on the chart, but I'll go through it"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.11,
      "end_seconds": 11.54,
      "duration_seconds": 3.43,
      "text": "thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.51,
      "end_seconds": 19.08,
      "duration_seconds": 6.57,
      "text": "honestly, it's severe lower back pain, and my family pushed me to come"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.48,
      "end_seconds": 26.56,
      "duration_seconds": 2.08,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 29.94,
      "end_seconds": 31.99,
      "duration_seconds": 2.05,
      "text": "it, It started yesterday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.11,
      "end_seconds": 38.63,
      "duration_seconds": 5.52,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 40.12,
      "end_seconds": 44.17,
      "duration_seconds": 4.05,
      "text": "I'd say moderate. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.76,
      "end_seconds": 51.13,
      "duration_seconds": 3.37,
      "text": "has there been numbness between your legs too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 52.17,
      "end_seconds": 85.75,
      "duration_seconds": 33.58,
      "text": "yeah. About two weeks, um, I'd say with numbness between my legs, I'd say severe it's once or twice a day oh, and weakness in both legs had that since this morning with weakness in both legs, I'd call it severe as for trouble passing urine, I honestly can't say when that began it might have been last month or the month before"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 86.32,
      "end_seconds": 97.08,
      "duration_seconds": 10.76,
      "text": "Doctor, I've got the readings for you. SpO2 97 percent on room air, temp 36.9 degrees, pressure 117 over 73, heart rate 85."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.75,
      "end_seconds": 99.25,
      "duration_seconds": 1.5,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.36,
      "end_seconds": 105.72,
      "duration_seconds": 5.36,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.57,
      "end_seconds": 108.66,
      "duration_seconds": 1.09,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.15,
      "end_seconds": 112.24,
      "duration_seconds": 2.09,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.27,
      "end_seconds": 132.46,
      "duration_seconds": 5.19,
      "text": "You have numbness in the saddle area and your leg strength is reduced."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.96,
      "end_seconds": 141.08,
      "duration_seconds": 5.12,
      "text": "good, you can sit up again any recent fall or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 142.13,
      "end_seconds": 147.31,
      "duration_seconds": 5.18,
      "text": "no recent fall or fever, none of it it"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.14,
      "end_seconds": 151.32,
      "duration_seconds": 2.18,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.15,
      "end_seconds": 157.53,
      "duration_seconds": 2.38,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.43,
      "end_seconds": 163.8,
      "duration_seconds": 4.37,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.43,
      "end_seconds": 173.08,
      "duration_seconds": 7.65,
      "text": "Amoxicillin. I come out in... well, hives. Diclofenac. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.97,
      "end_seconds": 185.24,
      "duration_seconds": 3.27,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 186.9,
      "end_seconds": 188.86,
      "duration_seconds": 1.96,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.91,
      "end_seconds": 198.7,
      "duration_seconds": 2.79,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.77,
      "end_seconds": 202.7,
      "duration_seconds": 2.93,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.49,
      "end_seconds": 206.34,
      "duration_seconds": 1.85,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 208.2,
      "end_seconds": 214.02,
      "duration_seconds": 5.82,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.22,
      "end_seconds": 218.44,
      "duration_seconds": 1.22,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.07,
      "end_seconds": 222.28,
      "duration_seconds": 3.21,
      "text": "I gave up cigarettes last spring"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.5,
      "end_seconds": 225.14,
      "duration_seconds": 1.64,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.0,
      "end_seconds": 230.25,
      "duration_seconds": 4.25,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.34,
      "end_seconds": 234.7,
      "duration_seconds": 2.36,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 235.72,
      "end_seconds": 240.06,
      "duration_seconds": 4.34,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.07,
      "end_seconds": 244.18,
      "duration_seconds": 3.11,
      "text": "Alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.79,
      "end_seconds": 252.39,
      "duration_seconds": 6.6,
      "text": "It's something called omep... omeprazole, 20 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.15,
      "end_seconds": 258.68,
      "duration_seconds": 4.53,
      "text": "Did you happen to to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 260.63,
      "end_seconds": 265.78,
      "duration_seconds": 5.15,
      "text": "Ah, not with me. I'll bring it it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.96,
      "end_seconds": 270.82,
      "duration_seconds": 3.86,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.81,
      "end_seconds": 273.85,
      "duration_seconds": 2.04,
      "text": "I have acid reflux."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.39,
      "end_seconds": 299.84,
      "duration_seconds": 11.45,
      "text": "so where does that leave us? My working impression is possible cauda equina syndrome needing an urgent scan i can't rule out a large disc prolapse yet"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 301.16,
      "end_seconds": 303.78,
      "duration_seconds": 2.62,
      "text": "is it it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.89,
      "end_seconds": 321.66,
      "duration_seconds": 16.77,
      "text": "I understand the worry. At the moment I'd say it's possible cauda equina syndrome needing an urgent scan, and we'll watch how it goes. You need to go to hospital now for an emergency scan."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.09,
      "end_seconds": 332.41,
      "duration_seconds": 10.32,
      "text": "Mm, okay. And please bring the latest prescription or the medicine boxes to the next visit, so so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.18,
      "end_seconds": 336.1,
      "duration_seconds": 1.92,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.14,
      "end_seconds": 339.59,
      "duration_seconds": 2.45,
      "text": "We'll catch up straight away."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 341.34,
      "end_seconds": 343.11,
      "duration_seconds": 1.77,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.15,
      "end_seconds": 348.1,
      "duration_seconds": 2.95,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 349.99,
      "end_seconds": 352.18,
      "duration_seconds": 2.19,
      "text": "Thank you, doctor, goodbye."
    }
  ]
