{
  "schema_version": "1.0",
  "encounter_id": "01254",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 6.05,
      "duration_seconds": 5.53,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.93,
      "end_seconds": 12.95,
      "duration_seconds": 5.02,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.56,
      "end_seconds": 17.89,
      "duration_seconds": 4.33,
      "text": "Yeah, it's vomiting. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.65,
      "end_seconds": 22.47,
      "duration_seconds": 1.82,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.49,
      "end_seconds": 28.95,
      "duration_seconds": 3.46,
      "text": "it's been going on for two months"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.63,
      "end_seconds": 39.21,
      "duration_seconds": 9.58,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.94,
      "end_seconds": 65.52,
      "duration_seconds": 24.58,
      "text": "I'd give it a five, out of ten. It's a couple of times a week. Okay, so I've been passing a lot of urine too, for three days. And deep fast breathing, too. As for deep fast breathing, it's severe, honestly. I, I had tummy pain before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.71,
      "end_seconds": 71.61,
      "duration_seconds": 4.9,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.35,
      "end_seconds": 83.57,
      "duration_seconds": 11.22,
      "text": "I hardly move around during the day. I retired from the post office two years ago. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.44,
      "end_seconds": 91.52,
      "duration_seconds": 4.08,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.33,
      "end_seconds": 94.81,
      "duration_seconds": 2.48,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 99.85,
      "duration_seconds": 3.36,
      "text": "Okay, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.6,
      "end_seconds": 104.31,
      "duration_seconds": 3.71,
      "text": "just a bunion operation, six years ago"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.08,
      "end_seconds": 109.23,
      "duration_seconds": 4.15,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.32,
      "end_seconds": 118.13,
      "duration_seconds": 6.81,
      "text": "My uncle has high cholesterol. Hmm, my mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.21,
      "end_seconds": 121.76,
      "duration_seconds": 2.55,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.48,
      "end_seconds": 126.85,
      "duration_seconds": 4.37,
      "text": "I've got diabetes. Heart failure, for about a year."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.41,
      "end_seconds": 128.34,
      "duration_seconds": 0.93,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.78,
      "end_seconds": 135.09,
      "duration_seconds": 5.31,
      "text": "Low haemoglobin, for five years. I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.32,
      "end_seconds": 147.51,
      "duration_seconds": 8.19,
      "text": "yes, heart failure is known to us, good to have that clear do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.97,
      "end_seconds": 165.2,
      "duration_seconds": 16.23,
      "text": "Glimepiride. I take it 2 milligrams, before breakfast. I take furosemide, 40 milligrams, every morning. Iron tablets, once a day. I take alendronate, 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.28,
      "end_seconds": 170.14,
      "duration_seconds": 2.86,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.91,
      "end_seconds": 174.71,
      "duration_seconds": 3.8,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.38,
      "end_seconds": 178.3,
      "duration_seconds": 2.92,
      "text": "and what about cough or chest pain?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.93,
      "end_seconds": 182.83,
      "duration_seconds": 2.9,
      "text": "No, no cough or chest pain."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.79,
      "end_seconds": 187.16,
      "duration_seconds": 2.37,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.32,
      "end_seconds": 189.44,
      "duration_seconds": 1.12,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.79,
      "end_seconds": 204.92,
      "duration_seconds": 3.13,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.4,
      "end_seconds": 217.0,
      "duration_seconds": 2.6,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.77,
      "end_seconds": 253.95,
      "duration_seconds": 17.18,
      "text": "okay: temp 36.6 degrees, blood pressure 115 over 75, height 167 centimetres. And weight 76 kilos, oxygen saturation is 99 percent, pulse is 107 beats a minute, BMI works out to 27.3."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.81,
      "end_seconds": 257.05,
      "duration_seconds": 2.24,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.46,
      "end_seconds": 260.61,
      "duration_seconds": 2.15,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.7,
      "end_seconds": 266.6,
      "duration_seconds": 4.9,
      "text": "Now I'm going to do a a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.69,
      "end_seconds": 283.24,
      "duration_seconds": 1.55,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.9,
      "end_seconds": 286.14,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.96,
      "end_seconds": 298.62,
      "duration_seconds": 4.66,
      "text": "You are dry, breathing deeply and your breath smells fruity."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.32,
      "end_seconds": 300.36,
      "duration_seconds": 1.04,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.82,
      "end_seconds": 305.53,
      "duration_seconds": 1.71,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.84,
      "end_seconds": 330.75,
      "duration_seconds": 15.91,
      "text": "Having listened and examined, I think we're dealing with diabetic ketoacidosis at this stage. The reason I say that is that your story and my examination fit together. I'd also keep a severe infection in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.05,
      "end_seconds": 338.1,
      "duration_seconds": 3.05,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.14,
      "end_seconds": 368.99,
      "duration_seconds": 29.85,
      "text": "nothing I've seen today points to an emergency it looks like diabetic ketoacidosis, but I'd like to confirm i want blood gas and electrolytes done, that's for DKA we should do a blood sugar and ketone test for thirst and vomiting you need to go to hospital now for insulin and fluids and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.67,
      "end_seconds": 372.49,
      "duration_seconds": 1.82,
      "text": "yes, will do"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.73,
      "end_seconds": 382.15,
      "duration_seconds": 8.42,
      "text": "Book a review straight away. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.78,
      "end_seconds": 388.26,
      "duration_seconds": 4.48,
      "text": "So, I come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.45,
      "end_seconds": 396.2,
      "duration_seconds": 6.75,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.24,
      "end_seconds": 401.31,
      "duration_seconds": 4.07,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}