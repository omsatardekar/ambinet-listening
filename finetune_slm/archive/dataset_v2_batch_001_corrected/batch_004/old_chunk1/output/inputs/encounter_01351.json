{
  "schema_version": "1.0",
  "encounter_id": "01351",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 7.33,
      "duration_seconds": 6.68,
      "text": "Sorry, what was I saying, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.07,
      "end_seconds": 12.78,
      "duration_seconds": 3.71,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.64,
      "end_seconds": 19.69,
      "duration_seconds": 5.05,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.58,
      "end_seconds": 23.73,
      "duration_seconds": 3.15,
      "text": "alright, absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.96,
      "end_seconds": 35.33,
      "duration_seconds": 7.37,
      "text": "Let me think, so the thing is, I've got crushing chest pain."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.59,
      "end_seconds": 39.45,
      "duration_seconds": 2.86,
      "text": "So, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.86,
      "end_seconds": 44.61,
      "duration_seconds": 3.75,
      "text": "I, I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 46.0,
      "end_seconds": 50.06,
      "duration_seconds": 4.06,
      "text": "It was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.7,
      "end_seconds": 55.8,
      "duration_seconds": 4.1,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.22,
      "end_seconds": 60.26,
      "duration_seconds": 3.04,
      "text": "Yes, uh, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.25,
      "end_seconds": 70.31,
      "duration_seconds": 9.06,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.69,
      "end_seconds": 78.37,
      "duration_seconds": 6.68,
      "text": "um, it's a few times a day. It feels mild to me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.95,
      "end_seconds": 83.29,
      "duration_seconds": 4.34,
      "text": "Has there been pain going into your left arm too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.19,
      "end_seconds": 112.83,
      "duration_seconds": 27.64,
      "text": "Yes, about the same, two days. Um, as for pain going into my left arm, a five out of ten, I suppose. Okay, so I've been sweating too. Okay, so with sweating, I'd say a couple of times a week. Hmm, and I've been feeling sick as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.32,
      "end_seconds": 119.95,
      "duration_seconds": 5.63,
      "text": "Have you had crushing chest pain before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.81,
      "end_seconds": 129.27,
      "duration_seconds": 7.46,
      "text": "Hmm, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.82,
      "end_seconds": 133.83,
      "duration_seconds": 3.01,
      "text": "any fever, cough or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.53,
      "end_seconds": 140.52,
      "duration_seconds": 4.99,
      "text": "No fever, cough or leg swelling, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.15,
      "end_seconds": 144.31,
      "duration_seconds": 2.16,
      "text": "Okay, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.82,
      "end_seconds": 147.89,
      "duration_seconds": 2.07,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.85,
      "end_seconds": 151.14,
      "duration_seconds": 2.29,
      "text": "anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.02,
      "end_seconds": 156.09,
      "duration_seconds": 3.07,
      "text": "well, no, that's all fine"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.5,
      "end_seconds": 163.1,
      "duration_seconds": 2.6,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.49,
      "end_seconds": 169.56,
      "duration_seconds": 5.07,
      "text": "no, um, nothing as far as I know"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.44,
      "end_seconds": 172.38,
      "duration_seconds": 1.94,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.57,
      "end_seconds": 183.73,
      "duration_seconds": 10.16,
      "text": "It's metoprolol, 50 milligrams, twice a day for my pressure. I take Seretide inhaler, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.18,
      "end_seconds": 199.04,
      "duration_seconds": 2.86,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.82,
      "end_seconds": 204.27,
      "duration_seconds": 4.45,
      "text": "I had my septum straightened in my thirties"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.05,
      "end_seconds": 208.23,
      "duration_seconds": 3.18,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.81,
      "end_seconds": 214.86,
      "duration_seconds": 5.05,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.89,
      "end_seconds": 217.26,
      "duration_seconds": 1.37,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.19,
      "end_seconds": 222.32,
      "duration_seconds": 3.13,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.24,
      "end_seconds": 228.29,
      "duration_seconds": 4.05,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.44,
      "end_seconds": 236.02,
      "duration_seconds": 6.58,
      "text": "I've got high blood pressure yes, high cholesterol i've got asthma"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.82,
      "end_seconds": 242.67,
      "duration_seconds": 5.85,
      "text": "Sure. Yes, high cholesterol is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.05,
      "end_seconds": 259.07,
      "duration_seconds": 2.02,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.31,
      "end_seconds": 270.86,
      "duration_seconds": 2.55,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.04,
      "end_seconds": 301.91,
      "duration_seconds": 11.87,
      "text": "okay: height 179 centimetres, weight 69 kilos, BMI works out to 21.5. And temperature 36.8, pressure 122 over 74, heart rate 126."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.4,
      "end_seconds": 305.57,
      "duration_seconds": 2.17,
      "text": "is that that okay?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.27,
      "end_seconds": 310.15,
      "duration_seconds": 2.88,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.75,
      "end_seconds": 316.02,
      "duration_seconds": 4.27,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.28,
      "end_seconds": 318.9,
      "duration_seconds": 1.62,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.61,
      "end_seconds": 331.98,
      "duration_seconds": 4.37,
      "text": "you are pale and sweaty, and your pulse is fast"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.82,
      "end_seconds": 338.72,
      "duration_seconds": 2.9,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.06,
      "end_seconds": 381.67,
      "duration_seconds": 25.61,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be a possible heart attack, or it might be unstable angina. A troponin blood test is what I'd like next, for chest pain. The result will help us decide whether anything more is needed. An ECG is what I'd like next, for chest pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.75,
      "end_seconds": 386.06,
      "duration_seconds": 2.31,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.12,
      "end_seconds": 396.18,
      "duration_seconds": 9.06,
      "text": "you'll be taking aspirin, 300 milligrams, once now, single dose you take it by mouth it's for possible heart attack"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.15,
      "end_seconds": 403.15,
      "duration_seconds": 5.0,
      "text": "uh, can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.34,
      "end_seconds": 411.11,
      "duration_seconds": 6.77,
      "text": "stay lying down and do not eat or drink. We'll refer you to the cardiac team"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 412.62,
      "end_seconds": 414.25,
      "duration_seconds": 1.63,
      "text": "alright, thank you"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.39,
      "end_seconds": 427.37,
      "duration_seconds": 11.98,
      "text": "One warning sign to remember: the pain returns. In that case don't wait. We'll catch up straight away. Okay, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.03,
      "end_seconds": 436.99,
      "duration_seconds": 8.96,
      "text": "so, I take the aspirin, 300 milligrams, once now and come back straight away is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.85,
      "end_seconds": 442.92,
      "duration_seconds": 4.07,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 443.8,
      "end_seconds": 447.99,
      "duration_seconds": 4.19,
      "text": "Hmm, um, thank you, that's helpful."
    }
  ]
}