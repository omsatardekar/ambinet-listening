{
  "schema_version": "1.0",
  "encounter_id": "01323",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.61,
      "duration_seconds": 4.4,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 10.92,
      "duration_seconds": 3.92,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.2,
      "end_seconds": 17.46,
      "duration_seconds": 5.26,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.32,
      "end_seconds": 25.05,
      "duration_seconds": 2.73,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.43,
      "end_seconds": 37.02,
      "duration_seconds": 10.59,
      "text": "It's bloating after meals, mostly. I've never really been one for hospitals. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.95,
      "end_seconds": 40.15,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.02,
      "end_seconds": 46.2,
      "duration_seconds": 5.18,
      "text": "Around five days... no wait, it's more like about four days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.12,
      "end_seconds": 61.55,
      "duration_seconds": 10.43,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.66,
      "end_seconds": 78.95,
      "duration_seconds": 16.29,
      "text": "Only walking, and it's not much. Moderate, I'd say. I've, I've also had a lot of wind, for three days. Loose stools now and then was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.95,
      "end_seconds": 85.39,
      "duration_seconds": 5.44,
      "text": "Okay, have you had any vomiting or blood in the stool?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.17,
      "end_seconds": 90.2,
      "duration_seconds": 4.03,
      "text": "No, no vomiting or blood in the stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.89,
      "end_seconds": 93.57,
      "duration_seconds": 2.68,
      "text": "Any night-time diarrhoea or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.88,
      "end_seconds": 97.42,
      "duration_seconds": 2.54,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.51,
      "end_seconds": 103.45,
      "duration_seconds": 4.94,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.96,
      "end_seconds": 108.18,
      "duration_seconds": 3.22,
      "text": "I mean, no weakness or anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.81,
      "end_seconds": 110.63,
      "duration_seconds": 1.82,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.57,
      "end_seconds": 113.49,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 126.44,
      "duration_seconds": 3.0,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.38,
      "end_seconds": 135.09,
      "duration_seconds": 7.71,
      "text": "Yes, you know, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.2,
      "end_seconds": 141.2,
      "duration_seconds": 5.0,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.52,
      "end_seconds": 146.55,
      "duration_seconds": 4.03,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.55,
      "end_seconds": 151.72,
      "duration_seconds": 3.17,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.43,
      "end_seconds": 159.11,
      "duration_seconds": 5.68,
      "text": "My daughter has type 1 diabetes. Right, my son has asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 163.04,
      "duration_seconds": 2.64,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.57,
      "end_seconds": 179.35,
      "duration_seconds": 14.78,
      "text": "Anxiety, for nearly five years. My family kept telling me to get it checked. I told myself I'd wait and see, and here I am. I have acid reflux."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.69,
      "end_seconds": 182.67,
      "duration_seconds": 1.98,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.21,
      "end_seconds": 184.7,
      "duration_seconds": 1.49,
      "text": "I've got migraines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.23,
      "end_seconds": 190.84,
      "duration_seconds": 4.61,
      "text": "Alright, anxiety and migraines, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.01,
      "end_seconds": 202.39,
      "duration_seconds": 2.38,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.15,
      "end_seconds": 212.13,
      "duration_seconds": 8.98,
      "text": "Escitalopram. I take it 10 milligrams, once a day. Lansoprazole, 30 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.43,
      "end_seconds": 218.15,
      "duration_seconds": 4.72,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.89,
      "end_seconds": 224.4,
      "duration_seconds": 4.51,
      "text": "No, it's at home. I take sumatriptan, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 228.13,
      "duration_seconds": 2.24,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.2,
      "end_seconds": 252.41,
      "duration_seconds": 19.21,
      "text": "It's 50 milligrams. It's peppermint capsules, after meals. I kept putting it off, which I know isn't sensible. I wasn't sure whether to come in at all, to be honest. I'd been on omeprazole, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.43,
      "end_seconds": 256.33,
      "duration_seconds": 2.9,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.02,
      "end_seconds": 261.0,
      "duration_seconds": 3.98,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.33,
      "end_seconds": 265.76,
      "duration_seconds": 1.43,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.91,
      "end_seconds": 270.26,
      "duration_seconds": 3.35,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.96,
      "end_seconds": 291.86,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.91,
      "end_seconds": 301.96,
      "duration_seconds": 3.05,
      "text": "Right, sit still for a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.02,
      "end_seconds": 318.96,
      "duration_seconds": 7.94,
      "text": "Okay: saturation 98 percent, pressure 113 over 82, temperature is 36.7 degrees. And pulse 83."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.64,
      "end_seconds": 324.94,
      "duration_seconds": 4.3,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.86,
      "end_seconds": 328.1,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.49,
      "end_seconds": 346.28,
      "duration_seconds": 5.79,
      "text": "Your tummy is soft and not tender, and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.85,
      "end_seconds": 380.25,
      "duration_seconds": 28.4,
      "text": "You can sit up now. Having listened and examined, the most likely explanation is a functional bowel pattern, with no alarm features. Irritable bowel syndrome is still possible. Try smaller meals and keep a food and symptom diary for four weeks. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in six weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.32,
      "end_seconds": 383.02,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.09,
      "end_seconds": 388.63,
      "duration_seconds": 2.54,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.23,
      "end_seconds": 394.24,
      "duration_seconds": 4.01,
      "text": "Erm, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.29,
      "end_seconds": 397.06,
      "duration_seconds": 1.77,
      "text": "Have a good day."
    }
  ]
}