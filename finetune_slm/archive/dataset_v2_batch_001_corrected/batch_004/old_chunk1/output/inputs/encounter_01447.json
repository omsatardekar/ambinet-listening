{
  "schema_version": "1.0",
  "encounter_id": "01447",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 7.43,
      "duration_seconds": 6.63,
      "text": "hello, take a seat, I'll be with you in a second. Okay, what's been worrying you?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.01,
      "end_seconds": 11.65,
      "duration_seconds": 3.64,
      "text": "I'm here because of a blocked ear."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.74,
      "end_seconds": 21.79,
      "duration_seconds": 9.05,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.79,
      "end_seconds": 28.29,
      "duration_seconds": 4.5,
      "text": "Showering definitely sets it off. It's mild, honestly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.21,
      "end_seconds": 32.17,
      "duration_seconds": 2.96,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.97,
      "end_seconds": 50.84,
      "duration_seconds": 17.87,
      "text": "I mean, when it starts I tend to get a feeling of fullness as well. The, The feeling of fullness? That's been for three weeks. Well, as for feeling of fullness, moderate, really"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.57,
      "end_seconds": 55.03,
      "duration_seconds": 3.46,
      "text": "have you noticed ringing, ear pain or dizziness?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.01,
      "end_seconds": 61.19,
      "duration_seconds": 4.18,
      "text": "Ah, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.47,
      "end_seconds": 67.43,
      "duration_seconds": 1.96,
      "text": "Did you notice any discharge?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.2,
      "end_seconds": 71.29,
      "duration_seconds": 3.09,
      "text": "No, I haven't had any discharge."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.52,
      "end_seconds": 76.09,
      "duration_seconds": 3.57,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.3,
      "end_seconds": 79.01,
      "duration_seconds": 1.71,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.76,
      "end_seconds": 83.25,
      "duration_seconds": 2.49,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.96,
      "end_seconds": 87.72,
      "duration_seconds": 3.76,
      "text": "Amoxicillin i come out in... well, hives"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.47,
      "end_seconds": 90.91,
      "duration_seconds": 1.44,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.66,
      "end_seconds": 97.36,
      "duration_seconds": 4.7,
      "text": "Let me think, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.09,
      "end_seconds": 116.45,
      "duration_seconds": 3.36,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.26,
      "end_seconds": 119.47,
      "duration_seconds": 2.21,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.87,
      "end_seconds": 124.82,
      "duration_seconds": 3.95,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.7,
      "end_seconds": 129.4,
      "duration_seconds": 3.7,
      "text": "Oh, no, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.95,
      "end_seconds": 134.95,
      "duration_seconds": 4.0,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.74,
      "end_seconds": 140.14,
      "duration_seconds": 4.4,
      "text": "Olive oil drops. I take it twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.76,
      "end_seconds": 145.75,
      "duration_seconds": 4.99,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.2,
      "end_seconds": 157.33,
      "duration_seconds": 10.13,
      "text": "I hardly move around during the day. I work in accounts at a hospital. My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.97,
      "end_seconds": 165.82,
      "duration_seconds": 2.85,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.8,
      "end_seconds": 181.3,
      "duration_seconds": 3.5,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.63,
      "end_seconds": 202.86,
      "duration_seconds": 8.23,
      "text": "Okay: temp 36.8 degrees, heart rate 81, blood pressure 127 over 77. And saturation 97 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.59,
      "end_seconds": 209.16,
      "duration_seconds": 3.57,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.8,
      "end_seconds": 213.21,
      "duration_seconds": 2.41,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.86,
      "end_seconds": 225.67,
      "duration_seconds": 4.81,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.91,
      "end_seconds": 232.46,
      "duration_seconds": 2.55,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.16,
      "end_seconds": 261.08,
      "duration_seconds": 11.92,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be earwax blocking the ear, or it might be a middle ear fluid."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.01,
      "end_seconds": 264.36,
      "duration_seconds": 2.35,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.76,
      "end_seconds": 278.34,
      "duration_seconds": 9.58,
      "text": "Nothing I've seen today points to an emergency. It looks like earwax blocking the ear, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.32,
      "end_seconds": 300.17,
      "duration_seconds": 9.85,
      "text": "Let's get ear irrigation, for wax. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 301.94,
      "end_seconds": 306.11,
      "duration_seconds": 4.17,
      "text": "We have a slot Wednesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.13,
      "end_seconds": 309.97,
      "duration_seconds": 2.84,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.09,
      "end_seconds": 324.27,
      "duration_seconds": 9.18,
      "text": "Use the olive oil drops for a week and then we'll syringe the ear. Book a review in one week."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.93,
      "end_seconds": 329.61,
      "duration_seconds": 3.68,
      "text": "well, um, I can manage that"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.2,
      "end_seconds": 333.62,
      "duration_seconds": 3.42,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.17,
      "end_seconds": 339.82,
      "duration_seconds": 4.65,
      "text": "uh, I think I understand everything thanks"
    }
  ]
}