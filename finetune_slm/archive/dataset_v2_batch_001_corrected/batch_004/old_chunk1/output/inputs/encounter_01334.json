{
  "schema_version": "1.0",
  "encounter_id": "01334",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 6.14,
      "duration_seconds": 5.35,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 11.41,
      "duration_seconds": 4.68,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 17.1,
      "duration_seconds": 4.44,
      "text": "I wanted to get skipped beats looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.62,
      "end_seconds": 21.08,
      "duration_seconds": 3.46,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.04,
      "end_seconds": 32.58,
      "duration_seconds": 9.54,
      "text": "I'd say mild. Oh, and a flutter in my chest. That's been about the same, two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.71,
      "end_seconds": 38.0,
      "duration_seconds": 4.29,
      "text": "What about being a bit anxious, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.78,
      "end_seconds": 40.0,
      "duration_seconds": 1.22,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.66,
      "end_seconds": 45.07,
      "duration_seconds": 3.41,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.4,
      "end_seconds": 56.29,
      "duration_seconds": 2.89,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.44,
      "end_seconds": 88.4,
      "duration_seconds": 11.96,
      "text": "Okay: temperature is 37.0 degrees, heart rate 83, respiratory rate 15. And blood pressure 122 over 80, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.69,
      "end_seconds": 91.12,
      "duration_seconds": 1.43,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.2,
      "end_seconds": 98.16,
      "duration_seconds": 2.96,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.17,
      "end_seconds": 103.46,
      "duration_seconds": 4.29,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.33,
      "end_seconds": 106.29,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.6,
      "end_seconds": 123.68,
      "duration_seconds": 4.08,
      "text": "Your pulse is regular and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.72,
      "end_seconds": 130.76,
      "duration_seconds": 3.04,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.71,
      "end_seconds": 145.13,
      "duration_seconds": 6.42,
      "text": "Let me check a few things. Any fainting, chest pain, dizziness or shortness of breath?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.85,
      "end_seconds": 148.23,
      "duration_seconds": 2.38,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.21,
      "end_seconds": 154.74,
      "duration_seconds": 5.53,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.32,
      "end_seconds": 157.62,
      "duration_seconds": 2.3,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.44,
      "end_seconds": 160.25,
      "duration_seconds": 1.81,
      "text": "Alright, what's your work?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.04,
      "end_seconds": 165.99,
      "duration_seconds": 3.95,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.02,
      "end_seconds": 169.17,
      "duration_seconds": 2.15,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.94,
      "end_seconds": 172.35,
      "duration_seconds": 2.41,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.47,
      "end_seconds": 193.3,
      "duration_seconds": 3.83,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.77,
      "end_seconds": 196.28,
      "duration_seconds": 1.51,
      "text": "Yes, low haemoglobin."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.23,
      "end_seconds": 214.74,
      "duration_seconds": 2.51,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.13,
      "end_seconds": 227.8,
      "duration_seconds": 11.67,
      "text": "I'm on iron tablets, once a day. Sorry, what was I saying, I'm on herbal calming tea, in the evening."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.86,
      "end_seconds": 232.6,
      "duration_seconds": 2.74,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.02,
      "end_seconds": 237.7,
      "duration_seconds": 3.68,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.91,
      "end_seconds": 243.87,
      "duration_seconds": 2.96,
      "text": "Alright, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.5,
      "end_seconds": 248.4,
      "duration_seconds": 3.9,
      "text": "I'm allergic to trimethoprim, I get a rash."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.01,
      "end_seconds": 262.6,
      "duration_seconds": 12.59,
      "text": "Putting it all together, this looks most like harmless extra heartbeats. I want to be honest that this is an impression, not a final answer. An anxiety-related palpitation is still possible."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.92,
      "end_seconds": 269.53,
      "duration_seconds": 3.61,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.33,
      "end_seconds": 294.88,
      "duration_seconds": 19.55,
      "text": "I understand the worry. At the moment I'd say it's harmless extra heartbeats, and we'll watch how it goes. Cut back on coffee and energy drinks and keep a diary of when it happens. Book a review if it carries on after a month. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.08,
      "end_seconds": 301.96,
      "duration_seconds": 2.88,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}