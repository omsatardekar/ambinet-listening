{
  "schema_version": "1.0",
  "encounter_id": "01120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 3.91,
      "duration_seconds": 2.9,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 9.22,
      "duration_seconds": 3.74,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.24,
      "end_seconds": 18.23,
      "duration_seconds": 7.99,
      "text": "Erm, it's my face drooping on one side. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.68,
      "end_seconds": 21.65,
      "duration_seconds": 1.97,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.64,
      "end_seconds": 27.13,
      "duration_seconds": 4.49,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.85,
      "end_seconds": 31.57,
      "duration_seconds": 3.72,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.58,
      "end_seconds": 42.61,
      "duration_seconds": 9.03,
      "text": "It's moderate, honestly. Oh, and weakness in my right arm. That's been about the same, about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.21,
      "end_seconds": 48.67,
      "duration_seconds": 2.46,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.6,
      "end_seconds": 58.9,
      "duration_seconds": 3.3,
      "text": "Okay, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.59,
      "end_seconds": 83.46,
      "duration_seconds": 8.87,
      "text": "Okay: temperature 36.6, heart rate 94, SpO2 99 percent on room air. And BP is 164 over 96."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.43,
      "end_seconds": 85.84,
      "duration_seconds": 1.41,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.81,
      "end_seconds": 89.96,
      "duration_seconds": 2.15,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.61,
      "end_seconds": 95.87,
      "duration_seconds": 3.26,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.63,
      "end_seconds": 100.69,
      "duration_seconds": 3.06,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.08,
      "end_seconds": 114.29,
      "duration_seconds": 6.21,
      "text": "Your right face droops, your right arm is weak and your speech is slurred."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.59,
      "end_seconds": 120.34,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.79,
      "end_seconds": 134.02,
      "duration_seconds": 3.23,
      "text": "Any loss of consciousness or fever at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.59,
      "end_seconds": 137.79,
      "duration_seconds": 2.2,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.84,
      "end_seconds": 141.07,
      "duration_seconds": 1.23,
      "text": "How about seizure?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.99,
      "end_seconds": 143.65,
      "duration_seconds": 1.66,
      "text": "Nope, no seizure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.94,
      "end_seconds": 147.74,
      "duration_seconds": 2.8,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.37,
      "end_seconds": 152.21,
      "duration_seconds": 2.84,
      "text": "No, um, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.14,
      "end_seconds": 157.3,
      "duration_seconds": 3.16,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.47,
      "end_seconds": 160.33,
      "duration_seconds": 1.86,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.47,
      "end_seconds": 182.75,
      "duration_seconds": 4.28,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.28,
      "end_seconds": 186.59,
      "duration_seconds": 2.31,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.22,
      "end_seconds": 191.54,
      "duration_seconds": 3.32,
      "text": "Okay, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.35,
      "end_seconds": 205.09,
      "duration_seconds": 11.74,
      "text": "I walk the dog every morning. Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.98,
      "end_seconds": 214.09,
      "duration_seconds": 7.11,
      "text": "Do you take any prescribed or over-the-counter medicines? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.67,
      "end_seconds": 229.06,
      "duration_seconds": 14.39,
      "text": "It's, It's hydrochlorothiazide, 12.5 milligrams, every morning for my pressure. I'm on bisoprolol, 2.5 milligrams, once a day. I used to take metoprolol, but I stopped it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.64,
      "end_seconds": 236.44,
      "duration_seconds": 5.8,
      "text": "Okay, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.2,
      "end_seconds": 242.04,
      "duration_seconds": 3.84,
      "text": "Yes, trimethoprim, it gives me a rash."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.74,
      "end_seconds": 244.96,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.16,
      "end_seconds": 247.28,
      "duration_seconds": 1.12,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.86,
      "end_seconds": 250.49,
      "duration_seconds": 2.63,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.47,
      "end_seconds": 259.67,
      "duration_seconds": 4.2,
      "text": "I have high blood pressure, for two years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.42,
      "end_seconds": 261.12,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.67,
      "end_seconds": 271.85,
      "duration_seconds": 10.18,
      "text": "I've had an irregular heartbeat for five years now. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.69,
      "end_seconds": 294.43,
      "duration_seconds": 20.74,
      "text": "Right, right. Okay, I can see an irregular heartbeat in your file as well. From what you've told me and what I found, this is probably a possible stroke, within the treatment window. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.43,
      "end_seconds": 297.1,
      "duration_seconds": 1.67,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.08,
      "end_seconds": 309.5,
      "duration_seconds": 11.42,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible stroke, within the treatment window, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.44,
      "end_seconds": 331.19,
      "duration_seconds": 6.75,
      "text": "Let's book an urgent CT scan of the head to look into possible stroke."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 332.03,
      "end_seconds": 336.54,
      "duration_seconds": 4.51,
      "text": "We have a slot Thursday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.79,
      "end_seconds": 339.74,
      "duration_seconds": 1.95,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.34,
      "end_seconds": 356.14,
      "duration_seconds": 15.8,
      "text": "I'm sending you for a blood sugar test because of stroke symptoms. Call an ambulance now, you need hospital immediately. Let's plan a check straight away. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.78,
      "end_seconds": 360.58,
      "duration_seconds": 2.8,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.53,
      "end_seconds": 365.94,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}