{
  "schema_version": "1.0",
  "encounter_id": "01471",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 4.59,
      "duration_seconds": 3.35,
      "text": "hello doctor. I think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.21,
      "end_seconds": 11.24,
      "duration_seconds": 5.03,
      "text": "not at all please sit what seems to to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.07,
      "end_seconds": 25.86,
      "duration_seconds": 13.79,
      "text": "so the thing is, I've got shaking chills and a high temperature i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.35,
      "end_seconds": 34.51,
      "duration_seconds": 3.16,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.42,
      "end_seconds": 39.68,
      "duration_seconds": 3.26,
      "text": "Since yesterday that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.49,
      "end_seconds": 47.81,
      "duration_seconds": 6.32,
      "text": "alright, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.16,
      "end_seconds": 55.46,
      "duration_seconds": 6.3,
      "text": "Honestly, a few times a day. I've also been feeling confused, since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.77,
      "end_seconds": 60.79,
      "duration_seconds": 4.02,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.09,
      "end_seconds": 69.53,
      "duration_seconds": 2.44,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.96,
      "end_seconds": 100.92,
      "duration_seconds": 11.96,
      "text": "okay: height 167 centimetres, heart rate 101, respiratory rate 20, weight 76 kilos, BP is 106 over 73, oxygen saturation is 97 percent, temperature 38.9."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.72,
      "end_seconds": 107.18,
      "duration_seconds": 3.46,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.17,
      "end_seconds": 110.92,
      "duration_seconds": 1.75,
      "text": "so, nearly finished here"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.31,
      "end_seconds": 136.53,
      "duration_seconds": 7.22,
      "text": "you are hot, your heart is racing and your blood pressure is low, which worries me"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.89,
      "end_seconds": 146.57,
      "duration_seconds": 1.68,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.22,
      "end_seconds": 154.9,
      "duration_seconds": 5.68,
      "text": "Please sit back down. Have you had any rash, chest pain or stiff neck?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.42,
      "end_seconds": 159.15,
      "duration_seconds": 2.73,
      "text": "no none of those at all"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.31,
      "end_seconds": 162.67,
      "duration_seconds": 2.36,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.4,
      "end_seconds": 165.32,
      "duration_seconds": 0.92,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.27,
      "end_seconds": 168.76,
      "duration_seconds": 2.49,
      "text": "Before we go further any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.65,
      "end_seconds": 174.68,
      "duration_seconds": 4.03,
      "text": "Yes, milk, it gives me a rash."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.66,
      "end_seconds": 184.31,
      "duration_seconds": 3.65,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.02,
      "end_seconds": 187.29,
      "duration_seconds": 2.27,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.57,
      "end_seconds": 189.46,
      "duration_seconds": 0.89,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.05,
      "end_seconds": 193.78,
      "duration_seconds": 2.73,
      "text": "I have an underactive thyroid"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.71,
      "end_seconds": 205.62,
      "duration_seconds": 9.91,
      "text": "Right so high blood pressure is already on your record. We'll keep that in mind today. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.71,
      "end_seconds": 213.54,
      "duration_seconds": 5.83,
      "text": "yes, I had keyhole surgery on my gallbladder, two years back"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.09,
      "end_seconds": 236.03,
      "duration_seconds": 4.94,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.08,
      "end_seconds": 248.51,
      "duration_seconds": 11.43,
      "text": "My husband and I live above the shop. I look after my grandchildren most days. I walk the dog every morning"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.53,
      "end_seconds": 255.14,
      "duration_seconds": 4.61,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.05,
      "end_seconds": 265.95,
      "duration_seconds": 8.9,
      "text": "it's hydrochlorothiazide, 12.5 milligrams, every morning for my pressure. Thyronorm, 50 micrograms, every morning"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.77,
      "end_seconds": 280.77,
      "duration_seconds": 14.0,
      "text": "From what you've told me and what I found I think we're dealing with possible sepsis needing urgent treatment at this stage. Another possibility is a severe urine or chest infection."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.98,
      "end_seconds": 299.05,
      "duration_seconds": 9.07,
      "text": "I want lactate and blood tests done that's for sepsis it's a routine test and it'll give us a much clearer picture"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 300.29,
      "end_seconds": 304.2,
      "duration_seconds": 3.91,
      "text": "I can book that for Wednesday at 10 am."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.06,
      "end_seconds": 310.88,
      "duration_seconds": 4.82,
      "text": "I want to admit you to hospital now for fluids and antibiotics"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.8,
      "end_seconds": 316.52,
      "duration_seconds": 4.72,
      "text": "Could I get blood cultures done? A friend had it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.09,
      "end_seconds": 329.01,
      "duration_seconds": 10.92,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Come back straight away. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.44,
      "end_seconds": 333.71,
      "duration_seconds": 3.27,
      "text": "right I'll do that. Thank you doctor"
    }
  ]
}