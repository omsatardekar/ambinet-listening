{
  "schema_version": "1.0",
  "encounter_id": "01019",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.35,
      "end_seconds": 6.05,
      "duration_seconds": 4.7,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 11.99,
      "duration_seconds": 3.93,
      "text": "thanks, that's helpful hello, please sit what's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.57,
      "end_seconds": 18.8,
      "duration_seconds": 6.23,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 20.37,
      "end_seconds": 23.87,
      "duration_seconds": 3.5,
      "text": "Well, I've been having a sore ankle."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.17,
      "end_seconds": 27.68,
      "duration_seconds": 2.51,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 29.08,
      "end_seconds": 34.78,
      "duration_seconds": 5.7,
      "text": "he takes allopurinol, 100 milligrams, once a day for the gout"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.65,
      "end_seconds": 41.48,
      "duration_seconds": 4.83,
      "text": "I'd been on febuxostat, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.22,
      "end_seconds": 46.62,
      "duration_seconds": 3.4,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 48.05,
      "end_seconds": 51.22,
      "duration_seconds": 3.17,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 52.58,
      "end_seconds": 56.47,
      "duration_seconds": 3.89,
      "text": "Ah, hm, I'd say more like two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.55,
      "end_seconds": 62.3,
      "duration_seconds": 4.75,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.23,
      "end_seconds": 66.53,
      "duration_seconds": 3.3,
      "text": "Uh, yes, somewhere around that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.75,
      "end_seconds": 71.32,
      "duration_seconds": 3.57,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.67,
      "end_seconds": 77.84,
      "duration_seconds": 5.17,
      "text": "I'd say severe. Oh, you know, and a little swelling."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.89,
      "end_seconds": 85.6,
      "duration_seconds": 6.71,
      "text": "alright, have you had any pain in the foot, crack or pop or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.2,
      "end_seconds": 89.37,
      "duration_seconds": 3.17,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.27,
      "end_seconds": 98.13,
      "duration_seconds": 4.86,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 99.61,
      "end_seconds": 101.54,
      "duration_seconds": 1.93,
      "text": "no, nothing like that"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.26,
      "end_seconds": 105.26,
      "duration_seconds": 2.0,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.19,
      "end_seconds": 108.24,
      "duration_seconds": 1.05,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.53,
      "end_seconds": 127.13,
      "duration_seconds": 3.6,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.24,
      "end_seconds": 133.48,
      "duration_seconds": 5.24,
      "text": "My mother has an underactive thyroid. My brother has epilepsy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.38,
      "end_seconds": 146.25,
      "duration_seconds": 2.87,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.32,
      "end_seconds": 151.92,
      "duration_seconds": 4.6,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.54,
      "end_seconds": 156.4,
      "duration_seconds": 2.86,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.8,
      "end_seconds": 163.65,
      "duration_seconds": 2.85,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.97,
      "end_seconds": 166.4,
      "duration_seconds": 1.43,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.99,
      "end_seconds": 171.28,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.27,
      "end_seconds": 177.31,
      "duration_seconds": 4.04,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 181.79,
      "end_seconds": 186.12,
      "duration_seconds": 4.33,
      "text": "No, you know, I'm not allergic to to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 187.45,
      "end_seconds": 193.71,
      "duration_seconds": 6.26,
      "text": "I'm not sure that's right i seem to recall a problem with erythromycin"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 195.16,
      "end_seconds": 199.31,
      "duration_seconds": 4.15,
      "text": "I mean, maybe, but I don't recall it"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.78,
      "end_seconds": 207.79,
      "duration_seconds": 3.01,
      "text": "fair enough, I'll write down both versions"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.68,
      "end_seconds": 222.63,
      "duration_seconds": 2.95,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.94,
      "end_seconds": 227.18,
      "duration_seconds": 3.24,
      "text": "I have gout, for five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 231.49,
      "end_seconds": 241.23,
      "duration_seconds": 9.74,
      "text": "okay, so the the vitals from earlier heart rate 75, saturation 99 percent, temp 36.8 degrees, blood pressure 122 over 73."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.76,
      "end_seconds": 242.46,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.81,
      "end_seconds": 247.78,
      "duration_seconds": 3.97,
      "text": "Now I'm going to do a a short physical check."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.17,
      "end_seconds": 251.17,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.81,
      "end_seconds": 272.54,
      "duration_seconds": 6.73,
      "text": "There's mild swelling over the outside of the ankle, and you can put your weight on it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.46,
      "end_seconds": 310.5,
      "duration_seconds": 32.04,
      "text": "Please sit back down. So, based on the history and the examination, my working impression is a mild ankle sprain. That's my thinking for now, and it may change as we learn more. We shouldn't forget a minor fracture. Rest, ice, a compression bandage and keep it raised for two days. Keep an eye out, and if you cannot put weight on it, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 312.04,
      "end_seconds": 315.44,
      "duration_seconds": 3.4,
      "text": "Oh, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.19,
      "end_seconds": 324.73,
      "duration_seconds": 7.54,
      "text": "we'll catch up if it is not better in two weeks. I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 326.59,
      "end_seconds": 330.73,
      "duration_seconds": 4.14,
      "text": "No, uh, that's all. Thanks a lot."
    }
  ]
}