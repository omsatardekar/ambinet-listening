{
  "schema_version": "1.0",
  "encounter_id": "01419",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 4.24,
      "duration_seconds": 3.05,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.89,
      "end_seconds": 12.49,
      "duration_seconds": 4.6,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.7,
      "end_seconds": 16.84,
      "duration_seconds": 3.14,
      "text": "Well, I've been having vomiting blood."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.69,
      "end_seconds": 21.03,
      "duration_seconds": 3.34,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.1,
      "end_seconds": 26.42,
      "duration_seconds": 3.32,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.74,
      "end_seconds": 32.45,
      "duration_seconds": 4.71,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.05,
      "end_seconds": 45.63,
      "duration_seconds": 12.58,
      "text": "It happens every other day. I'd say moderate. I've had black tarry stools too, for three days. With black tarry stools, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.66,
      "end_seconds": 49.46,
      "duration_seconds": 2.8,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.36,
      "end_seconds": 64.79,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.99,
      "end_seconds": 87.66,
      "duration_seconds": 6.67,
      "text": "Okay: temperature is 36.7 degrees, saturation 99 percent, heart rate 117, pressure 136 over 73."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.31,
      "end_seconds": 91.25,
      "duration_seconds": 1.94,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.42,
      "end_seconds": 100.64,
      "duration_seconds": 3.22,
      "text": "Okay, we'll look at it together shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.1,
      "end_seconds": 106.14,
      "duration_seconds": 4.04,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.28,
      "end_seconds": 116.98,
      "duration_seconds": 1.7,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.95,
      "end_seconds": 119.69,
      "duration_seconds": 1.74,
      "text": "Alright, breathe out slowly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.31,
      "end_seconds": 141.59,
      "duration_seconds": 6.28,
      "text": "You look pale, your pulse is fast and your tummy is tender at the top."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.32,
      "end_seconds": 149.04,
      "duration_seconds": 1.72,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.71,
      "end_seconds": 170.11,
      "duration_seconds": 4.4,
      "text": "Let me check a few things. Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.87,
      "end_seconds": 174.29,
      "duration_seconds": 2.42,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.28,
      "end_seconds": 178.78,
      "duration_seconds": 3.5,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.23,
      "end_seconds": 184.92,
      "duration_seconds": 4.69,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.71,
      "end_seconds": 187.03,
      "duration_seconds": 1.32,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.58,
      "end_seconds": 190.62,
      "duration_seconds": 3.04,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.05,
      "end_seconds": 197.36,
      "duration_seconds": 2.31,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.59,
      "end_seconds": 202.56,
      "duration_seconds": 3.97,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.16,
      "end_seconds": 206.11,
      "duration_seconds": 1.95,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.0,
      "end_seconds": 211.53,
      "duration_seconds": 2.53,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.84,
      "end_seconds": 214.16,
      "duration_seconds": 1.32,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.15,
      "end_seconds": 218.86,
      "duration_seconds": 3.71,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.42,
      "end_seconds": 225.59,
      "duration_seconds": 5.17,
      "text": "Right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.14,
      "end_seconds": 235.68,
      "duration_seconds": 8.54,
      "text": "Yes, plasters. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.63,
      "end_seconds": 245.18,
      "duration_seconds": 3.55,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.77,
      "end_seconds": 249.71,
      "duration_seconds": 2.94,
      "text": "I have asthma, for two years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.42,
      "end_seconds": 255.53,
      "duration_seconds": 4.11,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.24,
      "end_seconds": 264.62,
      "duration_seconds": 7.38,
      "text": "It's Foracort inhaler, twice a day. It's ibuprofen, 400 milligrams, three times a day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.03,
      "end_seconds": 288.79,
      "duration_seconds": 13.76,
      "text": "So where does that leave us? My working impression is a possible bleeding stomach ulcer. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.1,
      "end_seconds": 325.46,
      "duration_seconds": 25.36,
      "text": "I'd like to arrange an endoscopy for bleeding. The result will help us decide whether anything more is needed. Please stop the ibuprofen and do not eat or drink. The thing that would worry me is if you vomit again. If that happens, go to emergency. See me again straight away. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.17,
      "end_seconds": 330.28,
      "duration_seconds": 3.11,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.0,
      "end_seconds": 333.28,
      "duration_seconds": 1.28,
      "text": "Look after yourself."
    }
  ]
}