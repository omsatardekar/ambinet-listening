{
  "schema_version": "1.0",
  "encounter_id": "01124",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.96,
      "end_seconds": 6.12,
      "duration_seconds": 5.16,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.42,
      "end_seconds": 16.23,
      "duration_seconds": 4.81,
      "text": "thank you good morning, tell me what's been going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.45,
      "end_seconds": 22.92,
      "duration_seconds": 5.47,
      "text": "right, doctor, I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.46,
      "end_seconds": 38.01,
      "duration_seconds": 10.55,
      "text": "Um, it's crushing chest pain, mostly. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.5,
      "end_seconds": 40.67,
      "duration_seconds": 1.17,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.38,
      "end_seconds": 45.05,
      "duration_seconds": 3.67,
      "text": "Ah, I'd say two weeks, maybe."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 46.73,
      "end_seconds": 52.73,
      "duration_seconds": 6.0,
      "text": "actually, you know, I think it's been nearer three weeks, actually"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.67,
      "end_seconds": 58.12,
      "duration_seconds": 4.45,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.68,
      "end_seconds": 61.02,
      "duration_seconds": 1.34,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.89,
      "end_seconds": 67.37,
      "duration_seconds": 5.48,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 69.17,
      "end_seconds": 81.39,
      "duration_seconds": 12.22,
      "text": "it feels severe to me it settles a little with rest honestly, a couple of times a week yes, exertion that makes it worse"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.61,
      "end_seconds": 84.17,
      "duration_seconds": 1.56,
      "text": "Have you been sweating?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 85.85,
      "end_seconds": 88.08,
      "duration_seconds": 2.23,
      "text": "yes, you know, actually"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 94.7,
      "duration_seconds": 4.6,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.11,
      "end_seconds": 102.44,
      "duration_seconds": 6.33,
      "text": "I mean, it feels moderate to me it just comes and goes"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 107.51,
      "end_seconds": 111.49,
      "duration_seconds": 3.98,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.25,
      "end_seconds": 129.64,
      "duration_seconds": 3.39,
      "text": "Have you noticed cough or leg swelling?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.49,
      "end_seconds": 144.89,
      "duration_seconds": 14.4,
      "text": "No, uh, no cough, no leg swelling. I did have pain going into my left arm at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.52,
      "end_seconds": 148.59,
      "duration_seconds": 3.07,
      "text": "Have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.09,
      "end_seconds": 155.73,
      "duration_seconds": 1.64,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.38,
      "end_seconds": 160.33,
      "duration_seconds": 3.95,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.16,
      "end_seconds": 163.61,
      "duration_seconds": 2.45,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.14,
      "end_seconds": 168.43,
      "duration_seconds": 1.29,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 172.25,
      "duration_seconds": 3.01,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.3,
      "end_seconds": 177.97,
      "duration_seconds": 3.67,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.27,
      "end_seconds": 198.05,
      "duration_seconds": 18.78,
      "text": "I've had high cholesterol for nearly five years now. I took the morning off to come in today. Erm, you know, yes, high blood pressure. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.58,
      "end_seconds": 207.98,
      "duration_seconds": 8.4,
      "text": "Alright, high blood pressure, that matches what I have here. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.85,
      "end_seconds": 214.55,
      "duration_seconds": 5.7,
      "text": "Telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 215.8,
      "end_seconds": 224.89,
      "duration_seconds": 9.09,
      "text": "Doctor, I think the last prescription for the telmisartan was 80 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.9,
      "end_seconds": 231.2,
      "duration_seconds": 4.3,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.85,
      "end_seconds": 237.5,
      "duration_seconds": 4.65,
      "text": "not with me i'll bring it next time"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.59,
      "end_seconds": 242.25,
      "duration_seconds": 2.66,
      "text": "have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.1,
      "end_seconds": 249.7,
      "duration_seconds": 5.6,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.78,
      "end_seconds": 255.5,
      "duration_seconds": 4.72,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.29,
      "end_seconds": 267.27,
      "duration_seconds": 9.98,
      "text": "Diclofenac. I come out in... well, wheezing. So, um, I'm allergic to naproxen, I get stomach pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 268.39,
      "end_seconds": 277.66,
      "duration_seconds": 9.27,
      "text": "okay, so the vitals from earlier. Temperature is 36.6 degrees, SpO2 98 percent on room air. Blood pressure 123 over 75, pulse 116."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.48,
      "end_seconds": 279.5,
      "duration_seconds": 1.02,
      "text": "alright, thanks"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.21,
      "end_seconds": 283.54,
      "duration_seconds": 2.33,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.91,
      "end_seconds": 288.29,
      "duration_seconds": 3.38,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.55,
      "end_seconds": 300.76,
      "duration_seconds": 4.21,
      "text": "You are pale and sweaty, and your pulse is fast."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 302.48,
      "end_seconds": 303.52,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.81,
      "end_seconds": 311.06,
      "duration_seconds": 2.25,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.8,
      "end_seconds": 335.39,
      "duration_seconds": 10.59,
      "text": "from what you've told me and what I found, it points towards a possible heart attack i can't rule out unstable angina yet"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 336.34,
      "end_seconds": 339.62,
      "duration_seconds": 3.28,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.17,
      "end_seconds": 350.28,
      "duration_seconds": 9.11,
      "text": "It's reasonable to be concerned, but right now a possible heart attack is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 352.1,
      "end_seconds": 355.67,
      "duration_seconds": 3.57,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.62,
      "end_seconds": 364.13,
      "duration_seconds": 6.51,
      "text": "Right, thank you. We should do a troponin blood test for chest pain."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_6",
      "role": "CLINICAL_STAFF",
      "start_seconds": 365.63,
      "end_seconds": 369.24,
      "duration_seconds": 3.61,
      "text": "The The earliest is Monday, 11:30 am."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.04,
      "end_seconds": 382.66,
      "duration_seconds": 12.62,
      "text": "I'll start you on aspirin, 300 milligrams, once now, single dose. That should help with possible heart attack. Stay lying down and do not eat or drink."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.09,
      "end_seconds": 387.45,
      "duration_seconds": 4.36,
      "text": "ah. I'm going to send a referral to the cardiac team"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.31,
      "end_seconds": 391.21,
      "duration_seconds": 2.9,
      "text": "Alright, um, thank you."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.67,
      "end_seconds": 405.8,
      "duration_seconds": 13.13,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose i'd like to see you again straight away"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.69,
      "end_seconds": 409.94,
      "duration_seconds": 2.25,
      "text": "alright, I'll be back"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.21,
      "end_seconds": 415.15,
      "duration_seconds": 3.94,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.96,
      "end_seconds": 421.42,
      "duration_seconds": 5.46,
      "text": "no, uh, that's all thanks a a lot"
    }
  ]
}