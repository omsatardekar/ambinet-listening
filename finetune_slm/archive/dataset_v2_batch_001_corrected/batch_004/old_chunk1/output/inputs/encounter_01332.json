{
  "schema_version": "1.0",
  "encounter_id": "01332",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.37,
      "end_seconds": 5.08,
      "duration_seconds": 3.71,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.33,
      "end_seconds": 12.23,
      "duration_seconds": 5.9,
      "text": "Good morning, uh, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.94,
      "end_seconds": 17.78,
      "duration_seconds": 4.84,
      "text": "Absolutely, come and sit beside them. What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.14,
      "end_seconds": 30.28,
      "duration_seconds": 11.14,
      "text": "Um, doctor, it's wheezing. It's getting on my nerves now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.05,
      "end_seconds": 34.04,
      "duration_seconds": 2.99,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.63,
      "end_seconds": 45.29,
      "duration_seconds": 9.66,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.87,
      "end_seconds": 49.93,
      "duration_seconds": 4.06,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.75,
      "end_seconds": 60.16,
      "duration_seconds": 8.41,
      "text": "Well, you know, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.83,
      "end_seconds": 67.0,
      "duration_seconds": 5.17,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.24,
      "end_seconds": 74.42,
      "duration_seconds": 3.18,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.08,
      "end_seconds": 83.15,
      "duration_seconds": 8.07,
      "text": "Yeah, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 83.25,
      "end_seconds": 89.21,
      "duration_seconds": 5.96,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 93.21,
      "end_seconds": 103.3,
      "duration_seconds": 10.09,
      "text": "Well, I was getting to that! Let me think, I've had swollen lips too, for two weeks."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.35,
      "end_seconds": 111.09,
      "duration_seconds": 5.74,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.98,
      "end_seconds": 114.71,
      "duration_seconds": 2.73,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.15,
      "end_seconds": 128.73,
      "duration_seconds": 2.58,
      "text": "Any chest pain or recent illness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.48,
      "end_seconds": 146.04,
      "duration_seconds": 15.56,
      "text": "Uh, no, no chest pain, no recent illness. I did have my throat closing up at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.57,
      "end_seconds": 150.8,
      "duration_seconds": 4.23,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.48,
      "end_seconds": 155.26,
      "duration_seconds": 2.78,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.82,
      "end_seconds": 161.2,
      "duration_seconds": 4.38,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.85,
      "end_seconds": 164.37,
      "duration_seconds": 1.52,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.31,
      "end_seconds": 172.99,
      "duration_seconds": 7.68,
      "text": "Anything in your past medical history I should know? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 173.77,
      "end_seconds": 182.59,
      "duration_seconds": 8.82,
      "text": "I have asthma, for nearly five years. Well, I've had acid reflux for five years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.92,
      "end_seconds": 185.32,
      "duration_seconds": 1.4,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.57,
      "end_seconds": 197.1,
      "duration_seconds": 10.53,
      "text": "Right, so asthma and acid reflux are already on your record. We'll keep that in mind today. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.68,
      "end_seconds": 216.16,
      "duration_seconds": 18.48,
      "text": "Seretide inhaler. I take it twice a day. I told myself I'd wait and see, you know, and here I am. Right, you know, I'm on omeprazole, 20 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 217.37,
      "end_seconds": 226.83,
      "duration_seconds": 9.46,
      "text": "She is supposed to take it once a day, but I can't say she always does."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.05,
      "end_seconds": 234.97,
      "duration_seconds": 6.92,
      "text": "Yeah, um, I used to take pantoprazole, but I stopped it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.33,
      "end_seconds": 241.72,
      "duration_seconds": 5.39,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 243.61,
      "end_seconds": 245.39,
      "duration_seconds": 1.78,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.02,
      "end_seconds": 247.49,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.65,
      "end_seconds": 253.34,
      "duration_seconds": 1.69,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.37,
      "end_seconds": 258.63,
      "duration_seconds": 3.26,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 260.44,
      "end_seconds": 263.66,
      "duration_seconds": 3.22,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 272.47,
      "end_seconds": 281.11,
      "duration_seconds": 8.64,
      "text": "Here are the numbers, doctor. Temp 36.4 degrees, blood pressure 95 over 62, pulse 102. Oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.77,
      "end_seconds": 282.47,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.82,
      "end_seconds": 286.87,
      "duration_seconds": 2.05,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.13,
      "end_seconds": 289.46,
      "duration_seconds": 1.33,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.34,
      "end_seconds": 310.73,
      "duration_seconds": 6.39,
      "text": "Your lips are swollen, you have hives, you are wheezing and your pressure is low."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.44,
      "end_seconds": 328.3,
      "duration_seconds": 11.86,
      "text": "Okay, that's enough for me. Okay, thinking it through, I can't pin this down yet. We're looking at anaphylaxis or a severe allergic reaction."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 330.24,
      "end_seconds": 331.75,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.69,
      "end_seconds": 346.64,
      "duration_seconds": 13.95,
      "text": "I can't promise yet, but most people with anaphylaxis do well once it's treated properly. So, to recap quickly. You've had wheezing, moderate, and no recent illness or chest pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 347.28,
      "end_seconds": 349.44,
      "duration_seconds": 2.16,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.83,
      "end_seconds": 361.38,
      "duration_seconds": 10.55,
      "text": "I think monitoring makes sense here, for anaphylaxis. You'll be taking adrenaline, 0.5 milligrams, once now, single dose. That's for anaphylaxis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 362.32,
      "end_seconds": 368.44,
      "duration_seconds": 6.12,
      "text": "Okay, um, so is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.49,
      "end_seconds": 387.85,
      "duration_seconds": 17.36,
      "text": "Lie flat with your legs raised, I am giving the injection now. The emergency team would be the right next step, I'll refer you. One warning sign to remember: the symptoms return. In that case don't wait."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 388.79,
      "end_seconds": 391.96,
      "duration_seconds": 3.17,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.83,
      "end_seconds": 403.31,
      "duration_seconds": 10.48,
      "text": "Please come and see me straight away. Right, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 403.86,
      "end_seconds": 414.86,
      "duration_seconds": 11.0,
      "text": "So, I take the adrenaline, 0.5 milligrams, once now and come back straight away. Is that right?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 415.45,
      "end_seconds": 419.43,
      "duration_seconds": 3.98,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 420.97,
      "end_seconds": 424.36,
      "duration_seconds": 3.39,
      "text": "I think I understand everything. Thanks."
    }
  ]
}