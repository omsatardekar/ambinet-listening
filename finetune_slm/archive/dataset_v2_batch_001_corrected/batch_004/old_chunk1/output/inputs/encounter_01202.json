{
  "schema_version": "1.0",
  "encounter_id": "01202",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 2.92,
      "duration_seconds": 1.77,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.79,
      "end_seconds": 7.86,
      "duration_seconds": 3.07,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.34,
      "end_seconds": 11.17,
      "duration_seconds": 1.83,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.91,
      "end_seconds": 15.4,
      "duration_seconds": 3.49,
      "text": "Well, I've been having a blocked ear."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.54,
      "end_seconds": 21.63,
      "duration_seconds": 3.09,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.66,
      "end_seconds": 33.58,
      "duration_seconds": 9.92,
      "text": "Around about a month... no wait, it's more like two months. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.2,
      "end_seconds": 39.39,
      "duration_seconds": 5.19,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.85,
      "end_seconds": 48.77,
      "duration_seconds": 4.92,
      "text": "I'd say severe. I notice it more with showering."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.25,
      "end_seconds": 54.33,
      "duration_seconds": 4.08,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.82,
      "end_seconds": 63.3,
      "duration_seconds": 2.48,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.35,
      "end_seconds": 84.65,
      "duration_seconds": 6.3,
      "text": "Okay: pulse 71, temperature 36.5, BP is 121 over 68. And respiratory rate 15."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.49,
      "end_seconds": 91.25,
      "duration_seconds": 3.76,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.3,
      "end_seconds": 95.15,
      "duration_seconds": 2.85,
      "text": "Alright, raise your arm for me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.5,
      "end_seconds": 110.87,
      "duration_seconds": 4.37,
      "text": "There's a lot of wax blocking the right ear canal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.66,
      "end_seconds": 115.35,
      "duration_seconds": 1.69,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.51,
      "end_seconds": 134.2,
      "duration_seconds": 4.69,
      "text": "Let me check a few things. Any ringing or discharge?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.29,
      "end_seconds": 139.33,
      "duration_seconds": 3.04,
      "text": "Mm, no, no ringing or discharge."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.94,
      "end_seconds": 145.06,
      "duration_seconds": 5.12,
      "text": "Let me check a few things. Any ear pain or dizziness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.66,
      "end_seconds": 152.83,
      "duration_seconds": 3.17,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.13,
      "end_seconds": 160.11,
      "duration_seconds": 2.98,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.16,
      "end_seconds": 164.14,
      "duration_seconds": 2.98,
      "text": "So, no, that side's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.52,
      "end_seconds": 168.11,
      "duration_seconds": 2.59,
      "text": "Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.76,
      "end_seconds": 171.46,
      "duration_seconds": 2.7,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.68,
      "end_seconds": 188.29,
      "duration_seconds": 2.61,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.1,
      "end_seconds": 192.25,
      "duration_seconds": 3.15,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.32,
      "end_seconds": 200.53,
      "duration_seconds": 3.21,
      "text": "Right, do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.6,
      "end_seconds": 205.31,
      "duration_seconds": 3.71,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.6,
      "end_seconds": 216.08,
      "duration_seconds": 3.48,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.7,
      "end_seconds": 220.36,
      "duration_seconds": 3.66,
      "text": "It's olive oil drops, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.9,
      "end_seconds": 228.76,
      "duration_seconds": 7.86,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.52,
      "end_seconds": 233.95,
      "duration_seconds": 3.43,
      "text": "Erm, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.73,
      "end_seconds": 240.42,
      "duration_seconds": 4.69,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.24,
      "end_seconds": 245.3,
      "duration_seconds": 3.06,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.25,
      "end_seconds": 257.01,
      "duration_seconds": 9.76,
      "text": "Okay, thinking it through, this is probably earwax blocking the ear. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.01,
      "end_seconds": 261.21,
      "duration_seconds": 3.2,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.31,
      "end_seconds": 280.43,
      "duration_seconds": 18.12,
      "text": "I can't promise yet, but most people with earwax blocking the ear do well once it's treated properly. Stop me if I've got anything wrong. You've had a blocked ear for two months, severe, and no discharge or ear pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.01,
      "end_seconds": 282.78,
      "duration_seconds": 1.77,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.0,
      "end_seconds": 303.53,
      "duration_seconds": 6.53,
      "text": "I want ear irrigation done, that's for wax. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.59,
      "end_seconds": 307.88,
      "duration_seconds": 3.29,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.45,
      "end_seconds": 309.65,
      "duration_seconds": 1.2,
      "text": "Take care now."
    }
  ]
}