  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.54,
      "duration_seconds": 3.54,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.9,
      "end_seconds": 11.87,
      "duration_seconds": 3.97,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.27,
      "end_seconds": 18.03,
      "duration_seconds": 4.76,
      "text": "well, I've been having burning when I pass urine"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.78,
      "end_seconds": 20.36,
      "duration_seconds": 1.58,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.1,
      "end_seconds": 24.21,
      "duration_seconds": 3.11,
      "text": "ever since... since last Tuesday, really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.87,
      "end_seconds": 26.99,
      "duration_seconds": 2.12,
      "text": "what eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.92,
      "end_seconds": 36.62,
      "duration_seconds": 8.7,
      "text": "it settles a little with drinking water i've also been going to the toilet often, for ten days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.98,
      "end_seconds": 40.06,
      "duration_seconds": 2.08,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.44,
      "end_seconds": 54.81,
      "duration_seconds": 2.37,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.53,
      "end_seconds": 76.36,
      "duration_seconds": 7.83,
      "text": "Okay: pulse 67, temp 36.5 degrees. And SpO2 99 percent on room air, blood pressure 112 over 71."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.86,
      "end_seconds": 79.9,
      "duration_seconds": 2.04,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.16,
      "end_seconds": 84.33,
      "duration_seconds": 3.17,
      "text": "So, we'll go over that that shortly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.42,
      "end_seconds": 89.75,
      "duration_seconds": 3.33,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.92,
      "end_seconds": 94.74,
      "duration_seconds": 3.82,
      "text": "Right, I'll listen to to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.73,
      "end_seconds": 114.09,
      "duration_seconds": 5.36,
      "text": "Your tummy is soft with slight tenderness just above the pubic bone."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.05,
      "end_seconds": 126.7,
      "duration_seconds": 6.65,
      "text": "good, you can sit up again. A few quick ones: vaginal discharge or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.04,
      "end_seconds": 129.97,
      "duration_seconds": 1.93,
      "text": "none of those, no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.96,
      "end_seconds": 137.74,
      "duration_seconds": 5.78,
      "text": "Okay, a few quick ones: back pain or blood in the urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.18,
      "end_seconds": 142.64,
      "duration_seconds": 3.46,
      "text": "none of those, you know, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.52,
      "end_seconds": 148.72,
      "duration_seconds": 4.2,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.13,
      "end_seconds": 152.04,
      "duration_seconds": 1.91,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.21,
      "end_seconds": 173.74,
      "duration_seconds": 3.53,
      "text": "So, do you take any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.9,
      "end_seconds": 177.58,
      "duration_seconds": 2.68,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.73,
      "end_seconds": 183.3,
      "duration_seconds": 4.57,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.17,
      "end_seconds": 199.62,
      "duration_seconds": 15.45,
      "text": "I quit smoking around ten years ago. My husband and I live above the shop. I'm a bus driver, so I sit for long hours. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.28,
      "end_seconds": 205.26,
      "duration_seconds": 3.98,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.04,
      "end_seconds": 210.82,
      "duration_seconds": 3.78,
      "text": "I don't think I have any, no"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.76,
      "end_seconds": 231.58,
      "duration_seconds": 7.82,
      "text": "Do you have any medical conditions I should know about? Just so I get the the full picture."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.63,
      "end_seconds": 235.88,
      "duration_seconds": 3.25,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.17,
      "end_seconds": 256.45,
      "duration_seconds": 9.28,
      "text": "Having listened and examined, I don't have a clear answer today: an uncomplicated urinary infection is possible, and so is vaginal irritation."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.81,
      "end_seconds": 290.58,
      "duration_seconds": 26.77,
      "text": "I'm going to order a urine dipstick, for burning urine. I'd rather check than guess, and this is the quickest way to know more. Let's use nitrofurantoin, 100 milligrams, twice a day, three days. It's for urinary infection. Drink plenty of water and avoid holding urine. Do get help quickly if you get a fever or back pain"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.0,
      "end_seconds": 296.23,
      "duration_seconds": 4.23,
      "text": "Hmm, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.88,
      "end_seconds": 304.91,
      "duration_seconds": 5.03,
      "text": "Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.01,
      "end_seconds": 315.4,
      "duration_seconds": 6.39,
      "text": "so, I take the nitrofurantoin, 100 milligrams, twice a day is that right?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.42,
      "end_seconds": 321.17,
      "duration_seconds": 3.75,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.1,
      "end_seconds": 328.28,
      "duration_seconds": 3.18,
      "text": "I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.97,
      "end_seconds": 331.4,
      "duration_seconds": 1.43,
      "text": "Look after yourself."
    }
  ]
}