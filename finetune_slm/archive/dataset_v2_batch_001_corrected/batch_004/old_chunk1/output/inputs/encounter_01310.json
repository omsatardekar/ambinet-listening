{
  "schema_version": "1.0",
  "encounter_id": "01310",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.77,
      "end_seconds": 4.75,
      "duration_seconds": 3.98,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.36,
      "end_seconds": 10.51,
      "duration_seconds": 5.15,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 18.19,
      "duration_seconds": 5.99,
      "text": "Honestly, it's a severe headache, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.65,
      "end_seconds": 21.03,
      "duration_seconds": 1.38,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.4,
      "end_seconds": 29.92,
      "duration_seconds": 3.52,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.26,
      "end_seconds": 34.06,
      "duration_seconds": 2.8,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.82,
      "end_seconds": 37.29,
      "duration_seconds": 1.47,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.56,
      "end_seconds": 41.77,
      "duration_seconds": 3.21,
      "text": "Did you get cough or recent head injury?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.32,
      "end_seconds": 46.79,
      "duration_seconds": 4.47,
      "text": "Erm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.95,
      "end_seconds": 50.43,
      "duration_seconds": 2.48,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.24,
      "end_seconds": 53.15,
      "duration_seconds": 0.91,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.56,
      "end_seconds": 59.26,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.24,
      "end_seconds": 68.72,
      "duration_seconds": 3.48,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.68,
      "end_seconds": 73.11,
      "duration_seconds": 3.43,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.81,
      "end_seconds": 78.28,
      "duration_seconds": 3.47,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.4,
      "end_seconds": 81.79,
      "duration_seconds": 2.39,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.72,
      "end_seconds": 88.19,
      "duration_seconds": 4.47,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.2,
      "end_seconds": 103.58,
      "duration_seconds": 3.38,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.27,
      "end_seconds": 108.11,
      "duration_seconds": 3.84,
      "text": "Um, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 126.08,
      "duration_seconds": 4.25,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.29,
      "end_seconds": 131.85,
      "duration_seconds": 4.56,
      "text": "I mean, uh, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.43,
      "end_seconds": 137.48,
      "duration_seconds": 5.05,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.47,
      "end_seconds": 139.59,
      "duration_seconds": 1.12,
      "text": "Yes, trimethoprim."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.67,
      "end_seconds": 143.55,
      "duration_seconds": 2.88,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.55,
      "end_seconds": 146.21,
      "duration_seconds": 1.66,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.66,
      "end_seconds": 157.65,
      "duration_seconds": 2.99,
      "text": "Right, I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.08,
      "end_seconds": 168.43,
      "duration_seconds": 3.35,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.29,
      "end_seconds": 197.92,
      "duration_seconds": 7.63,
      "text": "Okay: temperature is 38.6 degrees, pulse 105. And saturation 98 percent, BP is 121 over 70."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.55,
      "end_seconds": 201.46,
      "duration_seconds": 2.91,
      "text": "Uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.39,
      "end_seconds": 206.54,
      "duration_seconds": 4.15,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.04,
      "end_seconds": 212.99,
      "duration_seconds": 4.95,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.6,
      "end_seconds": 216.91,
      "duration_seconds": 2.31,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.8,
      "end_seconds": 233.04,
      "duration_seconds": 7.24,
      "text": "Your neck is stiff, you are feverish, and there are purple spots that do not fade when pressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.69,
      "end_seconds": 247.19,
      "duration_seconds": 1.5,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.34,
      "end_seconds": 288.62,
      "duration_seconds": 36.28,
      "text": "Good, you can sit up again. Let me tell you where I've got to. This looks most like possible bacterial meningitis. Blood cultures is what I'd like next, for possible meningitis. Let's use benzylpenicillin, 1.2 grams, once now, single dose. It's for possible meningitis. Call an ambulance now, this is an emergency. I'm going to send a referral to the emergency team. If you cannot go now, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.41,
      "end_seconds": 296.75,
      "duration_seconds": 7.34,
      "text": "Please come and see me straight away. Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.85,
      "end_seconds": 301.92,
      "duration_seconds": 4.07,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.77,
      "end_seconds": 304.09,
      "duration_seconds": 1.32,
      "text": "See you soon."
    }
  ]
}