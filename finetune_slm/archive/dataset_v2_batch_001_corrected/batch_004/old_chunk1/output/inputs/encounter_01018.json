{
  "schema_version": "1.0",
  "encounter_id": "01018",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 4.94,
      "duration_seconds": 4.28,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.1,
      "end_seconds": 10.41,
      "duration_seconds": 4.31,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.01,
      "end_seconds": 23.02,
      "duration_seconds": 11.01,
      "text": "Mainly I've been feeling well. That's why I came. I'm hoping you can tell me something definite. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.83,
      "end_seconds": 29.71,
      "duration_seconds": 2.88,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.01,
      "end_seconds": 33.77,
      "duration_seconds": 2.76,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.47,
      "end_seconds": 54.25,
      "duration_seconds": 1.78,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.1,
      "end_seconds": 58.69,
      "duration_seconds": 3.59,
      "text": "so, it's been about a week now"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.57,
      "end_seconds": 62.44,
      "duration_seconds": 2.87,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.58,
      "end_seconds": 69.24,
      "duration_seconds": 5.66,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.66,
      "end_seconds": 70.36,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.91,
      "end_seconds": 81.6,
      "duration_seconds": 9.69,
      "text": "And there's slightly dry skin as well, uh, about four days now. With slightly dry skin, mild, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.52,
      "end_seconds": 88.63,
      "duration_seconds": 6.11,
      "text": "Let me check a few things. Any weight change, feeling cold, constipation or palpitations?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.27,
      "end_seconds": 95.55,
      "duration_seconds": 5.28,
      "text": "no, no weight change, feeling cold, constipation or palpitations"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.7,
      "end_seconds": 99.62,
      "duration_seconds": 2.92,
      "text": "Okay, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.36,
      "end_seconds": 103.0,
      "duration_seconds": 2.64,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.37,
      "end_seconds": 118.71,
      "duration_seconds": 3.34,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.92,
      "end_seconds": 122.22,
      "duration_seconds": 2.3,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.03,
      "end_seconds": 125.56,
      "duration_seconds": 2.53,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.41,
      "end_seconds": 129.87,
      "duration_seconds": 3.46,
      "text": "Yeah, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.97,
      "end_seconds": 134.86,
      "duration_seconds": 2.89,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.94,
      "end_seconds": 148.05,
      "duration_seconds": 11.11,
      "text": "I walk the dog every morning. My husband and I live above the shop. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.13,
      "end_seconds": 167.03,
      "duration_seconds": 3.9,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.41,
      "end_seconds": 171.43,
      "duration_seconds": 3.02,
      "text": "no, nothing I can think of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.44,
      "end_seconds": 182.63,
      "duration_seconds": 3.19,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.92,
      "end_seconds": 191.86,
      "duration_seconds": 1.94,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.13,
      "end_seconds": 226.3,
      "duration_seconds": 16.17,
      "text": "okay: temp 36.5 degrees, weight 85 kilos and blood pressure 118 over 72, BMI works out to 29.8, pulse is 69 beats a minute, height 169 centimetres, saturation 97 percent"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.31,
      "end_seconds": 229.64,
      "duration_seconds": 2.33,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.26,
      "end_seconds": 232.65,
      "duration_seconds": 2.39,
      "text": "I'll interpret them after the examination"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.39,
      "end_seconds": 239.43,
      "duration_seconds": 4.04,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.4,
      "end_seconds": 243.12,
      "duration_seconds": 1.72,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.08,
      "end_seconds": 247.74,
      "duration_seconds": 2.66,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.44,
      "end_seconds": 269.23,
      "duration_seconds": 4.79,
      "text": "Your pulse is steady and your thyroid feels normal in size."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.35,
      "end_seconds": 279.4,
      "duration_seconds": 8.05,
      "text": "Okay, that's enough for me. So where does that leave us? I'd lean towards well-controlled thyroid replacement."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.07,
      "end_seconds": 286.13,
      "duration_seconds": 2.06,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.15,
      "end_seconds": 303.22,
      "duration_seconds": 15.07,
      "text": "I understand the worry. At the moment I'd say it's well-controlled thyroid replacement, and we'll know more once the a thyroid blood test is back. a thyroid blood test is what I'd like next, for annual review."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.73,
      "end_seconds": 307.75,
      "duration_seconds": 3.02,
      "text": "Okay, you know, I'll do it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.78,
      "end_seconds": 325.63,
      "duration_seconds": 15.85,
      "text": "Keep taking the tablet on an empty stomach, apart from coffee. Keep an eye out, and if you notice palpitations or weight change, call us the same day or go to to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.56,
      "end_seconds": 329.0,
      "duration_seconds": 1.44,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.15,
      "end_seconds": 336.46,
      "duration_seconds": 6.31,
      "text": "let's plan a check in twelve months anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.59,
      "end_seconds": 339.82,
      "duration_seconds": 2.23,
      "text": "alright, thanks, take care"
    }
  ]
}