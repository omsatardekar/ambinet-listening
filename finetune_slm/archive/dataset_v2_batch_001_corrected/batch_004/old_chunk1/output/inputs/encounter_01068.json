{
  "schema_version": "1.0",
  "encounter_id": "01068",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 5.72,
      "duration_seconds": 4.52,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.69,
      "end_seconds": 12.37,
      "duration_seconds": 4.68,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.24,
      "end_seconds": 24.49,
      "duration_seconds": 7.25,
      "text": "Honestly, it's a dry cough in the evenings, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.96,
      "end_seconds": 28.8,
      "duration_seconds": 2.84,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.9,
      "end_seconds": 38.87,
      "duration_seconds": 1.97,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.89,
      "end_seconds": 65.11,
      "duration_seconds": 14.22,
      "text": "Okay: weight 63 kilos, BP is 111 over 71, BMI works out to 26.6, saturation 99 percent, height 154 centimetres, respiratory rate 16, temp 36.9 degrees, pulse is 77 beats a minute."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.38,
      "end_seconds": 83.73,
      "duration_seconds": 1.35,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.26,
      "end_seconds": 88.51,
      "duration_seconds": 4.25,
      "text": "Okay, so it's been like this since Friday."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.01,
      "end_seconds": 93.82,
      "duration_seconds": 3.81,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.52,
      "end_seconds": 97.9,
      "duration_seconds": 3.38,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.36,
      "end_seconds": 103.69,
      "duration_seconds": 4.33,
      "text": "Any fever, wheeze or shortness of breath at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.62,
      "end_seconds": 111.49,
      "duration_seconds": 5.87,
      "text": "Sorry, what was I saying, no, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.65,
      "end_seconds": 119.02,
      "duration_seconds": 2.37,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.76,
      "end_seconds": 122.55,
      "duration_seconds": 1.79,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.46,
      "end_seconds": 128.97,
      "duration_seconds": 4.51,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.06,
      "end_seconds": 132.69,
      "duration_seconds": 1.63,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.17,
      "end_seconds": 137.63,
      "duration_seconds": 3.46,
      "text": "Alright, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.58,
      "end_seconds": 141.81,
      "duration_seconds": 2.23,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.62,
      "end_seconds": 145.36,
      "duration_seconds": 2.74,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.99,
      "end_seconds": 149.03,
      "duration_seconds": 2.04,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.58,
      "end_seconds": 166.44,
      "duration_seconds": 2.86,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.19,
      "end_seconds": 170.34,
      "duration_seconds": 3.15,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.0,
      "end_seconds": 172.58,
      "duration_seconds": 1.58,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.86,
      "end_seconds": 178.66,
      "duration_seconds": 4.8,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.21,
      "end_seconds": 181.51,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.14,
      "end_seconds": 185.98,
      "duration_seconds": 2.84,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.23,
      "end_seconds": 199.19,
      "duration_seconds": 2.96,
      "text": "Alright, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.53,
      "end_seconds": 207.5,
      "duration_seconds": 6.97,
      "text": "Atorvastatin, 20 milligrams, at night. Actually, I take loratadine, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.28,
      "end_seconds": 213.78,
      "duration_seconds": 4.5,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.48,
      "end_seconds": 218.45,
      "duration_seconds": 3.97,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.98,
      "end_seconds": 222.49,
      "duration_seconds": 2.51,
      "text": "Right, may I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.02,
      "end_seconds": 225.44,
      "duration_seconds": 1.42,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.2,
      "end_seconds": 247.51,
      "duration_seconds": 5.31,
      "text": "Your chest is clear and your nose looks a little swollen inside."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.94,
      "end_seconds": 253.71,
      "duration_seconds": 2.77,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.88,
      "end_seconds": 279.47,
      "duration_seconds": 14.59,
      "text": "Okay, so my impression is this: It fits best with seasonal hay fever causing the cough. For this, fluticasone nasal spray, 50 micrograms, once a day, for the season. That should help with hay fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.79,
      "end_seconds": 284.28,
      "duration_seconds": 3.49,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.82,
      "end_seconds": 296.61,
      "duration_seconds": 10.79,
      "text": "Keep windows closed on high-pollen days and wash your hair at night. Come back or go to emergency straight away if you start wheezing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.78,
      "end_seconds": 300.75,
      "duration_seconds": 2.97,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.42,
      "end_seconds": 304.05,
      "duration_seconds": 2.63,
      "text": "See me again in a month."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 305.16,
      "end_seconds": 308.54,
      "duration_seconds": 3.38,
      "text": "I can put that appointment in for you now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.13,
      "end_seconds": 318.08,
      "duration_seconds": 7.95,
      "text": "Right, tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.92,
      "end_seconds": 330.61,
      "duration_seconds": 10.69,
      "text": "So, I take the fluticasone nasal spray, 50 micrograms, once a day and come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.08,
      "end_seconds": 339.36,
      "duration_seconds": 5.28,
      "text": "Yes, exactly right. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 343.63,
      "end_seconds": 345.73,
      "duration_seconds": 2.1,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.32,
      "end_seconds": 347.69,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}