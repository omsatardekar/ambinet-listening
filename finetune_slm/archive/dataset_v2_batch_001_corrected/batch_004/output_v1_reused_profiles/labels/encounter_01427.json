  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "caregiver",
      "transcript_text": "We came because of nearly passing out.",
      "start_timestamp": "00:28",
      "end_timestamp": "00:31",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you tell me when it first started?",
      "start_timestamp": "00:33",
      "end_timestamp": "00:36",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Since last Tuesday, that's when it began. I looked a few things up online, and that probably didn't help.",
      "start_timestamp": "00:37",
      "end_timestamp": "00:47",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I get some relief from lying down. It happens once or twice a day. Severe, I'd say. It's a relief to finally sit down and talk about it.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "That's fine, one at a time. I'll ask about everything. Have you had a pounding in the head?",
      "start_timestamp": "01:37",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yeah. About a month, I'd say.",
      "start_timestamp": "01:47",
      "end_timestamp": "01:50",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Rate it for me, mild, moderate or severe?",
      "start_timestamp": "01:51",
      "end_timestamp": "01:55",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Mild, I'd say. And blurred vision for a few seconds, too.",
      "start_timestamp": "01:56",
      "end_timestamp": "02:02",
      "supports": [
        "symptoms[1]",
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, any fainting completely or slurred speech?",
      "start_timestamp": "02:02",
      "end_timestamp": "02:05",
      "supports": [
        "symptoms[3]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "No, no fainting completely, no slurred speech. I was feeling lightheaded at one point, but that went away on its own.",
      "start_timestamp": "02:08",
      "end_timestamp": "02:18",
      "supports": [
        "symptoms[3]",
        "negative_findings[0]",
        "negative_findings[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me check a few things. Any weakness, vomiting or palpitations?",
      "start_timestamp": "02:20",
      "end_timestamp": "02:25",
      "supports": [
        "negative_findings[2]",
        "negative_findings[3]",
        "negative_findings[4]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "None of those, no.",
      "start_timestamp": "02:27",
      "end_timestamp": "02:29",
      "supports": [
        "negative_findings[2]",
        "negative_findings[3]",
        "negative_findings[4]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How are your joints, any aches elsewhere?",
      "start_timestamp": "02:30",
      "end_timestamp": "02:34",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I move fine otherwise.",
      "start_timestamp": "02:34",
      "end_timestamp": "02:36",
      "supports": [
        "review_of_systems[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So, any breathing difficulties apart from this?",
      "start_timestamp": "02:38",
      "end_timestamp": "02:42",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "No, my breathing's been fine.",
      "start_timestamp": "02:43",
      "end_timestamp": "02:46",
      "supports": [
        "review_of_systems[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Alright, do you have any long-term conditions?",
      "start_timestamp": "02:48",
      "end_timestamp": "02:51",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, high blood pressure. I have diabetes, for about ten years. An underactive thyroid, for five years.",
      "start_timestamp": "02:52",
      "end_timestamp": "03:01",
      "supports": [
        "medical_history.past_medical_history[0]",
        "medical_history.past_medical_history[1]",
        "medical_history.past_medical_history[2]",
        "clinical_conditions[0]"
      ]
    },
