    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Good, thank you. Okay, when did this begin?",
      "start_timestamp": "00:44",
      "end_timestamp": "00:48",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "it's been going on for about a month",
