    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "okay, so the vitals from earlier temperature is 37.0 degrees, saturation 89 percent, pulse is 93 beats a minute blood pressure 121 over 82.",
