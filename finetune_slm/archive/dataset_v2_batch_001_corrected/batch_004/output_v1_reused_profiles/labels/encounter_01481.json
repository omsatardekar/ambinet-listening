      "end_timestamp": "01:01",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Moderate, I'd say. Only raising the legs, and it's not much. It's every other day.",
      "start_timestamp": "01:08",
      "end_timestamp": "01:15",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Alright, does anything else come with it?",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
