      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Ever since... since last Tuesday, really.",
      "start_timestamp": "00:55",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Have you had difficulty bending the finger?",
