  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Doctor, it's an itchy painful right ear. It's getting on my nerves now.",
      "start_timestamp": "00:26",
      "end_timestamp": "00:33",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, did it come on recently?",
      "start_timestamp": "00:35",
      "end_timestamp": "00:38",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "It's been two weeks, I'm fairly sure.",
      "start_timestamp": "00:39",
      "end_timestamp": "00:43",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I mean, I'd give it a eight, out of ten. Honestly, all the time. Touching the ear and lying on it definitely sets it off. And there's pain when I move my jaw as well, three days now.",
      "start_timestamp": "00:55",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay, give me more detail on it, whatever comes to mind.",
      "start_timestamp": "01:14",
      "end_timestamp": "01:18",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I notice it more with chewing. It comes and goes.",
      "start_timestamp": "01:20",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you had an itchy painful right ear before, or is this the first time?",
      "start_timestamp": "01:26",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Yes, something like this happened last winter, and it went away on its own.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:40",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_5",
      "speaker_role": "unknown",
      "transcript_text": "Yes, that's right, that's how it was.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[0]",
        "clinical_uncertainties[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "nurse",
      "transcript_text": "Here are the numbers, doctor. Pressure 127 over 82, temperature 36.6. Pulse is 72 beats a minute, oxygen saturation is 98 percent.",
