  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Uh, mainly a dry tickly cough. There's a couple of other things, but that's the main one.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:36",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How long has this been bothering you? I ask because it helps me narrow things down.",
      "start_timestamp": "00:38",
      "end_timestamp": "00:44",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It's been about a year, I'm fairly sure.",
      "start_timestamp": "00:45",
      "end_timestamp": "00:49",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it worse at certain times?",
      "start_timestamp": "00:50",
      "end_timestamp": "00:53",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Okay, so I notice it more with lying down.",
      "start_timestamp": "00:54",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "How much does it limit you?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:03",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:04",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:16",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Uh, you know, about a four out of ten.",
      "start_timestamp": "01:17",
      "end_timestamp": "01:22",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "What eases it, if anything?",
      "start_timestamp": "01:24",
      "end_timestamp": "01:26",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Only sips of water, and it's not much.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it constant or in episodes?",
      "start_timestamp": "01:32",
      "end_timestamp": "01:35",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Mm, it's, um... not exactly... well, hard to explain, I mean—",
      "start_timestamp": "01:37",
      "end_timestamp": "01:45",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Let me put it another way: how many times in a typical day or week?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:55",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "It, It comes and goes.",
      "start_timestamp": "01:57",
      "end_timestamp": "01:59",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Have you noticed anything else alongside it?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "A little breathlessness goes along with it, most of the time.",
      "start_timestamp": "02:05",
      "end_timestamp": "02:11",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Right, I was getting to that! Actually, and I've been coughing at night as well.",
      "start_timestamp": "02:32",
      "end_timestamp": "02:39",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "So, how much trouble does it give you?",
      "start_timestamp": "02:41",
      "end_timestamp": "02:44",
      "supports": [
        "symptoms[2]"
      ]
    },
