    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I have high blood pressure. I have arthritis in my knees. Heart failure, for nearly five years. High cholesterol, for about a year.",
