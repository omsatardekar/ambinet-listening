    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays.",
