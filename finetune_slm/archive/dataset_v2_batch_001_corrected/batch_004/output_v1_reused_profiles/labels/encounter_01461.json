  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "We came because of pain in my right ear.",
      "start_timestamp": "00:25",
      "end_timestamp": "00:30",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Let's run through your medicines.",
      "start_timestamp": "00:31",
      "end_timestamp": "00:33",
      "supports": [
        "medications[0]",
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "He takes Foracort inhaler, twice a day for my asthma. He takes ramipril, 5 milligrams, every morning.",
      "start_timestamp": "00:34",
      "end_timestamp": "00:43",
      "supports": [
        "medications[0]",
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Okay, how long have you taken that?",
      "start_timestamp": "00:45",
      "end_timestamp": "00:48",
      "supports": [
        "medications[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_3",
      "speaker_role": "family_member",
      "transcript_text": "About six months. It's metformin, 500 milligrams, twice a day, doctor. He is on paracetamol, 500 milligrams, when needed, I give it to him.",
      "start_timestamp": "00:48",
      "end_timestamp": "01:01",
      "supports": [
        "medications[1]",
        "medications[2]",
        "medications[3]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Has this been going on for long?",
      "start_timestamp": "01:02",
      "end_timestamp": "01:05",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Since this morning, that's when it began.",
      "start_timestamp": "01:06",
      "end_timestamp": "01:10",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Is it constant or in episodes?",
      "start_timestamp": "01:11",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It happens once or twice a day.",
      "start_timestamp": "01:16",
      "end_timestamp": "01:20",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Right, what do you do to make it better?",
      "start_timestamp": "01:22",
      "end_timestamp": "01:25",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It settles a little with a warm cloth.",
      "start_timestamp": "01:27",
      "end_timestamp": "01:32",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Right, what about a runny nose before it started, have you noticed that?",
      "start_timestamp": "01:33",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yes, that started yesterday. About runny nose before it started, I'd call it mild.",
      "start_timestamp": "01:40",
      "end_timestamp": "01:47",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "What about muffled hearing, have you noticed that?",
      "start_timestamp": "01:48",
      "end_timestamp": "01:52",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_015",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Yeah. Three days, I'd say.",
      "start_timestamp": "01:56",
      "end_timestamp": "01:59",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_016",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Would you say mild, moderate or severe?",
      "start_timestamp": "02:01",
      "end_timestamp": "02:04",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_017",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'd call it moderate.",
      "start_timestamp": "02:07",
      "end_timestamp": "02:10",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_018",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Have you had pain in your right ear before, or is this the first time?",
      "start_timestamp": "02:12",
      "end_timestamp": "02:18",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_019",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I had a similar thing about six months ago. It went away.",
      "start_timestamp": "02:19",
      "end_timestamp": "02:24",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_020",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
