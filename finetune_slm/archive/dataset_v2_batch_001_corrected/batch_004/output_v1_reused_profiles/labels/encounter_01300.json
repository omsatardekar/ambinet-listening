    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "Oh, you know, I'd say two weeks. Actually, no, closer to four weeks. I'd rather know what's going on than keep guessing.",
