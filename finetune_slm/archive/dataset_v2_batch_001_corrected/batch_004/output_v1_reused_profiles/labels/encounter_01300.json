    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Understood. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. Bear with me, I'm just building up the picture.",
