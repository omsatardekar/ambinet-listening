    },
    {
      "evidence_id": "EV_029",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "I can't promise yet, but most people with dyspepsia possibly related to anti-inflammatory tablets do well once it's treated properly. Blood tests is what I'd like next, for dyspepsia. I'd like to arrange a test for the stomach germ for dyspepsia. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose.",
      "start_timestamp": "05:21",
      "end_timestamp": "05:55",
