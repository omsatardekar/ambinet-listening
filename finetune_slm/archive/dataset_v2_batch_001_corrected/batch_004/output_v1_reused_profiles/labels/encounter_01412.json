    },
    {
      "evidence_id": "EV_027",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "I've had acid reflux for nearly five years now. I'm hoping you can tell me something definite. I told myself I'd wait and see, you know, and here I am.",
