    {
      "evidence_id": "EV_022",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Okay: pulse 67, height 163 centimetres, BP is 126 over 72, temp 36.7 degrees, weight 63 kilos, BMI works out to 23.7.",
