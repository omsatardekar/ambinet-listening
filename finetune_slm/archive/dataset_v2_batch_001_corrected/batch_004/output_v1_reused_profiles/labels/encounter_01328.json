  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "family_member",
      "transcript_text": "She's been having a bump on my head, doctor.",
      "start_timestamp": "00:40",
      "end_timestamp": "00:45",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "When was the first time you noticed it?",
      "start_timestamp": "00:47",
      "end_timestamp": "00:50",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "It's been ten days, I'm fairly sure.",
      "start_timestamp": "00:54",
      "end_timestamp": "00:58",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "is it accompanied by anything?",
      "start_timestamp": "01:00",
      "end_timestamp": "01:02",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "When it starts I tend to get a headache since the fall as well.",
      "start_timestamp": "01:03",
      "end_timestamp": "01:12",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Later, thanks. Please go on. Has there been a bit of nausea too?",
      "start_timestamp": "01:27",
      "end_timestamp": "01:33",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Ah, uh, yeah. Three days, I'd say.",
      "start_timestamp": "01:34",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse.",
      "start_timestamp": "01:41",
      "end_timestamp": "01:52",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I mean, you know, I'd say on and off. Pretty moderate, if I'm being honest",
      "start_timestamp": "01:57",
      "end_timestamp": "02:05",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "How troublesome is it day to day?",
      "start_timestamp": "02:09",
      "end_timestamp": "02:12",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to to say, it's kind of... I don't know—",
      "start_timestamp": "02:15",
      "end_timestamp": "02:21",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "Take your time. Mild, moderate, or severe, if you had to pick?",
      "start_timestamp": "02:22",
      "end_timestamp": "02:28",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "patient",
      "transcript_text": "I'd say severe",
      "start_timestamp": "02:30",
      "end_timestamp": "02:31",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_1",
      "speaker_role": "doctor",
      "transcript_text": "So, have you been feeling dizzy?",
      "start_timestamp": "02:32",
      "end_timestamp": "02:35",
      "supports": [
        "symptoms[3]"
      ]
    },
    {
      "evidence_id": "EV_015",
