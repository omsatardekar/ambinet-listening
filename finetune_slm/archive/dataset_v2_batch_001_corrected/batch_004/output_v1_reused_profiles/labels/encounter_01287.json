  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_1",
      "speaker_role": "patient",
      "transcript_text": "Okay, so it's a lump feeling in the throat, mostly. I thought it would sort itself out, but it hasn't.",
