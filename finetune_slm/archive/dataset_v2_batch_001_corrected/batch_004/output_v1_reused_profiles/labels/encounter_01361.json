      "end_timestamp": "01:17",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "As for sour taste in the mouth, I honestly can't say when that began. It might have been last month or the month before. As for sour taste in the mouth, about a five out of ten.",
