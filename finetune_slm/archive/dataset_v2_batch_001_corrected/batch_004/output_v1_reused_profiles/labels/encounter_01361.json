        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "It sort of comes and goes.",
      "start_timestamp": "00:49",
      "end_timestamp": "00:52",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Is it accompanied by anything?",
