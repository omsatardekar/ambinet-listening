      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_3",
      "speaker_role": "patient",
      "transcript_text": "A sour taste in the mouth goes along with it, most of the time. And bloating after meals, too.",
