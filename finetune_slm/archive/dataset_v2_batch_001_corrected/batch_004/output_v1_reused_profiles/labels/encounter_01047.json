  "clinical_evidence": [
    {
      "evidence_id": "EV_001",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "um, I've been dealing with a tight feeling in my chest when I walk uphill",
      "start_timestamp": "00:28",
      "end_timestamp": "00:36",
      "supports": [
        "chief_complaint",
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_002",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "alright when was the first time you noticed it?",
      "start_timestamp": "00:37",
      "end_timestamp": "00:41",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_003",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "it's been about a year, I'm fairly sure. A neighbour of mine said I should see someone about it. I kept putting it off, which I know isn't sensible",
      "start_timestamp": "00:42",
      "end_timestamp": "00:56",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_004",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "is it bearing on you a lot?",
      "start_timestamp": "00:57",
      "end_timestamp": "01:00",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_005",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Well, it's... hard to say, it's kind of... I don't know—",
      "start_timestamp": "01:02",
      "end_timestamp": "01:08",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_006",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "take your time. Mild moderate or severe if you had to pick?",
      "start_timestamp": "01:09",
      "end_timestamp": "01:14",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_007",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Moderate I'd say",
      "start_timestamp": "01:16",
      "end_timestamp": "01:17",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_008",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "what brings it on?",
      "start_timestamp": "01:19",
      "end_timestamp": "01:21",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_009",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "Cold weather definitely sets it off.",
      "start_timestamp": "01:24",
      "end_timestamp": "01:28",
      "supports": [
        "symptoms[0]"
      ]
    },
    {
      "evidence_id": "EV_010",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "Any other symptoms with it?",
      "start_timestamp": "01:29",
      "end_timestamp": "01:31",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_011",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "A heaviness in my left arm goes along with it, most of the time.",
      "start_timestamp": "01:33",
      "end_timestamp": "01:39",
      "supports": [
        "symptoms[0]",
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_012",
      "speaker_id": "person_4",
      "speaker_role": "patient",
      "transcript_text": "I was getting to that! The heaviness in my left arm? That's been for nearly five years",
      "start_timestamp": "01:54",
      "end_timestamp": "02:02",
      "supports": [
        "symptoms[1]"
      ]
    },
    {
      "evidence_id": "EV_013",
      "speaker_id": "person_2",
      "speaker_role": "doctor",
      "transcript_text": "okay, has there been breathlessness on exertion too?",
      "start_timestamp": "02:04",
      "end_timestamp": "02:08",
      "supports": [
        "symptoms[2]"
      ]
    },
    {
      "evidence_id": "EV_014",
      "speaker_id": "person_4",
