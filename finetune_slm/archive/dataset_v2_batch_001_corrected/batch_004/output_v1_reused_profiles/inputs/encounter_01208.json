{
  "schema_version": "1.0",
  "encounter_id": "01208",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.96,
      "duration_seconds": 3.74,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 10.93,
      "duration_seconds": 4.11,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.75,
      "end_seconds": 21.35,
      "duration_seconds": 8.6,
      "text": "Mainly tingling in my left foot. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.65,
      "end_seconds": 26.5,
      "duration_seconds": 3.85,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.88,
      "end_seconds": 42.09,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.51,
      "end_seconds": 70.09,
      "duration_seconds": 10.58,
      "text": "Okay: saturation 98 percent, pressure 125 over 78, respiratory rate 18. And temperature 36.6, pulse 78. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.7,
      "end_seconds": 80.3,
      "duration_seconds": 8.6,
      "text": "I've had it for about a year. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.84,
      "end_seconds": 86.32,
      "duration_seconds": 5.48,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.94,
      "end_seconds": 91.78,
      "duration_seconds": 3.84,
      "text": "It's severe, honestly. I'd say on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.33,
      "end_seconds": 96.75,
      "duration_seconds": 3.42,
      "text": "Have you had bowel problems, by any chance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.78,
      "end_seconds": 100.72,
      "duration_seconds": 1.94,
      "text": "Nope, no bowel problems."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.85,
      "end_seconds": 108.24,
      "duration_seconds": 6.39,
      "text": "Let me check a few things. Any weight loss, fever or numbness between the legs?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.55,
      "end_seconds": 112.88,
      "duration_seconds": 3.33,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.53,
      "end_seconds": 116.61,
      "duration_seconds": 2.08,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.85,
      "end_seconds": 120.78,
      "duration_seconds": 2.93,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.74,
      "end_seconds": 124.06,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.75,
      "end_seconds": 130.94,
      "duration_seconds": 1.19,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.62,
      "end_seconds": 135.31,
      "duration_seconds": 2.69,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.26,
      "end_seconds": 142.89,
      "duration_seconds": 5.63,
      "text": "It's telmisartan, 40 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.63,
      "end_seconds": 157.74,
      "duration_seconds": 2.11,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.87,
      "end_seconds": 161.33,
      "duration_seconds": 2.46,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.08,
      "end_seconds": 167.83,
      "duration_seconds": 2.75,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.91,
      "end_seconds": 172.76,
      "duration_seconds": 2.85,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.54,
      "end_seconds": 178.73,
      "duration_seconds": 1.19,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.8,
      "end_seconds": 184.05,
      "duration_seconds": 3.25,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.94,
      "end_seconds": 188.65,
      "duration_seconds": 2.71,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.23,
      "end_seconds": 195.69,
      "duration_seconds": 3.46,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.64,
      "end_seconds": 202.01,
      "duration_seconds": 4.37,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.5,
      "end_seconds": 205.78,
      "duration_seconds": 2.28,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.68,
      "end_seconds": 218.27,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.73,
      "end_seconds": 222.13,
      "duration_seconds": 2.4,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.98,
      "end_seconds": 226.01,
      "duration_seconds": 2.03,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.9,
      "end_seconds": 229.81,
      "duration_seconds": 2.91,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 253.05,
      "duration_seconds": 10.3,
      "text": "Straight leg raising on the left brings on the leg pain at about forty degrees, and the power and reflexes are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.91,
      "end_seconds": 257.83,
      "duration_seconds": 1.92,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.61,
      "end_seconds": 279.22,
      "duration_seconds": 6.61,
      "text": "So where does that leave us? This is probably sciatica from a lumbar disc irritation."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.04,
      "end_seconds": 284.32,
      "duration_seconds": 3.28,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.13,
      "end_seconds": 296.21,
      "duration_seconds": 11.08,
      "text": "I understand the worry. At the moment I'd say it's sciatica from a lumbar disc irritation, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.65,
      "end_seconds": 319.3,
      "duration_seconds": 9.65,
      "text": "I'll request blood tests, it'll help with back pain. I'll request an MRI of the lower back, it'll help with sciatica."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.56,
      "end_seconds": 323.72,
      "duration_seconds": 3.16,
      "text": "Okay, uh, I'll do it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.59,
      "end_seconds": 355.36,
      "duration_seconds": 29.77,
      "text": "What I'm giving you is naproxen, 500 milligrams, twice a day with food, for one week. It's for back and leg pain. Stay active and keep walking, bed rest makes this slower to settle. I think physiotherapy should see you too. If you get numbness between the legs or trouble passing urine, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.05,
      "end_seconds": 358.25,
      "duration_seconds": 2.2,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.84,
      "end_seconds": 362.65,
      "duration_seconds": 2.81,
      "text": "We'll catch up after the scan."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.1,
      "end_seconds": 370.12,
      "duration_seconds": 2.02,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.8,
      "end_seconds": 380.0,
      "duration_seconds": 8.2,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.94,
      "end_seconds": 392.68,
      "duration_seconds": 10.74,
      "text": "So, I take the naproxen, 500 milligrams, twice a day with food and come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.39,
      "end_seconds": 403.83,
      "duration_seconds": 5.44,
      "text": "Right, yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.1,
      "end_seconds": 408.82,
      "duration_seconds": 3.72,
      "text": "Great, um, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 410.67,
      "end_seconds": 412.04,
      "duration_seconds": 1.37,
      "text": "All the best."
    }
  ]
}