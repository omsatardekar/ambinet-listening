{
  "schema_version": "1.0",
  "encounter_id": "01360",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 4.6,
      "duration_seconds": 3.21,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.57,
      "end_seconds": 8.45,
      "duration_seconds": 2.88,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.4,
      "end_seconds": 14.08,
      "duration_seconds": 3.68,
      "text": "what would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.97,
      "end_seconds": 19.52,
      "duration_seconds": 3.55,
      "text": "I've been dealing with a swollen leg."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.2,
      "end_seconds": 24.36,
      "duration_seconds": 4.16,
      "text": "When was the the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.62,
      "end_seconds": 28.83,
      "duration_seconds": 3.21,
      "text": "well, it's been two weeks now"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.59,
      "end_seconds": 31.93,
      "duration_seconds": 2.34,
      "text": "what eases it, if anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.59,
      "end_seconds": 40.28,
      "duration_seconds": 2.69,
      "text": "Raising it helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.97,
      "end_seconds": 60.55,
      "duration_seconds": 2.58,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.82,
      "end_seconds": 62.98,
      "duration_seconds": 1.16,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.07,
      "end_seconds": 67.45,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.3,
      "end_seconds": 71.55,
      "duration_seconds": 3.25,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.33,
      "end_seconds": 76.39,
      "duration_seconds": 4.06,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.38,
      "end_seconds": 81.95,
      "duration_seconds": 3.57,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.48,
      "end_seconds": 86.27,
      "duration_seconds": 2.79,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.46,
      "end_seconds": 89.83,
      "duration_seconds": 2.37,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.62,
      "end_seconds": 105.48,
      "duration_seconds": 4.86,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.02,
      "end_seconds": 110.29,
      "duration_seconds": 3.27,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.02,
      "end_seconds": 127.64,
      "duration_seconds": 4.62,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.91,
      "end_seconds": 130.45,
      "duration_seconds": 1.54,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.69,
      "end_seconds": 141.01,
      "duration_seconds": 5.32,
      "text": "Let me check a few things. Any chest pain, vomiting or pus?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.84,
      "end_seconds": 146.87,
      "duration_seconds": 4.03,
      "text": "No, no chest pain, vomiting or pus."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.39,
      "end_seconds": 149.37,
      "duration_seconds": 1.98,
      "text": "Has there been any breathlessness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.2,
      "end_seconds": 153.47,
      "duration_seconds": 2.27,
      "text": "No, none, no breathlessness."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.81,
      "end_seconds": 157.63,
      "duration_seconds": 2.82,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.96,
      "end_seconds": 162.15,
      "duration_seconds": 3.19,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.12,
      "end_seconds": 167.38,
      "duration_seconds": 2.26,
      "text": "is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.6,
      "end_seconds": 170.7,
      "duration_seconds": 2.1,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 184.51,
      "duration_seconds": 2.4,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.52,
      "end_seconds": 198.46,
      "duration_seconds": 2.94,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.35,
      "end_seconds": 220.25,
      "duration_seconds": 10.9,
      "text": "okay: SpO2 96 percent on room air, temperature is 38.1 degrees. And heart rate 105, pressure 124 over 66, respiratory rate 16."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.11,
      "end_seconds": 224.36,
      "duration_seconds": 2.25,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.53,
      "end_seconds": 229.26,
      "duration_seconds": 3.73,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.56,
      "end_seconds": 234.65,
      "duration_seconds": 4.09,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.93,
      "end_seconds": 237.27,
      "duration_seconds": 1.34,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.42,
      "end_seconds": 241.07,
      "duration_seconds": 2.65,
      "text": "Hold that that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.87,
      "end_seconds": 263.67,
      "duration_seconds": 7.8,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.31,
      "end_seconds": 284.18,
      "duration_seconds": 15.87,
      "text": "that's all I needed to check. Let me tell you where I've got to. This looks most like cellulitis of the right leg. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.91,
      "end_seconds": 292.77,
      "duration_seconds": 2.86,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.11,
      "end_seconds": 311.56,
      "duration_seconds": 17.45,
      "text": "Nothing I've seen today points to an emergency. It looks like cellulitis of the right leg, but I'd like to confirm. Just to be sure I understood. You've had a swollen leg for two weeks, and no chest pain or vomiting."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.33,
      "end_seconds": 314.58,
      "duration_seconds": 2.25,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.71,
      "end_seconds": 319.42,
      "duration_seconds": 3.71,
      "text": "I'd like to arrange blood tests for skin infection."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.23,
      "end_seconds": 323.16,
      "duration_seconds": 2.93,
      "text": "How long will it it take?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.15,
      "end_seconds": 354.65,
      "duration_seconds": 29.5,
      "text": "The treatment will be flucloxacillin, 500 milligrams, four times a day, for seven days. You take it by mouth. It's for cellulitis. Mark the edge of the redness with a pen and keep the leg raised when sitting. One warning sign to remember: the redness spreads quickly or you get a high fever. In that case don't wait. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.07,
      "end_seconds": 358.15,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}