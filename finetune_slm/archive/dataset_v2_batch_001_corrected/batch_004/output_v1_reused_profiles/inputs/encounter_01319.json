{
  "schema_version": "1.0",
  "encounter_id": "01319",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.54,
      "duration_seconds": 6.27,
      "text": "So, uh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.23,
      "end_seconds": 13.59,
      "duration_seconds": 4.36,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.63,
      "end_seconds": 23.33,
      "duration_seconds": 8.7,
      "text": "It's, It's nausea in the mornings. I thought I'd wait, um, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.29,
      "end_seconds": 27.25,
      "duration_seconds": 1.96,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.3,
      "end_seconds": 41.83,
      "duration_seconds": 2.53,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.44,
      "end_seconds": 71.51,
      "duration_seconds": 8.07,
      "text": "Okay: pressure 118 over 79, temperature 36.4, pulse 85. And respiratory rate 14. When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.43,
      "end_seconds": 78.84,
      "duration_seconds": 6.41,
      "text": "Let me think, um, it's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.55,
      "end_seconds": 89.37,
      "duration_seconds": 8.82,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.54,
      "end_seconds": 97.72,
      "duration_seconds": 7.18,
      "text": "So, only dry biscuits, and it's not much. I'd call it moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.49,
      "end_seconds": 101.34,
      "duration_seconds": 2.85,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.04,
      "end_seconds": 110.0,
      "duration_seconds": 6.96,
      "text": "A missed period goes along with it, uh, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.43,
      "end_seconds": 120.69,
      "duration_seconds": 6.26,
      "text": "Have you had nausea in the mornings before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.73,
      "end_seconds": 127.1,
      "duration_seconds": 5.37,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.06,
      "end_seconds": 131.14,
      "duration_seconds": 3.08,
      "text": "Any vomiting everything or dizziness at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.95,
      "end_seconds": 135.35,
      "duration_seconds": 3.4,
      "text": "No, no vomiting everything or dizziness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.94,
      "end_seconds": 141.44,
      "duration_seconds": 4.5,
      "text": "Have you noticed burning when passing urine or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.27,
      "end_seconds": 146.31,
      "duration_seconds": 3.04,
      "text": "Right, none of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.61,
      "end_seconds": 153.79,
      "duration_seconds": 3.18,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.8,
      "end_seconds": 157.26,
      "duration_seconds": 1.46,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.88,
      "end_seconds": 169.17,
      "duration_seconds": 3.29,
      "text": "So, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.47,
      "end_seconds": 182.61,
      "duration_seconds": 12.14,
      "text": "Let me think, I've had an underactive thyroid for two years now. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.68,
      "end_seconds": 186.01,
      "duration_seconds": 2.33,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.66,
      "end_seconds": 190.7,
      "duration_seconds": 4.04,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.17,
      "end_seconds": 195.32,
      "duration_seconds": 3.15,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.53,
      "end_seconds": 200.98,
      "duration_seconds": 4.45,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.38,
      "end_seconds": 204.7,
      "duration_seconds": 2.32,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.62,
      "end_seconds": 220.07,
      "duration_seconds": 10.45,
      "text": "So, I'm on Thyronorm, 50 micrograms, every morning. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.9,
      "end_seconds": 227.06,
      "duration_seconds": 3.16,
      "text": "Okay, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.07,
      "end_seconds": 231.98,
      "duration_seconds": 3.91,
      "text": "Amoxicillin. I come out in... well, hives."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.68,
      "end_seconds": 244.57,
      "duration_seconds": 2.89,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.34,
      "end_seconds": 252.51,
      "duration_seconds": 6.17,
      "text": "Yeah, just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 257.57,
      "duration_seconds": 2.93,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.19,
      "end_seconds": 260.91,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.44,
      "end_seconds": 280.58,
      "duration_seconds": 6.14,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.9,
      "end_seconds": 297.61,
      "duration_seconds": 11.71,
      "text": "Please sit back down. Taking everything into account, I'm honestly not certain yet. It could be an early pregnancy, or it might be a late period for another reason."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.29,
      "end_seconds": 303.63,
      "duration_seconds": 4.34,
      "text": "Mm, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.51,
      "end_seconds": 314.54,
      "duration_seconds": 10.03,
      "text": "I understand the worry. At the moment I'd say it's an early pregnancy, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.98,
      "end_seconds": 349.43,
      "duration_seconds": 16.45,
      "text": "I'm sending you for blood tests because of antenatal screening. I'd rather check than guess, and this is the quickest way to know more. An early scan is what I'd like next, for early pregnancy."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.33,
      "end_seconds": 355.39,
      "duration_seconds": 4.06,
      "text": "So, um, is that done today?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.29,
      "end_seconds": 366.09,
      "duration_seconds": 9.8,
      "text": "We'll begin with folic acid, 5 milligrams, once a day, until twelve weeks. You take it by mouth. That should help with pregnancy."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.72,
      "end_seconds": 374.39,
      "duration_seconds": 6.67,
      "text": "I mean, uh, can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.57,
      "end_seconds": 405.43,
      "duration_seconds": 25.86,
      "text": "Avoid alcohol and don't take any new tablets without checking with us first. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. I'm not ordering a pregnancy test today. If things carry on in a month, we'll consider it. Book a review after the scan. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.04,
      "end_seconds": 410.93,
      "duration_seconds": 3.89,
      "text": "Well, great, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.56,
      "end_seconds": 414.02,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}