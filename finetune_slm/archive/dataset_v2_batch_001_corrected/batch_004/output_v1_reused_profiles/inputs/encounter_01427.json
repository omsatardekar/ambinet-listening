{
  "schema_version": "1.0",
  "encounter_id": "01427",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 6.56,
      "duration_seconds": 5.66,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.75,
      "end_seconds": 17.64,
      "duration_seconds": 4.89,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.17,
      "end_seconds": 22.53,
      "duration_seconds": 3.36,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.29,
      "end_seconds": 27.4,
      "duration_seconds": 4.11,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 28.63,
      "end_seconds": 31.9,
      "duration_seconds": 3.27,
      "text": "We came because of nearly passing out."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.26,
      "end_seconds": 36.38,
      "duration_seconds": 3.12,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.94,
      "end_seconds": 47.43,
      "duration_seconds": 9.49,
      "text": "Since last Tuesday, that's when it began. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.24,
      "end_seconds": 58.81,
      "duration_seconds": 9.57,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.48,
      "end_seconds": 77.32,
      "duration_seconds": 13.84,
      "text": "I get some relief from lying down. It happens once or twice a day. Severe, I'd say. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 78.2,
      "end_seconds": 85.74,
      "duration_seconds": 7.54,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 85.84,
      "end_seconds": 91.73,
      "duration_seconds": 5.89,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.49,
      "end_seconds": 96.29,
      "duration_seconds": 2.8,
      "text": "I, I was getting to that!"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.96,
      "end_seconds": 105.82,
      "duration_seconds": 7.86,
      "text": "That's fine, one at a time. I'll ask about everything. Have you had a pounding in the head?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.39,
      "end_seconds": 110.56,
      "duration_seconds": 3.17,
      "text": "Yeah. About a month, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.33,
      "end_seconds": 115.25,
      "duration_seconds": 3.92,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 116.6,
      "end_seconds": 122.07,
      "duration_seconds": 5.47,
      "text": "Mild, I'd say. And blurred vision for a few seconds, too."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.75,
      "end_seconds": 125.92,
      "duration_seconds": 3.17,
      "text": "Okay, any fainting completely or slurred speech?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.01,
      "end_seconds": 138.82,
      "duration_seconds": 10.81,
      "text": "No, no fainting completely, no slurred speech. I was feeling lightheaded at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.7,
      "end_seconds": 145.97,
      "duration_seconds": 5.27,
      "text": "Let me check a few things. Any weakness, vomiting or palpitations?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.17,
      "end_seconds": 149.32,
      "duration_seconds": 2.15,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.9,
      "end_seconds": 154.16,
      "duration_seconds": 3.26,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 154.92,
      "end_seconds": 156.98,
      "duration_seconds": 2.06,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.69,
      "end_seconds": 162.24,
      "duration_seconds": 3.55,
      "text": "So, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 163.87,
      "end_seconds": 166.41,
      "duration_seconds": 2.54,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.3,
      "end_seconds": 171.52,
      "duration_seconds": 3.22,
      "text": "Alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.62,
      "end_seconds": 181.93,
      "duration_seconds": 9.31,
      "text": "Yes, high blood pressure. I have diabetes, for about ten years. An underactive thyroid, for five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.85,
      "end_seconds": 190.68,
      "duration_seconds": 7.83,
      "text": "Alright, an underactive thyroid, that matches what I have here. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.65,
      "end_seconds": 193.44,
      "duration_seconds": 1.79,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.33,
      "end_seconds": 199.33,
      "duration_seconds": 5.0,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 199.94,
      "end_seconds": 215.14,
      "duration_seconds": 15.2,
      "text": "I'll have a glass of wine with dinner. I smoke roughly a pack every two days. Lots of rice, lentils and some fruit. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.38,
      "end_seconds": 221.4,
      "duration_seconds": 4.02,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.77,
      "end_seconds": 231.55,
      "duration_seconds": 8.78,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.5,
      "end_seconds": 235.72,
      "duration_seconds": 2.22,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 237.2,
      "end_seconds": 245.12,
      "duration_seconds": 7.92,
      "text": "It's, It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.39,
      "end_seconds": 248.75,
      "duration_seconds": 2.36,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.71,
      "end_seconds": 268.3,
      "duration_seconds": 17.59,
      "text": "Actually, uh, for my pressure, I believe. My son sets them out for me, I just take what I'm given. Uh, I was on thyroxine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 269.37,
      "end_seconds": 279.84,
      "duration_seconds": 10.47,
      "text": "Here are the numbers, doctor. Heart rate 112, pressure 104 over 64, oxygen saturation is 98 percent, temperature is 36.9 degrees, respiratory rate 16."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.55,
      "end_seconds": 281.25,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.62,
      "end_seconds": 287.48,
      "duration_seconds": 3.86,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.68,
      "end_seconds": 305.38,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.7,
      "end_seconds": 308.08,
      "duration_seconds": 1.38,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.91,
      "end_seconds": 318.65,
      "duration_seconds": 1.74,
      "text": "Heart rhythm is regular."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.6,
      "end_seconds": 321.74,
      "duration_seconds": 2.14,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.15,
      "end_seconds": 341.26,
      "duration_seconds": 4.11,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.64,
      "end_seconds": 357.23,
      "duration_seconds": 12.59,
      "text": "Okay, that's enough for me. So where does that leave us? This looks most like postural low blood pressure. Dehydration is still possible. Another possibility is a heart rhythm problem."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 360.67,
      "end_seconds": 362.79,
      "duration_seconds": 2.12,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.29,
      "end_seconds": 383.48,
      "duration_seconds": 19.19,
      "text": "I can't promise yet, but most people with postural low blood pressure do well once it's treated properly. Let me repeat that back to make sure. You've had nearly passing out, since last Tuesday, severe, and no vomiting or slurred speech."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 385.08,
      "end_seconds": 385.78,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.52,
      "end_seconds": 400.6,
      "duration_seconds": 7.08,
      "text": "We should do a blood sugar test for dizziness. Let's book blood tests to look into dizziness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.66,
      "end_seconds": 404.08,
      "duration_seconds": 1.42,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 408.45,
      "end_seconds": 411.84,
      "duration_seconds": 3.39,
      "text": "We've already done an ECG this morning, doctor."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.89,
      "end_seconds": 428.51,
      "duration_seconds": 14.62,
      "text": "Okay, good, thanks for doing that. Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. See me again in two weeks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 429.23,
      "end_seconds": 429.93,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.8,
      "end_seconds": 434.93,
      "duration_seconds": 4.13,
      "text": "Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.21,
      "end_seconds": 439.15,
      "duration_seconds": 2.94,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.93,
      "end_seconds": 441.4,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}