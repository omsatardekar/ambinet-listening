{
  "schema_version": "1.0",
  "encounter_id": "01066",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.11,
      "end_seconds": 7.57,
      "duration_seconds": 6.46,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.34,
      "end_seconds": 13.06,
      "duration_seconds": 4.72,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.09,
      "end_seconds": 23.06,
      "duration_seconds": 7.97,
      "text": "Let me think, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.89,
      "end_seconds": 26.46,
      "duration_seconds": 2.57,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.57,
      "end_seconds": 31.24,
      "duration_seconds": 3.67,
      "text": "Well, I've been having my arms jerking."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.28,
      "end_seconds": 34.51,
      "duration_seconds": 1.23,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.45,
      "end_seconds": 38.45,
      "duration_seconds": 3.0,
      "text": "Around about a month, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 39.22,
      "end_seconds": 42.99,
      "duration_seconds": 3.77,
      "text": "Hm, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.76,
      "end_seconds": 48.12,
      "duration_seconds": 4.36,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 50.09,
      "end_seconds": 54.18,
      "duration_seconds": 4.09,
      "text": "Let me think, I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.72,
      "end_seconds": 58.16,
      "duration_seconds": 3.44,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.19,
      "end_seconds": 60.72,
      "duration_seconds": 1.53,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.05,
      "end_seconds": 65.43,
      "duration_seconds": 4.38,
      "text": "Yes, carry on. Have you had a headache afterwards?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.11,
      "end_seconds": 85.6,
      "duration_seconds": 15.49,
      "text": "Yes, for one week. I've also been passing out for a couple of minutes. So, with passing out for a couple of minutes, it feels mild to me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.12,
      "end_seconds": 92.93,
      "duration_seconds": 5.81,
      "text": "Have you had your arms jerking before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.52,
      "end_seconds": 98.76,
      "duration_seconds": 5.24,
      "text": "Ah, a bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.5,
      "end_seconds": 104.36,
      "duration_seconds": 3.86,
      "text": "Alright, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.75,
      "end_seconds": 117.07,
      "duration_seconds": 11.32,
      "text": "I have high blood pressure, for nearly five years. I have an underactive thyroid. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 120.62,
      "duration_seconds": 1.51,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.73,
      "end_seconds": 127.85,
      "duration_seconds": 6.12,
      "text": "High cholesterol, for about ten years. I have migraines, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.23,
      "end_seconds": 138.69,
      "duration_seconds": 9.46,
      "text": "Yes, high cholesterol and migraines are known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.82,
      "end_seconds": 142.47,
      "duration_seconds": 2.65,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.19,
      "end_seconds": 148.55,
      "duration_seconds": 4.36,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 149.53,
      "end_seconds": 152.89,
      "duration_seconds": 3.36,
      "text": "So, he takes ramipril, every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.46,
      "end_seconds": 155.52,
      "duration_seconds": 2.06,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 156.28,
      "end_seconds": 167.69,
      "duration_seconds": 11.41,
      "text": "It's 5 milligrams. He takes Eltroxin, 100 micrograms, every morning for my thyroid. He takes propranolol, 40 milligrams, twice a day for the migraine prevention."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.99,
      "end_seconds": 187.9,
      "duration_seconds": 4.91,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.58,
      "end_seconds": 205.33,
      "duration_seconds": 11.75,
      "text": "Not much, I mostly stay in these days. My partner and our baby. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.48,
      "end_seconds": 226.28,
      "duration_seconds": 4.8,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.62,
      "end_seconds": 232.13,
      "duration_seconds": 4.51,
      "text": "My grandfather had a stroke. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.48,
      "end_seconds": 239.01,
      "duration_seconds": 5.53,
      "text": "Let me check a few things. Any weakness, vomiting or palpitations?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.05,
      "end_seconds": 245.08,
      "duration_seconds": 4.03,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.45,
      "end_seconds": 250.87,
      "duration_seconds": 4.42,
      "text": "Let me check a few things. Any head injury or fever?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 252.58,
      "end_seconds": 254.88,
      "duration_seconds": 2.3,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.17,
      "end_seconds": 258.64,
      "duration_seconds": 2.47,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.02,
      "end_seconds": 261.53,
      "duration_seconds": 1.51,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.18,
      "end_seconds": 264.85,
      "duration_seconds": 2.67,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.99,
      "end_seconds": 271.67,
      "duration_seconds": 3.68,
      "text": "Nothing on the skin, um, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 281.71,
      "end_seconds": 290.02,
      "duration_seconds": 8.31,
      "text": "Doctor, I've got the readings for you. Saturation 99 percent, pulse 66, temperature is 36.6 degrees, pressure 110 over 72."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.96,
      "end_seconds": 293.56,
      "duration_seconds": 1.6,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.76,
      "end_seconds": 298.4,
      "duration_seconds": 3.64,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.83,
      "end_seconds": 302.71,
      "duration_seconds": 2.88,
      "text": "Alright, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.74,
      "end_seconds": 317.42,
      "duration_seconds": 4.68,
      "text": "The neurological examination is normal, with steady walking and equal power."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.64,
      "end_seconds": 335.48,
      "duration_seconds": 13.84,
      "text": "You can relax now. Taking everything into account, I think we're dealing with a possible first seizure at this stage. A faint with some jerking is still possible."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 336.18,
      "end_seconds": 339.89,
      "duration_seconds": 3.71,
      "text": "I've already done an ECG, it's ready for you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.9,
      "end_seconds": 348.05,
      "duration_seconds": 6.15,
      "text": "Thanks, that helps. So, have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.36,
      "end_seconds": 357.09,
      "duration_seconds": 7.73,
      "text": "I did have a brain scan done last year, but the paper's at home."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.03,
      "end_seconds": 388.42,
      "duration_seconds": 30.39,
      "text": "Let's book an EEG to look into possible seizure. No driving until you have been seen in the clinic, and avoid swimming or climbing alone. I'm going to send a referral to the epilepsy clinic. If you have another episode or one lasts more than five minutes, or you feel really unwell, please come to the emergency department. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.81,
      "end_seconds": 393.27,
      "duration_seconds": 3.46,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}