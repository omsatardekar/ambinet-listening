{
  "schema_version": "1.0",
  "encounter_id": "01303",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 6.98,
      "duration_seconds": 5.77,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.33,
      "end_seconds": 13.22,
      "duration_seconds": 4.89,
      "text": "Alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.74,
      "end_seconds": 23.91,
      "duration_seconds": 9.17,
      "text": "Doctor, thank you for seeing us. Right, doctor, it's pain in my right ear. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.73,
      "end_seconds": 29.54,
      "duration_seconds": 3.81,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.49,
      "end_seconds": 34.9,
      "duration_seconds": 4.41,
      "text": "Yeah, um, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.43,
      "end_seconds": 38.27,
      "duration_seconds": 2.84,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.87,
      "end_seconds": 46.95,
      "duration_seconds": 8.08,
      "text": "Sorry, what was I saying, I notice it more with touching the ear and chewing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.51,
      "end_seconds": 51.06,
      "duration_seconds": 3.55,
      "text": "Yes. Have you had itching in the ear canal?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.63,
      "end_seconds": 53.1,
      "duration_seconds": 1.47,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.92,
      "end_seconds": 57.33,
      "duration_seconds": 3.41,
      "text": "Alright, has there been muffled hearing too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.93,
      "end_seconds": 68.19,
      "duration_seconds": 9.26,
      "text": "Yes, about the same, one week. About muffled hearing, maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.75,
      "end_seconds": 76.07,
      "duration_seconds": 7.32,
      "text": "Have you had pain in your right ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.15,
      "end_seconds": 83.84,
      "duration_seconds": 5.69,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.96,
      "end_seconds": 97.52,
      "duration_seconds": 5.56,
      "text": "And what about swelling behind the ear, fever or ringing in the ear?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.44,
      "end_seconds": 103.27,
      "duration_seconds": 3.83,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.86,
      "end_seconds": 108.7,
      "duration_seconds": 3.84,
      "text": "Alright, have you noticed facial weakness or recent swimming?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.37,
      "end_seconds": 111.48,
      "duration_seconds": 2.11,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.34,
      "end_seconds": 116.08,
      "duration_seconds": 3.74,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.79,
      "end_seconds": 118.3,
      "duration_seconds": 1.51,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.15,
      "end_seconds": 122.6,
      "duration_seconds": 2.45,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.95,
      "end_seconds": 125.53,
      "duration_seconds": 1.58,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.41,
      "end_seconds": 129.39,
      "duration_seconds": 1.98,
      "text": "Alright, are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.33,
      "end_seconds": 134.25,
      "duration_seconds": 2.92,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.07,
      "end_seconds": 138.12,
      "duration_seconds": 3.05,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.52,
      "end_seconds": 144.2,
      "duration_seconds": 3.68,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.42,
      "end_seconds": 147.66,
      "duration_seconds": 2.24,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.46,
      "end_seconds": 153.97,
      "duration_seconds": 4.51,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.63,
      "end_seconds": 156.63,
      "duration_seconds": 2.0,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.71,
      "end_seconds": 161.23,
      "duration_seconds": 3.52,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.29,
      "end_seconds": 165.68,
      "duration_seconds": 3.39,
      "text": "Right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.57,
      "end_seconds": 170.66,
      "duration_seconds": 3.09,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.46,
      "end_seconds": 184.35,
      "duration_seconds": 4.89,
      "text": "So, what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.92,
      "end_seconds": 186.55,
      "duration_seconds": 1.63,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.01,
      "end_seconds": 194.08,
      "duration_seconds": 4.07,
      "text": "Okay, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.02,
      "end_seconds": 204.11,
      "duration_seconds": 2.09,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.48,
      "end_seconds": 231.92,
      "duration_seconds": 6.44,
      "text": "Okay: pulse 74, temperature is 36.8 degrees, blood pressure 122 over 77."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.08,
      "end_seconds": 234.61,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.88,
      "end_seconds": 242.84,
      "duration_seconds": 2.96,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.37,
      "end_seconds": 247.79,
      "duration_seconds": 3.42,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.55,
      "end_seconds": 252.53,
      "duration_seconds": 2.98,
      "text": "Alright, take a deep breath for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.04,
      "end_seconds": 268.33,
      "duration_seconds": 7.29,
      "text": "The ear canal is red and swollen with some debris, and it's painful when I pull the ear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.93,
      "end_seconds": 274.6,
      "duration_seconds": 3.67,
      "text": "Right, good, you can sit up again."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.14,
      "end_seconds": 319.83,
      "duration_seconds": 26.69,
      "text": "From what you've told me and what I found, I'm honestly not certain yet. It could be an outer ear canal infection, or it might be wax. I'm going to put you on antibiotic and steroid ear drops, 3 drops, twice a day, for seven days. That's for ear canal infection. Keep the ear dry, no swimming, and don't poke anything into it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.39,
      "end_seconds": 347.89,
      "duration_seconds": 26.5,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Please don't wait if the ear swells or you get dizzy or feverish. That's when to be seen urgently. See me again if it isn't better in three days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.69,
      "end_seconds": 352.96,
      "duration_seconds": 4.27,
      "text": "Yeah, you know, alright, thanks, take care."
    }
  ]
}