{
  "schema_version": "1.0",
  "encounter_id": "01489",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.8,
      "end_seconds": 3.86,
      "duration_seconds": 3.06,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.74,
      "end_seconds": 6.81,
      "duration_seconds": 1.07,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.32,
      "end_seconds": 10.49,
      "duration_seconds": 3.17,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.32,
      "end_seconds": 19.26,
      "duration_seconds": 5.94,
      "text": "So the thing is, I've got pain in my lower back."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.42,
      "end_seconds": 23.41,
      "duration_seconds": 2.99,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.09,
      "end_seconds": 30.98,
      "duration_seconds": 5.89,
      "text": "I've had it for three weeks. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 36.23,
      "duration_seconds": 4.04,
      "text": "Alright, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.05,
      "end_seconds": 46.62,
      "duration_seconds": 9.57,
      "text": "Severe, really. There's a painful wrist as well. About painful wrist, yes, gripping. That makes it worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.77,
      "end_seconds": 53.44,
      "duration_seconds": 1.67,
      "text": "What about chest pain?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.85,
      "end_seconds": 56.64,
      "duration_seconds": 1.79,
      "text": "Definitely no chest pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.45,
      "end_seconds": 63.01,
      "duration_seconds": 4.56,
      "text": "Have you had any weight loss, fever or bladder problems?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.67,
      "end_seconds": 68.78,
      "duration_seconds": 4.11,
      "text": "No, no weight loss, fever or bladder problems."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.74,
      "end_seconds": 71.28,
      "duration_seconds": 1.54,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.95,
      "end_seconds": 75.04,
      "duration_seconds": 3.09,
      "text": "Um, no, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.06,
      "end_seconds": 85.6,
      "duration_seconds": 8.54,
      "text": "Are you allergic to anything? Any allergies to medicines or foods? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.6,
      "end_seconds": 89.43,
      "duration_seconds": 1.83,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.15,
      "end_seconds": 103.57,
      "duration_seconds": 3.42,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.35,
      "end_seconds": 107.15,
      "duration_seconds": 2.8,
      "text": "I've had thin bones, yes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.57,
      "end_seconds": 112.25,
      "duration_seconds": 1.68,
      "text": "Right, is that everything?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.19,
      "end_seconds": 116.38,
      "duration_seconds": 2.19,
      "text": "Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.29,
      "end_seconds": 133.22,
      "duration_seconds": 4.93,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.81,
      "end_seconds": 147.72,
      "duration_seconds": 12.91,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. No, I share a house with my brother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.67,
      "end_seconds": 162.76,
      "duration_seconds": 2.09,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.33,
      "end_seconds": 175.24,
      "duration_seconds": 10.91,
      "text": "Um, I take Thyronorm, 50 micrograms, every morning for my thyroid. I'd been on alendronate, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.67,
      "end_seconds": 180.54,
      "duration_seconds": 3.87,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.74,
      "end_seconds": 183.98,
      "duration_seconds": 2.24,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 188.46,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.02,
      "end_seconds": 196.29,
      "duration_seconds": 3.27,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.03,
      "end_seconds": 201.68,
      "duration_seconds": 4.65,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.49,
      "end_seconds": 216.85,
      "duration_seconds": 2.36,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.04,
      "end_seconds": 245.74,
      "duration_seconds": 7.7,
      "text": "Okay: saturation 97 percent, BP is 112 over 72. And pulse 82, temperature 36.4, respiratory rate 14."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.42,
      "end_seconds": 252.19,
      "duration_seconds": 4.77,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.8,
      "end_seconds": 253.5,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.48,
      "end_seconds": 256.83,
      "duration_seconds": 1.35,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.25,
      "end_seconds": 278.42,
      "duration_seconds": 6.17,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.35,
      "end_seconds": 299.21,
      "duration_seconds": 17.86,
      "text": "Okay, that's enough for me. From what you've told me and what I found, it's hard to say. Thin bones with a fragility fracture and back pain is one possibility and a muscle strain another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.15,
      "end_seconds": 301.84,
      "duration_seconds": 1.69,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.75,
      "end_seconds": 327.09,
      "duration_seconds": 23.34,
      "text": "I understand the worry. At the moment I'd say it's thin bones with a fragility fracture and back pain, and we'll know more once the a bone density scan is back. I'd like to arrange a bone density scan for fracture risk. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 328.88,
      "end_seconds": 333.07,
      "duration_seconds": 4.19,
      "text": "Okay, um, that makes sense. Thanks for explaining."
    }
  ]
}