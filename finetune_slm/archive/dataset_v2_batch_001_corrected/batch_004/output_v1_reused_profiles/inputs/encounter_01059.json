{
  "schema_version": "1.0",
  "encounter_id": "01059",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.95,
      "duration_seconds": 3.75,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.04,
      "end_seconds": 11.06,
      "duration_seconds": 4.02,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.74,
      "end_seconds": 16.84,
      "duration_seconds": 5.1,
      "text": "Well, I've been having neck pain going down my right arm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.89,
      "end_seconds": 25.17,
      "duration_seconds": 7.28,
      "text": "has this been going on for long? It helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.01,
      "end_seconds": 35.14,
      "duration_seconds": 9.13,
      "text": "I've had it for about a month. I thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.17,
      "end_seconds": 41.03,
      "duration_seconds": 3.86,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.17,
      "end_seconds": 45.87,
      "duration_seconds": 3.7,
      "text": "So, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.75,
      "end_seconds": 60.75,
      "duration_seconds": 4.0,
      "text": "Biceps power is a little reduced on the right."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.16,
      "end_seconds": 64.15,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.67,
      "end_seconds": 77.85,
      "duration_seconds": 5.18,
      "text": "Tilting the head to the right brings on the arm tingling"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.89,
      "end_seconds": 84.25,
      "duration_seconds": 2.36,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.36,
      "end_seconds": 105.69,
      "duration_seconds": 5.33,
      "text": "Did you get bladder problems, recent fall or weakness in the legs?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.04,
      "end_seconds": 109.29,
      "duration_seconds": 2.25,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.22,
      "end_seconds": 113.2,
      "duration_seconds": 2.98,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.6,
      "end_seconds": 116.25,
      "duration_seconds": 1.65,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.39,
      "end_seconds": 135.96,
      "duration_seconds": 2.57,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.26,
      "end_seconds": 139.78,
      "duration_seconds": 2.52,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.33,
      "end_seconds": 160.97,
      "duration_seconds": 3.64,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.74,
      "end_seconds": 164.27,
      "duration_seconds": 1.53,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.02,
      "end_seconds": 168.89,
      "duration_seconds": 2.87,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.91,
      "end_seconds": 173.97,
      "duration_seconds": 3.06,
      "text": "no, I don't take any tablets"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.43,
      "end_seconds": 183.39,
      "duration_seconds": 3.96,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.7,
      "end_seconds": 199.95,
      "duration_seconds": 15.25,
      "text": "I have about eight cigarettes in a day. Nothing, I'm teetotal. No, I share a house with my brother. Yes, I work in a bakery, early starts"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.6,
      "end_seconds": 206.69,
      "duration_seconds": 5.09,
      "text": "so, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.7,
      "end_seconds": 210.66,
      "duration_seconds": 2.96,
      "text": "Well, I've never had an allergy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.81,
      "end_seconds": 230.59,
      "duration_seconds": 5.78,
      "text": "Having listened and examined, this looks most like a pinched nerve in the neck."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.87,
      "end_seconds": 235.23,
      "duration_seconds": 3.36,
      "text": "Well, is there something to worry about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.03,
      "end_seconds": 265.61,
      "duration_seconds": 29.58,
      "text": "I can't promise yet, but most people with a pinched nerve in the neck do well once it's treated properly i'll request an X-ray of the neck, it'll help with neck and arm pain let's get an MRI of the cervical spine, for arm symptoms let's use naproxen, 250 milligrams, twice a day after food, for five days it's for nerve-related neck pain"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.92,
      "end_seconds": 269.4,
      "duration_seconds": 2.48,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.47,
      "end_seconds": 298.97,
      "duration_seconds": 27.5,
      "text": "Keep the neck moving gently and avoid long periods looking down at a phone. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Come back or go to emergency straight away if the symptoms get worse. Let's review you after the scan. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.79,
      "end_seconds": 302.16,
      "duration_seconds": 2.37,
      "text": "Thank you, that's helpful."
    }
  ]
}