{
  "schema_version": "1.0",
  "encounter_id": "01312",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.54,
      "end_seconds": 6.69,
      "duration_seconds": 6.15,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.48,
      "end_seconds": 14.35,
      "duration_seconds": 3.87,
      "text": "okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.24,
      "end_seconds": 21.37,
      "duration_seconds": 6.13,
      "text": "Uh, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 22.92,
      "end_seconds": 28.55,
      "duration_seconds": 5.63,
      "text": "I've been dealing with neck pain going down my right arm."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.52,
      "end_seconds": 31.78,
      "duration_seconds": 1.26,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 36.74,
      "end_seconds": 40.57,
      "duration_seconds": 3.83,
      "text": "it's been like this since last Tuesday"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.23,
      "end_seconds": 48.35,
      "duration_seconds": 3.12,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.49,
      "end_seconds": 55.61,
      "duration_seconds": 2.12,
      "text": "I, I'd say severe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.31,
      "end_seconds": 58.9,
      "duration_seconds": 1.59,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 60.95,
      "end_seconds": 85.81,
      "duration_seconds": 24.86,
      "text": "only resting my arm on my head, and it's not much. I've also had stiffness in the neck, for two weeks. As for stiffness in the neck, it feels moderate to me. Only heat, and it's not much. I've been waking with an ache in the arm too"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 87.61,
      "end_seconds": 97.1,
      "duration_seconds": 9.49,
      "text": "Okay, so the the vitals from earlier. Temperature 36.8, heart rate 72, blood pressure 126 over 80, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.66,
      "end_seconds": 98.56,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.34,
      "end_seconds": 104.66,
      "duration_seconds": 3.32,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.28,
      "end_seconds": 107.72,
      "duration_seconds": 1.44,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.17,
      "end_seconds": 128.79,
      "duration_seconds": 3.62,
      "text": "Biceps power is a little reduced on the right."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.75,
      "end_seconds": 132.77,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.81,
      "end_seconds": 146.37,
      "duration_seconds": 4.56,
      "text": "Tilting the head to the right brings on the arm tingling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.64,
      "end_seconds": 151.25,
      "duration_seconds": 1.61,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.02,
      "end_seconds": 163.14,
      "duration_seconds": 4.12,
      "text": "So, any bladder problems, balance problems or recent fall?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.96,
      "end_seconds": 171.81,
      "duration_seconds": 6.85,
      "text": "Erm, no bladder problems, balance problems or recent fall, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.53,
      "end_seconds": 176.32,
      "duration_seconds": 2.79,
      "text": "Any weakness in the legs or fever?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.95,
      "end_seconds": 180.62,
      "duration_seconds": 2.67,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.66,
      "end_seconds": 186.17,
      "duration_seconds": 3.51,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 188.02,
      "end_seconds": 190.05,
      "duration_seconds": 2.03,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.94,
      "end_seconds": 195.86,
      "duration_seconds": 3.92,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.18,
      "end_seconds": 199.98,
      "duration_seconds": 2.8,
      "text": "Nothing unusual, um, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.99,
      "end_seconds": 213.61,
      "duration_seconds": 2.62,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 215.42,
      "end_seconds": 228.21,
      "duration_seconds": 12.79,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.95,
      "end_seconds": 231.47,
      "duration_seconds": 2.52,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.04,
      "end_seconds": 238.92,
      "duration_seconds": 6.88,
      "text": "Glibenclamide. I take it 5 milligrams, maybe, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.37,
      "end_seconds": 244.87,
      "duration_seconds": 4.5,
      "text": "Do you have the packet or the the prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.99,
      "end_seconds": 256.52,
      "duration_seconds": 10.53,
      "text": "Not with me. I'll bring it next time. Escitalopram. I take it 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 257.24,
      "end_seconds": 263.57,
      "duration_seconds": 6.33,
      "text": "that's what's prescribed, but I'm not sure she takes it every day"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.4,
      "end_seconds": 267.08,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.92,
      "end_seconds": 279.45,
      "duration_seconds": 10.53,
      "text": "I mean, I have diabetes, for nearly five years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.35,
      "end_seconds": 281.81,
      "duration_seconds": 1.46,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.6,
      "end_seconds": 285.18,
      "duration_seconds": 1.58,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.58,
      "end_seconds": 295.34,
      "duration_seconds": 2.76,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 297.38,
      "end_seconds": 302.67,
      "duration_seconds": 5.29,
      "text": "my father had bowel cancer my aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.41,
      "end_seconds": 306.58,
      "duration_seconds": 3.17,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 307.88,
      "end_seconds": 317.71,
      "duration_seconds": 9.83,
      "text": "I only drink at family occasions. Yes, I work in a bakery, early starts. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.79,
      "end_seconds": 333.64,
      "duration_seconds": 13.85,
      "text": "Stop me if I've got anything wrong. You've had neck pain going down your right arm, since last Tuesday, severe, and no weakness in the legs or bladder problems."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 335.49,
      "end_seconds": 337.61,
      "duration_seconds": 2.12,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.56,
      "end_seconds": 368.67,
      "duration_seconds": 29.11,
      "text": "An X-ray of the neck is what I'd like next, for neck and arm pain. An MRI of the cervical spine is what I'd like next, for arm symptoms. The treatment will be naproxen, 250 milligrams, twice a day after food, for five days. It's for nerve-related neck pain. Keep the neck moving gently and avoid long periods looking down at a phone. Physiotherapy would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.0,
      "end_seconds": 386.53,
      "duration_seconds": 16.53,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'd like to see you again in three weeks. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 388.57,
      "end_seconds": 391.41,
      "duration_seconds": 2.84,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.26,
      "end_seconds": 394.46,
      "duration_seconds": 1.2,
      "text": "Goodbye for now."
    }
  ]
}