{
  "schema_version": "1.0",
  "encounter_id": "01280",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 4.78,
      "duration_seconds": 3.49,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.07,
      "end_seconds": 9.75,
      "duration_seconds": 3.68,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.68,
      "end_seconds": 19.9,
      "duration_seconds": 9.22,
      "text": "I've, I've been belching. I looked a few things up online, uh, and that probably didn't help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.85,
      "end_seconds": 24.79,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.16,
      "end_seconds": 28.41,
      "duration_seconds": 2.25,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.6,
      "end_seconds": 32.98,
      "duration_seconds": 3.38,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.66,
      "end_seconds": 37.93,
      "duration_seconds": 3.27,
      "text": "Ah, uh, I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.39,
      "end_seconds": 40.16,
      "duration_seconds": 1.77,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.09,
      "end_seconds": 59.5,
      "duration_seconds": 1.41,
      "text": "Nothing like jaundice?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.78,
      "end_seconds": 64.33,
      "duration_seconds": 3.55,
      "text": "No, um, none, no jaundice."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.32,
      "end_seconds": 71.47,
      "duration_seconds": 5.15,
      "text": "A few quick ones: vomiting blood, black stools or weight loss?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.27,
      "end_seconds": 78.58,
      "duration_seconds": 6.31,
      "text": "No vomiting blood, black stools or weight loss, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.1,
      "end_seconds": 82.52,
      "duration_seconds": 2.42,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.31,
      "end_seconds": 85.69,
      "duration_seconds": 1.38,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.75,
      "end_seconds": 90.9,
      "duration_seconds": 3.15,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.72,
      "end_seconds": 95.07,
      "duration_seconds": 2.35,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.3,
      "end_seconds": 111.5,
      "duration_seconds": 1.2,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.37,
      "end_seconds": 116.49,
      "duration_seconds": 4.12,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.49,
      "end_seconds": 119.73,
      "duration_seconds": 2.24,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.88,
      "end_seconds": 126.76,
      "duration_seconds": 5.88,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.81,
      "end_seconds": 132.02,
      "duration_seconds": 3.21,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.59,
      "end_seconds": 135.38,
      "duration_seconds": 1.79,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.56,
      "end_seconds": 154.74,
      "duration_seconds": 5.18,
      "text": "Right, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.24,
      "end_seconds": 163.44,
      "duration_seconds": 3.2,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.21,
      "end_seconds": 172.78,
      "duration_seconds": 7.57,
      "text": "Do you have any medical conditions I should know about? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.9,
      "end_seconds": 175.54,
      "duration_seconds": 1.64,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 182.99,
      "duration_seconds": 3.29,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.69,
      "end_seconds": 193.21,
      "duration_seconds": 2.52,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.05,
      "end_seconds": 206.6,
      "duration_seconds": 3.55,
      "text": "Okay: pulse 73, pressure 126 over 75."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.24,
      "end_seconds": 210.93,
      "duration_seconds": 1.69,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.71,
      "end_seconds": 215.5,
      "duration_seconds": 3.79,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.92,
      "end_seconds": 220.92,
      "duration_seconds": 4.0,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.83,
      "end_seconds": 224.56,
      "duration_seconds": 1.73,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.44,
      "end_seconds": 244.16,
      "duration_seconds": 4.72,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.8,
      "end_seconds": 257.35,
      "duration_seconds": 7.55,
      "text": "That's all I needed to check. Having listened and examined, I'd lean towards dyspepsia possibly related to anti-inflammatory tablets."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.33,
      "end_seconds": 262.65,
      "duration_seconds": 3.32,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.8,
      "end_seconds": 275.53,
      "duration_seconds": 11.73,
      "text": "I understand the worry. At the moment I'd say it's dyspepsia possibly related to anti-inflammatory tablets, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.0,
      "end_seconds": 295.44,
      "duration_seconds": 9.44,
      "text": "I'd like to arrange blood tests for dyspepsia. I'm prescribing omeprazole, 20 milligrams, once a day, for four weeks. It's for stomach acid."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.09,
      "end_seconds": 298.68,
      "duration_seconds": 1.59,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.69,
      "end_seconds": 310.51,
      "duration_seconds": 5.82,
      "text": "Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.77,
      "end_seconds": 314.02,
      "duration_seconds": 3.25,
      "text": "Yes. Let's plan a check in four weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.68,
      "end_seconds": 316.82,
      "duration_seconds": 2.14,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.47,
      "end_seconds": 321.61,
      "duration_seconds": 3.14,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.37,
      "end_seconds": 325.69,
      "duration_seconds": 3.32,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.95,
      "end_seconds": 328.42,
      "duration_seconds": 1.47,
      "text": "Goodbye for now."
    }
  ]
}