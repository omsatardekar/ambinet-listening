{
  "schema_version": "1.0",
  "encounter_id": "01290",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.67,
      "end_seconds": 6.24,
      "duration_seconds": 5.57,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.03,
      "end_seconds": 12.73,
      "duration_seconds": 4.7,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.68,
      "end_seconds": 17.79,
      "duration_seconds": 3.11,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.51,
      "end_seconds": 22.32,
      "duration_seconds": 2.81,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.65,
      "end_seconds": 28.67,
      "duration_seconds": 5.02,
      "text": "Doctor, it's been feeling weak. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.96,
      "end_seconds": 32.37,
      "duration_seconds": 3.41,
      "text": "Sure. Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 34.4,
      "end_seconds": 38.41,
      "duration_seconds": 4.01,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.08,
      "end_seconds": 46.94,
      "duration_seconds": 7.86,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 47.04,
      "end_seconds": 52.42,
      "duration_seconds": 5.38,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 53.31,
      "end_seconds": 55.69,
      "duration_seconds": 2.38,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.54,
      "end_seconds": 61.61,
      "duration_seconds": 4.07,
      "text": "Right, has there been a pounding in your head too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 63.01,
      "end_seconds": 66.43,
      "duration_seconds": 3.42,
      "text": "Yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.8,
      "end_seconds": 70.5,
      "duration_seconds": 2.7,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 71.09,
      "end_seconds": 75.74,
      "duration_seconds": 4.65,
      "text": "Maybe a five out of ten on a bad day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.63,
      "end_seconds": 80.61,
      "duration_seconds": 3.98,
      "text": "Have you been feeling weak at any time before this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.79,
      "end_seconds": 87.27,
      "duration_seconds": 5.48,
      "text": "I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.15,
      "end_seconds": 92.54,
      "duration_seconds": 4.39,
      "text": "And what about slurred speech, chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.64,
      "end_seconds": 107.58,
      "duration_seconds": 13.94,
      "text": "No, no slurred speech, no chest pain, no vomiting. I did have nearly blacking out at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.85,
      "end_seconds": 112.22,
      "duration_seconds": 3.37,
      "text": "And what about black stools or fainting?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 112.85,
      "end_seconds": 115.25,
      "duration_seconds": 2.4,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.88,
      "end_seconds": 118.62,
      "duration_seconds": 1.74,
      "text": "Any sign of palpitations?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 119.67,
      "end_seconds": 121.16,
      "duration_seconds": 1.49,
      "text": "Nope, no palpitations."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 121.69,
      "end_seconds": 126.78,
      "duration_seconds": 5.09,
      "text": "Actually, doctor, I did notice palpitations. She doesn't always say."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 128.49,
      "end_seconds": 134.76,
      "duration_seconds": 6.27,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.83,
      "end_seconds": 146.17,
      "duration_seconds": 10.34,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 147.86,
      "end_seconds": 149.95,
      "duration_seconds": 2.09,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.45,
      "end_seconds": 154.61,
      "duration_seconds": 3.16,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 155.95,
      "end_seconds": 158.25,
      "duration_seconds": 2.3,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.88,
      "end_seconds": 165.06,
      "duration_seconds": 3.18,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 165.72,
      "end_seconds": 169.18,
      "duration_seconds": 3.46,
      "text": "High blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.85,
      "end_seconds": 171.55,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.81,
      "end_seconds": 177.42,
      "duration_seconds": 4.61,
      "text": "Eczema, for five years. I, I have diabetes."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.38,
      "end_seconds": 182.98,
      "duration_seconds": 4.6,
      "text": "Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.91,
      "end_seconds": 203.91,
      "duration_seconds": 5.0,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 205.31,
      "end_seconds": 218.65,
      "duration_seconds": 13.34,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.26,
      "end_seconds": 222.34,
      "duration_seconds": 2.08,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 223.88,
      "end_seconds": 227.72,
      "duration_seconds": 3.84,
      "text": "I'm on telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 229.38,
      "end_seconds": 236.96,
      "duration_seconds": 7.58,
      "text": "It's meant to be once a day, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 239.12,
      "end_seconds": 247.12,
      "duration_seconds": 8.0,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.05,
      "end_seconds": 251.58,
      "duration_seconds": 2.53,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.53,
      "end_seconds": 263.23,
      "duration_seconds": 9.7,
      "text": "For my sugar, I believe. My wife sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.95,
      "end_seconds": 267.01,
      "duration_seconds": 2.06,
      "text": "So, do you smoke?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.83,
      "end_seconds": 272.27,
      "duration_seconds": 4.44,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.96,
      "end_seconds": 274.92,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 279.64,
      "end_seconds": 282.32,
      "duration_seconds": 2.68,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.93,
      "end_seconds": 286.94,
      "duration_seconds": 3.01,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 288.47,
      "end_seconds": 292.51,
      "duration_seconds": 4.04,
      "text": "My cousin has psoriasis. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 294.14,
      "end_seconds": 302.04,
      "duration_seconds": 7.9,
      "text": "Here are the numbers, doctor. Temperature 36.7, pulse 102. Oxygen saturation is 97 percent, BP is 97 over 62."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.1,
      "end_seconds": 305.06,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.68,
      "end_seconds": 310.36,
      "duration_seconds": 3.68,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.74,
      "end_seconds": 313.3,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.93,
      "end_seconds": 331.38,
      "duration_seconds": 6.45,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.25,
      "end_seconds": 335.12,
      "duration_seconds": 1.87,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.13,
      "end_seconds": 355.57,
      "duration_seconds": 4.44,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.93,
      "end_seconds": 362.47,
      "duration_seconds": 2.54,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.04,
      "end_seconds": 385.84,
      "duration_seconds": 9.8,
      "text": "We should do a lying and standing blood pressure check for dizziness. I want an ECG done, that's for dizziness."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 386.67,
      "end_seconds": 388.07,
      "duration_seconds": 1.4,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.79,
      "end_seconds": 408.7,
      "duration_seconds": 18.91,
      "text": "Get up slowly from lying and sitting, and keep drinking fluids through the day. If you faint or have chest pain, or you feel really unwell, please come to the emergency department. I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.97,
      "end_seconds": 414.2,
      "duration_seconds": 2.23,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.13,
      "end_seconds": 419.37,
      "duration_seconds": 4.24,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 420.86,
      "end_seconds": 424.24,
      "duration_seconds": 3.38,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}