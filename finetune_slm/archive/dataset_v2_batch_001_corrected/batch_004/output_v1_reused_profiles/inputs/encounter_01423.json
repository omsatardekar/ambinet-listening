{
  "schema_version": "1.0",
  "encounter_id": "01423",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.68,
      "end_seconds": 6.81,
      "duration_seconds": 6.13,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.05,
      "end_seconds": 12.19,
      "duration_seconds": 4.14,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.38,
      "end_seconds": 18.84,
      "duration_seconds": 5.46,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.55,
      "end_seconds": 23.85,
      "duration_seconds": 3.3,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.63,
      "end_seconds": 30.01,
      "duration_seconds": 4.38,
      "text": "Doctor, it's the room spinning. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.55,
      "end_seconds": 33.67,
      "duration_seconds": 2.12,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 35.28,
      "end_seconds": 38.43,
      "duration_seconds": 3.15,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.63,
      "end_seconds": 42.55,
      "duration_seconds": 2.92,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.72,
      "end_seconds": 51.47,
      "duration_seconds": 6.75,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.27,
      "end_seconds": 58.54,
      "duration_seconds": 6.27,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.6,
      "end_seconds": 61.93,
      "duration_seconds": 2.33,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.79,
      "end_seconds": 65.32,
      "duration_seconds": 2.53,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.53,
      "end_seconds": 71.63,
      "duration_seconds": 5.1,
      "text": "It's worse with lying down and turning my head."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.61,
      "end_seconds": 80.96,
      "duration_seconds": 8.35,
      "text": "Ah, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.06,
      "end_seconds": 86.03,
      "duration_seconds": 4.97,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.38,
      "end_seconds": 93.63,
      "duration_seconds": 2.25,
      "text": "I was getting to that!"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.34,
      "end_seconds": 98.92,
      "duration_seconds": 4.58,
      "text": "That's fine, one at a time. I'll ask about everything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.65,
      "end_seconds": 111.05,
      "duration_seconds": 6.4,
      "text": "So, and a blocked feeling in my ear as well, since last weekend."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.87,
      "end_seconds": 116.03,
      "duration_seconds": 3.16,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 117.91,
      "end_seconds": 124.38,
      "duration_seconds": 6.47,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.63,
      "end_seconds": 135.39,
      "duration_seconds": 5.76,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.48,
      "end_seconds": 151.25,
      "duration_seconds": 12.77,
      "text": "Mostly severe. As for nausea and vomiting, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.76,
      "end_seconds": 157.96,
      "duration_seconds": 5.2,
      "text": "Have you had the room spinning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 158.59,
      "end_seconds": 164.47,
      "duration_seconds": 5.88,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 165.18,
      "end_seconds": 167.51,
      "duration_seconds": 2.33,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.67,
      "end_seconds": 172.59,
      "duration_seconds": 3.92,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.87,
      "end_seconds": 178.64,
      "duration_seconds": 4.77,
      "text": "My uncle has high cholesterol. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 181.95,
      "duration_seconds": 1.85,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 183.34,
      "end_seconds": 186.29,
      "duration_seconds": 2.95,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.24,
      "end_seconds": 189.67,
      "duration_seconds": 1.43,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 190.31,
      "end_seconds": 194.81,
      "duration_seconds": 4.5,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.66,
      "end_seconds": 199.24,
      "duration_seconds": 2.58,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 201.33,
      "end_seconds": 205.24,
      "duration_seconds": 3.91,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.2,
      "end_seconds": 211.39,
      "duration_seconds": 5.19,
      "text": "Let's run through your medicines. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 212.75,
      "end_seconds": 223.75,
      "duration_seconds": 11.0,
      "text": "He takes metoprolol, 50 milligrams, twice a day. Sorry, what was I saying, he takes tamsulosin, 0.4 milligrams, at night."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 225.58,
      "end_seconds": 230.58,
      "duration_seconds": 5.0,
      "text": "I'd been on amlodipine, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.39,
      "end_seconds": 234.18,
      "duration_seconds": 2.79,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 236.23,
      "end_seconds": 241.52,
      "duration_seconds": 5.29,
      "text": "Mm, I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.46,
      "end_seconds": 244.81,
      "duration_seconds": 1.35,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 246.28,
      "end_seconds": 248.92,
      "duration_seconds": 2.64,
      "text": "I have an enlarged prostate."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.44,
      "end_seconds": 254.39,
      "duration_seconds": 4.95,
      "text": "Ah. Alright, an enlarged prostate, that matches what I have here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.2,
      "end_seconds": 274.39,
      "duration_seconds": 4.19,
      "text": "And what about double vision or ringing in the ears?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.29,
      "end_seconds": 287.82,
      "duration_seconds": 12.53,
      "text": "No, no double vision, no ringing in the ears. I did have being unsteady at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.82,
      "end_seconds": 294.13,
      "duration_seconds": 4.31,
      "text": "And what about hearing loss, headache, slurred speech or weakness?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.87,
      "end_seconds": 298.46,
      "duration_seconds": 2.59,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.0,
      "end_seconds": 303.63,
      "duration_seconds": 3.63,
      "text": "So, and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 309.51,
      "end_seconds": 311.57,
      "duration_seconds": 2.06,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 313.02,
      "end_seconds": 320.46,
      "duration_seconds": 7.44,
      "text": "Okay, so the vitals from earlier. Blood pressure 116 over 79, heart rate 71, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.74,
      "end_seconds": 323.74,
      "duration_seconds": 2.0,
      "text": "So, good, thank you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.84,
      "end_seconds": 330.08,
      "duration_seconds": 4.24,
      "text": "Alright, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.52,
      "end_seconds": 333.95,
      "duration_seconds": 2.43,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.03,
      "end_seconds": 351.28,
      "duration_seconds": 9.25,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 365.87,
      "end_seconds": 366.91,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.88,
      "end_seconds": 380.83,
      "duration_seconds": 10.95,
      "text": "Good, you can sit up again. So, to recap quickly. You've had the room spinning, since Monday, severe, and no weakness or ringing in the ears."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 382.16,
      "end_seconds": 383.73,
      "duration_seconds": 1.57,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.38,
      "end_seconds": 388.83,
      "duration_seconds": 3.45,
      "text": "We should do a positional test for vertigo."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.42,
      "end_seconds": 392.35,
      "duration_seconds": 2.93,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.35,
      "end_seconds": 426.7,
      "duration_seconds": 33.35,
      "text": "I think blood tests makes sense here, for dizziness. I'd rather check than guess, and this is the quickest way to know more. We'll begin with prochlorperazine, 5 milligrams, three times a day, for three days. That should help with nausea and vertigo. Start moving around gently as soon as you can, since resting too long slows recovery. Let's plan a check if it isn't settling in five days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 428.74,
      "end_seconds": 431.67,
      "duration_seconds": 2.93,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}