{
  "schema_version": "1.0",
  "encounter_id": "01150",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.4,
      "duration_seconds": 4.01,
      "text": "Oh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.23,
      "end_seconds": 11.73,
      "duration_seconds": 4.5,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.44,
      "end_seconds": 30.83,
      "duration_seconds": 15.39,
      "text": "So the thing is, um, I've got yellow eyes. I didn't want to bother you but it keeps coming back. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.16,
      "end_seconds": 34.43,
      "duration_seconds": 2.27,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.35,
      "end_seconds": 43.31,
      "duration_seconds": 6.96,
      "text": "It usually comes with no appetite. Oh, I've also had dark urine, for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.16,
      "end_seconds": 47.27,
      "duration_seconds": 3.11,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.17,
      "end_seconds": 59.08,
      "duration_seconds": 2.91,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.37,
      "end_seconds": 81.53,
      "duration_seconds": 8.16,
      "text": "Okay: pressure 128 over 80, temp 36.8 degrees. And saturation 98 percent, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.4,
      "end_seconds": 88.95,
      "duration_seconds": 4.55,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.85,
      "end_seconds": 93.34,
      "duration_seconds": 2.49,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.5,
      "end_seconds": 116.5,
      "duration_seconds": 7.0,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.17,
      "end_seconds": 124.0,
      "duration_seconds": 1.83,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.0,
      "end_seconds": 141.22,
      "duration_seconds": 5.22,
      "text": "Let me check a few things. Any bleeding, fever or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.27,
      "end_seconds": 147.99,
      "duration_seconds": 5.72,
      "text": "No bleeding, fever or severe abdominal pain, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.61,
      "end_seconds": 151.05,
      "duration_seconds": 1.44,
      "text": "Nothing like itching?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.86,
      "end_seconds": 153.48,
      "duration_seconds": 1.62,
      "text": "Definitely no itching."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.07,
      "end_seconds": 157.52,
      "duration_seconds": 3.45,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.13,
      "end_seconds": 160.3,
      "duration_seconds": 2.17,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.54,
      "end_seconds": 165.97,
      "duration_seconds": 4.43,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.58,
      "end_seconds": 168.01,
      "duration_seconds": 1.43,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.09,
      "end_seconds": 173.62,
      "duration_seconds": 4.53,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.47,
      "end_seconds": 181.89,
      "duration_seconds": 3.42,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.1,
      "end_seconds": 201.49,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.01,
      "end_seconds": 203.81,
      "duration_seconds": 1.8,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.64,
      "end_seconds": 207.4,
      "duration_seconds": 2.76,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.67,
      "end_seconds": 218.71,
      "duration_seconds": 10.04,
      "text": "Diabetes, for about ten years. My family kept telling me to get it checked. I've had heart failure, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.99,
      "end_seconds": 224.33,
      "duration_seconds": 4.34,
      "text": "Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.81,
      "end_seconds": 240.95,
      "duration_seconds": 2.14,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.44,
      "end_seconds": 244.85,
      "duration_seconds": 2.41,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.89,
      "end_seconds": 247.53,
      "duration_seconds": 1.64,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.25,
      "end_seconds": 250.72,
      "duration_seconds": 2.47,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.44,
      "end_seconds": 254.54,
      "duration_seconds": 3.1,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.35,
      "end_seconds": 259.69,
      "duration_seconds": 3.34,
      "text": "Actually, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.59,
      "end_seconds": 265.59,
      "duration_seconds": 5.0,
      "text": "Taking everything into account, this looks most like an acute viral hepatitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.34,
      "end_seconds": 271.18,
      "duration_seconds": 4.84,
      "text": "Um, uh, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.17,
      "end_seconds": 284.53,
      "duration_seconds": 12.36,
      "text": "I can't promise yet, but most people with an acute viral hepatitis do well once it's treated properly. I'm going to order an ultrasound of the liver, for jaundice."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 286.48,
      "end_seconds": 290.54,
      "duration_seconds": 4.06,
      "text": "We have a slot Wednesday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.2,
      "end_seconds": 294.53,
      "duration_seconds": 2.33,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.54,
      "end_seconds": 313.65,
      "duration_seconds": 17.11,
      "text": "Liver blood tests is what I'd like next, for jaundice. No alcohol at all and avoid paracetamol and other painkillers unless we say. I'll want another look in one week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.01,
      "end_seconds": 319.25,
      "duration_seconds": 4.24,
      "text": "Right, okay, that makes sense. Thanks for explaining."
    }
  ]
}