{
  "schema_version": "1.0",
  "encounter_id": "01110",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 4.12,
      "duration_seconds": 2.76,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.83,
      "end_seconds": 11.46,
      "duration_seconds": 5.63,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.01,
      "end_seconds": 15.43,
      "duration_seconds": 2.42,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.34,
      "end_seconds": 19.79,
      "duration_seconds": 2.45,
      "text": "It's a tight chest, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.0,
      "end_seconds": 24.36,
      "duration_seconds": 3.36,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.28,
      "end_seconds": 33.2,
      "duration_seconds": 7.92,
      "text": "About... well, about a week. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.91,
      "end_seconds": 37.51,
      "duration_seconds": 2.6,
      "text": "So, how frequently does it come?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.08,
      "end_seconds": 44.98,
      "duration_seconds": 3.9,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.87,
      "end_seconds": 53.43,
      "duration_seconds": 7.56,
      "text": "Uh, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 53.53,
      "end_seconds": 59.49,
      "duration_seconds": 5.96,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.17,
      "end_seconds": 72.78,
      "duration_seconds": 11.61,
      "text": "Okay, um, so I was getting to that! Hmm, and there's shortness of breath on walking as well, three days now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.41,
      "end_seconds": 76.19,
      "duration_seconds": 2.78,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.63,
      "end_seconds": 84.16,
      "duration_seconds": 4.53,
      "text": "Yes, you know, walking fast. That makes it worse."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.6,
      "end_seconds": 91.38,
      "duration_seconds": 5.78,
      "text": "Have you had a tight chest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.87,
      "end_seconds": 103.27,
      "duration_seconds": 10.4,
      "text": "Yes, uh, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.67,
      "end_seconds": 108.86,
      "duration_seconds": 4.19,
      "text": "Alright, did you get runny nose or leg swelling?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 110.84,
      "end_seconds": 123.95,
      "duration_seconds": 13.11,
      "text": "No, no runny nose, no leg swelling. I was using my blue inhaler more at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.65,
      "end_seconds": 130.13,
      "duration_seconds": 5.48,
      "text": "And what about weight loss, coughing up phlegm or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.01,
      "end_seconds": 138.6,
      "duration_seconds": 6.59,
      "text": "Um, no, no weight loss, coughing up phlegm or chest pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.82,
      "end_seconds": 143.3,
      "duration_seconds": 3.48,
      "text": "Right, have you had fever, by any chance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.1,
      "end_seconds": 151.98,
      "duration_seconds": 2.88,
      "text": "No, I haven't had any fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 153.12,
      "end_seconds": 158.69,
      "duration_seconds": 5.57,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.38,
      "end_seconds": 165.48,
      "duration_seconds": 6.1,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.28,
      "end_seconds": 178.67,
      "duration_seconds": 8.39,
      "text": "Alright, I'll note both what you've said and what you've noticed. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.12,
      "end_seconds": 182.16,
      "duration_seconds": 2.04,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.91,
      "end_seconds": 185.99,
      "duration_seconds": 2.08,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.89,
      "end_seconds": 194.45,
      "duration_seconds": 6.56,
      "text": "Yes, um, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.31,
      "end_seconds": 205.53,
      "duration_seconds": 3.22,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.62,
      "end_seconds": 207.73,
      "duration_seconds": 1.11,
      "text": "Yes, asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.73,
      "end_seconds": 209.82,
      "duration_seconds": 1.09,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.74,
      "end_seconds": 219.56,
      "duration_seconds": 7.82,
      "text": "I've got migraines. I have an enlarged prostate. Acid reflux, for nearly five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.55,
      "end_seconds": 231.76,
      "duration_seconds": 10.21,
      "text": "Okay, I can see acid reflux in your file as well. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.47,
      "end_seconds": 236.57,
      "duration_seconds": 3.1,
      "text": "So, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.71,
      "end_seconds": 240.86,
      "duration_seconds": 3.15,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.75,
      "end_seconds": 251.99,
      "duration_seconds": 10.24,
      "text": "I quit smoking around ten years ago. I live with my elderly mother. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.91,
      "end_seconds": 255.48,
      "duration_seconds": 2.57,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 257.49,
      "end_seconds": 260.67,
      "duration_seconds": 3.18,
      "text": "Yes, milk. I get a rash."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.18,
      "end_seconds": 265.49,
      "duration_seconds": 4.31,
      "text": "Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.75,
      "end_seconds": 273.75,
      "duration_seconds": 7.0,
      "text": "Asthalin inhaler, when needed. Sumatriptan. I take it 50 milligrams, when needed for my migraines."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 275.37,
      "end_seconds": 284.64,
      "duration_seconds": 9.27,
      "text": "Doctor, I think the last prescription for the sumatriptan was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.11,
      "end_seconds": 291.07,
      "duration_seconds": 4.96,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 292.67,
      "end_seconds": 301.56,
      "duration_seconds": 8.89,
      "text": "I don't think I have it with me. It's tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.46,
      "end_seconds": 305.86,
      "duration_seconds": 3.4,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 310.68,
      "end_seconds": 312.69,
      "duration_seconds": 2.01,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.65,
      "end_seconds": 318.09,
      "duration_seconds": 3.44,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.63,
      "end_seconds": 322.19,
      "duration_seconds": 2.56,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.5,
      "end_seconds": 340.83,
      "duration_seconds": 6.33,
      "text": "I can hear a widespread wheeze on both sides when you breathe out."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.67,
      "end_seconds": 344.01,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.36,
      "end_seconds": 355.34,
      "duration_seconds": 3.98,
      "text": "You're speaking in full sentences, which is reassuring."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.12,
      "end_seconds": 376.54,
      "duration_seconds": 15.42,
      "text": "That's the examination finished. Okay, thinking it through, I think we're dealing with an asthma flare-up at this stage. I'd also keep a chest infection in mind. I can't rule out an allergic reaction yet."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.52,
      "end_seconds": 380.83,
      "duration_seconds": 2.31,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 381.7,
      "end_seconds": 392.74,
      "duration_seconds": 11.04,
      "text": "I understand the worry. At the moment I'd say it's an asthma flare-up, and we'll know more once the a peak flow reading is back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.64,
      "end_seconds": 408.29,
      "duration_seconds": 7.65,
      "text": "I'm going to order a peak flow reading, for asthma control. We should do a chest X-ray for wheeze."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 409.48,
      "end_seconds": 411.48,
      "duration_seconds": 2.0,
      "text": "Right, uh, understood."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 413.16,
      "end_seconds": 417.1,
      "duration_seconds": 3.94,
      "text": "I'm sending you for breathing tests because of asthma."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 418.35,
      "end_seconds": 421.11,
      "duration_seconds": 2.76,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 423.15,
      "end_seconds": 448.62,
      "duration_seconds": 25.47,
      "text": "The treatment will be Seretide inhaler, 250 micrograms, two puffs twice a day, long term. It's for asthma control. For this, prednisolone, 30 milligrams, once a day, for five days. That should help with asthma flare-up. Rinse your mouth after the steroid inhaler. Let me watch you use the inhaler, a lot of people don't get the full dose."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 449.63,
      "end_seconds": 458.09,
      "duration_seconds": 8.46,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 459.15,
      "end_seconds": 460.15,
      "duration_seconds": 1.0,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 460.83,
      "end_seconds": 479.07,
      "duration_seconds": 18.24,
      "text": "Keep an eye out, and if the inhaler isn't helping or you can't speak in full sentences, call us the same day or go to emergency. I'd like to see you again in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 479.91,
      "end_seconds": 482.23,
      "duration_seconds": 2.32,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 482.73,
      "end_seconds": 483.9,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}