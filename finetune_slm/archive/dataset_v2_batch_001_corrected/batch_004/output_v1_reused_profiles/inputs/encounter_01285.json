{
  "schema_version": "1.0",
  "encounter_id": "01285",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 6.86,
      "duration_seconds": 5.89,
      "text": "Um, uh, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.83,
      "end_seconds": 13.16,
      "duration_seconds": 4.33,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.1,
      "end_seconds": 18.48,
      "duration_seconds": 3.38,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.22,
      "end_seconds": 22.38,
      "duration_seconds": 3.16,
      "text": "Right, absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.11,
      "end_seconds": 35.78,
      "duration_seconds": 7.67,
      "text": "It's pain in my lower back, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.67,
      "end_seconds": 41.2,
      "duration_seconds": 4.53,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.08,
      "end_seconds": 44.45,
      "duration_seconds": 2.37,
      "text": "Probably two years. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.88,
      "end_seconds": 48.16,
      "duration_seconds": 3.28,
      "text": "Understood. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.96,
      "end_seconds": 56.76,
      "duration_seconds": 7.8,
      "text": "Okay, uh, so maybe a seven out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.49,
      "end_seconds": 60.9,
      "duration_seconds": 2.41,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.59,
      "end_seconds": 68.15,
      "duration_seconds": 6.56,
      "text": "A stooped back goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.44,
      "end_seconds": 71.72,
      "duration_seconds": 2.28,
      "text": "Have you been losing height?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.82,
      "end_seconds": 82.67,
      "duration_seconds": 8.85,
      "text": "Yes, for four weeks. Yeah, I've had a painful wrist too, for two months."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.9,
      "end_seconds": 89.74,
      "duration_seconds": 5.84,
      "text": "And what about bladder problems, weight loss, chest pain or numbness in the legs?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.31,
      "end_seconds": 95.1,
      "duration_seconds": 3.79,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.96,
      "end_seconds": 98.61,
      "duration_seconds": 2.65,
      "text": "Did you notice any night pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.53,
      "end_seconds": 108.06,
      "duration_seconds": 3.53,
      "text": "Not that I've noticed, no night pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.49,
      "end_seconds": 112.79,
      "duration_seconds": 4.3,
      "text": "Sure. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.62,
      "end_seconds": 118.62,
      "duration_seconds": 4.0,
      "text": "Bowels are regular, um, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.34,
      "end_seconds": 124.27,
      "duration_seconds": 3.93,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.76,
      "end_seconds": 128.21,
      "duration_seconds": 2.45,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.99,
      "end_seconds": 131.85,
      "duration_seconds": 2.86,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 133.38,
      "end_seconds": 137.92,
      "duration_seconds": 4.54,
      "text": "Actually, it's thyroxine, 75 micrograms, every morning, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.29,
      "end_seconds": 139.36,
      "duration_seconds": 1.07,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 140.01,
      "end_seconds": 146.91,
      "duration_seconds": 6.9,
      "text": "So, he takes alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.17,
      "end_seconds": 150.53,
      "duration_seconds": 2.36,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 151.28,
      "end_seconds": 158.17,
      "duration_seconds": 6.89,
      "text": "For about three months. It's calcium tablets, 500 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.29,
      "end_seconds": 175.65,
      "duration_seconds": 3.36,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.32,
      "end_seconds": 178.31,
      "duration_seconds": 1.99,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.33,
      "end_seconds": 183.27,
      "duration_seconds": 2.94,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.93,
      "end_seconds": 199.44,
      "duration_seconds": 15.51,
      "text": "An underactive thyroid, for two years. My neighbour said I should get it looked at. So, yes, thin bones. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.51,
      "end_seconds": 208.9,
      "duration_seconds": 7.39,
      "text": "Hm, okay. Okay, I can see thin bones in your file as well. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.59,
      "end_seconds": 213.35,
      "duration_seconds": 2.76,
      "text": "No surgery, you know, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.42,
      "end_seconds": 220.64,
      "duration_seconds": 2.22,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.52,
      "end_seconds": 226.46,
      "duration_seconds": 4.94,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.99,
      "end_seconds": 230.26,
      "duration_seconds": 3.27,
      "text": "Okay, are you on your own at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.66,
      "end_seconds": 234.63,
      "duration_seconds": 2.97,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.07,
      "end_seconds": 243.84,
      "duration_seconds": 3.77,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.66,
      "end_seconds": 251.91,
      "duration_seconds": 4.25,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 256.84,
      "end_seconds": 266.63,
      "duration_seconds": 9.79,
      "text": "Actually, I remember he had some kind of reaction to trimethoprim before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.52,
      "end_seconds": 270.46,
      "duration_seconds": 1.94,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.13,
      "end_seconds": 279.54,
      "duration_seconds": 7.41,
      "text": "Alright, so that's unclear. I'll record what each of you said. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.95,
      "end_seconds": 293.81,
      "duration_seconds": 2.86,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.33,
      "end_seconds": 319.88,
      "duration_seconds": 12.55,
      "text": "Okay: pulse 74, weight 71 kilos, pressure 118 over 80, oxygen saturation is 99 percent, BMI works out to 22.9, respiratory rate 18, height 176 centimetres, temperature 37.0."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.54,
      "end_seconds": 325.26,
      "duration_seconds": 3.72,
      "text": "Well, uh, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.79,
      "end_seconds": 329.35,
      "duration_seconds": 2.56,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.81,
      "end_seconds": 335.98,
      "duration_seconds": 4.17,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.01,
      "end_seconds": 339.71,
      "duration_seconds": 1.7,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.57,
      "end_seconds": 341.77,
      "duration_seconds": 1.2,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.2,
      "end_seconds": 366.82,
      "duration_seconds": 6.62,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.95,
      "end_seconds": 368.92,
      "duration_seconds": 0.97,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.38,
      "end_seconds": 373.06,
      "duration_seconds": 1.68,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.23,
      "end_seconds": 402.57,
      "duration_seconds": 14.34,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be thin bones with a fragility fracture and back pain, or it might be a muscle strain."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.48,
      "end_seconds": 408.64,
      "duration_seconds": 4.16,
      "text": "Uh, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.98,
      "end_seconds": 421.12,
      "duration_seconds": 11.14,
      "text": "I understand the worry. At the moment I'd say it's thin bones with a fragility fracture and back pain, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.57,
      "end_seconds": 442.33,
      "duration_seconds": 13.76,
      "text": "Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. Come back after the scan. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 444.1,
      "end_seconds": 449.65,
      "duration_seconds": 5.55,
      "text": "I mean, you know, great, thank you for your help."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.88,
      "end_seconds": 452.47,
      "duration_seconds": 1.59,
      "text": "Have a good day."
    }
  ]
}