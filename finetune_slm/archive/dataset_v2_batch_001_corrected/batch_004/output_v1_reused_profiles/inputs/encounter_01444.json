{
  "schema_version": "1.0",
  "encounter_id": "01444",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 3.27,
      "duration_seconds": 2.07,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.49,
      "end_seconds": 5.52,
      "duration_seconds": 1.03,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.55,
      "end_seconds": 9.17,
      "duration_seconds": 2.62,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.62,
      "end_seconds": 23.73,
      "duration_seconds": 13.11,
      "text": "Yeah, um, it's trouble hearing in my left ear. I don't know what's causing it. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.74,
      "end_seconds": 26.07,
      "duration_seconds": 1.33,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.38,
      "end_seconds": 30.24,
      "duration_seconds": 2.86,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.65,
      "end_seconds": 34.77,
      "duration_seconds": 3.12,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.19,
      "end_seconds": 48.89,
      "duration_seconds": 12.7,
      "text": "Maybe a seven out of ten on a bad day. There was difficulty following conversation in crowds, yes, but that went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.51,
      "end_seconds": 68.79,
      "duration_seconds": 3.28,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.24,
      "end_seconds": 84.1,
      "duration_seconds": 2.86,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.55,
      "end_seconds": 111.58,
      "duration_seconds": 7.03,
      "text": "Okay: heart rate 83, saturation 98 percent. And temperature 36.9, blood pressure 128 over 81."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.78,
      "end_seconds": 114.95,
      "duration_seconds": 2.17,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.41,
      "end_seconds": 119.77,
      "duration_seconds": 3.36,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.54,
      "end_seconds": 126.54,
      "duration_seconds": 4.0,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.45,
      "end_seconds": 130.68,
      "duration_seconds": 2.23,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.94,
      "end_seconds": 143.44,
      "duration_seconds": 3.5,
      "text": "The right ear canal and drum are normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.9,
      "end_seconds": 146.98,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.07,
      "end_seconds": 161.76,
      "duration_seconds": 6.69,
      "text": "There's a lot of wax in the left ear canal, I can't see the drum."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.28,
      "end_seconds": 168.88,
      "duration_seconds": 1.6,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.05,
      "end_seconds": 182.7,
      "duration_seconds": 3.65,
      "text": "Any discharge, ear pain, headache or facial weakness?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.27,
      "end_seconds": 186.62,
      "duration_seconds": 3.35,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.94,
      "end_seconds": 190.22,
      "duration_seconds": 2.28,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.14,
      "end_seconds": 192.27,
      "duration_seconds": 1.13,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.63,
      "end_seconds": 196.96,
      "duration_seconds": 3.33,
      "text": "Okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.5,
      "end_seconds": 202.28,
      "duration_seconds": 4.78,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.85,
      "end_seconds": 205.29,
      "duration_seconds": 2.44,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 206.6,
      "end_seconds": 210.36,
      "duration_seconds": 3.76,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.99,
      "end_seconds": 218.02,
      "duration_seconds": 2.03,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.97,
      "end_seconds": 224.56,
      "duration_seconds": 5.59,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.66,
      "end_seconds": 229.16,
      "duration_seconds": 3.5,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.14,
      "end_seconds": 241.21,
      "duration_seconds": 11.07,
      "text": "I'm on telmisartan, 40 milligrams, once a day. I, I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 247.01,
      "duration_seconds": 4.26,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.54,
      "end_seconds": 249.85,
      "duration_seconds": 2.31,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.96,
      "end_seconds": 268.03,
      "duration_seconds": 10.07,
      "text": "So where does that leave us? My working impression is hearing loss from wax. I'd also keep an inner ear problem in mind."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 269.91,
      "end_seconds": 271.4,
      "duration_seconds": 1.49,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.28,
      "end_seconds": 286.23,
      "duration_seconds": 12.95,
      "text": "Nothing I've seen today points to an emergency. It looks like hearing loss from wax, but I'd like to confirm. I'm sending you for a hearing test because of hearing loss."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 286.92,
      "end_seconds": 290.98,
      "duration_seconds": 4.06,
      "text": "I can book that for Thursday at 9 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.99,
      "end_seconds": 315.8,
      "duration_seconds": 22.81,
      "text": "For this, ear drops, three times a day, for five days. That's for wax softening. Please don't use cotton buds or ear candles, they push the wax in further. If the symptoms get worse, that's the point to come in urgently. Come back after the hearing test. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.09,
      "end_seconds": 319.43,
      "duration_seconds": 2.34,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.21,
      "end_seconds": 322.62,
      "duration_seconds": 1.41,
      "text": "Take care now."
    }
  ]
}