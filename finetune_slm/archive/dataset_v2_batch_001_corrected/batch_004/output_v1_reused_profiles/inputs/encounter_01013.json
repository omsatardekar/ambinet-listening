{
  "schema_version": "1.0",
  "encounter_id": "01013",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.52,
      "duration_seconds": 4.39,
      "text": "Hi doctor, uh, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.31,
      "end_seconds": 13.81,
      "duration_seconds": 4.5,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.23,
      "end_seconds": 25.59,
      "duration_seconds": 10.36,
      "text": "I wanted to get tightness in my chest when I walk looked at. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.04,
      "end_seconds": 31.56,
      "duration_seconds": 4.52,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.9,
      "end_seconds": 47.81,
      "duration_seconds": 14.91,
      "text": "Erm, it settles a little with stopping to rest. It's worse with walking fast and climbing stairs. It happens a few times a day. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.2,
      "end_seconds": 52.07,
      "duration_seconds": 2.87,
      "text": "Has there been breathlessness on exertion too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.08,
      "end_seconds": 54.71,
      "duration_seconds": 1.63,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.53,
      "end_seconds": 59.25,
      "duration_seconds": 3.72,
      "text": "Alright, have you had any swelling in the ankles?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.67,
      "end_seconds": 65.89,
      "duration_seconds": 3.22,
      "text": "No. No swelling in the ankles."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.22,
      "end_seconds": 71.73,
      "duration_seconds": 4.51,
      "text": "And what about fever, cough, palpitations or pain at rest?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.68,
      "end_seconds": 80.35,
      "duration_seconds": 6.67,
      "text": "I mean, no, no fever, cough, palpitations or pain at rest."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.02,
      "end_seconds": 84.78,
      "duration_seconds": 2.76,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.34,
      "end_seconds": 88.85,
      "duration_seconds": 2.51,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.23,
      "end_seconds": 93.72,
      "duration_seconds": 2.49,
      "text": "Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.52,
      "end_seconds": 97.78,
      "duration_seconds": 2.26,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.92,
      "end_seconds": 101.81,
      "duration_seconds": 2.89,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.53,
      "end_seconds": 120.95,
      "duration_seconds": 13.42,
      "text": "No, I've never smoked in my life. Nothing, I'm teetotal. I'm a plumber, lots of bending and kneeling. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.25,
      "end_seconds": 124.85,
      "duration_seconds": 2.6,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.82,
      "end_seconds": 132.76,
      "duration_seconds": 3.94,
      "text": "Yes, kiwi. I get an itchy mouth."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.33,
      "end_seconds": 150.16,
      "duration_seconds": 4.83,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.68,
      "end_seconds": 159.43,
      "duration_seconds": 7.75,
      "text": "Amlodipine, 5 milligrams, once a day. I'm on aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.26,
      "end_seconds": 164.15,
      "duration_seconds": 3.89,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.9,
      "end_seconds": 170.86,
      "duration_seconds": 4.96,
      "text": "I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.62,
      "end_seconds": 174.38,
      "duration_seconds": 1.76,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.97,
      "end_seconds": 187.32,
      "duration_seconds": 3.35,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.42,
      "end_seconds": 194.44,
      "duration_seconds": 5.02,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.98,
      "end_seconds": 199.78,
      "duration_seconds": 4.8,
      "text": "Okay, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.4,
      "end_seconds": 211.29,
      "duration_seconds": 2.89,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.97,
      "end_seconds": 231.28,
      "duration_seconds": 10.31,
      "text": "Okay: BP is 161 over 102, temp 36.4 degrees, respiratory rate 14. And heart rate 89, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.21,
      "end_seconds": 233.59,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.39,
      "end_seconds": 236.98,
      "duration_seconds": 2.59,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 242.04,
      "duration_seconds": 3.83,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.59,
      "end_seconds": 244.86,
      "duration_seconds": 1.27,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.02,
      "end_seconds": 267.54,
      "duration_seconds": 4.52,
      "text": "Lungs are clear and there's no swelling in your ankles."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.35,
      "end_seconds": 271.78,
      "duration_seconds": 2.43,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.99,
      "end_seconds": 288.57,
      "duration_seconds": 2.58,
      "text": "Heart sounds are normal, no murmurs."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.84,
      "end_seconds": 292.75,
      "duration_seconds": 1.91,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.49,
      "end_seconds": 329.22,
      "duration_seconds": 20.73,
      "text": "Putting it all together, this looks most like angina-type chest pain. The reason I say that is that your story and my examination fit together. A treadmill test is what I'd like next, for exertional chest tightness. We should do an echocardiogram for chest tightness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.05,
      "end_seconds": 331.94,
      "duration_seconds": 1.89,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.55,
      "end_seconds": 336.88,
      "duration_seconds": 4.33,
      "text": "I want an ECG done, that's for chest tightness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.61,
      "end_seconds": 338.7,
      "duration_seconds": 1.09,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.46,
      "end_seconds": 372.28,
      "duration_seconds": 32.82,
      "text": "I'll start you on GTN spray, 0.4 milligrams, when the chest tightness comes, as needed. That should help with chest tightness. For this, atorvastatin, 40 milligrams, at night, long term. You take it by mouth. It's for cardiovascular risk. Don't push through the chest tightness, stop, sit down, and use the spray if I've given it to you. I'd like you to see a cardiologist as well, and I'll write the referral. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.02,
      "end_seconds": 378.24,
      "duration_seconds": 4.22,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.92,
      "end_seconds": 382.08,
      "duration_seconds": 3.16,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.37,
      "end_seconds": 384.57,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}