{
  "schema_version": "1.0",
  "encounter_id": "01225",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 4.18,
      "duration_seconds": 3.06,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.95,
      "end_seconds": 8.69,
      "duration_seconds": 3.74,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.4,
      "end_seconds": 17.09,
      "duration_seconds": 6.69,
      "text": "It's sharp heel pain with my first steps in the morning, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.23,
      "end_seconds": 26.69,
      "duration_seconds": 3.46,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.02,
      "end_seconds": 31.71,
      "duration_seconds": 3.69,
      "text": "Uh, I've had it since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.01,
      "end_seconds": 38.25,
      "duration_seconds": 6.24,
      "text": "I follow. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.98,
      "end_seconds": 54.8,
      "duration_seconds": 15.82,
      "text": "Right, it's worse with long standing and first steps. I'd call it moderate. I did try to ignore it for a while. I've also had limping a bit by the evening."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.31,
      "end_seconds": 66.14,
      "duration_seconds": 2.83,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.98,
      "end_seconds": 76.42,
      "duration_seconds": 2.44,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.04,
      "end_seconds": 103.72,
      "duration_seconds": 9.68,
      "text": "Okay: BP is 113 over 68, temperature is 36.6 degrees, SpO2 99 percent on room air, pulse 67, respiratory rate 16."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.03,
      "end_seconds": 106.44,
      "duration_seconds": 1.41,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.95,
      "end_seconds": 110.89,
      "duration_seconds": 2.94,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.43,
      "end_seconds": 134.48,
      "duration_seconds": 5.05,
      "text": "A few quick ones: numbness in the foot or back pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.33,
      "end_seconds": 141.69,
      "duration_seconds": 5.36,
      "text": "No, uh, no numbness in the foot or back pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.25,
      "end_seconds": 144.75,
      "duration_seconds": 2.5,
      "text": "Any fever or swelling at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.15,
      "end_seconds": 150.11,
      "duration_seconds": 3.96,
      "text": "I haven't had fever or swelling, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.65,
      "end_seconds": 153.21,
      "duration_seconds": 2.56,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.82,
      "end_seconds": 158.49,
      "duration_seconds": 3.67,
      "text": "Nothing on the skin, uh, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.49,
      "end_seconds": 162.68,
      "duration_seconds": 2.19,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.39,
      "end_seconds": 166.76,
      "duration_seconds": 3.37,
      "text": "Hmm, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.78,
      "end_seconds": 172.66,
      "duration_seconds": 4.88,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.64,
      "end_seconds": 181.17,
      "duration_seconds": 6.53,
      "text": "Mirtazapine. I take it 15 milligrams, at night. It's, It's rosuvastatin, at night."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.58,
      "end_seconds": 184.69,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.43,
      "end_seconds": 191.37,
      "duration_seconds": 4.94,
      "text": "10 milligrams. I was on fluoxetine before. I stopped taking it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.12,
      "end_seconds": 193.44,
      "duration_seconds": 1.32,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.54,
      "end_seconds": 197.21,
      "duration_seconds": 1.67,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.8,
      "end_seconds": 199.01,
      "duration_seconds": 1.21,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.78,
      "end_seconds": 205.15,
      "duration_seconds": 4.37,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.86,
      "end_seconds": 207.19,
      "duration_seconds": 1.33,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.64,
      "end_seconds": 211.39,
      "duration_seconds": 2.75,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.43,
      "end_seconds": 215.16,
      "duration_seconds": 1.73,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.12,
      "end_seconds": 220.77,
      "duration_seconds": 3.65,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.83,
      "end_seconds": 224.64,
      "duration_seconds": 1.81,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.66,
      "end_seconds": 230.26,
      "duration_seconds": 4.6,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.25,
      "end_seconds": 234.61,
      "duration_seconds": 2.36,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.22,
      "end_seconds": 240.55,
      "duration_seconds": 5.33,
      "text": "I, I have depression, for two years. I've got high cholesterol."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.97,
      "end_seconds": 248.92,
      "duration_seconds": 6.95,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.23,
      "end_seconds": 270.28,
      "duration_seconds": 5.05,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.03,
      "end_seconds": 273.85,
      "duration_seconds": 2.82,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.48,
      "end_seconds": 280.08,
      "duration_seconds": 4.6,
      "text": "From what you've told me, it fits best with plantar fasciitis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.71,
      "end_seconds": 283.98,
      "duration_seconds": 3.27,
      "text": "Um, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.82,
      "end_seconds": 305.07,
      "duration_seconds": 19.25,
      "text": "I can't promise yet, but most people with plantar fasciitis do well once it's treated properly. We should do an X-ray of the foot for heel pain. Supportive shoes with a cushioned heel help. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.7,
      "end_seconds": 308.82,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.69,
      "end_seconds": 311.98,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}