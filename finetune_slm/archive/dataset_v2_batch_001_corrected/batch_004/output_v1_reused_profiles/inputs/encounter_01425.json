{
  "schema_version": "1.0",
  "encounter_id": "01425",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 7.05,
      "duration_seconds": 6.2,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.62,
      "end_seconds": 12.03,
      "duration_seconds": 4.41,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.49,
      "end_seconds": 19.41,
      "duration_seconds": 5.92,
      "text": "Well, I've been having sudden hearing loss in my left ear."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.51,
      "end_seconds": 23.93,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.24,
      "end_seconds": 28.65,
      "duration_seconds": 3.41,
      "text": "Okay, so no, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.41,
      "end_seconds": 32.19,
      "duration_seconds": 2.78,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.45,
      "end_seconds": 35.82,
      "duration_seconds": 2.37,
      "text": "I've had it since yesterday."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.5,
      "end_seconds": 44.1,
      "duration_seconds": 7.6,
      "text": "Let me check a few things. Any recent flying, head injury, headache or ear pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.42,
      "end_seconds": 48.28,
      "duration_seconds": 2.86,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.19,
      "end_seconds": 52.51,
      "duration_seconds": 3.32,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.54,
      "end_seconds": 58.69,
      "duration_seconds": 2.15,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.58,
      "end_seconds": 64.52,
      "duration_seconds": 3.94,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.18,
      "end_seconds": 69.69,
      "duration_seconds": 1.51,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.38,
      "end_seconds": 90.27,
      "duration_seconds": 1.89,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.17,
      "end_seconds": 94.42,
      "duration_seconds": 3.25,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.18,
      "end_seconds": 98.02,
      "duration_seconds": 2.84,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 101.5,
      "duration_seconds": 2.86,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.71,
      "end_seconds": 110.16,
      "duration_seconds": 3.45,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.25,
      "end_seconds": 116.85,
      "duration_seconds": 4.6,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.71,
      "end_seconds": 134.21,
      "duration_seconds": 3.5,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.81,
      "end_seconds": 137.74,
      "duration_seconds": 1.93,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.52,
      "end_seconds": 142.45,
      "duration_seconds": 3.93,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.75,
      "end_seconds": 147.19,
      "duration_seconds": 3.44,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.19,
      "end_seconds": 152.85,
      "duration_seconds": 3.66,
      "text": "Right, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.79,
      "end_seconds": 162.06,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.72,
      "end_seconds": 178.65,
      "duration_seconds": 3.93,
      "text": "Okay: pressure 128 over 69, heart rate 72."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.15,
      "end_seconds": 180.8,
      "duration_seconds": 1.65,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.09,
      "end_seconds": 184.81,
      "duration_seconds": 2.72,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.53,
      "end_seconds": 190.67,
      "duration_seconds": 4.14,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.59,
      "end_seconds": 194.6,
      "duration_seconds": 2.01,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.05,
      "end_seconds": 214.14,
      "duration_seconds": 6.09,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.87,
      "end_seconds": 231.94,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.9,
      "end_seconds": 237.99,
      "duration_seconds": 2.09,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.27,
      "end_seconds": 256.92,
      "duration_seconds": 8.65,
      "text": "So, based on the history and the examination, it fits best with sudden loss of hearing that needs urgent assessment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.68,
      "end_seconds": 260.76,
      "duration_seconds": 3.08,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.17,
      "end_seconds": 283.21,
      "duration_seconds": 21.04,
      "text": "I understand the worry. At the moment I'd say it's sudden loss of hearing that needs urgent assessment, and we'll know more once the an MRI scan is back. Just to be sure I understood. You've had sudden hearing loss in your left ear, since yesterday, and no headache or head injury."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.48,
      "end_seconds": 285.18,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.92,
      "end_seconds": 295.26,
      "duration_seconds": 8.34,
      "text": "We should do an MRI scan for unilateral hearing loss. I'd like to arrange a hearing test for sudden hearing loss."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.16,
      "end_seconds": 297.5,
      "duration_seconds": 1.34,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.14,
      "end_seconds": 321.97,
      "duration_seconds": 22.83,
      "text": "What I'm giving you is prednisolone, 60 milligrams, once a day in the morning, for seven days. It's for sudden hearing loss. The pharmacy will go through the details again when you pick it up. Please attend the hearing test today if you can, as timing matters. Come back after the hearing test."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.19,
      "end_seconds": 325.37,
      "duration_seconds": 2.18,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.91,
      "end_seconds": 333.11,
      "duration_seconds": 3.2,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.26,
      "end_seconds": 336.4,
      "duration_seconds": 2.14,
      "text": "Alright, thanks, take care."
    }
  ]
}