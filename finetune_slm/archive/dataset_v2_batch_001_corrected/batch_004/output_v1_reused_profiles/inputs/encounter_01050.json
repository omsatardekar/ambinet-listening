{
  "schema_version": "1.0",
  "encounter_id": "01050",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 5.59,
      "duration_seconds": 4.72,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.77,
      "end_seconds": 7.86,
      "duration_seconds": 1.09,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.02,
      "end_seconds": 12.66,
      "duration_seconds": 3.64,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.04,
      "end_seconds": 22.4,
      "duration_seconds": 8.36,
      "text": "I've been dealing with a painful band of blisters on the left side of my chest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.19,
      "end_seconds": 25.13,
      "duration_seconds": 1.94,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.16,
      "end_seconds": 29.13,
      "duration_seconds": 2.97,
      "text": "Since yesterday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.17,
      "end_seconds": 43.87,
      "duration_seconds": 9.7,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.22,
      "end_seconds": 52.41,
      "duration_seconds": 7.19,
      "text": "Yes, clothing rubbing. That makes it worse. It happens a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.33,
      "end_seconds": 57.09,
      "duration_seconds": 3.76,
      "text": "What about a mild fever, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.01,
      "end_seconds": 65.85,
      "duration_seconds": 6.84,
      "text": "Yes, about the same, three days. About mild fever, I'd call it moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.75,
      "end_seconds": 70.17,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.8,
      "end_seconds": 72.43,
      "duration_seconds": 1.63,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.18,
      "end_seconds": 89.54,
      "duration_seconds": 4.36,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.51,
      "end_seconds": 94.74,
      "duration_seconds": 3.23,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.49,
      "end_seconds": 97.91,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.81,
      "end_seconds": 102.74,
      "duration_seconds": 3.93,
      "text": "Oh, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.98,
      "end_seconds": 108.47,
      "duration_seconds": 4.49,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.35,
      "end_seconds": 118.34,
      "duration_seconds": 8.99,
      "text": "Years back I got a rash all over from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.52,
      "end_seconds": 121.72,
      "duration_seconds": 2.2,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.59,
      "end_seconds": 127.51,
      "duration_seconds": 3.92,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.27,
      "end_seconds": 129.89,
      "duration_seconds": 1.62,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.57,
      "end_seconds": 135.08,
      "duration_seconds": 4.51,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.17,
      "end_seconds": 144.69,
      "duration_seconds": 2.52,
      "text": "So, any weakness or immune problems?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.79,
      "end_seconds": 150.09,
      "duration_seconds": 3.3,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.76,
      "end_seconds": 154.44,
      "duration_seconds": 3.68,
      "text": "Any rash on the other side or blurred vision?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.28,
      "end_seconds": 161.11,
      "duration_seconds": 5.83,
      "text": "I haven't had rash on the other side or blurred vision, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.57,
      "end_seconds": 165.21,
      "duration_seconds": 3.64,
      "text": "Understood. So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.41,
      "end_seconds": 167.82,
      "duration_seconds": 1.41,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.62,
      "end_seconds": 172.95,
      "duration_seconds": 3.33,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.93,
      "end_seconds": 180.23,
      "duration_seconds": 5.3,
      "text": "Uh, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.07,
      "end_seconds": 194.63,
      "duration_seconds": 2.56,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.77,
      "end_seconds": 206.1,
      "duration_seconds": 3.33,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.28,
      "end_seconds": 224.03,
      "duration_seconds": 5.75,
      "text": "Okay: temperature 36.7, pulse 86. And saturation 97 percent, pressure 113 over 80."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.08,
      "end_seconds": 226.64,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.43,
      "end_seconds": 232.03,
      "duration_seconds": 3.6,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 236.19,
      "duration_seconds": 2.25,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.44,
      "end_seconds": 238.77,
      "duration_seconds": 1.33,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.74,
      "end_seconds": 261.1,
      "duration_seconds": 7.36,
      "text": "Grouped blisters on a red base along one rib on the left, not crossing the midline."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.24,
      "end_seconds": 265.56,
      "duration_seconds": 2.32,
      "text": "Okay, all finished, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.18,
      "end_seconds": 311.99,
      "duration_seconds": 31.81,
      "text": "From what you've told me and what I found, I think we're dealing with shingles at this stage. That's my thinking for now, and it may change as we learn more. You'll be taking paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. It's for pain. I'd like to see you again in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.83,
      "end_seconds": 317.26,
      "duration_seconds": 4.43,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.16,
      "end_seconds": 320.25,
      "duration_seconds": 2.09,
      "text": "Okay, look after yourself."
    }
  ]
}