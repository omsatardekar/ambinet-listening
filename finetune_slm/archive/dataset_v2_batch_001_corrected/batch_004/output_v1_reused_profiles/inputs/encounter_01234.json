{
  "schema_version": "1.0",
  "encounter_id": "01234",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.18,
      "end_seconds": 6.33,
      "duration_seconds": 5.15,
      "text": "doctor, we're ready in room two, I've already taken the observations"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 10.01,
      "duration_seconds": 3.1,
      "text": "Thank you. Right, hello, what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.3,
      "end_seconds": 15.48,
      "duration_seconds": 4.18,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 16.97,
      "end_seconds": 20.98,
      "duration_seconds": 4.01,
      "text": "Well, I've been having aching in my thighs."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.88,
      "end_seconds": 25.21,
      "duration_seconds": 3.33,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 27.22,
      "end_seconds": 31.36,
      "duration_seconds": 4.14,
      "text": "it's been going on for about four days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.7,
      "end_seconds": 36.16,
      "duration_seconds": 4.46,
      "text": "okay, go on how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.77,
      "end_seconds": 43.04,
      "duration_seconds": 4.27,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.0,
      "end_seconds": 47.92,
      "duration_seconds": 2.92,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 49.48,
      "end_seconds": 58.56,
      "duration_seconds": 9.08,
      "text": "Dark urine goes along with it, most of the time there's cramps as well and tiredness, too"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.38,
      "end_seconds": 67.96,
      "duration_seconds": 5.58,
      "text": "Have you had aching in your thighs before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.56,
      "end_seconds": 73.39,
      "duration_seconds": 4.83,
      "text": "a bit, last winter. It settled by itself back then"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 74.25,
      "end_seconds": 76.54,
      "duration_seconds": 2.29,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 78.21,
      "end_seconds": 87.31,
      "duration_seconds": 9.1,
      "text": "doctor, I've got the readings for you bP is 109 over 81, heart rate 72, SpO2 98 percent on room air"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.69,
      "end_seconds": 89.62,
      "duration_seconds": 0.93,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.55,
      "end_seconds": 95.42,
      "duration_seconds": 3.87,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.55,
      "end_seconds": 97.84,
      "duration_seconds": 1.29,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.43,
      "end_seconds": 110.29,
      "duration_seconds": 3.86,
      "text": "The muscles are mildly tender when I squeeze."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.98,
      "end_seconds": 113.67,
      "duration_seconds": 1.69,
      "text": "Okay, does that hurt?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.05,
      "end_seconds": 136.44,
      "duration_seconds": 4.39,
      "text": "Power in the thighs is slightly reduced, four out of five."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.56,
      "end_seconds": 148.77,
      "duration_seconds": 8.21,
      "text": "Alright, that's all I needed to check. Did you get trouble swallowing, numbness, recent heavy exercise or joint swelling?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.11,
      "end_seconds": 155.96,
      "duration_seconds": 5.85,
      "text": "No, no trouble swallowing, numbness, recent heavy exercise or joint swelling."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.27,
      "end_seconds": 159.71,
      "duration_seconds": 2.44,
      "text": "Did you get fever or rash?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 161.78,
      "end_seconds": 165.35,
      "duration_seconds": 3.57,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.79,
      "end_seconds": 170.87,
      "duration_seconds": 4.08,
      "text": "okay, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 172.61,
      "end_seconds": 174.45,
      "duration_seconds": 1.84,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.57,
      "end_seconds": 192.77,
      "duration_seconds": 1.2,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 194.38,
      "end_seconds": 195.94,
      "duration_seconds": 1.56,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.56,
      "end_seconds": 197.92,
      "duration_seconds": 1.36,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.92,
      "end_seconds": 203.21,
      "duration_seconds": 4.29,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.85,
      "end_seconds": 205.29,
      "duration_seconds": 1.44,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 206.46,
      "end_seconds": 211.45,
      "duration_seconds": 4.99,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.75,
      "end_seconds": 217.55,
      "duration_seconds": 1.8,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.27,
      "end_seconds": 222.89,
      "duration_seconds": 4.62,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.35,
      "end_seconds": 229.2,
      "duration_seconds": 4.85,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 232.51,
      "end_seconds": 244.74,
      "duration_seconds": 12.23,
      "text": "hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.6,
      "end_seconds": 249.07,
      "duration_seconds": 3.47,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.11,
      "end_seconds": 254.54,
      "duration_seconds": 4.43,
      "text": "I have an underactive thyroid, for about ten years"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.45,
      "end_seconds": 257.15,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 258.97,
      "end_seconds": 262.97,
      "duration_seconds": 4.0,
      "text": "High blood pressure, for nearly five years"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.64,
      "end_seconds": 266.08,
      "duration_seconds": 1.44,
      "text": "okay, go on"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 267.67,
      "end_seconds": 272.58,
      "duration_seconds": 4.91,
      "text": "mm, I've had high cholesterol for about ten years now"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.74,
      "end_seconds": 282.0,
      "duration_seconds": 8.26,
      "text": "Right, so an underactive thyroid and high cholesterol are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.76,
      "end_seconds": 294.55,
      "duration_seconds": 3.79,
      "text": "Alright, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.72,
      "end_seconds": 298.36,
      "duration_seconds": 2.64,
      "text": "Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.0,
      "end_seconds": 302.42,
      "duration_seconds": 3.42,
      "text": "since when have you been taking it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 304.11,
      "end_seconds": 315.05,
      "duration_seconds": 10.94,
      "text": "About about three months. Losartan, 50 milligrams, once a day. Atorvastatin. I take it 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.87,
      "end_seconds": 320.13,
      "duration_seconds": 3.26,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 324.05,
      "end_seconds": 333.05,
      "duration_seconds": 9.0,
      "text": "right, not with me. I'll bring it next time. I used to take amlodipine, but I stopped it"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.97,
      "end_seconds": 337.12,
      "duration_seconds": 3.15,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 339.92,
      "end_seconds": 345.11,
      "duration_seconds": 5.19,
      "text": "my sister had breast cancer. My aunt has rheumatoid arthritis"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.2,
      "end_seconds": 374.32,
      "duration_seconds": 28.12,
      "text": "Taking everything into account, I'd lean towards muscle symptoms that may be related to the cholesterol tablet. It could also be a vitamin D deficiency, so we'll keep that open. I'm sending you for a vitamin D level because of muscle weakness. Let's book a creatine kinase level to look into muscle pain. I'm sending you for a thyroid test because of muscle weakness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.36,
      "end_seconds": 392.55,
      "duration_seconds": 14.19,
      "text": "Don't stop any of your tablets on your own, we'll decide after the blood test. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 393.81,
      "end_seconds": 395.48,
      "duration_seconds": 1.67,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.05,
      "end_seconds": 404.06,
      "duration_seconds": 7.01,
      "text": "Do get help quickly if the symptoms get worse. We'll catch up after the results are back."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 405.64,
      "end_seconds": 406.34,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.46,
      "end_seconds": 411.05,
      "duration_seconds": 3.59,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 412.49,
      "end_seconds": 416.21,
      "duration_seconds": 3.72,
      "text": "Uh, great, thank you for your help."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.23,
      "end_seconds": 419.42,
      "duration_seconds": 1.19,
      "text": "look after yourself"
    }
  ]
}