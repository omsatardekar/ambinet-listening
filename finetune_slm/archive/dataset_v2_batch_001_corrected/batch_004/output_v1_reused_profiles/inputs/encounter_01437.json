{
  "schema_version": "1.0",
  "encounter_id": "01437",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.2,
      "end_seconds": 4.52,
      "duration_seconds": 3.32,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.3,
      "end_seconds": 9.17,
      "duration_seconds": 3.87,
      "text": "of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.86,
      "end_seconds": 16.19,
      "duration_seconds": 5.33,
      "text": "I wanted to get an itch down below looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.2,
      "end_seconds": 21.76,
      "duration_seconds": 3.56,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.3,
      "end_seconds": 26.97,
      "duration_seconds": 3.67,
      "text": "It's been going on for three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.06,
      "end_seconds": 31.36,
      "duration_seconds": 3.3,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.62,
      "end_seconds": 37.64,
      "duration_seconds": 1.02,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.7,
      "end_seconds": 42.5,
      "duration_seconds": 2.8,
      "text": "have you tried anything for it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.0,
      "end_seconds": 55.92,
      "duration_seconds": 11.92,
      "text": "A cool compress helps a bit. Mm, I've also had pain when passing urine. Erm, I had soreness before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.55,
      "end_seconds": 62.63,
      "duration_seconds": 6.08,
      "text": "Have you had an itch down below before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.2,
      "end_seconds": 73.18,
      "duration_seconds": 9.98,
      "text": "yes, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.16,
      "end_seconds": 79.56,
      "duration_seconds": 4.4,
      "text": "Right, any fever, new partner or being pregnant at all?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.36,
      "end_seconds": 87.65,
      "duration_seconds": 6.29,
      "text": "I haven't had fever, new partner or being pregnant, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.32,
      "end_seconds": 92.28,
      "duration_seconds": 3.96,
      "text": "and what about bleeding between periods or pelvic pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.98,
      "end_seconds": 99.11,
      "duration_seconds": 5.13,
      "text": "I haven't had bleeding between periods or pelvic pain, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.89,
      "end_seconds": 103.51,
      "duration_seconds": 3.62,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.49,
      "end_seconds": 106.99,
      "duration_seconds": 2.5,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.01,
      "end_seconds": 110.8,
      "duration_seconds": 2.79,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.12,
      "end_seconds": 113.18,
      "duration_seconds": 1.06,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.73,
      "end_seconds": 134.01,
      "duration_seconds": 5.28,
      "text": "Any inherited conditions that you know of in the the family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.9,
      "end_seconds": 136.87,
      "duration_seconds": 1.97,
      "text": "my son has asthma"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.64,
      "end_seconds": 140.37,
      "duration_seconds": 2.73,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.03,
      "end_seconds": 143.89,
      "duration_seconds": 2.86,
      "text": "yes, I'm allergic to diclofenac"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.33,
      "end_seconds": 150.95,
      "duration_seconds": 5.62,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.88,
      "end_seconds": 162.51,
      "duration_seconds": 10.63,
      "text": "Yes, I work in a bakery, early starts. I'm vegetarian and have been for years. I swim twice a week."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.18,
      "end_seconds": 165.77,
      "duration_seconds": 2.59,
      "text": "are you on any regular medication?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.65,
      "end_seconds": 169.54,
      "duration_seconds": 2.89,
      "text": "no, nothing at the moment"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.25,
      "end_seconds": 174.62,
      "duration_seconds": 4.37,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.53,
      "end_seconds": 178.75,
      "duration_seconds": 2.22,
      "text": "Diabetes, for five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.81,
      "end_seconds": 187.26,
      "duration_seconds": 3.45,
      "text": "alright, diabetes, that matches what I have here"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.61,
      "end_seconds": 197.98,
      "duration_seconds": 2.37,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.62,
      "end_seconds": 205.39,
      "duration_seconds": 6.77,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.65,
      "end_seconds": 208.66,
      "duration_seconds": 2.01,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.63,
      "end_seconds": 217.58,
      "duration_seconds": 1.95,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.78,
      "end_seconds": 246.57,
      "duration_seconds": 9.79,
      "text": "Okay: SpO2 99 percent on room air, respiratory rate 14. And heart rate 75, BP is 116 over 78, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.17,
      "end_seconds": 249.73,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.78,
      "end_seconds": 253.17,
      "duration_seconds": 2.39,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.18,
      "end_seconds": 257.54,
      "duration_seconds": 2.36,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.11,
      "end_seconds": 261.05,
      "duration_seconds": 1.94,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.09,
      "end_seconds": 264.07,
      "duration_seconds": 1.98,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.44,
      "end_seconds": 281.95,
      "duration_seconds": 5.51,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.63,
      "end_seconds": 286.35,
      "duration_seconds": 1.72,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.7,
      "end_seconds": 313.77,
      "duration_seconds": 10.07,
      "text": "So, based on the history and the examination, my working impression is vaginal thrush. Let's book a urine test to look into dysuria."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.15,
      "end_seconds": 322.16,
      "duration_seconds": 3.01,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.23,
      "end_seconds": 328.36,
      "duration_seconds": 4.13,
      "text": "I think a swab makes sense here, for vaginal discharge."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.05,
      "end_seconds": 332.17,
      "duration_seconds": 2.12,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.75,
      "end_seconds": 355.88,
      "duration_seconds": 23.13,
      "text": "I'm going to put you on clotrimazole pessary, 500 milligrams, once at night, for one day. It's for thrush. Wear cotton underwear and avoid scented soaps or washes. I'll want another look if it isn't better in a week. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.92,
      "end_seconds": 361.26,
      "duration_seconds": 4.34,
      "text": "Mm, good, thanks, I'll see you then."
    }
  ]
}