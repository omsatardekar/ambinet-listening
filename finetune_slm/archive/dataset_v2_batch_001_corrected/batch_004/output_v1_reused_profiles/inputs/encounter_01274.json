  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.55,
      "end_seconds": 3.82,
      "duration_seconds": 3.27,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.64,
      "end_seconds": 9.93,
      "duration_seconds": 5.29,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.19,
      "end_seconds": 12.85,
      "duration_seconds": 1.66,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.55,
      "end_seconds": 18.9,
      "duration_seconds": 5.35,
      "text": "Okay, so I'm here because of headaches in the morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.44,
      "end_seconds": 23.02,
      "duration_seconds": 3.58,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.22,
      "end_seconds": 32.26,
      "duration_seconds": 8.04,
      "text": "Actually, for about a year, I'd say. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.82,
      "end_seconds": 41.49,
      "duration_seconds": 8.67,
      "text": "Ah. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.27,
      "end_seconds": 46.12,
      "duration_seconds": 3.85,
      "text": "Mostly mild. It sort of comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.47,
      "end_seconds": 66.15,
      "duration_seconds": 2.68,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.92,
      "end_seconds": 73.22,
      "duration_seconds": 5.3,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.72,
      "end_seconds": 82.35,
      "duration_seconds": 3.63,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.87,
      "end_seconds": 84.43,
      "duration_seconds": 1.56,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.84,
      "end_seconds": 99.5,
      "duration_seconds": 2.66,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.33,
      "end_seconds": 103.7,
      "duration_seconds": 2.37,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.11,
      "end_seconds": 109.18,
      "duration_seconds": 4.07,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.12,
      "end_seconds": 111.77,
      "duration_seconds": 1.65,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.87,
      "end_seconds": 121.96,
      "duration_seconds": 2.09,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.66,
      "end_seconds": 127.91,
      "duration_seconds": 4.25,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.5,
      "end_seconds": 132.96,
      "duration_seconds": 3.46,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.65,
      "end_seconds": 138.84,
      "duration_seconds": 4.19,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.58,
      "end_seconds": 146.05,
      "duration_seconds": 5.47,
      "text": "Any weakness on one side, passing less urine or shortness of breath?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.32,
      "end_seconds": 155.08,
      "duration_seconds": 7.76,
      "text": "Mm, no, no weakness on one side, passing less urine or shortness of breath."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.69,
      "end_seconds": 158.33,
      "duration_seconds": 1.64,
      "text": "Nothing like ankle swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.86,
      "end_seconds": 162.23,
      "duration_seconds": 3.37,
      "text": "Not that I've noticed, no ankle swelling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.69,
      "end_seconds": 165.98,
      "duration_seconds": 2.29,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.77,
      "end_seconds": 171.32,
      "duration_seconds": 3.55,
      "text": "Let me think, no, that's all fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.45,
      "end_seconds": 179.69,
      "duration_seconds": 3.24,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.53,
      "end_seconds": 195.31,
      "duration_seconds": 2.78,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.33,
      "end_seconds": 223.69,
      "duration_seconds": 7.36,
      "text": "Okay: BP is 148 over 104, respiratory rate 14, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.35,
      "end_seconds": 239.86,
      "duration_seconds": 7.51,
      "text": "Okay, so my impression from what you've said is this: This looks most like poorly controlled high blood pressure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.61,
      "end_seconds": 243.89,
      "duration_seconds": 3.28,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.84,
      "end_seconds": 258.23,
      "duration_seconds": 13.39,
      "text": "It's reasonable to be concerned, but right now poorly controlled high blood pressure is my leading thought, not anything worse. Let's get a home blood pressure diary, for hypertension."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 260.21,
      "end_seconds": 264.93,
      "duration_seconds": 4.72,
      "text": "We have a slot Friday at 11:30 am, if that works."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.48,
      "end_seconds": 299.35,
      "duration_seconds": 31.87,
      "text": "We should do a urine test for hypertension. The treatment will be amlodipine, 5 milligrams, once a day, long term. You take it by mouth. That should help with high blood pressure. Check your blood pressure at home twice a day for a week and bring the readings. One warning sign to remember: you get chest pain, weakness or trouble speaking. In that case don't wait. Come back in four weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.35,
      "end_seconds": 304.79,
      "duration_seconds": 4.44,
      "text": "Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.26,
      "end_seconds": 310.5,
      "duration_seconds": 2.24,
      "text": "Thank you, that's helpful."
    }
  ]
}