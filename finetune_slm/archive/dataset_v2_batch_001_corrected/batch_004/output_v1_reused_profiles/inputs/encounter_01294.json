  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 5.22,
      "duration_seconds": 4.23,
      "text": "morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.3,
      "end_seconds": 12.22,
      "duration_seconds": 4.92,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.44,
      "end_seconds": 23.03,
      "duration_seconds": 5.59,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.02,
      "end_seconds": 30.17,
      "duration_seconds": 5.15,
      "text": "Right, I've been dealing with itching around my bottom."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.88,
      "end_seconds": 35.29,
      "duration_seconds": 3.41,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.91,
      "end_seconds": 45.61,
      "duration_seconds": 8.7,
      "text": "probably one week. Yeah. Sorry, you know, I know I'm rambling a a bit"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.14,
      "end_seconds": 56.8,
      "duration_seconds": 10.66,
      "text": "I follow. Can you describe it a bit more for me? How strong it it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.51,
      "end_seconds": 63.87,
      "duration_seconds": 6.36,
      "text": "A cream helps a bit about a five out of ten"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.7,
      "end_seconds": 69.59,
      "duration_seconds": 3.89,
      "text": "Has there been bright red blood on the paper too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.61,
      "end_seconds": 72.83,
      "duration_seconds": 2.22,
      "text": "Yes, you know, actually."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.03,
      "end_seconds": 80.16,
      "duration_seconds": 6.13,
      "text": "okay, have you had itching around your bottom before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.8,
      "end_seconds": 86.32,
      "duration_seconds": 5.52,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.48,
      "end_seconds": 105.69,
      "duration_seconds": 4.21,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.57,
      "end_seconds": 118.67,
      "duration_seconds": 12.1,
      "text": "I've got low haemoglobin. I didn't want to bother you but it keeps coming back. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.64,
      "end_seconds": 122.76,
      "duration_seconds": 3.12,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.95,
      "end_seconds": 126.76,
      "duration_seconds": 2.81,
      "text": "Yeah, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.35,
      "end_seconds": 132.75,
      "duration_seconds": 4.4,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 134.67,
      "end_seconds": 144.53,
      "duration_seconds": 9.86,
      "text": "she is on iron tablets, once a day for my blood count, I give it to her"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.87,
      "end_seconds": 148.51,
      "duration_seconds": 2.64,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 150.56,
      "end_seconds": 157.43,
      "duration_seconds": 6.87,
      "text": "Nearly five years now. Uh, it's a soothing cream, when needed, doctor."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.96,
      "end_seconds": 171.81,
      "duration_seconds": 2.85,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.01,
      "end_seconds": 181.02,
      "duration_seconds": 8.01,
      "text": "I was told I'm allergic to cat fur, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.96,
      "end_seconds": 197.58,
      "duration_seconds": 1.62,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.65,
      "end_seconds": 201.62,
      "duration_seconds": 1.97,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.44,
      "end_seconds": 204.83,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.45,
      "end_seconds": 210.28,
      "duration_seconds": 3.83,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.0,
      "end_seconds": 212.33,
      "duration_seconds": 1.33,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.34,
      "end_seconds": 216.94,
      "duration_seconds": 3.6,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.5,
      "end_seconds": 221.12,
      "duration_seconds": 2.62,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.0,
      "end_seconds": 225.44,
      "duration_seconds": 3.44,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.04,
      "end_seconds": 228.84,
      "duration_seconds": 2.8,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.53,
      "end_seconds": 237.44,
      "duration_seconds": 7.91,
      "text": "yes, um, I had a wisdom tooth extraction under sedation, five years ago"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.33,
      "end_seconds": 243.49,
      "duration_seconds": 4.16,
      "text": "did you get black stools, dizziness, severe pain or fever?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.54,
      "end_seconds": 248.95,
      "duration_seconds": 3.41,
      "text": "Nope, you know, nothing like that."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.7,
      "end_seconds": 252.62,
      "duration_seconds": 2.92,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.34,
      "end_seconds": 257.06,
      "duration_seconds": 2.72,
      "text": "erm, no, joints are fine"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.63,
      "end_seconds": 260.19,
      "duration_seconds": 2.56,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.38,
      "end_seconds": 274.09,
      "duration_seconds": 2.71,
      "text": "so, sit still for a moment.."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.5,
      "end_seconds": 292.07,
      "duration_seconds": 7.57,
      "text": "Okay: pulse is 84 beats a minute, blood pressure 113 over 70, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.88,
      "end_seconds": 295.62,
      "duration_seconds": 2.74,
      "text": "mm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.42,
      "end_seconds": 300.02,
      "duration_seconds": 2.6,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.54,
      "end_seconds": 305.5,
      "duration_seconds": 3.96,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.57,
      "end_seconds": 308.53,
      "duration_seconds": 1.96,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.4,
      "end_seconds": 328.64,
      "duration_seconds": 9.24,
      "text": "There is a small soft lump at the edge of the anus and no tear that I can see."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.86,
      "end_seconds": 361.98,
      "duration_seconds": 31.12,
      "text": "That's the examination finished. Putting it all together, this looks most like haemorrhoids. It could also be a polyp in the bowel, so we'll keep that open. I'm sending you for a blood count because of rectal bleeding. Let's get a camera test of the bowel, for rectal bleeding. The result will help us decide whether anything more is needed. Fibre, plenty of water, and don't sit on the toilet for long."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.23,
      "end_seconds": 369.93,
      "duration_seconds": 7.7,
      "text": "Yes. Let's review you after the camera test. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.69,
      "end_seconds": 373.67,
      "duration_seconds": 2.98,
      "text": "I think I understand everything. Thanks."
    }
  ]
}