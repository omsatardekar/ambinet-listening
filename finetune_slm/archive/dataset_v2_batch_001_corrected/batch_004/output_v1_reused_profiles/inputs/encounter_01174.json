      "role": "DOCTOR",
      "start_seconds": 267.97,
      "end_seconds": 278.45,
      "duration_seconds": 10.48,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, this is probably a refractive problem or early cataracts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.04,
      "end_seconds": 282.0,
      "duration_seconds": 2.96,
      "text": "Do you think it's something serious?"
