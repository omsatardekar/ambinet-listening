{
  "schema_version": "1.0",
  "encounter_id": "01398",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.83,
      "duration_seconds": 3.86,
      "text": "Sorry, um, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.26,
      "end_seconds": 11.4,
      "duration_seconds": 5.14,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.4,
      "end_seconds": 17.61,
      "duration_seconds": 4.21,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.22,
      "end_seconds": 22.25,
      "duration_seconds": 4.03,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.31,
      "end_seconds": 32.33,
      "duration_seconds": 8.02,
      "text": "it's been coughing up yellow phlegm, doctor he didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.4,
      "end_seconds": 36.66,
      "duration_seconds": 2.26,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.69,
      "end_seconds": 45.6,
      "duration_seconds": 3.91,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.49,
      "end_seconds": 49.28,
      "duration_seconds": 2.79,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.84,
      "end_seconds": 55.58,
      "duration_seconds": 4.74,
      "text": "Maybe a eight out of ten on a bad day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.14,
      "end_seconds": 59.53,
      "duration_seconds": 2.39,
      "text": "is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.47,
      "end_seconds": 80.29,
      "duration_seconds": 18.82,
      "text": "When it starts I tend to get a sore throat as well. As for bad cough, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.16,
      "end_seconds": 86.98,
      "duration_seconds": 5.82,
      "text": "okay, give me more detail on it, whatever comes to to mind"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.42,
      "end_seconds": 95.36,
      "duration_seconds": 6.94,
      "text": "It just comes and goes. Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.04,
      "end_seconds": 99.87,
      "duration_seconds": 3.83,
      "text": "are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 100.52,
      "end_seconds": 103.6,
      "duration_seconds": 3.08,
      "text": "it's cough syrup, at night, doctor"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.25,
      "end_seconds": 110.07,
      "duration_seconds": 4.82,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.03,
      "end_seconds": 114.92,
      "duration_seconds": 2.89,
      "text": "I've, I've never had an allergy"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.42,
      "end_seconds": 119.01,
      "duration_seconds": 2.59,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.4,
      "end_seconds": 123.43,
      "duration_seconds": 3.03,
      "text": "I've had high blood pressure, yes"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.6,
      "end_seconds": 131.57,
      "duration_seconds": 6.97,
      "text": "Understood. Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.61,
      "end_seconds": 142.76,
      "duration_seconds": 3.15,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.55,
      "end_seconds": 147.34,
      "duration_seconds": 2.79,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.27,
      "end_seconds": 152.68,
      "duration_seconds": 2.41,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.53,
      "end_seconds": 160.37,
      "duration_seconds": 5.84,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.07,
      "end_seconds": 164.19,
      "duration_seconds": 2.12,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.08,
      "end_seconds": 167.83,
      "duration_seconds": 2.75,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.28,
      "end_seconds": 172.89,
      "duration_seconds": 3.61,
      "text": "Have you noticed night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.82,
      "end_seconds": 179.0,
      "duration_seconds": 4.18,
      "text": "No, no night sweats or coughing up blood."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.04,
      "end_seconds": 188.48,
      "duration_seconds": 7.44,
      "text": "Let me check a few things. Any shortness of breath, weight loss or leg swelling?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.61,
      "end_seconds": 195.68,
      "duration_seconds": 3.07,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.29,
      "end_seconds": 199.96,
      "duration_seconds": 3.67,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.21,
      "end_seconds": 202.15,
      "duration_seconds": 0.94,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.51,
      "end_seconds": 218.24,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.85,
      "end_seconds": 227.21,
      "duration_seconds": 2.36,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.06,
      "end_seconds": 257.81,
      "duration_seconds": 11.75,
      "text": "Okay: BP is 107 over 78, temperature is 38.8 degrees. And pulse is 89 beats a minute, respiratory rate 20, saturation 95 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.66,
      "end_seconds": 262.76,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.32,
      "end_seconds": 266.53,
      "duration_seconds": 2.21,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.37,
      "end_seconds": 277.72,
      "duration_seconds": 2.35,
      "text": "No crackles at the bases"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.44,
      "end_seconds": 284.06,
      "duration_seconds": 1.62,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.78,
      "end_seconds": 304.5,
      "duration_seconds": 10.72,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be a a chest infection, probably viral, or it might be pneumonia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.49,
      "end_seconds": 307.01,
      "duration_seconds": 1.52,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.62,
      "end_seconds": 324.4,
      "duration_seconds": 16.78,
      "text": "it's reasonable to be concerned, but right now a chest infection, probably viral is my leading thought, not anything worse i'm sending you for a chest X-ray cos of cough we should do blood tests for cough"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.43,
      "end_seconds": 327.78,
      "duration_seconds": 2.35,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.07,
      "end_seconds": 364.42,
      "duration_seconds": 35.35,
      "text": "I'm prescribing azithromycin, 500 milligrams, once a day, for three days. You take it by mouth. That's for chest infection. I'll start you on salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. That should help with wheeze. Steam and warm fluids can ease the cough, and try to sleep with your head propped up. Please come and see me in ten days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 366.27,
      "end_seconds": 370.87,
      "duration_seconds": 4.6,
      "text": "right, uh, I'll do that thank you, doctor"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.17,
      "end_seconds": 373.38,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}