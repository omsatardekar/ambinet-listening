{
  "schema_version": "1.0",
  "encounter_id": "01057",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 7.01,
      "duration_seconds": 5.86,
      "text": "Hi there, the chair's free, sit down. Did you find the place alright?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.48,
      "end_seconds": 14.7,
      "duration_seconds": 6.22,
      "text": "Um, yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.37,
      "end_seconds": 18.71,
      "duration_seconds": 3.34,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.09,
      "end_seconds": 26.93,
      "duration_seconds": 6.84,
      "text": "well, I've been having drenching night sweats i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.44,
      "end_seconds": 28.83,
      "duration_seconds": 1.39,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.05,
      "end_seconds": 32.72,
      "duration_seconds": 2.67,
      "text": "for two weeks, I'd say"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.87,
      "end_seconds": 36.55,
      "duration_seconds": 2.68,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.8,
      "end_seconds": 45.21,
      "duration_seconds": 4.41,
      "text": "it settles a little with changing my clothes"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.82,
      "end_seconds": 48.83,
      "duration_seconds": 3.01,
      "text": "So, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.44,
      "end_seconds": 58.47,
      "duration_seconds": 9.03,
      "text": "sorry, what was I saying, when it starts I tend to get itching all over as well"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.44,
      "end_seconds": 64.73,
      "duration_seconds": 4.29,
      "text": "Has there been a low fever in the evenings too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.42,
      "end_seconds": 72.03,
      "duration_seconds": 6.61,
      "text": "yeah, uh, that too the itching all over? That's been for two weeks"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 85.35,
      "end_seconds": 96.37,
      "duration_seconds": 11.02,
      "text": "Here are the numbers, doctor. Pulse is 89 beats a minute, weight 87 kilos. Height 174 centimetres, pressure 116 over 80, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.63,
      "end_seconds": 98.33,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.16,
      "end_seconds": 103.1,
      "duration_seconds": 2.94,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.19,
      "end_seconds": 105.51,
      "duration_seconds": 1.32,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.05,
      "end_seconds": 123.26,
      "duration_seconds": 6.21,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.99,
      "end_seconds": 126.24,
      "duration_seconds": 1.25,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 141.54,
      "duration_seconds": 2.08,
      "text": "I can't feel your spleen"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.86,
      "end_seconds": 154.2,
      "duration_seconds": 7.34,
      "text": "That's the examination finished. A few quick ones: diarrhoea, joint pain, recent travel or weight loss?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.44,
      "end_seconds": 160.72,
      "duration_seconds": 5.28,
      "text": "No, no diarrhoea, joint pain, recent travel or weight loss."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.76,
      "end_seconds": 165.64,
      "duration_seconds": 2.88,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.36,
      "end_seconds": 168.71,
      "duration_seconds": 2.35,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.61,
      "end_seconds": 172.23,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.25,
      "end_seconds": 176.47,
      "duration_seconds": 2.22,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.87,
      "end_seconds": 180.69,
      "duration_seconds": 2.82,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.28,
      "end_seconds": 195.18,
      "duration_seconds": 12.9,
      "text": "I drink a lot of tea and snack through the day. I swim twice a week. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.41,
      "end_seconds": 200.86,
      "duration_seconds": 4.45,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.44,
      "end_seconds": 204.83,
      "duration_seconds": 3.39,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.25,
      "end_seconds": 215.62,
      "duration_seconds": 2.37,
      "text": "what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.14,
      "end_seconds": 219.82,
      "duration_seconds": 3.68,
      "text": "Metoprolol. I take it twice a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.77,
      "end_seconds": 222.83,
      "duration_seconds": 2.06,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.4,
      "end_seconds": 225.93,
      "duration_seconds": 1.53,
      "text": "it's 50 milligrams"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.03,
      "end_seconds": 230.55,
      "duration_seconds": 3.52,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.35,
      "end_seconds": 235.48,
      "duration_seconds": 3.13,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.21,
      "end_seconds": 246.82,
      "duration_seconds": 9.61,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.45,
      "end_seconds": 249.28,
      "duration_seconds": 1.83,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.99,
      "end_seconds": 278.26,
      "duration_seconds": 14.27,
      "text": "having listened and examined, this looks most like an enlarged gland with night sweats that needs a proper work-up. That's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.85,
      "end_seconds": 282.65,
      "duration_seconds": 2.8,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.33,
      "end_seconds": 308.13,
      "duration_seconds": 23.8,
      "text": "Nothing I've seen today points to an emergency. It looks like an enlarged gland with night sweats that needs a proper work-up, but I'd like to confirm. I think a chest X-ray makes sense here, for night sweats. Keep a note of your temperature each evening. We'll refer you to the haematology clinic."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.75,
      "end_seconds": 309.45,
      "duration_seconds": 0.7,
      "text": "okay"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.32,
      "end_seconds": 313.62,
      "duration_seconds": 3.3,
      "text": "anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.51,
      "end_seconds": 316.59,
      "duration_seconds": 2.08,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.47,
      "end_seconds": 318.93,
      "duration_seconds": 1.46,
      "text": "see you soon"
    }
  ]
}