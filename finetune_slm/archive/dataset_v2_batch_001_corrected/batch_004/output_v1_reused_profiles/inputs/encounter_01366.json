{
  "schema_version": "1.0",
  "encounter_id": "01366",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.39,
      "end_seconds": 3.48,
      "duration_seconds": 2.09,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.23,
      "end_seconds": 5.37,
      "duration_seconds": 1.14,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.35,
      "end_seconds": 8.45,
      "duration_seconds": 2.1,
      "text": "Alright, cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.23,
      "end_seconds": 14.07,
      "duration_seconds": 3.84,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.48,
      "end_seconds": 18.49,
      "duration_seconds": 3.01,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.5,
      "end_seconds": 28.29,
      "duration_seconds": 7.79,
      "text": "Let me think, doctor, it's headaches for a while. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.19,
      "end_seconds": 31.98,
      "duration_seconds": 1.79,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.71,
      "end_seconds": 37.0,
      "duration_seconds": 3.29,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 38.28,
      "end_seconds": 47.56,
      "duration_seconds": 9.28,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.2,
      "end_seconds": 60.52,
      "duration_seconds": 11.32,
      "text": "I notice it more with coughing and bending down. I'd call it moderate. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.88,
      "end_seconds": 80.02,
      "duration_seconds": 3.14,
      "text": "A few quick ones: seizures or confusion?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.22,
      "end_seconds": 83.62,
      "duration_seconds": 2.4,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.25,
      "end_seconds": 90.9,
      "duration_seconds": 3.65,
      "text": "Okay, have you had any fever or weakness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.42,
      "end_seconds": 98.15,
      "duration_seconds": 2.73,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.18,
      "end_seconds": 102.21,
      "duration_seconds": 3.03,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.24,
      "end_seconds": 106.84,
      "duration_seconds": 2.6,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.25,
      "end_seconds": 113.18,
      "duration_seconds": 4.93,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.75,
      "end_seconds": 116.41,
      "duration_seconds": 1.66,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.59,
      "end_seconds": 134.15,
      "duration_seconds": 2.56,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.26,
      "end_seconds": 150.14,
      "duration_seconds": 14.88,
      "text": "No, I've never smoked in my life. I used to drink heavily but I stopped four years ago. I swim twice a week. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.54,
      "end_seconds": 156.0,
      "duration_seconds": 4.46,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.02,
      "end_seconds": 162.8,
      "duration_seconds": 4.78,
      "text": "I, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.65,
      "end_seconds": 167.24,
      "duration_seconds": 2.59,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.75,
      "end_seconds": 169.9,
      "duration_seconds": 2.15,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.09,
      "end_seconds": 180.86,
      "duration_seconds": 2.77,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.82,
      "end_seconds": 195.94,
      "duration_seconds": 2.12,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.17,
      "end_seconds": 219.58,
      "duration_seconds": 7.41,
      "text": "Okay: heart rate 80, pressure 122 over 72, temp 36.7 degrees, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.65,
      "end_seconds": 224.74,
      "duration_seconds": 4.09,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.63,
      "end_seconds": 227.58,
      "duration_seconds": 0.95,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.45,
      "end_seconds": 231.06,
      "duration_seconds": 1.61,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.6,
      "end_seconds": 246.08,
      "duration_seconds": 3.48,
      "text": "Power and reflexes are equal on both sides."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.33,
      "end_seconds": 255.38,
      "duration_seconds": 7.05,
      "text": "Please sit back down. Okay, thinking it through, it points towards a headache disorder of uncertain type."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.98,
      "end_seconds": 259.67,
      "duration_seconds": 2.69,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.2,
      "end_seconds": 283.13,
      "duration_seconds": 21.93,
      "text": "I understand the worry. At the moment I'd say it's a headache disorder of uncertain type, and we'll know more once the an eye pressure check is back. Let me repeat that back to make sure. You've had headaches for a while for four weeks, moderate, and no seizures or weakness."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.77,
      "end_seconds": 286.27,
      "duration_seconds": 1.5,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.47,
      "end_seconds": 301.42,
      "duration_seconds": 4.95,
      "text": "Let's get an eye pressure check, for headache with blurred vision."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 302.29,
      "end_seconds": 304.74,
      "duration_seconds": 2.45,
      "text": "The earliest is Tuesday, 2 pm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.25,
      "end_seconds": 312.36,
      "duration_seconds": 6.11,
      "text": "I'm going to order an MRI of the brain, for headaches with visual symptoms."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.58,
      "end_seconds": 316.65,
      "duration_seconds": 3.07,
      "text": "I mean, okay, I'll do it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.56,
      "end_seconds": 342.66,
      "duration_seconds": 24.1,
      "text": "Note down each headache with the date, time and what you were doing. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. We'll refer you to a neurologist. Please don't wait if you get sudden worst-ever headache or weakness. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.65,
      "end_seconds": 348.41,
      "duration_seconds": 3.76,
      "text": "Mm, um, thank you, that's clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.27,
      "end_seconds": 357.53,
      "duration_seconds": 8.26,
      "text": "We'll catch up after the scan. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 359.15,
      "end_seconds": 364.81,
      "duration_seconds": 5.66,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.5,
      "end_seconds": 371.64,
      "duration_seconds": 6.14,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.62,
      "end_seconds": 375.55,
      "duration_seconds": 2.93,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.98,
      "end_seconds": 378.82,
      "duration_seconds": 1.84,
      "text": "Have a good day."
    }
  ]
}