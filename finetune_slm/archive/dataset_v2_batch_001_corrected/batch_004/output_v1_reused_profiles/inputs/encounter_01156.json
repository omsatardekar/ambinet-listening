{
  "schema_version": "1.0",
  "encounter_id": "01156",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.68,
      "duration_seconds": 3.71,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.01,
      "end_seconds": 9.86,
      "duration_seconds": 3.85,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.75,
      "end_seconds": 24.81,
      "duration_seconds": 10.06,
      "text": "Hello, doctor. I'm here with them in case I can help. We came because of yellow phlegm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.89,
      "end_seconds": 29.25,
      "duration_seconds": 3.36,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.14,
      "end_seconds": 34.23,
      "duration_seconds": 3.09,
      "text": "Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.44,
      "end_seconds": 38.46,
      "duration_seconds": 3.02,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.29,
      "end_seconds": 46.61,
      "duration_seconds": 5.32,
      "text": "Six months now. It's telmisartan, 40 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.6,
      "end_seconds": 50.54,
      "duration_seconds": 2.94,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.45,
      "end_seconds": 55.44,
      "duration_seconds": 3.99,
      "text": "About about a month, give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 57.53,
      "end_seconds": 63.14,
      "duration_seconds": 5.61,
      "text": "Hm, you know, I'd say more like about two months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.33,
      "end_seconds": 68.72,
      "duration_seconds": 4.39,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.01,
      "end_seconds": 72.3,
      "duration_seconds": 2.29,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.38,
      "end_seconds": 78.44,
      "duration_seconds": 2.06,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.42,
      "end_seconds": 101.4,
      "duration_seconds": 20.98,
      "text": "Let me think, when it starts I tend to get a chesty cough as well. About chesty cough, it's every other day. Yes, cold air and mornings. That makes it worse. Oh, and a sore chest from coughing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.55,
      "end_seconds": 123.54,
      "duration_seconds": 4.99,
      "text": "And what about ankle swelling, night sweats or coughing up blood?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.59,
      "end_seconds": 129.32,
      "duration_seconds": 3.73,
      "text": "Okay, so no, I'd have said so."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.27,
      "end_seconds": 132.35,
      "duration_seconds": 2.08,
      "text": "Nothing like sharp chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.15,
      "end_seconds": 137.97,
      "duration_seconds": 3.82,
      "text": "No, none, no sharp chest pain."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.7,
      "end_seconds": 141.85,
      "duration_seconds": 3.15,
      "text": "Alright, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.14,
      "end_seconds": 145.87,
      "duration_seconds": 2.73,
      "text": "Nothing there, uh, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.7,
      "end_seconds": 150.97,
      "duration_seconds": 4.27,
      "text": "So, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.01,
      "end_seconds": 159.31,
      "duration_seconds": 6.3,
      "text": "Sorry, what was I saying, my mother had a stroke."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.77,
      "end_seconds": 170.17,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.11,
      "end_seconds": 174.02,
      "duration_seconds": 1.91,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.04,
      "end_seconds": 180.7,
      "duration_seconds": 4.66,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.19,
      "end_seconds": 190.51,
      "duration_seconds": 8.32,
      "text": "I was told I'm allergic to erythromycin, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.73,
      "end_seconds": 199.73,
      "duration_seconds": 4.0,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.45,
      "end_seconds": 213.49,
      "duration_seconds": 12.04,
      "text": "I grab fast food at lunch most days. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.52,
      "end_seconds": 218.6,
      "duration_seconds": 4.08,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.32,
      "end_seconds": 226.72,
      "duration_seconds": 7.4,
      "text": "I have COPD, for two years. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.72,
      "end_seconds": 230.41,
      "duration_seconds": 1.69,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.26,
      "end_seconds": 236.21,
      "duration_seconds": 3.95,
      "text": "High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.33,
      "end_seconds": 249.98,
      "duration_seconds": 4.65,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.23,
      "end_seconds": 260.68,
      "duration_seconds": 3.45,
      "text": "Alright, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.17,
      "end_seconds": 284.17,
      "duration_seconds": 9.0,
      "text": "Okay: oxygen saturation is 91 percent, heart rate 97. And respiratory rate 24, pressure 124 over 75, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.06,
      "end_seconds": 287.27,
      "duration_seconds": 2.21,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.23,
      "end_seconds": 291.39,
      "duration_seconds": 3.16,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.58,
      "end_seconds": 297.11,
      "duration_seconds": 4.53,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.07,
      "end_seconds": 301.19,
      "duration_seconds": 3.12,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.76,
      "end_seconds": 314.35,
      "duration_seconds": 4.59,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.98,
      "end_seconds": 336.67,
      "duration_seconds": 19.69,
      "text": "Okay, that's enough for me. Okay, thinking it through, it points towards an infective exacerbation of chronic lung disease. I'd also keep a pneumonia in mind. Let me repeat that back to make sure. You've had yellow phlegm, and no night sweats or sharp chest pain."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.03,
      "end_seconds": 339.61,
      "duration_seconds": 1.58,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.75,
      "end_seconds": 345.06,
      "duration_seconds": 4.31,
      "text": "I want a sputum sample done, that's for purulent sputum."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.0,
      "end_seconds": 349.73,
      "duration_seconds": 2.73,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.32,
      "end_seconds": 367.51,
      "duration_seconds": 13.19,
      "text": "I'll request a chest X-ray, it'll help with productive cough. The treatment will be doxycycline, 100 milligrams, twice a day, for five days. You take it by mouth. That's for chest infection."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.57,
      "end_seconds": 371.4,
      "duration_seconds": 1.83,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.02,
      "end_seconds": 387.82,
      "duration_seconds": 14.8,
      "text": "Keep using your inhaler as before and drink plenty of fluids. Keep an eye out, and if you become more breathless or your lips turn blue, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.34,
      "end_seconds": 391.74,
      "duration_seconds": 3.4,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.05,
      "end_seconds": 397.98,
      "duration_seconds": 4.93,
      "text": "See me again in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.91,
      "end_seconds": 404.43,
      "duration_seconds": 4.52,
      "text": "Right, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.97,
      "end_seconds": 406.79,
      "duration_seconds": 1.82,
      "text": "Have a good day."
    }
  ]
}