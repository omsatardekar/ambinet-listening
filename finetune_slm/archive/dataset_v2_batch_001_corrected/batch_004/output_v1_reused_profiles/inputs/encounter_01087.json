{
  "schema_version": "1.0",
  "encounter_id": "01087",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 5.48,
      "duration_seconds": 4.27,
      "text": "I mean, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.27,
      "end_seconds": 10.54,
      "duration_seconds": 4.27,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.84,
      "end_seconds": 18.28,
      "duration_seconds": 6.44,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.32,
      "end_seconds": 26.89,
      "duration_seconds": 7.57,
      "text": "Mainly drenching night sweats. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.52,
      "end_seconds": 30.06,
      "duration_seconds": 2.54,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 31.18,
      "end_seconds": 46.15,
      "duration_seconds": 14.97,
      "text": "Right, he is on telmisartan, 40 milligrams, once a day, I give it to him. It's Dolo, 650 milligrams, when I get the fever, doctor."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.01,
      "end_seconds": 68.53,
      "duration_seconds": 3.52,
      "text": "So, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.21,
      "end_seconds": 72.32,
      "duration_seconds": 3.11,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.99,
      "end_seconds": 78.59,
      "duration_seconds": 4.6,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.49,
      "end_seconds": 112.27,
      "duration_seconds": 32.78,
      "text": "I, I'd say a few times a day. It's mild, honestly. I get some relief from changing my clothes. A neighbour of mine said I should see someone about it. Let me think, uh, I've also been feeling run down, for about four days. I've also had itching all over, since last Tuesday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.21,
      "end_seconds": 119.3,
      "duration_seconds": 6.09,
      "text": "Have you had drenching night sweats before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.67,
      "end_seconds": 126.47,
      "duration_seconds": 5.8,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.31,
      "end_seconds": 131.65,
      "duration_seconds": 4.34,
      "text": "Right, and what about recent travel or weight loss?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.22,
      "end_seconds": 136.42,
      "duration_seconds": 3.2,
      "text": "Actually, no, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.1,
      "end_seconds": 141.45,
      "duration_seconds": 3.35,
      "text": "Any joint pain, diarrhoea or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.14,
      "end_seconds": 149.4,
      "duration_seconds": 6.26,
      "text": "I haven't had joint pain, diarrhoea or chest pain, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.66,
      "end_seconds": 153.04,
      "duration_seconds": 3.38,
      "text": "Yes, carry on. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.0,
      "end_seconds": 156.05,
      "duration_seconds": 1.05,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.44,
      "end_seconds": 160.64,
      "duration_seconds": 3.2,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.45,
      "end_seconds": 165.22,
      "duration_seconds": 1.77,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.02,
      "end_seconds": 185.46,
      "duration_seconds": 2.44,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.48,
      "end_seconds": 193.06,
      "duration_seconds": 5.58,
      "text": "Yeah, just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.11,
      "end_seconds": 196.54,
      "duration_seconds": 2.43,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.77,
      "end_seconds": 205.26,
      "duration_seconds": 7.49,
      "text": "I mean, I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.83,
      "end_seconds": 218.88,
      "duration_seconds": 8.05,
      "text": "Okay, I can see high blood pressure in your file as well. Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.91,
      "end_seconds": 224.27,
      "duration_seconds": 4.36,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.87,
      "end_seconds": 230.66,
      "duration_seconds": 4.79,
      "text": "Right, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.64,
      "end_seconds": 236.56,
      "duration_seconds": 3.92,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.48,
      "end_seconds": 241.45,
      "duration_seconds": 2.97,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.01,
      "end_seconds": 248.02,
      "duration_seconds": 6.01,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.05,
      "end_seconds": 254.14,
      "duration_seconds": 4.09,
      "text": "Alright, time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.37,
      "end_seconds": 264.0,
      "duration_seconds": 2.63,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.74,
      "end_seconds": 296.65,
      "duration_seconds": 15.91,
      "text": "Okay: height 161 centimetres, heart rate 94, oxygen saturation is 97 percent. And BMI works out to 21.6, blood pressure 121 over 79, weight 56 kilos, temp 39.1 degrees, respiratory rate 16."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.28,
      "end_seconds": 301.84,
      "duration_seconds": 3.56,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.2,
      "end_seconds": 305.54,
      "duration_seconds": 2.34,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.7,
      "end_seconds": 321.88,
      "duration_seconds": 2.18,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.07,
      "end_seconds": 327.87,
      "duration_seconds": 1.8,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.65,
      "end_seconds": 361.47,
      "duration_seconds": 20.82,
      "text": "From what you've told me and what I found, it fits best with an enlarged gland with night sweats that needs a proper work-up. That's my thinking for now, and it may change as we learn more. Let's get a chest X-ray, for night sweats."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.52,
      "end_seconds": 366.89,
      "duration_seconds": 3.37,
      "text": "Erm, when would that take place?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.18,
      "end_seconds": 378.75,
      "duration_seconds": 10.57,
      "text": "Let's book blood tests to look into night sweats. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.74,
      "end_seconds": 382.24,
      "duration_seconds": 2.5,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.85,
      "end_seconds": 386.59,
      "duration_seconds": 3.74,
      "text": "Keep a note of your temperature each evening."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.92,
      "end_seconds": 392.01,
      "duration_seconds": 5.09,
      "text": "Yes, carry on. I'll also refer you to the haematology clinic."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.79,
      "end_seconds": 394.56,
      "duration_seconds": 1.77,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.77,
      "end_seconds": 403.1,
      "duration_seconds": 4.33,
      "text": "Let's plan a check after the results are back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 404.37,
      "end_seconds": 406.54,
      "duration_seconds": 2.17,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.93,
      "end_seconds": 412.82,
      "duration_seconds": 4.89,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 414.45,
      "end_seconds": 416.94,
      "duration_seconds": 2.49,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}