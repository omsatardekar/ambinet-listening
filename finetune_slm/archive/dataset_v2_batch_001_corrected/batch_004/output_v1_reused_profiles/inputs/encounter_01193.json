{
  "schema_version": "1.0",
  "encounter_id": "01193",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.38,
      "end_seconds": 4.51,
      "duration_seconds": 3.13,
      "text": "sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.41,
      "end_seconds": 10.82,
      "duration_seconds": 4.41,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.61,
      "end_seconds": 15.16,
      "duration_seconds": 2.55,
      "text": "It's occasional chest tightness, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.59,
      "end_seconds": 19.33,
      "duration_seconds": 2.74,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.71,
      "end_seconds": 24.49,
      "duration_seconds": 3.78,
      "text": "It's been about a year, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.31,
      "end_seconds": 27.43,
      "duration_seconds": 2.12,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.3,
      "end_seconds": 33.02,
      "duration_seconds": 3.72,
      "text": "I notice it more with walking uphill"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.82,
      "end_seconds": 40.17,
      "duration_seconds": 5.35,
      "text": "Alright, is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.93,
      "end_seconds": 44.54,
      "duration_seconds": 2.61,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.67,
      "end_seconds": 48.0,
      "duration_seconds": 2.33,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.66,
      "end_seconds": 62.86,
      "duration_seconds": 13.2,
      "text": "A bit of dizziness with the new tablets goes along with it, most of the time. The bit of dizziness with the new tablets? That's been for six months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.68,
      "end_seconds": 67.53,
      "duration_seconds": 2.85,
      "text": "Alright, how much does it limit you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.55,
      "end_seconds": 70.99,
      "duration_seconds": 1.44,
      "text": "I'd say mild"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.56,
      "end_seconds": 89.78,
      "duration_seconds": 6.22,
      "text": "Have you had any coughing up blood, black stools, fainting or pain at rest?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.34,
      "end_seconds": 102.45,
      "duration_seconds": 7.11,
      "text": "I haven't had coughing up blood, black stools, fainting or pain at rest, no"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.65,
      "end_seconds": 106.35,
      "duration_seconds": 2.7,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.24,
      "end_seconds": 110.67,
      "duration_seconds": 2.43,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.47,
      "end_seconds": 114.91,
      "duration_seconds": 2.44,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.82,
      "end_seconds": 120.9,
      "duration_seconds": 4.08,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.58,
      "end_seconds": 127.96,
      "duration_seconds": 5.38,
      "text": "So, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.14,
      "end_seconds": 149.87,
      "duration_seconds": 20.73,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. My husband and I live above the shop. I drink a lot of tea and snack through the day. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.4,
      "end_seconds": 163.3,
      "duration_seconds": 2.9,
      "text": "right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.04,
      "end_seconds": 167.51,
      "duration_seconds": 3.47,
      "text": "It's Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.06,
      "end_seconds": 171.34,
      "duration_seconds": 3.28,
      "text": "how long have you been on it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.29,
      "end_seconds": 175.4,
      "duration_seconds": 2.11,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.99,
      "end_seconds": 180.29,
      "duration_seconds": 3.3,
      "text": "So, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.64,
      "end_seconds": 183.82,
      "duration_seconds": 2.18,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.64,
      "end_seconds": 205.85,
      "duration_seconds": 3.21,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.63,
      "end_seconds": 209.06,
      "duration_seconds": 2.43,
      "text": "my father had bowel cancer"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 213.37,
      "duration_seconds": 2.48,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.23,
      "end_seconds": 225.96,
      "duration_seconds": 11.73,
      "text": "I've had heart disease for five years now. I've had diabetes, yes. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.53,
      "end_seconds": 230.45,
      "duration_seconds": 2.92,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.93,
      "end_seconds": 240.38,
      "duration_seconds": 2.45,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.64,
      "end_seconds": 267.59,
      "duration_seconds": 12.95,
      "text": "Okay: pulse 68, respiratory rate 14, pressure 119 over 78. And SpO2 97 percent on room air. Putting together what you've described, it fits best with stable recovery after the heart event."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.85,
      "end_seconds": 272.74,
      "duration_seconds": 3.89,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.65,
      "end_seconds": 306.97,
      "duration_seconds": 32.32,
      "text": "I can't promise yet, but most people with stable recovery after the heart event do well once it's treated properly. Let's book an echocardiogram to look into follow-up. Let's book an ECG to to look into follow-up. The treatment will be atorvastatin, 40 milligrams, at night, long term. It's for cardiovascular risk. Cardiac rehab is worth doing, it really helps your confidence. Please don't stop the blood thinner on your own, even if you feel fine"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.14,
      "end_seconds": 314.92,
      "duration_seconds": 4.78,
      "text": "Cardiac rehabilitation would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.44,
      "end_seconds": 321.4,
      "duration_seconds": 5.96,
      "text": "Alright, thank you. Should I have a lipid profile as well?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.63,
      "end_seconds": 343.5,
      "duration_seconds": 17.87,
      "text": "not at this point, no it isn't indicated yet if the symptoms get worse, or you feel really unwell, please come to the emergency department please come and see me in six weeks does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.06,
      "end_seconds": 348.26,
      "duration_seconds": 3.2,
      "text": "no, that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.75,
      "end_seconds": 351.52,
      "duration_seconds": 1.77,
      "text": "Right, all the best."
    }
  ]
}