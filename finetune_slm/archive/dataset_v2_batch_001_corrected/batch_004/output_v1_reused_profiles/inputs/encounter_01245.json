{
  "schema_version": "1.0",
  "encounter_id": "01245",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 5.55,
      "duration_seconds": 4.91,
      "text": "Hi, um, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.33,
      "end_seconds": 12.0,
      "duration_seconds": 4.67,
      "text": "yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.68,
      "end_seconds": 24.01,
      "duration_seconds": 7.33,
      "text": "Mainly tingling in my fingers. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.49,
      "end_seconds": 27.23,
      "duration_seconds": 1.74,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.76,
      "end_seconds": 30.92,
      "duration_seconds": 2.16,
      "text": "About... well, two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.38,
      "end_seconds": 36.88,
      "duration_seconds": 5.5,
      "text": "mm, okay okay, give me more detail on it, whatever comes to mind"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.79,
      "end_seconds": 47.65,
      "duration_seconds": 8.86,
      "text": "I'd say once or twice a day. Holding the phone and typing definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.75,
      "end_seconds": 57.02,
      "duration_seconds": 6.27,
      "text": "What about numbness in the thumb and first two fingers, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.58,
      "end_seconds": 60.56,
      "duration_seconds": 2.98,
      "text": "Yes, about the same, five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.54,
      "end_seconds": 65.15,
      "duration_seconds": 2.61,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.03,
      "end_seconds": 70.08,
      "duration_seconds": 4.05,
      "text": "I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.13,
      "end_seconds": 80.99,
      "duration_seconds": 2.86,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.08,
      "end_seconds": 84.85,
      "duration_seconds": 1.77,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.87,
      "end_seconds": 88.34,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.32,
      "end_seconds": 93.22,
      "duration_seconds": 3.9,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.63,
      "end_seconds": 96.91,
      "duration_seconds": 2.28,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.93,
      "end_seconds": 103.98,
      "duration_seconds": 6.05,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.16,
      "end_seconds": 108.2,
      "duration_seconds": 3.04,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 113.09,
      "duration_seconds": 3.92,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.28,
      "end_seconds": 117.53,
      "duration_seconds": 3.25,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.16,
      "end_seconds": 122.31,
      "duration_seconds": 3.15,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.33,
      "end_seconds": 143.4,
      "duration_seconds": 8.07,
      "text": "so, any allergies to tablets, food or anything in the environment? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.43,
      "end_seconds": 148.46,
      "duration_seconds": 3.03,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.33,
      "end_seconds": 155.4,
      "duration_seconds": 5.07,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.38,
      "end_seconds": 161.1,
      "duration_seconds": 4.72,
      "text": "I'm, I'm on Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.47,
      "end_seconds": 162.57,
      "duration_seconds": 1.1,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.35,
      "end_seconds": 170.64,
      "duration_seconds": 6.29,
      "text": "Mm, I take thyroxine, 75 micrograms, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.98,
      "end_seconds": 174.02,
      "duration_seconds": 2.04,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.28,
      "end_seconds": 183.87,
      "duration_seconds": 8.59,
      "text": "Diabetes, for nearly five years. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.75,
      "end_seconds": 185.79,
      "duration_seconds": 1.04,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.21,
      "end_seconds": 189.54,
      "duration_seconds": 2.33,
      "text": "yes, an underactive thyroid"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.16,
      "end_seconds": 200.66,
      "duration_seconds": 8.5,
      "text": "Okay, go on. Okay, I can see diabetes in your file as well. So, any bladder problems or headache?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.69,
      "end_seconds": 207.12,
      "duration_seconds": 4.43,
      "text": "I haven't had bladder problems or headache, no."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.35,
      "end_seconds": 211.79,
      "duration_seconds": 4.44,
      "text": "Hm, okay. A few quick ones: neck pain or trouble walking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.34,
      "end_seconds": 215.25,
      "duration_seconds": 2.91,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.2,
      "end_seconds": 219.21,
      "duration_seconds": 3.01,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.54,
      "end_seconds": 222.08,
      "duration_seconds": 1.54,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.73,
      "end_seconds": 227.67,
      "duration_seconds": 3.94,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.79,
      "end_seconds": 233.17,
      "duration_seconds": 1.38,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 233.99,
      "end_seconds": 243.36,
      "duration_seconds": 9.37,
      "text": "okay, so the vitals from earlier. BP is 108 over 78, heart rate 79, saturation 97 percent, temp 36.5 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.09,
      "end_seconds": 245.52,
      "duration_seconds": 1.43,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.67,
      "end_seconds": 249.51,
      "duration_seconds": 2.84,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.23,
      "end_seconds": 252.84,
      "duration_seconds": 1.61,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.83,
      "end_seconds": 257.53,
      "duration_seconds": 2.7,
      "text": "So, raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.6,
      "end_seconds": 275.53,
      "duration_seconds": 3.93,
      "text": "Bending the wrist for a minute brings on the numbness."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.17,
      "end_seconds": 279.02,
      "duration_seconds": 1.85,
      "text": "Okay, breathe out slowly."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.35,
      "end_seconds": 294.64,
      "duration_seconds": 3.29,
      "text": "Tapping over the wrist reproduces the tingling"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.92,
      "end_seconds": 308.77,
      "duration_seconds": 10.85,
      "text": "Alright, good, you can sit up again. Taking everything into account, I think we're dealing with carpal tunnel syndrome at this stage. Diabetic neuropathy is still possible."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.25,
      "end_seconds": 325.4,
      "duration_seconds": 5.15,
      "text": "I'd like to arrange a nerve conduction study for hand numbness"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.09,
      "end_seconds": 329.27,
      "duration_seconds": 2.18,
      "text": "is that done today?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.35,
      "end_seconds": 360.47,
      "duration_seconds": 29.12,
      "text": "I think a blood sugar test makes sense here, for neuropathy screen the result will help us decide whether anything more is needed a night wrist splint, kept neutral, usually helps a lot take short breaks from typing and keep the wrist straight let's get you seen by physiotherapy, I'll arrange the letter i'd like you back in four weeks right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.04,
      "end_seconds": 362.71,
      "duration_seconds": 1.67,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.34,
      "end_seconds": 365.69,
      "duration_seconds": 1.35,
      "text": "take care now"
    }
  ]
}