{
  "schema_version": "1.0",
  "encounter_id": "01217",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.34,
      "end_seconds": 5.27,
      "duration_seconds": 3.93,
      "text": "welcome. Make yourself comfortable. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.77,
      "end_seconds": 9.92,
      "duration_seconds": 3.15,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.62,
      "end_seconds": 14.51,
      "duration_seconds": 2.89,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.75,
      "end_seconds": 23.77,
      "duration_seconds": 8.02,
      "text": "I mean, I'm here because of pins and needles in my hands and feet."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.97,
      "end_seconds": 27.04,
      "duration_seconds": 2.07,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.96,
      "end_seconds": 32.88,
      "duration_seconds": 3.92,
      "text": "Metformin i take it twice a day"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.49,
      "end_seconds": 35.57,
      "duration_seconds": 2.08,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.6,
      "end_seconds": 38.57,
      "duration_seconds": 0.97,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.84,
      "end_seconds": 41.6,
      "duration_seconds": 1.76,
      "text": "Okay, is that long-standing?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.6,
      "end_seconds": 45.04,
      "duration_seconds": 1.44,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.15,
      "end_seconds": 47.72,
      "duration_seconds": 1.57,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.45,
      "end_seconds": 53.87,
      "duration_seconds": 4.42,
      "text": "hmm, for about a month, I'd say"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.47,
      "end_seconds": 58.61,
      "duration_seconds": 4.14,
      "text": "yes, carry on. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.42,
      "end_seconds": 62.81,
      "duration_seconds": 3.39,
      "text": "Hmm, it feels moderate to me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.95,
      "end_seconds": 66.59,
      "duration_seconds": 2.64,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.09,
      "end_seconds": 94.6,
      "duration_seconds": 26.51,
      "text": "Being unsteady on my feet goes along with it, most of the time. Right, as for Being unsteady on my feet, I honestly can't say when that began. It might have been last month or the month before. And, And I've been forgetting words as well, for three weeks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.42,
      "end_seconds": 101.39,
      "duration_seconds": 4.97,
      "text": "Have you had any diarrhoea, rash or loss of vision?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.23,
      "end_seconds": 108.04,
      "duration_seconds": 4.81,
      "text": "I haven't had diarrhoea, rash or loss of vision, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.18,
      "end_seconds": 114.6,
      "duration_seconds": 5.42,
      "text": "have you had any weight loss or weakness of one side?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.49,
      "end_seconds": 119.21,
      "duration_seconds": 2.72,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.61,
      "end_seconds": 122.68,
      "duration_seconds": 2.07,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.66,
      "end_seconds": 125.7,
      "duration_seconds": 2.04,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.21,
      "end_seconds": 129.18,
      "duration_seconds": 2.97,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.14,
      "end_seconds": 137.47,
      "duration_seconds": 6.33,
      "text": "Sorry, what was I saying, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.52,
      "end_seconds": 144.96,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.71,
      "end_seconds": 164.73,
      "duration_seconds": 18.02,
      "text": "I only drink at family occasions. No, I've never smoked in my life. Not much, I mostly stay in these days. I'm a plumber, lots of bending and kneeling. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.06,
      "end_seconds": 177.56,
      "duration_seconds": 4.5,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.23,
      "end_seconds": 186.81,
      "duration_seconds": 7.58,
      "text": "I've had diabetes, yes i thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.36,
      "end_seconds": 191.87,
      "duration_seconds": 4.51,
      "text": "Understood. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.65,
      "end_seconds": 195.26,
      "duration_seconds": 1.61,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.79,
      "end_seconds": 207.94,
      "duration_seconds": 4.15,
      "text": "Shall I check your blood pressure and and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.61,
      "end_seconds": 223.23,
      "duration_seconds": 2.62,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.76,
      "end_seconds": 250.77,
      "duration_seconds": 9.01,
      "text": "Okay: pulse 71, SpO2 98 percent on room air, BP is 117 over 76. And temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.45,
      "end_seconds": 254.89,
      "duration_seconds": 2.44,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.47,
      "end_seconds": 258.86,
      "duration_seconds": 2.39,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.79,
      "end_seconds": 277.63,
      "duration_seconds": 2.84,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.67,
      "end_seconds": 292.7,
      "duration_seconds": 10.03,
      "text": "thank you, you can get dressed. Taking everything into account, it it points towards symptoms that fit a vitamin B12 deficiency"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.22,
      "end_seconds": 298.31,
      "duration_seconds": 4.09,
      "text": "Well, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.1,
      "end_seconds": 312.72,
      "duration_seconds": 13.62,
      "text": "I understand the worry. At the moment I'd say it's symptoms that fit a vitamin B12 deficiency, and we'll know more once the a vitamin B12 level is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.57,
      "end_seconds": 353.53,
      "duration_seconds": 32.96,
      "text": "Let's book a vitamin B12 level to look into tingling and tiredness. A thyroid test is what I'd like next, for tiredness. I'd like you to take cyanocobalamin, 1000 micrograms, every other day, for two weeks. That should help with low vitamin B12. I'll put all of this in writing so you don't have to remember it. Eating more eggs, dairy and fortified cereals will help over time."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.95,
      "end_seconds": 368.06,
      "duration_seconds": 14.11,
      "text": "ah avoid taking any extra painkillers on top of what I'm prescribing without checking with us come back or go to emergency straight away if the symptoms get worse"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.85,
      "end_seconds": 372.57,
      "duration_seconds": 3.72,
      "text": "Mm, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.09,
      "end_seconds": 383.43,
      "duration_seconds": 9.34,
      "text": "let's plan a check after the results are back. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.29,
      "end_seconds": 395.1,
      "duration_seconds": 9.81,
      "text": "So, I take the cyanocobalamin, 1000 micrograms, every other day and come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 396.4,
      "end_seconds": 400.17,
      "duration_seconds": 3.77,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 400.69,
      "end_seconds": 402.36,
      "duration_seconds": 1.67,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.37,
      "end_seconds": 406.44,
      "duration_seconds": 2.07,
      "text": "so, goodbye for now"
    }
  ]
}