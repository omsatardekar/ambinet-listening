{
  "schema_version": "1.0",
  "encounter_id": "01373",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 5.07,
      "duration_seconds": 4.45,
      "text": "Hello, come in. Mind the step. What's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.38,
      "end_seconds": 15.77,
      "duration_seconds": 9.39,
      "text": "Well, I'm here because of thick green mucus. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.74,
      "end_seconds": 18.98,
      "duration_seconds": 1.24,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.58,
      "end_seconds": 27.35,
      "duration_seconds": 7.77,
      "text": "I've had it for two weeks. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.88,
      "end_seconds": 31.12,
      "duration_seconds": 3.24,
      "text": "Yes. Is there anything else with it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.7,
      "end_seconds": 38.7,
      "duration_seconds": 6.0,
      "text": "It usually comes with a headache. With headache, it's all the time."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.5,
      "end_seconds": 45.46,
      "duration_seconds": 4.96,
      "text": "Any toothache, double vision or swelling around the eyes at all?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.38,
      "end_seconds": 53.77,
      "duration_seconds": 6.39,
      "text": "No toothache, double vision or swelling around the eyes, none of it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.55,
      "end_seconds": 56.81,
      "duration_seconds": 2.26,
      "text": "Have you had any nosebleeds?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.75,
      "end_seconds": 62.22,
      "duration_seconds": 3.47,
      "text": "Not that I've noticed, no nosebleeds."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.62,
      "end_seconds": 66.52,
      "duration_seconds": 2.9,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.22,
      "end_seconds": 70.2,
      "duration_seconds": 1.98,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.97,
      "end_seconds": 76.03,
      "duration_seconds": 4.06,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.92,
      "end_seconds": 80.02,
      "duration_seconds": 2.1,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.11,
      "end_seconds": 82.8,
      "duration_seconds": 1.69,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.23,
      "end_seconds": 87.38,
      "duration_seconds": 3.15,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.08,
      "end_seconds": 102.04,
      "duration_seconds": 2.96,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.95,
      "end_seconds": 111.67,
      "duration_seconds": 7.72,
      "text": "I've had asthma for five years now. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.8,
      "end_seconds": 113.72,
      "duration_seconds": 0.92,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.8,
      "end_seconds": 120.39,
      "duration_seconds": 4.59,
      "text": "I have heart failure, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.44,
      "end_seconds": 130.75,
      "duration_seconds": 8.31,
      "text": "Yes. Alright, asthma, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.83,
      "end_seconds": 143.78,
      "duration_seconds": 10.95,
      "text": "My partner and our baby. Not much, I mostly stay in these days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.66,
      "end_seconds": 157.53,
      "duration_seconds": 3.87,
      "text": "Alright, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.37,
      "end_seconds": 163.29,
      "duration_seconds": 3.92,
      "text": "Hmm, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.29,
      "end_seconds": 183.55,
      "duration_seconds": 3.26,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.01,
      "end_seconds": 197.28,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.44,
      "end_seconds": 222.74,
      "duration_seconds": 8.3,
      "text": "Okay: pulse 97, oxygen saturation is 96 percent, blood pressure 104 over 67. And temperature 38.2, respiratory rate 21."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.65,
      "end_seconds": 226.12,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.01,
      "end_seconds": 229.83,
      "duration_seconds": 2.82,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.0,
      "end_seconds": 235.2,
      "duration_seconds": 4.2,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.74,
      "end_seconds": 237.29,
      "duration_seconds": 1.55,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 239.47,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.24,
      "end_seconds": 257.98,
      "duration_seconds": 5.74,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.46,
      "end_seconds": 291.57,
      "duration_seconds": 31.11,
      "text": "Okay, all finished, thank you. So, based on the history and the examination, my working impression is acute sinusitis. I'm prescribing fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. That's for sinus congestion. Steam inhalation and saline rinses can help clear the nose. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.21,
      "end_seconds": 297.73,
      "duration_seconds": 5.52,
      "text": "I'd like you back in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.3,
      "end_seconds": 300.8,
      "duration_seconds": 2.5,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.53,
      "end_seconds": 303.96,
      "duration_seconds": 1.43,
      "text": "See you soon."
    }
  ]
}