{
  "schema_version": "1.0",
  "encounter_id": "01091",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 3.84,
      "duration_seconds": 3.17,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.66,
      "end_seconds": 5.65,
      "duration_seconds": 0.99,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.33,
      "end_seconds": 8.66,
      "duration_seconds": 2.33,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.08,
      "end_seconds": 13.5,
      "duration_seconds": 3.42,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.28,
      "end_seconds": 15.7,
      "duration_seconds": 1.42,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.73,
      "end_seconds": 26.14,
      "duration_seconds": 8.41,
      "text": "I'm here because of blurry vision. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.67,
      "end_seconds": 31.18,
      "duration_seconds": 3.51,
      "text": "Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.98,
      "end_seconds": 40.3,
      "duration_seconds": 7.32,
      "text": "It's been two years now. And there's tired eyes as well, two years now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.87,
      "end_seconds": 52.68,
      "duration_seconds": 2.81,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.06,
      "end_seconds": 57.34,
      "duration_seconds": 3.28,
      "text": "Sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.77,
      "end_seconds": 59.28,
      "duration_seconds": 1.51,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 78.21,
      "duration_seconds": 3.48,
      "text": "Right, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.08,
      "end_seconds": 91.17,
      "duration_seconds": 12.09,
      "text": "I hardly move around during the day. I'm a bus driver, so I sit for long hours. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.51,
      "end_seconds": 96.27,
      "duration_seconds": 3.76,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.08,
      "end_seconds": 102.61,
      "duration_seconds": 4.53,
      "text": "Yes, walnuts, it gives me my lips swelling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.29,
      "end_seconds": 105.91,
      "duration_seconds": 2.62,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.01,
      "end_seconds": 120.04,
      "duration_seconds": 12.03,
      "text": "Yeah, I've had diabetes for two years now. I've been putting this off for weeks. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.06,
      "end_seconds": 127.41,
      "duration_seconds": 5.35,
      "text": "Sure. So, and what about double vision, redness or eye pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.09,
      "end_seconds": 133.37,
      "duration_seconds": 5.28,
      "text": "Yeah, no, no double vision, redness or eye pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 137.83,
      "duration_seconds": 2.95,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.56,
      "end_seconds": 140.94,
      "duration_seconds": 1.38,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.77,
      "end_seconds": 145.53,
      "duration_seconds": 3.76,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.55,
      "end_seconds": 150.46,
      "duration_seconds": 3.91,
      "text": "Nothing on the skin, um, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.57,
      "end_seconds": 163.81,
      "duration_seconds": 3.24,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.58,
      "end_seconds": 179.38,
      "duration_seconds": 2.8,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.19,
      "end_seconds": 199.91,
      "duration_seconds": 5.72,
      "text": "Okay: heart rate 78, saturation 99 percent, BP is 116 over 72."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.75,
      "end_seconds": 206.35,
      "duration_seconds": 4.6,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.6,
      "end_seconds": 209.07,
      "duration_seconds": 1.47,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.38,
      "end_seconds": 212.63,
      "duration_seconds": 2.25,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.08,
      "end_seconds": 233.86,
      "duration_seconds": 4.78,
      "text": "Vision without glasses is six over twelve in both eyes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.57,
      "end_seconds": 238.5,
      "duration_seconds": 2.93,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.41,
      "end_seconds": 252.83,
      "duration_seconds": 4.42,
      "text": "The lens looks a little cloudy on both sides."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.48,
      "end_seconds": 256.12,
      "duration_seconds": 2.64,
      "text": "Yes, you know, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.84,
      "end_seconds": 260.69,
      "duration_seconds": 1.85,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.59,
      "end_seconds": 291.01,
      "duration_seconds": 12.42,
      "text": "Having listened and examined, it's hard to say. A refractive problem or early cataracts is one possibility and glaucoma another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.38,
      "end_seconds": 294.89,
      "duration_seconds": 2.51,
      "text": "Right, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.92,
      "end_seconds": 311.86,
      "duration_seconds": 15.94,
      "text": "I understand the worry. At the moment I'd say it's a refractive problem or early cataracts, and we'll watch how it goes. Get a proper glasses test, and keep your sugar and blood pressure well controlled for your eyes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.31,
      "end_seconds": 315.6,
      "duration_seconds": 3.29,
      "text": "Sure. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.84,
      "end_seconds": 318.92,
      "duration_seconds": 2.08,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 320.05,
      "end_seconds": 321.52,
      "duration_seconds": 1.47,
      "text": "Look after yourself."
    }
  ]
}