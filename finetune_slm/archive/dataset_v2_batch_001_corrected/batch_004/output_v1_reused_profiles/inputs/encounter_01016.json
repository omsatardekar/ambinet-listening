{
  "schema_version": "1.0",
  "encounter_id": "01016",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 5.46,
      "duration_seconds": 4.7,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.25,
      "end_seconds": 15.33,
      "duration_seconds": 4.08,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.18,
      "end_seconds": 24.02,
      "duration_seconds": 7.84,
      "text": "I wanted to get a red, hot area on my lower leg looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.03,
      "end_seconds": 28.64,
      "duration_seconds": 3.61,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.71,
      "end_seconds": 32.13,
      "duration_seconds": 2.42,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.7,
      "end_seconds": 37.06,
      "duration_seconds": 3.36,
      "text": "Right, is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.21,
      "end_seconds": 43.08,
      "duration_seconds": 1.87,
      "text": "Elevation helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.01,
      "end_seconds": 46.38,
      "duration_seconds": 2.37,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.19,
      "end_seconds": 58.39,
      "duration_seconds": 10.2,
      "text": "It usually comes with pain in the calf. The pain in the calf? That's been since last weekend."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.58,
      "end_seconds": 80.49,
      "duration_seconds": 3.91,
      "text": "Right, did you get pus, vomiting or breathlessness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.52,
      "end_seconds": 85.08,
      "duration_seconds": 3.56,
      "text": "No, no pus, vomiting or breathlessness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.85,
      "end_seconds": 87.82,
      "duration_seconds": 1.97,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.58,
      "end_seconds": 91.15,
      "duration_seconds": 2.57,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.14,
      "end_seconds": 96.38,
      "duration_seconds": 3.24,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.47,
      "end_seconds": 99.22,
      "duration_seconds": 1.75,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.24,
      "end_seconds": 101.98,
      "duration_seconds": 1.74,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.29,
      "end_seconds": 107.57,
      "duration_seconds": 4.28,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.32,
      "end_seconds": 110.8,
      "duration_seconds": 2.48,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.31,
      "end_seconds": 114.93,
      "duration_seconds": 3.62,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 130.73,
      "duration_seconds": 4.66,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.28,
      "end_seconds": 138.58,
      "duration_seconds": 3.3,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.35,
      "end_seconds": 141.77,
      "duration_seconds": 2.42,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.99,
      "end_seconds": 146.51,
      "duration_seconds": 1.52,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.1,
      "end_seconds": 150.65,
      "duration_seconds": 3.55,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.41,
      "end_seconds": 165.78,
      "duration_seconds": 2.37,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.12,
      "end_seconds": 194.11,
      "duration_seconds": 7.99,
      "text": "Okay: blood pressure 115 over 68, temperature is 38.4 degrees, pulse is 99 beats a minute."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.72,
      "end_seconds": 198.98,
      "duration_seconds": 3.26,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.19,
      "end_seconds": 202.0,
      "duration_seconds": 1.81,
      "text": "Right, nearly finished here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.57,
      "end_seconds": 223.58,
      "duration_seconds": 9.01,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.51,
      "end_seconds": 232.89,
      "duration_seconds": 3.38,
      "text": "Okay, that's all I needed to check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.13,
      "end_seconds": 249.91,
      "duration_seconds": 5.78,
      "text": "having listened and examined, this looks most like cellulitis of the right leg"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.62,
      "end_seconds": 264.62,
      "duration_seconds": 6.0,
      "text": "Let's book an ultrasound of the leg veins to look into leg swelling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.48,
      "end_seconds": 268.4,
      "duration_seconds": 1.92,
      "text": "okay, I'll do it"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.87,
      "end_seconds": 278.37,
      "duration_seconds": 8.5,
      "text": "Let's use flucloxacillin, 500 milligrams, four times a day, for seven days. That should help with cellulitis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.15,
      "end_seconds": 283.36,
      "duration_seconds": 4.21,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 292.17,
      "duration_seconds": 8.27,
      "text": "Mark the edge of the redness with a pen and keep the leg raised when sitting. Come back in two days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.14,
      "end_seconds": 297.84,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.11,
      "end_seconds": 303.86,
      "duration_seconds": 4.75,
      "text": "Is there anything you'd like me to to go over again?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.63,
      "end_seconds": 306.79,
      "duration_seconds": 2.16,
      "text": "Thank you, that's helpful."
    }
  ]
}