{
  "schema_version": "1.0",
  "encounter_id": "01380",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.47,
      "duration_seconds": 2.95,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.21,
      "end_seconds": 9.07,
      "duration_seconds": 3.86,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.6,
      "end_seconds": 18.0,
      "duration_seconds": 8.4,
      "text": "It's pain going to the shoulder blade. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.44,
      "end_seconds": 20.72,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.57,
      "end_seconds": 25.63,
      "duration_seconds": 3.06,
      "text": "Well, it's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.25,
      "end_seconds": 31.23,
      "duration_seconds": 3.98,
      "text": "Right, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.96,
      "end_seconds": 36.41,
      "duration_seconds": 3.45,
      "text": "Well, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.19,
      "end_seconds": 41.94,
      "duration_seconds": 2.75,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.48,
      "end_seconds": 45.41,
      "duration_seconds": 1.93,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.66,
      "end_seconds": 51.72,
      "duration_seconds": 5.06,
      "text": "Have you had pain under the right ribs after fatty meals?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.33,
      "end_seconds": 62.54,
      "duration_seconds": 10.21,
      "text": "Yeah. About a week, I'd say. With pain under the right ribs after fatty meals, only lying still, and it's not much."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.5,
      "end_seconds": 67.41,
      "duration_seconds": 2.91,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.04,
      "end_seconds": 71.88,
      "duration_seconds": 2.84,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.62,
      "end_seconds": 81.0,
      "duration_seconds": 1.38,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.79,
      "end_seconds": 86.59,
      "duration_seconds": 3.8,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.26,
      "end_seconds": 91.08,
      "duration_seconds": 2.82,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.63,
      "end_seconds": 94.44,
      "duration_seconds": 2.81,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.01,
      "end_seconds": 98.67,
      "duration_seconds": 2.66,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.89,
      "end_seconds": 103.11,
      "duration_seconds": 3.22,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.92,
      "end_seconds": 116.71,
      "duration_seconds": 3.79,
      "text": "right, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.49,
      "end_seconds": 121.67,
      "duration_seconds": 4.18,
      "text": "Hmm, it's glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.94,
      "end_seconds": 125.69,
      "duration_seconds": 2.75,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.21,
      "end_seconds": 129.15,
      "duration_seconds": 2.94,
      "text": "Diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.75,
      "end_seconds": 141.49,
      "duration_seconds": 3.74,
      "text": "Any fever, weight loss or vomiting at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.57,
      "end_seconds": 145.51,
      "duration_seconds": 1.94,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.1,
      "end_seconds": 148.98,
      "duration_seconds": 2.88,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.04,
      "end_seconds": 152.52,
      "duration_seconds": 1.48,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.7,
      "end_seconds": 157.06,
      "duration_seconds": 3.36,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.62,
      "end_seconds": 161.87,
      "duration_seconds": 4.25,
      "text": "my heart's been fine, as far as I know"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 182.59,
      "duration_seconds": 2.49,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.18,
      "end_seconds": 197.32,
      "duration_seconds": 2.14,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.44,
      "end_seconds": 215.04,
      "duration_seconds": 6.6,
      "text": "Okay: pulse 76, SpO2 99 percent on room air, blood pressure 109 over 78."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.67,
      "end_seconds": 219.71,
      "duration_seconds": 3.04,
      "text": "so, shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.59,
      "end_seconds": 222.68,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.67,
      "end_seconds": 233.43,
      "duration_seconds": 2.76,
      "text": "The rest of the tummy is soft."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.5,
      "end_seconds": 235.41,
      "duration_seconds": 0.91,
      "text": "of course"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.7,
      "end_seconds": 238.98,
      "duration_seconds": 2.28,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.08,
      "end_seconds": 253.78,
      "duration_seconds": 7.7,
      "text": "mild tenderness under the right ribs, and no pain when you breathe in while I press"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.42,
      "end_seconds": 270.92,
      "duration_seconds": 12.5,
      "text": "Thank you, you can get dressed. Taking everything into account, I'm honestly not certain yet. It could be gallstone pain, or it might be gastritis."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.4,
      "end_seconds": 274.5,
      "duration_seconds": 2.1,
      "text": "is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.16,
      "end_seconds": 309.42,
      "duration_seconds": 34.26,
      "text": "I understand the worry at the moment I'd say it's gallstone pain, and we'll know more once the liver function tests is back i'm going to order liver function tests, for right upper quadrant pain smaller, lower-fat meals will probably keep the pain down until we've seen the scan one warning sign to remember: the pain lasts for hours, you get a fever or turn yellow in that case don't wait"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.55,
      "end_seconds": 313.39,
      "duration_seconds": 2.84,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.1,
      "end_seconds": 318.51,
      "duration_seconds": 3.41,
      "text": "Please come and see me after the scan."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.16,
      "end_seconds": 321.51,
      "duration_seconds": 2.35,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.58,
      "end_seconds": 327.35,
      "duration_seconds": 3.77,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.07,
      "end_seconds": 333.14,
      "duration_seconds": 3.07,
      "text": "Great, thank you for your help."
    }
  ]
}