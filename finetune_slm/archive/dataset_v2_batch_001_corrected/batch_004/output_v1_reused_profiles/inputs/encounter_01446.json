{
  "schema_version": "1.0",
  "encounter_id": "01446",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 7.96,
      "duration_seconds": 7.07,
      "text": "Hi, sit anywhere you like. Sorry about the wait, we're running a bit behind."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.62,
      "end_seconds": 15.07,
      "duration_seconds": 5.45,
      "text": "Oh, that's fine. I was just reading something on my phone."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.2,
      "end_seconds": 19.48,
      "duration_seconds": 3.28,
      "text": "Okay, what do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.32,
      "end_seconds": 28.42,
      "duration_seconds": 8.1,
      "text": "Um, so... a red, hot area on my lower leg. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.02,
      "end_seconds": 32.24,
      "duration_seconds": 3.22,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.75,
      "end_seconds": 44.54,
      "duration_seconds": 6.79,
      "text": "Actually, I'd say one week. Actually, no, closer to about two weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.31,
      "end_seconds": 47.21,
      "duration_seconds": 1.9,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.6,
      "end_seconds": 54.36,
      "duration_seconds": 5.76,
      "text": "Let me think, um, it settles a little with elevation."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.29,
      "end_seconds": 63.06,
      "duration_seconds": 2.77,
      "text": "Any pain in the calf as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.18,
      "end_seconds": 75.2,
      "duration_seconds": 11.02,
      "text": "Yeah, that too. As for pain in the calf, honestly, a couple of times a week. I've been feeling feverish too."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.86,
      "end_seconds": 85.77,
      "duration_seconds": 8.91,
      "text": "Have you had a red, hot area on your lower leg before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.56,
      "end_seconds": 94.78,
      "duration_seconds": 7.22,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.73,
      "end_seconds": 108.21,
      "duration_seconds": 3.48,
      "text": "Have you had vomiting, by any chance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.75,
      "end_seconds": 111.29,
      "duration_seconds": 1.54,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.98,
      "end_seconds": 118.32,
      "duration_seconds": 6.34,
      "text": "Have you had any chest pain, red streaks up the leg, pus or breathlessness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.49,
      "end_seconds": 127.75,
      "duration_seconds": 8.26,
      "text": "I, I haven't had chest pain, red streaks up the leg, pus or breathlessness, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.21,
      "end_seconds": 131.4,
      "duration_seconds": 3.19,
      "text": "I follow. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.29,
      "end_seconds": 135.14,
      "duration_seconds": 1.85,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.04,
      "end_seconds": 138.36,
      "duration_seconds": 1.32,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.77,
      "end_seconds": 144.62,
      "duration_seconds": 1.85,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.53,
      "end_seconds": 148.97,
      "duration_seconds": 3.44,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.33,
      "end_seconds": 153.12,
      "duration_seconds": 2.79,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.54,
      "end_seconds": 157.51,
      "duration_seconds": 2.97,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.03,
      "end_seconds": 163.66,
      "duration_seconds": 4.63,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.81,
      "end_seconds": 171.8,
      "duration_seconds": 2.99,
      "text": "Alright, tell me about your eating."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.81,
      "end_seconds": 177.75,
      "duration_seconds": 4.94,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.79,
      "end_seconds": 182.06,
      "duration_seconds": 2.27,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.7,
      "end_seconds": 184.91,
      "duration_seconds": 1.21,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.15,
      "end_seconds": 191.88,
      "duration_seconds": 5.73,
      "text": "Alright, diabetes, that matches what I have here. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.34,
      "end_seconds": 200.27,
      "duration_seconds": 2.93,
      "text": "Metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.86,
      "end_seconds": 213.1,
      "duration_seconds": 3.24,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.0,
      "end_seconds": 226.31,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.42,
      "end_seconds": 247.97,
      "duration_seconds": 8.55,
      "text": "Okay: pressure 104 over 70, SpO2 98 percent on room air, heart rate 90, temperature is 38.8 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.55,
      "end_seconds": 253.55,
      "duration_seconds": 4.0,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.91,
      "end_seconds": 257.33,
      "duration_seconds": 2.42,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.25,
      "end_seconds": 275.67,
      "duration_seconds": 7.42,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.02,
      "end_seconds": 280.52,
      "duration_seconds": 2.5,
      "text": "So, you can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.85,
      "end_seconds": 301.63,
      "duration_seconds": 12.78,
      "text": "Having listened and examined, it's hard to say. Cellulitis of the right leg is one possibility and stasis dermatitis another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 303.27,
      "end_seconds": 306.17,
      "duration_seconds": 2.9,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.82,
      "end_seconds": 326.7,
      "duration_seconds": 15.88,
      "text": "I understand the worry. At the moment I'd say it's cellulitis of the right leg, and we'll know more once the blood tests is back. I'm going to order blood tests, for skin infection."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 327.66,
      "end_seconds": 330.89,
      "duration_seconds": 3.23,
      "text": "I can book that for Tuesday at 2 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.27,
      "end_seconds": 333.36,
      "duration_seconds": 1.09,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.41,
      "end_seconds": 346.17,
      "duration_seconds": 10.76,
      "text": "The treatment will be flucloxacillin, 500 milligrams, four times a day, for seven days. You take it by mouth. That's for cellulitis."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.19,
      "end_seconds": 352.97,
      "duration_seconds": 4.78,
      "text": "Actually, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.95,
      "end_seconds": 367.81,
      "duration_seconds": 13.86,
      "text": "Mark the edge of the redness with a pen and keep the leg raised when sitting. Come back or go to emergency straight away if the redness spreads quickly or you get a high fever."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.57,
      "end_seconds": 370.13,
      "duration_seconds": 1.56,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.83,
      "end_seconds": 377.37,
      "duration_seconds": 6.54,
      "text": "Let's review you if the redness spreads. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.15,
      "end_seconds": 384.38,
      "duration_seconds": 2.23,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}