{
  "schema_version": "1.0",
  "encounter_id": "01009",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 7.61,
      "duration_seconds": 6.31,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.3,
      "end_seconds": 13.57,
      "duration_seconds": 4.27,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.82,
      "end_seconds": 28.68,
      "duration_seconds": 13.86,
      "text": "I've been dealing with a bump on my head. My sister suggested writing things down, but I forgot. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.57,
      "end_seconds": 32.35,
      "duration_seconds": 1.78,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.26,
      "end_seconds": 36.97,
      "duration_seconds": 2.71,
      "text": "It's been like this since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.96,
      "end_seconds": 40.22,
      "duration_seconds": 2.26,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.97,
      "end_seconds": 44.89,
      "duration_seconds": 2.92,
      "text": "An ice pack helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.18,
      "end_seconds": 46.25,
      "duration_seconds": 1.07,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.13,
      "end_seconds": 51.14,
      "duration_seconds": 2.01,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.41,
      "end_seconds": 63.54,
      "duration_seconds": 1.13,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.27,
      "end_seconds": 67.62,
      "duration_seconds": 2.35,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.46,
      "end_seconds": 94.7,
      "duration_seconds": 8.24,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.59,
      "end_seconds": 97.68,
      "duration_seconds": 1.09,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.82,
      "end_seconds": 109.85,
      "duration_seconds": 9.03,
      "text": "You can relax now. And what about double vision, vomiting, clear fluid from the nose or ear or confusion?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.94,
      "end_seconds": 113.65,
      "duration_seconds": 2.71,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.2,
      "end_seconds": 117.31,
      "duration_seconds": 3.11,
      "text": "Understood. Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.07,
      "end_seconds": 121.87,
      "duration_seconds": 3.8,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.59,
      "end_seconds": 127.12,
      "duration_seconds": 3.53,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.1,
      "end_seconds": 132.68,
      "duration_seconds": 2.58,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.33,
      "end_seconds": 135.56,
      "duration_seconds": 2.23,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.43,
      "end_seconds": 141.55,
      "duration_seconds": 5.12,
      "text": "Just a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.53,
      "end_seconds": 146.26,
      "duration_seconds": 2.73,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.32,
      "end_seconds": 150.7,
      "duration_seconds": 2.38,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.17,
      "end_seconds": 169.39,
      "duration_seconds": 4.22,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.07,
      "end_seconds": 173.53,
      "duration_seconds": 3.46,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.62,
      "end_seconds": 176.84,
      "duration_seconds": 1.22,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.42,
      "end_seconds": 181.36,
      "duration_seconds": 3.94,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.04,
      "end_seconds": 183.96,
      "duration_seconds": 1.92,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.36,
      "end_seconds": 192.73,
      "duration_seconds": 4.37,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.08,
      "end_seconds": 195.97,
      "duration_seconds": 1.89,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.2,
      "end_seconds": 199.7,
      "duration_seconds": 2.5,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.42,
      "end_seconds": 204.33,
      "duration_seconds": 2.91,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.3,
      "end_seconds": 211.91,
      "duration_seconds": 4.61,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.39,
      "end_seconds": 235.71,
      "duration_seconds": 9.32,
      "text": "From what you've told me and what I found, it fits best with a minor head injury without worrying signs."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.03,
      "end_seconds": 239.91,
      "duration_seconds": 2.88,
      "text": "So, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.79,
      "end_seconds": 252.02,
      "duration_seconds": 10.23,
      "text": "I understand the worry. At the moment I'd say it's a minor head injury without worrying signs, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.09,
      "end_seconds": 289.87,
      "duration_seconds": 21.78,
      "text": "We'll begin with paracetamol, 1 gram, every six hours if needed, for three days. It's for headache. Someone should stay with you tonight, and no alcohol or contact sport for now. I'll want another look if the headache gets worse. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.59,
      "end_seconds": 296.93,
      "duration_seconds": 3.34,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.94,
      "end_seconds": 300.11,
      "duration_seconds": 1.17,
      "text": "Take care now."
    }
  ]
}