{
  "schema_version": "1.0",
  "encounter_id": "01402",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.14,
      "duration_seconds": 5.27,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.6,
      "end_seconds": 12.25,
      "duration_seconds": 4.65,
      "text": "Alright, of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.61,
      "end_seconds": 17.19,
      "duration_seconds": 3.58,
      "text": "I wanted to get shaky spells looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.67,
      "end_seconds": 19.89,
      "duration_seconds": 1.22,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.88,
      "end_seconds": 23.75,
      "duration_seconds": 2.87,
      "text": "It's been about two weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.02,
      "end_seconds": 30.64,
      "duration_seconds": 5.62,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.92,
      "end_seconds": 45.17,
      "duration_seconds": 13.25,
      "text": "I'd say a couple of times a week. I'd call it mild. Eating something sweet helps a bit. I've been feeling suddenly very hungry too, for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.25,
      "end_seconds": 50.15,
      "duration_seconds": 2.9,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.81,
      "end_seconds": 56.37,
      "duration_seconds": 4.56,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.92,
      "end_seconds": 62.88,
      "duration_seconds": 1.96,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.98,
      "end_seconds": 69.26,
      "duration_seconds": 5.28,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.43,
      "end_seconds": 82.84,
      "duration_seconds": 2.41,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.83,
      "end_seconds": 89.21,
      "duration_seconds": 4.38,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.02,
      "end_seconds": 102.61,
      "duration_seconds": 2.59,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.7,
      "end_seconds": 107.94,
      "duration_seconds": 3.24,
      "text": "I have diabetes, for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.63,
      "end_seconds": 111.96,
      "duration_seconds": 2.33,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.68,
      "end_seconds": 116.84,
      "duration_seconds": 4.16,
      "text": "Well, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.5,
      "end_seconds": 121.4,
      "duration_seconds": 3.9,
      "text": "And what about seizure, vomiting or losing consciousness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.55,
      "end_seconds": 134.55,
      "duration_seconds": 8.0,
      "text": "Sorry, what was I saying, I haven't had seizure, vomiting or losing consciousness, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.15,
      "end_seconds": 138.35,
      "duration_seconds": 3.2,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.55,
      "end_seconds": 144.47,
      "duration_seconds": 4.92,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.45,
      "end_seconds": 165.55,
      "duration_seconds": 3.1,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.44,
      "end_seconds": 178.98,
      "duration_seconds": 2.54,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.89,
      "end_seconds": 205.62,
      "duration_seconds": 16.73,
      "text": "Okay: SpO2 98 percent on room air, respiratory rate 14. And height 165 centimetres, pulse 82, temp 36.8 degrees, pressure 108 over 80, weight 86 kilos, BMI works out to 31.6."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.98,
      "end_seconds": 211.47,
      "duration_seconds": 3.49,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.02,
      "end_seconds": 214.66,
      "duration_seconds": 1.64,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.03,
      "end_seconds": 218.44,
      "duration_seconds": 2.41,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.21,
      "end_seconds": 240.85,
      "duration_seconds": 3.64,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.48,
      "end_seconds": 247.02,
      "duration_seconds": 3.54,
      "text": "Right, that's all I needed to check."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.32,
      "end_seconds": 286.39,
      "duration_seconds": 28.07,
      "text": "Putting it all together, this is probably low sugar episodes related to diabetes medication. I'm sending you for a blood sugar test because of hypoglycaemia. Let's book an HbA1c to look into diabetes control. Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.17,
      "end_seconds": 306.22,
      "duration_seconds": 19.05,
      "text": "The thing that would worry me is if you black out or can't wake up properly after an episode. If that happens, go to emergency. Please come and see me after the results are back. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.53,
      "end_seconds": 309.87,
      "duration_seconds": 2.34,
      "text": "Alright, thanks, take care."
    }
  ]
}