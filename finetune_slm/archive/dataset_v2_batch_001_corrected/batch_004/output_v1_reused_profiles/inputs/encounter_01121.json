{
  "schema_version": "1.0",
  "encounter_id": "01121",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 4.67,
      "duration_seconds": 3.67,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.73,
      "end_seconds": 11.18,
      "duration_seconds": 4.45,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.1,
      "end_seconds": 15.85,
      "duration_seconds": 2.75,
      "text": "It's a stinging pain, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.21,
      "end_seconds": 20.41,
      "duration_seconds": 3.2,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.47,
      "end_seconds": 23.67,
      "duration_seconds": 2.2,
      "text": "It's lansoprazole, before breakfast."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.95,
      "end_seconds": 26.89,
      "duration_seconds": 1.94,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.35,
      "end_seconds": 33.39,
      "duration_seconds": 5.04,
      "text": "30 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.77,
      "end_seconds": 37.12,
      "duration_seconds": 2.35,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.82,
      "end_seconds": 40.99,
      "duration_seconds": 2.17,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.61,
      "end_seconds": 45.65,
      "duration_seconds": 3.04,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.32,
      "end_seconds": 58.13,
      "duration_seconds": 11.81,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.17,
      "end_seconds": 62.52,
      "duration_seconds": 2.35,
      "text": "Alright, does anything help it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.28,
      "end_seconds": 75.03,
      "duration_seconds": 8.75,
      "text": "It settles a little with a cold cloth. Um, I've also had a blister, for one week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.71,
      "end_seconds": 81.75,
      "duration_seconds": 6.04,
      "text": "Alright, did you get trouble breathing, chemical exposure or burn on the face?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.71,
      "end_seconds": 87.48,
      "duration_seconds": 3.77,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.42,
      "end_seconds": 92.61,
      "duration_seconds": 4.19,
      "text": "And what about numbness at the burn or pus?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.19,
      "end_seconds": 98.53,
      "duration_seconds": 5.34,
      "text": "I haven't had numbness at the burn or pus, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.04,
      "end_seconds": 103.4,
      "duration_seconds": 4.36,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.49,
      "end_seconds": 111.91,
      "duration_seconds": 3.42,
      "text": "Bowels are regular, um, nothing odd."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.9,
      "end_seconds": 116.47,
      "duration_seconds": 3.57,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.51,
      "end_seconds": 120.49,
      "duration_seconds": 2.98,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.83,
      "end_seconds": 128.47,
      "duration_seconds": 3.64,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.39,
      "end_seconds": 132.56,
      "duration_seconds": 3.17,
      "text": "Erm, I've had acid reflux, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.26,
      "end_seconds": 134.52,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.25,
      "end_seconds": 137.96,
      "duration_seconds": 1.71,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.8,
      "end_seconds": 144.99,
      "duration_seconds": 5.19,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.85,
      "end_seconds": 161.28,
      "duration_seconds": 15.43,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. Not much, I mostly stay in these days. I look after my grandchildren most days. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.94,
      "end_seconds": 168.53,
      "duration_seconds": 3.59,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.61,
      "end_seconds": 172.54,
      "duration_seconds": 1.93,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.88,
      "end_seconds": 191.23,
      "duration_seconds": 3.35,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.24,
      "end_seconds": 196.75,
      "duration_seconds": 3.51,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 208.0,
      "end_seconds": 217.86,
      "duration_seconds": 9.86,
      "text": "Doctor, I've got the readings for you. BP is 112 over 79, heart rate 69, SpO2 98 percent on room air, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.73,
      "end_seconds": 220.43,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.57,
      "end_seconds": 226.81,
      "duration_seconds": 4.24,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.38,
      "end_seconds": 230.49,
      "duration_seconds": 2.11,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.28,
      "end_seconds": 234.65,
      "duration_seconds": 2.37,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.15,
      "end_seconds": 253.56,
      "duration_seconds": 10.41,
      "text": "There is a five-centimetre area of redness with an intact blister on the left forearm, and it blanches and is painful."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.94,
      "end_seconds": 256.04,
      "duration_seconds": 1.1,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.12,
      "end_seconds": 259.76,
      "duration_seconds": 1.64,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.8,
      "end_seconds": 300.67,
      "duration_seconds": 27.87,
      "text": "What I'm giving you is paracetamol, 1 gram, every six hours if needed, for three days. It's for burn pain. Cool the area under running water for twenty minutes and cover it with a non-stick dressing, and leave the blister alone. Please take the tablets with food so they don't upset your stomach. Do get help quickly if the burn becomes smelly, spreads or you get a fever."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.31,
      "end_seconds": 302.97,
      "duration_seconds": 1.66,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.58,
      "end_seconds": 308.39,
      "duration_seconds": 4.81,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.13,
      "end_seconds": 312.96,
      "duration_seconds": 2.83,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.85,
      "end_seconds": 315.18,
      "duration_seconds": 1.33,
      "text": "Goodbye for now."
    }
  ]
}