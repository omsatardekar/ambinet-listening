{
  "schema_version": "1.0",
  "encounter_id": "01416",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.74,
      "end_seconds": 4.22,
      "duration_seconds": 3.48,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.75,
      "end_seconds": 9.19,
      "duration_seconds": 4.44,
      "text": "Morning, um, doctor, sorry about the the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.54,
      "end_seconds": 13.76,
      "duration_seconds": 3.22,
      "text": "okay, tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.53,
      "end_seconds": 20.59,
      "duration_seconds": 6.06,
      "text": "it's a pounding headache. I thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 22.4,
      "end_seconds": 32.81,
      "duration_seconds": 10.41,
      "text": "here are the numbers, doctor. Pulse is 66 beats a minute, pressure 124 over 72. Temperature is 36.8 degrees, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.83,
      "end_seconds": 37.25,
      "duration_seconds": 2.42,
      "text": "Right, thanks. Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.18,
      "end_seconds": 44.2,
      "duration_seconds": 5.02,
      "text": "I'd say four weeks. Actually, no, closer to one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.12,
      "end_seconds": 56.42,
      "duration_seconds": 10.3,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.94,
      "end_seconds": 70.28,
      "duration_seconds": 12.34,
      "text": "It settles a little with lying in a dark room. Honestly, a few times a day. About a three out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.49,
      "end_seconds": 75.45,
      "duration_seconds": 3.96,
      "text": "Okay, have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.51,
      "end_seconds": 87.88,
      "duration_seconds": 11.37,
      "text": "When it starts I tend to get sensitivity to light as well. Vomiting was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.29,
      "end_seconds": 107.96,
      "duration_seconds": 5.67,
      "text": "any loss of consciousness, slurred speech or weakness in the arms or legs?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.35,
      "end_seconds": 117.04,
      "duration_seconds": 7.69,
      "text": "I haven't had loss of consciousness, slurred speech or weakness in the arms or legs, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.66,
      "end_seconds": 120.29,
      "duration_seconds": 2.63,
      "text": "Alright, any sign of neck stiffness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.82,
      "end_seconds": 122.64,
      "duration_seconds": 1.82,
      "text": "Definitely no neck stiffness."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.73,
      "end_seconds": 128.48,
      "duration_seconds": 3.75,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.0,
      "end_seconds": 132.03,
      "duration_seconds": 2.03,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.88,
      "end_seconds": 135.99,
      "duration_seconds": 2.11,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.25,
      "end_seconds": 140.64,
      "duration_seconds": 3.39,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.31,
      "end_seconds": 152.74,
      "duration_seconds": 3.43,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.8,
      "end_seconds": 155.37,
      "duration_seconds": 1.57,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.3,
      "end_seconds": 158.0,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.62,
      "end_seconds": 163.75,
      "duration_seconds": 4.13,
      "text": "Erm, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.12,
      "end_seconds": 175.1,
      "duration_seconds": 5.98,
      "text": "Okay, I can see anxiety and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.31,
      "end_seconds": 198.64,
      "duration_seconds": 6.33,
      "text": "let's run through your medicines it helps to be thorough at this stage"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.19,
      "end_seconds": 203.88,
      "duration_seconds": 4.69,
      "text": "I'm on Disprin, 325 milligrams, maybe, when it starts."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 212.56,
      "duration_seconds": 4.1,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.85,
      "end_seconds": 215.92,
      "duration_seconds": 2.07,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.62,
      "end_seconds": 220.52,
      "duration_seconds": 2.9,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.35,
      "end_seconds": 224.75,
      "duration_seconds": 3.4,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.89,
      "end_seconds": 227.41,
      "duration_seconds": 1.52,
      "text": "Right, any smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 231.84,
      "end_seconds": 234.5,
      "duration_seconds": 2.66,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 235.03,
      "end_seconds": 236.85,
      "duration_seconds": 1.82,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.91,
      "end_seconds": 242.91,
      "duration_seconds": 4.0,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.62,
      "end_seconds": 246.01,
      "duration_seconds": 2.39,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.78,
      "end_seconds": 250.03,
      "duration_seconds": 3.25,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.0,
      "end_seconds": 252.68,
      "duration_seconds": 1.68,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.3,
      "end_seconds": 256.12,
      "duration_seconds": 2.82,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.94,
      "end_seconds": 260.67,
      "duration_seconds": 2.73,
      "text": "what do you do during the day?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 262.01,
      "end_seconds": 265.23,
      "duration_seconds": 3.22,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.62,
      "end_seconds": 271.63,
      "duration_seconds": 4.01,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 276.72,
      "end_seconds": 278.22,
      "duration_seconds": 1.5,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.61,
      "end_seconds": 281.61,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.44,
      "end_seconds": 295.3,
      "duration_seconds": 2.86,
      "text": "Power in all four limbs is normal"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.57,
      "end_seconds": 298.59,
      "duration_seconds": 2.02,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.17,
      "end_seconds": 313.61,
      "duration_seconds": 3.44,
      "text": "Cranial nerves look normal, eye movements are full."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.6,
      "end_seconds": 335.5,
      "duration_seconds": 15.9,
      "text": "You can relax now. Taking everything into account, this is probably migraine with aura. The reason I say that is that your story and my examination fit together. It could also be tension-type headache, so we'll keep that open."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.3,
      "end_seconds": 339.34,
      "duration_seconds": 2.04,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.72,
      "end_seconds": 362.4,
      "duration_seconds": 21.68,
      "text": "I understand the worry. At the moment I'd say it's migraine with aura, and we'll know more once the an MRI of the brain is back. I want an MRI of the brain done, that's for recurrent headaches. It's a routine test and it'll give us a much clearer picture"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.38,
      "end_seconds": 366.18,
      "duration_seconds": 1.8,
      "text": "does it it hurt?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.18,
      "end_seconds": 376.72,
      "duration_seconds": 9.54,
      "text": "the treatment will be sumatriptan, 50 milligrams, at the start of an attack, as needed. You take it by mouth. It's for migraine"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.67,
      "end_seconds": 380.16,
      "duration_seconds": 1.49,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.94,
      "end_seconds": 388.6,
      "duration_seconds": 7.66,
      "text": "I'd like you to take domperidone, 10 milligrams, when nauseous, as needed. It's for migraine nausea."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 389.15,
      "end_seconds": 393.54,
      "duration_seconds": 4.39,
      "text": "Can I collect it from my own pharmacy?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.29,
      "end_seconds": 424.81,
      "duration_seconds": 29.52,
      "text": "Keep a headache diary, things like skipped meals, poor sleep, certain foods and the weather. Try not to skip meals and keep your sleep regular. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Book a review in a month. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 426.15,
      "end_seconds": 427.94,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    }
  ]
}