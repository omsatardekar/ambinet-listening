{
  "schema_version": "1.0",
  "encounter_id": "01263",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 7.02,
      "duration_seconds": 6.17,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.92,
      "end_seconds": 13.81,
      "duration_seconds": 4.89,
      "text": "great hello, come in and sit down how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.03,
      "end_seconds": 22.6,
      "duration_seconds": 7.57,
      "text": "Good afternoon, um, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.54,
      "end_seconds": 28.17,
      "duration_seconds": 4.63,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.85,
      "end_seconds": 35.23,
      "duration_seconds": 5.38,
      "text": "I wanted to get aching bones and muscles looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.07,
      "end_seconds": 40.87,
      "duration_seconds": 3.8,
      "text": "can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.84,
      "end_seconds": 46.81,
      "duration_seconds": 3.97,
      "text": "About two weeks, uh, give or take."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 47.36,
      "end_seconds": 51.68,
      "duration_seconds": 4.32,
      "text": "I, I think it's been nearer three weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.76,
      "end_seconds": 58.28,
      "duration_seconds": 4.52,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.56,
      "end_seconds": 60.66,
      "duration_seconds": 1.1,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.44,
      "end_seconds": 63.93,
      "duration_seconds": 2.49,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.64,
      "end_seconds": 67.65,
      "duration_seconds": 3.01,
      "text": "It, It just comes and goes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.11,
      "end_seconds": 72.09,
      "duration_seconds": 2.98,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 72.89,
      "end_seconds": 94.47,
      "duration_seconds": 21.58,
      "text": "Mm, maybe a five out of ten on a bad day. I've also had a sore tongue, since last weekend. I've had low mood too, for three weeks. Actually, and there's tiredness as well, ten days now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 96.5,
      "end_seconds": 99.98,
      "duration_seconds": 3.48,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.97,
      "end_seconds": 105.25,
      "duration_seconds": 3.28,
      "text": "and what about fractures, poor diet or breathlessness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 106.58,
      "end_seconds": 109.4,
      "duration_seconds": 2.82,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.23,
      "end_seconds": 112.63,
      "duration_seconds": 2.4,
      "text": "did you notice any weight loss?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.56,
      "end_seconds": 117.22,
      "duration_seconds": 2.66,
      "text": "No, none, no weight loss."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.71,
      "end_seconds": 122.11,
      "duration_seconds": 4.4,
      "text": "mm-hmm. A few quick ones: black stools or fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 124.09,
      "end_seconds": 129.06,
      "duration_seconds": 4.97,
      "text": "Okay, so no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.96,
      "end_seconds": 134.13,
      "duration_seconds": 3.17,
      "text": "So, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 135.91,
      "end_seconds": 138.22,
      "duration_seconds": 2.31,
      "text": "no, that's all fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.91,
      "end_seconds": 142.2,
      "duration_seconds": 3.29,
      "text": "how about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.83,
      "end_seconds": 146.07,
      "duration_seconds": 3.24,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.09,
      "end_seconds": 151.54,
      "duration_seconds": 4.45,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 152.22,
      "end_seconds": 164.16,
      "duration_seconds": 11.94,
      "text": "Naproxen i come out in... well, a rash yes, wheat i've no idea what the reaction was, only that I'm not supposed to have it"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.85,
      "end_seconds": 172.34,
      "duration_seconds": 4.49,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 173.04,
      "end_seconds": 183.66,
      "duration_seconds": 10.62,
      "text": "I have acid reflux, for two years. My family kept telling me to get it checked. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.67,
      "end_seconds": 190.22,
      "duration_seconds": 1.55,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 191.31,
      "end_seconds": 204.05,
      "duration_seconds": 12.74,
      "text": "I've got gout. I've had heart failure for about a year now. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.06,
      "end_seconds": 205.86,
      "duration_seconds": 0.8,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.41,
      "end_seconds": 212.2,
      "duration_seconds": 4.79,
      "text": "I've, I've had an underactive thyroid for two years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.87,
      "end_seconds": 223.65,
      "duration_seconds": 9.78,
      "text": "Okay, I can see acid reflux and heart failure in your file as well. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.19,
      "end_seconds": 228.32,
      "duration_seconds": 4.13,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.69,
      "end_seconds": 232.72,
      "duration_seconds": 3.03,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.38,
      "end_seconds": 240.25,
      "duration_seconds": 5.87,
      "text": "My mother had a a stroke. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.89,
      "end_seconds": 244.53,
      "duration_seconds": 3.64,
      "text": "So, which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 245.29,
      "end_seconds": 249.92,
      "duration_seconds": 4.63,
      "text": "So, I take lansoprazole, 30 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 250.94,
      "end_seconds": 258.56,
      "duration_seconds": 7.62,
      "text": "It's meant to be before breakfast, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.45,
      "end_seconds": 267.5,
      "duration_seconds": 7.05,
      "text": "it's a... um, I can't remember what it's called it's a little pink tablet"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.18,
      "end_seconds": 271.61,
      "duration_seconds": 2.43,
      "text": "Do you remember what it's for?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 272.28,
      "end_seconds": 284.96,
      "duration_seconds": 12.68,
      "text": "For my heart, I believe. My son sets them out for me, I just take what I'm given. Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.6,
      "end_seconds": 288.66,
      "duration_seconds": 3.06,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 290.28,
      "end_seconds": 304.75,
      "duration_seconds": 14.47,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 315.07,
      "end_seconds": 327.67,
      "duration_seconds": 12.6,
      "text": "okay, so the vitals from earlier. Weight 54 kilos, oxygen saturation is 98 percent. BP is 122 over 79, pulse 68, height 170 centimetres, BMI works out to 18.7, temperature 36.9."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.06,
      "end_seconds": 329.97,
      "duration_seconds": 0.91,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.85,
      "end_seconds": 335.7,
      "duration_seconds": 3.85,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.93,
      "end_seconds": 339.13,
      "duration_seconds": 2.2,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.95,
      "end_seconds": 352.08,
      "duration_seconds": 3.13,
      "text": "Gentle pressure over the shin bone is tender."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.23,
      "end_seconds": 354.55,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.94,
      "end_seconds": 374.13,
      "duration_seconds": 3.19,
      "text": "The tongue looks smooth and a little red."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 375.13,
      "end_seconds": 376.21,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.7,
      "end_seconds": 388.79,
      "duration_seconds": 9.09,
      "text": "you can sit up now okay, thinking it through, it fits best with a vitamin deficiency another possibility is an underactive thyroid"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 392.84,
      "end_seconds": 395.46,
      "duration_seconds": 2.62,
      "text": "Erm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.43,
      "end_seconds": 406.79,
      "duration_seconds": 7.36,
      "text": "I can't promise yet, but most people with a vitamin deficiency do well once it's treated properly."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.91,
      "end_seconds": 423.29,
      "duration_seconds": 8.38,
      "text": "let's get a vitamin D level, for bone aches i'd like to arrange a vitamin B12 level for tingling and tiredness"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 424.76,
      "end_seconds": 426.12,
      "duration_seconds": 1.36,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 430.2,
      "end_seconds": 450.06,
      "duration_seconds": 19.86,
      "text": "For this, vitamin D, 60000 units, once a week, for eight weeks. That's for possible deficiency. Some midday sunlight on the arms for fifteen minutes helps. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 451.91,
      "end_seconds": 456.73,
      "duration_seconds": 4.82,
      "text": "Should I have a full blood count as well?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 458.47,
      "end_seconds": 465.33,
      "duration_seconds": 6.86,
      "text": "Not right now, it wouldn't change what we do today. Let's plan a check in two months."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 466.88,
      "end_seconds": 469.59,
      "duration_seconds": 2.71,
      "text": "So, alright, I'll be back."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 470.38,
      "end_seconds": 475.16,
      "duration_seconds": 4.78,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 475.71,
      "end_seconds": 478.9,
      "duration_seconds": 3.19,
      "text": "good, thanks, I'll see you then"
    }
  ]
}