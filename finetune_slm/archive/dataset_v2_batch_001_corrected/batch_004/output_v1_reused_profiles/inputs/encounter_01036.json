{
  "schema_version": "1.0",
  "encounter_id": "01036",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 4.13,
      "duration_seconds": 3.58,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.68,
      "end_seconds": 9.95,
      "duration_seconds": 4.27,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 15.38,
      "duration_seconds": 3.69,
      "text": "Oh, I've been dealing with my heart racing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.06,
      "end_seconds": 19.83,
      "duration_seconds": 2.77,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.88,
      "end_seconds": 25.83,
      "duration_seconds": 3.95,
      "text": "I've had it for nearly five years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.48,
      "end_seconds": 39.9,
      "duration_seconds": 9.42,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.28,
      "end_seconds": 54.59,
      "duration_seconds": 13.31,
      "text": "it's moderate, honestly. It just comes and goes. There's loose stools as well. I'd been feeling hot all the time, but that went away"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.89,
      "end_seconds": 69.58,
      "duration_seconds": 3.69,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.87,
      "end_seconds": 82.69,
      "duration_seconds": 2.82,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.22,
      "end_seconds": 110.86,
      "duration_seconds": 10.64,
      "text": "Okay: blood pressure 125 over 76, pulse is 121 beats a minute. And SpO2 98 percent on room air, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.5,
      "end_seconds": 116.74,
      "duration_seconds": 4.24,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.51,
      "end_seconds": 121.55,
      "duration_seconds": 3.04,
      "text": "so, take a deep breath for me"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.97,
      "end_seconds": 139.69,
      "duration_seconds": 5.72,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.54,
      "end_seconds": 144.67,
      "duration_seconds": 3.13,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.84,
      "end_seconds": 162.53,
      "duration_seconds": 6.69,
      "text": "There is a fine tremor of the outstretched hands and the pulse is fast and regular."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.58,
      "end_seconds": 169.18,
      "duration_seconds": 2.6,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.46,
      "end_seconds": 183.79,
      "duration_seconds": 4.33,
      "text": "Any fainting, chest pain, fever or double vision at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.81,
      "end_seconds": 186.73,
      "duration_seconds": 1.92,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.35,
      "end_seconds": 192.82,
      "duration_seconds": 4.47,
      "text": "Alright, and and what about neck swelling or eye pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.32,
      "end_seconds": 198.13,
      "duration_seconds": 4.81,
      "text": "No neck swelling or eye pain, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.67,
      "end_seconds": 205.02,
      "duration_seconds": 2.35,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.81,
      "end_seconds": 208.73,
      "duration_seconds": 1.92,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.99,
      "end_seconds": 216.28,
      "duration_seconds": 3.29,
      "text": "okay, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.92,
      "end_seconds": 219.7,
      "duration_seconds": 2.78,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.48,
      "end_seconds": 222.62,
      "duration_seconds": 2.14,
      "text": "alright, who lives with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.27,
      "end_seconds": 226.76,
      "duration_seconds": 2.49,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.93,
      "end_seconds": 229.67,
      "duration_seconds": 1.74,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.95,
      "end_seconds": 234.87,
      "duration_seconds": 3.92,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.88,
      "end_seconds": 240.35,
      "duration_seconds": 4.47,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.89,
      "end_seconds": 249.57,
      "duration_seconds": 7.68,
      "text": "Yes, amoxicillin, it gives me a rash all over. I'm allergic to walnuts, I get hives."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.77,
      "end_seconds": 253.03,
      "duration_seconds": 2.26,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.82,
      "end_seconds": 269.03,
      "duration_seconds": 14.21,
      "text": "It's sumatriptan, 50 milligrams, when needed. I'm supposed to take it regularly, but I don't always manage. I had telmisartan at one point, but I'm off it it now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.13,
      "end_seconds": 282.66,
      "duration_seconds": 2.53,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.79,
      "end_seconds": 290.83,
      "duration_seconds": 7.04,
      "text": "High blood pressure, for about a year. I have migraines, for about a year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.9,
      "end_seconds": 311.47,
      "duration_seconds": 19.57,
      "text": "yes. Right, yes, migraines is known to us, good to have that clear. Taking everything into account, my working impression is an overactive thyroid. An abnormal heart rhythm is also on my list. We should do a thyroid scan for neck swelling"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 313.11,
      "end_seconds": 318.08,
      "duration_seconds": 4.97,
      "text": "we have a slot Wednesday at 11:30 am, if that works"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.3,
      "end_seconds": 331.53,
      "duration_seconds": 12.23,
      "text": "Let's book thyroid blood tests to look into palpitations and weight loss. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.31,
      "end_seconds": 334.85,
      "duration_seconds": 1.54,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.12,
      "end_seconds": 354.02,
      "duration_seconds": 16.9,
      "text": "We'll begin with propranolol, 20 milligrams, twice a day, until review. It's for racing heart and tremor. Try to avoid caffeine while we sort this out. Come back after the thyroid results. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.09,
      "end_seconds": 359.23,
      "duration_seconds": 4.14,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}