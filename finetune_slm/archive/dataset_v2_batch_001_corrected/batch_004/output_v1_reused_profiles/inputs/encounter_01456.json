{
  "schema_version": "1.0",
  "encounter_id": "01456",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.23,
      "end_seconds": 9.18,
      "duration_seconds": 7.95,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.2,
      "end_seconds": 14.64,
      "duration_seconds": 3.44,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.88,
      "end_seconds": 24.65,
      "duration_seconds": 6.77,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.28,
      "end_seconds": 28.69,
      "duration_seconds": 3.41,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 30.18,
      "end_seconds": 36.48,
      "duration_seconds": 6.3,
      "text": "He's been having tight shoes by the end of the day, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.39,
      "end_seconds": 40.38,
      "duration_seconds": 2.99,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 41.77,
      "end_seconds": 52.09,
      "duration_seconds": 10.32,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.9,
      "end_seconds": 56.66,
      "duration_seconds": 2.76,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 58.24,
      "end_seconds": 65.38,
      "duration_seconds": 7.14,
      "text": "Well, uh, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.35,
      "end_seconds": 72.03,
      "duration_seconds": 5.68,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.1,
      "end_seconds": 75.34,
      "duration_seconds": 1.24,
      "text": "Moderate, really."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.85,
      "end_seconds": 84.27,
      "duration_seconds": 8.42,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 84.37,
      "end_seconds": 91.2,
      "duration_seconds": 6.83,
      "text": "Erm, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 92.53,
      "end_seconds": 105.61,
      "duration_seconds": 13.08,
      "text": "I, I was getting to that! Oh, and a heavy feeling in the legs. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.38,
      "end_seconds": 114.2,
      "duration_seconds": 7.82,
      "text": "Have you had tight shoes by the end of the day before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.98,
      "end_seconds": 120.25,
      "duration_seconds": 5.27,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 124.75,
      "end_seconds": 126.91,
      "duration_seconds": 2.16,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.03,
      "end_seconds": 133.98,
      "duration_seconds": 5.95,
      "text": "Any reduced urine, calf pain or one leg more swollen than the other?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 139.01,
      "end_seconds": 159.74,
      "duration_seconds": 20.73,
      "text": "No, no reduced urine, no calf pain, no one leg more swollen than the other. I did have swollen ankles in the evening at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.33,
      "end_seconds": 165.37,
      "duration_seconds": 4.04,
      "text": "Alright, did you get breathlessness lying flat or chest pain?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 166.09,
      "end_seconds": 171.01,
      "duration_seconds": 4.92,
      "text": "Oh, uh, no, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.43,
      "end_seconds": 174.79,
      "duration_seconds": 2.36,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 176.67,
      "end_seconds": 179.4,
      "duration_seconds": 2.73,
      "text": "Yeah, no, all normal there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.23,
      "end_seconds": 184.05,
      "duration_seconds": 2.82,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.4,
      "end_seconds": 187.52,
      "duration_seconds": 2.12,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.33,
      "end_seconds": 192.06,
      "duration_seconds": 2.73,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.71,
      "end_seconds": 196.08,
      "duration_seconds": 3.37,
      "text": "Yeah, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.43,
      "end_seconds": 200.37,
      "duration_seconds": 2.94,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 204.22,
      "end_seconds": 209.03,
      "duration_seconds": 4.81,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.73,
      "end_seconds": 210.94,
      "duration_seconds": 1.21,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 211.85,
      "end_seconds": 216.03,
      "duration_seconds": 4.18,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.66,
      "end_seconds": 220.35,
      "duration_seconds": 3.69,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 221.7,
      "end_seconds": 225.92,
      "duration_seconds": 4.22,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.29,
      "end_seconds": 246.98,
      "duration_seconds": 3.69,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 248.05,
      "end_seconds": 256.66,
      "duration_seconds": 8.61,
      "text": "I've got high blood pressure. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.81,
      "end_seconds": 258.73,
      "duration_seconds": 0.92,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 260.8,
      "end_seconds": 266.59,
      "duration_seconds": 5.79,
      "text": "Okay, so I've had high cholesterol for two years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.57,
      "end_seconds": 269.41,
      "duration_seconds": 0.84,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 271.29,
      "end_seconds": 272.77,
      "duration_seconds": 1.48,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.94,
      "end_seconds": 283.72,
      "duration_seconds": 9.78,
      "text": "Okay, I can see high cholesterol in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.35,
      "end_seconds": 288.0,
      "duration_seconds": 2.65,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.74,
      "end_seconds": 291.99,
      "duration_seconds": 3.25,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 292.94,
      "end_seconds": 302.37,
      "duration_seconds": 9.43,
      "text": "I take valsartan, 80 milligrams, once a day. Oh, uh, I'm on simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 305.28,
      "end_seconds": 316.45,
      "duration_seconds": 11.17,
      "text": "Doctor, I think the last prescription for the simvastatin was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.86,
      "end_seconds": 322.68,
      "duration_seconds": 4.82,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 324.05,
      "end_seconds": 335.45,
      "duration_seconds": 11.4,
      "text": "Hmm, no, I left it at home. Let me think, I'd been on lisinopril, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 337.2,
      "end_seconds": 349.26,
      "duration_seconds": 12.06,
      "text": "Here are the numbers, doctor. Pressure 160 over 90, pulse is 87 beats a minute, temperature is 36.9 degrees, respiratory rate 15, saturation 96 percent."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.78,
      "end_seconds": 350.48,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.08,
      "end_seconds": 355.07,
      "duration_seconds": 1.99,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 356.8,
      "end_seconds": 358.69,
      "duration_seconds": 1.89,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.46,
      "end_seconds": 361.7,
      "duration_seconds": 1.24,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.45,
      "end_seconds": 373.38,
      "duration_seconds": 3.93,
      "text": "Chest is clear and the neck veins aren't raised."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.29,
      "end_seconds": 377.46,
      "duration_seconds": 2.17,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.15,
      "end_seconds": 399.22,
      "duration_seconds": 4.07,
      "text": "Mild pitting swelling around both ankles, equal on both sides."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.77,
      "end_seconds": 401.94,
      "duration_seconds": 1.17,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.35,
      "end_seconds": 408.1,
      "duration_seconds": 1.75,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 423.07,
      "end_seconds": 435.27,
      "duration_seconds": 12.2,
      "text": "Putting it all together, this is probably ankle swelling possibly from a blood pressure tablet. Another possibility is heart-related fluid retention. Another possibility is a venous problem."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 436.12,
      "end_seconds": 439.54,
      "duration_seconds": 3.42,
      "text": "Hmm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.37,
      "end_seconds": 462.52,
      "duration_seconds": 21.15,
      "text": "Nothing I've seen today points to an emergency. It looks like ankle swelling possibly from a blood pressure tablet, but I'd like to confirm. Let me repeat that back to make sure. You've had tight shoes by the end of the day, moderate, and no reduced urine or calf pain."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 464.53,
      "end_seconds": 465.23,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 466.42,
      "end_seconds": 469.94,
      "duration_seconds": 3.52,
      "text": "We should do kidney function tests for leg swelling."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 470.88,
      "end_seconds": 472.99,
      "duration_seconds": 2.11,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 474.64,
      "end_seconds": 509.71,
      "duration_seconds": 35.07,
      "text": "I'm sending you for a urine protein test because of leg swelling. Raise your legs when you're sitting and try compression socks. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. If the symptoms get worse, that's the point to come in urgently. Book a review after the results are back."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 511.56,
      "end_seconds": 513.66,
      "duration_seconds": 2.1,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 514.68,
      "end_seconds": 517.19,
      "duration_seconds": 2.51,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 522.48,
      "end_seconds": 524.27,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    }
  ]
}