  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.61,
      "end_seconds": 6.76,
      "duration_seconds": 6.15,
      "text": "doctor this one's ready for you everything's on the chart but I'll go through it it"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 12.8,
      "duration_seconds": 4.81,
      "text": "Thank you. Good morning tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.22,
      "end_seconds": 18.74,
      "duration_seconds": 4.52,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.88,
      "end_seconds": 26.38,
      "duration_seconds": 3.5,
      "text": "yes, that's no problem at all. Please sit"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.72,
      "end_seconds": 31.1,
      "duration_seconds": 3.38,
      "text": "we came because of lower back pain"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.13,
      "end_seconds": 35.91,
      "duration_seconds": 3.78,
      "text": "are you taking anything regularly including from the pharmacy?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 37.29,
      "end_seconds": 43.08,
      "duration_seconds": 5.79,
      "text": "I'm on amlodipine 5 milligrams once a day for my pressure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 44.48,
      "end_seconds": 51.36,
      "duration_seconds": 6.88,
      "text": "that's what's prescribed, but I'm not sure he takes it every day"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 52.59,
      "end_seconds": 61.56,
      "duration_seconds": 8.97,
      "text": "It's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.11,
      "end_seconds": 65.8,
      "duration_seconds": 2.69,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 66.73,
      "end_seconds": 76.51,
      "duration_seconds": 9.78,
      "text": "for the anxiety I believe my husband sets them out for me I just take what I'm given"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.52,
      "end_seconds": 80.39,
      "duration_seconds": 2.87,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 81.94,
      "end_seconds": 93.08,
      "duration_seconds": 11.14,
      "text": "I'm not sure when it began, uh, to be honest some weeks ago, but I can't say how many"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.04,
      "end_seconds": 100.83,
      "duration_seconds": 5.79,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.56,
      "end_seconds": 109.63,
      "duration_seconds": 4.07,
      "text": "I'd say once or twice a day"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.04,
      "end_seconds": 114.27,
      "duration_seconds": 3.23,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 115.0,
      "end_seconds": 118.43,
      "duration_seconds": 3.43,
      "text": "Only heat and it's not much."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.37,
      "end_seconds": 121.39,
      "duration_seconds": 2.02,
      "text": "have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.01,
      "end_seconds": 125.59,
      "duration_seconds": 3.58,
      "text": "Bending definitely sets it it off"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 126.01,
      "end_seconds": 132.16,
      "duration_seconds": 6.15,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 132.26,
      "end_seconds": 139.51,
      "duration_seconds": 7.25,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.67,
      "end_seconds": 146.64,
      "duration_seconds": 5.97,
      "text": "later thanks please go on what about stiffness in the morning have you noticed that?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 148.4,
      "end_seconds": 152.41,
      "duration_seconds": 4.01,
      "text": "Yes, about the the same, two months."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.74,
      "end_seconds": 159.35,
      "duration_seconds": 2.61,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 160.87,
      "end_seconds": 164.15,
      "duration_seconds": 3.28,
      "text": "Honestly once or twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.67,
      "end_seconds": 168.62,
      "duration_seconds": 3.95,
      "text": "Have you had trouble sleeping because of the pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 169.3,
      "end_seconds": 170.49,
      "duration_seconds": 1.19,
      "text": "mm yes"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.64,
      "end_seconds": 177.32,
      "duration_seconds": 3.68,
      "text": "a few quick ones: fever or bladder problems?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.93,
      "end_seconds": 190.57,
      "duration_seconds": 12.64,
      "text": "no, no fever, no bladder problems i did have tingling in my left foot at one point, but that that went away on its own"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.93,
      "end_seconds": 196.41,
      "duration_seconds": 4.48,
      "text": "okay, a a few quick ones: bowel problems or weight loss?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 197.42,
      "end_seconds": 203.65,
      "duration_seconds": 6.23,
      "text": "I, I haven't had bowel problems or weight loss, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.48,
      "end_seconds": 208.08,
      "duration_seconds": 2.6,
      "text": "nothing like numbness between the legs?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 210.03,
      "end_seconds": 213.11,
      "duration_seconds": 3.08,
      "text": "no numbness between the legs, thankfully"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.1,
      "end_seconds": 218.28,
      "duration_seconds": 4.18,
      "text": "Okay, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 222.15,
      "end_seconds": 225.58,
      "duration_seconds": 3.43,
      "text": "ah, no, nothing with my heart"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.13,
      "end_seconds": 228.77,
      "duration_seconds": 2.64,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 230.67,
      "end_seconds": 243.27,
      "duration_seconds": 12.6,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.0,
      "end_seconds": 249.86,
      "duration_seconds": 4.86,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 251.66,
      "end_seconds": 255.42,
      "duration_seconds": 3.76,
      "text": "okay, so so my son has asthma"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.24,
      "end_seconds": 260.11,
      "duration_seconds": 3.87,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 261.28,
      "end_seconds": 265.29,
      "duration_seconds": 4.01,
      "text": "Um, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.64,
      "end_seconds": 267.39,
      "duration_seconds": 0.75,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 268.54,
      "end_seconds": 277.64,
      "duration_seconds": 9.1,
      "text": "Well you know yes anxiety. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.26,
      "end_seconds": 282.11,
      "duration_seconds": 2.85,
      "text": "right, right. Do you get out much?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.89,
      "end_seconds": 291.42,
      "duration_seconds": 4.53,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.77,
      "end_seconds": 295.74,
      "duration_seconds": 2.97,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 296.72,
      "end_seconds": 300.1,
      "duration_seconds": 3.38,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 313.26,
      "end_seconds": 322.11,
      "duration_seconds": 8.85,
      "text": "okay so the vitals from earlier oxygen saturation is 97 percent pulse 80. Temp 36.8 degrees pressure 121 over 78."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.79,
      "end_seconds": 323.49,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.52,
      "end_seconds": 327.84,
      "duration_seconds": 2.32,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.63,
      "end_seconds": 331.1,
      "duration_seconds": 1.47,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.2,
      "end_seconds": 357.32,
      "duration_seconds": 9.12,
      "text": "Straight leg raising on the left brings on the leg pain at about forty degrees, and the power and reflexes are normal."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.34,
      "end_seconds": 375.78,
      "duration_seconds": 16.44,
      "text": "Alright, good, you can sit up again. Let me tell you where I've got to. I'd lean towards sciatica from a lumbar disc irritation. I'd also keep a muscle strain in mind. I'd also keep a narrowed spinal canal in mind."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.35,
      "end_seconds": 388.06,
      "duration_seconds": 4.71,
      "text": "I'm gonna order an MRI of the lower back, for sciatica"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 389.6,
      "end_seconds": 391.82,
      "duration_seconds": 2.22,
      "text": "the earliest is Tuesday 9 am"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 393.62,
      "end_seconds": 396.45,
      "duration_seconds": 2.83,
      "text": "Tuesday, that works for me."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.72,
      "end_seconds": 429.66,
      "duration_seconds": 31.94,
      "text": "I'm going to order blood tests, for back pain. I'm prescribing naproxen, 500 milligrams, twice a day with food, for one week. You take it by mouth. It's for back and leg pain. Stay active and keep walking, bed rest makes this slower to settle. I'd like you to see physiotherapy as well, and I'll write the referral. I'd like to see you again after the scan."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 430.2,
      "end_seconds": 430.9,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.92,
      "end_seconds": 434.47,
      "duration_seconds": 2.55,
      "text": "have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 435.4,
      "end_seconds": 438.89,
      "duration_seconds": 3.49,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 439.84,
      "end_seconds": 441.21,
      "duration_seconds": 1.37,
      "text": "take care now"
    }
  ]
