{
  "schema_version": "1.0",
  "encounter_id": "01119",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 2.48,
      "duration_seconds": 1.66,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.46,
      "end_seconds": 12.85,
      "duration_seconds": 5.39,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.88,
      "end_seconds": 21.21,
      "duration_seconds": 7.33,
      "text": "Honestly, um, it's nausea in the mornings, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.78,
      "end_seconds": 28.9,
      "duration_seconds": 6.12,
      "text": "When did this begin? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.98,
      "end_seconds": 33.23,
      "duration_seconds": 3.25,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.15,
      "end_seconds": 38.96,
      "duration_seconds": 4.81,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.26,
      "end_seconds": 48.75,
      "duration_seconds": 8.49,
      "text": "Ah, honestly, a few times a day. It feels severe to me. There's a missed period as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.67,
      "end_seconds": 56.33,
      "duration_seconds": 5.66,
      "text": "Let me check a few things. Any bleeding or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.09,
      "end_seconds": 61.99,
      "duration_seconds": 4.9,
      "text": "No bleeding or severe abdominal pain, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.53,
      "end_seconds": 67.71,
      "duration_seconds": 4.18,
      "text": "Have you noticed burning when passing urine or vomiting everything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.41,
      "end_seconds": 71.75,
      "duration_seconds": 3.34,
      "text": "Yeah, no, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.07,
      "end_seconds": 75.29,
      "duration_seconds": 2.22,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.23,
      "end_seconds": 77.59,
      "duration_seconds": 1.36,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.52,
      "end_seconds": 86.54,
      "duration_seconds": 4.02,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.2,
      "end_seconds": 91.67,
      "duration_seconds": 1.47,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.49,
      "end_seconds": 108.83,
      "duration_seconds": 2.34,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.01,
      "end_seconds": 127.08,
      "duration_seconds": 17.07,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. I do a yoga class on Thursdays. No, I share a house with my brother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.78,
      "end_seconds": 129.02,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.81,
      "end_seconds": 133.99,
      "duration_seconds": 4.18,
      "text": "Well, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.74,
      "end_seconds": 151.0,
      "duration_seconds": 3.26,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.68,
      "end_seconds": 160.75,
      "duration_seconds": 5.07,
      "text": "Folic acid. I take it 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.41,
      "end_seconds": 165.7,
      "duration_seconds": 4.29,
      "text": "Okay, are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.76,
      "end_seconds": 171.18,
      "duration_seconds": 3.42,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.94,
      "end_seconds": 175.98,
      "duration_seconds": 4.04,
      "text": "Right, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.49,
      "end_seconds": 187.26,
      "duration_seconds": 2.77,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.22,
      "end_seconds": 220.44,
      "duration_seconds": 11.22,
      "text": "Okay: heart rate 79, SpO2 97 percent on room air, respiratory rate 16, blood pressure 126 over 74, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.1,
      "end_seconds": 223.46,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.01,
      "end_seconds": 226.94,
      "duration_seconds": 2.93,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.46,
      "end_seconds": 230.97,
      "duration_seconds": 2.51,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.06,
      "end_seconds": 234.96,
      "duration_seconds": 2.9,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.34,
      "end_seconds": 253.75,
      "duration_seconds": 6.41,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.32,
      "end_seconds": 271.33,
      "duration_seconds": 1.01,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.65,
      "end_seconds": 279.05,
      "duration_seconds": 2.4,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.04,
      "end_seconds": 305.21,
      "duration_seconds": 16.17,
      "text": "I'm sending you for an early scan because of early pregnancy. Avoid alcohol and don't take any new tablets without checking with us first. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.38,
      "end_seconds": 309.35,
      "duration_seconds": 2.97,
      "text": "Hmm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.85,
      "end_seconds": 312.08,
      "duration_seconds": 1.23,
      "text": "See you soon."
    }
  ]
}