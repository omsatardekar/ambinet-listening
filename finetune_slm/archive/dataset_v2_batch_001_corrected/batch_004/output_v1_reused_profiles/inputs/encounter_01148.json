{
  "schema_version": "1.0",
  "encounter_id": "01148",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.15,
      "end_seconds": 5.02,
      "duration_seconds": 3.87,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.46,
      "end_seconds": 10.6,
      "duration_seconds": 1.14,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.34,
      "end_seconds": 13.61,
      "duration_seconds": 2.27,
      "text": "Right, did you come far?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.46,
      "end_seconds": 19.63,
      "duration_seconds": 5.17,
      "text": "Not too far, about half an hour by bus."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.56,
      "end_seconds": 24.85,
      "duration_seconds": 3.29,
      "text": "So, start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.29,
      "end_seconds": 32.38,
      "duration_seconds": 6.09,
      "text": "Doctor, it's itching especially at night. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.23,
      "end_seconds": 36.48,
      "duration_seconds": 3.25,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.42,
      "end_seconds": 41.54,
      "duration_seconds": 3.12,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.65,
      "end_seconds": 51.96,
      "duration_seconds": 2.31,
      "text": "Any sign of swollen glands?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.91,
      "end_seconds": 55.46,
      "duration_seconds": 2.55,
      "text": "No, none, no swollen glands."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.24,
      "end_seconds": 61.29,
      "duration_seconds": 5.05,
      "text": "A few quick ones: joint pain, oozing or new medicines?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.82,
      "end_seconds": 64.81,
      "duration_seconds": 1.99,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.57,
      "end_seconds": 68.39,
      "duration_seconds": 2.82,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.4,
      "end_seconds": 71.94,
      "duration_seconds": 1.54,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.71,
      "end_seconds": 76.89,
      "duration_seconds": 4.18,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.0,
      "end_seconds": 80.5,
      "duration_seconds": 2.5,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.79,
      "end_seconds": 95.32,
      "duration_seconds": 2.53,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.24,
      "end_seconds": 98.7,
      "duration_seconds": 1.46,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.9,
      "end_seconds": 101.3,
      "duration_seconds": 1.4,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.88,
      "end_seconds": 105.09,
      "duration_seconds": 3.21,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.23,
      "end_seconds": 107.93,
      "duration_seconds": 1.7,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.75,
      "end_seconds": 113.26,
      "duration_seconds": 4.51,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.26,
      "end_seconds": 117.51,
      "duration_seconds": 2.25,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.47,
      "end_seconds": 122.07,
      "duration_seconds": 3.6,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.91,
      "end_seconds": 126.69,
      "duration_seconds": 2.78,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.45,
      "end_seconds": 133.05,
      "duration_seconds": 4.6,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.81,
      "end_seconds": 136.03,
      "duration_seconds": 1.22,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.8,
      "end_seconds": 140.65,
      "duration_seconds": 2.85,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.83,
      "end_seconds": 145.23,
      "duration_seconds": 3.4,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.81,
      "end_seconds": 148.8,
      "duration_seconds": 1.99,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.51,
      "end_seconds": 154.11,
      "duration_seconds": 3.6,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.95,
      "end_seconds": 156.76,
      "duration_seconds": 1.81,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.49,
      "end_seconds": 172.65,
      "duration_seconds": 3.16,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.69,
      "end_seconds": 184.45,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.41,
      "end_seconds": 214.46,
      "duration_seconds": 12.05,
      "text": "Okay: SpO2 99 percent on room air, temperature 36.5, respiratory rate 14. And blood pressure 127 over 68, pulse is 68 beats a minute."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 216.13,
      "end_seconds": 217.72,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.81,
      "end_seconds": 222.43,
      "duration_seconds": 2.62,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.38,
      "end_seconds": 228.6,
      "duration_seconds": 4.22,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.46,
      "end_seconds": 231.78,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.24,
      "end_seconds": 247.44,
      "duration_seconds": 8.2,
      "text": "There are small burrow-like tracks and red bumps between the fingers and on the wrists, with scratch marks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.25,
      "end_seconds": 255.17,
      "duration_seconds": 1.92,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.51,
      "end_seconds": 281.15,
      "duration_seconds": 13.64,
      "text": "Having listened and examined, this looks most like scabies. Let me just check I've got this right. You've had itching especially at night for about a month, and no new medicines or swollen glands."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.2,
      "end_seconds": 282.9,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.76,
      "end_seconds": 294.25,
      "duration_seconds": 9.49,
      "text": "I'd like you to take permethrin cream, 5 percent, once, then again after a week, for two weeks. That should help with scabies."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.66,
      "end_seconds": 297.4,
      "duration_seconds": 1.74,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.55,
      "end_seconds": 329.53,
      "duration_seconds": 30.98,
      "text": "Everyone at home should be treated at the same time, and wash bedding and clothes at a high temperature. If you smoke, this is a good moment to think about stopping, and we can help you with that. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.44,
      "end_seconds": 334.75,
      "duration_seconds": 4.31,
      "text": "So, good, thanks, I'll see you then."
    }
  ]
}