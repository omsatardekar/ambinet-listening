{
  "schema_version": "1.0",
  "encounter_id": "01452",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.11,
      "end_seconds": 5.52,
      "duration_seconds": 4.41,
      "text": "So, come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.19,
      "end_seconds": 11.99,
      "duration_seconds": 5.8,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.66,
      "end_seconds": 15.48,
      "duration_seconds": 1.82,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.28,
      "end_seconds": 24.46,
      "duration_seconds": 8.18,
      "text": "Erm, mainly sneezing fits. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.28,
      "end_seconds": 33.27,
      "duration_seconds": 2.99,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.31,
      "end_seconds": 40.24,
      "duration_seconds": 2.93,
      "text": "It's been about a week now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.9,
      "end_seconds": 45.82,
      "duration_seconds": 4.92,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.24,
      "end_seconds": 64.01,
      "duration_seconds": 16.77,
      "text": "It's, It's moderate, honestly. I get some relief from antihistamines. It just comes and goes. I've been putting this off for weeks. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.38,
      "end_seconds": 68.3,
      "duration_seconds": 2.92,
      "text": "Has there been itchy watery eyes too?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.54,
      "end_seconds": 89.65,
      "duration_seconds": 17.11,
      "text": "Um, yes, about the same, three days. Erm, about itchy watery eyes, moderate, really. Let me think, and a blocked nose at night as well, since last weekend."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.73,
      "end_seconds": 99.25,
      "duration_seconds": 7.52,
      "text": "Let me check a few things. Any wheezing, facial pain, shortness of breath or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.82,
      "end_seconds": 104.6,
      "duration_seconds": 3.78,
      "text": "So, no, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.15,
      "end_seconds": 108.54,
      "duration_seconds": 3.39,
      "text": "Right, right. Okay, has your skin been okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.9,
      "end_seconds": 110.92,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.81,
      "end_seconds": 115.04,
      "duration_seconds": 3.23,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 116.78,
      "end_seconds": 121.3,
      "duration_seconds": 4.52,
      "text": "Hmm, uh, no weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.03,
      "end_seconds": 142.49,
      "duration_seconds": 3.46,
      "text": "So, do you work outside the home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.14,
      "end_seconds": 148.58,
      "duration_seconds": 4.44,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.32,
      "end_seconds": 152.52,
      "duration_seconds": 2.2,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 153.59,
      "end_seconds": 156.39,
      "duration_seconds": 2.8,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.25,
      "end_seconds": 160.15,
      "duration_seconds": 2.9,
      "text": "So, tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.88,
      "end_seconds": 169.36,
      "duration_seconds": 6.48,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.2,
      "end_seconds": 174.84,
      "duration_seconds": 4.64,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 175.86,
      "end_seconds": 179.5,
      "duration_seconds": 3.64,
      "text": "Mm, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.33,
      "end_seconds": 195.53,
      "duration_seconds": 3.2,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.5,
      "end_seconds": 203.05,
      "duration_seconds": 5.55,
      "text": "Asthma, for about a year. I've got heart disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.11,
      "end_seconds": 215.41,
      "duration_seconds": 10.3,
      "text": "Sure. Okay, I can see asthma in your file as well. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 216.64,
      "end_seconds": 220.37,
      "duration_seconds": 3.73,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.66,
      "end_seconds": 225.75,
      "duration_seconds": 4.09,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 227.01,
      "end_seconds": 235.89,
      "duration_seconds": 8.88,
      "text": "I'm on Foracort inhaler, twice a day. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.87,
      "end_seconds": 239.64,
      "duration_seconds": 1.77,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.57,
      "end_seconds": 250.16,
      "duration_seconds": 9.59,
      "text": "About about a month. Well, it's something called ceti... cetirizine, 10 milligrams, maybe, when it flares."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.75,
      "end_seconds": 254.74,
      "duration_seconds": 2.99,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 256.09,
      "end_seconds": 258.81,
      "duration_seconds": 2.72,
      "text": "Actually, no, it's at home."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.64,
      "end_seconds": 267.45,
      "duration_seconds": 2.81,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.55,
      "end_seconds": 277.78,
      "duration_seconds": 5.23,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.42,
      "end_seconds": 280.97,
      "duration_seconds": 2.55,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.76,
      "end_seconds": 291.73,
      "duration_seconds": 2.97,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.81,
      "end_seconds": 318.64,
      "duration_seconds": 10.83,
      "text": "Okay: pulse 85, respiratory rate 17, blood pressure 116 over 77, SpO2 97 percent on room air, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 319.54,
      "end_seconds": 321.06,
      "duration_seconds": 1.52,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.85,
      "end_seconds": 325.44,
      "duration_seconds": 2.59,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.69,
      "end_seconds": 330.03,
      "duration_seconds": 2.34,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 331.12,
      "end_seconds": 333.5,
      "duration_seconds": 2.38,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.19,
      "end_seconds": 346.15,
      "duration_seconds": 3.96,
      "text": "The inside of your nose is pale and swollen."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.25,
      "end_seconds": 351.95,
      "duration_seconds": 2.7,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.5,
      "end_seconds": 388.44,
      "duration_seconds": 27.94,
      "text": "So where does that leave us? It fits best with allergic rhinitis. It could also be a viral cold, so we'll keep that open. I'm sending you for an allergy test because of allergic rhinitis. Let's use fluticasone nasal spray, 50 micrograms, one spray each side daily, for four weeks. That's for allergic rhinitis. Keep the windows closed in the early morning and wash the bedsheets weekly in hot water."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 389.45,
      "end_seconds": 404.02,
      "duration_seconds": 14.57,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. One warning sign to remember: the symptoms get worse. In that case don't wait."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 404.64,
      "end_seconds": 406.36,
      "duration_seconds": 1.72,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.59,
      "end_seconds": 410.51,
      "duration_seconds": 2.92,
      "text": "I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 412.25,
      "end_seconds": 417.23,
      "duration_seconds": 4.98,
      "text": "Hmm, I'll book it on my way out."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 418.91,
      "end_seconds": 424.84,
      "duration_seconds": 5.93,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 426.69,
      "end_seconds": 441.17,
      "duration_seconds": 14.48,
      "text": "So, uh, I take the fluticasone nasal spray, 50 micrograms, one spray each side daily and come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 442.44,
      "end_seconds": 446.7,
      "duration_seconds": 4.26,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 448.67,
      "end_seconds": 452.41,
      "duration_seconds": 3.74,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 453.56,
      "end_seconds": 454.95,
      "duration_seconds": 1.39,
      "text": "See you soon."
    }
  ]
}