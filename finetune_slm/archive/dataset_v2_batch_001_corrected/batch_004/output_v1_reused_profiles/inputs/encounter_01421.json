{
  "schema_version": "1.0",
  "encounter_id": "01421",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.64,
      "end_seconds": 6.86,
      "duration_seconds": 6.22,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.46,
      "end_seconds": 15.99,
      "duration_seconds": 4.53,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.6,
      "end_seconds": 23.66,
      "duration_seconds": 6.06,
      "text": "I've been losing weight without trying, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.41,
      "end_seconds": 28.01,
      "duration_seconds": 3.6,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.06,
      "end_seconds": 38.03,
      "duration_seconds": 3.97,
      "text": "It's, It's been like this since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.25,
      "end_seconds": 56.72,
      "duration_seconds": 2.47,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 70.74,
      "duration_seconds": 2.82,
      "text": "So, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.89,
      "end_seconds": 106.37,
      "duration_seconds": 15.48,
      "text": "Okay: pulse is 76 beats a minute, respiratory rate 17, weight 97 kilos. And height 172 centimetres, BMI works out to 32.8, pressure 112 over 81, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.69,
      "end_seconds": 110.93,
      "duration_seconds": 3.24,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.49,
      "end_seconds": 114.12,
      "duration_seconds": 1.63,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.65,
      "end_seconds": 118.03,
      "duration_seconds": 2.38,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.29,
      "end_seconds": 135.87,
      "duration_seconds": 4.58,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.78,
      "end_seconds": 140.35,
      "duration_seconds": 2.57,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.24,
      "end_seconds": 155.69,
      "duration_seconds": 2.45,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.03,
      "end_seconds": 159.89,
      "duration_seconds": 1.86,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.41,
      "end_seconds": 181.12,
      "duration_seconds": 5.71,
      "text": "Have you had any fruity smell on the breath, blurred vision or fever?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.21,
      "end_seconds": 188.17,
      "duration_seconds": 5.96,
      "text": "No, no fruity smell on the breath, blurred vision or fever."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.96,
      "end_seconds": 192.56,
      "duration_seconds": 2.6,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.57,
      "end_seconds": 197.85,
      "duration_seconds": 3.28,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.34,
      "end_seconds": 201.74,
      "duration_seconds": 2.4,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.54,
      "end_seconds": 203.89,
      "duration_seconds": 1.35,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.83,
      "end_seconds": 209.46,
      "duration_seconds": 4.63,
      "text": "Okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.34,
      "end_seconds": 217.78,
      "duration_seconds": 6.44,
      "text": "Diclofenac. I take it 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.54,
      "end_seconds": 237.28,
      "duration_seconds": 2.74,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.61,
      "end_seconds": 249.25,
      "duration_seconds": 10.64,
      "text": "I drink a lot of tea and snack through the day. My partner and our baby. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.21,
      "end_seconds": 256.09,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.85,
      "end_seconds": 260.6,
      "duration_seconds": 3.75,
      "text": "Diclofenac. I come out in... well, wheezing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.69,
      "end_seconds": 264.93,
      "duration_seconds": 3.24,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.21,
      "end_seconds": 269.19,
      "duration_seconds": 2.98,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.42,
      "end_seconds": 277.3,
      "duration_seconds": 6.88,
      "text": "Having listened and examined, I think we're dealing with possible new-onset diabetes at this stage."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.95,
      "end_seconds": 280.45,
      "duration_seconds": 1.5,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.02,
      "end_seconds": 293.1,
      "duration_seconds": 11.08,
      "text": "I understand the worry. At the moment I'd say it's possible new-onset diabetes, and we'll know more once the an HbA1c is back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.87,
      "end_seconds": 337.13,
      "duration_seconds": 30.26,
      "text": "I'm sending you for an HbA1c because of possible diabetes. It's a routine test and it'll give us a much clearer picture. I want a blood sugar test done, that's for polydipsia and polyuria. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. Come back or go to emergency straight away if you start vomiting or become drowsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.33,
      "end_seconds": 344.18,
      "duration_seconds": 2.85,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.18,
      "end_seconds": 354.95,
      "duration_seconds": 6.77,
      "text": "I'd like you back after the results are back. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.83,
      "end_seconds": 358.91,
      "duration_seconds": 3.08,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.75,
      "end_seconds": 360.96,
      "duration_seconds": 1.21,
      "text": "See you soon."
    }
  ]
}