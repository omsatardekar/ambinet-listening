{
  "schema_version": "1.0",
  "encounter_id": "01323",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.98,
      "duration_seconds": 4.01,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.52,
      "end_seconds": 10.28,
      "duration_seconds": 3.76,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.85,
      "end_seconds": 17.05,
      "duration_seconds": 6.2,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.74,
      "end_seconds": 20.77,
      "duration_seconds": 3.03,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.42,
      "end_seconds": 33.0,
      "duration_seconds": 11.58,
      "text": "It's a tight chest, mostly. I've never really been one for hospitals. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.08,
      "end_seconds": 36.26,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.97,
      "end_seconds": 41.21,
      "duration_seconds": 3.24,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.19,
      "end_seconds": 46.77,
      "duration_seconds": 3.58,
      "text": "So, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.26,
      "end_seconds": 65.31,
      "duration_seconds": 17.05,
      "text": "A six out of ten, I suppose. Um, and a sore throat as well, since Monday. With sore throat, mostly severe. I, I did have a low fever at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.15,
      "end_seconds": 73.87,
      "duration_seconds": 6.72,
      "text": "Okay, have you had a tight chest before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.77,
      "end_seconds": 83.5,
      "duration_seconds": 8.73,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.7,
      "end_seconds": 89.3,
      "duration_seconds": 3.6,
      "text": "Have you had any leg swelling or night sweats?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.83,
      "end_seconds": 95.18,
      "duration_seconds": 4.35,
      "text": "I haven't had leg swelling or night sweats, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.51,
      "end_seconds": 101.53,
      "duration_seconds": 5.02,
      "text": "Have you had any coughing up blood, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.32,
      "end_seconds": 105.43,
      "duration_seconds": 3.11,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.9,
      "end_seconds": 109.02,
      "duration_seconds": 2.12,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.27,
      "end_seconds": 112.51,
      "duration_seconds": 2.24,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.71,
      "end_seconds": 126.3,
      "duration_seconds": 2.59,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.78,
      "end_seconds": 131.36,
      "duration_seconds": 3.58,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.75,
      "end_seconds": 137.67,
      "duration_seconds": 4.92,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.12,
      "end_seconds": 147.18,
      "duration_seconds": 4.06,
      "text": "So, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 151.97,
      "duration_seconds": 3.78,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.31,
      "end_seconds": 155.95,
      "duration_seconds": 2.64,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.82,
      "end_seconds": 160.7,
      "duration_seconds": 2.88,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.6,
      "end_seconds": 173.99,
      "duration_seconds": 8.39,
      "text": "I have asthma, for five years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.75,
      "end_seconds": 176.59,
      "duration_seconds": 1.84,
      "text": "Right, and besides that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.48,
      "end_seconds": 182.62,
      "duration_seconds": 5.14,
      "text": "I've had high blood pressure for about a year now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.53,
      "end_seconds": 185.84,
      "duration_seconds": 1.31,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.98,
      "end_seconds": 188.47,
      "duration_seconds": 1.49,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 194.65,
      "duration_seconds": 4.94,
      "text": "Alright, asthma and anxiety, that matches what I have here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.01,
      "end_seconds": 213.16,
      "duration_seconds": 4.15,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 214.37,
      "end_seconds": 228.02,
      "duration_seconds": 13.65,
      "text": "He takes Foracort inhaler, twice a day for my asthma. Right, he takes hydrochlorothiazide, 12.5 milligrams, every morning. So, it's paracetamol, 500 milligrams, when needed, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.71,
      "end_seconds": 230.65,
      "duration_seconds": 1.94,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.61,
      "end_seconds": 235.82,
      "duration_seconds": 4.21,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.69,
      "end_seconds": 240.55,
      "duration_seconds": 3.86,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.44,
      "end_seconds": 245.94,
      "duration_seconds": 3.5,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.75,
      "end_seconds": 262.76,
      "duration_seconds": 3.01,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.75,
      "end_seconds": 275.37,
      "duration_seconds": 2.62,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.14,
      "end_seconds": 299.85,
      "duration_seconds": 11.71,
      "text": "Okay: SpO2 96 percent on room air, respiratory rate 19. And pulse 103, blood pressure 117 over 71, temperature is 38.5 degrees."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.18,
      "end_seconds": 304.85,
      "duration_seconds": 1.67,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.74,
      "end_seconds": 307.75,
      "duration_seconds": 2.01,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.65,
      "end_seconds": 315.14,
      "duration_seconds": 4.49,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.96,
      "end_seconds": 319.23,
      "duration_seconds": 2.27,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.22,
      "end_seconds": 333.63,
      "duration_seconds": 4.41,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.41,
      "end_seconds": 336.81,
      "duration_seconds": 1.4,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.97,
      "end_seconds": 352.4,
      "duration_seconds": 2.43,
      "text": "No crackles at the bases."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.68,
      "end_seconds": 389.49,
      "duration_seconds": 34.81,
      "text": "That's all I needed to check. Right, here's what I'm thinking. I'm honestly not certain yet. It could be acute bronchitis, or it might be pneumonia. I'm going to order a chest X-ray, for cough. I'd rather check than guess, and this is the quickest way to know more. I'd like to arrange blood tests for cough. We'll begin with azithromycin, 500 milligrams, once a day, for three days. That's for chest infection."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.66,
      "end_seconds": 417.25,
      "duration_seconds": 22.59,
      "text": "Steam and warm fluids can ease the cough, and try to sleep with your head propped up. Come back or go to emergency straight away if you become breathless or cough up blood. Book a review in ten days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.89,
      "end_seconds": 419.58,
      "duration_seconds": 1.69,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.15,
      "end_seconds": 422.61,
      "duration_seconds": 1.46,
      "text": "Goodbye for now."
    }
  ]
}