{
  "schema_version": "1.0",
  "encounter_id": "01146",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 7.14,
      "duration_seconds": 6.09,
      "text": "Sorry, what was I saying, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.26,
      "end_seconds": 12.53,
      "duration_seconds": 4.27,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.26,
      "end_seconds": 19.88,
      "duration_seconds": 5.62,
      "text": "Well, you know, I've been having an itchy rash all over."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.12,
      "end_seconds": 24.67,
      "duration_seconds": 3.55,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.05,
      "end_seconds": 30.26,
      "duration_seconds": 4.21,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.18,
      "end_seconds": 33.77,
      "duration_seconds": 2.59,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.31,
      "end_seconds": 38.16,
      "duration_seconds": 3.85,
      "text": "It settles a little with an antihistamine."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.07,
      "end_seconds": 41.64,
      "duration_seconds": 2.57,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.55,
      "end_seconds": 47.5,
      "duration_seconds": 3.95,
      "text": "It usually comes with swelling of my lips."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.49,
      "end_seconds": 53.92,
      "duration_seconds": 5.43,
      "text": "Let me check a few things. Any throat tightness, vomiting or new food?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.7,
      "end_seconds": 61.57,
      "duration_seconds": 5.87,
      "text": "So, I haven't had throat tightness, vomiting or new food, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.64,
      "end_seconds": 64.81,
      "duration_seconds": 2.17,
      "text": "Any sign of trouble breathing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.94,
      "end_seconds": 68.98,
      "duration_seconds": 3.04,
      "text": "No, none, no trouble breathing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.91,
      "end_seconds": 73.14,
      "duration_seconds": 3.23,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.34,
      "end_seconds": 76.16,
      "duration_seconds": 1.82,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.52,
      "end_seconds": 79.55,
      "duration_seconds": 2.03,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.75,
      "end_seconds": 83.27,
      "duration_seconds": 2.52,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.1,
      "end_seconds": 88.62,
      "duration_seconds": 3.52,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.18,
      "end_seconds": 93.94,
      "duration_seconds": 3.76,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.11,
      "end_seconds": 100.61,
      "duration_seconds": 5.5,
      "text": "Okay, go on. Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.89,
      "end_seconds": 115.0,
      "duration_seconds": 2.11,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.08,
      "end_seconds": 121.71,
      "duration_seconds": 5.63,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.36,
      "end_seconds": 124.69,
      "duration_seconds": 2.33,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.84,
      "end_seconds": 129.62,
      "duration_seconds": 3.78,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.13,
      "end_seconds": 132.99,
      "duration_seconds": 2.86,
      "text": "Okay, is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.53,
      "end_seconds": 138.25,
      "duration_seconds": 3.72,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.5,
      "end_seconds": 158.39,
      "duration_seconds": 3.89,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.6,
      "end_seconds": 168.31,
      "duration_seconds": 8.71,
      "text": "Uh, I'm on Foracort inhaler, twice a day. Um, it's cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.05,
      "end_seconds": 171.84,
      "duration_seconds": 2.79,
      "text": "So, any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.48,
      "end_seconds": 180.32,
      "duration_seconds": 6.84,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.78,
      "end_seconds": 196.25,
      "duration_seconds": 2.47,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.12,
      "end_seconds": 203.44,
      "duration_seconds": 5.32,
      "text": "Erm, I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.27,
      "end_seconds": 208.0,
      "duration_seconds": 3.73,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.94,
      "end_seconds": 219.27,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.33,
      "end_seconds": 239.77,
      "duration_seconds": 9.44,
      "text": "Okay: heart rate 71, respiratory rate 15, temperature is 36.7 degrees, BP is 124 over 69, saturation 99 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.63,
      "end_seconds": 243.03,
      "duration_seconds": 1.4,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.38,
      "end_seconds": 247.65,
      "duration_seconds": 3.27,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.89,
      "end_seconds": 252.32,
      "duration_seconds": 3.43,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.95,
      "end_seconds": 256.57,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.51,
      "end_seconds": 283.75,
      "duration_seconds": 11.24,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.18,
      "end_seconds": 295.97,
      "duration_seconds": 8.79,
      "text": "You can sit up now. Putting it all together, this looks most like an allergic reaction, possibly to a recently started medicine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.8,
      "end_seconds": 300.82,
      "duration_seconds": 3.02,
      "text": "Oh, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.38,
      "end_seconds": 325.32,
      "duration_seconds": 22.94,
      "text": "Nothing I've seen today points to an emergency. It looks like an allergic reaction, possibly to a recently started medicine. Let's use prednisolone, 30 milligrams, once a day, for three days. It's for allergic reaction. The treatment will be chlorphenamine, 4 milligrams, every six hours, for three days. It's for allergic rash."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.07,
      "end_seconds": 332.76,
      "duration_seconds": 3.69,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.0,
      "end_seconds": 349.39,
      "duration_seconds": 15.39,
      "text": "Stop the new tablet until we know what caused it and write down every medicine you took in the last week. I'll want another look after the review. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.82,
      "end_seconds": 354.18,
      "duration_seconds": 3.36,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}