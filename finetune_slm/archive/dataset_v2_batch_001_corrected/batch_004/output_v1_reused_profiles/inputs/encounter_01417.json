{
  "schema_version": "1.0",
  "encounter_id": "01417",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 5.5,
      "duration_seconds": 4.6,
      "text": "hello, sorry about the delay, do sit what's the problem?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.15,
      "end_seconds": 16.22,
      "duration_seconds": 6.07,
      "text": "It's tingling in my fingers. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.36,
      "end_seconds": 23.31,
      "duration_seconds": 2.95,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.75,
      "end_seconds": 34.3,
      "duration_seconds": 8.55,
      "text": "I've had it since yesterday. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.0,
      "end_seconds": 41.37,
      "duration_seconds": 5.37,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.56,
      "end_seconds": 55.79,
      "duration_seconds": 13.23,
      "text": "A five out of ten, I suppose. It's worse with holding the phone and typing. I've been waking up at night with pins and needles too, for four weeks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.22,
      "end_seconds": 66.58,
      "duration_seconds": 1.36,
      "text": "Any neck pain?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.81,
      "end_seconds": 70.87,
      "duration_seconds": 3.06,
      "text": "Not at all, no neck pain."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.83,
      "end_seconds": 78.28,
      "duration_seconds": 5.45,
      "text": "Did you get trouble walking, bladder problems, weakness in the legs or headache?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.92,
      "end_seconds": 82.73,
      "duration_seconds": 3.81,
      "text": "No, uh, none of those at all."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.78,
      "end_seconds": 87.67,
      "duration_seconds": 2.89,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.71,
      "end_seconds": 90.54,
      "duration_seconds": 1.83,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.1,
      "end_seconds": 94.64,
      "duration_seconds": 2.54,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.42,
      "end_seconds": 97.5,
      "duration_seconds": 2.08,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.35,
      "end_seconds": 100.71,
      "duration_seconds": 1.36,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.34,
      "end_seconds": 105.27,
      "duration_seconds": 3.93,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.36,
      "end_seconds": 108.54,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.61,
      "end_seconds": 112.58,
      "duration_seconds": 2.97,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.71,
      "end_seconds": 127.72,
      "duration_seconds": 3.01,
      "text": "So, what about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.82,
      "end_seconds": 130.27,
      "duration_seconds": 1.45,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.03,
      "end_seconds": 133.63,
      "duration_seconds": 1.6,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.4,
      "end_seconds": 148.54,
      "duration_seconds": 10.14,
      "text": "I have an underactive thyroid, for nearly five years i'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.94,
      "end_seconds": 160.83,
      "duration_seconds": 10.89,
      "text": "right, so diabetes and an underactive thyroid are already on your record we'll keep that in mind today does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.87,
      "end_seconds": 165.61,
      "duration_seconds": 2.74,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.72,
      "end_seconds": 170.38,
      "duration_seconds": 3.66,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.95,
      "end_seconds": 181.86,
      "duration_seconds": 9.91,
      "text": "I'm on sitagliptin, 100 milligrams, once a day for my sugar. Eltroxin, 100 micrograms, every morning for my thyroid"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.12,
      "end_seconds": 183.42,
      "duration_seconds": 1.3,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.75,
      "end_seconds": 188.66,
      "duration_seconds": 3.91,
      "text": "I'm on paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.37,
      "end_seconds": 192.47,
      "duration_seconds": 2.1,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 194.23,
      "end_seconds": 198.04,
      "duration_seconds": 3.81,
      "text": "just part of my thyroid removed, years back"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 212.08,
      "end_seconds": 221.54,
      "duration_seconds": 9.46,
      "text": "Doctor, I've got the readings for you. Heart rate 71, SpO2 98 percent on room air, temperature is 36.7 degrees, pressure 127 over 75."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.55,
      "end_seconds": 223.63,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.15,
      "end_seconds": 230.19,
      "duration_seconds": 4.04,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.32,
      "end_seconds": 233.65,
      "duration_seconds": 2.33,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.55,
      "end_seconds": 245.7,
      "duration_seconds": 3.15,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.86,
      "end_seconds": 247.87,
      "duration_seconds": 1.01,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.29,
      "end_seconds": 273.57,
      "duration_seconds": 22.28,
      "text": "You can sit up now. Okay, thinking it through, it fits best with carpal tunnel syndrome. The reason I say that is that your story and my examination fit together. We shouldn't forget diabetic neuropathy. So, to recap quickly. You've had tingling in your fingers, since yesterday, and no neck pain or bladder problems."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.88,
      "end_seconds": 275.58,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.42,
      "end_seconds": 293.05,
      "duration_seconds": 16.63,
      "text": "I'm going to order a nerve conduction study, for hand numbness. That will help us see what's going on underneath and decide the next step. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 294.67,
      "end_seconds": 295.73,
      "duration_seconds": 1.06,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.25,
      "end_seconds": 300.52,
      "duration_seconds": 4.27,
      "text": "Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.31,
      "end_seconds": 304.52,
      "duration_seconds": 3.21,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.76,
      "end_seconds": 308.26,
      "duration_seconds": 2.5,
      "text": "alright, have a good day"
    }
  ]
}