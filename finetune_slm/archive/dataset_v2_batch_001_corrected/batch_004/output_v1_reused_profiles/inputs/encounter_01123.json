  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 5.25,
      "duration_seconds": 4.55,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.8,
      "end_seconds": 14.56,
      "duration_seconds": 4.76,
      "text": "So, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.84,
      "end_seconds": 25.5,
      "duration_seconds": 9.66,
      "text": "It's my face drooping on the right side, mostly. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.1,
      "end_seconds": 33.55,
      "duration_seconds": 3.45,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.12,
      "end_seconds": 39.12,
      "duration_seconds": 4.0,
      "text": "Right, it's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.43,
      "end_seconds": 40.4,
      "duration_seconds": 0.97,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.24,
      "end_seconds": 44.12,
      "duration_seconds": 2.88,
      "text": "And food tasting odd, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.28,
      "end_seconds": 50.32,
      "duration_seconds": 5.04,
      "text": "Any rash around the ear, headache or slurred speech at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.19,
      "end_seconds": 54.38,
      "duration_seconds": 2.19,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.38,
      "end_seconds": 57.63,
      "duration_seconds": 2.25,
      "text": "Nothing like recent tick bite?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.55,
      "end_seconds": 62.17,
      "duration_seconds": 3.62,
      "text": "Not at all, no recent tick bite."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.24,
      "end_seconds": 66.76,
      "duration_seconds": 3.52,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.45,
      "end_seconds": 69.85,
      "duration_seconds": 2.4,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.84,
      "end_seconds": 73.46,
      "duration_seconds": 1.62,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.39,
      "end_seconds": 82.57,
      "duration_seconds": 3.18,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.58,
      "end_seconds": 85.55,
      "duration_seconds": 1.97,
      "text": "So, and your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.53,
      "end_seconds": 89.93,
      "duration_seconds": 3.4,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.15,
      "end_seconds": 112.51,
      "duration_seconds": 4.36,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.17,
      "end_seconds": 114.67,
      "duration_seconds": 1.5,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.62,
      "end_seconds": 134.38,
      "duration_seconds": 3.76,
      "text": "Right, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.61,
      "end_seconds": 137.2,
      "duration_seconds": 1.59,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.63,
      "end_seconds": 141.59,
      "duration_seconds": 2.96,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.66,
      "end_seconds": 144.21,
      "duration_seconds": 1.55,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.39,
      "end_seconds": 160.29,
      "duration_seconds": 3.9,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.38,
      "end_seconds": 165.01,
      "duration_seconds": 2.63,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.49,
      "end_seconds": 174.54,
      "duration_seconds": 4.05,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.43,
      "end_seconds": 186.07,
      "duration_seconds": 2.64,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.55,
      "end_seconds": 207.54,
      "duration_seconds": 7.99,
      "text": "Okay: BP is 109 over 75, pulse is 67 beats a minute, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.71,
      "end_seconds": 210.3,
      "duration_seconds": 1.59,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.17,
      "end_seconds": 214.83,
      "duration_seconds": 3.66,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.36,
      "end_seconds": 220.56,
      "duration_seconds": 4.2,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.28,
      "end_seconds": 224.98,
      "duration_seconds": 2.7,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.68,
      "end_seconds": 247.21,
      "duration_seconds": 6.53,
      "text": "Left side of the face moves normally, and arm and leg strength is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.37,
      "end_seconds": 251.63,
      "duration_seconds": 2.26,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.71,
      "end_seconds": 297.04,
      "duration_seconds": 35.33,
      "text": "So, based on the history and the examination, I'd lean towards a Bell's palsy pattern. I think blood sugar testing makes sense here, for facial palsy. Let's use prednisolone, 50 milligrams, once a day, for seven days. You take it by mouth. That should help with facial weakness. Use lubricating drops through the day and tape the eye shut at night. We'll catch up in a week. So, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.19,
      "end_seconds": 301.13,
      "duration_seconds": 2.94,
      "text": "I think I understand everything. Thanks."
    }
  ]
}