{
  "schema_version": "1.0",
  "encounter_id": "01138",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 3.89,
      "duration_seconds": 2.92,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.52,
      "end_seconds": 8.21,
      "duration_seconds": 2.69,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.87,
      "end_seconds": 11.86,
      "duration_seconds": 2.99,
      "text": "Okay, lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.79,
      "end_seconds": 18.44,
      "duration_seconds": 4.65,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.18,
      "end_seconds": 21.74,
      "duration_seconds": 1.56,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.81,
      "end_seconds": 31.97,
      "duration_seconds": 8.16,
      "text": "I wanted to get muscle aches looked at. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.72,
      "end_seconds": 36.99,
      "duration_seconds": 3.27,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.39,
      "end_seconds": 44.38,
      "duration_seconds": 5.99,
      "text": "About four days, I think... sorry, three days, I got that wrong."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.43,
      "end_seconds": 48.59,
      "duration_seconds": 3.16,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.25,
      "end_seconds": 54.12,
      "duration_seconds": 3.87,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.45,
      "end_seconds": 57.93,
      "duration_seconds": 3.48,
      "text": "Okay, go on. Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.15,
      "end_seconds": 70.38,
      "duration_seconds": 11.23,
      "text": "It usually comes with a high fever with shaking chills. The high fever with shaking chills? That's been since Monday."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.38,
      "end_seconds": 83.47,
      "duration_seconds": 3.09,
      "text": "Did you get cough or neck stiffness?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.28,
      "end_seconds": 87.4,
      "duration_seconds": 2.12,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.0,
      "end_seconds": 95.01,
      "duration_seconds": 3.01,
      "text": "Have you noticed rash, diarrhoea or confusion?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.78,
      "end_seconds": 99.27,
      "duration_seconds": 3.49,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.37,
      "end_seconds": 109.17,
      "duration_seconds": 4.8,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.06,
      "end_seconds": 113.21,
      "duration_seconds": 2.15,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.3,
      "end_seconds": 131.76,
      "duration_seconds": 4.46,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.69,
      "end_seconds": 137.0,
      "duration_seconds": 3.31,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.79,
      "end_seconds": 155.05,
      "duration_seconds": 4.26,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.18,
      "end_seconds": 164.01,
      "duration_seconds": 7.83,
      "text": "Yes, an irregular heartbeat. I've got diabetes. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.21,
      "end_seconds": 172.99,
      "duration_seconds": 7.78,
      "text": "I follow. Yes, an irregular heartbeat is known to us, good to have that clear. What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.02,
      "end_seconds": 179.66,
      "duration_seconds": 4.64,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.39,
      "end_seconds": 183.56,
      "duration_seconds": 2.17,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.45,
      "end_seconds": 189.19,
      "duration_seconds": 3.74,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.96,
      "end_seconds": 193.71,
      "duration_seconds": 2.75,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.6,
      "end_seconds": 199.03,
      "duration_seconds": 3.43,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.32,
      "end_seconds": 202.42,
      "duration_seconds": 2.1,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.73,
      "end_seconds": 208.89,
      "duration_seconds": 5.16,
      "text": "It's warfarin, 3 milligrams, in the evening for the blood thinning."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.81,
      "end_seconds": 212.46,
      "duration_seconds": 2.65,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.72,
      "end_seconds": 226.38,
      "duration_seconds": 12.66,
      "text": "About a year now. I'm on glimepiride, 2 milligrams, before breakfast for my sugar. I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.81,
      "end_seconds": 229.23,
      "duration_seconds": 1.42,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.95,
      "end_seconds": 232.11,
      "duration_seconds": 2.16,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.27,
      "end_seconds": 235.82,
      "duration_seconds": 2.55,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.65,
      "end_seconds": 240.24,
      "duration_seconds": 3.59,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.86,
      "end_seconds": 244.63,
      "duration_seconds": 2.77,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.71,
      "end_seconds": 248.72,
      "duration_seconds": 2.01,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.68,
      "end_seconds": 252.41,
      "duration_seconds": 2.73,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.63,
      "end_seconds": 267.83,
      "duration_seconds": 2.2,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.31,
      "end_seconds": 296.38,
      "duration_seconds": 8.07,
      "text": "Okay: temp 39.0 degrees, saturation 98 percent, blood pressure 105 over 77. And heart rate 101."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.04,
      "end_seconds": 302.59,
      "duration_seconds": 1.55,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.58,
      "end_seconds": 308.5,
      "duration_seconds": 2.92,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.09,
      "end_seconds": 313.89,
      "duration_seconds": 2.8,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.92,
      "end_seconds": 316.11,
      "duration_seconds": 1.19,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.41,
      "end_seconds": 336.93,
      "duration_seconds": 4.52,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.48,
      "end_seconds": 370.73,
      "duration_seconds": 30.25,
      "text": "You can sit up now. Let me tell you where I've got to. The most likely explanation is a fever after travel that must be treated as possible malaria. The reason I say that is that your story and my examination fit together. Another possibility is dengue fever. Let's get a malaria test, for fever after travel. Avoid anti-inflammatory painkillers and keep drinking. I think the tropical diseases unit should see you too."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 372.4,
      "end_seconds": 376.18,
      "duration_seconds": 3.78,
      "text": "Sure, uh, where do I go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 377.42,
      "end_seconds": 381.46,
      "duration_seconds": 4.04,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.61,
      "end_seconds": 385.91,
      "duration_seconds": 3.3,
      "text": "Great, thank you for your help."
    }
  ]
}