  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 8.57,
      "duration_seconds": 7.25,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.17,
      "end_seconds": 15.66,
      "duration_seconds": 5.49,
      "text": "right, yes, come in and sit down what brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 17.62,
      "end_seconds": 29.58,
      "duration_seconds": 11.96,
      "text": "Ah, uh, hello, doctor. I hope it's alright if I stay in for this. Doctor, it's loud snoring. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.42,
      "end_seconds": 34.56,
      "duration_seconds": 3.14,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 36.21,
      "end_seconds": 41.91,
      "duration_seconds": 5.7,
      "text": "It's gliclazide, 80 milligrams, twice a day for my sugar, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.12,
      "end_seconds": 46.19,
      "duration_seconds": 3.07,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.37,
      "end_seconds": 51.42,
      "duration_seconds": 4.05,
      "text": "Hmm, I've had it for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.71,
      "end_seconds": 55.3,
      "duration_seconds": 3.59,
      "text": "Understood. Have you been feeling sleepy during the day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.86,
      "end_seconds": 82.54,
      "duration_seconds": 25.68,
      "text": "Yes, um, about the same, about a month. So, about feeling sleepy during the day, I'd give it a seven, out of ten. There's my partner noticing pauses in my breathing as well. As for my partner noticing pauses in my breathing, it feels mild to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.34,
      "end_seconds": 91.46,
      "duration_seconds": 8.12,
      "text": "Let me check a few things. Any choking at night, leg swelling, palpitations or low mood?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.58,
      "end_seconds": 104.95,
      "duration_seconds": 8.37,
      "text": "Okay, uh, so no, no choking at night, leg swelling, palpitations or low mood."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.8,
      "end_seconds": 109.3,
      "duration_seconds": 3.5,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.23,
      "end_seconds": 111.98,
      "duration_seconds": 1.75,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.9,
      "end_seconds": 117.82,
      "duration_seconds": 3.92,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.89,
      "end_seconds": 123.12,
      "duration_seconds": 3.23,
      "text": "actually, bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 125.89,
      "duration_seconds": 2.25,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.2,
      "end_seconds": 133.31,
      "duration_seconds": 6.11,
      "text": "I've got diabetes. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.07,
      "end_seconds": 152.65,
      "duration_seconds": 4.58,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.36,
      "end_seconds": 158.81,
      "duration_seconds": 4.45,
      "text": "oh, yes, cat fur, it gives me sneezing"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.54,
      "end_seconds": 164.78,
      "duration_seconds": 2.24,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.26,
      "end_seconds": 170.71,
      "duration_seconds": 4.45,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.8,
      "end_seconds": 173.06,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.87,
      "end_seconds": 177.9,
      "duration_seconds": 3.03,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.15,
      "end_seconds": 181.69,
      "duration_seconds": 2.54,
      "text": "Okay, tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.92,
      "end_seconds": 188.3,
      "duration_seconds": 5.38,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.92,
      "end_seconds": 205.47,
      "duration_seconds": 2.55,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.02,
      "end_seconds": 210.54,
      "duration_seconds": 3.52,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.33,
      "end_seconds": 226.28,
      "duration_seconds": 2.95,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 241.62,
      "duration_seconds": 3.41,
      "text": "So, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.29,
      "end_seconds": 265.2,
      "duration_seconds": 7.91,
      "text": "Okay: respiratory rate 14, pulse 74. And temperature 36.6, oxygen saturation is 97 percent, pressure 151 over 97."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.64,
      "end_seconds": 272.95,
      "duration_seconds": 5.31,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.04,
      "end_seconds": 275.75,
      "duration_seconds": 1.71,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.33,
      "end_seconds": 292.87,
      "duration_seconds": 5.54,
      "text": "Your neck is thick and the the back of the throat looks crowded."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.16,
      "end_seconds": 311.45,
      "duration_seconds": 15.29,
      "text": "please sit back down. From what you've told me and what I found, the most likely explanation is symptoms that suggest obstructive sleep apnoea. That's my thinking for now, and it it may change as we learn more"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.45,
      "end_seconds": 320.01,
      "duration_seconds": 3.56,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.01,
      "end_seconds": 339.61,
      "duration_seconds": 14.6,
      "text": "Nothing I've seen today points to an emergency. It looks like symptoms that suggest obstructive sleep apnoea. I don't need to add any tests or treatment at this point. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.37,
      "end_seconds": 344.75,
      "duration_seconds": 4.38,
      "text": "Well, good, thanks, I'll see you then."
    }
  ]
}