{
  "schema_version": "1.0",
  "encounter_id": "01006",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.44,
      "duration_seconds": 2.51,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.86,
      "end_seconds": 7.92,
      "duration_seconds": 1.06,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.79,
      "end_seconds": 13.14,
      "duration_seconds": 3.35,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.21,
      "end_seconds": 21.12,
      "duration_seconds": 6.91,
      "text": "Of course, please stay. It's helpful to have you here. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.13,
      "end_seconds": 28.39,
      "duration_seconds": 3.26,
      "text": "Well, I've been having a poor appetite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.68,
      "end_seconds": 30.16,
      "duration_seconds": 1.48,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.98,
      "end_seconds": 37.01,
      "duration_seconds": 6.03,
      "text": "Erm, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 37.11,
      "end_seconds": 44.27,
      "duration_seconds": 7.16,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.2,
      "end_seconds": 47.29,
      "duration_seconds": 2.09,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.13,
      "end_seconds": 51.82,
      "duration_seconds": 3.69,
      "text": "And I've been feeling tired as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.04,
      "end_seconds": 55.89,
      "duration_seconds": 2.85,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.35,
      "end_seconds": 64.25,
      "duration_seconds": 5.9,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.48,
      "end_seconds": 71.31,
      "duration_seconds": 5.83,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.15,
      "end_seconds": 80.9,
      "duration_seconds": 8.75,
      "text": "Mostly severe. I was losing weight without trying at one point, you know, but that's gone now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.22,
      "end_seconds": 88.3,
      "duration_seconds": 6.08,
      "text": "Have you had a poor appetite before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.4,
      "end_seconds": 94.38,
      "duration_seconds": 4.98,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.26,
      "end_seconds": 101.75,
      "duration_seconds": 4.49,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 102.47,
      "end_seconds": 107.03,
      "duration_seconds": 4.56,
      "text": "Let me think, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.89,
      "end_seconds": 112.26,
      "duration_seconds": 3.37,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.92,
      "end_seconds": 117.05,
      "duration_seconds": 4.13,
      "text": "Yes, high cholesterol. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.77,
      "end_seconds": 123.47,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.09,
      "end_seconds": 140.02,
      "duration_seconds": 11.93,
      "text": "Hmm, I've had an enlarged prostate, yes. It's the not knowing that gets to me. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.6,
      "end_seconds": 151.62,
      "duration_seconds": 10.02,
      "text": "Okay, I can see high cholesterol and an enlarged prostate in your file as well. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.66,
      "end_seconds": 158.41,
      "duration_seconds": 5.75,
      "text": "Just a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.64,
      "end_seconds": 165.81,
      "duration_seconds": 3.17,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 167.24,
      "end_seconds": 170.34,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.18,
      "end_seconds": 176.98,
      "duration_seconds": 4.8,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.82,
      "end_seconds": 189.97,
      "duration_seconds": 11.15,
      "text": "Yes, amoxicillin, it gives me hives. Yes, nickel. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.68,
      "end_seconds": 194.23,
      "duration_seconds": 3.55,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.09,
      "end_seconds": 200.72,
      "duration_seconds": 5.63,
      "text": "I take rosuvastatin, 10 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 202.79,
      "end_seconds": 210.17,
      "duration_seconds": 7.38,
      "text": "That's what's prescribed, you know, but I'm not sure he takes it every day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.95,
      "end_seconds": 216.6,
      "duration_seconds": 4.65,
      "text": "It's tamsulosin, 0.4 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.54,
      "end_seconds": 225.02,
      "duration_seconds": 4.48,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.7,
      "end_seconds": 231.38,
      "duration_seconds": 5.68,
      "text": "Let me think, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.48,
      "end_seconds": 244.34,
      "duration_seconds": 5.86,
      "text": "Any difficulty swallowing, blood in the stool, coughing up blood or itching at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.22,
      "end_seconds": 253.56,
      "duration_seconds": 7.34,
      "text": "No difficulty swallowing, blood in the stool, coughing up blood or itching, none of it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.14,
      "end_seconds": 257.99,
      "duration_seconds": 3.85,
      "text": "Hm, okay. Any vomiting or bone pain at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.06,
      "end_seconds": 262.1,
      "duration_seconds": 3.04,
      "text": "Oh, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.75,
      "end_seconds": 264.74,
      "duration_seconds": 1.99,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.03,
      "end_seconds": 269.58,
      "duration_seconds": 3.55,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.48,
      "end_seconds": 273.91,
      "duration_seconds": 2.43,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.6,
      "end_seconds": 279.14,
      "duration_seconds": 3.54,
      "text": "Hmm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 280.18,
      "end_seconds": 287.88,
      "duration_seconds": 7.7,
      "text": "Here are the numbers, doctor. Heart rate 71, temperature 37.0, BP is 121 over 70, saturation 98 percent."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.79,
      "end_seconds": 289.73,
      "duration_seconds": 0.94,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.92,
      "end_seconds": 294.19,
      "duration_seconds": 2.27,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.87,
      "end_seconds": 306.87,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.84,
      "end_seconds": 309.21,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 323.48,
      "end_seconds": 328.13,
      "duration_seconds": 4.65,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.66,
      "end_seconds": 331.94,
      "duration_seconds": 2.28,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 349.65,
      "end_seconds": 354.86,
      "duration_seconds": 5.21,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.47,
      "end_seconds": 357.42,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 360.18,
      "end_seconds": 392.23,
      "duration_seconds": 32.05,
      "text": "Good, you can sit up again. Putting it all together, it points towards an unexplained weight loss that needs a proper work-up. That's my thinking for now, and it may change as we learn more. Another possibility is an overactive thyroid. I can't rule out a chronic infection yet. I'd like to arrange a chest X-ray for cough and weight loss. I'd like to arrange a thyroid test for weight loss."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.63,
      "end_seconds": 413.93,
      "duration_seconds": 20.3,
      "text": "I'd like to arrange blood tests for weight loss. Weigh yourself once a week at the same time and note it down. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 414.57,
      "end_seconds": 416.04,
      "duration_seconds": 1.47,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 417.97,
      "end_seconds": 424.0,
      "duration_seconds": 6.03,
      "text": "See me again after the results are back. Alright, does all of that make sense?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 425.38,
      "end_seconds": 429.37,
      "duration_seconds": 3.99,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}