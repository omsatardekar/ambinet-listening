{
  "schema_version": "1.0",
  "encounter_id": "01182",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 5.34,
      "duration_seconds": 3.96,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.32,
      "end_seconds": 10.61,
      "duration_seconds": 3.29,
      "text": "Well, good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.64,
      "end_seconds": 13.38,
      "duration_seconds": 1.74,
      "text": "Cold out there today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.84,
      "end_seconds": 22.65,
      "duration_seconds": 3.81,
      "text": "Freezing, I could hardly feel my hands."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.69,
      "end_seconds": 27.5,
      "duration_seconds": 2.81,
      "text": "so what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.68,
      "end_seconds": 32.98,
      "duration_seconds": 4.3,
      "text": "It's burning when I pass urine, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.16,
      "end_seconds": 36.65,
      "duration_seconds": 2.49,
      "text": "Alright, did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.58,
      "end_seconds": 54.37,
      "duration_seconds": 15.79,
      "text": "Let me think, you know, honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.38,
      "end_seconds": 57.28,
      "duration_seconds": 1.9,
      "text": "does anything help it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.84,
      "end_seconds": 66.99,
      "duration_seconds": 8.15,
      "text": "Sorry, uh, what was I saying, I get some relief from drinking water."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.47,
      "end_seconds": 70.46,
      "duration_seconds": 1.99,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 71.48,
      "end_seconds": 86.15,
      "duration_seconds": 14.67,
      "text": "A sudden urgent need to go goes along with it, you know, most of the time. Um, the sudden urgent need to go? That's been for two weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.2,
      "end_seconds": 93.79,
      "duration_seconds": 6.59,
      "text": "okay, have you had burning when you pass urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.68,
      "end_seconds": 101.87,
      "duration_seconds": 6.19,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.7,
      "end_seconds": 108.61,
      "duration_seconds": 4.91,
      "text": "let me check a few things any vomiting or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.66,
      "end_seconds": 113.48,
      "duration_seconds": 3.82,
      "text": "I haven't had vomiting or fever, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.23,
      "end_seconds": 117.72,
      "duration_seconds": 3.49,
      "text": "Okay, any loin pain or new partner?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.62,
      "end_seconds": 122.71,
      "duration_seconds": 4.09,
      "text": "uh, no, not a single one"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.93,
      "end_seconds": 127.41,
      "duration_seconds": 3.48,
      "text": "And blood in the urine, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.33,
      "end_seconds": 131.39,
      "duration_seconds": 3.06,
      "text": "No. No blood in the urine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.73,
      "end_seconds": 138.14,
      "duration_seconds": 2.41,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.24,
      "end_seconds": 140.32,
      "duration_seconds": 1.08,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.33,
      "end_seconds": 146.76,
      "duration_seconds": 4.43,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.65,
      "end_seconds": 151.76,
      "duration_seconds": 3.11,
      "text": "nothing unusual, you know, no"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.46,
      "end_seconds": 170.68,
      "duration_seconds": 5.22,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.16,
      "end_seconds": 187.59,
      "duration_seconds": 12.43,
      "text": "I drink a lot of tea and snack through the day. I swim twice a week. I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.14,
      "end_seconds": 190.95,
      "duration_seconds": 2.81,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.55,
      "end_seconds": 197.61,
      "duration_seconds": 6.06,
      "text": "Yeah, you know, I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.58,
      "end_seconds": 206.64,
      "duration_seconds": 7.06,
      "text": "okay, I can see diabetes in your file as well. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.2,
      "end_seconds": 212.29,
      "duration_seconds": 5.09,
      "text": "I, I take Glycomet, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.52,
      "end_seconds": 230.87,
      "duration_seconds": 2.35,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.36,
      "end_seconds": 242.46,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.06,
      "end_seconds": 263.88,
      "duration_seconds": 7.82,
      "text": "Okay: temp 36.5 degrees, pulse 83, BP is 126 over 72, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.63,
      "end_seconds": 267.58,
      "duration_seconds": 1.95,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.33,
      "end_seconds": 271.34,
      "duration_seconds": 2.01,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.77,
      "end_seconds": 296.02,
      "duration_seconds": 6.25,
      "text": "your tummy is soft with mild tenderness low down and no pain in the loins"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.42,
      "end_seconds": 314.47,
      "duration_seconds": 1.05,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.86,
      "end_seconds": 324.03,
      "duration_seconds": 7.17,
      "text": "That's the examination finished. Having listened and examined, the most likely explanation is a lower urinary tract infection."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 324.91,
      "end_seconds": 328.33,
      "duration_seconds": 3.42,
      "text": "I mean, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.05,
      "end_seconds": 361.97,
      "duration_seconds": 32.92,
      "text": "nothing I've seen today points to an emergency. It looks like a lower urinary tract infection, but I'd like to confirm. I'm sending you for a urine culture because of recurrent urinary infection. I'll start you on nitrofurantoin, 100 milligrams, twice a day, for three days. You take it by mouth. That should help with urinary infection. Drink plenty of water and don't hold on when you need to go"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.99,
      "end_seconds": 372.55,
      "duration_seconds": 8.56,
      "text": "I'd like to see you again after the culture result. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.31,
      "end_seconds": 375.68,
      "duration_seconds": 2.37,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 376.64,
      "end_seconds": 377.85,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}