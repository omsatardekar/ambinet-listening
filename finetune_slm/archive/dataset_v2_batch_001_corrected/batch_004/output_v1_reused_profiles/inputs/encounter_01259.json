{
  "schema_version": "1.0",
  "encounter_id": "01259",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 4.19,
      "duration_seconds": 3.61,
      "text": "morning doctor is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.99,
      "end_seconds": 10.14,
      "duration_seconds": 4.15,
      "text": "come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 22.51,
      "duration_seconds": 11.0,
      "text": "Uh um so the thing is I've got an itchy rash all over. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.45,
      "end_seconds": 26.71,
      "duration_seconds": 2.26,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.73,
      "end_seconds": 30.92,
      "duration_seconds": 3.19,
      "text": "ah ever since... since last Tuesday really"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.79,
      "end_seconds": 41.24,
      "duration_seconds": 8.45,
      "text": "Tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.5,
      "end_seconds": 53.45,
      "duration_seconds": 10.95,
      "text": "Moderate really. An antihistamine helps a a bit honestly a couple of times a week i'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.26,
      "end_seconds": 58.72,
      "duration_seconds": 4.46,
      "text": "what about swelling of your lips, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.01,
      "end_seconds": 62.91,
      "duration_seconds": 2.9,
      "text": "actually, yes, for two weeks"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.82,
      "end_seconds": 73.43,
      "duration_seconds": 8.61,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.0,
      "end_seconds": 89.65,
      "duration_seconds": 14.65,
      "text": "I mean, I'd say all the time. It's moderate, honestly. I've also had a tingling mouth, since last weekend. About tingling mouth, it's on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.89,
      "end_seconds": 93.37,
      "duration_seconds": 2.48,
      "text": "have you noticed wheeze or vomiting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.92,
      "end_seconds": 98.23,
      "duration_seconds": 3.31,
      "text": "so no not a single one"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.78,
      "end_seconds": 103.96,
      "duration_seconds": 4.18,
      "text": "so, have you noticed throat tightness, trouble breathing or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.67,
      "end_seconds": 111.24,
      "duration_seconds": 5.57,
      "text": "yeah, no throat tightness, trouble breathing or fainting, none of it"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.32,
      "end_seconds": 115.73,
      "duration_seconds": 2.41,
      "text": "So how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.07,
      "end_seconds": 119.65,
      "duration_seconds": 2.58,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.59,
      "end_seconds": 124.36,
      "duration_seconds": 2.77,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.48,
      "end_seconds": 129.53,
      "duration_seconds": 4.05,
      "text": "yes, asthma. Diabetes, for nearly five years"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.17,
      "end_seconds": 134.63,
      "duration_seconds": 3.46,
      "text": "alright asthma that matches what I have here"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 151.09,
      "duration_seconds": 2.37,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.62,
      "end_seconds": 161.29,
      "duration_seconds": 9.67,
      "text": "It's Asthalin inhaler, when needed for my asthma. It's Glycomet, 500 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.05,
      "end_seconds": 165.77,
      "duration_seconds": 2.72,
      "text": "Before we go further any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.39,
      "end_seconds": 174.23,
      "duration_seconds": 7.84,
      "text": "ah um years back I got wheezing from diclofenac so I stay away from it now"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.89,
      "end_seconds": 177.5,
      "duration_seconds": 2.61,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.44,
      "end_seconds": 189.14,
      "duration_seconds": 9.7,
      "text": "I'm a plumber, lots of bending and kneeling. I live with my elderly mother. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.05,
      "end_seconds": 192.25,
      "duration_seconds": 1.2,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.22,
      "end_seconds": 196.57,
      "duration_seconds": 2.35,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.97,
      "end_seconds": 218.51,
      "duration_seconds": 3.54,
      "text": "let me get the readings out of the way"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.37,
      "end_seconds": 234.44,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.77,
      "end_seconds": 259.75,
      "duration_seconds": 9.98,
      "text": "Okay: blood pressure 122 over 73 heart rate 76 SpO2 99 percent on room air weight 91 kilos height 186 centimetres."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.97,
      "end_seconds": 266.01,
      "duration_seconds": 4.04,
      "text": "alright, over here please and I'll take a look"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.08,
      "end_seconds": 269.47,
      "duration_seconds": 2.39,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.19,
      "end_seconds": 289.26,
      "duration_seconds": 10.07,
      "text": "there are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.32,
      "end_seconds": 296.11,
      "duration_seconds": 1.79,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.75,
      "end_seconds": 320.6,
      "duration_seconds": 9.85,
      "text": "I'd like you to take chlorphenamine, 4 milligrams, every six hours, for three days. You take it by mouth. That's for allergic rash."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.22,
      "end_seconds": 324.97,
      "duration_seconds": 3.75,
      "text": "should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.41,
      "end_seconds": 346.2,
      "duration_seconds": 19.79,
      "text": "Stop the the new tablet until we know what caused it and write down every medicine you took in the last week. Please don't wait if your throat tightens, your lips swell further or you get breathless. That's when to be seen urgently. Come back after the review."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.46,
      "end_seconds": 349.06,
      "duration_seconds": 1.6,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.31,
      "end_seconds": 353.73,
      "duration_seconds": 3.42,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.64,
      "end_seconds": 358.24,
      "duration_seconds": 3.6,
      "text": "thank you, you know, that's helpful"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.13,
      "end_seconds": 361.86,
      "duration_seconds": 1.73,
      "text": "all the the best"
    }
  ]
}