{
  "schema_version": "1.0",
  "encounter_id": "01052",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.28,
      "duration_seconds": 3.74,
      "text": "hello? Doctor? I was told to come in"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.07,
      "end_seconds": 9.51,
      "duration_seconds": 4.44,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.5,
      "end_seconds": 17.46,
      "duration_seconds": 5.96,
      "text": "So, doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 22.16,
      "duration_seconds": 2.96,
      "text": "Absolutely, come and and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.69,
      "end_seconds": 26.72,
      "duration_seconds": 4.03,
      "text": "Hmm, we came because of loud snoring."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.74,
      "end_seconds": 31.99,
      "duration_seconds": 3.25,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.16,
      "end_seconds": 44.31,
      "duration_seconds": 11.15,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.32,
      "end_seconds": 48.73,
      "duration_seconds": 2.41,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.57,
      "end_seconds": 60.3,
      "duration_seconds": 10.73,
      "text": "Yes, lying on my back. That makes it worse. Well, and I've been feeling sleepy during the day as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.78,
      "end_seconds": 83.06,
      "duration_seconds": 4.28,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.63,
      "end_seconds": 84.77,
      "duration_seconds": 1.14,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.69,
      "end_seconds": 94.39,
      "duration_seconds": 8.7,
      "text": "Okay, I can see diabetes in your file as well. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.19,
      "end_seconds": 98.44,
      "duration_seconds": 2.25,
      "text": "Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.15,
      "end_seconds": 101.29,
      "duration_seconds": 2.14,
      "text": "how much do you take?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.07,
      "end_seconds": 104.56,
      "duration_seconds": 1.49,
      "text": "it's 500 milligrams"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.47,
      "end_seconds": 116.88,
      "duration_seconds": 1.41,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.21,
      "end_seconds": 122.6,
      "duration_seconds": 4.39,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.41,
      "end_seconds": 128.32,
      "duration_seconds": 1.91,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.13,
      "end_seconds": 136.02,
      "duration_seconds": 5.89,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.66,
      "end_seconds": 140.07,
      "duration_seconds": 2.41,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.38,
      "end_seconds": 147.03,
      "duration_seconds": 5.65,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.93,
      "end_seconds": 150.97,
      "duration_seconds": 2.04,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.0,
      "end_seconds": 156.39,
      "duration_seconds": 4.39,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.95,
      "end_seconds": 160.69,
      "duration_seconds": 3.74,
      "text": "okay, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.93,
      "end_seconds": 165.82,
      "duration_seconds": 3.89,
      "text": "Let me think, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.77,
      "end_seconds": 184.1,
      "duration_seconds": 2.33,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.67,
      "end_seconds": 190.3,
      "duration_seconds": 4.63,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.96,
      "end_seconds": 196.92,
      "duration_seconds": 4.96,
      "text": "Let me check a few things. Any palpitations or choking at night?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.55,
      "end_seconds": 200.25,
      "duration_seconds": 2.7,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.66,
      "end_seconds": 203.43,
      "duration_seconds": 1.77,
      "text": "what about chest pain?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.74,
      "end_seconds": 206.86,
      "duration_seconds": 2.12,
      "text": "No. No chest pain."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.92,
      "end_seconds": 213.6,
      "duration_seconds": 4.68,
      "text": "have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.72,
      "end_seconds": 216.25,
      "duration_seconds": 1.53,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.08,
      "end_seconds": 220.67,
      "duration_seconds": 2.59,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.51,
      "end_seconds": 229.93,
      "duration_seconds": 2.42,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.0,
      "end_seconds": 259.58,
      "duration_seconds": 9.58,
      "text": "Okay: heart rate 86, respiratory rate 14, saturation 98 percent, temperature is 36.6 degrees, BP is 145 over 90."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.13,
      "end_seconds": 262.71,
      "duration_seconds": 1.58,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.69,
      "end_seconds": 266.47,
      "duration_seconds": 2.78,
      "text": "right, we'll go over that shortly"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.5,
      "end_seconds": 271.92,
      "duration_seconds": 4.42,
      "text": "I'll need to examine you for this, it won't take long"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.61,
      "end_seconds": 274.11,
      "duration_seconds": 1.5,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.02,
      "end_seconds": 276.34,
      "duration_seconds": 1.32,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.25,
      "end_seconds": 293.49,
      "duration_seconds": 5.24,
      "text": "Your neck is thick and the back of the throat looks crowded."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.08,
      "end_seconds": 323.46,
      "duration_seconds": 27.38,
      "text": "Okay, that's enough for me. Okay, thinking it through, I think we're dealing with symptoms that suggest obstructive sleep apnoea at this stage. The reason I say that is that your story and my examination fit together. Another possibility is an under-active thyroid. Let me just check I've got this right. You've had loud snoring, and no choking at night or chest pain."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.96,
      "end_seconds": 325.66,
      "duration_seconds": 0.7,
      "text": "correct"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.48,
      "end_seconds": 336.01,
      "duration_seconds": 8.53,
      "text": "I think a thyroid test makes sense here, for tiredness. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.31,
      "end_seconds": 340.12,
      "duration_seconds": 2.81,
      "text": "I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.81,
      "end_seconds": 342.15,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}