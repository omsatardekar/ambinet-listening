{
  "schema_version": "1.0",
  "encounter_id": "01101",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.93,
      "end_seconds": 3.34,
      "duration_seconds": 2.41,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.27,
      "end_seconds": 6.41,
      "duration_seconds": 1.14,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.41,
      "end_seconds": 14.82,
      "duration_seconds": 4.41,
      "text": "Good morning, doctor. I came along to to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.88,
      "end_seconds": 21.74,
      "duration_seconds": 5.86,
      "text": "Good, that'll be useful. Pull up a chair. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.29,
      "end_seconds": 28.83,
      "duration_seconds": 5.54,
      "text": "So the thing is, I've got burning when I pass urine."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.88,
      "end_seconds": 33.44,
      "duration_seconds": 3.56,
      "text": "Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.1,
      "end_seconds": 36.25,
      "duration_seconds": 2.15,
      "text": "about... well, three days"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.91,
      "end_seconds": 42.81,
      "duration_seconds": 4.9,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.56,
      "end_seconds": 45.79,
      "duration_seconds": 2.23,
      "text": "It comes and goes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.6,
      "end_seconds": 49.74,
      "duration_seconds": 2.14,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.78,
      "end_seconds": 75.56,
      "duration_seconds": 24.78,
      "text": "A dull ache above the pubic bone goes along with it, most of the time. The dull ache above the pubic bone? That's been for two days. I've also been needing to go all the time. I did have a sudden urgent need to go at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.65,
      "end_seconds": 79.61,
      "duration_seconds": 1.96,
      "text": "Any loin pain or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.5,
      "end_seconds": 85.81,
      "duration_seconds": 4.31,
      "text": "no loin pain or fever, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.44,
      "end_seconds": 92.64,
      "duration_seconds": 6.2,
      "text": "Let me check a few things. Any vomiting, blood in the urine or vaginal discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.27,
      "end_seconds": 100.25,
      "duration_seconds": 5.98,
      "text": "No vomiting, blood in the urine or vaginal discharge, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.29,
      "end_seconds": 105.05,
      "duration_seconds": 2.76,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.79,
      "end_seconds": 107.67,
      "duration_seconds": 1.88,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.71,
      "end_seconds": 114.69,
      "duration_seconds": 4.98,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.1,
      "end_seconds": 118.2,
      "duration_seconds": 2.1,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.71,
      "end_seconds": 122.52,
      "duration_seconds": 2.81,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.29,
      "end_seconds": 125.27,
      "duration_seconds": 1.98,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.81,
      "end_seconds": 129.83,
      "duration_seconds": 4.02,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.66,
      "end_seconds": 134.88,
      "duration_seconds": 4.22,
      "text": "no, um, nothing as far as I know"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.86,
      "end_seconds": 147.46,
      "duration_seconds": 1.6,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.72,
      "end_seconds": 150.41,
      "duration_seconds": 1.69,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.08,
      "end_seconds": 152.66,
      "duration_seconds": 1.58,
      "text": "who lives with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.7,
      "end_seconds": 157.01,
      "duration_seconds": 2.31,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.55,
      "end_seconds": 161.09,
      "duration_seconds": 2.54,
      "text": "so, do you do any exercise?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.91,
      "end_seconds": 164.23,
      "duration_seconds": 2.32,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.7,
      "end_seconds": 167.3,
      "duration_seconds": 1.6,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.79,
      "end_seconds": 172.69,
      "duration_seconds": 3.9,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.67,
      "end_seconds": 180.01,
      "duration_seconds": 6.34,
      "text": "Are you taking anything regularly, including from the pharmacy? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.61,
      "end_seconds": 185.4,
      "duration_seconds": 4.79,
      "text": "I'm on glibenclamide, 5 milligrams, before breakfast for my sugar"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 190.64,
      "end_seconds": 198.58,
      "duration_seconds": 7.94,
      "text": "It's meant to be before breakfast, though I don't see she take it every time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.09,
      "end_seconds": 206.78,
      "duration_seconds": 6.69,
      "text": "I'm on escitalopram, 10 milligrams, once a day. I take cranberry juice, every day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.46,
      "end_seconds": 210.92,
      "duration_seconds": 2.46,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.0,
      "end_seconds": 215.25,
      "duration_seconds": 3.25,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.03,
      "end_seconds": 223.19,
      "duration_seconds": 4.16,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.29,
      "end_seconds": 229.22,
      "duration_seconds": 3.93,
      "text": "I've had diabetes, yes i've had depression, yes"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.62,
      "end_seconds": 238.46,
      "duration_seconds": 7.84,
      "text": "Yes, depression is known to us, good to have that clear. Let me take your readings now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.38,
      "end_seconds": 249.19,
      "duration_seconds": 2.81,
      "text": "Okay, sit still for a moment..."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.8,
      "end_seconds": 271.5,
      "duration_seconds": 9.7,
      "text": "okay: BP is 110 over 80, respiratory rate 16. And SpO2 97 percent on room air, temp 36.7 degrees, heart rate 85."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.06,
      "end_seconds": 275.41,
      "duration_seconds": 2.35,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.29,
      "end_seconds": 281.14,
      "duration_seconds": 3.85,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.36,
      "end_seconds": 285.34,
      "duration_seconds": 1.98,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.03,
      "end_seconds": 296.78,
      "duration_seconds": 1.75,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.67,
      "end_seconds": 301.94,
      "duration_seconds": 3.27,
      "text": "right, I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.85,
      "end_seconds": 318.22,
      "duration_seconds": 6.37,
      "text": "Your tummy is soft with mild tenderness low down and no pain in the loins."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.7,
      "end_seconds": 321.05,
      "duration_seconds": 1.35,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.91,
      "end_seconds": 337.25,
      "duration_seconds": 10.34,
      "text": "Right, please sit back down. Taking everything into account, it points towards a lower urinary tract infection. Vaginal irritation is also on my list."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.83,
      "end_seconds": 342.8,
      "duration_seconds": 3.97,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.62,
      "end_seconds": 354.39,
      "duration_seconds": 9.77,
      "text": "It's reasonable to be concerned, but right now a lower urinary tract infection is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.53,
      "end_seconds": 372.58,
      "duration_seconds": 10.05,
      "text": "A urine test is what I'd like next, for dysuria. I'm sending you for a urine culture because of recurrent urinary infection"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 374.26,
      "end_seconds": 375.78,
      "duration_seconds": 1.52,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.77,
      "end_seconds": 401.01,
      "duration_seconds": 21.24,
      "text": "the treatment will be nitrofurantoin, 100 milligrams, twice a day, for three days that's for urinary infection drink plenty of water and don't hold on when you need to go one warning sign to remember: you get fever, loin pain or vomiting in that case don't wait"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 401.63,
      "end_seconds": 405.27,
      "duration_seconds": 3.64,
      "text": "hmm, I know what to watch for"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 407.05,
      "end_seconds": 413.64,
      "duration_seconds": 6.59,
      "text": "Book a review if it isn't better in three days. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.01,
      "end_seconds": 418.65,
      "duration_seconds": 3.64,
      "text": "no, that's all. Thanks a a lot"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.88,
      "end_seconds": 421.55,
      "duration_seconds": 1.67,
      "text": "All the the best."
    }
  ]
}