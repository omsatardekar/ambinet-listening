{
  "schema_version": "1.0",
  "encounter_id": "01083",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 5.32,
      "duration_seconds": 4.14,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.83,
      "end_seconds": 10.94,
      "duration_seconds": 4.11,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.87,
      "end_seconds": 25.27,
      "duration_seconds": 10.4,
      "text": "Doctor, it's sore, gritty eyes. It's getting on my nerves now. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 27.26,
      "end_seconds": 39.46,
      "duration_seconds": 12.2,
      "text": "Okay, so the vitals from earlier. Blood pressure 127 over 79, heart rate 83, temperature is 36.8 degrees, SpO2 97 percent on room air, respiratory rate 15."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.07,
      "end_seconds": 43.9,
      "duration_seconds": 3.83,
      "text": "Okay, noted. How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.27,
      "end_seconds": 48.08,
      "duration_seconds": 2.81,
      "text": "Probably nearly five years. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.28,
      "end_seconds": 52.53,
      "duration_seconds": 3.25,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.29,
      "end_seconds": 55.92,
      "duration_seconds": 2.63,
      "text": "Eye drops helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.3,
      "end_seconds": 60.05,
      "duration_seconds": 2.75,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.11,
      "end_seconds": 67.48,
      "duration_seconds": 6.37,
      "text": "It's moderate, honestly. I've also had watery eyes, for about three months."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.59,
      "end_seconds": 92.59,
      "duration_seconds": 7.0,
      "text": "A few quick ones: loss of vision, double vision, discharge or sensitivity to light?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.12,
      "end_seconds": 99.07,
      "duration_seconds": 5.95,
      "text": "No, no loss of vision, double vision, discharge or sensitivity to light."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.31,
      "end_seconds": 102.32,
      "duration_seconds": 3.01,
      "text": "Hm, okay. Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.26,
      "end_seconds": 106.12,
      "duration_seconds": 2.86,
      "text": "Nothing there, you know, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.35,
      "end_seconds": 112.86,
      "duration_seconds": 5.51,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.89,
      "end_seconds": 116.48,
      "duration_seconds": 2.59,
      "text": "Yeah, no weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.31,
      "end_seconds": 135.17,
      "duration_seconds": 0.86,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.94,
      "end_seconds": 140.7,
      "duration_seconds": 3.76,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.61,
      "end_seconds": 143.16,
      "duration_seconds": 1.55,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.31,
      "end_seconds": 147.51,
      "duration_seconds": 3.2,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.67,
      "end_seconds": 151.95,
      "duration_seconds": 3.28,
      "text": "So, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.7,
      "end_seconds": 156.56,
      "duration_seconds": 3.86,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.61,
      "end_seconds": 161.03,
      "duration_seconds": 2.42,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.12,
      "end_seconds": 167.15,
      "duration_seconds": 4.03,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.76,
      "end_seconds": 170.35,
      "duration_seconds": 2.59,
      "text": "So, any regular medication at all?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.59,
      "end_seconds": 172.63,
      "duration_seconds": 1.04,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.44,
      "end_seconds": 177.16,
      "duration_seconds": 3.72,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.16,
      "end_seconds": 180.95,
      "duration_seconds": 1.79,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.97,
      "end_seconds": 186.23,
      "duration_seconds": 3.26,
      "text": "Okay, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.49,
      "end_seconds": 190.96,
      "duration_seconds": 3.47,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.8,
      "end_seconds": 196.43,
      "duration_seconds": 3.63,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.61,
      "end_seconds": 200.97,
      "duration_seconds": 3.36,
      "text": "I've, I've never had an allergy."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.17,
      "end_seconds": 207.67,
      "duration_seconds": 4.5,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.22,
      "end_seconds": 209.92,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.03,
      "end_seconds": 213.8,
      "duration_seconds": 2.77,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.27,
      "end_seconds": 231.57,
      "duration_seconds": 7.3,
      "text": "The eyes are slightly red with no discharge and the front of the eye looks clear."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.1,
      "end_seconds": 239.24,
      "duration_seconds": 2.14,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.32,
      "end_seconds": 265.18,
      "duration_seconds": 10.86,
      "text": "Right, here's what I'm thinking. My working impression is dry eye syndrome. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.54,
      "end_seconds": 296.6,
      "duration_seconds": 13.06,
      "text": "Take a screen break every twenty minutes and try to blink fully. Let's plan a check in four weeks. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.26,
      "end_seconds": 302.9,
      "duration_seconds": 4.64,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.49,
      "end_seconds": 307.93,
      "duration_seconds": 4.44,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.69,
      "end_seconds": 312.01,
      "duration_seconds": 3.32,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}