{
  "schema_version": "1.0",
  "encounter_id": "01392",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 7.24,
      "duration_seconds": 6.4,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.98,
      "duration_seconds": 4.49,
      "text": "Alright, thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.66,
      "end_seconds": 21.62,
      "duration_seconds": 7.96,
      "text": "Honestly, it's excess hair on my face, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.12,
      "end_seconds": 26.53,
      "duration_seconds": 3.41,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.0,
      "end_seconds": 49.0,
      "duration_seconds": 21.0,
      "text": "Ah, I've had it for six months. A neighbour of mine said I should see someone about it. I, I was putting on weight around the middle at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.68,
      "end_seconds": 70.61,
      "duration_seconds": 7.93,
      "text": "Let me check a few things. Any trying for a baby, headaches with vision changes or milk from the breasts?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.8,
      "end_seconds": 74.67,
      "duration_seconds": 2.87,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.86,
      "end_seconds": 81.69,
      "duration_seconds": 5.83,
      "text": "Let me check a few things. Any pelvic pain or missed period?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.0,
      "end_seconds": 90.58,
      "duration_seconds": 2.58,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.15,
      "end_seconds": 93.5,
      "duration_seconds": 2.35,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 95.59,
      "end_seconds": 97.89,
      "duration_seconds": 2.3,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.27,
      "end_seconds": 100.71,
      "duration_seconds": 1.44,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.9,
      "end_seconds": 105.86,
      "duration_seconds": 3.96,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.78,
      "end_seconds": 109.63,
      "duration_seconds": 2.85,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.53,
      "end_seconds": 118.67,
      "duration_seconds": 4.14,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.95,
      "end_seconds": 121.74,
      "duration_seconds": 1.79,
      "text": "Right, are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.01,
      "end_seconds": 126.64,
      "duration_seconds": 3.63,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.71,
      "end_seconds": 133.44,
      "duration_seconds": 4.73,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.81,
      "end_seconds": 154.07,
      "duration_seconds": 19.26,
      "text": "Let me think, um, I'm on metformin, 500 milligrams, twice a day. Rosuvastatin. I take it 10 milligrams, at night for my cholesterol. Aspirin. I take it 75 milligrams, once a day for my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.14,
      "end_seconds": 159.17,
      "duration_seconds": 4.03,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.95,
      "end_seconds": 166.97,
      "duration_seconds": 6.02,
      "text": "Yeah, uh, I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.22,
      "end_seconds": 178.12,
      "duration_seconds": 3.9,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.55,
      "end_seconds": 184.03,
      "duration_seconds": 4.48,
      "text": "I, I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.43,
      "end_seconds": 188.26,
      "duration_seconds": 2.83,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.7,
      "end_seconds": 193.27,
      "duration_seconds": 3.57,
      "text": "High cholesterol, for nearly five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.16,
      "end_seconds": 196.21,
      "duration_seconds": 1.05,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 199.46,
      "end_seconds": 202.77,
      "duration_seconds": 3.31,
      "text": "Yeah, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.76,
      "end_seconds": 208.3,
      "duration_seconds": 3.54,
      "text": "Mm, okay. So, any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.46,
      "end_seconds": 214.37,
      "duration_seconds": 4.91,
      "text": "Yes, I had a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 215.14,
      "end_seconds": 226.1,
      "duration_seconds": 10.96,
      "text": "Okay, so the vitals from earlier. Heart rate 75, pressure 118 over 75. Oxygen saturation is 99 percent, respiratory rate 17, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.06,
      "end_seconds": 228.76,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.47,
      "end_seconds": 233.57,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.2,
      "end_seconds": 236.97,
      "duration_seconds": 1.77,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.77,
      "end_seconds": 254.14,
      "duration_seconds": 5.37,
      "text": "Facial acne along the jaw and some dark coarse hair on the chin."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.17,
      "end_seconds": 259.14,
      "duration_seconds": 1.97,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.2,
      "end_seconds": 282.68,
      "duration_seconds": 13.48,
      "text": "So, based on the history and the examination, the most likely explanation is possible polycystic ovary syndrome. It could also be raised prolactin, so we'll keep that open."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.8,
      "end_seconds": 287.31,
      "duration_seconds": 3.51,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.74,
      "end_seconds": 309.79,
      "duration_seconds": 21.05,
      "text": "I understand the worry. At the moment I'd say it's possible polycystic ovary syndrome, and we'll know more once the a thyroid test is back. We should do a thyroid test for irregular periods. I'm going to order hormone blood tests, for irregular periods."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.38,
      "end_seconds": 314.88,
      "duration_seconds": 3.5,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.92,
      "end_seconds": 322.86,
      "duration_seconds": 6.94,
      "text": "Regular exercise and modest weight loss can bring cycles back. I'll want another look in six weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 323.68,
      "end_seconds": 324.38,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.08,
      "end_seconds": 328.6,
      "duration_seconds": 3.52,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 329.95,
      "end_seconds": 333.49,
      "duration_seconds": 3.54,
      "text": "Thank you, uh, that's helpful."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.33,
      "end_seconds": 335.94,
      "duration_seconds": 1.61,
      "text": "Have a good day."
    }
  ]
}