{
  "schema_version": "1.0",
  "encounter_id": "01128",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.1,
      "end_seconds": 3.19,
      "duration_seconds": 2.09,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.44,
      "end_seconds": 10.68,
      "duration_seconds": 6.24,
      "text": "Right, hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.33,
      "end_seconds": 14.32,
      "duration_seconds": 1.99,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.49,
      "end_seconds": 27.13,
      "duration_seconds": 6.64,
      "text": "Yeah, you know, doctor, it's the room spinning. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.13,
      "end_seconds": 31.22,
      "duration_seconds": 3.09,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.15,
      "end_seconds": 36.55,
      "duration_seconds": 3.4,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.65,
      "end_seconds": 45.47,
      "duration_seconds": 7.82,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.51,
      "end_seconds": 53.39,
      "duration_seconds": 5.88,
      "text": "Mostly severe. Turning over in bed and looking up definitely sets it off."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.05,
      "end_seconds": 57.41,
      "duration_seconds": 3.36,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.8,
      "end_seconds": 62.17,
      "duration_seconds": 3.37,
      "text": "It's Vertin, 16 milligrams, when it comes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.48,
      "end_seconds": 73.34,
      "duration_seconds": 4.86,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.62,
      "end_seconds": 76.24,
      "duration_seconds": 1.62,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.23,
      "end_seconds": 78.4,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.35,
      "end_seconds": 83.22,
      "duration_seconds": 2.87,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.79,
      "end_seconds": 97.23,
      "duration_seconds": 2.44,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.29,
      "end_seconds": 102.57,
      "duration_seconds": 4.28,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.25,
      "end_seconds": 105.43,
      "duration_seconds": 1.18,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.22,
      "end_seconds": 109.56,
      "duration_seconds": 3.34,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.55,
      "end_seconds": 112.29,
      "duration_seconds": 1.74,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.06,
      "end_seconds": 119.81,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.79,
      "end_seconds": 131.59,
      "duration_seconds": 2.8,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.27,
      "end_seconds": 140.68,
      "duration_seconds": 8.41,
      "text": "Well, years back I got itching from trimethoprim, so I stay away from it now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.44,
      "end_seconds": 148.9,
      "duration_seconds": 7.46,
      "text": "Let me check a few things. Any weakness, numbness in the face or slurred speech?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.52,
      "end_seconds": 153.52,
      "duration_seconds": 4.0,
      "text": "No, you know, none that I've noticed."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.49,
      "end_seconds": 157.63,
      "duration_seconds": 2.14,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.2,
      "end_seconds": 160.2,
      "duration_seconds": 2.0,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.03,
      "end_seconds": 163.14,
      "duration_seconds": 2.11,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.89,
      "end_seconds": 168.21,
      "duration_seconds": 4.32,
      "text": "Yeah, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.8,
      "end_seconds": 187.96,
      "duration_seconds": 3.16,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.26,
      "end_seconds": 202.29,
      "duration_seconds": 2.03,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.37,
      "end_seconds": 218.89,
      "duration_seconds": 5.52,
      "text": "Okay: saturation 97 percent, temperature 36.9, pressure 122 over 76, pulse 68."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.71,
      "end_seconds": 224.18,
      "duration_seconds": 2.47,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 225.86,
      "end_seconds": 228.4,
      "duration_seconds": 2.54,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.11,
      "end_seconds": 232.5,
      "duration_seconds": 2.39,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.73,
      "end_seconds": 246.08,
      "duration_seconds": 4.35,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 250.21,
      "end_seconds": 251.89,
      "duration_seconds": 1.68,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.03,
      "end_seconds": 254.42,
      "duration_seconds": 1.39,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.05,
      "end_seconds": 277.9,
      "duration_seconds": 6.85,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.04,
      "end_seconds": 289.39,
      "duration_seconds": 8.35,
      "text": "Thank you, you can get dressed. Let me tell you where I've got to. This is probably benign positional vertigo."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.01,
      "end_seconds": 308.29,
      "duration_seconds": 4.28,
      "text": "Let's book a hearing test to look into tinnitus and vertigo."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 313.14,
      "end_seconds": 316.38,
      "duration_seconds": 3.24,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.02,
      "end_seconds": 333.96,
      "duration_seconds": 15.94,
      "text": "Get up slowly from lying down and sit for a moment first. There's a simple head manoeuvre we can do, and I'll show you how to repeat it at home. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.68,
      "end_seconds": 339.25,
      "duration_seconds": 4.57,
      "text": "No, you know, that's all. Thanks a lot."
    }
  ]
}