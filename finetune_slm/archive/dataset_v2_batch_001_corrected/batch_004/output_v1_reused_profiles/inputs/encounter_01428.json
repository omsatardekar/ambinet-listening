{
  "schema_version": "1.0",
  "encounter_id": "01428",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 5.22,
      "duration_seconds": 4.59,
      "text": "Ah, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.18,
      "end_seconds": 10.64,
      "duration_seconds": 4.46,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.93,
      "end_seconds": 14.56,
      "duration_seconds": 2.63,
      "text": "Well, I've been having wheezing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.61,
      "end_seconds": 21.85,
      "duration_seconds": 4.24,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.51,
      "end_seconds": 26.34,
      "duration_seconds": 3.83,
      "text": "I'm, I'm on Asthalin inhaler, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.92,
      "end_seconds": 39.91,
      "duration_seconds": 2.99,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.62,
      "end_seconds": 44.55,
      "duration_seconds": 3.93,
      "text": "Since last weekend, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.16,
      "end_seconds": 56.48,
      "duration_seconds": 10.32,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.2,
      "end_seconds": 69.24,
      "duration_seconds": 12.04,
      "text": "Moderate, really. Yes, cold air. That That makes it worse. The inhaler helps a bit. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.19,
      "end_seconds": 76.16,
      "duration_seconds": 4.97,
      "text": "Have you noticed coughing up phlegm, chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.58,
      "end_seconds": 79.96,
      "duration_seconds": 2.38,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.69,
      "end_seconds": 85.34,
      "duration_seconds": 3.65,
      "text": "Okay, and runny nose, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.12,
      "end_seconds": 92.65,
      "duration_seconds": 3.53,
      "text": "Not that I've noticed, no runny nose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.08,
      "end_seconds": 96.58,
      "duration_seconds": 2.5,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.47,
      "end_seconds": 99.77,
      "duration_seconds": 2.3,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.86,
      "end_seconds": 105.55,
      "duration_seconds": 3.69,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.18,
      "end_seconds": 108.29,
      "duration_seconds": 2.11,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.42,
      "end_seconds": 122.84,
      "duration_seconds": 2.42,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.45,
      "end_seconds": 127.21,
      "duration_seconds": 3.76,
      "text": "I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.12,
      "end_seconds": 134.45,
      "duration_seconds": 5.33,
      "text": "Understood. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.68,
      "end_seconds": 146.21,
      "duration_seconds": 10.53,
      "text": "I swim twice a week. I live with my elderly mother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.22,
      "end_seconds": 161.48,
      "duration_seconds": 5.26,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.3,
      "end_seconds": 166.56,
      "duration_seconds": 3.26,
      "text": "I'm allergic to walnuts, I get hives."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.8,
      "end_seconds": 177.94,
      "duration_seconds": 4.14,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.19,
      "end_seconds": 191.67,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.24,
      "end_seconds": 209.71,
      "duration_seconds": 8.47,
      "text": "Okay: respiratory rate 25, pulse is 88 beats a minute. And saturation 94 percent, blood pressure 139 over 80."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.23,
      "end_seconds": 211.61,
      "duration_seconds": 1.38,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.85,
      "end_seconds": 215.64,
      "duration_seconds": 2.79,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.61,
      "end_seconds": 222.51,
      "duration_seconds": 3.9,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.1,
      "end_seconds": 226.94,
      "duration_seconds": 2.84,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.92,
      "end_seconds": 244.27,
      "duration_seconds": 5.35,
      "text": "I can hear a widespread wheeze on both sides when you breathe out."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.81,
      "end_seconds": 246.51,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.88,
      "end_seconds": 249.13,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.5,
      "end_seconds": 269.41,
      "duration_seconds": 3.91,
      "text": "you're speaking in full sentences, which is reassuring"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.76,
      "end_seconds": 296.46,
      "duration_seconds": 23.7,
      "text": "Good, you can sit up again. Okay, so my impression is this: I don't have a clear answer today: an asthma flare-up is possible, and so is a chest infection. I want breathing tests done, that's for asthma. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 297.34,
      "end_seconds": 300.52,
      "duration_seconds": 3.18,
      "text": "The earliest is Tuesday, 3:30 pm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.86,
      "end_seconds": 303.94,
      "duration_seconds": 2.08,
      "text": "Okay, I'll be there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.85,
      "end_seconds": 325.72,
      "duration_seconds": 16.87,
      "text": "You'll be taking prednisolone, 30 milligrams, once a day, for five days. You take it by mouth. That should help with asthma flare-up. Rinse your mouth after the steroid inhaler. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.03,
      "end_seconds": 330.16,
      "duration_seconds": 3.13,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}