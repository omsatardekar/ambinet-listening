{
  "schema_version": "1.0",
  "encounter_id": "01144",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 6.97,
      "duration_seconds": 5.79,
      "text": "Well, uh, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.39,
      "end_seconds": 13.21,
      "duration_seconds": 4.82,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.86,
      "end_seconds": 28.07,
      "duration_seconds": 14.21,
      "text": "Yeah, it's rumbling and gas. I don't know what's causing it. I'm not great at remembering details, so bear with me. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.21,
      "end_seconds": 32.87,
      "duration_seconds": 3.66,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.99,
      "end_seconds": 38.59,
      "duration_seconds": 2.6,
      "text": "I've had it since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.07,
      "end_seconds": 43.08,
      "duration_seconds": 4.01,
      "text": "Sure. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.81,
      "end_seconds": 46.33,
      "duration_seconds": 1.52,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.38,
      "end_seconds": 49.36,
      "duration_seconds": 1.98,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.58,
      "end_seconds": 57.49,
      "duration_seconds": 6.91,
      "text": "When it starts I tend to get loose stools after dairy as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.06,
      "end_seconds": 64.22,
      "duration_seconds": 6.16,
      "text": "Hm, okay. Let me check a few things. Any vomiting, rash or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.62,
      "end_seconds": 69.64,
      "duration_seconds": 4.02,
      "text": "I haven't had vomiting, rash or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.6,
      "end_seconds": 74.01,
      "duration_seconds": 3.41,
      "text": "Has there been any blood in the stool?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.37,
      "end_seconds": 79.51,
      "duration_seconds": 4.14,
      "text": "No, I haven't had any blood in the stool."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.62,
      "end_seconds": 84.13,
      "duration_seconds": 3.51,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.96,
      "end_seconds": 87.83,
      "duration_seconds": 2.87,
      "text": "Well, no, that's all normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.86,
      "end_seconds": 91.2,
      "duration_seconds": 2.34,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.2,
      "end_seconds": 96.44,
      "duration_seconds": 3.24,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.77,
      "end_seconds": 111.34,
      "duration_seconds": 3.57,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.82,
      "end_seconds": 115.11,
      "duration_seconds": 2.29,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.42,
      "end_seconds": 127.26,
      "duration_seconds": 2.84,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.94,
      "end_seconds": 132.42,
      "duration_seconds": 3.48,
      "text": "I mean, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.91,
      "end_seconds": 135.82,
      "duration_seconds": 1.91,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.06,
      "end_seconds": 141.79,
      "duration_seconds": 2.73,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.8,
      "end_seconds": 145.23,
      "duration_seconds": 2.43,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.74,
      "end_seconds": 151.61,
      "duration_seconds": 5.87,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.29,
      "end_seconds": 158.63,
      "duration_seconds": 5.34,
      "text": "So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.8,
      "end_seconds": 163.15,
      "duration_seconds": 3.35,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.69,
      "end_seconds": 180.9,
      "duration_seconds": 4.21,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.26,
      "end_seconds": 194.27,
      "duration_seconds": 2.01,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.8,
      "end_seconds": 212.79,
      "duration_seconds": 5.99,
      "text": "Okay: temp 36.4 degrees, heart rate 85, BP is 111 over 71."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.45,
      "end_seconds": 214.88,
      "duration_seconds": 1.43,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.66,
      "end_seconds": 219.73,
      "duration_seconds": 3.07,
      "text": "Alright, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.74,
      "end_seconds": 224.58,
      "duration_seconds": 3.84,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.41,
      "end_seconds": 226.44,
      "duration_seconds": 1.03,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.96,
      "end_seconds": 230.58,
      "duration_seconds": 2.62,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.77,
      "end_seconds": 252.41,
      "duration_seconds": 4.64,
      "text": "Your tummy is soft and non-tender, with active bowel sounds."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.83,
      "end_seconds": 256.47,
      "duration_seconds": 1.64,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.69,
      "end_seconds": 279.64,
      "duration_seconds": 9.95,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be lactose intolerance, or it might be coeliac disease."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.6,
      "end_seconds": 283.54,
      "duration_seconds": 1.94,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.77,
      "end_seconds": 302.69,
      "duration_seconds": 17.92,
      "text": "I understand the worry. At the moment I'd say it's lactose intolerance, and we'll know more once the a coeliac test is back. Let me just check I've got this right. You've had rumbling and gas, since Monday, mild, and no rash or fever."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.12,
      "end_seconds": 304.82,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.6,
      "end_seconds": 309.96,
      "duration_seconds": 4.36,
      "text": "I'm going to order a coeliac test, for bloating."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 312.05,
      "end_seconds": 315.69,
      "duration_seconds": 3.64,
      "text": "I can book that for Tuesday at 10 am."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.7,
      "end_seconds": 323.45,
      "duration_seconds": 5.75,
      "text": "Try two weeks without dairy and tell me if it makes a difference."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.89,
      "end_seconds": 338.03,
      "duration_seconds": 14.14,
      "text": "Mm, okay. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'll want another look in three weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.8,
      "end_seconds": 343.46,
      "duration_seconds": 4.66,
      "text": "Let me think, great, thank you for your help."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.97,
      "end_seconds": 345.16,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}