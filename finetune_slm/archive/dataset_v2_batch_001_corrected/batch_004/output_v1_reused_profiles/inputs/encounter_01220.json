{
  "schema_version": "1.0",
  "encounter_id": "01220",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 4.0,
      "duration_seconds": 3.37,
      "text": "hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.5,
      "end_seconds": 10.1,
      "duration_seconds": 5.6,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.42,
      "end_seconds": 15.68,
      "duration_seconds": 4.26,
      "text": "I'm here because of pain after standing at work."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.68,
      "end_seconds": 20.5,
      "duration_seconds": 2.82,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.75,
      "end_seconds": 25.63,
      "duration_seconds": 3.88,
      "text": "no, you know, nothing at the moment"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.57,
      "end_seconds": 30.72,
      "duration_seconds": 3.15,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.76,
      "end_seconds": 37.03,
      "duration_seconds": 5.27,
      "text": "Three weeks, I think... sorry, one week, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.6,
      "end_seconds": 52.13,
      "duration_seconds": 9.53,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.39,
      "end_seconds": 61.33,
      "duration_seconds": 4.94,
      "text": "I notice it more with standing. It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.18,
      "end_seconds": 64.29,
      "duration_seconds": 2.11,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.23,
      "end_seconds": 79.05,
      "duration_seconds": 13.82,
      "text": "Hmm, when it starts I tend to get a tender spot on the sole as well. The tender spot on the sole? That's been for two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.34,
      "end_seconds": 99.55,
      "duration_seconds": 5.21,
      "text": "And what about fever, recent injury or pain in other joints?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.08,
      "end_seconds": 108.24,
      "duration_seconds": 3.16,
      "text": "None of those, you know, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.08,
      "end_seconds": 112.8,
      "duration_seconds": 2.72,
      "text": "and your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.29,
      "end_seconds": 116.24,
      "duration_seconds": 0.95,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.2,
      "end_seconds": 120.89,
      "duration_seconds": 3.69,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.78,
      "end_seconds": 124.7,
      "duration_seconds": 1.92,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.59,
      "end_seconds": 126.79,
      "duration_seconds": 1.2,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.57,
      "end_seconds": 136.9,
      "duration_seconds": 4.33,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.72,
      "end_seconds": 140.32,
      "duration_seconds": 2.6,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.92,
      "end_seconds": 145.47,
      "duration_seconds": 3.55,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.96,
      "end_seconds": 152.26,
      "duration_seconds": 2.3,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.41,
      "end_seconds": 155.65,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.88,
      "end_seconds": 158.8,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.42,
      "end_seconds": 163.32,
      "duration_seconds": 3.9,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.3,
      "end_seconds": 169.66,
      "duration_seconds": 4.36,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.4,
      "end_seconds": 172.83,
      "duration_seconds": 1.43,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.55,
      "end_seconds": 177.49,
      "duration_seconds": 2.94,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 188.0,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.76,
      "end_seconds": 206.8,
      "duration_seconds": 9.04,
      "text": "Okay: pulse is 84 beats a minute, saturation 99 percent, BP is 111 over 82. And temperature 36.7, respiratory rate 14."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.62,
      "end_seconds": 212.97,
      "duration_seconds": 4.35,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.9,
      "end_seconds": 216.17,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.36,
      "end_seconds": 238.12,
      "duration_seconds": 3.76,
      "text": "Pressing on the inner heel brings on the pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.09,
      "end_seconds": 241.91,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.58,
      "end_seconds": 257.31,
      "duration_seconds": 2.73,
      "text": "The ankle and foot move fully."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.8,
      "end_seconds": 263.52,
      "duration_seconds": 2.72,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.92,
      "end_seconds": 277.94,
      "duration_seconds": 5.02,
      "text": "Taking everything into account, the most likely explanation is plantar fasciitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.34,
      "end_seconds": 315.09,
      "duration_seconds": 23.75,
      "text": "An X-ray of the foot is what I'd like next, for heel pain. Roll the sole over a bottle and stretch the calf against a wall twice a day. I'll also refer you to physiotherapy. Come back in six weeks. Okay, can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.1,
      "end_seconds": 323.15,
      "duration_seconds": 6.05,
      "text": "So, you know, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.44,
      "end_seconds": 328.06,
      "duration_seconds": 3.62,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.4,
      "end_seconds": 331.69,
      "duration_seconds": 2.29,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.29,
      "end_seconds": 334.61,
      "duration_seconds": 1.32,
      "text": "All the best."
    }
  ]
}