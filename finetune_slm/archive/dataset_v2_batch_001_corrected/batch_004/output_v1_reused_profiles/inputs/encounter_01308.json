{
  "schema_version": "1.0",
  "encounter_id": "01308",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.02,
      "duration_seconds": 3.2,
      "text": "morning doctor. Lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.94,
      "end_seconds": 11.12,
      "duration_seconds": 5.18,
      "text": "right you're alright take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.45,
      "end_seconds": 19.25,
      "duration_seconds": 6.8,
      "text": "so, um, morning, doctor i'll stay and fill in anything that's missed"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.17,
      "end_seconds": 25.94,
      "duration_seconds": 4.77,
      "text": "okay, that's fine, sit down. We'll go through it it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.94,
      "end_seconds": 32.29,
      "duration_seconds": 5.35,
      "text": "we came because of some chest discomfort when I climb stairs"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.89,
      "end_seconds": 34.68,
      "duration_seconds": 1.79,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.62,
      "end_seconds": 43.09,
      "duration_seconds": 7.47,
      "text": "Well, uh, around nearly five years... no wait, it's more like two years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.04,
      "end_seconds": 57.39,
      "duration_seconds": 8.35,
      "text": "Tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.99,
      "end_seconds": 63.74,
      "duration_seconds": 4.75,
      "text": "I I notice it more with stairs. Mostly moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.84,
      "end_seconds": 67.0,
      "duration_seconds": 2.16,
      "text": "Have you been feeling tired?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.06,
      "end_seconds": 76.19,
      "duration_seconds": 8.13,
      "text": "Yes, I have. And there's nose bleeds as well, you know, four weeks now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.02,
      "end_seconds": 95.94,
      "duration_seconds": 3.92,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.24,
      "end_seconds": 102.04,
      "duration_seconds": 4.8,
      "text": "my sister had breast cancer my brother has epilepsy"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.6,
      "end_seconds": 108.39,
      "duration_seconds": 4.79,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.19,
      "end_seconds": 124.02,
      "duration_seconds": 13.83,
      "text": "I mean, I've got high cholesterol. It's a relief to finally sit down and talk about it. I've had heart disease for about ten years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.52,
      "end_seconds": 138.71,
      "duration_seconds": 9.19,
      "text": "Okay, I can see high cholesterol and heart disease in your file as well. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.28,
      "end_seconds": 150.51,
      "duration_seconds": 10.23,
      "text": "I think I reacted to to some antibiotic once years ago i don't remember which one or what happened exactly"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.81,
      "end_seconds": 154.64,
      "duration_seconds": 2.83,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.32,
      "end_seconds": 159.62,
      "duration_seconds": 3.3,
      "text": "I live with my elderly mother"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.99,
      "end_seconds": 163.84,
      "duration_seconds": 2.85,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.03,
      "end_seconds": 169.06,
      "duration_seconds": 4.03,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.54,
      "end_seconds": 173.25,
      "duration_seconds": 2.71,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.83,
      "end_seconds": 179.41,
      "duration_seconds": 4.58,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.77,
      "end_seconds": 198.2,
      "duration_seconds": 3.43,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.91,
      "end_seconds": 204.62,
      "duration_seconds": 5.71,
      "text": "uh, it's atorvastatin, 20 milligrams, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 206.29,
      "end_seconds": 216.8,
      "duration_seconds": 10.51,
      "text": "doctor I think the last prescription for the atorvastatin was 10 milligrams we changed it at the last visit"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.23,
      "end_seconds": 222.63,
      "duration_seconds": 4.4,
      "text": "Hm, that's different. Is the latest prescription anywhere near you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.94,
      "end_seconds": 236.21,
      "duration_seconds": 12.27,
      "text": "not with me. I'll bring it next time. I mean, um, I take metoprolol, 50 milligrams, maybe, twice a day for my heart"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.76,
      "end_seconds": 241.57,
      "duration_seconds": 4.81,
      "text": "so did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.23,
      "end_seconds": 244.3,
      "duration_seconds": 2.07,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.96,
      "end_seconds": 249.3,
      "duration_seconds": 3.34,
      "text": "alright, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.07,
      "end_seconds": 257.8,
      "duration_seconds": 6.73,
      "text": "right, I had a mole taken off my arm a few years ago"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.87,
      "end_seconds": 261.39,
      "duration_seconds": 2.52,
      "text": "Have you noticed breathlessness or palpitations?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.51,
      "end_seconds": 269.84,
      "duration_seconds": 4.33,
      "text": "Yeah, no breathlessness or palpitations, none of it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.69,
      "end_seconds": 278.26,
      "duration_seconds": 6.57,
      "text": "have you noticed fainting pain at rest black stools or blood in the urine?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.81,
      "end_seconds": 282.55,
      "duration_seconds": 3.74,
      "text": "no, none of those at all"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.21,
      "end_seconds": 285.95,
      "duration_seconds": 2.74,
      "text": "so, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.58,
      "end_seconds": 289.09,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.46,
      "end_seconds": 292.91,
      "duration_seconds": 2.45,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.58,
      "end_seconds": 296.91,
      "duration_seconds": 2.33,
      "text": "No all normal there."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.9,
      "end_seconds": 301.0,
      "duration_seconds": 3.1,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.33,
      "end_seconds": 315.28,
      "duration_seconds": 2.95,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.46,
      "end_seconds": 336.64,
      "duration_seconds": 5.18,
      "text": "okay: BP is 127 over 75, pulse is 74 beats a minute"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.46,
      "end_seconds": 340.94,
      "duration_seconds": 2.48,
      "text": "shall I start the the examination?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.86,
      "end_seconds": 343.49,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.71,
      "end_seconds": 364.91,
      "duration_seconds": 4.2,
      "text": "there are a few small bruises on your forearms"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.89,
      "end_seconds": 368.93,
      "duration_seconds": 2.04,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.87,
      "end_seconds": 380.91,
      "duration_seconds": 4.04,
      "text": "Heart sounds are normal and your chest is clear"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.21,
      "end_seconds": 385.86,
      "duration_seconds": 2.65,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.32,
      "end_seconds": 416.34,
      "duration_seconds": 17.02,
      "text": "Let me tell you where I've got to. It points towards stable coronary disease on antiplatelet treatment, with minor bleeding. That's my thinking for now and it may change as we learn more. We shouldn't forget reflux from the tablets."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.33,
      "end_seconds": 419.77,
      "duration_seconds": 2.44,
      "text": "Mm is it dangerous doctor?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.81,
      "end_seconds": 447.48,
      "duration_seconds": 26.67,
      "text": "nothing I've seen today points to an emergency it looks like stable coronary disease on antiplatelet treatment, with minor bleeding and please bring the latest prescription or the medicine boxes to the next visit so we can settle the dose for now no new medicines or tests are needed have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 448.08,
      "end_seconds": 452.88,
      "duration_seconds": 4.8,
      "text": "Right uh I'll do that. Thank you doctor."
    }
  ]
}