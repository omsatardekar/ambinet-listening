{
  "schema_version": "1.0",
  "encounter_id": "01058",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.52,
      "end_seconds": 3.46,
      "duration_seconds": 2.94,
      "text": "Good afternoon, um, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.4,
      "end_seconds": 8.38,
      "duration_seconds": 3.98,
      "text": "no problem at all, come in what's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.42,
      "end_seconds": 18.35,
      "duration_seconds": 8.93,
      "text": "Honestly, uh, it's a dry cough at night, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.11,
      "end_seconds": 27.67,
      "duration_seconds": 8.56,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.51,
      "end_seconds": 48.04,
      "duration_seconds": 19.53,
      "text": "I'd say every other day. I notice it more with laughing. I'd give it a seven, you know, out of ten. And I've been coughing after exercise as well, for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.89,
      "end_seconds": 54.11,
      "duration_seconds": 4.22,
      "text": "Has there been a runny nose in the mornings too?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.13,
      "end_seconds": 68.24,
      "duration_seconds": 12.11,
      "text": "Yes, actually. Oh, I've also had a mild wheeze at times, for six months. About mild wheeze at times, honestly, on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.23,
      "end_seconds": 86.54,
      "duration_seconds": 3.31,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.78,
      "end_seconds": 93.28,
      "duration_seconds": 3.5,
      "text": "Uh, my mother had a stroke."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.88,
      "end_seconds": 95.72,
      "duration_seconds": 1.84,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.99,
      "end_seconds": 100.53,
      "duration_seconds": 3.54,
      "text": "I only drink at family occasions"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.48,
      "end_seconds": 103.82,
      "duration_seconds": 1.34,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.51,
      "end_seconds": 108.39,
      "duration_seconds": 3.88,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.46,
      "end_seconds": 112.31,
      "duration_seconds": 1.85,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.84,
      "end_seconds": 117.97,
      "duration_seconds": 4.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.74,
      "end_seconds": 121.34,
      "duration_seconds": 2.6,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.06,
      "end_seconds": 131.82,
      "duration_seconds": 4.76,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.48,
      "end_seconds": 134.47,
      "duration_seconds": 1.99,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.26,
      "end_seconds": 140.34,
      "duration_seconds": 4.08,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.55,
      "end_seconds": 155.8,
      "duration_seconds": 7.25,
      "text": "do you take any prescribed or over-the-counter medicines? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.35,
      "end_seconds": 165.35,
      "duration_seconds": 8.0,
      "text": "Hydrocortisone cream, when needed it's, It's levetiracetam, 500 milligrams, maybe, twice a day"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.2,
      "end_seconds": 170.18,
      "duration_seconds": 2.98,
      "text": "is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.37,
      "end_seconds": 185.31,
      "duration_seconds": 9.94,
      "text": "Actually, you know, not with me. I'll bring it next time. Iron tablets, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.98,
      "end_seconds": 188.61,
      "duration_seconds": 1.63,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.52,
      "end_seconds": 198.59,
      "duration_seconds": 8.07,
      "text": "About about a month. I had lamotrigine at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.01,
      "end_seconds": 203.34,
      "duration_seconds": 3.33,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.37,
      "end_seconds": 219.68,
      "duration_seconds": 14.31,
      "text": "Yes, eczema. Yes, epilepsy. Okay, so I've had low haemoglobin for about ten years now. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.46,
      "end_seconds": 229.07,
      "duration_seconds": 8.61,
      "text": "Yes, eczema and epilepsy are known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.6,
      "end_seconds": 244.85,
      "duration_seconds": 14.25,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.09,
      "end_seconds": 259.95,
      "duration_seconds": 2.86,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.92,
      "end_seconds": 269.82,
      "duration_seconds": 7.9,
      "text": "Uh, just a a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.99,
      "end_seconds": 274.36,
      "duration_seconds": 3.37,
      "text": "Have you noticed heartburn or weight loss?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.95,
      "end_seconds": 282.97,
      "duration_seconds": 7.02,
      "text": "sorry, what was I saying, I haven't had heartburn or weight loss, no"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.71,
      "end_seconds": 287.2,
      "duration_seconds": 3.49,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.43,
      "end_seconds": 290.9,
      "duration_seconds": 2.47,
      "text": "I move fine otherwise"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.78,
      "end_seconds": 293.75,
      "duration_seconds": 1.97,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.59,
      "end_seconds": 297.28,
      "duration_seconds": 1.69,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.27,
      "end_seconds": 301.43,
      "duration_seconds": 3.16,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.84,
      "end_seconds": 315.57,
      "duration_seconds": 2.73,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.56,
      "end_seconds": 345.58,
      "duration_seconds": 15.02,
      "text": "Okay: temp 36.8 degrees, weight 88 kilos, pulse 78, height 181 centimetres, blood pressure 120 over 80, SpO2 99 percent on room air, BMI works out to 26.9, respiratory rate 18."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.74,
      "end_seconds": 353.2,
      "duration_seconds": 5.46,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.93,
      "end_seconds": 357.81,
      "duration_seconds": 2.88,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.31,
      "end_seconds": 360.54,
      "duration_seconds": 1.23,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.96,
      "end_seconds": 382.54,
      "duration_seconds": 3.58,
      "text": "A faint wheeze when you breathe out forcefully."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.24,
      "end_seconds": 414.4,
      "duration_seconds": 29.16,
      "text": "Okay, that's enough for me. Let me tell you where I've got to. I think we're dealing with cough-variant asthma at this stage. Reflux-related cough is also on my list. I'm sending you for breathing tests because of chronic cough. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.17,
      "end_seconds": 419.05,
      "duration_seconds": 3.88,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 422.06,
      "end_seconds": 423.29,
      "duration_seconds": 1.23,
      "text": "goodbye for now"
    }
  ]
}