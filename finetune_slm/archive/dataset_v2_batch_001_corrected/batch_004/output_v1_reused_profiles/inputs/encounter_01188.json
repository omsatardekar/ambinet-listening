  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 4.46,
      "duration_seconds": 3.36,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.38,
      "end_seconds": 9.59,
      "duration_seconds": 4.21,
      "text": "not at all, please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.32,
      "end_seconds": 19.2,
      "duration_seconds": 7.88,
      "text": "it's a painful band of blisters on the left side of my chest, mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.79,
      "end_seconds": 23.66,
      "duration_seconds": 2.87,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.03,
      "end_seconds": 27.71,
      "duration_seconds": 2.68,
      "text": "I've had it for two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.3,
      "end_seconds": 34.63,
      "duration_seconds": 6.33,
      "text": "Right, right. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.09,
      "end_seconds": 42.0,
      "duration_seconds": 5.91,
      "text": "Only cool cloths, and it's not much. It's worse with clothing rubbing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.51,
      "end_seconds": 46.65,
      "duration_seconds": 4.14,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.89,
      "end_seconds": 61.16,
      "duration_seconds": 2.27,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.83,
      "end_seconds": 81.22,
      "duration_seconds": 9.39,
      "text": "Okay: oxygen saturation is 98 percent, temperature is 36.5 degrees, pulse 85, pressure 121 over 76, respiratory rate 18."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.72,
      "end_seconds": 84.83,
      "duration_seconds": 2.11,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.73,
      "end_seconds": 88.53,
      "duration_seconds": 2.8,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.37,
      "end_seconds": 95.01,
      "duration_seconds": 3.64,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.58,
      "end_seconds": 96.66,
      "duration_seconds": 1.08,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.82,
      "end_seconds": 99.8,
      "duration_seconds": 1.98,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.63,
      "end_seconds": 119.63,
      "duration_seconds": 7.0,
      "text": "Grouped blisters on a red base along one rib on the left, not crossing the midline."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.73,
      "end_seconds": 122.78,
      "duration_seconds": 1.05,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.25,
      "end_seconds": 129.98,
      "duration_seconds": 3.73,
      "text": "that's all I needed to check. Any eye pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.2,
      "end_seconds": 137.16,
      "duration_seconds": 1.96,
      "text": "No, no eye pain."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.74,
      "end_seconds": 144.3,
      "duration_seconds": 6.56,
      "text": "So, have you noticed blurred vision, weakness or rash on the other side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.01,
      "end_seconds": 148.37,
      "duration_seconds": 3.36,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.2,
      "end_seconds": 153.41,
      "duration_seconds": 3.21,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.65,
      "end_seconds": 156.2,
      "duration_seconds": 1.55,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.24,
      "end_seconds": 177.11,
      "duration_seconds": 2.87,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.9,
      "end_seconds": 186.51,
      "duration_seconds": 8.61,
      "text": "High blood pressure, for five years. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.73,
      "end_seconds": 192.28,
      "duration_seconds": 1.55,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.68,
      "end_seconds": 207.44,
      "duration_seconds": 4.76,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.14,
      "end_seconds": 217.8,
      "duration_seconds": 8.66,
      "text": "My partner and our baby. I'm vegetarian and have been for years. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.38,
      "end_seconds": 222.09,
      "duration_seconds": 2.71,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.64,
      "end_seconds": 225.19,
      "duration_seconds": 1.55,
      "text": "no surgery, no"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.45,
      "end_seconds": 240.0,
      "duration_seconds": 2.55,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.62,
      "end_seconds": 246.9,
      "duration_seconds": 5.28,
      "text": "I'm on valsartan, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.89,
      "end_seconds": 250.01,
      "duration_seconds": 2.12,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.29,
      "end_seconds": 255.81,
      "duration_seconds": 4.52,
      "text": "80 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.24,
      "end_seconds": 259.86,
      "duration_seconds": 2.62,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.69,
      "end_seconds": 267.3,
      "duration_seconds": 5.61,
      "text": "Sorry, what was I saying, no, not that I know of."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.0,
      "end_seconds": 272.37,
      "duration_seconds": 3.37,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.26,
      "end_seconds": 280.62,
      "duration_seconds": 3.36,
      "text": "my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.18,
      "end_seconds": 294.48,
      "duration_seconds": 5.3,
      "text": "okay, so my impression is this: My working impression is shingles"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.75,
      "end_seconds": 297.4,
      "duration_seconds": 1.65,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.51,
      "end_seconds": 326.27,
      "duration_seconds": 27.76,
      "text": "I understand the worry. At the moment I'd say it's shingles, and we'll watch how it goes. For this, aciclovir, 800 milligrams, five times a day, for seven days. That should help with shingles. Keep the blisters clean and covered, and avoid contact with anyone pregnant or newborn until they crust. See me again in a week."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.15,
      "end_seconds": 327.85,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.51,
      "end_seconds": 334.39,
      "duration_seconds": 4.88,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.06,
      "end_seconds": 336.53,
      "duration_seconds": 1.47,
      "text": "That's clear, thanks."
    }
  ]
}