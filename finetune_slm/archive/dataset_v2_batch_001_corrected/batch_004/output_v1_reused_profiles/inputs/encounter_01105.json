{
  "schema_version": "1.0",
  "encounter_id": "01105",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.67,
      "end_seconds": 4.8,
      "duration_seconds": 4.13,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 10.54,
      "duration_seconds": 4.34,
      "text": "Alright, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.52,
      "end_seconds": 25.46,
      "duration_seconds": 13.94,
      "text": "Yeah, it's a tight band-like headache. I don't know what's causing it. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.47,
      "end_seconds": 29.86,
      "duration_seconds": 2.39,
      "text": "Does anything set it off?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.51,
      "end_seconds": 35.16,
      "duration_seconds": 4.65,
      "text": "I notice it more with long hours on the computer."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.98,
      "end_seconds": 39.1,
      "duration_seconds": 3.12,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.96,
      "end_seconds": 48.79,
      "duration_seconds": 7.83,
      "text": "It usually comes with tired eyes. The tired eyes? That's been for nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.78,
      "end_seconds": 55.3,
      "duration_seconds": 4.52,
      "text": "Any blurred vision, weakness, vomiting or fever at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.65,
      "end_seconds": 64.32,
      "duration_seconds": 5.67,
      "text": "Mm, I haven't had blurred vision, weakness, vomiting or fever, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.45,
      "end_seconds": 68.14,
      "duration_seconds": 2.69,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.04,
      "end_seconds": 70.96,
      "duration_seconds": 0.92,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.29,
      "end_seconds": 75.01,
      "duration_seconds": 2.72,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.55,
      "end_seconds": 77.01,
      "duration_seconds": 1.46,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.71,
      "end_seconds": 81.05,
      "duration_seconds": 2.34,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.37,
      "end_seconds": 84.64,
      "duration_seconds": 2.27,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.76,
      "end_seconds": 88.74,
      "duration_seconds": 2.98,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.42,
      "end_seconds": 93.23,
      "duration_seconds": 2.81,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.89,
      "end_seconds": 98.06,
      "duration_seconds": 3.17,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.74,
      "end_seconds": 104.73,
      "duration_seconds": 4.99,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.26,
      "end_seconds": 110.69,
      "duration_seconds": 4.43,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.35,
      "end_seconds": 114.91,
      "duration_seconds": 2.56,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.32,
      "end_seconds": 120.93,
      "duration_seconds": 4.61,
      "text": "Right, right. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.57,
      "end_seconds": 128.5,
      "duration_seconds": 6.93,
      "text": "I'm on metoprolol, 50 milligrams, twice a day. It's paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.12,
      "end_seconds": 131.62,
      "duration_seconds": 2.5,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.55,
      "end_seconds": 134.73,
      "duration_seconds": 2.18,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.46,
      "end_seconds": 139.84,
      "duration_seconds": 3.38,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.78,
      "end_seconds": 142.6,
      "duration_seconds": 1.82,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.15,
      "end_seconds": 158.09,
      "duration_seconds": 2.94,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.14,
      "end_seconds": 167.21,
      "duration_seconds": 2.07,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.73,
      "end_seconds": 200.75,
      "duration_seconds": 15.02,
      "text": "Okay: blood pressure 126 over 81, saturation 97 percent, respiratory rate 15. And temp 36.7 degrees, height 183 centimetres, pulse 74, BMI works out to 17.0, weight 57 kilos."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.46,
      "end_seconds": 206.3,
      "duration_seconds": 3.84,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.77,
      "end_seconds": 210.07,
      "duration_seconds": 2.3,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.8,
      "end_seconds": 230.59,
      "duration_seconds": 5.79,
      "text": "The muscles at the back of your neck are tight and tender."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.98,
      "end_seconds": 234.05,
      "duration_seconds": 2.07,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.62,
      "end_seconds": 249.72,
      "duration_seconds": 3.1,
      "text": "Your eye movements and reflexes are normal."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.75,
      "end_seconds": 256.13,
      "duration_seconds": 2.38,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.48,
      "end_seconds": 280.34,
      "duration_seconds": 15.86,
      "text": "So where does that leave us? I think we're dealing with a tension-type headache at this stage. We shouldn't forget a medication-overuse headache. So, to recap quickly. You've had a tight band-like headache, and no blurred vision or vomiting."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.72,
      "end_seconds": 283.27,
      "duration_seconds": 1.55,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.39,
      "end_seconds": 311.49,
      "duration_seconds": 18.1,
      "text": "We'll begin with amitriptyline, 10 milligrams, at night, for six weeks. You take it by mouth. That should help with headache prevention. It's a commonly used medicine and most people tolerate it well. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.76,
      "end_seconds": 321.02,
      "duration_seconds": 3.26,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}