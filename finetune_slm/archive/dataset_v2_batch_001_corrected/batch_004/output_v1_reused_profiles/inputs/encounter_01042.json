{
  "schema_version": "1.0",
  "encounter_id": "01042",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.28,
      "end_seconds": 4.43,
      "duration_seconds": 3.15,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.98,
      "end_seconds": 7.19,
      "duration_seconds": 1.21,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 10.29,
      "duration_seconds": 1.65,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.04,
      "end_seconds": 25.66,
      "duration_seconds": 10.62,
      "text": "Um, so... burning pain in the upper tummy. That's why I came. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.43,
      "end_seconds": 31.44,
      "duration_seconds": 5.01,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.14,
      "end_seconds": 47.51,
      "duration_seconds": 14.37,
      "text": "I'd say all the time. I notice it more with spicy food. I've been feeling full quickly too. Oh, and mild nausea. Had that since yesterday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.08,
      "end_seconds": 55.0,
      "duration_seconds": 3.92,
      "text": "Right, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.92,
      "end_seconds": 59.63,
      "duration_seconds": 2.71,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.75,
      "end_seconds": 66.98,
      "duration_seconds": 4.23,
      "text": "Any difficulty swallowing, weight loss, chest pain or vomiting blood?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.02,
      "end_seconds": 73.32,
      "duration_seconds": 5.3,
      "text": "Ah, um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.81,
      "end_seconds": 76.15,
      "duration_seconds": 1.34,
      "text": "Nothing like jaundice?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.8,
      "end_seconds": 78.67,
      "duration_seconds": 1.87,
      "text": "Nope, no jaundice."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.72,
      "end_seconds": 83.17,
      "duration_seconds": 3.45,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.76,
      "end_seconds": 85.46,
      "duration_seconds": 1.7,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.24,
      "end_seconds": 105.81,
      "duration_seconds": 4.57,
      "text": "So, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.59,
      "end_seconds": 111.22,
      "duration_seconds": 3.63,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.72,
      "end_seconds": 123.52,
      "duration_seconds": 10.8,
      "text": "Hm, okay. Alright, arthritis in your knees, that matches what I have here. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.48,
      "end_seconds": 129.55,
      "duration_seconds": 4.07,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.15,
      "end_seconds": 133.15,
      "duration_seconds": 3.0,
      "text": "Okay, anything surgical in your history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.38,
      "end_seconds": 143.13,
      "duration_seconds": 8.75,
      "text": "Just keyhole surgery on my gallbladder, two years back. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.94,
      "end_seconds": 158.48,
      "duration_seconds": 4.54,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.46,
      "end_seconds": 165.82,
      "duration_seconds": 5.36,
      "text": "It's diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.84,
      "end_seconds": 172.62,
      "duration_seconds": 4.78,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.99,
      "end_seconds": 183.58,
      "duration_seconds": 9.59,
      "text": "I gave up cigarettes last spring. My partner and our baby. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.42,
      "end_seconds": 188.14,
      "duration_seconds": 3.72,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.53,
      "end_seconds": 192.19,
      "duration_seconds": 2.66,
      "text": "Ah, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 201.13,
      "duration_seconds": 5.23,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.63,
      "end_seconds": 211.59,
      "duration_seconds": 2.96,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.32,
      "end_seconds": 241.1,
      "duration_seconds": 8.78,
      "text": "Okay: pulse is 67 beats a minute, pressure 125 over 78, SpO2 97 percent on room air. And temperature 36.7."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.63,
      "end_seconds": 244.26,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.06,
      "end_seconds": 248.14,
      "duration_seconds": 3.08,
      "text": "So, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.52,
      "end_seconds": 280.85,
      "duration_seconds": 25.33,
      "text": "Listening to the whole story, I'm honestly not certain yet. It could be dyspepsia possibly related to anti-inflammatory tablets, or it might be reflux. I'm going to order blood tests, for dyspepsia. A test for the stomach germ is what I'd like next, for dyspepsia. I'm prescribing omeprazole, 20 milligrams, once a day, for four weeks. That should help with stomach acid."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.3,
      "end_seconds": 283.9,
      "duration_seconds": 1.6,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.42,
      "end_seconds": 300.06,
      "duration_seconds": 15.64,
      "text": "Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. If you pass black stools or vomit blood, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.44,
      "end_seconds": 303.17,
      "duration_seconds": 1.73,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.06,
      "end_seconds": 308.92,
      "duration_seconds": 3.86,
      "text": "Please come and see me in four weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.49,
      "end_seconds": 312.45,
      "duration_seconds": 2.96,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.96,
      "end_seconds": 316.26,
      "duration_seconds": 3.3,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.07,
      "end_seconds": 323.6,
      "duration_seconds": 5.53,
      "text": "Okay, so okay, that makes sense. Thanks for explaining."
    }
  ]
}