{
  "schema_version": "1.0",
  "encounter_id": "01224",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.03,
      "end_seconds": 7.31,
      "duration_seconds": 6.28,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.96,
      "end_seconds": 11.78,
      "duration_seconds": 3.82,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.13,
      "end_seconds": 19.11,
      "duration_seconds": 5.98,
      "text": "Doctor, it's a sore throat. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.29,
      "end_seconds": 23.36,
      "duration_seconds": 3.07,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 24.47,
      "end_seconds": 28.46,
      "duration_seconds": 3.99,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.68,
      "end_seconds": 31.4,
      "duration_seconds": 1.72,
      "text": "What brings it on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.41,
      "end_seconds": 35.99,
      "duration_seconds": 2.58,
      "text": "Swallowing definitely sets it off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 36.93,
      "end_seconds": 42.96,
      "duration_seconds": 6.03,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 43.06,
      "end_seconds": 49.56,
      "duration_seconds": 6.5,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 53.73,
      "duration_seconds": 2.2,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.28,
      "end_seconds": 58.15,
      "duration_seconds": 2.87,
      "text": "I've also had pain on swallowing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.96,
      "end_seconds": 63.37,
      "duration_seconds": 3.41,
      "text": "Have you had swollen glands in your neck?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.18,
      "end_seconds": 68.69,
      "duration_seconds": 3.51,
      "text": "Yes, about the same, ten days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.2,
      "end_seconds": 72.24,
      "duration_seconds": 3.04,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 74.16,
      "end_seconds": 85.59,
      "duration_seconds": 11.43,
      "text": "I'd give it a seven, out of ten. Oh, and bad breath. That's been about the same, about a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 90.52,
      "duration_seconds": 3.33,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.6,
      "end_seconds": 99.34,
      "duration_seconds": 6.74,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.63,
      "end_seconds": 106.54,
      "duration_seconds": 5.91,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 108.54,
      "end_seconds": 111.9,
      "duration_seconds": 3.36,
      "text": "A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.7,
      "end_seconds": 117.21,
      "duration_seconds": 3.51,
      "text": "Did you get drooling or trouble opening the mouth?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.68,
      "end_seconds": 125.94,
      "duration_seconds": 2.26,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.58,
      "end_seconds": 130.14,
      "duration_seconds": 3.56,
      "text": "Have you noticed ear pain, cough or rash?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.88,
      "end_seconds": 133.73,
      "duration_seconds": 2.85,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.81,
      "end_seconds": 138.78,
      "duration_seconds": 3.97,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 139.87,
      "end_seconds": 142.23,
      "duration_seconds": 2.36,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 145.82,
      "duration_seconds": 2.53,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.73,
      "end_seconds": 152.23,
      "duration_seconds": 1.5,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.3,
      "end_seconds": 168.32,
      "duration_seconds": 3.02,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 169.23,
      "end_seconds": 174.27,
      "duration_seconds": 5.04,
      "text": "Um, you know, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.08,
      "end_seconds": 179.18,
      "duration_seconds": 3.1,
      "text": "So, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 179.94,
      "end_seconds": 184.89,
      "duration_seconds": 4.95,
      "text": "I have migraines, for five years. I've got asthma."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.41,
      "end_seconds": 188.69,
      "duration_seconds": 3.28,
      "text": "Mm, okay. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.12,
      "end_seconds": 201.87,
      "duration_seconds": 11.75,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.43,
      "end_seconds": 206.14,
      "duration_seconds": 3.71,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.66,
      "end_seconds": 211.56,
      "duration_seconds": 4.9,
      "text": "It's something called suma... sumatriptan, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.94,
      "end_seconds": 217.68,
      "duration_seconds": 4.74,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.83,
      "end_seconds": 227.09,
      "duration_seconds": 8.26,
      "text": "Yeah, no, it's at home. I take Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.85,
      "end_seconds": 236.11,
      "duration_seconds": 3.26,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 238.19,
      "end_seconds": 240.16,
      "duration_seconds": 1.97,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.65,
      "end_seconds": 243.57,
      "duration_seconds": 1.92,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.4,
      "end_seconds": 249.51,
      "duration_seconds": 4.11,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.13,
      "end_seconds": 252.49,
      "duration_seconds": 2.36,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 253.65,
      "end_seconds": 257.4,
      "duration_seconds": 3.75,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.3,
      "end_seconds": 260.04,
      "duration_seconds": 1.74,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.06,
      "end_seconds": 265.19,
      "duration_seconds": 3.13,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 266.86,
      "end_seconds": 274.58,
      "duration_seconds": 7.72,
      "text": "Doctor, I've got the readings for you. Blood pressure 122 over 71, temperature is 38.5 degrees, pulse 101."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.49,
      "end_seconds": 276.92,
      "duration_seconds": 1.43,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.2,
      "end_seconds": 282.09,
      "duration_seconds": 3.89,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.87,
      "end_seconds": 286.71,
      "duration_seconds": 2.84,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.2,
      "end_seconds": 308.79,
      "duration_seconds": 6.59,
      "text": "Both tonsils are red and enlarged with white patches, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.7,
      "end_seconds": 315.73,
      "duration_seconds": 2.03,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.67,
      "end_seconds": 343.16,
      "duration_seconds": 14.49,
      "text": "Okay, so my impression is this: My working impression is tonsillitis. That's my thinking for now, and it may change as we learn more. A viral sore throat is still possible."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 345.05,
      "end_seconds": 347.06,
      "duration_seconds": 2.01,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.15,
      "end_seconds": 367.55,
      "duration_seconds": 18.4,
      "text": "I understand the worry. At the moment I'd say it's tonsillitis, and we'll know more once the a throat swab is back. Let me just check I've got this right. You've had a sore throat, since last Tuesday, and no drooling or rash."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 371.27,
      "end_seconds": 372.89,
      "duration_seconds": 1.62,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 374.95,
      "end_seconds": 378.4,
      "duration_seconds": 3.45,
      "text": "We've already done a throat swab this morning, doctor."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.07,
      "end_seconds": 384.85,
      "duration_seconds": 4.78,
      "text": "Right, thank you. We should do a throat swab for sore throat."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 387.98,
      "end_seconds": 391.3,
      "duration_seconds": 3.32,
      "text": "I can book that for Wednesday at 10 am."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.39,
      "end_seconds": 422.89,
      "duration_seconds": 29.5,
      "text": "The treatment will be phenoxymethylpenicillin, 500 milligrams, four times a day, for ten days. That should help with tonsillitis. Gargle with warm salt water and drink plenty of fluids. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up if it isn't better in three days."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 424.09,
      "end_seconds": 426.36,
      "duration_seconds": 2.27,
      "text": "Okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.03,
      "end_seconds": 432.85,
      "duration_seconds": 4.82,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 433.46,
      "end_seconds": 435.96,
      "duration_seconds": 2.5,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 440.59,
      "end_seconds": 441.85,
      "duration_seconds": 1.26,
      "text": "Look after yourself."
    }
  ]
}