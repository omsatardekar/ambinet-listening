{
  "schema_version": "1.0",
  "encounter_id": "01385",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.95,
      "end_seconds": 3.87,
      "duration_seconds": 2.92,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.03,
      "end_seconds": 6.13,
      "duration_seconds": 1.1,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.54,
      "end_seconds": 14.86,
      "duration_seconds": 3.32,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.53,
      "end_seconds": 28.48,
      "duration_seconds": 11.95,
      "text": "Doctor, it's irregular periods. It's getting on my nerves now. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.99,
      "end_seconds": 30.86,
      "duration_seconds": 1.87,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.56,
      "end_seconds": 39.9,
      "duration_seconds": 7.34,
      "text": "I've had it for about a month. I've also had thinning hair on the scalp."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.71,
      "end_seconds": 58.64,
      "duration_seconds": 4.93,
      "text": "And what about missed period, heavy bleeding or trying for a baby?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.72,
      "end_seconds": 62.11,
      "duration_seconds": 2.39,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.63,
      "end_seconds": 66.22,
      "duration_seconds": 3.59,
      "text": "Have you had pelvic pain, by any chance?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 67.21,
      "end_seconds": 69.27,
      "duration_seconds": 2.06,
      "text": "No, no pelvic pain."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.52,
      "end_seconds": 74.67,
      "duration_seconds": 4.15,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.04,
      "end_seconds": 77.72,
      "duration_seconds": 1.68,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.19,
      "end_seconds": 85.57,
      "duration_seconds": 5.38,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.65,
      "end_seconds": 90.1,
      "duration_seconds": 2.45,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.98,
      "end_seconds": 93.21,
      "duration_seconds": 2.23,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.48,
      "end_seconds": 95.98,
      "duration_seconds": 1.5,
      "text": "Pantoprazole, before breakfast."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.87,
      "end_seconds": 100.31,
      "duration_seconds": 2.44,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.82,
      "end_seconds": 104.75,
      "duration_seconds": 0.93,
      "text": "40 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.83,
      "end_seconds": 108.75,
      "duration_seconds": 1.92,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.58,
      "end_seconds": 112.21,
      "duration_seconds": 2.63,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.24,
      "end_seconds": 115.94,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.95,
      "end_seconds": 121.85,
      "duration_seconds": 3.9,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.83,
      "end_seconds": 138.51,
      "duration_seconds": 2.68,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.51,
      "end_seconds": 143.54,
      "duration_seconds": 4.03,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.14,
      "end_seconds": 153.25,
      "duration_seconds": 4.11,
      "text": "Okay, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.76,
      "end_seconds": 156.7,
      "duration_seconds": 1.94,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.34,
      "end_seconds": 162.7,
      "duration_seconds": 4.36,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.67,
      "end_seconds": 168.36,
      "duration_seconds": 3.69,
      "text": "I've had acid reflux for two years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 189.3,
      "duration_seconds": 3.25,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.16,
      "end_seconds": 193.51,
      "duration_seconds": 3.35,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.38,
      "end_seconds": 208.3,
      "duration_seconds": 3.92,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.77,
      "end_seconds": 223.02,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.71,
      "end_seconds": 246.29,
      "duration_seconds": 7.58,
      "text": "Okay: temperature 37.0, saturation 97 percent. And heart rate 86, pressure 110 over 82."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.73,
      "end_seconds": 254.04,
      "duration_seconds": 5.31,
      "text": "Alright, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.26,
      "end_seconds": 258.19,
      "duration_seconds": 2.93,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.28,
      "end_seconds": 279.33,
      "duration_seconds": 5.05,
      "text": "Facial acne along the jaw and some dark coarse hair on the chin."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.09,
      "end_seconds": 304.07,
      "duration_seconds": 21.98,
      "text": "That's the examination finished. So, based on the history and the examination, the most likely explanation is possible polycystic ovary syndrome. I'll request a pelvic ultrasound, it'll help with irregular periods. Regular exercise and modest weight loss can bring cycles back. Please come and see me in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.88,
      "end_seconds": 306.5,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.54,
      "end_seconds": 309.71,
      "duration_seconds": 1.17,
      "text": "Take care now."
    }
  ]
}