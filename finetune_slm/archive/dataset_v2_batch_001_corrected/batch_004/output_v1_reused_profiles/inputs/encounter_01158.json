{
  "schema_version": "1.0",
  "encounter_id": "01158",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.55,
      "end_seconds": 6.74,
      "duration_seconds": 6.19,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.48,
      "end_seconds": 11.61,
      "duration_seconds": 4.13,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.39,
      "end_seconds": 19.99,
      "duration_seconds": 6.6,
      "text": "It's a tight scalp. I thought I'd wait, but it it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.76,
      "end_seconds": 22.54,
      "duration_seconds": 1.78,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.87,
      "end_seconds": 35.12,
      "duration_seconds": 8.25,
      "text": "Um, for two years, I'd say. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.88,
      "end_seconds": 37.47,
      "duration_seconds": 1.59,
      "text": "does anything help it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.99,
      "end_seconds": 42.27,
      "duration_seconds": 4.28,
      "text": "only a head massage, and it's not much"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.36,
      "end_seconds": 46.16,
      "duration_seconds": 2.8,
      "text": "Have you had a band-like headache?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.61,
      "end_seconds": 54.28,
      "duration_seconds": 6.67,
      "text": "Yes, actually. As for band-like headache, yes, screens. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.92,
      "end_seconds": 63.15,
      "duration_seconds": 3.23,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.71,
      "end_seconds": 66.27,
      "duration_seconds": 1.56,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.03,
      "end_seconds": 72.41,
      "duration_seconds": 4.38,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.65,
      "end_seconds": 75.67,
      "duration_seconds": 2.02,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.37,
      "end_seconds": 90.71,
      "duration_seconds": 2.34,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.57,
      "end_seconds": 94.72,
      "duration_seconds": 3.15,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.79,
      "end_seconds": 104.09,
      "duration_seconds": 1.3,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.13,
      "end_seconds": 109.74,
      "duration_seconds": 3.61,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.85,
      "end_seconds": 113.77,
      "duration_seconds": 2.92,
      "text": "Anything you do to to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.1,
      "end_seconds": 118.71,
      "duration_seconds": 3.61,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.42,
      "end_seconds": 122.86,
      "duration_seconds": 2.44,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.97,
      "end_seconds": 130.98,
      "duration_seconds": 5.01,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.96,
      "end_seconds": 134.33,
      "duration_seconds": 2.37,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.64,
      "end_seconds": 138.92,
      "duration_seconds": 3.28,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.5,
      "end_seconds": 143.8,
      "duration_seconds": 3.3,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.58,
      "end_seconds": 148.53,
      "duration_seconds": 2.95,
      "text": "It's paracetamol, 500 milligrams, most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.74,
      "end_seconds": 155.1,
      "duration_seconds": 2.36,
      "text": "have you had any head injury?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.68,
      "end_seconds": 157.47,
      "duration_seconds": 1.79,
      "text": "no. No head injury"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.58,
      "end_seconds": 162.4,
      "duration_seconds": 3.82,
      "text": "Right, did you get vomiting, weakness or blurred vision?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.82,
      "end_seconds": 167.21,
      "duration_seconds": 3.39,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.75,
      "end_seconds": 171.49,
      "duration_seconds": 2.74,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.14,
      "end_seconds": 174.15,
      "duration_seconds": 1.01,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.34,
      "end_seconds": 185.96,
      "duration_seconds": 2.62,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 199.82,
      "duration_seconds": 2.59,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.0,
      "end_seconds": 216.77,
      "duration_seconds": 5.77,
      "text": "Okay: pulse 78, pressure 124 over 69, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.51,
      "end_seconds": 222.75,
      "duration_seconds": 3.24,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.64,
      "end_seconds": 227.02,
      "duration_seconds": 2.38,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.75,
      "end_seconds": 248.78,
      "duration_seconds": 6.03,
      "text": "Neck muscles are tight and tender, and the eye and limb checks are normal"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.45,
      "end_seconds": 251.94,
      "duration_seconds": 1.49,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.34,
      "end_seconds": 256.34,
      "duration_seconds": 2.0,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.85,
      "end_seconds": 291.78,
      "duration_seconds": 20.93,
      "text": "We should do blood tests for headache. That will help us see what's going on underneath and decide the next step. Try to limit painkillers to two days a week and keep a diary of the headaches. I'd like you back in four weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.77,
      "end_seconds": 293.47,
      "duration_seconds": 0.7,
      "text": "sure"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.22,
      "end_seconds": 298.12,
      "duration_seconds": 2.9,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.1,
      "end_seconds": 303.08,
      "duration_seconds": 2.98,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.87,
      "end_seconds": 309.63,
      "duration_seconds": 1.76,
      "text": "Have a good day."
    }
  ]
}