{
  "schema_version": "1.0",
  "encounter_id": "01126",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 7.21,
      "duration_seconds": 5.94,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 11.98,
      "duration_seconds": 3.92,
      "text": "that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.79,
      "end_seconds": 18.9,
      "duration_seconds": 6.11,
      "text": "I mean, mainly I've been feeling unsteady. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.54,
      "end_seconds": 23.77,
      "duration_seconds": 3.23,
      "text": "when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.43,
      "end_seconds": 28.25,
      "duration_seconds": 3.82,
      "text": "It's been going on for ten days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.58,
      "end_seconds": 42.18,
      "duration_seconds": 12.6,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.07,
      "end_seconds": 48.33,
      "duration_seconds": 5.26,
      "text": "It settles a little with holding on to something. Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.29,
      "end_seconds": 52.95,
      "duration_seconds": 3.66,
      "text": "What about the room spinning, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.47,
      "end_seconds": 62.44,
      "duration_seconds": 7.97,
      "text": "yeah. Two weeks, I'd say. With room spinning, a five out of ten, I suppose"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.29,
      "end_seconds": 65.76,
      "duration_seconds": 2.47,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.96,
      "end_seconds": 77.6,
      "duration_seconds": 2.64,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.88,
      "end_seconds": 98.47,
      "duration_seconds": 9.59,
      "text": "okay: SpO2 98 percent on room air, temperature is 36.5 degrees, pressure 110 over 82, pulse is 72 beats a minute"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.33,
      "end_seconds": 104.6,
      "duration_seconds": 4.27,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.75,
      "end_seconds": 108.57,
      "duration_seconds": 2.82,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.29,
      "end_seconds": 124.52,
      "duration_seconds": 6.23,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.46,
      "end_seconds": 128.7,
      "duration_seconds": 2.24,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.6,
      "end_seconds": 141.47,
      "duration_seconds": 4.87,
      "text": "Your walking is steady and the finger-nose test is normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.39,
      "end_seconds": 148.19,
      "duration_seconds": 1.8,
      "text": "you can relax now"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.1,
      "end_seconds": 169.49,
      "duration_seconds": 3.39,
      "text": "Have you noticed headache, weakness or double vision?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.1,
      "end_seconds": 174.37,
      "duration_seconds": 4.27,
      "text": "I haven't had headache, weakness or double vision, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.71,
      "end_seconds": 177.76,
      "duration_seconds": 3.05,
      "text": "I follow has your skin been okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.42,
      "end_seconds": 179.44,
      "duration_seconds": 1.02,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.1,
      "end_seconds": 183.68,
      "duration_seconds": 3.58,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.53,
      "end_seconds": 186.61,
      "duration_seconds": 2.08,
      "text": "I've had diabetes, yes"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.17,
      "end_seconds": 194.78,
      "duration_seconds": 6.61,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.5,
      "end_seconds": 213.85,
      "duration_seconds": 1.35,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.12,
      "end_seconds": 220.33,
      "duration_seconds": 3.21,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.86,
      "end_seconds": 223.69,
      "duration_seconds": 2.83,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.54,
      "end_seconds": 227.66,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.61,
      "end_seconds": 231.05,
      "duration_seconds": 2.44,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.19,
      "end_seconds": 235.66,
      "duration_seconds": 3.47,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.27,
      "end_seconds": 241.07,
      "duration_seconds": 4.8,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.37,
      "end_seconds": 247.77,
      "duration_seconds": 5.4,
      "text": "I'm on Glycomet, 500 milligrams, twice a day for my sugar"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.79,
      "end_seconds": 261.99,
      "duration_seconds": 5.2,
      "text": "right, here's what I'm thinking it points towards benign positional vertigo"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.26,
      "end_seconds": 313.13,
      "duration_seconds": 37.87,
      "text": "I'm going to order a hearing test, for tinnitus and vertigo. What I'm giving you is betahistine, 16 milligrams, three times a day, for two weeks. You take it by mouth. That's for vertigo. Get up slowly from lying down and sit for a moment first. Do get help quickly if you get weakness, slurred speech or a severe headache with the dizziness. Come back in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.1,
      "end_seconds": 317.49,
      "duration_seconds": 3.39,
      "text": "Right, great, thank you for your help."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.24,
      "end_seconds": 321.71,
      "duration_seconds": 2.47,
      "text": "Okay, have a good day."
    }
  ]
}