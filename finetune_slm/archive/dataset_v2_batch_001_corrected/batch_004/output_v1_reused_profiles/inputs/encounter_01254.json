{
  "schema_version": "1.0",
  "encounter_id": "01254",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 6.39,
      "duration_seconds": 5.22,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.47,
      "end_seconds": 11.9,
      "duration_seconds": 4.43,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.47,
      "end_seconds": 18.78,
      "duration_seconds": 5.31,
      "text": "Yeah, it's nausea with it. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.77,
      "end_seconds": 22.59,
      "duration_seconds": 1.82,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.24,
      "end_seconds": 25.8,
      "duration_seconds": 1.56,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.87,
      "end_seconds": 35.98,
      "duration_seconds": 8.11,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.92,
      "end_seconds": 47.23,
      "duration_seconds": 10.31,
      "text": "Mild, really. It's a couple of times a week. I had pain going to the shoulder blade before. That's settled now, though."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.18,
      "end_seconds": 54.53,
      "duration_seconds": 6.35,
      "text": "Have you had nausea with it before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.2,
      "end_seconds": 62.25,
      "duration_seconds": 6.05,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 67.3,
      "duration_seconds": 3.15,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.16,
      "end_seconds": 73.28,
      "duration_seconds": 4.12,
      "text": "Simvastatin. I take it at night for my cholesterol."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.17,
      "end_seconds": 77.63,
      "duration_seconds": 2.46,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.35,
      "end_seconds": 87.88,
      "duration_seconds": 8.53,
      "text": "20 milligrams. Glimepiride, 2 milligrams, before breakfast i'd rather know what's going on than keep guessing"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.86,
      "end_seconds": 91.1,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.05,
      "end_seconds": 94.58,
      "duration_seconds": 1.53,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.86,
      "end_seconds": 97.12,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.67,
      "end_seconds": 100.44,
      "duration_seconds": 2.77,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.34,
      "end_seconds": 104.07,
      "duration_seconds": 2.73,
      "text": "Right, tell me about your eating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.02,
      "end_seconds": 110.46,
      "duration_seconds": 5.44,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.94,
      "end_seconds": 117.4,
      "duration_seconds": 2.46,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.64,
      "end_seconds": 122.83,
      "duration_seconds": 4.19,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.49,
      "end_seconds": 127.62,
      "duration_seconds": 3.13,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.75,
      "end_seconds": 132.92,
      "duration_seconds": 4.17,
      "text": "I have high cholesterol, for about ten years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.83,
      "end_seconds": 135.76,
      "duration_seconds": 0.93,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.12,
      "end_seconds": 138.22,
      "duration_seconds": 1.1,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.89,
      "end_seconds": 141.23,
      "duration_seconds": 1.34,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.73,
      "end_seconds": 145.62,
      "duration_seconds": 2.89,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.36,
      "end_seconds": 148.74,
      "duration_seconds": 2.38,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.2,
      "end_seconds": 154.35,
      "duration_seconds": 4.15,
      "text": "Have you had any weight loss, vomiting or pale stools?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.64,
      "end_seconds": 161.97,
      "duration_seconds": 5.33,
      "text": "I haven't had weight loss, vomiting or pale stools, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.72,
      "end_seconds": 165.11,
      "duration_seconds": 1.39,
      "text": "Any dark urine?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.85,
      "end_seconds": 169.31,
      "duration_seconds": 3.46,
      "text": "Yeah, I haven't noticed any dark urine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.2,
      "end_seconds": 176.8,
      "duration_seconds": 2.6,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.54,
      "end_seconds": 180.21,
      "duration_seconds": 1.67,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.79,
      "end_seconds": 183.96,
      "duration_seconds": 2.17,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.85,
      "end_seconds": 188.23,
      "duration_seconds": 3.38,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.66,
      "end_seconds": 192.17,
      "duration_seconds": 2.51,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.31,
      "end_seconds": 202.71,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.42,
      "end_seconds": 235.64,
      "duration_seconds": 14.22,
      "text": "Okay: weight 97 kilos, oxygen saturation is 99 percent, heart rate 75. And temperature is 36.6 degrees, height 154 centimetres, blood pressure 117 over 77, BMI works out to 40.9."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.28,
      "end_seconds": 242.21,
      "duration_seconds": 4.93,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.0,
      "end_seconds": 245.26,
      "duration_seconds": 1.26,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.04,
      "end_seconds": 263.07,
      "duration_seconds": 3.03,
      "text": "The rest of the tummy is soft."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.16,
      "end_seconds": 270.0,
      "duration_seconds": 1.84,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.12,
      "end_seconds": 305.76,
      "duration_seconds": 17.64,
      "text": "So, based on the history and the examination, I'd lean towards gallstone pain. I want to be honest that this is an impression, not a final answer. It could also be gastritis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.98,
      "end_seconds": 336.49,
      "duration_seconds": 12.51,
      "text": "I'm gonna order liver function tests, for right upper quadrant pain. Smaller, lower-fat meals will probably keep the pain down until we've seen the scan."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.86,
      "end_seconds": 337.56,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.31,
      "end_seconds": 344.31,
      "duration_seconds": 6.0,
      "text": "Could I get an ultrasound of the abdomen done? A friend had it."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.9,
      "end_seconds": 360.69,
      "duration_seconds": 14.79,
      "text": "I wouldn't order it today if anything changes, we'll reconsider one warning sign to remember: the pain lasts for hours, you get a fever or turn yellow in that case don't wait"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.28,
      "end_seconds": 365.48,
      "duration_seconds": 4.2,
      "text": "Let me think, I know what to watch for."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.27,
      "end_seconds": 370.45,
      "duration_seconds": 3.18,
      "text": "I'll want another look after the scan"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.24,
      "end_seconds": 374.23,
      "duration_seconds": 2.99,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.29,
      "end_seconds": 378.84,
      "duration_seconds": 3.55,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.31,
      "end_seconds": 383.27,
      "duration_seconds": 2.96,
      "text": "I think I understand everything. Thanks."
    }
  ]
}