{
  "schema_version": "1.0",
  "encounter_id": "01384",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 4.77,
      "duration_seconds": 3.64,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.09,
      "end_seconds": 9.15,
      "duration_seconds": 3.06,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.86,
      "end_seconds": 13.62,
      "duration_seconds": 2.76,
      "text": "Did you find the place alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.15,
      "end_seconds": 19.48,
      "duration_seconds": 5.33,
      "text": "Yes, it was easy enough. The parking was the hard part."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.22,
      "end_seconds": 22.1,
      "duration_seconds": 1.88,
      "text": "Right, what's the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.67,
      "end_seconds": 31.01,
      "duration_seconds": 7.34,
      "text": "Erm, it's tingling in my feet. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.75,
      "end_seconds": 35.64,
      "duration_seconds": 3.89,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.53,
      "end_seconds": 44.55,
      "duration_seconds": 3.02,
      "text": "For nearly five years, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.5,
      "end_seconds": 48.94,
      "duration_seconds": 2.44,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.01,
      "end_seconds": 52.87,
      "duration_seconds": 1.86,
      "text": "It's on and off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.16,
      "end_seconds": 56.69,
      "duration_seconds": 2.53,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.66,
      "end_seconds": 61.63,
      "duration_seconds": 3.97,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.43,
      "end_seconds": 64.25,
      "duration_seconds": 1.82,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.42,
      "end_seconds": 69.08,
      "duration_seconds": 3.66,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.99,
      "end_seconds": 74.12,
      "duration_seconds": 4.13,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.76,
      "end_seconds": 80.84,
      "duration_seconds": 6.08,
      "text": "Glimepiride. I take it 2 milligrams, before breakfast. Magnesium tablets, at night."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.07,
      "end_seconds": 100.17,
      "duration_seconds": 3.1,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.31,
      "end_seconds": 103.56,
      "duration_seconds": 2.25,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.3,
      "end_seconds": 124.56,
      "duration_seconds": 4.26,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.17,
      "end_seconds": 131.77,
      "duration_seconds": 5.6,
      "text": "Yes, diabetes. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.41,
      "end_seconds": 140.71,
      "duration_seconds": 4.3,
      "text": "Any shortness of breath or weakness in the legs at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.21,
      "end_seconds": 148.57,
      "duration_seconds": 6.36,
      "text": "I haven't had shortness of breath or weakness in the legs, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.5,
      "end_seconds": 153.89,
      "duration_seconds": 3.39,
      "text": "Any sign of swelling of the legs?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.25,
      "end_seconds": 163.16,
      "duration_seconds": 3.91,
      "text": "I haven't noticed any swelling of the legs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.67,
      "end_seconds": 166.67,
      "duration_seconds": 2.0,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.32,
      "end_seconds": 173.34,
      "duration_seconds": 1.02,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.25,
      "end_seconds": 179.13,
      "duration_seconds": 3.88,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.79,
      "end_seconds": 182.44,
      "duration_seconds": 2.65,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.78,
      "end_seconds": 187.23,
      "duration_seconds": 3.45,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.35,
      "end_seconds": 202.11,
      "duration_seconds": 2.76,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.24,
      "end_seconds": 219.07,
      "duration_seconds": 6.83,
      "text": "Okay: pressure 126 over 69, pulse 75, temperature is 36.4 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.67,
      "end_seconds": 222.63,
      "duration_seconds": 1.96,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.31,
      "end_seconds": 239.31,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.08,
      "end_seconds": 243.39,
      "duration_seconds": 2.31,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.87,
      "end_seconds": 264.12,
      "duration_seconds": 7.25,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.44,
      "end_seconds": 275.6,
      "duration_seconds": 8.16,
      "text": "All finished, thank you. Right, here's what I'm thinking. My working impression is night-time muscle cramps without a worrying cause."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.5,
      "end_seconds": 294.4,
      "duration_seconds": 5.9,
      "text": "I'm sending you for a blood sugar test because of tingling feet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 296.36,
      "end_seconds": 297.98,
      "duration_seconds": 1.62,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.44,
      "end_seconds": 302.07,
      "duration_seconds": 2.63,
      "text": "Keep well hydrated through the day."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.4,
      "end_seconds": 316.66,
      "duration_seconds": 14.26,
      "text": "Yes. I'm not ordering blood tests today. If things carry on in a month, we'll consider it. One warning sign to remember: one leg becomes red, hot or swollen. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.56,
      "end_seconds": 321.46,
      "duration_seconds": 2.9,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.73,
      "end_seconds": 328.23,
      "duration_seconds": 5.5,
      "text": "Come back in four weeks. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 329.35,
      "end_seconds": 334.23,
      "duration_seconds": 4.88,
      "text": "So, I come back in four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.46,
      "end_seconds": 342.13,
      "duration_seconds": 6.67,
      "text": "Right, yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.61,
      "end_seconds": 345.09,
      "duration_seconds": 1.48,
      "text": "That's clear, thanks."
    }
  ]
}