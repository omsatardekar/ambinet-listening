{
  "schema_version": "1.0",
  "encounter_id": "01461",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 4.26,
      "duration_seconds": 3.13,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.15,
      "end_seconds": 10.93,
      "duration_seconds": 2.78,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.39,
      "end_seconds": 16.06,
      "duration_seconds": 3.67,
      "text": "Okay, so doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.66,
      "end_seconds": 24.31,
      "duration_seconds": 6.65,
      "text": "Right, that's fine, sit down. We'll go through it together. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.63,
      "end_seconds": 30.09,
      "duration_seconds": 4.46,
      "text": "We came because of pain in my right ear."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.17,
      "end_seconds": 33.47,
      "duration_seconds": 2.3,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 34.71,
      "end_seconds": 43.51,
      "duration_seconds": 8.8,
      "text": "He takes Foracort inhaler, twice a day for my asthma. He takes ramipril, 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 48.25,
      "duration_seconds": 3.03,
      "text": "Okay, how long have you taken that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 48.79,
      "end_seconds": 61.11,
      "duration_seconds": 12.32,
      "text": "About six months. It's metformin, 500 milligrams, twice a day, doctor. He is on paracetamol, 500 milligrams, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.5,
      "end_seconds": 65.77,
      "duration_seconds": 3.27,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.36,
      "end_seconds": 70.26,
      "duration_seconds": 3.9,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.62,
      "end_seconds": 74.54,
      "duration_seconds": 2.92,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.62,
      "end_seconds": 80.1,
      "duration_seconds": 3.48,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.04,
      "end_seconds": 85.91,
      "duration_seconds": 3.87,
      "text": "Right, what do you do to make it better?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.95,
      "end_seconds": 92.2,
      "duration_seconds": 4.25,
      "text": "It settles a little with a warm cloth."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.62,
      "end_seconds": 99.06,
      "duration_seconds": 5.44,
      "text": "Right, what about a runny nose before it started, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.58,
      "end_seconds": 107.55,
      "duration_seconds": 6.97,
      "text": "Yes, that started yesterday. About runny nose before it started, I'd call it mild."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.7,
      "end_seconds": 112.32,
      "duration_seconds": 3.62,
      "text": "What about muffled hearing, have you noticed that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.19,
      "end_seconds": 119.01,
      "duration_seconds": 2.82,
      "text": "Yeah. Three days, I'd say."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.02,
      "end_seconds": 124.12,
      "duration_seconds": 3.1,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.99,
      "end_seconds": 130.02,
      "duration_seconds": 2.03,
      "text": "I'd call it moderate."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.02,
      "end_seconds": 138.7,
      "duration_seconds": 6.68,
      "text": "Have you had pain in your right ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.26,
      "end_seconds": 144.79,
      "duration_seconds": 5.53,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.65,
      "end_seconds": 149.41,
      "duration_seconds": 2.76,
      "text": "Right, have you had any dizziness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.11,
      "end_seconds": 155.76,
      "duration_seconds": 1.65,
      "text": "Definitely no dizziness."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 156.78,
      "end_seconds": 161.54,
      "duration_seconds": 4.76,
      "text": "Actually, doctor, I did notice dizziness. He doesn't always say."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.41,
      "end_seconds": 169.7,
      "duration_seconds": 6.29,
      "text": "No, I don't think I did. Maybe a little, I'm not sure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.94,
      "end_seconds": 178.88,
      "duration_seconds": 7.94,
      "text": "Alright, I'll note both what you've said and what you've noticed. Any facial weakness, ringing or recent swim?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.94,
      "end_seconds": 183.88,
      "duration_seconds": 3.94,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.84,
      "end_seconds": 188.89,
      "duration_seconds": 4.05,
      "text": "Any discharge from the ear or swelling behind the ear?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.99,
      "end_seconds": 193.65,
      "duration_seconds": 3.66,
      "text": "No, um, not a single one."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.42,
      "end_seconds": 197.36,
      "duration_seconds": 1.94,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.27,
      "end_seconds": 199.97,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.41,
      "end_seconds": 204.25,
      "duration_seconds": 2.84,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.52,
      "end_seconds": 212.14,
      "duration_seconds": 6.62,
      "text": "Yes, I had a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.9,
      "end_seconds": 215.34,
      "duration_seconds": 2.44,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.59,
      "end_seconds": 230.34,
      "duration_seconds": 11.75,
      "text": "I gave up cigarettes last spring. I hardly move around during the day. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.21,
      "end_seconds": 236.04,
      "duration_seconds": 3.83,
      "text": "Alright, is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.23,
      "end_seconds": 239.75,
      "duration_seconds": 2.52,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.41,
      "end_seconds": 254.56,
      "duration_seconds": 4.15,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.09,
      "end_seconds": 258.87,
      "duration_seconds": 2.78,
      "text": "Asthma, for about ten years."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.5,
      "end_seconds": 260.71,
      "duration_seconds": 1.21,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.6,
      "end_seconds": 264.4,
      "duration_seconds": 2.8,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.76,
      "end_seconds": 266.71,
      "duration_seconds": 0.95,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.77,
      "end_seconds": 272.2,
      "duration_seconds": 1.43,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.09,
      "end_seconds": 281.42,
      "duration_seconds": 8.33,
      "text": "Right, yes, asthma and diabetes are known to us, good to have that clear. Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 287.44,
      "end_seconds": 289.85,
      "duration_seconds": 2.41,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 291.36,
      "end_seconds": 296.95,
      "duration_seconds": 5.59,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.93,
      "end_seconds": 300.73,
      "duration_seconds": 2.8,
      "text": "Oh, I don't remember that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.26,
      "end_seconds": 305.58,
      "duration_seconds": 3.32,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.92,
      "end_seconds": 324.78,
      "duration_seconds": 2.86,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.91,
      "end_seconds": 337.13,
      "duration_seconds": 2.22,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.06,
      "end_seconds": 363.83,
      "duration_seconds": 8.77,
      "text": "Okay: oxygen saturation is 97 percent, respiratory rate 17, blood pressure 106 over 70, heart rate 105, temperature 38.1."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.88,
      "end_seconds": 366.53,
      "duration_seconds": 1.65,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.06,
      "end_seconds": 371.45,
      "duration_seconds": 3.39,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.8,
      "end_seconds": 405.51,
      "duration_seconds": 26.71,
      "text": "So, based on your history, I'd lean towards a middle ear infection. I can't rule out a wax blockage yet. Let's use amoxicillin, 500 milligrams, three times a day, for five days. That's for ear infection. Keep the ear dry for now and don't put anything in it, including cotton buds. I'd like you back in a week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 406.21,
      "end_seconds": 409.15,
      "duration_seconds": 2.94,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.47,
      "end_seconds": 411.66,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}