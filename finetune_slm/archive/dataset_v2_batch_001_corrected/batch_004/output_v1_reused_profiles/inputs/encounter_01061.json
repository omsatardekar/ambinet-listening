{
  "schema_version": "1.0",
  "encounter_id": "01061",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 3.61,
      "duration_seconds": 2.89,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.03,
      "end_seconds": 6.22,
      "duration_seconds": 1.19,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.82,
      "end_seconds": 16.66,
      "duration_seconds": 6.84,
      "text": "Sorry, what was I saying, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.5,
      "end_seconds": 25.44,
      "duration_seconds": 6.94,
      "text": "Yes, that's no problem at all. Please sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.6,
      "end_seconds": 41.31,
      "duration_seconds": 9.71,
      "text": "Honestly, it's pins and needles in my hands and feet, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.5,
      "end_seconds": 48.86,
      "duration_seconds": 6.36,
      "text": "How long has this been bothering you? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.84,
      "end_seconds": 58.92,
      "duration_seconds": 9.08,
      "text": "About two weeks, I think... sorry, four weeks, I got that wrong. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.84,
      "end_seconds": 63.29,
      "duration_seconds": 3.45,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.71,
      "end_seconds": 67.52,
      "duration_seconds": 2.81,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.47,
      "end_seconds": 75.84,
      "duration_seconds": 2.37,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.35,
      "end_seconds": 92.95,
      "duration_seconds": 15.6,
      "text": "It usually comes with being unsteady on my feet. As for being unsteady on my feet, it's mild, honestly. And I've been feeling very tired as well, for about a month."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.01,
      "end_seconds": 100.27,
      "duration_seconds": 3.26,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.33,
      "end_seconds": 104.3,
      "duration_seconds": 2.97,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.88,
      "end_seconds": 124.89,
      "duration_seconds": 3.01,
      "text": "Have you had any loss of vision?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.65,
      "end_seconds": 131.25,
      "duration_seconds": 4.6,
      "text": "No, um, none, no loss of vision."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.98,
      "end_seconds": 137.2,
      "duration_seconds": 4.22,
      "text": "Any rash, weakness of one side, diarrhoea or weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.65,
      "end_seconds": 144.95,
      "duration_seconds": 6.3,
      "text": "I haven't had rash, weakness of one side, diarrhoea or weight loss, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.78,
      "end_seconds": 149.92,
      "duration_seconds": 3.14,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.69,
      "end_seconds": 152.26,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.73,
      "end_seconds": 156.29,
      "duration_seconds": 2.56,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.19,
      "end_seconds": 161.72,
      "duration_seconds": 3.53,
      "text": "Erm, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.56,
      "end_seconds": 167.84,
      "duration_seconds": 4.28,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.72,
      "end_seconds": 178.04,
      "duration_seconds": 9.32,
      "text": "I grab fast food at lunch most days. I hardly move around during the day. My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.66,
      "end_seconds": 198.42,
      "duration_seconds": 3.76,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.68,
      "end_seconds": 228.58,
      "duration_seconds": 28.9,
      "text": "I mean, you know, I have diabetes, for nearly five years. I thought it would sort itself out, but it hasn't. I have acid reflux. I'd rather not end up on lots of tablets if I can avoid it. I just want to get back to normal, um, really. I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.15,
      "end_seconds": 238.31,
      "duration_seconds": 9.16,
      "text": "Yes, diabetes and acid reflux are known to us, good to have that clear. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 240.25,
      "end_seconds": 253.31,
      "duration_seconds": 13.06,
      "text": "It's, It's sitagliptin, 100 milligrams, once a day, doctor. It's pantoprazole, 40 milligrams, before breakfast, doctor. It's thyroxine, 75 micrograms, every morning, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.93,
      "end_seconds": 256.31,
      "duration_seconds": 1.38,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 257.83,
      "end_seconds": 259.28,
      "duration_seconds": 1.45,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.16,
      "end_seconds": 262.57,
      "duration_seconds": 2.41,
      "text": "Glimepiride I don't take anymore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.15,
      "end_seconds": 268.95,
      "duration_seconds": 2.8,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.3,
      "end_seconds": 276.41,
      "duration_seconds": 6.11,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.32,
      "end_seconds": 280.69,
      "duration_seconds": 2.37,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 281.28,
      "end_seconds": 282.73,
      "duration_seconds": 1.45,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.07,
      "end_seconds": 285.3,
      "duration_seconds": 1.23,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.29,
      "end_seconds": 303.67,
      "duration_seconds": 3.38,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.23,
      "end_seconds": 321.2,
      "duration_seconds": 13.97,
      "text": "You can relax now. Right, here's what I'm thinking. I don't have a clear answer today: symptoms that fit a vitamin B12 deficiency is possible, and so is diabetic nerve damage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.99,
      "end_seconds": 323.97,
      "duration_seconds": 1.98,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.25,
      "end_seconds": 334.58,
      "duration_seconds": 9.33,
      "text": "It's reasonable to be concerned, but right now symptoms that fit a vitamin B12 deficiency is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.58,
      "end_seconds": 351.31,
      "duration_seconds": 8.73,
      "text": "I'm sending you for a full blood count because of tiredness. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.75,
      "end_seconds": 354.31,
      "duration_seconds": 1.56,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.94,
      "end_seconds": 356.35,
      "duration_seconds": 1.41,
      "text": "All the best."
    }
  ]
}