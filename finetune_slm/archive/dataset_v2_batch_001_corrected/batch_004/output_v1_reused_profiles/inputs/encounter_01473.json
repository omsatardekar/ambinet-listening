{
  "schema_version": "1.0",
  "encounter_id": "01473",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 5.45,
      "duration_seconds": 4.14,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.09,
      "end_seconds": 10.76,
      "duration_seconds": 3.67,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.83,
      "end_seconds": 24.01,
      "duration_seconds": 12.18,
      "text": "Um, you know, so... a cough at night. That's why I came. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.85,
      "end_seconds": 26.57,
      "duration_seconds": 1.72,
      "text": "Right, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.8,
      "end_seconds": 31.09,
      "duration_seconds": 3.29,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.38,
      "end_seconds": 40.2,
      "duration_seconds": 7.82,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.79,
      "end_seconds": 44.61,
      "duration_seconds": 3.82,
      "text": "Severe, really. It just comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.48,
      "end_seconds": 50.61,
      "duration_seconds": 4.13,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.91,
      "end_seconds": 61.45,
      "duration_seconds": 9.54,
      "text": "I had a reaction to trimethoprim when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.77,
      "end_seconds": 82.34,
      "duration_seconds": 2.57,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.41,
      "end_seconds": 87.77,
      "duration_seconds": 3.36,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.82,
      "end_seconds": 90.88,
      "duration_seconds": 2.06,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.02,
      "end_seconds": 96.16,
      "duration_seconds": 4.14,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.43,
      "end_seconds": 100.74,
      "duration_seconds": 3.31,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.74,
      "end_seconds": 107.24,
      "duration_seconds": 4.5,
      "text": "Asthalin inhaler, when needed. Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.65,
      "end_seconds": 123.08,
      "duration_seconds": 2.43,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.57,
      "end_seconds": 126.52,
      "duration_seconds": 1.95,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.34,
      "end_seconds": 129.3,
      "duration_seconds": 1.96,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.98,
      "end_seconds": 132.33,
      "duration_seconds": 2.35,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.37,
      "end_seconds": 135.07,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.44,
      "end_seconds": 148.18,
      "duration_seconds": 2.74,
      "text": "Any blue lips or fever at all?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.87,
      "end_seconds": 152.99,
      "duration_seconds": 3.12,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.81,
      "end_seconds": 157.09,
      "duration_seconds": 2.28,
      "text": "Okay, how about ankle swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.17,
      "end_seconds": 161.25,
      "duration_seconds": 2.08,
      "text": "No, no ankle swelling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.87,
      "end_seconds": 164.82,
      "duration_seconds": 1.95,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.73,
      "end_seconds": 168.21,
      "duration_seconds": 1.48,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.04,
      "end_seconds": 172.97,
      "duration_seconds": 2.93,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.12,
      "end_seconds": 187.96,
      "duration_seconds": 2.84,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.86,
      "end_seconds": 220.01,
      "duration_seconds": 10.15,
      "text": "Okay: BP is 120 over 73, pulse is 85 beats a minute, respiratory rate 16, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.15,
      "end_seconds": 224.11,
      "duration_seconds": 1.96,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.39,
      "end_seconds": 227.46,
      "duration_seconds": 2.07,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.0,
      "end_seconds": 248.37,
      "duration_seconds": 7.37,
      "text": "I can hear a faint wheeze at the end of breathing out, otherwise the chest is clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.95,
      "end_seconds": 259.31,
      "duration_seconds": 6.36,
      "text": "That's the examination finished. Putting it all together, I'd lean towards exercise-triggered asthma with seasonal allergy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.09,
      "end_seconds": 266.84,
      "duration_seconds": 3.75,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.41,
      "end_seconds": 281.5,
      "duration_seconds": 13.09,
      "text": "I understand the worry. At the moment I'd say it's exercise-triggered asthma with seasonal allergy, and we'll know more once the a peak flow diary is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.37,
      "end_seconds": 302.41,
      "duration_seconds": 8.04,
      "text": "Let's get a peak flow diary, for asthma. I'm going to order an allergy test, for seasonal symptoms."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.37,
      "end_seconds": 307.6,
      "duration_seconds": 3.23,
      "text": "Mm, do I need to prepare?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.14,
      "end_seconds": 333.11,
      "duration_seconds": 20.97,
      "text": "The treatment will be budesonide-formoterol inhaler, 200 micrograms, one puff twice a day, long term. That's for asthma control. Rinse your mouth after the preventer inhaler and use the spacer. We'll catch up in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.86,
      "end_seconds": 336.3,
      "duration_seconds": 2.44,
      "text": "Alright, thanks, take care."
    }
  ]
}