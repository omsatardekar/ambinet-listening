{
  "schema_version": "1.0",
  "encounter_id": "01180",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.96,
      "end_seconds": 6.19,
      "duration_seconds": 5.23,
      "text": "Afternoon, doctor. They're in and comfortable, and I have the measurements ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.98,
      "end_seconds": 12.19,
      "duration_seconds": 5.21,
      "text": "So, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.19,
      "end_seconds": 24.59,
      "duration_seconds": 11.4,
      "text": "Good morning, doctor. I came along to help out. It's being very thirsty, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.17,
      "end_seconds": 27.63,
      "duration_seconds": 1.46,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 29.29,
      "end_seconds": 36.5,
      "duration_seconds": 7.21,
      "text": "For two months, I'd say. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.21,
      "end_seconds": 45.4,
      "duration_seconds": 8.19,
      "text": "Okay, can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.14,
      "end_seconds": 50.62,
      "duration_seconds": 4.48,
      "text": "Drinking water helps a bit. I'd call it moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 51.54,
      "end_seconds": 57.68,
      "duration_seconds": 6.14,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 57.78,
      "end_seconds": 64.73,
      "duration_seconds": 6.95,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.59,
      "end_seconds": 68.08,
      "duration_seconds": 2.49,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 68.72,
      "end_seconds": 83.2,
      "duration_seconds": 14.48,
      "text": "Sorry, what was I saying, as for recurrent thrush, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.27,
      "end_seconds": 88.01,
      "duration_seconds": 2.74,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 89.24,
      "end_seconds": 95.44,
      "duration_seconds": 6.2,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.32,
      "end_seconds": 102.05,
      "duration_seconds": 5.73,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.1,
      "end_seconds": 106.03,
      "duration_seconds": 2.93,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 107.26,
      "end_seconds": 110.7,
      "duration_seconds": 3.44,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.95,
      "end_seconds": 131.62,
      "duration_seconds": 5.67,
      "text": "Alright, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.19,
      "end_seconds": 135.62,
      "duration_seconds": 2.43,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.63,
      "end_seconds": 139.85,
      "duration_seconds": 3.22,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.87,
      "end_seconds": 147.05,
      "duration_seconds": 5.18,
      "text": "Atorvastatin. I take it 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 148.75,
      "end_seconds": 157.38,
      "duration_seconds": 8.63,
      "text": "Doctor, I think the last prescription for the atorvastatin was 10 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.91,
      "end_seconds": 163.18,
      "duration_seconds": 4.27,
      "text": "Okay, I see. Is the most recent prescription on you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.33,
      "end_seconds": 171.9,
      "duration_seconds": 7.57,
      "text": "Not with me. I'll bring it next time. It's valsartan, 80 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 173.77,
      "end_seconds": 182.32,
      "duration_seconds": 8.55,
      "text": "It's meant to be once a day, though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.59,
      "end_seconds": 186.27,
      "duration_seconds": 2.68,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 187.09,
      "end_seconds": 193.66,
      "duration_seconds": 6.57,
      "text": "High cholesterol, for two years. High blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.31,
      "end_seconds": 202.76,
      "duration_seconds": 8.45,
      "text": "Yes, carry on. Okay, I can see high cholesterol and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.64,
      "end_seconds": 215.33,
      "duration_seconds": 1.69,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.6,
      "end_seconds": 218.28,
      "duration_seconds": 1.68,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.07,
      "end_seconds": 222.83,
      "duration_seconds": 2.76,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 224.41,
      "end_seconds": 227.77,
      "duration_seconds": 3.36,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.9,
      "end_seconds": 232.37,
      "duration_seconds": 3.47,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.1,
      "end_seconds": 238.87,
      "duration_seconds": 4.77,
      "text": "My grandfather had a stroke. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.08,
      "end_seconds": 242.47,
      "duration_seconds": 2.39,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.31,
      "end_seconds": 249.03,
      "duration_seconds": 4.72,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.95,
      "end_seconds": 253.22,
      "duration_seconds": 3.27,
      "text": "Any vomiting, fruity smelling breath or confusion?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.24,
      "end_seconds": 269.17,
      "duration_seconds": 14.93,
      "text": "No, no vomiting, no fruity smelling breath, no confusion. I was passing a lot of urine at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.14,
      "end_seconds": 273.43,
      "duration_seconds": 2.29,
      "text": "Any chest pain or fever?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.29,
      "end_seconds": 278.35,
      "duration_seconds": 3.06,
      "text": "No, no chest pain or fever."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.55,
      "end_seconds": 281.26,
      "duration_seconds": 1.71,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 282.13,
      "end_seconds": 284.87,
      "duration_seconds": 2.74,
      "text": "No, uh, nothing there."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 286.95,
      "end_seconds": 299.48,
      "duration_seconds": 12.53,
      "text": "Okay, so the vitals from earlier. Pulse is 73 beats a minute, height 161 centimetres, respiratory rate 14. Weight 92 kilos, temperature is 36.8 degrees, BP is 152 over 100."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.77,
      "end_seconds": 302.22,
      "duration_seconds": 1.45,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.76,
      "end_seconds": 308.51,
      "duration_seconds": 3.75,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 310.35,
      "end_seconds": 311.3,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.21,
      "end_seconds": 316.24,
      "duration_seconds": 3.03,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.68,
      "end_seconds": 334.18,
      "duration_seconds": 6.5,
      "text": "Your fingerprick sugar here is high, and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.04,
      "end_seconds": 349.54,
      "duration_seconds": 11.5,
      "text": "Okay, that's enough for me. Having listened and examined, I'd lean towards symptoms that point to newly developed type 2 diabetes. Another possibility is a urine infection."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 350.32,
      "end_seconds": 354.17,
      "duration_seconds": 3.85,
      "text": "I've already done a urine test, it's ready for you."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.83,
      "end_seconds": 387.04,
      "duration_seconds": 31.21,
      "text": "Thanks, I'll have a look. I'd like to arrange a fasting blood sugar for thirst and polyuria. The treatment will be metformin, 500 milligrams, once a day with food, long term. You take it by mouth. That's for high blood sugar. Cut right down on sugary drinks and keep water with you. Let's get you seen by the diabetes educator, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.57,
      "end_seconds": 396.34,
      "duration_seconds": 8.77,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 398.08,
      "end_seconds": 398.99,
      "duration_seconds": 0.91,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.41,
      "end_seconds": 409.99,
      "duration_seconds": 9.58,
      "text": "Come back or go to emergency straight away if you are vomiting or feel confused. We'll catch up in two weeks."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.03,
      "end_seconds": 411.73,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.49,
      "end_seconds": 415.87,
      "duration_seconds": 3.38,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 417.14,
      "end_seconds": 419.95,
      "duration_seconds": 2.81,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}