{
  "schema_version": "1.0",
  "encounter_id": "01226",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.89,
      "end_seconds": 5.6,
      "duration_seconds": 4.71,
      "text": "hi, doctor, I came as soon as they called me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.2,
      "end_seconds": 10.32,
      "duration_seconds": 4.12,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.11,
      "end_seconds": 24.42,
      "duration_seconds": 13.31,
      "text": "Mainly pain in the lower right tummy. There's a couple of other things, but that's the main one. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.31,
      "end_seconds": 28.62,
      "duration_seconds": 3.31,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.12,
      "end_seconds": 32.25,
      "duration_seconds": 2.13,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.23,
      "end_seconds": 40.86,
      "duration_seconds": 7.63,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.82,
      "end_seconds": 50.22,
      "duration_seconds": 8.4,
      "text": "Mild, really. Only lying still, and and it's not much. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.8,
      "end_seconds": 54.41,
      "duration_seconds": 2.61,
      "text": "Okay, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.33,
      "end_seconds": 61.86,
      "duration_seconds": 6.53,
      "text": "A low fever goes along with it, um, most of the time"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.49,
      "end_seconds": 66.16,
      "duration_seconds": 2.67,
      "text": "so, how frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.13,
      "end_seconds": 71.06,
      "duration_seconds": 3.93,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.49,
      "end_seconds": 90.18,
      "duration_seconds": 3.69,
      "text": "Any hernia bulge, diarrhoea or burning when passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.48,
      "end_seconds": 95.45,
      "duration_seconds": 3.97,
      "text": "Um, no, not a single one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.25,
      "end_seconds": 99.1,
      "duration_seconds": 2.85,
      "text": "What about blood in the stool?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.34,
      "end_seconds": 105.29,
      "duration_seconds": 4.95,
      "text": "No, I haven't had any blood in the stool."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.82,
      "end_seconds": 108.24,
      "duration_seconds": 1.42,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.97,
      "end_seconds": 112.19,
      "duration_seconds": 2.22,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.05,
      "end_seconds": 126.73,
      "duration_seconds": 4.68,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.5,
      "end_seconds": 130.34,
      "duration_seconds": 2.84,
      "text": "not to my knowledge, no"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.07,
      "end_seconds": 134.25,
      "duration_seconds": 2.18,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.22,
      "end_seconds": 140.99,
      "duration_seconds": 5.77,
      "text": "I'm on rosuvastatin, 10 milligrams, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.36,
      "end_seconds": 142.11,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.74,
      "end_seconds": 146.78,
      "duration_seconds": 4.04,
      "text": "Paracetamol i take it 500 milligrams, when needed"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.63,
      "end_seconds": 151.89,
      "duration_seconds": 4.26,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.77,
      "end_seconds": 155.69,
      "duration_seconds": 2.92,
      "text": "High cholesterol, for two years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.59,
      "end_seconds": 166.16,
      "duration_seconds": 8.57,
      "text": "Mm-hmm. Right, so high cholesterol is already on your record. We'll keep that in mind today. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.21,
      "end_seconds": 168.36,
      "duration_seconds": 1.15,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.89,
      "end_seconds": 171.23,
      "duration_seconds": 2.34,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.67,
      "end_seconds": 176.66,
      "duration_seconds": 3.99,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.59,
      "end_seconds": 182.69,
      "duration_seconds": 4.1,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.61,
      "end_seconds": 188.24,
      "duration_seconds": 3.63,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.82,
      "end_seconds": 193.65,
      "duration_seconds": 3.83,
      "text": "Okay, what line of work are you in?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.29,
      "end_seconds": 200.23,
      "duration_seconds": 4.94,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.5,
      "end_seconds": 212.45,
      "duration_seconds": 2.95,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.96,
      "end_seconds": 223.92,
      "duration_seconds": 2.96,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.8,
      "end_seconds": 245.63,
      "duration_seconds": 8.83,
      "text": "okay: pressure 114 over 72, saturation 96 percent, temperature is 38.1 degrees and respiratory rate 19, pulse 104."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.48,
      "end_seconds": 252.12,
      "duration_seconds": 3.64,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.53,
      "end_seconds": 254.23,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.75,
      "end_seconds": 258.77,
      "duration_seconds": 3.02,
      "text": "okay, I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.2,
      "end_seconds": 278.08,
      "duration_seconds": 5.88,
      "text": "There's tenderness in the right lower part and it hurts when I let go suddenly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.19,
      "end_seconds": 282.02,
      "duration_seconds": 1.83,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.86,
      "end_seconds": 305.47,
      "duration_seconds": 10.61,
      "text": "Let me tell you where I've got to. This is probably possible appendicitis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.43,
      "end_seconds": 310.73,
      "duration_seconds": 3.3,
      "text": "I'm scared it's something bad is it?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.1,
      "end_seconds": 341.99,
      "duration_seconds": 29.89,
      "text": "Nothing I've seen today points to an emergency. It looks like possible appendicitis, but I'd like to confirm. Let's get a urine test, for abdominal pain. Please don't eat or drink anything until the surgeons have seen you. I'd like you to see the surgical team as well, and I'll write the referral. See me again today after the results. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.74,
      "end_seconds": 348.97,
      "duration_seconds": 3.23,
      "text": "I think I understand everything. Thanks."
    }
  ]
}