{
  "schema_version": "1.0",
  "encounter_id": "01200",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 4.02,
      "duration_seconds": 3.0,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.77,
      "end_seconds": 9.39,
      "duration_seconds": 3.62,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 17.86,
      "duration_seconds": 7.1,
      "text": "oh, it's a bump on my head. I thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.2,
      "end_seconds": 21.94,
      "duration_seconds": 2.74,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.47,
      "end_seconds": 25.98,
      "duration_seconds": 2.51,
      "text": "I've had it since Monday"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.8,
      "end_seconds": 28.81,
      "duration_seconds": 2.01,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.69,
      "end_seconds": 54.12,
      "duration_seconds": 23.43,
      "text": "When it starts I tend to get a headache since the fall as well. Yeah, the headache since the fall? That's been for five days. About headache since the fall, I'd say on and off. It settles a little with paracetamol."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.52,
      "end_seconds": 58.77,
      "duration_seconds": 4.25,
      "text": "Understood. Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.59,
      "end_seconds": 62.05,
      "duration_seconds": 1.46,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.89,
      "end_seconds": 65.38,
      "duration_seconds": 2.49,
      "text": "Right, how active are you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.06,
      "end_seconds": 69.55,
      "duration_seconds": 3.49,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.14,
      "end_seconds": 73.39,
      "duration_seconds": 3.25,
      "text": "Right, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.38,
      "end_seconds": 78.93,
      "duration_seconds": 3.55,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.85,
      "end_seconds": 83.28,
      "duration_seconds": 2.43,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.44,
      "end_seconds": 88.19,
      "duration_seconds": 3.75,
      "text": "Uh, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.59,
      "end_seconds": 93.46,
      "duration_seconds": 3.87,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.36,
      "end_seconds": 97.52,
      "duration_seconds": 2.16,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 101.19,
      "duration_seconds": 2.44,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.32,
      "end_seconds": 107.83,
      "duration_seconds": 5.51,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.84,
      "end_seconds": 115.56,
      "duration_seconds": 5.72,
      "text": "A few quick ones: vomiting, clear fluid from the nose or ear or confusion?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.03,
      "end_seconds": 119.56,
      "duration_seconds": 2.53,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.23,
      "end_seconds": 125.12,
      "duration_seconds": 3.89,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.72,
      "end_seconds": 128.89,
      "duration_seconds": 2.17,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.58,
      "end_seconds": 131.8,
      "duration_seconds": 2.22,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.3,
      "end_seconds": 133.21,
      "duration_seconds": 0.91,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.73,
      "end_seconds": 149.82,
      "duration_seconds": 3.09,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.38,
      "end_seconds": 165.45,
      "duration_seconds": 2.07,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.65,
      "end_seconds": 196.31,
      "duration_seconds": 9.66,
      "text": "Okay: BP is 109 over 78, pulse is 73 beats a minute. And oxygen saturation is 99 percent, temperature is 36.5 degrees."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.37,
      "end_seconds": 200.03,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.19,
      "end_seconds": 204.0,
      "duration_seconds": 2.81,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.44,
      "end_seconds": 208.45,
      "duration_seconds": 2.01,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.13,
      "end_seconds": 211.42,
      "duration_seconds": 1.29,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.0,
      "end_seconds": 227.35,
      "duration_seconds": 8.35,
      "text": "there is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.28,
      "end_seconds": 235.44,
      "duration_seconds": 2.16,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.17,
      "end_seconds": 262.45,
      "duration_seconds": 8.28,
      "text": "let me tell you where I've got to the most likely explanation is a minor head injury without worrying signs"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.83,
      "end_seconds": 289.47,
      "duration_seconds": 8.64,
      "text": "You'll be taking paracetamol, 1 gram, every six hours if needed, for three days. It's for headache."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.93,
      "end_seconds": 295.31,
      "duration_seconds": 4.38,
      "text": "Alright, um, I'll pick it up today."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.25,
      "end_seconds": 303.46,
      "duration_seconds": 6.21,
      "text": "Someone should stay with you tonight, and no alcohol or contact sport for now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.93,
      "end_seconds": 327.75,
      "duration_seconds": 23.82,
      "text": "Hm, okay. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. One warning sign to remember: you vomit repeatedly, become drowsy or confused, or have a fit. In that case don't wait. Come back if the headache gets worse."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 329.57,
      "end_seconds": 334.18,
      "duration_seconds": 4.61,
      "text": "I'll book your follow-up at the front desk on your way out."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.32,
      "end_seconds": 338.53,
      "duration_seconds": 3.21,
      "text": "I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.73,
      "end_seconds": 344.49,
      "duration_seconds": 4.76,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.74,
      "end_seconds": 347.19,
      "duration_seconds": 1.45,
      "text": "Take care now."
    }
  ]
}