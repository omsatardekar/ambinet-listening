{
  "schema_version": "1.0",
  "encounter_id": "01227",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 2.62,
      "duration_seconds": 1.61,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.53,
      "end_seconds": 9.01,
      "duration_seconds": 4.48,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.91,
      "end_seconds": 16.15,
      "duration_seconds": 6.24,
      "text": "Honestly, it's drenching night sweats, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.72,
      "end_seconds": 18.89,
      "duration_seconds": 1.17,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.29,
      "end_seconds": 25.16,
      "duration_seconds": 4.87,
      "text": "Around three weeks... no wait, it's more like two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.38,
      "end_seconds": 30.78,
      "duration_seconds": 4.4,
      "text": "Okay, any a low fever in the evenings as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.05,
      "end_seconds": 40.82,
      "duration_seconds": 8.77,
      "text": "Yeah. About four days, I'd say. With low fever in the evenings, moderate, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.81,
      "end_seconds": 48.7,
      "duration_seconds": 5.89,
      "text": "So, any diarrhoea, recent travel, chest pain or joint pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.44,
      "end_seconds": 57.26,
      "duration_seconds": 6.82,
      "text": "I haven't had diarrhoea, recent travel, chest pain or joint pain, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.65,
      "end_seconds": 61.61,
      "duration_seconds": 2.96,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.48,
      "end_seconds": 64.41,
      "duration_seconds": 1.93,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.56,
      "end_seconds": 78.49,
      "duration_seconds": 1.93,
      "text": "Right, how about smoking?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.64,
      "end_seconds": 83.27,
      "duration_seconds": 3.63,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 87.54,
      "duration_seconds": 2.82,
      "text": "So, tell me about your eating."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.5,
      "end_seconds": 93.56,
      "duration_seconds": 5.06,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.03,
      "end_seconds": 97.77,
      "duration_seconds": 2.74,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.61,
      "end_seconds": 101.81,
      "duration_seconds": 3.2,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.72,
      "end_seconds": 106.13,
      "duration_seconds": 2.41,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.63,
      "end_seconds": 112.06,
      "duration_seconds": 4.43,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.97,
      "end_seconds": 116.52,
      "duration_seconds": 2.55,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.14,
      "end_seconds": 127.93,
      "duration_seconds": 9.79,
      "text": "I had a reaction to tramadol when I was younger, feeling very drowsy, and I've avoided it since."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.41,
      "end_seconds": 138.18,
      "duration_seconds": 4.77,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.67,
      "end_seconds": 144.66,
      "duration_seconds": 4.99,
      "text": "I'm on Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.29,
      "end_seconds": 161.0,
      "duration_seconds": 3.71,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.65,
      "end_seconds": 164.33,
      "duration_seconds": 1.68,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.43,
      "end_seconds": 169.81,
      "duration_seconds": 4.38,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.11,
      "end_seconds": 179.48,
      "duration_seconds": 2.37,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.8,
      "end_seconds": 213.39,
      "duration_seconds": 15.59,
      "text": "Okay: height 158 centimetres, temp 38.5 degrees, SpO2 98 percent on room air, weight 81 kilos, BP is 105 over 77, BMI works out to 32.4, pulse is 97 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.15,
      "end_seconds": 215.52,
      "duration_seconds": 1.37,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.87,
      "end_seconds": 219.6,
      "duration_seconds": 2.73,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.3,
      "end_seconds": 225.44,
      "duration_seconds": 4.14,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.57,
      "end_seconds": 229.03,
      "duration_seconds": 2.46,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.13,
      "end_seconds": 243.08,
      "duration_seconds": 1.95,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.99,
      "end_seconds": 246.36,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.27,
      "end_seconds": 265.56,
      "duration_seconds": 6.29,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 269.36,
      "end_seconds": 270.06,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.54,
      "end_seconds": 277.06,
      "duration_seconds": 2.52,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.58,
      "end_seconds": 300.56,
      "duration_seconds": 7.98,
      "text": "Taking everything into account, this is probably an enlarged gland with night sweats that needs a proper work-up."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.95,
      "end_seconds": 334.26,
      "duration_seconds": 15.31,
      "text": "I'd like to arrange a chest X-ray for night sweats. Keep a note of your temperature each evening. Book a review after the results are back. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.18,
      "end_seconds": 339.67,
      "duration_seconds": 3.49,
      "text": "Right, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.63,
      "end_seconds": 342.38,
      "duration_seconds": 1.75,
      "text": "Okay, look after yourself."
    }
  ]
}