  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.14,
      "end_seconds": 5.38,
      "duration_seconds": 4.24,
      "text": "Hello, uh, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 9.75,
      "duration_seconds": 3.63,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 20.3,
      "duration_seconds": 8.57,
      "text": "Sorry, what was I saying, doctor, it's hot flushes. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.21,
      "end_seconds": 24.29,
      "duration_seconds": 3.08,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.28,
      "end_seconds": 34.62,
      "duration_seconds": 9.34,
      "text": "Yeah, it's been going on for two weeks. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.93,
      "end_seconds": 41.35,
      "duration_seconds": 6.42,
      "text": "Yes, carry on. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.32,
      "end_seconds": 61.47,
      "duration_seconds": 18.15,
      "text": "Oh, um, it happens a few times a day. I notice it more with caffeine and warm rooms. Mostly moderate. I've also had poor sleep, for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.34,
      "end_seconds": 65.43,
      "duration_seconds": 3.09,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.52,
      "end_seconds": 67.57,
      "duration_seconds": 1.05,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.04,
      "end_seconds": 68.74,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.99,
      "end_seconds": 83.23,
      "duration_seconds": 2.24,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.89,
      "end_seconds": 94.85,
      "duration_seconds": 1.96,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.87,
      "end_seconds": 116.28,
      "duration_seconds": 9.41,
      "text": "Okay: saturation 97 percent, pulse is 68 beats a minute. And BP is 122 over 77, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.65,
      "end_seconds": 121.04,
      "duration_seconds": 3.39,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.72,
      "end_seconds": 124.21,
      "duration_seconds": 1.49,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.15,
      "end_seconds": 127.46,
      "duration_seconds": 1.31,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 148.91,
      "duration_seconds": 7.01,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.91,
      "end_seconds": 158.24,
      "duration_seconds": 5.33,
      "text": "All finished, thank you. Have you noticed chest pain or heavy bleeding?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.12,
      "end_seconds": 165.54,
      "duration_seconds": 5.42,
      "text": "Actually, no chest pain or heavy bleeding, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.39,
      "end_seconds": 172.2,
      "duration_seconds": 4.81,
      "text": "Any bleeding after sex, weight loss or palpitations at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.16,
      "end_seconds": 178.77,
      "duration_seconds": 4.61,
      "text": "Hmm, you know, no, nothing to report there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.75,
      "end_seconds": 181.93,
      "duration_seconds": 2.18,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.42,
      "end_seconds": 185.11,
      "duration_seconds": 1.69,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.05,
      "end_seconds": 189.89,
      "duration_seconds": 3.84,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.91,
      "end_seconds": 192.54,
      "duration_seconds": 1.63,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.23,
      "end_seconds": 195.76,
      "duration_seconds": 2.53,
      "text": "Right, any regular medication at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.51,
      "end_seconds": 200.47,
      "duration_seconds": 2.96,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.18,
      "end_seconds": 206.84,
      "duration_seconds": 4.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.53,
      "end_seconds": 220.58,
      "duration_seconds": 12.05,
      "text": "Lots of rice, lentils and some fruit. I live with my elderly mother. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.11,
      "end_seconds": 223.62,
      "duration_seconds": 2.51,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.52,
      "end_seconds": 227.93,
      "duration_seconds": 2.41,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.19,
      "end_seconds": 239.88,
      "duration_seconds": 10.69,
      "text": "Understood. Right, so thin bones is already on your record. We'll keep that in mind today. Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.28,
      "end_seconds": 243.86,
      "duration_seconds": 2.58,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.1,
      "end_seconds": 261.01,
      "duration_seconds": 4.91,
      "text": "So where does that leave us? It fits best with perimenopausal symptoms."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.14,
      "end_seconds": 265.53,
      "duration_seconds": 3.39,
      "text": "Hmm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.41,
      "end_seconds": 276.88,
      "duration_seconds": 7.47,
      "text": "Nothing I've seen today points to an emergency. It looks like perimenopausal symptoms, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.41,
      "end_seconds": 316.34,
      "duration_seconds": 24.93,
      "text": "I'm sending you for a thyroid test because of hot flushes. Let's book a bone density scan to look into menopause. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.64,
      "end_seconds": 320.82,
      "duration_seconds": 3.18,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.41,
      "end_seconds": 323.61,
      "duration_seconds": 1.2,
      "text": "Look after yourself."
    }
  ]
}