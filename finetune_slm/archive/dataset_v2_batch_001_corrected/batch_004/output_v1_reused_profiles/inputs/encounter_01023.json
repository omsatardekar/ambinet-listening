{
  "schema_version": "1.0",
  "encounter_id": "01023",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 5.37,
      "duration_seconds": 4.72,
      "text": "Actually, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.2,
      "end_seconds": 12.64,
      "duration_seconds": 5.44,
      "text": "okay, you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.98,
      "end_seconds": 19.53,
      "duration_seconds": 5.55,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.37,
      "end_seconds": 29.59,
      "duration_seconds": 5.22,
      "text": "Well, I've been having burning when I pass urine."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.73,
      "end_seconds": 37.42,
      "duration_seconds": 6.69,
      "text": "How long has it been like this? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.98,
      "end_seconds": 46.45,
      "duration_seconds": 7.47,
      "text": "probably about a week yeah there's a sudden urgent need to go as well"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.1,
      "end_seconds": 54.08,
      "duration_seconds": 5.98,
      "text": "Have you had burning when you pass urine before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.9,
      "end_seconds": 64.08,
      "duration_seconds": 8.18,
      "text": "Well, a bit, a couple of years ago. It It settled by itself back then."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.17,
      "end_seconds": 83.84,
      "duration_seconds": 1.67,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.94,
      "end_seconds": 89.76,
      "duration_seconds": 4.82,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.5,
      "end_seconds": 92.88,
      "duration_seconds": 2.38,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.38,
      "end_seconds": 98.2,
      "duration_seconds": 3.82,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.08,
      "end_seconds": 104.19,
      "duration_seconds": 4.11,
      "text": "okay, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 113.9,
      "duration_seconds": 7.64,
      "text": "I have diabetes, for two years. I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.47,
      "end_seconds": 118.58,
      "duration_seconds": 4.11,
      "text": "alright, diabetes, that matches what I have here"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.78,
      "end_seconds": 130.85,
      "duration_seconds": 3.07,
      "text": "so, tell me your medicines, please"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 131.51,
      "end_seconds": 140.93,
      "duration_seconds": 9.42,
      "text": "It's Glycomet, 500 milligrams, twice a day, doctor. She is on paracetamol, when needed, I give it to her."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.98,
      "end_seconds": 144.05,
      "duration_seconds": 2.07,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 145.33,
      "end_seconds": 146.2,
      "duration_seconds": 0.87,
      "text": "650 milligrams"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.44,
      "end_seconds": 151.19,
      "duration_seconds": 3.75,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.76,
      "end_seconds": 155.13,
      "duration_seconds": 3.37,
      "text": "no, I'm not allergic to anything"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.87,
      "end_seconds": 157.88,
      "duration_seconds": 2.01,
      "text": "Any loin pain or fever?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.74,
      "end_seconds": 162.66,
      "duration_seconds": 2.92,
      "text": "no, not a a single one"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.38,
      "end_seconds": 173.8,
      "duration_seconds": 7.42,
      "text": "Let me check a a few things. Any vaginal discharge, blood in the urine or vomiting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.34,
      "end_seconds": 181.28,
      "duration_seconds": 2.94,
      "text": "ah, nope, nothing like that that"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.23,
      "end_seconds": 186.14,
      "duration_seconds": 2.91,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.13,
      "end_seconds": 190.32,
      "duration_seconds": 2.19,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.05,
      "end_seconds": 193.13,
      "duration_seconds": 2.08,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.77,
      "end_seconds": 195.34,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.66,
      "end_seconds": 206.56,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.69,
      "end_seconds": 217.96,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.21,
      "end_seconds": 243.54,
      "duration_seconds": 7.33,
      "text": "okay: pulse is 71 beats a minute, temp 36.6 degrees, blood pressure 114 over 79."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.74,
      "end_seconds": 248.44,
      "duration_seconds": 3.7,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.44,
      "end_seconds": 251.68,
      "duration_seconds": 1.24,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.37,
      "end_seconds": 255.46,
      "duration_seconds": 2.09,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.25,
      "end_seconds": 274.94,
      "duration_seconds": 6.69,
      "text": "Your tummy is soft with mild tenderness low down and no pain in the loins."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.06,
      "end_seconds": 290.11,
      "duration_seconds": 11.05,
      "text": "that's the examination finished. So where does that leave us? I'd lean towards a lower urinary tract infection. I can't rule out a kidney infection yet"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.99,
      "end_seconds": 294.16,
      "duration_seconds": 3.17,
      "text": "okay, so will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.44,
      "end_seconds": 329.52,
      "duration_seconds": 34.08,
      "text": "I understand the worry. At the the moment I'd say it's a lower urinary tract infection, and we'll know more once the a urine test is back. I think a urine test makes sense here, for dysuria. I want a urine culture done, that's for recurrent urinary infection. For this, nitrofurantoin, 100 milligrams, twice a day, for three days. You take it by mouth. That should help with urinary infection."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.16,
      "end_seconds": 332.72,
      "duration_seconds": 1.56,
      "text": "thank you, doctor"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.77,
      "end_seconds": 349.01,
      "duration_seconds": 15.24,
      "text": "Drink plenty of water and don't hold on when you need to go. Please come and see me after the culture result. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.07,
      "end_seconds": 351.67,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    }
  ]
}