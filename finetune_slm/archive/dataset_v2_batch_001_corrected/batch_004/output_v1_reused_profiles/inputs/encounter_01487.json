{
  "schema_version": "1.0",
  "encounter_id": "01487",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 6.64,
      "duration_seconds": 5.53,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.58,
      "end_seconds": 13.06,
      "duration_seconds": 4.48,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.56,
      "end_seconds": 21.27,
      "duration_seconds": 3.71,
      "text": "right, I've been dealing with loud snoring"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.88,
      "end_seconds": 25.02,
      "duration_seconds": 2.14,
      "text": "any regular medication at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.37,
      "end_seconds": 27.55,
      "duration_seconds": 1.18,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.6,
      "end_seconds": 32.88,
      "duration_seconds": 3.28,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.58,
      "end_seconds": 43.85,
      "duration_seconds": 9.27,
      "text": "yeah, uh, I've had it for two years. I took the morning off to come in today"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.29,
      "end_seconds": 47.84,
      "duration_seconds": 2.55,
      "text": "okay, is anything making it worse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.12,
      "end_seconds": 53.99,
      "duration_seconds": 4.87,
      "text": "I notice it more with lying on my back."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.59,
      "end_seconds": 59.0,
      "duration_seconds": 3.41,
      "text": "Have you been feeling sleepy during the day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.3,
      "end_seconds": 62.85,
      "duration_seconds": 2.55,
      "text": "yes, for about a month"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.02,
      "end_seconds": 82.86,
      "duration_seconds": 7.84,
      "text": "let me check a few things. Any choking at night, palpitations, leg swelling or low mood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.16,
      "end_seconds": 87.06,
      "duration_seconds": 2.9,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.17,
      "end_seconds": 91.74,
      "duration_seconds": 3.57,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.4,
      "end_seconds": 93.95,
      "duration_seconds": 1.55,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.19,
      "end_seconds": 108.89,
      "duration_seconds": 3.7,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.91,
      "end_seconds": 113.93,
      "duration_seconds": 4.02,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.33,
      "end_seconds": 117.22,
      "duration_seconds": 1.89,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.82,
      "end_seconds": 121.57,
      "duration_seconds": 2.75,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.66,
      "end_seconds": 124.69,
      "duration_seconds": 2.03,
      "text": "Okay, what's your work?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.83,
      "end_seconds": 130.2,
      "duration_seconds": 4.37,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.55,
      "end_seconds": 133.99,
      "duration_seconds": 2.44,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.61,
      "end_seconds": 139.06,
      "duration_seconds": 4.45,
      "text": "I'm allergic to grass pollen, I get itchy eyes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.92,
      "end_seconds": 143.12,
      "duration_seconds": 2.2,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.95,
      "end_seconds": 151.57,
      "duration_seconds": 7.62,
      "text": "I've had high blood pressure for about ten years now. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.24,
      "end_seconds": 163.61,
      "duration_seconds": 1.37,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.13,
      "end_seconds": 167.28,
      "duration_seconds": 2.15,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.06,
      "end_seconds": 173.0,
      "duration_seconds": 3.94,
      "text": "right, I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.34,
      "end_seconds": 187.29,
      "duration_seconds": 1.95,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.35,
      "end_seconds": 211.7,
      "duration_seconds": 10.35,
      "text": "Okay: temperature 37.0, SpO2 96 percent on room air. And BP is 158 over 100, respiratory rate 16, pulse 86."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.3,
      "end_seconds": 214.65,
      "duration_seconds": 2.35,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.29,
      "end_seconds": 228.73,
      "duration_seconds": 13.44,
      "text": "okay, I'll explain what these mean in a moment okay, so my impression from what you've said is this: This is probably symptoms that suggest obstructive sleep apnoea"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 229.49,
      "end_seconds": 232.57,
      "duration_seconds": 3.08,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.11,
      "end_seconds": 253.97,
      "duration_seconds": 20.86,
      "text": "It's reasonable to be concerned, but right now symptoms that suggest obstructive sleep apnoea is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had loud snoring for two years, and no choking at night or palpitations."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.54,
      "end_seconds": 256.15,
      "duration_seconds": 1.61,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.13,
      "end_seconds": 261.38,
      "duration_seconds": 3.25,
      "text": "Let's get a thyroid test, for tiredness."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 262.22,
      "end_seconds": 264.69,
      "duration_seconds": 2.47,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.29,
      "end_seconds": 289.93,
      "duration_seconds": 23.64,
      "text": "I want an overnight sleep study done, that's for suspected sleep apnoea try to sleep on your side and avoid alcohol close to bedtime avoid taking any extra painkillers on top of what I'm prescribing without checking with us let's get you seen by the sleep clinic, I'll arrange the letter"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.09,
      "end_seconds": 293.71,
      "duration_seconds": 2.62,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.22,
      "end_seconds": 301.02,
      "duration_seconds": 6.8,
      "text": "One warning sign to remember: you feel sleepy while driving. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.29,
      "end_seconds": 310.32,
      "duration_seconds": 3.03,
      "text": "I know what to watch for"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.17,
      "end_seconds": 314.54,
      "duration_seconds": 2.37,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.09,
      "end_seconds": 321.13,
      "duration_seconds": 2.04,
      "text": "thank you, that's helpful"
    }
  ]
}