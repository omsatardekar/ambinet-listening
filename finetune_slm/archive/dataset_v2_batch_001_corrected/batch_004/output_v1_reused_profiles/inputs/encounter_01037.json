{
  "schema_version": "1.0",
  "encounter_id": "01037",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.83,
      "end_seconds": 3.3,
      "duration_seconds": 2.47,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.38,
      "end_seconds": 6.46,
      "duration_seconds": 1.08,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.43,
      "end_seconds": 16.94,
      "duration_seconds": 5.51,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.24,
      "end_seconds": 24.58,
      "duration_seconds": 6.34,
      "text": "Yes, that's no problem at all. Please sit. Right, what do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 34.3,
      "duration_seconds": 8.13,
      "text": "Mainly a fit last month. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.26,
      "end_seconds": 40.08,
      "duration_seconds": 4.82,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.94,
      "end_seconds": 56.15,
      "duration_seconds": 2.21,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.58,
      "end_seconds": 82.32,
      "duration_seconds": 12.74,
      "text": "Okay: SpO2 97 percent on room air, pressure 114 over 82, heart rate 67, respiratory rate 18, temp 36.9 degrees. Did it come on recently?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.82,
      "end_seconds": 87.05,
      "duration_seconds": 3.23,
      "text": "About two weeks, give or take."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 88.23,
      "end_seconds": 91.75,
      "duration_seconds": 3.52,
      "text": "Hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.03,
      "end_seconds": 97.13,
      "duration_seconds": 4.1,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.02,
      "end_seconds": 100.93,
      "duration_seconds": 1.91,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.6,
      "end_seconds": 104.91,
      "duration_seconds": 3.31,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.75,
      "end_seconds": 110.29,
      "duration_seconds": 3.54,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.9,
      "end_seconds": 114.52,
      "duration_seconds": 2.62,
      "text": "Have you been biting your tongue?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.59,
      "end_seconds": 124.4,
      "duration_seconds": 8.81,
      "text": "Yeah. Ten days, I'd say. With biting my tongue, a eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.65,
      "end_seconds": 138.75,
      "duration_seconds": 5.1,
      "text": "Any fever, weakness on one side, loss of bladder control or headache?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.29,
      "end_seconds": 146.9,
      "duration_seconds": 7.61,
      "text": "No, no fever, weakness on one side, loss of bladder control or headache."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.5,
      "end_seconds": 149.7,
      "duration_seconds": 2.2,
      "text": "Okay, nothing like head injury?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.16,
      "end_seconds": 153.2,
      "duration_seconds": 2.04,
      "text": "Definitely no head injury."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.38,
      "end_seconds": 157.29,
      "duration_seconds": 2.91,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 158.37,
      "end_seconds": 162.16,
      "duration_seconds": 3.79,
      "text": "No, you know, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.57,
      "end_seconds": 182.5,
      "duration_seconds": 2.93,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.1,
      "end_seconds": 188.03,
      "duration_seconds": 3.93,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.8,
      "end_seconds": 190.19,
      "duration_seconds": 1.39,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.79,
      "end_seconds": 194.96,
      "duration_seconds": 3.17,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.14,
      "end_seconds": 209.37,
      "duration_seconds": 3.23,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 210.95,
      "end_seconds": 217.79,
      "duration_seconds": 6.84,
      "text": "He is on lamotrigine, 100 milligrams, twice a day, I give it to him."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.91,
      "end_seconds": 225.11,
      "duration_seconds": 6.2,
      "text": "Uh, you know, before this I was on carbamazepine; that's been stopped."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.65,
      "end_seconds": 229.2,
      "duration_seconds": 3.55,
      "text": "Okay, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.71,
      "end_seconds": 231.81,
      "duration_seconds": 2.1,
      "text": "Epilepsy, for five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.48,
      "end_seconds": 237.8,
      "duration_seconds": 4.32,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.85,
      "end_seconds": 240.15,
      "duration_seconds": 1.3,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.22,
      "end_seconds": 253.25,
      "duration_seconds": 3.03,
      "text": "You're alert and orientated, speech is clear."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.05,
      "end_seconds": 277.83,
      "duration_seconds": 19.78,
      "text": "Thank you, you can get dressed. Okay, thinking it through, I think we're dealing with breakthrough seizure on known epilepsy at this stage. A provoked seizure from missed medication is still possible. I want an MRI of the brain done, that's for seizure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.55,
      "end_seconds": 280.04,
      "duration_seconds": 1.49,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.32,
      "end_seconds": 305.79,
      "duration_seconds": 24.47,
      "text": "I think a blood level of the tablet makes sense here, for adherence check. I want an EEG done, that's for seizure. Never skip the tablets, and set a phone alarm if it helps. No driving until we've reviewed you again, I'm sorry, but that's the rule. We'll refer you to the epilepsy clinic."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.37,
      "end_seconds": 308.07,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.45,
      "end_seconds": 315.15,
      "duration_seconds": 3.7,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.74,
      "end_seconds": 317.66,
      "duration_seconds": 1.92,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.44,
      "end_seconds": 319.67,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
}