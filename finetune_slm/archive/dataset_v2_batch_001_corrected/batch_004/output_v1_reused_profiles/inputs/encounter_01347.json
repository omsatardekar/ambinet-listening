{
  "schema_version": "1.0",
  "encounter_id": "01347",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.37,
      "duration_seconds": 4.04,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.2,
      "end_seconds": 12.66,
      "duration_seconds": 4.46,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.16,
      "end_seconds": 16.65,
      "duration_seconds": 2.49,
      "text": "It's a hoarse voice, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.3,
      "end_seconds": 24.46,
      "duration_seconds": 3.16,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.68,
      "end_seconds": 28.61,
      "duration_seconds": 2.93,
      "text": "for four weeks, I'd say"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.99,
      "end_seconds": 29.69,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.47,
      "end_seconds": 36.83,
      "duration_seconds": 5.36,
      "text": "I've had a dry tickly cough too, for about a year"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.63,
      "end_seconds": 39.37,
      "duration_seconds": 1.74,
      "text": "does anything help it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.44,
      "end_seconds": 45.29,
      "duration_seconds": 3.85,
      "text": "It settles a little with sips of water."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.89,
      "end_seconds": 48.41,
      "duration_seconds": 2.52,
      "text": "Mm, okay. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.17,
      "end_seconds": 52.43,
      "duration_seconds": 2.26,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.79,
      "end_seconds": 69.41,
      "duration_seconds": 4.62,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.88,
      "end_seconds": 74.52,
      "duration_seconds": 3.64,
      "text": "Cough syrup. I take it at night."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.41,
      "end_seconds": 91.7,
      "duration_seconds": 1.29,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.3,
      "end_seconds": 96.63,
      "duration_seconds": 4.33,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.57,
      "end_seconds": 99.99,
      "duration_seconds": 2.42,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.77,
      "end_seconds": 107.03,
      "duration_seconds": 5.26,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.75,
      "end_seconds": 110.54,
      "duration_seconds": 2.79,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.04,
      "end_seconds": 117.43,
      "duration_seconds": 5.39,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.38,
      "end_seconds": 137.83,
      "duration_seconds": 3.45,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.65,
      "end_seconds": 146.55,
      "duration_seconds": 2.9,
      "text": "mm, my sister had breast cancer"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.48,
      "end_seconds": 152.11,
      "duration_seconds": 3.63,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.07,
      "end_seconds": 157.18,
      "duration_seconds": 4.11,
      "text": "Ah, no, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.14,
      "end_seconds": 163.04,
      "duration_seconds": 3.9,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.68,
      "end_seconds": 166.41,
      "duration_seconds": 2.73,
      "text": "Not really, uh, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.39,
      "end_seconds": 177.11,
      "duration_seconds": 1.72,
      "text": "Any wheeze or heartburn?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.41,
      "end_seconds": 182.16,
      "duration_seconds": 3.75,
      "text": "I haven't had wheeze or heartburn, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.56,
      "end_seconds": 188.86,
      "duration_seconds": 2.3,
      "text": "any weight loss or fever?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.41,
      "end_seconds": 191.39,
      "duration_seconds": 1.98,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.97,
      "end_seconds": 194.45,
      "duration_seconds": 1.48,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.01,
      "end_seconds": 198.64,
      "duration_seconds": 3.63,
      "text": "Well, um, no, that's all normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 200.17,
      "end_seconds": 209.63,
      "duration_seconds": 9.46,
      "text": "Here are the numbers, doctor. Respiratory rate 15, temperature 36.8, saturation 99 percent. BP is 111 over 82, heart rate 71."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.68,
      "end_seconds": 211.38,
      "duration_seconds": 0.7,
      "text": "thanks"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.21,
      "end_seconds": 216.94,
      "duration_seconds": 2.73,
      "text": "right, shall I start the examination?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.23,
      "end_seconds": 221.15,
      "duration_seconds": 2.92,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.68,
      "end_seconds": 238.85,
      "duration_seconds": 4.17,
      "text": "Your chest is clear and there is no wheeze."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.57,
      "end_seconds": 275.87,
      "duration_seconds": 31.3,
      "text": "Good, you can sit up again. Having listened and examined, I can't pin this down yet. We're looking at a persistent dry cough without a clear cause so far or reflux. I'm sending you for a breathing test because of cough. That will help us see what's going on underneath and decide the next step. We will review your tablets and see whether the cough settles over a month."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.59,
      "end_seconds": 288.26,
      "duration_seconds": 11.67,
      "text": "Please don't wait if you cough up blood or lose weight. That's when to be seen urgently. I'd like to see you again in six weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.83,
      "end_seconds": 291.59,
      "duration_seconds": 1.76,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.25,
      "end_seconds": 296.49,
      "duration_seconds": 3.24,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.09,
      "end_seconds": 301.0,
      "duration_seconds": 3.91,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}