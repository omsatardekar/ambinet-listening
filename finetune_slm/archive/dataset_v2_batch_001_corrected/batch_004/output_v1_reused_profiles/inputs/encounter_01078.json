{
  "schema_version": "1.0",
  "encounter_id": "01078",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 3.19,
      "duration_seconds": 2.43,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.22,
      "end_seconds": 7.77,
      "duration_seconds": 3.55,
      "text": "morning, doctor, sorry about the rush"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.52,
      "end_seconds": 15.36,
      "duration_seconds": 3.84,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.46,
      "end_seconds": 26.06,
      "duration_seconds": 8.6,
      "text": "Yes, that's no problem at all. Please sit. Right, what would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.28,
      "end_seconds": 33.96,
      "duration_seconds": 6.68,
      "text": "Doctor, you know, it's skipped beats. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.85,
      "end_seconds": 38.55,
      "duration_seconds": 3.7,
      "text": "Okay, how long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.91,
      "end_seconds": 43.25,
      "duration_seconds": 3.34,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.47,
      "end_seconds": 47.83,
      "duration_seconds": 3.36,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.59,
      "end_seconds": 51.97,
      "duration_seconds": 2.38,
      "text": "I'd call it moderate"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.38,
      "end_seconds": 55.77,
      "duration_seconds": 2.39,
      "text": "how frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.9,
      "end_seconds": 87.24,
      "duration_seconds": 30.34,
      "text": "It happens once or twice a day. Yeah, and I've been feeling anxious about it as well. With feeling anxious about it, I'd give it a six, out of ten. I've also had poor sleep, for ten days. Right, as for poor sleep, I'd call it moderate. Oh, and occasional lightheadedness. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.11,
      "end_seconds": 90.21,
      "duration_seconds": 2.1,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.78,
      "end_seconds": 98.09,
      "duration_seconds": 6.31,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.41,
      "end_seconds": 102.35,
      "duration_seconds": 2.94,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.42,
      "end_seconds": 107.53,
      "duration_seconds": 4.11,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.89,
      "end_seconds": 110.45,
      "duration_seconds": 1.56,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.53,
      "end_seconds": 115.53,
      "duration_seconds": 3.0,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.14,
      "end_seconds": 120.44,
      "duration_seconds": 3.3,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.3,
      "end_seconds": 127.83,
      "duration_seconds": 6.53,
      "text": "My daughter has type 1 diabetes. Ah, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.98,
      "end_seconds": 135.47,
      "duration_seconds": 6.49,
      "text": "What do you take on a normal day? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.12,
      "end_seconds": 144.39,
      "duration_seconds": 8.27,
      "text": "I'm on Thyronorm, 50 micrograms, every morning. It's escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 146.09,
      "end_seconds": 155.1,
      "duration_seconds": 9.01,
      "text": "it's meant to be once a day, though I don't see he take it every time"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.5,
      "end_seconds": 175.8,
      "duration_seconds": 4.3,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.33,
      "end_seconds": 180.89,
      "duration_seconds": 4.56,
      "text": "Yes, amoxicillin. I get a rash all over."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.91,
      "end_seconds": 183.95,
      "duration_seconds": 2.04,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.12,
      "end_seconds": 192.0,
      "duration_seconds": 6.88,
      "text": "Um, I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.4,
      "end_seconds": 195.82,
      "duration_seconds": 2.42,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.76,
      "end_seconds": 207.41,
      "duration_seconds": 9.65,
      "text": "I have an underactive thyroid. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.14,
      "end_seconds": 209.33,
      "duration_seconds": 1.19,
      "text": "any other things?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.43,
      "end_seconds": 213.42,
      "duration_seconds": 2.99,
      "text": "Anxiety, for about ten years."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.78,
      "end_seconds": 231.4,
      "duration_seconds": 16.62,
      "text": "Okay, go on. Right, so an underactive thyroid and anxiety are already on your record. We'll keep that in mind today. Alright, did you get chest pain, family history of sudden death, breathlessness or fainting?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.04,
      "end_seconds": 240.78,
      "duration_seconds": 7.74,
      "text": "No, no chest pain, family history of sudden death, breathlessness or fainting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.59,
      "end_seconds": 246.43,
      "duration_seconds": 3.84,
      "text": "And what about energy drinks or leg swelling?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.07,
      "end_seconds": 252.95,
      "duration_seconds": 4.88,
      "text": "no energy drinks or leg swelling, none of it"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.93,
      "end_seconds": 257.42,
      "duration_seconds": 2.49,
      "text": "So, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 266.34,
      "duration_seconds": 2.99,
      "text": "Oh, no, joints are fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.85,
      "end_seconds": 268.82,
      "duration_seconds": 1.97,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.27,
      "end_seconds": 272.52,
      "duration_seconds": 2.25,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.58,
      "end_seconds": 275.97,
      "duration_seconds": 2.39,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.68,
      "end_seconds": 286.81,
      "duration_seconds": 3.13,
      "text": "Right, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.01,
      "end_seconds": 315.86,
      "duration_seconds": 15.85,
      "text": "Okay: weight 77 kilos, saturation 98 percent. And pulse 77, BMI works out to to 22.3, BP is 128 over 78, respiratory rate 15, height 186 centimetres, temperature 36.9."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.49,
      "end_seconds": 317.95,
      "duration_seconds": 1.46,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.3,
      "end_seconds": 324.22,
      "duration_seconds": 2.92,
      "text": "right, I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.22,
      "end_seconds": 331.12,
      "duration_seconds": 4.9,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.39,
      "end_seconds": 334.72,
      "duration_seconds": 2.33,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.02,
      "end_seconds": 350.01,
      "duration_seconds": 2.99,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 351.88,
      "end_seconds": 354.5,
      "duration_seconds": 2.62,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 366.96,
      "end_seconds": 374.38,
      "duration_seconds": 7.42,
      "text": "Pulse is regular at the moment, with a couple of early beats while I listened."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.77,
      "end_seconds": 381.89,
      "duration_seconds": 3.12,
      "text": "Alright, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.92,
      "end_seconds": 411.11,
      "duration_seconds": 12.19,
      "text": "Let me tell you where I've got to. I'm honestly not certain yet. It could be benign extra heartbeats, though we should confirm, or it might be a thyroid cause."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.81,
      "end_seconds": 419.47,
      "duration_seconds": 3.66,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.96,
      "end_seconds": 438.91,
      "duration_seconds": 17.95,
      "text": "I can't promise yet, but most people with benign extra heartbeats, though we should confirm do well once it's treated properly. So, to recap quickly. You've had skipped beats for one week, moderate, and no fainting or chest pain."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 440.05,
      "end_seconds": 441.66,
      "duration_seconds": 1.61,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.75,
      "end_seconds": 465.7,
      "duration_seconds": 16.95,
      "text": "I'm sending you for a thyroid test because of palpitations. I'm sending you for a Holter monitor because of palpitations. I'd rather check than guess, and this is the quickest way to to know more."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 467.67,
      "end_seconds": 470.95,
      "duration_seconds": 3.28,
      "text": "Erm, when would that take place?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 471.93,
      "end_seconds": 477.31,
      "duration_seconds": 5.38,
      "text": "Try cutting out caffeine for two weeks and see if the beats settle."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 477.82,
      "end_seconds": 482.71,
      "duration_seconds": 4.89,
      "text": "sure. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 483.66,
      "end_seconds": 486.91,
      "duration_seconds": 3.25,
      "text": "Thank you, um, doctor, goodbye."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 488.84,
      "end_seconds": 490.26,
      "duration_seconds": 1.42,
      "text": "Goodbye for now."
    }
  ]
}