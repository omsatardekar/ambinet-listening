{
  "schema_version": "1.0",
  "encounter_id": "01349",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.99,
      "end_seconds": 4.68,
      "duration_seconds": 3.69,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.93,
      "end_seconds": 14.29,
      "duration_seconds": 4.36,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.99,
      "end_seconds": 23.12,
      "duration_seconds": 8.13,
      "text": "Mainly gritty tired eyes. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.63,
      "end_seconds": 28.04,
      "duration_seconds": 3.41,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.69,
      "end_seconds": 32.81,
      "duration_seconds": 3.12,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.03,
      "end_seconds": 36.94,
      "duration_seconds": 3.91,
      "text": "Okay, go on. Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.88,
      "end_seconds": 43.97,
      "duration_seconds": 5.09,
      "text": "Yes, air conditioning and screens. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.98,
      "end_seconds": 50.37,
      "duration_seconds": 5.39,
      "text": "Have you noticed loss of vision, eye pain or sensitivity to light?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.25,
      "end_seconds": 57.39,
      "duration_seconds": 6.14,
      "text": "I haven't had loss of vision, eye pain or sensitivity to light, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.01,
      "end_seconds": 61.27,
      "duration_seconds": 3.26,
      "text": "Okay, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.1,
      "end_seconds": 64.95,
      "duration_seconds": 2.85,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.53,
      "end_seconds": 68.95,
      "duration_seconds": 2.42,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.53,
      "end_seconds": 73.41,
      "duration_seconds": 2.88,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.67,
      "end_seconds": 91.41,
      "duration_seconds": 3.74,
      "text": "So, has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.04,
      "end_seconds": 94.23,
      "duration_seconds": 2.19,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.55,
      "end_seconds": 100.73,
      "duration_seconds": 5.18,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.62,
      "end_seconds": 103.44,
      "duration_seconds": 1.82,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.18,
      "end_seconds": 106.64,
      "duration_seconds": 2.46,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.3,
      "end_seconds": 111.84,
      "duration_seconds": 3.54,
      "text": "Artificial tears. I take it when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 116.79,
      "duration_seconds": 2.99,
      "text": "Alright, now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.58,
      "end_seconds": 128.38,
      "duration_seconds": 9.8,
      "text": "I work in accounts at a hospital. I swim twice a week. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.49,
      "end_seconds": 145.05,
      "duration_seconds": 3.56,
      "text": "So, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.88,
      "end_seconds": 148.56,
      "duration_seconds": 2.68,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.04,
      "end_seconds": 153.22,
      "duration_seconds": 3.18,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.53,
      "end_seconds": 161.66,
      "duration_seconds": 2.13,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.61,
      "end_seconds": 187.33,
      "duration_seconds": 6.72,
      "text": "Okay: saturation 97 percent, blood pressure 118 over 68, temperature is 36.8 degrees, pulse 74."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.74,
      "end_seconds": 190.42,
      "duration_seconds": 1.68,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.03,
      "end_seconds": 194.4,
      "duration_seconds": 3.37,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.63,
      "end_seconds": 201.14,
      "duration_seconds": 4.51,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.7,
      "end_seconds": 204.0,
      "duration_seconds": 1.3,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.78,
      "end_seconds": 227.19,
      "duration_seconds": 4.41,
      "text": "The eyes look a little pink but the corneas are clear."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.62,
      "end_seconds": 233.51,
      "duration_seconds": 1.89,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.37,
      "end_seconds": 253.3,
      "duration_seconds": 10.93,
      "text": "Okay, so my impression is this: It's hard to say. Dry eye is one possibility and digital eye strain another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.25,
      "end_seconds": 258.62,
      "duration_seconds": 3.37,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.39,
      "end_seconds": 271.2,
      "duration_seconds": 10.81,
      "text": "I understand the worry. At the moment I'd say it's dry eye, and we'll know more once the an eye check is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.07,
      "end_seconds": 297.36,
      "duration_seconds": 9.29,
      "text": "An eye check is what I'd like next, for gritty eyes. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.66,
      "end_seconds": 300.28,
      "duration_seconds": 1.62,
      "text": "That's clear, thanks."
    }
  ]
}