{
  "schema_version": "1.0",
  "encounter_id": "01478",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.37,
      "end_seconds": 7.23,
      "duration_seconds": 5.86,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.32,
      "end_seconds": 13.0,
      "duration_seconds": 3.68,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.89,
      "end_seconds": 21.94,
      "duration_seconds": 7.05,
      "text": "It's more breathlessness than usual. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.83,
      "end_seconds": 27.04,
      "duration_seconds": 3.21,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.52,
      "end_seconds": 31.23,
      "duration_seconds": 2.71,
      "text": "For five days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.4,
      "end_seconds": 37.29,
      "duration_seconds": 4.89,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.33,
      "end_seconds": 48.91,
      "duration_seconds": 9.58,
      "text": "Mostly mild. It just comes and goes. Stairs definitely sets it off. It settles a little with resting."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.53,
      "end_seconds": 61.64,
      "duration_seconds": 2.11,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.4,
      "end_seconds": 67.89,
      "duration_seconds": 4.49,
      "text": "Tiotropium inhaler. I take it once a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.01,
      "end_seconds": 87.46,
      "duration_seconds": 2.45,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.44,
      "end_seconds": 96.17,
      "duration_seconds": 6.73,
      "text": "Yes, you know, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.12,
      "end_seconds": 102.77,
      "duration_seconds": 4.65,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.43,
      "end_seconds": 114.26,
      "duration_seconds": 10.83,
      "text": "I have COPD. I just want to get back to normal, really. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.18,
      "end_seconds": 118.78,
      "duration_seconds": 2.6,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.8,
      "end_seconds": 124.29,
      "duration_seconds": 4.49,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.34,
      "end_seconds": 127.76,
      "duration_seconds": 2.42,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.32,
      "end_seconds": 132.39,
      "duration_seconds": 4.07,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.16,
      "end_seconds": 137.76,
      "duration_seconds": 3.6,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.5,
      "end_seconds": 144.99,
      "duration_seconds": 2.49,
      "text": "So, no allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.19,
      "end_seconds": 147.85,
      "duration_seconds": 1.66,
      "text": "Nothing like swollen ankles?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.52,
      "end_seconds": 150.43,
      "duration_seconds": 1.91,
      "text": "Definitely no swollen ankles."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.58,
      "end_seconds": 155.14,
      "duration_seconds": 3.56,
      "text": "Any confusion, weight loss or chest pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.17,
      "end_seconds": 159.37,
      "duration_seconds": 2.2,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.06,
      "end_seconds": 163.69,
      "duration_seconds": 3.63,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.42,
      "end_seconds": 166.62,
      "duration_seconds": 2.2,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.54,
      "end_seconds": 178.81,
      "duration_seconds": 4.27,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.14,
      "end_seconds": 189.99,
      "duration_seconds": 2.85,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.77,
      "end_seconds": 218.37,
      "duration_seconds": 9.6,
      "text": "Okay: temperature is 37.1 degrees, BP is 131 over 80, oxygen saturation is 90 percent, respiratory rate 25, heart rate 98."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.45,
      "end_seconds": 225.06,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.14,
      "end_seconds": 230.0,
      "duration_seconds": 2.86,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.31,
      "end_seconds": 236.59,
      "duration_seconds": 4.28,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.31,
      "end_seconds": 239.68,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.24,
      "end_seconds": 252.46,
      "duration_seconds": 4.22,
      "text": "There's some wheeze, and no swelling in the legs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.45,
      "end_seconds": 255.47,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.84,
      "end_seconds": 278.13,
      "duration_seconds": 5.29,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.08,
      "end_seconds": 285.05,
      "duration_seconds": 2.97,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.22,
      "end_seconds": 303.55,
      "duration_seconds": 7.33,
      "text": "I think a sputum culture makes sense here, for productive cough. Let's get blood tests, for infective exacerbation."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.8,
      "end_seconds": 305.87,
      "duration_seconds": 1.07,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.6,
      "end_seconds": 332.1,
      "duration_seconds": 24.5,
      "text": "The treatment will be prednisolone, 30 milligrams, once a day, for five days. That's for COPD flare-up. I'm not ordering a chest X-ray today. If things carry on next month, we'll consider it. I'd like you back in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.33,
      "end_seconds": 335.56,
      "duration_seconds": 2.23,
      "text": "Alright, thanks, take care."
    }
  ]
}