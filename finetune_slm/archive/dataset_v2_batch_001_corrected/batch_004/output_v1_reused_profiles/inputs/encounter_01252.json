{
  "schema_version": "1.0",
  "encounter_id": "01252",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.65,
      "end_seconds": 3.25,
      "duration_seconds": 2.6,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 6.28,
      "duration_seconds": 1.28,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.73,
      "end_seconds": 17.28,
      "duration_seconds": 5.55,
      "text": "So, I've been putting on weight over the last year, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.01,
      "end_seconds": 21.74,
      "duration_seconds": 2.73,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.62,
      "end_seconds": 35.29,
      "duration_seconds": 12.67,
      "text": "about... well, nearly five years. Work has been very busy so I kept ignoring it. I'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.57,
      "end_seconds": 39.02,
      "duration_seconds": 2.45,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.92,
      "end_seconds": 49.85,
      "duration_seconds": 2.93,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.25,
      "end_seconds": 72.36,
      "duration_seconds": 9.11,
      "text": "Okay: pressure 116 over 72, oxygen saturation is 98 percent, pulse is 66 beats a minute, respiratory rate 17."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.34,
      "end_seconds": 78.56,
      "duration_seconds": 4.22,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.92,
      "end_seconds": 80.96,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.68,
      "end_seconds": 84.74,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.79,
      "end_seconds": 105.08,
      "duration_seconds": 4.29,
      "text": "Your waist measures about a hundred and four centimetres."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.77,
      "end_seconds": 111.28,
      "duration_seconds": 2.51,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.33,
      "end_seconds": 121.76,
      "duration_seconds": 3.43,
      "text": "did you get heat intolerance or irregular periods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.84,
      "end_seconds": 128.89,
      "duration_seconds": 2.05,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.35,
      "end_seconds": 132.6,
      "duration_seconds": 3.25,
      "text": "Yes. Have you had any chest pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.4,
      "end_seconds": 137.04,
      "duration_seconds": 2.64,
      "text": "No, none, no chest pain."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.06,
      "end_seconds": 141.51,
      "duration_seconds": 2.45,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.09,
      "end_seconds": 145.65,
      "duration_seconds": 2.56,
      "text": "Nothing unusual, you know, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.42,
      "end_seconds": 149.99,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.58,
      "end_seconds": 154.14,
      "duration_seconds": 3.56,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.73,
      "end_seconds": 177.99,
      "duration_seconds": 5.26,
      "text": "Okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.89,
      "end_seconds": 185.65,
      "duration_seconds": 5.76,
      "text": "I'm on gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.6,
      "end_seconds": 190.92,
      "duration_seconds": 4.32,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.31,
      "end_seconds": 194.83,
      "duration_seconds": 2.52,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.4,
      "end_seconds": 199.04,
      "duration_seconds": 3.64,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.66,
      "end_seconds": 203.93,
      "duration_seconds": 3.27,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.95,
      "end_seconds": 207.05,
      "duration_seconds": 2.1,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.83,
      "end_seconds": 213.93,
      "duration_seconds": 4.1,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.45,
      "end_seconds": 217.34,
      "duration_seconds": 1.89,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.39,
      "end_seconds": 222.67,
      "duration_seconds": 3.28,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.51,
      "end_seconds": 239.39,
      "duration_seconds": 2.88,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.71,
      "end_seconds": 247.15,
      "duration_seconds": 6.44,
      "text": "I have diabetes, for five years. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.02,
      "end_seconds": 251.67,
      "duration_seconds": 2.65,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.51,
      "end_seconds": 256.57,
      "duration_seconds": 3.06,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.89,
      "end_seconds": 289.34,
      "duration_seconds": 22.45,
      "text": "A thyroid test is what I'd like next, for weight gain. Let's get a sleep study, for snoring and sleepiness. Start with small, specific changes: smaller portions, no sugary drinks, a thirty-minute walk most days. Let's get you seen by a dietitian, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 290.67,
      "end_seconds": 291.37,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.12,
      "end_seconds": 299.58,
      "duration_seconds": 6.46,
      "text": "We'll catch up in six weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.35,
      "end_seconds": 303.47,
      "duration_seconds": 2.12,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.99,
      "end_seconds": 305.61,
      "duration_seconds": 1.62,
      "text": "Have a good day."
    }
  ]
}