{
  "schema_version": "1.0",
  "encounter_id": "01424",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 4.59,
      "duration_seconds": 3.38,
      "text": "Ah, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.38,
      "end_seconds": 9.92,
      "duration_seconds": 4.54,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.01,
      "end_seconds": 18.38,
      "duration_seconds": 7.37,
      "text": "It's, It's breathlessness on slopes. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.26,
      "end_seconds": 22.39,
      "duration_seconds": 3.13,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.02,
      "end_seconds": 25.73,
      "duration_seconds": 2.71,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.97,
      "end_seconds": 31.87,
      "duration_seconds": 4.9,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.77,
      "end_seconds": 41.45,
      "duration_seconds": 7.68,
      "text": "It's worse with slopes. Only resting, and it's not much. And occasional chest tightness, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.5,
      "end_seconds": 53.41,
      "duration_seconds": 2.91,
      "text": "Have you noticed bruising or black stools?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.4,
      "end_seconds": 58.15,
      "duration_seconds": 3.75,
      "text": "No bruising or black stools, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.96,
      "end_seconds": 62.63,
      "duration_seconds": 2.67,
      "text": "Did you get palpitations or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.09,
      "end_seconds": 72.01,
      "duration_seconds": 2.92,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.33,
      "end_seconds": 74.76,
      "duration_seconds": 2.43,
      "text": "Sure. Has your skin been okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.54,
      "end_seconds": 77.62,
      "duration_seconds": 1.08,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.22,
      "end_seconds": 81.35,
      "duration_seconds": 2.13,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.56,
      "end_seconds": 84.02,
      "duration_seconds": 1.46,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.34,
      "end_seconds": 90.17,
      "duration_seconds": 4.83,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.23,
      "end_seconds": 97.32,
      "duration_seconds": 6.09,
      "text": "Well, uh, I'm on hydrochlorothiazide, 12.5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.02,
      "end_seconds": 102.96,
      "duration_seconds": 3.94,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.55,
      "end_seconds": 106.56,
      "duration_seconds": 2.01,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.6,
      "end_seconds": 112.18,
      "duration_seconds": 3.58,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.05,
      "end_seconds": 120.19,
      "duration_seconds": 7.14,
      "text": "Heart disease, for nearly five years. I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.43,
      "end_seconds": 129.03,
      "duration_seconds": 7.6,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.64,
      "end_seconds": 144.36,
      "duration_seconds": 4.72,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.34,
      "end_seconds": 156.37,
      "duration_seconds": 10.03,
      "text": "I look after my grandchildren most days. I'm vegetarian and have been for years. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.7,
      "end_seconds": 163.14,
      "duration_seconds": 4.44,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.0,
      "end_seconds": 167.2,
      "duration_seconds": 3.2,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.49,
      "end_seconds": 171.95,
      "duration_seconds": 3.46,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.16,
      "end_seconds": 176.88,
      "duration_seconds": 3.72,
      "text": "Actually, my daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.56,
      "end_seconds": 180.82,
      "duration_seconds": 3.26,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.89,
      "end_seconds": 193.69,
      "duration_seconds": 2.8,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.33,
      "end_seconds": 213.89,
      "duration_seconds": 7.56,
      "text": "Okay: heart rate 64, SpO2 99 percent on room air, BP is 116 over 69, temperature 37.0."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.9,
      "end_seconds": 217.92,
      "duration_seconds": 2.02,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.8,
      "end_seconds": 222.74,
      "duration_seconds": 2.94,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.03,
      "end_seconds": 233.18,
      "duration_seconds": 3.15,
      "text": "Chest is clear and heart sounds are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.52,
      "end_seconds": 235.86,
      "duration_seconds": 1.34,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.37,
      "end_seconds": 254.01,
      "duration_seconds": 3.64,
      "text": "The scar on your chest has healed well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.81,
      "end_seconds": 280.36,
      "duration_seconds": 22.55,
      "text": "Good, you can sit up again. So, based on the history and the examination, the most likely explanation is stable recovery after the heart event. Let me repeat that back to make sure. You've had breathlessness on slopes for about three months, and no palpitations or bruising."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.27,
      "end_seconds": 283.77,
      "duration_seconds": 1.5,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.09,
      "end_seconds": 325.39,
      "duration_seconds": 30.3,
      "text": "An ECG is what I'd like next, for follow-up. A lipid profile is what I'd like next, for cardiovascular risk. I'd rather check than guess, and this is the quickest way to know more. I'm going to put you on atorvastatin, 40 milligrams, at night, long term. That's for cardiovascular risk. Cardiac rehab is worth doing, it really helps your confidence."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.88,
      "end_seconds": 333.22,
      "duration_seconds": 7.34,
      "text": "I see, go ahead. Let's get you seen by cardiac rehabilitation, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.6,
      "end_seconds": 336.4,
      "duration_seconds": 1.8,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.59,
      "end_seconds": 345.67,
      "duration_seconds": 8.08,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.64,
      "end_seconds": 349.11,
      "duration_seconds": 1.47,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.55,
      "end_seconds": 366.79,
      "duration_seconds": 15.24,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. Please come and see me in three months. So, does all of that make sense?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 368.66,
      "end_seconds": 370.86,
      "duration_seconds": 2.2,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.25,
      "end_seconds": 373.42,
      "duration_seconds": 1.17,
      "text": "All the best."
    }
  ]
}