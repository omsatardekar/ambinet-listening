{
  "schema_version": "1.0",
  "encounter_id": "01073",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 6.88,
      "duration_seconds": 5.58,
      "text": "Ah, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 12.89,
      "duration_seconds": 5.13,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.39,
      "end_seconds": 24.02,
      "duration_seconds": 8.63,
      "text": "Okay, uh, so it's my heart racing. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.74,
      "end_seconds": 28.29,
      "duration_seconds": 3.55,
      "text": "Can you tell me when it it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.92,
      "end_seconds": 35.15,
      "duration_seconds": 6.23,
      "text": "for about four days, I'd say i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.8,
      "end_seconds": 41.71,
      "duration_seconds": 2.91,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.47,
      "end_seconds": 48.61,
      "duration_seconds": 1.14,
      "text": "Severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.15,
      "end_seconds": 56.11,
      "duration_seconds": 6.96,
      "text": "Yes, carry on. And what about chest pain, diarrhoea or lump in the neck?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.83,
      "end_seconds": 59.02,
      "duration_seconds": 2.19,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.67,
      "end_seconds": 65.07,
      "duration_seconds": 4.4,
      "text": "Okay, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.54,
      "end_seconds": 69.02,
      "duration_seconds": 2.48,
      "text": "so, no, all normal there"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.53,
      "end_seconds": 72.82,
      "duration_seconds": 3.29,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.25,
      "end_seconds": 87.7,
      "duration_seconds": 13.45,
      "text": "I smoke roughly a pack every two days. Nothing, I'm teetotal. I swim twice a week. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.82,
      "end_seconds": 109.06,
      "duration_seconds": 4.24,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.55,
      "end_seconds": 112.19,
      "duration_seconds": 1.64,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.12,
      "end_seconds": 115.43,
      "duration_seconds": 2.31,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 119.72,
      "duration_seconds": 2.95,
      "text": "Atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.19,
      "end_seconds": 136.96,
      "duration_seconds": 3.77,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.5,
      "end_seconds": 141.33,
      "duration_seconds": 2.83,
      "text": "oh, no allergies at all"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.5,
      "end_seconds": 143.74,
      "duration_seconds": 1.24,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.53,
      "end_seconds": 148.77,
      "duration_seconds": 3.24,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.84,
      "end_seconds": 152.84,
      "duration_seconds": 2.0,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.92,
      "end_seconds": 160.98,
      "duration_seconds": 2.06,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.3,
      "end_seconds": 186.96,
      "duration_seconds": 12.66,
      "text": "Okay: weight 95 kilos, BMI works out to 36.2, pressure 132 over 76, temperature is 36.5 degrees, pulse is 115 beats a minute, height 162 centimetres."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.46,
      "end_seconds": 190.12,
      "duration_seconds": 1.66,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.19,
      "end_seconds": 193.73,
      "duration_seconds": 2.54,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.86,
      "end_seconds": 198.7,
      "duration_seconds": 3.84,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.84,
      "end_seconds": 202.99,
      "duration_seconds": 3.15,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.1,
      "end_seconds": 217.3,
      "duration_seconds": 4.2,
      "text": "Your thyroid feels a little enlarged and and smooth."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.61,
      "end_seconds": 224.1,
      "duration_seconds": 2.49,
      "text": "So, you can relax now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.22,
      "end_seconds": 245.3,
      "duration_seconds": 4.08,
      "text": "Taking everything into account, it points towards an overactive thyroid."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.42,
      "end_seconds": 247.9,
      "duration_seconds": 1.48,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.63,
      "end_seconds": 257.58,
      "duration_seconds": 8.95,
      "text": "It's reasonable to be concerned, but right now an overactive thyroid is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.06,
      "end_seconds": 282.99,
      "duration_seconds": 10.93,
      "text": "Let's get an ECG, for palpitations. For this, propranolol, 20 milligrams, twice a day, until we review. That should help with palpitations and tremor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.89,
      "end_seconds": 287.9,
      "duration_seconds": 3.01,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.43,
      "end_seconds": 294.5,
      "duration_seconds": 5.07,
      "text": "limit tea, coffee and anything that speeds up the heart for now"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.86,
      "end_seconds": 311.72,
      "duration_seconds": 16.86,
      "text": "Mm-hmm. Let's hold off on a thyroid test for now, and if there's no change in two weeks we can revisit it. Please come and see me after the results are back. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.88,
      "end_seconds": 314.52,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    }
  ]
}