{
  "schema_version": "1.0",
  "encounter_id": "01381",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 2.81,
      "duration_seconds": 2.3,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.44,
      "end_seconds": 4.6,
      "duration_seconds": 1.16,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 5.65,
      "end_seconds": 9.48,
      "duration_seconds": 3.83,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.92,
      "end_seconds": 21.79,
      "duration_seconds": 6.87,
      "text": "Yes, that's no problem at all. Please sit. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 32.99,
      "duration_seconds": 9.14,
      "text": "Well, I've been having a red eye. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.75,
      "end_seconds": 37.22,
      "duration_seconds": 2.47,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.2,
      "end_seconds": 47.07,
      "duration_seconds": 2.87,
      "text": "Right, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.69,
      "end_seconds": 74.44,
      "duration_seconds": 8.75,
      "text": "Okay: BP is 124 over 81, heart rate 79, saturation 98 percent, temperature is 36.8 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.13,
      "end_seconds": 77.48,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.7,
      "end_seconds": 80.8,
      "duration_seconds": 2.1,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.08,
      "end_seconds": 84.48,
      "duration_seconds": 3.4,
      "text": "Yes. Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.01,
      "end_seconds": 87.58,
      "duration_seconds": 2.57,
      "text": "It feels moderate to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.55,
      "end_seconds": 92.43,
      "duration_seconds": 2.88,
      "text": "Right, is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.27,
      "end_seconds": 101.06,
      "duration_seconds": 7.79,
      "text": "Itching goes along with it, most of the time. As for itching, severe, I'd say."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.21,
      "end_seconds": 107.29,
      "duration_seconds": 5.08,
      "text": "And what about loss of vision or pain in the eye?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.05,
      "end_seconds": 114.89,
      "duration_seconds": 6.84,
      "text": "I mean, no, no loss of vision or pain in the eye."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.76,
      "end_seconds": 123.63,
      "duration_seconds": 6.87,
      "text": "Let me check a few things. Any contact lens or foreign body in the eye?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.53,
      "end_seconds": 128.35,
      "duration_seconds": 2.82,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.98,
      "end_seconds": 131.94,
      "duration_seconds": 2.96,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.81,
      "end_seconds": 134.55,
      "duration_seconds": 1.74,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.22,
      "end_seconds": 141.67,
      "duration_seconds": 5.45,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.1,
      "end_seconds": 151.49,
      "duration_seconds": 8.39,
      "text": "I live with my elderly mother. I look after my grandchildren most days. I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.07,
      "end_seconds": 171.47,
      "duration_seconds": 4.4,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.11,
      "end_seconds": 181.61,
      "duration_seconds": 8.5,
      "text": "I had a reaction to erythromycin when I was younger, bad stomach cramps, and I've avoided it since."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.12,
      "end_seconds": 190.73,
      "duration_seconds": 7.61,
      "text": "Tell me about any past illnesses or ongoing conditions. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.69,
      "end_seconds": 194.08,
      "duration_seconds": 1.39,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.5,
      "end_seconds": 197.2,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.7,
      "end_seconds": 201.12,
      "duration_seconds": 2.42,
      "text": "I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.2,
      "end_seconds": 206.22,
      "duration_seconds": 3.02,
      "text": "Sure. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 207.62,
      "end_seconds": 218.24,
      "duration_seconds": 10.62,
      "text": "She takes hydrocortisone cream, when needed for the eczema. She is on clopidogrel, 75 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.75,
      "end_seconds": 221.05,
      "duration_seconds": 1.3,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.14,
      "end_seconds": 223.3,
      "duration_seconds": 1.16,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.07,
      "end_seconds": 230.31,
      "duration_seconds": 5.24,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.91,
      "end_seconds": 240.6,
      "duration_seconds": 1.69,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.9,
      "end_seconds": 243.33,
      "duration_seconds": 1.43,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.27,
      "end_seconds": 267.58,
      "duration_seconds": 7.31,
      "text": "The white of the eye is pink all over, and there's some sticky discharge on the lashes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.8,
      "end_seconds": 274.43,
      "duration_seconds": 1.63,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.88,
      "end_seconds": 297.03,
      "duration_seconds": 13.15,
      "text": "Right, here's what I'm thinking. The most likely explanation is conjunctivitis. The reason I say that is that your story and my examination fit together. An allergic eye problem is still possible."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.17,
      "end_seconds": 300.86,
      "duration_seconds": 2.69,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.8,
      "end_seconds": 328.92,
      "duration_seconds": 27.12,
      "text": "It's reasonable to be concerned, but right now conjunctivitis is my leading thought, not anything worse. Let's get an eye swab, for red eye. Let's use chloramphenicol eye drops, four times a day, for five days. It's for conjunctivitis. Wash your hands often, don't share towels, and don't rub the eye. Book a review in a week. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.02,
      "end_seconds": 332.16,
      "duration_seconds": 2.14,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.91,
      "end_seconds": 334.18,
      "duration_seconds": 1.27,
      "text": "See you soon."
    }
  ]
}