{
  "schema_version": "1.0",
  "encounter_id": "01099",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 3.15,
      "duration_seconds": 1.96,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.34,
      "end_seconds": 7.13,
      "duration_seconds": 2.79,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.44,
      "end_seconds": 14.17,
      "duration_seconds": 5.73,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.3,
      "end_seconds": 20.16,
      "duration_seconds": 4.86,
      "text": "Absolutely, come and sit beside them. Did you take the bus in?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.46,
      "end_seconds": 25.25,
      "duration_seconds": 3.79,
      "text": "I drove. The roads were quiet today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.76,
      "end_seconds": 27.93,
      "duration_seconds": 1.17,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.56,
      "end_seconds": 40.65,
      "duration_seconds": 11.09,
      "text": "Well, I've been having sudden hearing loss in my left ear. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.6,
      "end_seconds": 46.41,
      "duration_seconds": 3.81,
      "text": "Have you had a ringing in the ear?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.51,
      "end_seconds": 50.62,
      "duration_seconds": 2.11,
      "text": "Yes, uh, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.14,
      "end_seconds": 55.06,
      "duration_seconds": 2.92,
      "text": "So, have you had trouble following conversations?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.04,
      "end_seconds": 75.27,
      "duration_seconds": 19.23,
      "text": "Right, yeah. One week, I'd say. Ah, you know, as for trouble following conversations, mild, really. Noisy places definitely sets it off. I've also been feeling a bit dizzy, for about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.16,
      "end_seconds": 84.25,
      "duration_seconds": 8.09,
      "text": "So, have you had sudden hearing loss in your left ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.21,
      "end_seconds": 94.51,
      "duration_seconds": 8.3,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.48,
      "end_seconds": 99.43,
      "duration_seconds": 2.95,
      "text": "Any recent flying, head injury or discharge?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.29,
      "end_seconds": 105.87,
      "duration_seconds": 4.58,
      "text": "No, no recent flying, head injury or discharge."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.84,
      "end_seconds": 109.86,
      "duration_seconds": 2.02,
      "text": "Has there been any headache?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.37,
      "end_seconds": 114.48,
      "duration_seconds": 3.11,
      "text": "Not that I've noticed, no headache."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.44,
      "end_seconds": 118.77,
      "duration_seconds": 3.33,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.42,
      "end_seconds": 124.8,
      "duration_seconds": 4.38,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.43,
      "end_seconds": 127.51,
      "duration_seconds": 2.08,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.25,
      "end_seconds": 129.95,
      "duration_seconds": 1.7,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.25,
      "end_seconds": 148.78,
      "duration_seconds": 2.53,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.65,
      "end_seconds": 158.06,
      "duration_seconds": 7.41,
      "text": "It's hydrochlorothiazide, 12.5 milligrams, every morning. I'm on diclofenac, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.15,
      "end_seconds": 163.09,
      "duration_seconds": 3.94,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.56,
      "end_seconds": 166.71,
      "duration_seconds": 2.15,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.55,
      "end_seconds": 170.5,
      "duration_seconds": 2.95,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.05,
      "end_seconds": 175.22,
      "duration_seconds": 4.17,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.26,
      "end_seconds": 180.45,
      "duration_seconds": 1.19,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.11,
      "end_seconds": 183.86,
      "duration_seconds": 2.75,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.61,
      "end_seconds": 189.05,
      "duration_seconds": 2.44,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.3,
      "end_seconds": 194.17,
      "duration_seconds": 3.87,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.97,
      "end_seconds": 212.94,
      "duration_seconds": 1.97,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.59,
      "end_seconds": 217.96,
      "duration_seconds": 4.37,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.57,
      "end_seconds": 222.62,
      "duration_seconds": 4.05,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.13,
      "end_seconds": 233.39,
      "duration_seconds": 9.26,
      "text": "I have high blood pressure, for two years. I have arthritis in my knees, for nearly five years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.13,
      "end_seconds": 243.87,
      "duration_seconds": 9.74,
      "text": "I follow. Alright, high blood pressure, that matches what I have here. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 244.64,
      "end_seconds": 248.38,
      "duration_seconds": 3.74,
      "text": "Uh, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 249.53,
      "end_seconds": 255.93,
      "duration_seconds": 6.4,
      "text": "Hold on, doctor, I think she reacted to amoxicillin once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.44,
      "end_seconds": 260.09,
      "duration_seconds": 2.65,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.52,
      "end_seconds": 266.79,
      "duration_seconds": 5.27,
      "text": "Alright, so that's unclear. I'll record what each of you said."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.69,
      "end_seconds": 285.93,
      "duration_seconds": 2.24,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.55,
      "end_seconds": 299.59,
      "duration_seconds": 3.04,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.36,
      "end_seconds": 315.24,
      "duration_seconds": 5.88,
      "text": "Okay: saturation 98 percent, temperature 36.6, pulse 85, pressure 110 over 71."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.25,
      "end_seconds": 318.24,
      "duration_seconds": 1.99,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.76,
      "end_seconds": 322.61,
      "duration_seconds": 2.85,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.48,
      "end_seconds": 328.58,
      "duration_seconds": 4.1,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.27,
      "end_seconds": 331.93,
      "duration_seconds": 1.66,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.48,
      "end_seconds": 336.34,
      "duration_seconds": 2.86,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.72,
      "end_seconds": 359.65,
      "duration_seconds": 5.93,
      "text": "Both eardrums look normal and a tuning fork is heard better in the right ear."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.62,
      "end_seconds": 375.48,
      "duration_seconds": 12.86,
      "text": "Good, you can sit up again. Putting it all together, I think we're dealing with sudden loss of hearing that needs urgent assessment at this stage. Wax is still possible."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.61,
      "end_seconds": 378.78,
      "duration_seconds": 2.17,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 379.69,
      "end_seconds": 397.2,
      "duration_seconds": 17.51,
      "text": "I understand the worry. At the moment I'd say it's sudden loss of hearing that needs urgent assessment, and we'll know more once the an MRI scan is back. I want an MRI scan done, that's for unilateral hearing loss."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.06,
      "end_seconds": 400.2,
      "duration_seconds": 2.14,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.93,
      "end_seconds": 427.73,
      "duration_seconds": 26.8,
      "text": "I want a hearing test done, that's for sudden hearing loss. I'd like you to take prednisolone, 60 milligrams, once a day in the morning, for seven days. It's for sudden hearing loss. Please attend the hearing test today if you can, as timing matters. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 428.47,
      "end_seconds": 434.78,
      "duration_seconds": 6.31,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 439.17,
      "end_seconds": 447.52,
      "duration_seconds": 8.35,
      "text": "So, I take the prednisolone, 60 milligrams, once a day in the morning. Is that right?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 448.56,
      "end_seconds": 454.46,
      "duration_seconds": 5.9,
      "text": "Yes, exactly right. So, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 455.27,
      "end_seconds": 457.06,
      "duration_seconds": 1.79,
      "text": "That's clear, thanks."
    }
  ]
}