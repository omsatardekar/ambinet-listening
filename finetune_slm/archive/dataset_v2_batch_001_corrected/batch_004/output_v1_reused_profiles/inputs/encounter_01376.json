{
  "schema_version": "1.0",
  "encounter_id": "01376",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.36,
      "end_seconds": 6.36,
      "duration_seconds": 5.0,
      "text": "Yeah, hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.37,
      "end_seconds": 12.9,
      "duration_seconds": 4.53,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.51,
      "end_seconds": 20.65,
      "duration_seconds": 7.14,
      "text": "Yeah, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.06,
      "end_seconds": 24.78,
      "duration_seconds": 2.72,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.53,
      "end_seconds": 30.05,
      "duration_seconds": 3.52,
      "text": "Right, I've been dealing with some bleeding."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.57,
      "end_seconds": 33.77,
      "duration_seconds": 2.2,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.59,
      "end_seconds": 42.79,
      "duration_seconds": 8.2,
      "text": "Ah, uh, I've had it for five days. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.24,
      "end_seconds": 46.67,
      "duration_seconds": 3.43,
      "text": "Yes. Alright, has there been tender breasts too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.49,
      "end_seconds": 57.49,
      "duration_seconds": 10.0,
      "text": "Let me think, yeah. About four days, I'd say. Okay, so about tender breasts, it's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.26,
      "end_seconds": 62.5,
      "duration_seconds": 3.24,
      "text": "Have you been feeling sick in the mornings?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.1,
      "end_seconds": 65.29,
      "duration_seconds": 1.19,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.88,
      "end_seconds": 72.22,
      "duration_seconds": 5.34,
      "text": "Have you had some bleeding before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.01,
      "end_seconds": 81.79,
      "duration_seconds": 8.78,
      "text": "Mm, um, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.05,
      "end_seconds": 85.24,
      "duration_seconds": 2.19,
      "text": "Have you had any fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.27,
      "end_seconds": 87.93,
      "duration_seconds": 1.66,
      "text": "Nope, no fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.75,
      "end_seconds": 95.44,
      "duration_seconds": 5.69,
      "text": "Let me check a few things. Any passing tissue, severe one-sided pain or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.23,
      "end_seconds": 99.77,
      "duration_seconds": 2.54,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.63,
      "end_seconds": 104.75,
      "duration_seconds": 4.12,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.24,
      "end_seconds": 109.4,
      "duration_seconds": 3.16,
      "text": "Um, no, that's all normal."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.07,
      "end_seconds": 112.89,
      "duration_seconds": 2.82,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.3,
      "end_seconds": 116.27,
      "duration_seconds": 1.97,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.99,
      "end_seconds": 121.86,
      "duration_seconds": 3.87,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.05,
      "end_seconds": 126.29,
      "duration_seconds": 3.24,
      "text": "I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.09,
      "end_seconds": 130.43,
      "duration_seconds": 2.34,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.81,
      "end_seconds": 135.16,
      "duration_seconds": 3.35,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.16,
      "end_seconds": 139.78,
      "duration_seconds": 2.62,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.5,
      "end_seconds": 142.81,
      "duration_seconds": 2.31,
      "text": "I've had eczema, yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.16,
      "end_seconds": 162.22,
      "duration_seconds": 2.06,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.08,
      "end_seconds": 172.42,
      "duration_seconds": 8.34,
      "text": "Yes, um, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.92,
      "end_seconds": 176.31,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.27,
      "end_seconds": 180.73,
      "duration_seconds": 3.46,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.24,
      "end_seconds": 184.8,
      "duration_seconds": 3.56,
      "text": "So, are you in work at the moment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.16,
      "end_seconds": 191.14,
      "duration_seconds": 4.98,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.3,
      "end_seconds": 204.84,
      "duration_seconds": 2.54,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.65,
      "end_seconds": 221.67,
      "duration_seconds": 3.02,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.73,
      "end_seconds": 244.69,
      "duration_seconds": 5.96,
      "text": "Okay: temperature 36.8, heart rate 66, BP is 117 over 82."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.25,
      "end_seconds": 249.59,
      "duration_seconds": 4.34,
      "text": "Let me think, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.2,
      "end_seconds": 253.63,
      "duration_seconds": 2.43,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.02,
      "end_seconds": 259.56,
      "duration_seconds": 4.54,
      "text": "Right, I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.23,
      "end_seconds": 263.95,
      "duration_seconds": 2.72,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.05,
      "end_seconds": 288.55,
      "duration_seconds": 6.5,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.8,
      "end_seconds": 305.52,
      "duration_seconds": 13.72,
      "text": "Thank you, you can get dressed. Okay, thinking it through, this looks most like bleeding in early pregnancy that needs a scan. An ectopic pregnancy is also on my list."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.23,
      "end_seconds": 340.27,
      "duration_seconds": 16.04,
      "text": "I'd like to arrange an early pregnancy scan for bleeding in early pregnancy. I want a pregnancy hormone level done, that's for bleeding in early pregnancy. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.4,
      "end_seconds": 349.09,
      "duration_seconds": 2.69,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.79,
      "end_seconds": 371.96,
      "duration_seconds": 19.17,
      "text": "Use pads rather than tampons and avoid intercourse until the scan. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. I'd like you back after the scan."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.18,
      "end_seconds": 377.71,
      "duration_seconds": 4.53,
      "text": "Let me think, uh, I can manage that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.28,
      "end_seconds": 382.01,
      "duration_seconds": 2.73,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.13,
      "end_seconds": 386.1,
      "duration_seconds": 2.97,
      "text": "Well, thank you, doctor, goodbye."
    }
  ]
}