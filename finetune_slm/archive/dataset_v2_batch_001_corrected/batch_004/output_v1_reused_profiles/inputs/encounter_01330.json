{
  "schema_version": "1.0",
  "encounter_id": "01330",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 4.36,
      "duration_seconds": 3.28,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.39,
      "end_seconds": 10.6,
      "duration_seconds": 5.21,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.21,
      "end_seconds": 20.17,
      "duration_seconds": 4.96,
      "text": "Yeah, I'm here because of blurred vision at times."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.15,
      "end_seconds": 24.19,
      "duration_seconds": 3.04,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.45,
      "end_seconds": 34.03,
      "duration_seconds": 6.58,
      "text": "I'd say two months. Actually, you know, no, closer to about three months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.13,
      "end_seconds": 37.18,
      "duration_seconds": 2.05,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.26,
      "end_seconds": 43.5,
      "duration_seconds": 4.24,
      "text": "It usually comes with headaches in the morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.52,
      "end_seconds": 47.42,
      "duration_seconds": 2.9,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.83,
      "end_seconds": 50.33,
      "duration_seconds": 1.5,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.39,
      "end_seconds": 62.11,
      "duration_seconds": 6.72,
      "text": "Any allergies to tablets, food or anything in the environment? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.65,
      "end_seconds": 66.94,
      "duration_seconds": 3.29,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.07,
      "end_seconds": 72.8,
      "duration_seconds": 4.73,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.4,
      "end_seconds": 80.2,
      "duration_seconds": 2.8,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.13,
      "end_seconds": 89.71,
      "duration_seconds": 1.58,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.19,
      "end_seconds": 93.8,
      "duration_seconds": 2.61,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.74,
      "end_seconds": 98.35,
      "duration_seconds": 3.61,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.34,
      "end_seconds": 103.9,
      "duration_seconds": 3.56,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.36,
      "end_seconds": 108.08,
      "duration_seconds": 2.72,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.85,
      "end_seconds": 113.23,
      "duration_seconds": 4.38,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.58,
      "end_seconds": 116.42,
      "duration_seconds": 1.84,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.9,
      "end_seconds": 120.09,
      "duration_seconds": 2.19,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.78,
      "end_seconds": 138.56,
      "duration_seconds": 2.78,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.2,
      "end_seconds": 141.25,
      "duration_seconds": 1.05,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.29,
      "end_seconds": 150.01,
      "duration_seconds": 6.72,
      "text": "Did you get shortness of breath, weakness on one side, ankle swelling or slurred speech?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.42,
      "end_seconds": 159.7,
      "duration_seconds": 8.28,
      "text": "Ah, no, no shortness of breath, weakness on one side, ankle swelling or slurred speech."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.33,
      "end_seconds": 165.32,
      "duration_seconds": 3.99,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.27,
      "end_seconds": 172.27,
      "duration_seconds": 5.0,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.24,
      "end_seconds": 177.88,
      "duration_seconds": 4.64,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.65,
      "end_seconds": 182.96,
      "duration_seconds": 3.31,
      "text": "Okay, so no, all normal there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 193.0,
      "end_seconds": 203.59,
      "duration_seconds": 10.59,
      "text": "Doctor, I've got the readings for you. BP is 164 over 101, pulse is 72 beats a minute. Respiratory rate 18, temp 36.4 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.28,
      "end_seconds": 205.74,
      "duration_seconds": 1.46,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.75,
      "end_seconds": 210.47,
      "duration_seconds": 3.72,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.57,
      "end_seconds": 213.26,
      "duration_seconds": 1.69,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.85,
      "end_seconds": 232.03,
      "duration_seconds": 5.18,
      "text": "The back of your eyes looks fine and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.57,
      "end_seconds": 237.48,
      "duration_seconds": 2.91,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.04,
      "end_seconds": 257.78,
      "duration_seconds": 9.74,
      "text": "Let me tell you where I've got to. I think we're dealing with poorly controlled high blood pressure at this stage."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.62,
      "end_seconds": 262.74,
      "duration_seconds": 4.12,
      "text": "Hmm, uh, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.53,
      "end_seconds": 293.62,
      "duration_seconds": 30.09,
      "text": "Nothing I've seen today points to an emergency. It looks like poorly controlled high blood pressure, but I'd like to confirm. I think a home blood pressure diary makes sense here, for hypertension. What I'm giving you is amlodipine, 5 milligrams, once a day, long term. That should help with high blood pressure. Check your blood pressure at home twice a day for a week and bring the readings."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.86,
      "end_seconds": 311.64,
      "duration_seconds": 11.78,
      "text": "If it hasn't settled next month, we'd think about a urine test, but not now. Let's plan a check in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.98,
      "end_seconds": 317.46,
      "duration_seconds": 3.48,
      "text": "Oh, no, that's all. Thanks a lot."
    }
  ]
}