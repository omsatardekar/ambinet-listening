{
  "schema_version": "1.0",
  "encounter_id": "01495",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.29,
      "end_seconds": 4.53,
      "duration_seconds": 3.24,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.07,
      "end_seconds": 6.04,
      "duration_seconds": 0.97,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.76,
      "end_seconds": 9.83,
      "duration_seconds": 2.07,
      "text": "Weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.45,
      "end_seconds": 19.53,
      "duration_seconds": 8.08,
      "text": "Let me think, um, it has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.89,
      "end_seconds": 23.77,
      "duration_seconds": 2.88,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.26,
      "end_seconds": 32.4,
      "duration_seconds": 7.14,
      "text": "Let me think, uh, so the thing is, I've got drenching night sweats."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.02,
      "end_seconds": 36.96,
      "duration_seconds": 2.94,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.32,
      "end_seconds": 53.17,
      "duration_seconds": 14.85,
      "text": "Since last night, that's when it began. Work has been very busy so I kept ignoring it. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.21,
      "end_seconds": 60.69,
      "duration_seconds": 5.48,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.45,
      "end_seconds": 88.09,
      "duration_seconds": 26.64,
      "text": "About a five out of ten. Only changing my clothes, and it's not much. It happens on and off. And there's a low fever in the evenings as well, about two weeks now. With low fever in the evenings, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.87,
      "end_seconds": 91.44,
      "duration_seconds": 2.57,
      "text": "Any itching all over as well?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 93.44,
      "end_seconds": 95.7,
      "duration_seconds": 2.26,
      "text": "Yes, um, actually."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.76,
      "end_seconds": 101.65,
      "duration_seconds": 4.89,
      "text": "Alright, any cough, weight loss or joint pain at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.63,
      "end_seconds": 109.93,
      "duration_seconds": 4.3,
      "text": "Hmm, you know, nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.51,
      "end_seconds": 113.87,
      "duration_seconds": 3.36,
      "text": "And what about chest pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.39,
      "end_seconds": 120.46,
      "duration_seconds": 6.07,
      "text": "Um, I haven't had chest pain or diarrhoea, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.2,
      "end_seconds": 124.38,
      "duration_seconds": 2.18,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.32,
      "end_seconds": 128.21,
      "duration_seconds": 2.89,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.57,
      "end_seconds": 131.94,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.59,
      "end_seconds": 144.35,
      "duration_seconds": 11.76,
      "text": "I've had high cholesterol for about a year now. Hmm, yes, high blood pressure. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.18,
      "end_seconds": 150.35,
      "duration_seconds": 1.17,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.17,
      "end_seconds": 154.05,
      "duration_seconds": 1.88,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.73,
      "end_seconds": 156.55,
      "duration_seconds": 0.82,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.89,
      "end_seconds": 161.47,
      "duration_seconds": 3.58,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.7,
      "end_seconds": 167.24,
      "duration_seconds": 4.54,
      "text": "So, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.15,
      "end_seconds": 171.85,
      "duration_seconds": 3.7,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.88,
      "end_seconds": 176.27,
      "duration_seconds": 2.39,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.82,
      "end_seconds": 181.11,
      "duration_seconds": 4.29,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.14,
      "end_seconds": 187.04,
      "duration_seconds": 4.9,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.26,
      "end_seconds": 195.2,
      "duration_seconds": 4.94,
      "text": "Uh, I'm allergic to trimethoprim, I get itching."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.21,
      "end_seconds": 206.24,
      "duration_seconds": 4.03,
      "text": "Okay, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.8,
      "end_seconds": 212.35,
      "duration_seconds": 4.55,
      "text": "I'm on simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 213.65,
      "end_seconds": 218.41,
      "duration_seconds": 4.76,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.03,
      "end_seconds": 226.85,
      "duration_seconds": 4.82,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.87,
      "end_seconds": 251.22,
      "duration_seconds": 22.35,
      "text": "Hmm, not with me. I'll bring it next time. Right, you know, I take hydrochlorothiazide, 12.5 milligrams, every morning. Dolo, 650 milligrams, when I get the fever. I was on ramipril before. I stopped taking it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.3,
      "end_seconds": 266.5,
      "duration_seconds": 3.2,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.33,
      "end_seconds": 273.8,
      "duration_seconds": 6.47,
      "text": "Actually, my grandfather had a stroke. Oh, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 286.87,
      "end_seconds": 297.13,
      "duration_seconds": 10.26,
      "text": "Doctor, I've got the readings for you. Blood pressure 113 over 69, temperature 38.4, respiratory rate 16, pulse 90, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.98,
      "end_seconds": 300.5,
      "duration_seconds": 1.52,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.02,
      "end_seconds": 304.89,
      "duration_seconds": 2.87,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.52,
      "end_seconds": 309.65,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.46,
      "end_seconds": 312.9,
      "duration_seconds": 2.44,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.8,
      "end_seconds": 329.24,
      "duration_seconds": 6.44,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.01,
      "end_seconds": 334.71,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.0,
      "end_seconds": 338.47,
      "duration_seconds": 2.47,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 350.41,
      "end_seconds": 352.49,
      "duration_seconds": 2.08,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 355.8,
      "end_seconds": 376.98,
      "duration_seconds": 21.18,
      "text": "Thank you, you can get dressed. I'd like to arrange a chest X-ray for night sweats. Let's get blood tests, for night sweats. Keep a note of your temperature each evening. The haematology clinic would be the right next step, I'll refer you."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 378.29,
      "end_seconds": 381.49,
      "duration_seconds": 3.2,
      "text": "Ah, sure, where do I go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 382.8,
      "end_seconds": 406.12,
      "duration_seconds": 23.32,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I'm not ordering an ultrasound of the armpit today. If things carry on in two weeks, we'll consider it. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 407.16,
      "end_seconds": 408.86,
      "duration_seconds": 1.7,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 410.79,
      "end_seconds": 417.56,
      "duration_seconds": 6.77,
      "text": "Let's plan a check after the results are back. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 419.52,
      "end_seconds": 422.56,
      "duration_seconds": 3.04,
      "text": "That's clear, you know, thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 424.53,
      "end_seconds": 425.78,
      "duration_seconds": 1.25,
      "text": "See you soon."
    }
  ]
}