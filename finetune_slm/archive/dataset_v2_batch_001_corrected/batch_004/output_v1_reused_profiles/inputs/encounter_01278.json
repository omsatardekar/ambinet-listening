{
  "schema_version": "1.0",
  "encounter_id": "01278",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 4.06,
      "duration_seconds": 3.01,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.15,
      "end_seconds": 9.71,
      "duration_seconds": 4.56,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.97,
      "end_seconds": 17.61,
      "duration_seconds": 6.64,
      "text": "it's my heart racing i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.21,
      "end_seconds": 21.79,
      "duration_seconds": 3.58,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.4,
      "end_seconds": 25.63,
      "duration_seconds": 3.23,
      "text": "It's been about a month now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.55,
      "end_seconds": 28.92,
      "duration_seconds": 2.37,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.62,
      "end_seconds": 32.76,
      "duration_seconds": 3.14,
      "text": "it's a couple of times a week"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.52,
      "end_seconds": 51.96,
      "duration_seconds": 4.44,
      "text": "And what about eye pain, neck swelling or fever?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.64,
      "end_seconds": 55.84,
      "duration_seconds": 2.2,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.17,
      "end_seconds": 62.57,
      "duration_seconds": 3.4,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.77,
      "end_seconds": 68.28,
      "duration_seconds": 1.51,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 73.24,
      "duration_seconds": 2.94,
      "text": "So, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.24,
      "end_seconds": 75.64,
      "duration_seconds": 1.4,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.76,
      "end_seconds": 80.14,
      "duration_seconds": 3.38,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.23,
      "end_seconds": 85.89,
      "duration_seconds": 1.66,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.15,
      "end_seconds": 91.73,
      "duration_seconds": 4.58,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.05,
      "end_seconds": 98.04,
      "duration_seconds": 1.99,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.12,
      "end_seconds": 101.69,
      "duration_seconds": 2.57,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.46,
      "end_seconds": 107.93,
      "duration_seconds": 5.47,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.57,
      "end_seconds": 111.56,
      "duration_seconds": 2.99,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.73,
      "end_seconds": 114.4,
      "duration_seconds": 1.67,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.31,
      "end_seconds": 136.68,
      "duration_seconds": 3.37,
      "text": "so, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.39,
      "end_seconds": 141.79,
      "duration_seconds": 3.4,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.37,
      "end_seconds": 164.54,
      "duration_seconds": 4.17,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.27,
      "end_seconds": 181.4,
      "duration_seconds": 16.13,
      "text": "I only drink at family occasions. I've never touched a cigarette. I hardly move around during the day. I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.51,
      "end_seconds": 196.44,
      "duration_seconds": 2.93,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.14,
      "end_seconds": 208.69,
      "duration_seconds": 2.55,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.8,
      "end_seconds": 231.92,
      "duration_seconds": 7.12,
      "text": "Okay: pressure 117 over 81, temperature is 36.7 degrees, pulse is 105 beats a minute."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.68,
      "end_seconds": 235.06,
      "duration_seconds": 1.38,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.09,
      "end_seconds": 238.07,
      "duration_seconds": 1.98,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.81,
      "end_seconds": 244.32,
      "duration_seconds": 3.51,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.51,
      "end_seconds": 247.1,
      "duration_seconds": 1.59,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.37,
      "end_seconds": 250.74,
      "duration_seconds": 2.37,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.34,
      "end_seconds": 268.72,
      "duration_seconds": 7.38,
      "text": "there is a fine tremor of the outstretched hands and the pulse is fast and regular"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.64,
      "end_seconds": 272.35,
      "duration_seconds": 2.71,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.56,
      "end_seconds": 291.37,
      "duration_seconds": 4.81,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.63,
      "end_seconds": 305.75,
      "duration_seconds": 9.12,
      "text": "thank you, you can get dressed okay, so my impression is this: The most likely explanation is an overactive thyroid"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.35,
      "end_seconds": 309.05,
      "duration_seconds": 1.7,
      "text": "is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.11,
      "end_seconds": 325.59,
      "duration_seconds": 13.48,
      "text": "Nothing I've seen today points to an emergency. It looks like an overactive thyroid, but I'd like to confirm. Let's get thyroid blood tests, for palpitations and weight loss."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 326.12,
      "end_seconds": 329.66,
      "duration_seconds": 3.54,
      "text": "I can book that for Wednesday at 9 am."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.72,
      "end_seconds": 361.72,
      "duration_seconds": 30.0,
      "text": "I'm prescribing propranolol, 20 milligrams, twice a day, until review. You take it by mouth. That should help with racing heart and tremor. Try to avoid caffeine while we sort this out. I'm going to send a referral to the endocrine clinic. I'd like you back after the thyroid results. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.23,
      "end_seconds": 365.22,
      "duration_seconds": 2.99,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.69,
      "end_seconds": 371.01,
      "duration_seconds": 1.32,
      "text": "Take care now."
    }
  ]
}