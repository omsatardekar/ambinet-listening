{
  "schema_version": "1.0",
  "encounter_id": "01064",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 3.44,
      "duration_seconds": 2.76,
      "text": "morning doctor. Lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.9,
      "end_seconds": 9.49,
      "duration_seconds": 4.59,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.44,
      "end_seconds": 24.18,
      "duration_seconds": 13.74,
      "text": "it's a high fever with shaking chills, mostly my neighbour said I should get it looked at sorry, I know I'm rambling a bit"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.71,
      "end_seconds": 26.56,
      "duration_seconds": 1.85,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.26,
      "end_seconds": 31.78,
      "duration_seconds": 4.52,
      "text": "Uh it's been one week I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.4,
      "end_seconds": 40.6,
      "duration_seconds": 8.2,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.56,
      "end_seconds": 53.8,
      "duration_seconds": 12.24,
      "text": "I, I get some relief from paracetamol. I notice it more with evenings. Well, I've been sweating a lot too, since yesterday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.22,
      "end_seconds": 58.3,
      "duration_seconds": 2.08,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.06,
      "end_seconds": 67.43,
      "duration_seconds": 8.37,
      "text": "It's a couple of times a week. So, I've also been feeling sick, for five days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.66,
      "end_seconds": 87.92,
      "duration_seconds": 4.26,
      "text": "Did you get confusion, diarrhoea, neck stiffness or yellow eyes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.87,
      "end_seconds": 90.73,
      "duration_seconds": 1.86,
      "text": "none of those no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.39,
      "end_seconds": 94.02,
      "duration_seconds": 2.63,
      "text": "is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.07,
      "end_seconds": 96.42,
      "duration_seconds": 1.35,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.6,
      "end_seconds": 100.36,
      "duration_seconds": 2.76,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.97,
      "end_seconds": 107.1,
      "duration_seconds": 5.13,
      "text": "yes, I had my tonsils removed, as a teenager"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.06,
      "end_seconds": 125.73,
      "duration_seconds": 2.67,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.78,
      "end_seconds": 138.57,
      "duration_seconds": 9.79,
      "text": "I've had heart disease for about a year now. I took the morning off to come in today. I've got migraines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.69,
      "end_seconds": 147.22,
      "duration_seconds": 7.53,
      "text": "Alright, migraines, that matches what I have here. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.86,
      "end_seconds": 152.0,
      "duration_seconds": 4.14,
      "text": "Naproxen. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.47,
      "end_seconds": 157.23,
      "duration_seconds": 3.76,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.63,
      "end_seconds": 176.99,
      "duration_seconds": 18.36,
      "text": "mm I take metoprolol 50 milligrams twice a day for my heart. It's propranolol 40 milligrams twice a day for the migraine prevention. Dolo. I take it 650 milligrams when I get the fever"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.88,
      "end_seconds": 182.66,
      "duration_seconds": 4.78,
      "text": "tell me about your routine, work, habits, that sort of thing"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.47,
      "end_seconds": 195.26,
      "duration_seconds": 10.79,
      "text": "I live with my elderly mother. I work in accounts at a hospital. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.44,
      "end_seconds": 200.61,
      "duration_seconds": 4.17,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.41,
      "end_seconds": 213.88,
      "duration_seconds": 2.47,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.95,
      "end_seconds": 236.17,
      "duration_seconds": 9.22,
      "text": "Okay: blood pressure 119 over 67, respiratory rate 16, heart rate 96, saturation 97 percent, temp 38.4 degrees."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.19,
      "end_seconds": 239.79,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.6,
      "end_seconds": 244.96,
      "duration_seconds": 3.36,
      "text": "alright, we'll look at it together shortly"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.94,
      "end_seconds": 250.1,
      "duration_seconds": 3.16,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.46,
      "end_seconds": 255.26,
      "duration_seconds": 1.8,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.82,
      "end_seconds": 258.16,
      "duration_seconds": 1.34,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.78,
      "end_seconds": 281.24,
      "duration_seconds": 4.46,
      "text": "the spleen tip is just palpable and the chest is clear"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.89,
      "end_seconds": 288.39,
      "duration_seconds": 2.5,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.23,
      "end_seconds": 308.9,
      "duration_seconds": 12.67,
      "text": "Let's get blood cultures, for fever. Avoid anti-inflammatory painkillers and keep drinking. Do get help quickly if you become confused or cannot keep fluids down. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.44,
      "end_seconds": 311.18,
      "duration_seconds": 1.74,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.18,
      "end_seconds": 314.41,
      "duration_seconds": 1.23,
      "text": "all the best"
    }
  ]
}