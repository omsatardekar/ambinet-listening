{
  "schema_version": "1.0",
  "encounter_id": "01405",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 4.67,
      "duration_seconds": 3.6,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 11.59,
      "duration_seconds": 5.0,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.62,
      "end_seconds": 20.12,
      "duration_seconds": 6.5,
      "text": "Well, doctor, it's an itchy rash all over. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.71,
      "end_seconds": 28.05,
      "duration_seconds": 6.34,
      "text": "Has this been going on for long? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.78,
      "end_seconds": 32.79,
      "duration_seconds": 3.01,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.78,
      "end_seconds": 36.89,
      "duration_seconds": 3.11,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.31,
      "end_seconds": 40.11,
      "duration_seconds": 1.8,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.83,
      "end_seconds": 61.07,
      "duration_seconds": 3.24,
      "text": "Any fainting, wheeze or trouble breathing at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.81,
      "end_seconds": 65.32,
      "duration_seconds": 2.51,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.69,
      "end_seconds": 69.77,
      "duration_seconds": 3.08,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.16,
      "end_seconds": 73.48,
      "duration_seconds": 2.32,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.63,
      "end_seconds": 90.5,
      "duration_seconds": 6.87,
      "text": "Do you have any medical conditions I should know about? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.89,
      "end_seconds": 96.14,
      "duration_seconds": 4.25,
      "text": "No, uh, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.14,
      "end_seconds": 100.19,
      "duration_seconds": 3.05,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.16,
      "end_seconds": 104.89,
      "duration_seconds": 3.73,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.47,
      "end_seconds": 108.87,
      "duration_seconds": 2.4,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.58,
      "end_seconds": 114.96,
      "duration_seconds": 4.38,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.26,
      "end_seconds": 136.87,
      "duration_seconds": 3.61,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.68,
      "end_seconds": 143.93,
      "duration_seconds": 5.25,
      "text": "Let me think, um, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.43,
      "end_seconds": 165.11,
      "duration_seconds": 3.68,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.52,
      "end_seconds": 170.33,
      "duration_seconds": 3.81,
      "text": "It's cetirizine, 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.46,
      "end_seconds": 174.67,
      "duration_seconds": 3.21,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.3,
      "end_seconds": 190.14,
      "duration_seconds": 2.84,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.47,
      "end_seconds": 218.26,
      "duration_seconds": 6.79,
      "text": "Okay: saturation 97 percent, temperature is 36.9 degrees, blood pressure 127 over 81, pulse 85."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.11,
      "end_seconds": 225.62,
      "duration_seconds": 4.51,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.5,
      "end_seconds": 229.18,
      "duration_seconds": 1.68,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.11,
      "end_seconds": 248.12,
      "duration_seconds": 11.01,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.43,
      "end_seconds": 250.53,
      "duration_seconds": 1.1,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.5,
      "end_seconds": 265.61,
      "duration_seconds": 12.11,
      "text": "Thank you, you can get dressed. From what you've told me and what I found, I'd lean towards an allergic reaction, possibly to a recently started medicine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.33,
      "end_seconds": 269.66,
      "duration_seconds": 3.33,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.26,
      "end_seconds": 302.22,
      "duration_seconds": 31.96,
      "text": "I understand the worry. At the moment I'd say it's an allergic reaction, possibly to a recently started medicine, and we'll watch how it goes. I'm going to put you on prednisolone, 30 milligrams, once a day, for three days. It's for allergic reaction. Stop the new tablet until we know what caused it and write down every medicine you took in the last week. Let's plan a check in two days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.73,
      "end_seconds": 305.52,
      "duration_seconds": 1.79,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.82,
      "end_seconds": 309.8,
      "duration_seconds": 2.98,
      "text": "Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.43,
      "end_seconds": 314.39,
      "duration_seconds": 2.96,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.93,
      "end_seconds": 317.17,
      "duration_seconds": 1.24,
      "text": "See you soon."
    }
  ]
}