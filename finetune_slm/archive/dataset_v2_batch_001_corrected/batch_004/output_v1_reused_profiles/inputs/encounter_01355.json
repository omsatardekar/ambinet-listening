{
  "schema_version": "1.0",
  "encounter_id": "01355",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.06,
      "duration_seconds": 3.05,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 9.45,
      "duration_seconds": 4.44,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.66,
      "end_seconds": 15.66,
      "duration_seconds": 5.0,
      "text": "So the thing is, I've got being very thirsty."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.81,
      "end_seconds": 19.23,
      "duration_seconds": 2.42,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.31,
      "end_seconds": 26.65,
      "duration_seconds": 5.34,
      "text": "Around six months... no wait, it's more like about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.36,
      "end_seconds": 38.48,
      "duration_seconds": 10.12,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.05,
      "end_seconds": 45.23,
      "duration_seconds": 6.18,
      "text": "I get some relief from drinking water. It feels moderate to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.92,
      "end_seconds": 49.56,
      "duration_seconds": 2.64,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.14,
      "end_seconds": 54.38,
      "duration_seconds": 3.24,
      "text": "It usually comes with blurry vision."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.9,
      "end_seconds": 70.54,
      "duration_seconds": 3.64,
      "text": "Any fruity smelling breath, vomiting, confusion or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.78,
      "end_seconds": 75.15,
      "duration_seconds": 3.37,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.44,
      "end_seconds": 78.82,
      "duration_seconds": 2.38,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.46,
      "end_seconds": 83.12,
      "duration_seconds": 2.66,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.65,
      "end_seconds": 86.39,
      "duration_seconds": 2.74,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.52,
      "end_seconds": 93.72,
      "duration_seconds": 6.2,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 104.67,
      "duration_seconds": 3.21,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.73,
      "end_seconds": 108.33,
      "duration_seconds": 1.6,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.47,
      "end_seconds": 124.21,
      "duration_seconds": 7.74,
      "text": "Okay, do you react to any medicines or foods? Any allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.37,
      "end_seconds": 128.28,
      "duration_seconds": 2.91,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.99,
      "end_seconds": 135.86,
      "duration_seconds": 2.87,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.95,
      "end_seconds": 139.68,
      "duration_seconds": 2.73,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.47,
      "end_seconds": 145.09,
      "duration_seconds": 1.62,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.1,
      "end_seconds": 149.63,
      "duration_seconds": 3.53,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.22,
      "end_seconds": 153.68,
      "duration_seconds": 2.46,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.25,
      "end_seconds": 158.87,
      "duration_seconds": 3.62,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.18,
      "end_seconds": 166.18,
      "duration_seconds": 6.0,
      "text": "Do you have any long-term conditions? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.36,
      "end_seconds": 175.56,
      "duration_seconds": 8.2,
      "text": "I have high cholesterol, for about ten years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.91,
      "end_seconds": 179.81,
      "duration_seconds": 2.9,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.47,
      "end_seconds": 191.5,
      "duration_seconds": 2.03,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.02,
      "end_seconds": 211.17,
      "duration_seconds": 7.15,
      "text": "Okay: BP is 162 over 96, pulse is 82 beats a minute, temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.73,
      "end_seconds": 215.71,
      "duration_seconds": 2.98,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.01,
      "end_seconds": 220.7,
      "duration_seconds": 3.69,
      "text": "Alright, I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.34,
      "end_seconds": 226.23,
      "duration_seconds": 3.89,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.35,
      "end_seconds": 228.66,
      "duration_seconds": 1.31,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.87,
      "end_seconds": 253.07,
      "duration_seconds": 7.2,
      "text": "Your fingerprick sugar here is high, and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.64,
      "end_seconds": 272.34,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.78,
      "end_seconds": 285.72,
      "duration_seconds": 9.94,
      "text": "Please sit back down. Let me tell you where I've got to. My working impression is symptoms that point to newly developed type 2 diabetes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.72,
      "end_seconds": 291.64,
      "duration_seconds": 3.92,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.3,
      "end_seconds": 323.66,
      "duration_seconds": 31.36,
      "text": "I can't promise yet, but most people with symptoms that point to newly developed type 2 diabetes do well once it's treated properly. Let's book an HbA1c to look into suspected diabetes. You'll be taking metformin, 500 milligrams, once a day with food, long term. You take it by mouth. That should help with high blood sugar. Cut right down on sugary drinks and keep water with you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.72,
      "end_seconds": 341.03,
      "duration_seconds": 16.31,
      "text": "Let's hold off on a fasting blood sugar for now, and if there's no change next month we can revisit it. One warning sign to remember: you are vomiting or feel confused. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.6,
      "end_seconds": 343.26,
      "duration_seconds": 1.66,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.43,
      "end_seconds": 351.67,
      "duration_seconds": 7.24,
      "text": "I'd like you back in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.52,
      "end_seconds": 357.45,
      "duration_seconds": 3.93,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}