{
  "schema_version": "1.0",
  "encounter_id": "01474",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.77,
      "end_seconds": 3.61,
      "duration_seconds": 2.84,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.25,
      "end_seconds": 8.21,
      "duration_seconds": 2.96,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.82,
      "end_seconds": 12.63,
      "duration_seconds": 2.81,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.89,
      "end_seconds": 18.12,
      "duration_seconds": 4.23,
      "text": "I'm here because of drenching night sweats"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.79,
      "end_seconds": 24.07,
      "duration_seconds": 4.28,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 31.64,
      "duration_seconds": 5.47,
      "text": "I, I take simvastatin, 20 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.3,
      "end_seconds": 37.21,
      "duration_seconds": 3.91,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.68,
      "end_seconds": 45.64,
      "duration_seconds": 6.96,
      "text": "uh, uh, not with me. I'll bring it it next time"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.68,
      "end_seconds": 56.21,
      "duration_seconds": 8.53,
      "text": "It's, It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.05,
      "end_seconds": 63.96,
      "duration_seconds": 2.91,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.68,
      "end_seconds": 85.55,
      "duration_seconds": 20.87,
      "text": "Let me think, um, for my pressure, I believe. My daughter sets them out for me, I just take what I'm given. Dolo. I take it 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 89.98,
      "end_seconds": 95.27,
      "duration_seconds": 5.29,
      "text": "Doctor, our chart from the last visit lists it as 325 milligrams."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.29,
      "end_seconds": 99.47,
      "duration_seconds": 3.18,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 100.99,
      "end_seconds": 105.69,
      "duration_seconds": 4.7,
      "text": "Yeah, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.46,
      "end_seconds": 109.5,
      "duration_seconds": 3.04,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.6,
      "end_seconds": 116.81,
      "duration_seconds": 6.21,
      "text": "Four weeks, I think... sorry, about two weeks, I got that wrong."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.44,
      "end_seconds": 120.01,
      "duration_seconds": 2.57,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.03,
      "end_seconds": 125.18,
      "duration_seconds": 3.15,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.23,
      "end_seconds": 130.1,
      "duration_seconds": 2.87,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.38,
      "end_seconds": 138.52,
      "duration_seconds": 7.14,
      "text": "Well, uh, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.41,
      "end_seconds": 145.96,
      "duration_seconds": 5.55,
      "text": "take your time. Mild, moderate, or severe, if you had to to pick?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.53,
      "end_seconds": 149.63,
      "duration_seconds": 2.1,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.85,
      "end_seconds": 153.11,
      "duration_seconds": 2.26,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.19,
      "end_seconds": 162.94,
      "duration_seconds": 7.75,
      "text": "A low fever in the evenings goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.41,
      "end_seconds": 169.87,
      "duration_seconds": 6.46,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 169.97,
      "end_seconds": 176.75,
      "duration_seconds": 6.78,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.59,
      "end_seconds": 180.34,
      "duration_seconds": 2.75,
      "text": "Alright, later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.86,
      "end_seconds": 187.94,
      "duration_seconds": 7.08,
      "text": "Hmm, the low fever in the evenings? That's been for two weeks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.46,
      "end_seconds": 190.52,
      "duration_seconds": 2.06,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.63,
      "end_seconds": 194.66,
      "duration_seconds": 3.03,
      "text": "It happens all the time."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.81,
      "end_seconds": 199.07,
      "duration_seconds": 3.26,
      "text": "Has there been itching all over too?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.93,
      "end_seconds": 203.35,
      "duration_seconds": 2.42,
      "text": "Yes, since last weekend."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.12,
      "end_seconds": 210.39,
      "duration_seconds": 6.27,
      "text": "Is it there all the time or does it come and and go?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.15,
      "end_seconds": 218.65,
      "duration_seconds": 7.5,
      "text": "I'd say on and off. I've also been feeling run down, for two weeks"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.71,
      "end_seconds": 222.72,
      "duration_seconds": 3.01,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.65,
      "end_seconds": 228.58,
      "duration_seconds": 3.93,
      "text": "A eight out of ten, I suppose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 230.33,
      "end_seconds": 232.69,
      "duration_seconds": 2.36,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.85,
      "end_seconds": 253.12,
      "duration_seconds": 6.27,
      "text": "Let me check a few things. Any cough, joint pain or weight loss?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.15,
      "end_seconds": 256.81,
      "duration_seconds": 2.66,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.14,
      "end_seconds": 265.16,
      "duration_seconds": 6.02,
      "text": "Let me check a few things. Any diarrhoea, recent travel or chest pain?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 266.89,
      "end_seconds": 269.0,
      "duration_seconds": 2.11,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.02,
      "end_seconds": 273.05,
      "duration_seconds": 2.03,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.57,
      "end_seconds": 275.33,
      "duration_seconds": 1.76,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.01,
      "end_seconds": 278.9,
      "duration_seconds": 2.89,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.92,
      "end_seconds": 287.3,
      "duration_seconds": 7.38,
      "text": "Yes, I had a wisdom tooth extraction under sedation, five years ago."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.29,
      "end_seconds": 291.24,
      "duration_seconds": 2.95,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.02,
      "end_seconds": 297.0,
      "duration_seconds": 4.98,
      "text": "actually, I've had high cholesterol for about a year now"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.83,
      "end_seconds": 299.77,
      "duration_seconds": 0.94,
      "text": "hm, okay"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.74,
      "end_seconds": 306.87,
      "duration_seconds": 5.13,
      "text": "Oh, I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.29,
      "end_seconds": 311.88,
      "duration_seconds": 3.59,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.56,
      "end_seconds": 327.05,
      "duration_seconds": 14.49,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.46,
      "end_seconds": 331.18,
      "duration_seconds": 2.72,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.96,
      "end_seconds": 334.48,
      "duration_seconds": 2.52,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.44,
      "end_seconds": 339.74,
      "duration_seconds": 3.3,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.6,
      "end_seconds": 345.07,
      "duration_seconds": 3.47,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.62,
      "end_seconds": 348.11,
      "duration_seconds": 2.49,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.17,
      "end_seconds": 353.96,
      "duration_seconds": 3.79,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 355.1,
      "end_seconds": 364.43,
      "duration_seconds": 9.33,
      "text": "Doctor, I've got the readings for you. Saturation 98 percent, height 174 centimetres, BP is 105 over 77. Pulse 95, weight 76 kilos."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.09,
      "end_seconds": 369.17,
      "duration_seconds": 1.08,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 370.66,
      "end_seconds": 372.89,
      "duration_seconds": 2.23,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.42,
      "end_seconds": 376.21,
      "duration_seconds": 1.79,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 385.31,
      "end_seconds": 391.7,
      "duration_seconds": 6.39,
      "text": "there's a firm, rubbery gland about two centimetres in the left armpit, not tender"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.44,
      "end_seconds": 394.61,
      "duration_seconds": 1.17,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 404.44,
      "end_seconds": 406.71,
      "duration_seconds": 2.27,
      "text": "I can't feel your spleen"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 411.77,
      "end_seconds": 413.87,
      "duration_seconds": 2.1,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 425.96,
      "end_seconds": 452.46,
      "duration_seconds": 26.5,
      "text": "Okay, thinking it through, I think we're dealing with an enlarged gland with night sweats that needs a proper work-up at this stage. I want to be honest that that this is an impression, not a final answer. It could also be a lingering infection, so we'll keep that open. We shouldn't forget a blood condition. Let's get a chest X-ray, for night sweats."
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 454.36,
      "end_seconds": 458.41,
      "duration_seconds": 4.05,
      "text": "I can book that for Tuesday at 10 am."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 462.7,
      "end_seconds": 484.14,
      "duration_seconds": 21.44,
      "text": "let's get blood tests, for night sweats keep a note of your temperature each evening and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose let's review you after the results are back alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 485.96,
      "end_seconds": 489.34,
      "duration_seconds": 3.38,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 490.47,
      "end_seconds": 491.76,
      "duration_seconds": 1.29,
      "text": "see you soon"
    }
  ]
}