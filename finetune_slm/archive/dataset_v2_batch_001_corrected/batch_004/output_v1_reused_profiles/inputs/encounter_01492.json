{
  "schema_version": "1.0",
  "encounter_id": "01492",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 8.7,
      "duration_seconds": 7.4,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.81,
      "end_seconds": 19.48,
      "duration_seconds": 5.67,
      "text": "Right, not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.36,
      "end_seconds": 26.71,
      "duration_seconds": 6.35,
      "text": "Hmm, I wanted to get gritty tired eyes looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.74,
      "end_seconds": 32.04,
      "duration_seconds": 3.3,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.35,
      "end_seconds": 39.7,
      "duration_seconds": 6.35,
      "text": "Sorry, what was I saying, I've had it since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.28,
      "end_seconds": 46.33,
      "duration_seconds": 5.05,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.87,
      "end_seconds": 58.72,
      "duration_seconds": 10.85,
      "text": "Ah, yes, air conditioning. That makes it worse. I'd call it severe. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.6,
      "end_seconds": 64.02,
      "duration_seconds": 3.42,
      "text": "Okay, is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.83,
      "end_seconds": 92.14,
      "duration_seconds": 26.31,
      "text": "Blurry vision that clears when I blink goes along with it, you know, most of the time. As for blurry vision that clears when I blink, it feels mild to me. It settles a little with blinking. Right, I did have redness by the evening at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.02,
      "end_seconds": 96.68,
      "duration_seconds": 3.66,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.83,
      "end_seconds": 108.24,
      "duration_seconds": 2.41,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.43,
      "end_seconds": 128.6,
      "duration_seconds": 9.17,
      "text": "Okay: heart rate 86, weight 72 kilos. And BP is 125 over 73, height 161 centimetres, temperature 36.7, respiratory rate 14."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.9,
      "end_seconds": 133.55,
      "duration_seconds": 3.65,
      "text": "Hmm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.09,
      "end_seconds": 137.88,
      "duration_seconds": 3.79,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.44,
      "end_seconds": 142.01,
      "duration_seconds": 2.57,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.14,
      "end_seconds": 145.79,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.41,
      "end_seconds": 164.8,
      "duration_seconds": 4.39,
      "text": "The eyes look a little pink but the corneas are clear."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.61,
      "end_seconds": 167.63,
      "duration_seconds": 1.02,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.48,
      "end_seconds": 174.4,
      "duration_seconds": 1.92,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.37,
      "end_seconds": 184.31,
      "duration_seconds": 1.94,
      "text": "What about double vision?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.78,
      "end_seconds": 194.1,
      "duration_seconds": 4.32,
      "text": "Yeah, I haven't noticed any double vision."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.4,
      "end_seconds": 203.37,
      "duration_seconds": 8.97,
      "text": "Mm, okay. Let me check a few things. Any loss of vision, sensitivity to light or dry mouth?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.0,
      "end_seconds": 208.32,
      "duration_seconds": 3.32,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.61,
      "end_seconds": 212.36,
      "duration_seconds": 3.75,
      "text": "Understood. How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.13,
      "end_seconds": 216.98,
      "duration_seconds": 2.85,
      "text": "Right, no, that's been fine."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.95,
      "end_seconds": 220.38,
      "duration_seconds": 2.43,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.59,
      "end_seconds": 228.45,
      "duration_seconds": 1.86,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 239.37,
      "duration_seconds": 2.46,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.82,
      "end_seconds": 245.87,
      "duration_seconds": 5.05,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.74,
      "end_seconds": 249.31,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.84,
      "end_seconds": 272.25,
      "duration_seconds": 19.41,
      "text": "I've, I've had arthritis in my knees for two years now. I thought it would sort itself out, you know, but it hasn't. I've had asthma for two years now. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.31,
      "end_seconds": 274.65,
      "duration_seconds": 1.34,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.7,
      "end_seconds": 279.39,
      "duration_seconds": 3.69,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.24,
      "end_seconds": 299.99,
      "duration_seconds": 1.75,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.35,
      "end_seconds": 302.56,
      "duration_seconds": 1.21,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.13,
      "end_seconds": 305.55,
      "duration_seconds": 2.42,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 308.7,
      "end_seconds": 312.98,
      "duration_seconds": 4.28,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.62,
      "end_seconds": 315.28,
      "duration_seconds": 1.66,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.94,
      "end_seconds": 321.05,
      "duration_seconds": 4.11,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.82,
      "end_seconds": 325.61,
      "duration_seconds": 2.79,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.64,
      "end_seconds": 330.65,
      "duration_seconds": 4.01,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.44,
      "end_seconds": 338.98,
      "duration_seconds": 3.54,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.81,
      "end_seconds": 344.98,
      "duration_seconds": 5.17,
      "text": "Diclofenac. I take it 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.53,
      "end_seconds": 351.62,
      "duration_seconds": 3.09,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.28,
      "end_seconds": 368.8,
      "duration_seconds": 15.52,
      "text": "Not with me. I'll bring it next time. Mm, it's Seretide inhaler, twice a day for my asthma. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.82,
      "end_seconds": 372.6,
      "duration_seconds": 2.78,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.34,
      "end_seconds": 375.99,
      "duration_seconds": 1.65,
      "text": "For six months."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.39,
      "end_seconds": 406.02,
      "duration_seconds": 29.63,
      "text": "I see, go ahead. Having listened and examined, I think we're dealing with dry eye at this stage. I'd also keep an allergic eye problem in mind. What I'm giving you is lubricating eye drops, four times a day, for one month. It's for dry eye. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.58,
      "end_seconds": 410.89,
      "duration_seconds": 3.31,
      "text": "Thank you, you know, that's clear."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.53,
      "end_seconds": 416.44,
      "duration_seconds": 3.91,
      "text": "Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.67,
      "end_seconds": 423.19,
      "duration_seconds": 3.52,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.37,
      "end_seconds": 425.6,
      "duration_seconds": 1.23,
      "text": "Goodbye for now."
    }
  ]
}