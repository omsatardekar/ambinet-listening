{
  "schema_version": "1.0",
  "encounter_id": "01295",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 4.54,
      "duration_seconds": 3.79,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.71,
      "end_seconds": 9.47,
      "duration_seconds": 3.76,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.87,
      "end_seconds": 19.52,
      "duration_seconds": 8.65,
      "text": "So, I've been waking up breathless at night, doctor. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.79,
      "end_seconds": 26.28,
      "duration_seconds": 3.49,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.94,
      "end_seconds": 35.36,
      "duration_seconds": 8.42,
      "text": "Oh, probably about a month. Yeah. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.92,
      "end_seconds": 39.4,
      "duration_seconds": 3.48,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.13,
      "end_seconds": 43.69,
      "duration_seconds": 3.56,
      "text": "A five out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.22,
      "end_seconds": 47.74,
      "duration_seconds": 2.52,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.61,
      "end_seconds": 65.53,
      "duration_seconds": 15.92,
      "text": "It settles a little with sitting up. As for tight stomach, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.41,
      "end_seconds": 76.02,
      "duration_seconds": 2.61,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.29,
      "end_seconds": 86.98,
      "duration_seconds": 9.69,
      "text": "I have heart failure. An irregular heartbeat, for about a year. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.11,
      "end_seconds": 93.04,
      "duration_seconds": 0.93,
      "text": "anything else?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.63,
      "end_seconds": 101.11,
      "duration_seconds": 7.48,
      "text": "Okay, I can see heart failure in your file as well. Who lives with you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.37,
      "end_seconds": 104.8,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.98,
      "end_seconds": 108.27,
      "duration_seconds": 2.29,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.16,
      "end_seconds": 114.2,
      "duration_seconds": 4.04,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.28,
      "end_seconds": 119.38,
      "duration_seconds": 3.1,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.48,
      "end_seconds": 124.84,
      "duration_seconds": 4.36,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.7,
      "end_seconds": 141.45,
      "duration_seconds": 2.75,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.33,
      "end_seconds": 145.6,
      "duration_seconds": 2.27,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.42,
      "end_seconds": 150.6,
      "duration_seconds": 4.18,
      "text": "Right, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.46,
      "end_seconds": 161.21,
      "duration_seconds": 9.75,
      "text": "Spironolactone. I take it it 25 milligrams, once a day for my heart. I take apixaban, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.9,
      "end_seconds": 165.12,
      "duration_seconds": 3.22,
      "text": "alright, do you know the the dose?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.57,
      "end_seconds": 173.83,
      "duration_seconds": 4.26,
      "text": "5 milligrams, I think that's what's on the box"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.11,
      "end_seconds": 174.81,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.75,
      "end_seconds": 190.57,
      "duration_seconds": 4.82,
      "text": "have you had any cough with blood, palpitations or fainting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.21,
      "end_seconds": 194.25,
      "duration_seconds": 2.04,
      "text": "nope, nothing like that"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 199.11,
      "duration_seconds": 4.01,
      "text": "Have you had any chest pain or calf pain?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.92,
      "end_seconds": 206.01,
      "duration_seconds": 5.09,
      "text": "Um, I haven't had chest pain or calf pain, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.79,
      "end_seconds": 210.44,
      "duration_seconds": 3.65,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.0,
      "end_seconds": 214.59,
      "duration_seconds": 2.59,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.58,
      "end_seconds": 218.97,
      "duration_seconds": 3.39,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.69,
      "end_seconds": 221.99,
      "duration_seconds": 2.3,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.64,
      "end_seconds": 225.57,
      "duration_seconds": 2.93,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.97,
      "end_seconds": 241.78,
      "duration_seconds": 2.81,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.83,
      "end_seconds": 283.64,
      "duration_seconds": 24.81,
      "text": "Okay: pressure 116 over 70, temperature is 36.6 degrees, pulse 108, oxygen saturation is 97 percent. Going by what you've described, this looks most like fluid overload from heart failure. I want to be honest that this is an impression, not a final answer. A chest infection is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.18,
      "end_seconds": 287.66,
      "duration_seconds": 3.48,
      "text": "Oh, is there something to worry about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.23,
      "end_seconds": 303.34,
      "duration_seconds": 15.11,
      "text": "I understand the worry. At the moment I'd say it's fluid overload from heart failure, and we'll know more once the a chest X-ray is back. a chest X-ray is what I'd like next, for breathlessness."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.31,
      "end_seconds": 307.27,
      "duration_seconds": 2.96,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.7,
      "end_seconds": 314.22,
      "duration_seconds": 5.52,
      "text": "A heart ultrasound is what I'd like next, for suspected heart failure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.01,
      "end_seconds": 317.81,
      "duration_seconds": 2.8,
      "text": "where would I go for that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.68,
      "end_seconds": 329.71,
      "duration_seconds": 11.03,
      "text": "Weigh yourself every morning and tell us if you gain more than two kilos in three days. I think the community nursing team should see you too."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.36,
      "end_seconds": 332.06,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.68,
      "end_seconds": 352.14,
      "duration_seconds": 14.46,
      "text": "If you become more breathless or gain weight quickly, or you feel really unwell, please come to the emergency department. See me again in one week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.22,
      "end_seconds": 356.02,
      "duration_seconds": 2.8,
      "text": "So, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.1,
      "end_seconds": 358.9,
      "duration_seconds": 1.8,
      "text": "Have a good day."
    }
  ]
}