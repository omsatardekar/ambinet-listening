{
  "schema_version": "1.0",
  "encounter_id": "01221",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 6.11,
      "duration_seconds": 5.02,
      "text": "Let me think, sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.53,
      "end_seconds": 12.01,
      "duration_seconds": 4.48,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.84,
      "end_seconds": 22.8,
      "duration_seconds": 8.96,
      "text": "I've been dealing with pain in both knees. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.49,
      "end_seconds": 26.65,
      "duration_seconds": 3.16,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.35,
      "end_seconds": 40.57,
      "duration_seconds": 12.22,
      "text": "I'm on valsartan, 80 milligrams, once a day for my blood pressure. Paracetamol. I take it 650 milligrams, when needed"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.29,
      "end_seconds": 44.81,
      "duration_seconds": 3.52,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.42,
      "end_seconds": 52.04,
      "duration_seconds": 5.62,
      "text": "Okay, um, so I've had it for three weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.81,
      "end_seconds": 55.33,
      "duration_seconds": 2.52,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.12,
      "end_seconds": 60.78,
      "duration_seconds": 4.66,
      "text": "So, I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.66,
      "end_seconds": 68.02,
      "duration_seconds": 5.36,
      "text": "What about swelling in the right knee, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.73,
      "end_seconds": 71.35,
      "duration_seconds": 1.62,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.0,
      "end_seconds": 76.76,
      "duration_seconds": 3.76,
      "text": "How much trouble does it it give you?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.36,
      "end_seconds": 81.34,
      "duration_seconds": 2.98,
      "text": "I, I'd call it severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.75,
      "end_seconds": 83.28,
      "duration_seconds": 1.53,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.31,
      "end_seconds": 96.53,
      "duration_seconds": 11.22,
      "text": "Hmm, you know, there's a grinding sound when I move as well. About grinding sound when I move, moderate, really."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.27,
      "end_seconds": 102.48,
      "duration_seconds": 4.21,
      "text": "Did you get locking of the knee or back pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.33,
      "end_seconds": 106.94,
      "duration_seconds": 3.61,
      "text": "Hmm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.41,
      "end_seconds": 110.85,
      "duration_seconds": 2.44,
      "text": "Have you noticed fall or fever?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.03,
      "end_seconds": 119.7,
      "duration_seconds": 3.67,
      "text": "Mm, no, I'd have said so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.97,
      "end_seconds": 124.83,
      "duration_seconds": 1.86,
      "text": "Alright, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.67,
      "end_seconds": 127.52,
      "duration_seconds": 1.85,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.86,
      "end_seconds": 132.11,
      "duration_seconds": 3.25,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.92,
      "end_seconds": 136.13,
      "duration_seconds": 3.21,
      "text": "Yeah, no, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.58,
      "end_seconds": 151.51,
      "duration_seconds": 3.93,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.73,
      "end_seconds": 155.51,
      "duration_seconds": 2.78,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.39,
      "end_seconds": 160.99,
      "duration_seconds": 4.6,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.22,
      "end_seconds": 184.25,
      "duration_seconds": 22.03,
      "text": "I only drink at family occasions. I have about eight cigarettes in a day. I live with my elderly mother. I do a yoga class on Thursdays. I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.1,
      "end_seconds": 189.65,
      "duration_seconds": 3.55,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.16,
      "end_seconds": 201.6,
      "duration_seconds": 11.44,
      "text": "I've got diabetes. I've had high blood pressure for nearly five years now. I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 208.09,
      "duration_seconds": 4.53,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.5,
      "end_seconds": 220.67,
      "duration_seconds": 2.17,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.08,
      "end_seconds": 239.03,
      "duration_seconds": 6.95,
      "text": "okay: blood pressure 116 over 68, pulse 81, oxygen saturation is 99 percent, temperature 36.6."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.82,
      "end_seconds": 243.99,
      "duration_seconds": 2.17,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.76,
      "end_seconds": 248.85,
      "duration_seconds": 3.09,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.69,
      "end_seconds": 268.94,
      "duration_seconds": 6.25,
      "text": "There's mild swelling on the right knee, and a grating feel when I bend it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.82,
      "end_seconds": 272.76,
      "duration_seconds": 1.94,
      "text": "okay, breathe out slowly"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.44,
      "end_seconds": 296.85,
      "duration_seconds": 6.41,
      "text": "Bending is limited to about a right angle, and it hurts at the end"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.7,
      "end_seconds": 307.84,
      "duration_seconds": 1.14,
      "text": "of course"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.91,
      "end_seconds": 328.98,
      "duration_seconds": 16.07,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, I don't have a clear answer today: osteoarthritis of the knees is possible, and so is a meniscal problem."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.68,
      "end_seconds": 332.99,
      "duration_seconds": 2.31,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.67,
      "end_seconds": 341.49,
      "duration_seconds": 7.82,
      "text": "it's reasonable to be concerned, but right now osteoarthritis of the knees is my leading thought, not anything worse"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.58,
      "end_seconds": 369.67,
      "duration_seconds": 10.09,
      "text": "I'll request blood tests, it'll help with joint pain. I think an X-ray of both knees makes sense here, for knee pain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.64,
      "end_seconds": 377.01,
      "duration_seconds": 2.37,
      "text": "is that done today?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.91,
      "end_seconds": 385.17,
      "duration_seconds": 6.26,
      "text": "Let's use etoricoxib, 60 milligrams, once a day, for five days. It's for knee pain."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.89,
      "end_seconds": 389.61,
      "duration_seconds": 3.72,
      "text": "Fine, you know, I'll begin it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.67,
      "end_seconds": 400.92,
      "duration_seconds": 9.25,
      "text": "Losing even a few kilos takes a lot of load off the knees, and I'd like you to do the strengthening exercises."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.38,
      "end_seconds": 411.65,
      "duration_seconds": 10.27,
      "text": "mm-hmm i'm going to send a referral to physiotherapy do get help quickly if the symptoms get worse i'll want another look in six weeks"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.05,
      "end_seconds": 415.84,
      "duration_seconds": 2.79,
      "text": "Yes, um, that's manageable."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.09,
      "end_seconds": 419.63,
      "duration_seconds": 2.54,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 420.78,
      "end_seconds": 423.99,
      "duration_seconds": 3.21,
      "text": "Great, thank you for your help."
    }
  ]
}