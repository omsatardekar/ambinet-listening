      "role": "DOCTOR",
      "start_seconds": 136.5,
      "end_seconds": 139.19,
      "duration_seconds": 2.69,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.99,
      "end_seconds": 151.3,
      "duration_seconds": 10.31,
      "text": "just a a meniscus repair on my knee, four years ago i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.7,
      "end_seconds": 156.52,
      "duration_seconds": 3.82,
