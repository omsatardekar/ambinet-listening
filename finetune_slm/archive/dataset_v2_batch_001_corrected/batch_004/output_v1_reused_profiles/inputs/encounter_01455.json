      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.57,
      "end_seconds": 209.97,
      "duration_seconds": 4.4,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.18,
      "end_seconds": 230.67,
      "duration_seconds": 15.49,
      "text": "Uh, it's hydrochlorothiazide, 12.5 milligrams, every morning. I've been reading about it online and it worried me. I've never really been one for hospitals. Atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.58,
      "end_seconds": 233.67,
      "duration_seconds": 2.09,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.17,
      "end_seconds": 239.39,
      "duration_seconds": 4.22,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.12,
      "end_seconds": 241.75,
