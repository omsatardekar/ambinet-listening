{
  "schema_version": "1.0",
  "encounter_id": "01117",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.04,
      "end_seconds": 2.67,
      "duration_seconds": 1.63,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.64,
      "end_seconds": 9.91,
      "duration_seconds": 5.27,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 17.7,
      "duration_seconds": 5.99,
      "text": "Yeah, it's blood on the toilet paper. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.6,
      "end_seconds": 21.98,
      "duration_seconds": 2.38,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.59,
      "end_seconds": 25.22,
      "duration_seconds": 1.63,
      "text": "It started yesterday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.99,
      "end_seconds": 32.16,
      "duration_seconds": 5.17,
      "text": "So, have you had a small lump near the back passage?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.96,
      "end_seconds": 40.71,
      "duration_seconds": 7.75,
      "text": "Yeah, that too. Mm, there was pain when I pass stool, yes, but that went away."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "UNKNOWN",
      "start_seconds": 44.74,
      "end_seconds": 46.84,
      "duration_seconds": 2.1,
      "text": "Yes, exactly like that."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.27,
      "end_seconds": 51.56,
      "duration_seconds": 1.29,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.19,
      "end_seconds": 56.19,
      "duration_seconds": 4.0,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.62,
      "end_seconds": 61.2,
      "duration_seconds": 3.58,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.48,
      "end_seconds": 65.85,
      "duration_seconds": 3.37,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.3,
      "end_seconds": 71.67,
      "duration_seconds": 1.37,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.77,
      "end_seconds": 77.47,
      "duration_seconds": 3.7,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.43,
      "end_seconds": 82.75,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.51,
      "end_seconds": 87.52,
      "duration_seconds": 3.01,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.55,
      "end_seconds": 106.3,
      "duration_seconds": 3.75,
      "text": "So, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.69,
      "end_seconds": 111.76,
      "duration_seconds": 2.07,
      "text": "I have low haemoglobin."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.01,
      "end_seconds": 116.6,
      "duration_seconds": 3.59,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.79,
      "end_seconds": 120.07,
      "duration_seconds": 2.28,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.56,
      "end_seconds": 140.84,
      "duration_seconds": 3.28,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.98,
      "end_seconds": 156.68,
      "duration_seconds": 14.7,
      "text": "It's iron tablets, once a day for my blood count. I'm supposed to take it regularly, but I don't always manage. Well, I take Anovate cream, twice a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.85,
      "end_seconds": 165.84,
      "duration_seconds": 3.99,
      "text": "Have you had any weight loss or abdominal pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.49,
      "end_seconds": 169.87,
      "duration_seconds": 3.38,
      "text": "Um, no, not a single one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.63,
      "end_seconds": 179.5,
      "duration_seconds": 7.87,
      "text": "Have you noticed fever, family history of bowel cancer, black stools or change in bowel habit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.61,
      "end_seconds": 184.53,
      "duration_seconds": 3.92,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.0,
      "end_seconds": 187.97,
      "duration_seconds": 1.97,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.05,
      "end_seconds": 191.31,
      "duration_seconds": 2.26,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 192.09,
      "end_seconds": 199.82,
      "duration_seconds": 7.73,
      "text": "Doctor, I've got the readings for you. Respiratory rate 18, temperature 36.9. Pulse 74, blood pressure 127 over 78."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.74,
      "end_seconds": 201.74,
      "duration_seconds": 1.0,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.29,
      "end_seconds": 209.26,
      "duration_seconds": 4.97,
      "text": "So, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.94,
      "end_seconds": 213.38,
      "duration_seconds": 2.44,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.86,
      "end_seconds": 226.92,
      "duration_seconds": 2.06,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.64,
      "end_seconds": 230.77,
      "duration_seconds": 2.13,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.96,
      "end_seconds": 253.75,
      "duration_seconds": 5.79,
      "text": "There's a small external pile at the edge, and I don't see any fissure."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.43,
      "end_seconds": 273.87,
      "duration_seconds": 16.44,
      "text": "You can sit up now. Putting it all together, I'm honestly not certain yet. It could be haemorrhoids, or it might be an anal fissure. Something higher up in the bowel that we shouldn't miss is still possible."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.83,
      "end_seconds": 278.51,
      "duration_seconds": 3.68,
      "text": "Hmm, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.43,
      "end_seconds": 297.37,
      "duration_seconds": 16.94,
      "text": "I can't promise yet, but most people with haemorrhoids do well once it's treated properly. A colonoscopy is what I'd like next, for rectal bleeding. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 299.2,
      "end_seconds": 301.48,
      "duration_seconds": 2.28,
      "text": "The earliest is Friday, 2 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.47,
      "end_seconds": 307.87,
      "duration_seconds": 4.4,
      "text": "I'll request blood tests, it'll help with rectal bleeding."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.17,
      "end_seconds": 314.35,
      "duration_seconds": 3.18,
      "text": "Right, do I need to prepare?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.58,
      "end_seconds": 322.65,
      "duration_seconds": 7.07,
      "text": "I'd like you to take a soothing cream, twice a day, for one week. That's for haemorrhoids."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.51,
      "end_seconds": 327.9,
      "duration_seconds": 3.39,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.8,
      "end_seconds": 354.79,
      "duration_seconds": 25.99,
      "text": "We'll begin with lactulose, 15 ml, at night, for two weeks. That should help with constipation. Soak in a warm bath for ten minutes after you pass stool, and don't strain. Cut down on salt and fried food for now, it really does make a difference. Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.8,
      "end_seconds": 362.83,
      "duration_seconds": 7.03,
      "text": "So, I take the lactulose, 15 ml, at night. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.27,
      "end_seconds": 368.69,
      "duration_seconds": 4.42,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.39,
      "end_seconds": 372.47,
      "duration_seconds": 3.08,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.24,
      "end_seconds": 374.55,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}