{
  "schema_version": "1.0",
  "encounter_id": "01038",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 4.9,
      "duration_seconds": 3.57,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.78,
      "end_seconds": 11.02,
      "duration_seconds": 5.24,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.56,
      "end_seconds": 16.74,
      "duration_seconds": 4.18,
      "text": "Well, thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.6,
      "end_seconds": 21.89,
      "duration_seconds": 3.29,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.53,
      "end_seconds": 29.68,
      "duration_seconds": 6.15,
      "text": "Honestly, it's blurred vision beforehand, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.21,
      "end_seconds": 33.83,
      "duration_seconds": 3.62,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.06,
      "end_seconds": 39.4,
      "duration_seconds": 4.34,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.8,
      "end_seconds": 43.43,
      "duration_seconds": 3.63,
      "text": "Ah. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.07,
      "end_seconds": 48.25,
      "duration_seconds": 4.18,
      "text": "I'd give it a six, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.42,
      "end_seconds": 51.75,
      "duration_seconds": 2.33,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.56,
      "end_seconds": 77.37,
      "duration_seconds": 23.81,
      "text": "Actually, when it starts I tend to get a bump on my head after as well. And I've been feeling hot and sweaty before it as well. The bump on my head after? That's been for one week. I've also been passing out once last week, for one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.23,
      "end_seconds": 80.24,
      "duration_seconds": 2.01,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.08,
      "end_seconds": 87.76,
      "duration_seconds": 3.68,
      "text": "It happens a few times a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.87,
      "end_seconds": 95.92,
      "duration_seconds": 7.05,
      "text": "Have you noticed tongue biting, chest pain, loss of bladder control or shaking or jerking?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.49,
      "end_seconds": 105.87,
      "duration_seconds": 8.38,
      "text": "I haven't had tongue biting, chest pain, loss of bladder control or shaking or jerking, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.68,
      "end_seconds": 110.52,
      "duration_seconds": 2.84,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.72,
      "end_seconds": 113.98,
      "duration_seconds": 2.26,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.82,
      "end_seconds": 117.19,
      "duration_seconds": 1.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.82,
      "end_seconds": 121.41,
      "duration_seconds": 3.59,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.21,
      "end_seconds": 124.73,
      "duration_seconds": 2.52,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.24,
      "end_seconds": 130.29,
      "duration_seconds": 4.05,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.2,
      "end_seconds": 133.49,
      "duration_seconds": 2.29,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.64,
      "end_seconds": 139.8,
      "duration_seconds": 5.16,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.72,
      "end_seconds": 142.46,
      "duration_seconds": 1.74,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.25,
      "end_seconds": 148.06,
      "duration_seconds": 4.81,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.72,
      "end_seconds": 165.12,
      "duration_seconds": 4.4,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.54,
      "end_seconds": 169.94,
      "duration_seconds": 3.4,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.3,
      "end_seconds": 181.05,
      "duration_seconds": 2.75,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.8,
      "end_seconds": 192.04,
      "duration_seconds": 9.24,
      "text": "I've had high blood pressure, yes. I've had thin bones for about ten years now. I have diabetes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.55,
      "end_seconds": 193.25,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.7,
      "end_seconds": 198.03,
      "duration_seconds": 3.33,
      "text": "I've got arthritis in my knees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.04,
      "end_seconds": 208.21,
      "duration_seconds": 8.17,
      "text": "Alright, high blood pressure and thin bones, that matches what I have here. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.16,
      "end_seconds": 215.41,
      "duration_seconds": 5.25,
      "text": "Alendronate, 70 milligrams, once a week for my bones."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 217.14,
      "end_seconds": 226.88,
      "duration_seconds": 9.74,
      "text": "Doctor, I think the last prescription for the alendronate was 35 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.78,
      "end_seconds": 232.87,
      "duration_seconds": 5.09,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.67,
      "end_seconds": 243.39,
      "duration_seconds": 8.72,
      "text": "No, I left it at home. Sitagliptin. I take it 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.95,
      "end_seconds": 251.31,
      "duration_seconds": 7.36,
      "text": "Has anything ever caused you a reaction? I mean any allergies. I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.2,
      "end_seconds": 254.31,
      "duration_seconds": 2.11,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 256.39,
      "end_seconds": 262.25,
      "duration_seconds": 5.86,
      "text": "I'm not sure that's right. I seem to recall a problem with tramadol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.35,
      "end_seconds": 266.26,
      "duration_seconds": 2.91,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.3,
      "end_seconds": 271.75,
      "duration_seconds": 3.45,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.67,
      "end_seconds": 277.84,
      "duration_seconds": 4.17,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.76,
      "end_seconds": 282.12,
      "duration_seconds": 2.36,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.69,
      "end_seconds": 306.42,
      "duration_seconds": 6.73,
      "text": "Your pulse is regular and there's a small bruise on the right side of the head."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.17,
      "end_seconds": 310.22,
      "duration_seconds": 2.05,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.68,
      "end_seconds": 321.27,
      "duration_seconds": 1.59,
      "text": "No murmurs on listening."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.51,
      "end_seconds": 327.21,
      "duration_seconds": 2.7,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.49,
      "end_seconds": 355.8,
      "duration_seconds": 18.31,
      "text": "Right, here's what I'm thinking. It fits best with a simple faint, probably reflex-related. We shouldn't forget a heart rhythm problem. Just to be sure I understood. You've had blurred vision beforehand for about two weeks, and no tongue biting or chest pain."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.87,
      "end_seconds": 358.38,
      "duration_seconds": 1.51,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.76,
      "end_seconds": 362.83,
      "duration_seconds": 3.07,
      "text": "Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.69,
      "end_seconds": 370.96,
      "duration_seconds": 6.27,
      "text": "I did have an echocardiogram done last month, but the paper's at home."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.99,
      "end_seconds": 377.76,
      "duration_seconds": 5.77,
      "text": "Let's get blood tests, for syncope. Let's book an ECG to look into syncope."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.12,
      "end_seconds": 380.75,
      "duration_seconds": 1.63,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.7,
      "end_seconds": 397.55,
      "duration_seconds": 15.85,
      "text": "Drink enough water and avoid standing still for long stretches, and sit if you feel it coming. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.68,
      "end_seconds": 400.77,
      "duration_seconds": 2.09,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.8,
      "end_seconds": 418.62,
      "duration_seconds": 15.82,
      "text": "Do get help quickly if you pass out again, especially with chest pain or palpitations. I'd like you back after the results are back. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.77,
      "end_seconds": 422.28,
      "duration_seconds": 2.51,
      "text": "Alright, thanks, take care."
    }
  ]
}