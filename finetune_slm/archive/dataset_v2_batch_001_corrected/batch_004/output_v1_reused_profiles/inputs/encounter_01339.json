{
  "schema_version": "1.0",
  "encounter_id": "01339",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.0,
      "end_seconds": 3.2,
      "duration_seconds": 2.2,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.98,
      "end_seconds": 6.67,
      "duration_seconds": 2.69,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.48,
      "end_seconds": 10.22,
      "duration_seconds": 1.74,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.98,
      "end_seconds": 15.87,
      "duration_seconds": 4.89,
      "text": "Uh, I've been dealing with very heavy periods."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.88,
      "end_seconds": 18.59,
      "duration_seconds": 1.71,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.59,
      "end_seconds": 22.97,
      "duration_seconds": 2.38,
      "text": "It's been four weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.42,
      "end_seconds": 24.12,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.7,
      "end_seconds": 30.34,
      "duration_seconds": 5.64,
      "text": "I've been passing clots too, you know, for about four days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.59,
      "end_seconds": 33.19,
      "duration_seconds": 1.6,
      "text": "Any tiredness as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.49,
      "end_seconds": 35.65,
      "duration_seconds": 1.16,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.67,
      "end_seconds": 54.39,
      "duration_seconds": 4.72,
      "text": "A few quick ones: weight loss or pain during sex?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.27,
      "end_seconds": 57.58,
      "duration_seconds": 2.31,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.13,
      "end_seconds": 64.62,
      "duration_seconds": 3.49,
      "text": "A few quick ones: fever or vaginal discharge?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.64,
      "end_seconds": 70.84,
      "duration_seconds": 4.2,
      "text": "No fever or vaginal discharge, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.99,
      "end_seconds": 74.93,
      "duration_seconds": 2.94,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.5,
      "end_seconds": 78.68,
      "duration_seconds": 2.18,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.67,
      "end_seconds": 93.16,
      "duration_seconds": 4.49,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.14,
      "end_seconds": 97.8,
      "duration_seconds": 3.66,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.79,
      "end_seconds": 105.69,
      "duration_seconds": 3.9,
      "text": "So, do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.23,
      "end_seconds": 112.44,
      "duration_seconds": 5.21,
      "text": "Um, you know, it's Thyronorm, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.8,
      "end_seconds": 115.87,
      "duration_seconds": 2.07,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.66,
      "end_seconds": 133.23,
      "duration_seconds": 16.57,
      "text": "50 micrograms, I think that's what's on the box. Oh, I'm on mefenamic acid, 500 milligrams, when the pain is bad. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.3,
      "end_seconds": 139.81,
      "duration_seconds": 4.51,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.62,
      "end_seconds": 155.67,
      "duration_seconds": 15.05,
      "text": "I'll have a glass of wine with dinner. I drink a lot of tea and snack through the day. I live with my elderly mother. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.91,
      "end_seconds": 161.01,
      "duration_seconds": 4.1,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.02,
      "end_seconds": 165.82,
      "duration_seconds": 2.8,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.41,
      "end_seconds": 169.48,
      "duration_seconds": 3.07,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.18,
      "end_seconds": 172.87,
      "duration_seconds": 1.69,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.58,
      "end_seconds": 177.26,
      "duration_seconds": 2.68,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.93,
      "end_seconds": 182.64,
      "duration_seconds": 4.71,
      "text": "I've had an underactive thyroid for two years now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.2,
      "end_seconds": 189.07,
      "duration_seconds": 5.87,
      "text": "Right, right. Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.18,
      "end_seconds": 197.14,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.24,
      "end_seconds": 213.46,
      "duration_seconds": 5.22,
      "text": "Okay: temperature 37.0, blood pressure 114 over 77, pulse 71."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.05,
      "end_seconds": 216.0,
      "duration_seconds": 1.95,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.67,
      "end_seconds": 220.22,
      "duration_seconds": 3.55,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.95,
      "end_seconds": 226.46,
      "duration_seconds": 4.51,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.39,
      "end_seconds": 230.38,
      "duration_seconds": 1.99,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.54,
      "end_seconds": 253.84,
      "duration_seconds": 7.3,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.07,
      "end_seconds": 256.95,
      "duration_seconds": 1.88,
      "text": "So, nearly finished here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.82,
      "end_seconds": 274.03,
      "duration_seconds": 2.21,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.68,
      "end_seconds": 282.35,
      "duration_seconds": 2.67,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.28,
      "end_seconds": 313.72,
      "duration_seconds": 21.44,
      "text": "I'm sending you for a pelvic ultrasound because of heavy periods. The treatment will be ferrous sulfate, 200 milligrams, once a day, for three months. That's for possible iron deficiency. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.72,
      "end_seconds": 317.68,
      "duration_seconds": 2.96,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.72,
      "end_seconds": 343.98,
      "duration_seconds": 25.26,
      "text": "I'm going to put you on tranexamic acid, 500 milligrams, three times a day during periods, for three cycles. It's for heavy bleeding. The pharmacy will go through the details again when you pick it up. Keep a note of how many pads you use each day and the dates, it helps us a lot."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.56,
      "end_seconds": 347.64,
      "duration_seconds": 3.08,
      "text": "Yes. We'll catch up in four weeks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.5,
      "end_seconds": 349.2,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 352.63,
      "end_seconds": 357.06,
      "duration_seconds": 4.43,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 358.53,
      "end_seconds": 360.31,
      "duration_seconds": 1.78,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 361.34,
      "end_seconds": 362.8,
      "duration_seconds": 1.46,
      "text": "All the best."
    }
  ]
}