{
  "schema_version": "1.0",
  "encounter_id": "01284",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 6.42,
      "duration_seconds": 5.66,
      "text": "Hmm, hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.4,
      "end_seconds": 13.37,
      "duration_seconds": 4.97,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.63,
      "end_seconds": 23.7,
      "duration_seconds": 9.07,
      "text": "It's a feeling that I can't take a deep breath. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.57,
      "end_seconds": 28.25,
      "duration_seconds": 3.68,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.34,
      "end_seconds": 32.17,
      "duration_seconds": 2.83,
      "text": "Probably about three months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.88,
      "end_seconds": 35.69,
      "duration_seconds": 2.81,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.49,
      "end_seconds": 42.09,
      "duration_seconds": 1.6,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.77,
      "end_seconds": 45.23,
      "duration_seconds": 2.46,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.5,
      "end_seconds": 65.78,
      "duration_seconds": 19.28,
      "text": "When it starts I tend to get a dry cough as well. I've been getting breathless walking short distances too, for about a month. About getting breathless walking short distances, a six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.78,
      "end_seconds": 70.86,
      "duration_seconds": 3.08,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.33,
      "end_seconds": 75.38,
      "duration_seconds": 3.05,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.46,
      "end_seconds": 85.38,
      "duration_seconds": 8.92,
      "text": "Have you had a feeling that you can't take a deep breath before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.9,
      "end_seconds": 91.81,
      "duration_seconds": 5.91,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.54,
      "end_seconds": 95.98,
      "duration_seconds": 2.44,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.54,
      "end_seconds": 110.49,
      "duration_seconds": 1.95,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.92,
      "end_seconds": 134.36,
      "duration_seconds": 9.44,
      "text": "Okay: respiratory rate 21, blood pressure 138 over 78. And oxygen saturation is 92 percent, pulse is 97 beats a minute."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.62,
      "end_seconds": 138.56,
      "duration_seconds": 2.94,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.12,
      "end_seconds": 141.14,
      "duration_seconds": 1.02,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.14,
      "end_seconds": 143.7,
      "duration_seconds": 1.56,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.43,
      "end_seconds": 164.46,
      "duration_seconds": 2.03,
      "text": "No clubbing in the fingers."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.25,
      "end_seconds": 167.68,
      "duration_seconds": 2.43,
      "text": "Yeah, uh, no problem."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.83,
      "end_seconds": 171.86,
      "duration_seconds": 3.03,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.42,
      "end_seconds": 191.61,
      "duration_seconds": 4.19,
      "text": "There are fine crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.7,
      "end_seconds": 195.39,
      "duration_seconds": 1.69,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.06,
      "end_seconds": 209.42,
      "duration_seconds": 4.36,
      "text": "Okay, and what about coughing up blood or chest pain?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.09,
      "end_seconds": 212.91,
      "duration_seconds": 2.82,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.88,
      "end_seconds": 219.35,
      "duration_seconds": 5.47,
      "text": "Have you noticed weight loss, fever, night sweats or leg swelling?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.1,
      "end_seconds": 227.02,
      "duration_seconds": 5.92,
      "text": "No, no weight loss, fever, night sweats or leg swelling."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.94,
      "end_seconds": 232.17,
      "duration_seconds": 3.23,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.05,
      "end_seconds": 235.99,
      "duration_seconds": 1.94,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.59,
      "end_seconds": 239.29,
      "duration_seconds": 2.7,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.26,
      "end_seconds": 244.61,
      "duration_seconds": 3.35,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.71,
      "end_seconds": 249.03,
      "duration_seconds": 3.32,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.01,
      "end_seconds": 253.63,
      "duration_seconds": 3.62,
      "text": "Tiotropium inhaler. I take it once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.18,
      "end_seconds": 266.4,
      "duration_seconds": 1.22,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.12,
      "end_seconds": 270.86,
      "duration_seconds": 2.74,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.54,
      "end_seconds": 275.73,
      "duration_seconds": 4.19,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.27,
      "end_seconds": 280.66,
      "duration_seconds": 3.39,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.1,
      "end_seconds": 283.86,
      "duration_seconds": 1.76,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.6,
      "end_seconds": 288.15,
      "duration_seconds": 3.55,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.26,
      "end_seconds": 292.23,
      "duration_seconds": 2.97,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.75,
      "end_seconds": 302.66,
      "duration_seconds": 4.91,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.72,
      "end_seconds": 307.45,
      "duration_seconds": 2.73,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.23,
      "end_seconds": 316.27,
      "duration_seconds": 7.04,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.67,
      "end_seconds": 335.04,
      "duration_seconds": 2.37,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.7,
      "end_seconds": 340.98,
      "duration_seconds": 4.28,
      "text": "Right, I've had COPD for about ten years now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.94,
      "end_seconds": 345.33,
      "duration_seconds": 3.39,
      "text": "Mm, okay. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.2,
      "end_seconds": 350.03,
      "duration_seconds": 2.83,
      "text": "Yes, grass pollen. I get sneezing."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 350.99,
      "end_seconds": 361.99,
      "duration_seconds": 11.0,
      "text": "Okay, thinking it through, I'd lean towards chronic breathlessness that needs a proper work-up. Another possibility is heart-related breathlessness. Let's get breathing tests, for chronic breathlessness."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.06,
      "end_seconds": 366.63,
      "duration_seconds": 2.57,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.19,
      "end_seconds": 375.11,
      "duration_seconds": 6.92,
      "text": "Let's get a CT scan of the chest, for chronic breathlessness. Let's get an echocardiogram, for breathlessness."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.67,
      "end_seconds": 378.87,
      "duration_seconds": 3.2,
      "text": "Okay, you know, I'll do it."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.47,
      "end_seconds": 383.43,
      "duration_seconds": 3.96,
      "text": "Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.06,
      "end_seconds": 397.36,
      "duration_seconds": 9.3,
      "text": "I had a chest X-ray done at another clinic last month. I don't have the report with me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.92,
      "end_seconds": 414.3,
      "duration_seconds": 11.38,
      "text": "Try a daily walk and note how far you get before you need to stop. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.57,
      "end_seconds": 416.49,
      "duration_seconds": 0.92,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.5,
      "end_seconds": 425.35,
      "duration_seconds": 6.85,
      "text": "We'll catch up in four weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 426.85,
      "end_seconds": 430.0,
      "duration_seconds": 3.15,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 431.11,
      "end_seconds": 432.31,
      "duration_seconds": 1.2,
      "text": "See you soon."
    }
  ]
}