{
  "schema_version": "1.0",
  "encounter_id": "01477",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 6.83,
      "duration_seconds": 5.59,
      "text": "I mean, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.44,
      "end_seconds": 12.76,
      "duration_seconds": 4.32,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.31,
      "end_seconds": 19.73,
      "duration_seconds": 5.42,
      "text": "Good morning, you know, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.7,
      "end_seconds": 25.83,
      "duration_seconds": 4.13,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 31.68,
      "end_seconds": 35.9,
      "duration_seconds": 4.22,
      "text": "We came because of terrible itching at night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.23,
      "end_seconds": 39.8,
      "duration_seconds": 2.57,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.02,
      "end_seconds": 53.21,
      "duration_seconds": 2.19,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.14,
      "end_seconds": 75.7,
      "duration_seconds": 5.56,
      "text": "Okay: oxygen saturation is 98 percent, pulse 84, blood pressure 112 over 68."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.45,
      "end_seconds": 80.02,
      "duration_seconds": 3.57,
      "text": "Um, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.59,
      "end_seconds": 91.78,
      "duration_seconds": 11.19,
      "text": "I'll explain what these mean in a moment. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.61,
      "end_seconds": 101.84,
      "duration_seconds": 9.23,
      "text": "Sorry, what was I saying, I'd say severe. It's worse with being warm in bed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.42,
      "end_seconds": 106.54,
      "duration_seconds": 3.12,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.56,
      "end_seconds": 116.46,
      "duration_seconds": 7.9,
      "text": "Trouble sleeping because of it goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.47,
      "end_seconds": 123.5,
      "duration_seconds": 5.03,
      "text": "Has there been scratch marks on the wrists and waist too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.84,
      "end_seconds": 130.23,
      "duration_seconds": 5.39,
      "text": "Yeah, you know, I've had that since this morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.86,
      "end_seconds": 140.84,
      "duration_seconds": 4.98,
      "text": "What about tiny spots between your fingers, have you noticed that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.78,
      "end_seconds": 157.82,
      "duration_seconds": 16.04,
      "text": "Yeah. Three days, I'd say. Hmm, uh, the trouble sleeping because of it? That's been for one week. So, you know, with trouble sleeping because of it, I'd say severe."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.54,
      "end_seconds": 165.35,
      "duration_seconds": 5.81,
      "text": "Have you had terrible itching at night before, or is this the first time?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.41,
      "end_seconds": 176.86,
      "duration_seconds": 10.45,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.72,
      "end_seconds": 178.61,
      "duration_seconds": 0.89,
      "text": "Any pus?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.41,
      "end_seconds": 181.04,
      "duration_seconds": 1.63,
      "text": "No pus, thankfully."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.85,
      "end_seconds": 188.93,
      "duration_seconds": 7.08,
      "text": "Alright, did you get rash on the face, new soaps, fever or joint pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.03,
      "end_seconds": 200.45,
      "duration_seconds": 9.42,
      "text": "Hmm, no rash on the face, new soaps, fever or joint pain, none of it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.82,
      "end_seconds": 205.31,
      "duration_seconds": 3.49,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.49,
      "end_seconds": 210.1,
      "duration_seconds": 3.61,
      "text": "Oh, um, I move fine otherwise."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.42,
      "end_seconds": 219.2,
      "duration_seconds": 3.78,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.97,
      "end_seconds": 222.17,
      "duration_seconds": 2.2,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.99,
      "end_seconds": 240.9,
      "duration_seconds": 2.91,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.72,
      "end_seconds": 245.48,
      "duration_seconds": 2.76,
      "text": "Eczema, for nearly five years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.99,
      "end_seconds": 247.46,
      "duration_seconds": 1.47,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.09,
      "end_seconds": 252.42,
      "duration_seconds": 4.33,
      "text": "An enlarged prostate, for nearly five years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.18,
      "end_seconds": 254.63,
      "duration_seconds": 1.45,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.17,
      "end_seconds": 265.74,
      "duration_seconds": 10.57,
      "text": "Yes, eczema and an enlarged prostate are known to us, good to have that clear. Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 267.03,
      "end_seconds": 270.75,
      "duration_seconds": 3.72,
      "text": "It's hydrocortisone cream, when needed, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.62,
      "end_seconds": 278.36,
      "duration_seconds": 2.74,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.41,
      "end_seconds": 283.15,
      "duration_seconds": 3.74,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.56,
      "end_seconds": 287.75,
      "duration_seconds": 3.19,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.3,
      "end_seconds": 292.24,
      "duration_seconds": 2.94,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.37,
      "end_seconds": 294.72,
      "duration_seconds": 1.35,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.18,
      "end_seconds": 299.94,
      "duration_seconds": 3.76,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.24,
      "end_seconds": 318.41,
      "duration_seconds": 4.17,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.27,
      "end_seconds": 326.37,
      "duration_seconds": 7.1,
      "text": "My grandfather had a stroke. Hmm, uh, my sister had breast cancer."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.15,
      "end_seconds": 346.17,
      "duration_seconds": 4.02,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.19,
      "end_seconds": 351.35,
      "duration_seconds": 3.16,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 352.24,
      "end_seconds": 360.67,
      "duration_seconds": 8.43,
      "text": "Actually, I remember he had some kind of reaction to amoxicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.65,
      "end_seconds": 366.73,
      "duration_seconds": 4.08,
      "text": "Ah, um, I don't remember that."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.36,
      "end_seconds": 370.48,
      "duration_seconds": 3.12,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.91,
      "end_seconds": 374.58,
      "duration_seconds": 2.67,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.69,
      "end_seconds": 377.17,
      "duration_seconds": 1.48,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.77,
      "end_seconds": 393.95,
      "duration_seconds": 5.18,
      "text": "Tiny linear burrows between the fingers and scratched papules on the wrists."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.7,
      "end_seconds": 417.41,
      "duration_seconds": 17.71,
      "text": "Alright, you can sit up now. Let me tell you where I've got to. It fits best with scabies. I want to be honest that this is an impression, not a final answer. An insect-bite reaction is still possible."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.95,
      "end_seconds": 420.05,
      "duration_seconds": 2.1,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.88,
      "end_seconds": 441.35,
      "duration_seconds": 15.47,
      "text": "I understand the worry. At the moment I'd say it's scabies, and we'll watch how it goes. So, to recap quickly. You've had terrible itching at night, severe, and no fever or rash on the face."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.92,
      "end_seconds": 443.62,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 444.72,
      "end_seconds": 456.22,
      "duration_seconds": 11.5,
      "text": "Everyone in the house should be treated at the same time, and bedding washed hot. So, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 457.43,
      "end_seconds": 461.7,
      "duration_seconds": 4.27,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 463.71,
      "end_seconds": 464.97,
      "duration_seconds": 1.26,
      "text": "Take care now."
    }
  ]
}