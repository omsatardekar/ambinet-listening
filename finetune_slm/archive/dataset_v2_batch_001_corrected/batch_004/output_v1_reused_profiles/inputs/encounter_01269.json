{
  "schema_version": "1.0",
  "encounter_id": "01269",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.95,
      "end_seconds": 8.37,
      "duration_seconds": 7.42,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.77,
      "end_seconds": 14.38,
      "duration_seconds": 4.61,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.07,
      "end_seconds": 19.81,
      "duration_seconds": 4.74,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.45,
      "end_seconds": 24.98,
      "duration_seconds": 4.53,
      "text": "Of course, please stay. It's helpful to have you here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.88,
      "end_seconds": 33.12,
      "duration_seconds": 7.24,
      "text": "It's been feeling shaky and sweaty, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.52,
      "end_seconds": 36.87,
      "duration_seconds": 2.35,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 38.16,
      "end_seconds": 41.32,
      "duration_seconds": 3.16,
      "text": "Sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 43.25,
      "end_seconds": 47.86,
      "duration_seconds": 4.61,
      "text": "Doctor, our chart from the last visit lists it as 200 milligrams."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.92,
      "end_seconds": 55.38,
      "duration_seconds": 5.46,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.13,
      "end_seconds": 66.67,
      "duration_seconds": 9.54,
      "text": "I don't think I have it with me. I take telmisartan, 40 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.22,
      "end_seconds": 72.33,
      "duration_seconds": 4.11,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 74.05,
      "end_seconds": 78.02,
      "duration_seconds": 3.97,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 79.08,
      "end_seconds": 87.49,
      "duration_seconds": 8.41,
      "text": "Actually, it's a... um, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.27,
      "end_seconds": 91.15,
      "duration_seconds": 2.88,
      "text": "Alright, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.23,
      "end_seconds": 102.99,
      "duration_seconds": 9.76,
      "text": "For the prostate, I believe. My wife sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.79,
      "end_seconds": 107.7,
      "duration_seconds": 3.91,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.2,
      "end_seconds": 117.02,
      "duration_seconds": 2.82,
      "text": "I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.63,
      "end_seconds": 120.64,
      "duration_seconds": 3.01,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 121.42,
      "end_seconds": 125.16,
      "duration_seconds": 3.74,
      "text": "I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.81,
      "end_seconds": 128.8,
      "duration_seconds": 1.99,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 133.37,
      "end_seconds": 139.61,
      "duration_seconds": 6.24,
      "text": "When it starts I tend to get a pounding heart as well."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 140.11,
      "end_seconds": 146.79,
      "duration_seconds": 6.68,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 146.89,
      "end_seconds": 153.08,
      "duration_seconds": 6.19,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.33,
      "end_seconds": 158.43,
      "duration_seconds": 4.1,
      "text": "Later, thanks. Please go on. How frequently does it come?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 159.4,
      "end_seconds": 167.75,
      "duration_seconds": 8.35,
      "text": "Honestly, on and off. And headaches, too. There was sudden hunger, yes, but that went away."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.31,
      "end_seconds": 173.96,
      "duration_seconds": 5.65,
      "text": "Have you been feeling shaky and sweaty at any time before this?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 175.67,
      "end_seconds": 183.32,
      "duration_seconds": 7.65,
      "text": "Yes, something like this happened last year, and it went away on its own."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.71,
      "end_seconds": 189.09,
      "duration_seconds": 4.38,
      "text": "And what about chest pain, fainting or blurred vision?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.86,
      "end_seconds": 191.87,
      "duration_seconds": 2.01,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.77,
      "end_seconds": 195.57,
      "duration_seconds": 2.8,
      "text": "And what about slurred speech or seizure?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 198.92,
      "end_seconds": 203.4,
      "duration_seconds": 4.48,
      "text": "I haven't had slurred speech or seizure, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.8,
      "end_seconds": 206.94,
      "duration_seconds": 2.14,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 208.61,
      "end_seconds": 210.19,
      "duration_seconds": 1.58,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.66,
      "end_seconds": 216.17,
      "duration_seconds": 4.51,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 218.21,
      "end_seconds": 221.17,
      "duration_seconds": 2.96,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.08,
      "end_seconds": 240.87,
      "duration_seconds": 2.79,
      "text": "Right, tell me about your eating."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 242.55,
      "end_seconds": 247.58,
      "duration_seconds": 5.03,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.1,
      "end_seconds": 251.51,
      "duration_seconds": 3.41,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.23,
      "end_seconds": 257.17,
      "duration_seconds": 3.94,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.03,
      "end_seconds": 262.52,
      "duration_seconds": 4.49,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 264.16,
      "end_seconds": 266.42,
      "duration_seconds": 2.26,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.2,
      "end_seconds": 284.09,
      "duration_seconds": 4.89,
      "text": "Okay, tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 285.98,
      "end_seconds": 292.18,
      "duration_seconds": 6.2,
      "text": "Yes, diabetes. Kidney disease, for five years. I have high blood pressure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.2,
      "end_seconds": 294.44,
      "duration_seconds": 1.24,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 295.65,
      "end_seconds": 297.58,
      "duration_seconds": 1.93,
      "text": "Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.06,
      "end_seconds": 308.38,
      "duration_seconds": 9.32,
      "text": "I follow. Yes, diabetes and kidney disease are known to us, good to have that clear. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 310.42,
      "end_seconds": 315.95,
      "duration_seconds": 5.53,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 316.57,
      "end_seconds": 327.88,
      "duration_seconds": 11.31,
      "text": "Doctor, I've got the readings for you. Pulse 85, weight 98 kilos, height 167 centimetres, oxygen saturation is 99 percent, BP is 116 over 71, temperature 36.5."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.21,
      "end_seconds": 330.17,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.59,
      "end_seconds": 336.12,
      "duration_seconds": 3.53,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.86,
      "end_seconds": 340.21,
      "duration_seconds": 2.35,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.43,
      "end_seconds": 357.23,
      "duration_seconds": 4.8,
      "text": "Your fingerprick sugar now is normal and your heart rate is steady."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.48,
      "end_seconds": 392.16,
      "duration_seconds": 32.68,
      "text": "Right, that's the examination finished. Let me tell you where I've got to. I think we're dealing with episodes of low blood sugar related to diabetes treatment at this stage. It could also be an abnormal heart rhythm, so we'll keep that open. I'd also keep an anxiety attack in mind. Let me repeat that back to make sure. You've been feeling shaky and sweaty, since last Tuesday, and no fainting or seizure."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 393.44,
      "end_seconds": 394.14,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.38,
      "end_seconds": 399.41,
      "duration_seconds": 4.03,
      "text": "I'll request an HbA1c, it'll help with diabetes control."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 401.11,
      "end_seconds": 403.16,
      "duration_seconds": 2.05,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 404.97,
      "end_seconds": 409.1,
      "duration_seconds": 4.13,
      "text": "I'll request blood tests, it'll help with low sugar."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 410.48,
      "end_seconds": 412.61,
      "duration_seconds": 2.13,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.54,
      "end_seconds": 430.67,
      "duration_seconds": 16.13,
      "text": "Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 431.77,
      "end_seconds": 437.27,
      "duration_seconds": 5.5,
      "text": "Okay, makes sense. Should I have a home sugar diary as well?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.68,
      "end_seconds": 447.43,
      "duration_seconds": 8.75,
      "text": "Not at this point, no. It isn't indicated yet. Let's plan a check in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 449.32,
      "end_seconds": 452.62,
      "duration_seconds": 3.3,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 454.24,
      "end_seconds": 455.57,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}