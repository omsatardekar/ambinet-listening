{
  "schema_version": "1.0",
  "encounter_id": "01270",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.21,
      "end_seconds": 4.07,
      "duration_seconds": 2.86,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.77,
      "end_seconds": 8.94,
      "duration_seconds": 4.17,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.73,
      "end_seconds": 18.78,
      "duration_seconds": 5.05,
      "text": "I've been dealing with a tickle in the chest."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.28,
      "end_seconds": 22.26,
      "duration_seconds": 1.98,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.06,
      "end_seconds": 34.73,
      "duration_seconds": 10.67,
      "text": "It's been three days, I'm fairly sure. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.01,
      "end_seconds": 39.45,
      "duration_seconds": 4.44,
      "text": "I see, go ahead. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.31,
      "end_seconds": 49.49,
      "duration_seconds": 9.18,
      "text": "I'd give it a four, out of ten. I've also had a mild wheeze at times, for six months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.84,
      "end_seconds": 55.19,
      "duration_seconds": 5.35,
      "text": "I follow. Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.43,
      "end_seconds": 67.84,
      "duration_seconds": 2.41,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.92,
      "end_seconds": 94.73,
      "duration_seconds": 8.81,
      "text": "Okay: pulse 64, respiratory rate 16. And BP is 115 over 69, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.11,
      "end_seconds": 98.04,
      "duration_seconds": 1.93,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.88,
      "end_seconds": 102.22,
      "duration_seconds": 2.34,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.84,
      "end_seconds": 107.29,
      "duration_seconds": 2.45,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.82,
      "end_seconds": 110.27,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.27,
      "end_seconds": 124.62,
      "duration_seconds": 3.35,
      "text": "A faint wheeze when you breathe out forcefully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.31,
      "end_seconds": 129.31,
      "duration_seconds": 2.0,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.4,
      "end_seconds": 144.64,
      "duration_seconds": 5.24,
      "text": "Let me check a few things. Any fever, heartburn or weight loss?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.45,
      "end_seconds": 149.74,
      "duration_seconds": 3.29,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.55,
      "end_seconds": 156.8,
      "duration_seconds": 5.25,
      "text": "Let me check a few things. Any coughing up phlegm or chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.84,
      "end_seconds": 163.12,
      "duration_seconds": 5.28,
      "text": "No coughing up phlegm or chest pain, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.54,
      "end_seconds": 166.89,
      "duration_seconds": 2.35,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.85,
      "end_seconds": 170.45,
      "duration_seconds": 2.6,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.56,
      "end_seconds": 173.08,
      "duration_seconds": 1.52,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.28,
      "end_seconds": 176.48,
      "duration_seconds": 2.2,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.26,
      "end_seconds": 198.78,
      "duration_seconds": 3.52,
      "text": "So, a few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.81,
      "end_seconds": 215.14,
      "duration_seconds": 14.33,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. Not much, I mostly stay in these days. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.15,
      "end_seconds": 218.91,
      "duration_seconds": 2.76,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.58,
      "end_seconds": 224.24,
      "duration_seconds": 4.66,
      "text": "Okay, so I've had eczema for five years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.8,
      "end_seconds": 231.53,
      "duration_seconds": 3.73,
      "text": "Right, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.01,
      "end_seconds": 236.36,
      "duration_seconds": 3.35,
      "text": "Uh, no, nothing at the moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.2,
      "end_seconds": 241.72,
      "duration_seconds": 4.52,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.02,
      "end_seconds": 247.44,
      "duration_seconds": 4.42,
      "text": "Ah, I'm allergic to tramadol, I get vomiting."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.62,
      "end_seconds": 251.79,
      "duration_seconds": 3.17,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.3,
      "end_seconds": 255.71,
      "duration_seconds": 2.41,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.53,
      "end_seconds": 269.98,
      "duration_seconds": 1.45,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.83,
      "end_seconds": 274.86,
      "duration_seconds": 3.03,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.14,
      "end_seconds": 285.64,
      "duration_seconds": 5.5,
      "text": "Let me tell you where I've got to. This is probably cough-variant asthma."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.37,
      "end_seconds": 290.35,
      "duration_seconds": 2.98,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.0,
      "end_seconds": 304.03,
      "duration_seconds": 12.03,
      "text": "Nothing I've seen today points to an emergency. It looks like cough-variant asthma, but I'd like to confirm. I'll request breathing tests, it'll help with chronic cough."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 305.35,
      "end_seconds": 310.07,
      "duration_seconds": 4.72,
      "text": "We have a slot Tuesday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.44,
      "end_seconds": 334.04,
      "duration_seconds": 22.6,
      "text": "We'll begin with salbutamol inhaler, 100 micrograms, two puffs when needed, for two weeks. It's for cough and wheeze. Try the inhaler before exercise and note whether the cough settles. Please don't wait if the symptoms get worse. That's when to be seen urgently. Let's plan a check in four weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.47,
      "end_seconds": 337.28,
      "duration_seconds": 1.81,
      "text": "That's clear, thanks."
    }
  ]
}