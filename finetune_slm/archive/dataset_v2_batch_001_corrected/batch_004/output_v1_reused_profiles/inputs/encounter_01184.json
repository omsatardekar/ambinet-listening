  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 6.49,
      "duration_seconds": 5.79,
      "text": "Hi, uh, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.45,
      "end_seconds": 13.82,
      "duration_seconds": 5.37,
      "text": "Okay, yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.68,
      "end_seconds": 23.79,
      "duration_seconds": 5.11,
      "text": "good morning, doctor. I came along to to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.15,
      "end_seconds": 32.42,
      "duration_seconds": 7.27,
      "text": "So, mainly I've been putting on weight over the last year. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.03,
      "end_seconds": 38.95,
      "duration_seconds": 4.92,
      "text": "Tell me your medicines, please. Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 39.71,
      "end_seconds": 42.96,
      "duration_seconds": 3.25,
      "text": "She takes simvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.15,
      "end_seconds": 49.33,
      "duration_seconds": 3.18,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 51.24,
      "end_seconds": 52.58,
      "duration_seconds": 1.34,
      "text": "Six months now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.88,
      "end_seconds": 56.35,
      "duration_seconds": 3.47,
      "text": "ah so, did it come on recently?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.25,
      "end_seconds": 59.74,
      "duration_seconds": 2.49,
      "text": "It's been two months now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.14,
      "end_seconds": 60.84,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.84,
      "end_seconds": 75.16,
      "duration_seconds": 12.32,
      "text": "There's sore knees as well. And I've been feeling sleepy in the day as well. Yeah, as for feeling sleepy in the day, it's severe, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.26,
      "end_seconds": 94.39,
      "duration_seconds": 5.13,
      "text": "Alright, and what about heat intolerance, irregular periods or increased thirst?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.04,
      "end_seconds": 98.44,
      "duration_seconds": 2.4,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.04,
      "end_seconds": 103.08,
      "duration_seconds": 3.04,
      "text": "Okay, and chest pain, any of that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.83,
      "end_seconds": 106.83,
      "duration_seconds": 3.0,
      "text": "I haven't noticed any chest pain."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.66,
      "end_seconds": 110.69,
      "duration_seconds": 3.03,
      "text": "Okay, anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.07,
      "end_seconds": 113.79,
      "duration_seconds": 1.72,
      "text": "nothing there, no"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.51,
      "end_seconds": 117.23,
      "duration_seconds": 2.72,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.31,
      "end_seconds": 126.13,
      "duration_seconds": 6.82,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.29,
      "end_seconds": 141.5,
      "duration_seconds": 1.21,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.04,
      "end_seconds": 146.98,
      "duration_seconds": 3.94,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.72,
      "end_seconds": 150.68,
      "duration_seconds": 1.96,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.57,
      "end_seconds": 156.75,
      "duration_seconds": 4.18,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.31,
      "end_seconds": 160.08,
      "duration_seconds": 1.77,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.1,
      "end_seconds": 166.39,
      "duration_seconds": 4.29,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.72,
      "end_seconds": 169.84,
      "duration_seconds": 2.12,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.6,
      "end_seconds": 174.25,
      "duration_seconds": 2.65,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.11,
      "end_seconds": 178.32,
      "duration_seconds": 2.21,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.8,
      "end_seconds": 183.57,
      "duration_seconds": 3.77,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.66,
      "end_seconds": 189.01,
      "duration_seconds": 4.35,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.73,
      "end_seconds": 196.74,
      "duration_seconds": 2.01,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.26,
      "end_seconds": 201.38,
      "duration_seconds": 4.12,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.96,
      "end_seconds": 203.9,
      "duration_seconds": 1.94,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.61,
      "end_seconds": 211.14,
      "duration_seconds": 6.53,
      "text": "Alright, high cholesterol, that matches what I have here. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.31,
      "end_seconds": 224.29,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.6,
      "end_seconds": 246.98,
      "duration_seconds": 9.38,
      "text": "Okay: height 166 centimetres, BMI works out to 35.6. And weight 98 kilos, pressure 109 over 78, pulse 74."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.83,
      "end_seconds": 249.27,
      "duration_seconds": 1.44,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.5,
      "end_seconds": 253.32,
      "duration_seconds": 2.82,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.32,
      "end_seconds": 259.26,
      "duration_seconds": 3.94,
      "text": "okay, time for me to to examine you"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.93,
      "end_seconds": 263.26,
      "duration_seconds": 2.33,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.97,
      "end_seconds": 283.65,
      "duration_seconds": 3.68,
      "text": "your waist measures about a hundred and four centimetres"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.74,
      "end_seconds": 290.59,
      "duration_seconds": 1.85,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.56,
      "end_seconds": 324.0,
      "duration_seconds": 14.44,
      "text": "taking everything into account, the most likely explanation is weight gain with a metabolic cause that needs checking that's my thinking for now, and it may change as we learn more"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.05,
      "end_seconds": 329.4,
      "duration_seconds": 3.35,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.45,
      "end_seconds": 349.64,
      "duration_seconds": 18.19,
      "text": "Nothing I've seen today points to an emergency. It looks like weight gain with a metabolic cause that needs checking, but I'd like to confirm. Let's book a thyroid test to look into weight gain. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 350.37,
      "end_seconds": 352.03,
      "duration_seconds": 1.66,
      "text": "That's clear, thanks."
    }
  ]
}