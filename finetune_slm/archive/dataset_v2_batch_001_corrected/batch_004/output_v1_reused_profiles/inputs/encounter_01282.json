{
  "schema_version": "1.0",
  "encounter_id": "01282",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.18,
      "end_seconds": 4.29,
      "duration_seconds": 3.11,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.38,
      "duration_seconds": 3.89,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.64,
      "end_seconds": 19.26,
      "duration_seconds": 5.62,
      "text": "I wanted to get a cut on my finger looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.28,
      "end_seconds": 23.43,
      "duration_seconds": 2.15,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.17,
      "end_seconds": 26.83,
      "duration_seconds": 2.66,
      "text": "It's lamotrigine, twice a day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.68,
      "end_seconds": 31.49,
      "duration_seconds": 2.81,
      "text": "Okay, how much do you take?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.36,
      "end_seconds": 34.29,
      "duration_seconds": 0.93,
      "text": "100 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.81,
      "end_seconds": 36.49,
      "duration_seconds": 1.68,
      "text": "Alright, is that long-standing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.05,
      "end_seconds": 43.01,
      "duration_seconds": 1.96,
      "text": "For nearly five years."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.91,
      "end_seconds": 47.74,
      "duration_seconds": 2.83,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.0,
      "end_seconds": 56.91,
      "duration_seconds": 7.91,
      "text": "It's been two days now. I've had a numb fingertip too, for about a week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.03,
      "end_seconds": 69.3,
      "duration_seconds": 8.27,
      "text": "Let me check a few things. Any pus, weakness of the hand, dirt in the wound or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.78,
      "end_seconds": 73.22,
      "duration_seconds": 2.44,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.18,
      "end_seconds": 77.36,
      "duration_seconds": 2.18,
      "text": "Have you had any bite?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.37,
      "end_seconds": 80.08,
      "duration_seconds": 1.71,
      "text": "No, no bite."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.64,
      "end_seconds": 86.9,
      "duration_seconds": 5.26,
      "text": "So, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.79,
      "end_seconds": 91.74,
      "duration_seconds": 2.95,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.37,
      "end_seconds": 96.09,
      "duration_seconds": 2.72,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.88,
      "end_seconds": 99.42,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.77,
      "end_seconds": 116.52,
      "duration_seconds": 2.75,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.44,
      "end_seconds": 120.88,
      "duration_seconds": 2.44,
      "text": "Epilepsy, for about ten years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.05,
      "end_seconds": 122.75,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.0,
      "end_seconds": 138.59,
      "duration_seconds": 1.59,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.03,
      "end_seconds": 145.2,
      "duration_seconds": 5.17,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.7,
      "end_seconds": 148.71,
      "duration_seconds": 2.01,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.38,
      "end_seconds": 153.19,
      "duration_seconds": 3.81,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.47,
      "end_seconds": 156.51,
      "duration_seconds": 2.04,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.1,
      "end_seconds": 160.48,
      "duration_seconds": 2.38,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.86,
      "end_seconds": 165.92,
      "duration_seconds": 4.06,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.24,
      "end_seconds": 170.15,
      "duration_seconds": 2.91,
      "text": "Yes, naproxen. I get a rash."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.74,
      "end_seconds": 174.01,
      "duration_seconds": 3.27,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.78,
      "end_seconds": 190.2,
      "duration_seconds": 2.42,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.71,
      "end_seconds": 212.95,
      "duration_seconds": 13.24,
      "text": "Okay: blood pressure 116 over 71, oxygen saturation is 98 percent. And weight 63 kilos, temperature 36.5, height 170 centimetres, pulse is 84 beats a minute."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.6,
      "end_seconds": 216.06,
      "duration_seconds": 1.46,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.69,
      "end_seconds": 220.41,
      "duration_seconds": 2.72,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.59,
      "end_seconds": 224.67,
      "duration_seconds": 2.08,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.56,
      "end_seconds": 226.89,
      "duration_seconds": 1.33,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.53,
      "end_seconds": 253.45,
      "duration_seconds": 8.92,
      "text": "There is a two-centimetre clean cut over the first knuckle, the finger moves fully and the fingertip feels normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.97,
      "end_seconds": 275.77,
      "duration_seconds": 16.8,
      "text": "Thank you, you can get dressed. Okay, thinking it through, this is probably a clean finger laceration without nerve or tendon injury. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.12,
      "end_seconds": 302.6,
      "duration_seconds": 11.48,
      "text": "I'd like to arrange an X-ray of the finger for laceration. The treatment will be tetanus booster, 0.5 ml, once, for one day. It's for tetanus prevention."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.55,
      "end_seconds": 308.31,
      "duration_seconds": 3.76,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.83,
      "end_seconds": 319.63,
      "duration_seconds": 10.8,
      "text": "Keep the dressing dry for two days and watch for redness or pus. See me again in five days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.53,
      "end_seconds": 324.45,
      "duration_seconds": 2.92,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.05,
      "end_seconds": 326.39,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}