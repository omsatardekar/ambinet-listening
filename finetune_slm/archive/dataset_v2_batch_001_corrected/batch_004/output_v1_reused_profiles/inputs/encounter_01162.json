{
  "schema_version": "1.0",
  "encounter_id": "01162",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.16,
      "duration_seconds": 3.38,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.2,
      "end_seconds": 9.67,
      "duration_seconds": 4.47,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.26,
      "end_seconds": 21.02,
      "duration_seconds": 9.76,
      "text": "Mainly red scaly patches on my elbows. There's a couple of other things, uh, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.63,
      "end_seconds": 25.45,
      "duration_seconds": 2.82,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.68,
      "end_seconds": 33.41,
      "duration_seconds": 6.73,
      "text": "Oh, probably three weeks. Yeah. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.88,
      "end_seconds": 38.64,
      "duration_seconds": 4.76,
      "text": "Mm-hmm. So, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.08,
      "end_seconds": 43.46,
      "duration_seconds": 3.38,
      "text": "About a eight out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.25,
      "end_seconds": 48.11,
      "duration_seconds": 2.86,
      "text": "Any fever, joint swelling or new medicines?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.54,
      "end_seconds": 55.68,
      "duration_seconds": 2.14,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.71,
      "end_seconds": 59.67,
      "duration_seconds": 1.96,
      "text": "How about eye redness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.93,
      "end_seconds": 64.82,
      "duration_seconds": 3.89,
      "text": "No, I haven't had any eye redness."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.69,
      "end_seconds": 68.84,
      "duration_seconds": 2.15,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.51,
      "end_seconds": 71.87,
      "duration_seconds": 2.36,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.35,
      "end_seconds": 86.07,
      "duration_seconds": 3.72,
      "text": "Right, is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.88,
      "end_seconds": 89.59,
      "duration_seconds": 2.71,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.94,
      "end_seconds": 95.86,
      "duration_seconds": 4.92,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.41,
      "end_seconds": 100.19,
      "duration_seconds": 3.78,
      "text": "Yeah, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.09,
      "end_seconds": 109.11,
      "duration_seconds": 7.02,
      "text": "Do you have any medical conditions I should know about? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.39,
      "end_seconds": 113.64,
      "duration_seconds": 3.25,
      "text": "No, uh, nothing at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.5,
      "end_seconds": 117.0,
      "duration_seconds": 2.5,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.49,
      "end_seconds": 124.56,
      "duration_seconds": 6.07,
      "text": "Sorry, what was I saying, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.9,
      "end_seconds": 142.02,
      "duration_seconds": 4.12,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.7,
      "end_seconds": 154.64,
      "duration_seconds": 11.94,
      "text": "I look after my grandchildren most days. I hardly move around during the day. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.8,
      "end_seconds": 171.03,
      "duration_seconds": 3.23,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.5,
      "end_seconds": 184.93,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.54,
      "end_seconds": 213.2,
      "duration_seconds": 9.66,
      "text": "Okay: blood pressure 123 over 72, temperature is 36.9 degrees, pulse 66. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.77,
      "end_seconds": 216.12,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.44,
      "end_seconds": 224.0,
      "duration_seconds": 3.56,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.66,
      "end_seconds": 229.64,
      "duration_seconds": 3.98,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.61,
      "end_seconds": 233.15,
      "duration_seconds": 2.54,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.13,
      "end_seconds": 248.77,
      "duration_seconds": 3.64,
      "text": "Well-defined thick silvery plaques over both elbows and knees."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.06,
      "end_seconds": 251.2,
      "duration_seconds": 1.14,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.58,
      "end_seconds": 254.72,
      "duration_seconds": 2.14,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.16,
      "end_seconds": 268.99,
      "duration_seconds": 2.83,
      "text": "A few small pits in the fingernails."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.35,
      "end_seconds": 282.27,
      "duration_seconds": 7.92,
      "text": "Right, you can relax now. Putting it all together, I think we're dealing with plaque psoriasis at this stage."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 282.99,
      "end_seconds": 286.27,
      "duration_seconds": 3.28,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.94,
      "end_seconds": 298.12,
      "duration_seconds": 10.18,
      "text": "I understand the worry. At the moment I'd say it's plaque psoriasis, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.42,
      "end_seconds": 310.1,
      "duration_seconds": 4.68,
      "text": "I'll request blood tests, it'll help with baseline before treatment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.73,
      "end_seconds": 313.25,
      "duration_seconds": 1.52,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.87,
      "end_seconds": 324.99,
      "duration_seconds": 11.12,
      "text": "We'll begin with calcipotriol-betamethasone gel, once a day, for four weeks. It's for psoriasis. The pharmacy will go through the details again when you pick it up."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.0,
      "end_seconds": 327.01,
      "duration_seconds": 1.01,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.15,
      "end_seconds": 353.07,
      "duration_seconds": 20.92,
      "text": "A little sunlight helps psoriasis, but avoid sunburn. Moisturise often. If the symptoms get worse, or you feel really unwell, please come to the emergency department. Let's review you in six weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.04,
      "end_seconds": 358.47,
      "duration_seconds": 4.43,
      "text": "Good, uh, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.45,
      "end_seconds": 362.82,
      "duration_seconds": 2.37,
      "text": "Alright, have a good day."
    }
  ]
}