{
  "schema_version": "1.0",
  "encounter_id": "01170",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.7,
      "duration_seconds": 2.98,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.6,
      "end_seconds": 9.06,
      "duration_seconds": 4.46,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.58,
      "end_seconds": 15.14,
      "duration_seconds": 4.56,
      "text": "Well, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.29,
      "end_seconds": 19.16,
      "duration_seconds": 2.87,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.66,
      "end_seconds": 27.26,
      "duration_seconds": 6.6,
      "text": "Doctor, it's a headache since the fall. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.8,
      "end_seconds": 31.96,
      "duration_seconds": 3.16,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.71,
      "end_seconds": 37.75,
      "duration_seconds": 5.04,
      "text": "Erm, it's been going on for about a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.06,
      "end_seconds": 49.51,
      "duration_seconds": 10.45,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.05,
      "end_seconds": 66.57,
      "duration_seconds": 15.52,
      "text": "Pretty severe, if I'm being honest. Paracetamol helps a bit. And I've been feeling dizzy as well. As for feeling dizzy, it's severe, honestly. It's a couple of times a week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.66,
      "end_seconds": 75.97,
      "duration_seconds": 5.31,
      "text": "Did you get vomiting, double vision, loss of consciousness or weakness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.85,
      "end_seconds": 82.32,
      "duration_seconds": 4.47,
      "text": "I mean, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.38,
      "end_seconds": 86.93,
      "duration_seconds": 2.55,
      "text": "So, have you had any confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.89,
      "end_seconds": 91.47,
      "duration_seconds": 3.58,
      "text": "Um, not at all, no confusion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.05,
      "end_seconds": 95.24,
      "duration_seconds": 2.19,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.83,
      "end_seconds": 99.76,
      "duration_seconds": 2.93,
      "text": "Right, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.67,
      "end_seconds": 102.66,
      "duration_seconds": 1.99,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.58,
      "end_seconds": 105.5,
      "duration_seconds": 0.92,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.51,
      "end_seconds": 109.31,
      "duration_seconds": 2.8,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.84,
      "end_seconds": 113.3,
      "duration_seconds": 2.46,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.36,
      "end_seconds": 116.73,
      "duration_seconds": 2.37,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.23,
      "end_seconds": 127.98,
      "duration_seconds": 9.75,
      "text": "It's losartan, 50 milligrams, once a day. Foracort inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.8,
      "end_seconds": 133.79,
      "duration_seconds": 3.99,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.56,
      "end_seconds": 139.2,
      "duration_seconds": 3.64,
      "text": "I have high blood pressure. I've got asthma."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.12,
      "end_seconds": 146.18,
      "duration_seconds": 6.06,
      "text": "I follow. Yes, asthma is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.52,
      "end_seconds": 165.41,
      "duration_seconds": 3.89,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.33,
      "end_seconds": 178.85,
      "duration_seconds": 11.52,
      "text": "I smoke roughly a pack every two days. My husband and I live above the shop. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.59,
      "end_seconds": 183.12,
      "duration_seconds": 2.53,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.52,
      "end_seconds": 188.3,
      "duration_seconds": 3.78,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.21,
      "end_seconds": 207.98,
      "duration_seconds": 2.77,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.63,
      "end_seconds": 212.9,
      "duration_seconds": 4.27,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.66,
      "end_seconds": 219.55,
      "duration_seconds": 3.89,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.79,
      "end_seconds": 222.88,
      "duration_seconds": 2.09,
      "text": "So, does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.85,
      "end_seconds": 239.41,
      "duration_seconds": 8.56,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.72,
      "end_seconds": 244.67,
      "duration_seconds": 1.95,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.12,
      "end_seconds": 279.11,
      "duration_seconds": 16.99,
      "text": "Putting it all together, it fits best with a minor head injury without worrying signs. A concussion is still possible. We'll begin with paracetamol, 1 gram, every six hours if needed, for three days. That's for headache."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.21,
      "end_seconds": 283.89,
      "duration_seconds": 2.68,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.48,
      "end_seconds": 293.99,
      "duration_seconds": 9.51,
      "text": "Someone should stay with you tonight, and no alcohol or contact sport for now. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.96,
      "end_seconds": 298.22,
      "duration_seconds": 3.26,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.84,
      "end_seconds": 301.8,
      "duration_seconds": 1.96,
      "text": "Have a good day."
    }
  ]
}