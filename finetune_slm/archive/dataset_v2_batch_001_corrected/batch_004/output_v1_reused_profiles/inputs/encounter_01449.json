  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 3.28,
      "duration_seconds": 2.6,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 4.15,
      "end_seconds": 5.34,
      "duration_seconds": 1.19,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.96,
      "end_seconds": 13.28,
      "duration_seconds": 7.32,
      "text": "Yeah, it's cramping in my lower tummy. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.35,
      "end_seconds": 18.36,
      "duration_seconds": 4.01,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.21,
      "end_seconds": 35.05,
      "duration_seconds": 2.84,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.68,
      "end_seconds": 64.39,
      "duration_seconds": 12.71,
      "text": "Okay: pressure 128 over 81, temperature is 36.9 degrees, pulse is 78 beats a minute, oxygen saturation is 98 percent. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.66,
      "end_seconds": 67.62,
      "duration_seconds": 1.96,
      "text": "About... well, ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.33,
      "end_seconds": 72.43,
      "duration_seconds": 3.1,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.83,
      "end_seconds": 78.75,
      "duration_seconds": 0.92,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.53,
      "end_seconds": 82.35,
      "duration_seconds": 1.82,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.67,
      "end_seconds": 85.65,
      "duration_seconds": 1.98,
      "text": "Rest helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.94,
      "end_seconds": 86.64,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.53,
      "end_seconds": 103.36,
      "duration_seconds": 3.83,
      "text": "Have you noticed shoulder tip pain or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.2,
      "end_seconds": 112.43,
      "duration_seconds": 5.23,
      "text": "No shoulder tip pain or fainting, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.02,
      "end_seconds": 117.5,
      "duration_seconds": 3.48,
      "text": "Have you had passing tissue, by any chance?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 119.22,
      "end_seconds": 121.32,
      "duration_seconds": 2.1,
      "text": "Definitely no passing tissue."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.95,
      "end_seconds": 123.92,
      "duration_seconds": 1.97,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.31,
      "end_seconds": 129.1,
      "duration_seconds": 3.79,
      "text": "No, uh, my breathing's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.46,
      "end_seconds": 141.42,
      "duration_seconds": 1.96,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.26,
      "end_seconds": 146.38,
      "duration_seconds": 3.12,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.02,
      "end_seconds": 151.29,
      "duration_seconds": 3.27,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.66,
      "end_seconds": 173.92,
      "duration_seconds": 21.26,
      "text": "No, I've never smoked in my life. I'll have a glass of wine with dinner. Lots of rice, lentils and some fruit. I'm a bus driver, so I sit for long hours. My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.68,
      "end_seconds": 190.65,
      "duration_seconds": 3.97,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.13,
      "end_seconds": 199.77,
      "duration_seconds": 3.64,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.39,
      "end_seconds": 208.35,
      "duration_seconds": 3.96,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.49,
      "end_seconds": 211.14,
      "duration_seconds": 1.65,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.68,
      "end_seconds": 216.4,
      "duration_seconds": 3.72,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.21,
      "end_seconds": 220.67,
      "duration_seconds": 2.46,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.65,
      "end_seconds": 235.15,
      "duration_seconds": 6.5,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.05,
      "end_seconds": 250.81,
      "duration_seconds": 12.76,
      "text": "That's all I needed to check. From what you've told me and what I found, it fits best with bleeding in early pregnancy that needs a scan."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.75,
      "end_seconds": 284.67,
      "duration_seconds": 16.92,
      "text": "I'm sending you for an early pregnancy scan because of bleeding in early pregnancy. Use pads rather than tampons and avoid intercourse until the scan. I'd like you to see the early pregnancy unit as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 286.45,
      "end_seconds": 289.1,
      "duration_seconds": 2.65,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.22,
      "end_seconds": 303.83,
      "duration_seconds": 13.61,
      "text": "Come back or go to emergency straight away if the bleeding becomes heavy or the pain becomes severe or one-sided. Please come and see me after the scan. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 308.95,
      "end_seconds": 312.68,
      "duration_seconds": 3.73,
      "text": "Thank you, you know, doctor, goodbye."
    }
  ]
}