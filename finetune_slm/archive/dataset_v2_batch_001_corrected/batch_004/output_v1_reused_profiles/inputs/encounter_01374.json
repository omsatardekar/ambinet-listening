{
  "schema_version": "1.0",
  "encounter_id": "01374",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.6,
      "end_seconds": 3.3,
      "duration_seconds": 2.7,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.95,
      "end_seconds": 6.17,
      "duration_seconds": 2.22,
      "text": "Evening, uh, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.25,
      "end_seconds": 10.3,
      "duration_seconds": 2.05,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.31,
      "end_seconds": 15.34,
      "duration_seconds": 4.03,
      "text": "I'm here because of aching bones and muscles."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.34,
      "end_seconds": 19.04,
      "duration_seconds": 2.7,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.27,
      "end_seconds": 22.67,
      "duration_seconds": 2.4,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.87,
      "end_seconds": 32.29,
      "duration_seconds": 3.42,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.19,
      "end_seconds": 36.51,
      "duration_seconds": 3.32,
      "text": "I've had it for about a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.74,
      "end_seconds": 39.1,
      "duration_seconds": 2.36,
      "text": "I follow. Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.89,
      "end_seconds": 43.57,
      "duration_seconds": 2.68,
      "text": "I get some relief from rest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.36,
      "end_seconds": 48.21,
      "duration_seconds": 2.85,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.04,
      "end_seconds": 51.76,
      "duration_seconds": 1.72,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.44,
      "end_seconds": 55.14,
      "duration_seconds": 2.7,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.64,
      "end_seconds": 66.78,
      "duration_seconds": 10.14,
      "text": "It usually comes with low mood. The low mood? That's been for about a week. About low mood, I'd say mild."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.92,
      "end_seconds": 72.31,
      "duration_seconds": 4.39,
      "text": "Alright, have you noticed fever, weight loss or black stools?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.26,
      "end_seconds": 78.1,
      "duration_seconds": 4.84,
      "text": "I haven't had fever, weight loss or black stools, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.03,
      "end_seconds": 80.98,
      "duration_seconds": 1.95,
      "text": "Any sign of fractures?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.92,
      "end_seconds": 83.67,
      "duration_seconds": 1.75,
      "text": "Nope, no fractures."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.1,
      "end_seconds": 89.56,
      "duration_seconds": 5.46,
      "text": "Okay, go on. What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 90.82,
      "end_seconds": 92.74,
      "duration_seconds": 1.92,
      "text": "No, all normal there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.46,
      "end_seconds": 95.5,
      "duration_seconds": 2.04,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.13,
      "end_seconds": 102.67,
      "duration_seconds": 5.54,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.88,
      "end_seconds": 105.32,
      "duration_seconds": 1.44,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.56,
      "end_seconds": 109.26,
      "duration_seconds": 2.7,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.72,
      "end_seconds": 112.08,
      "duration_seconds": 1.36,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 116.04,
      "end_seconds": 119.8,
      "duration_seconds": 3.76,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.04,
      "end_seconds": 124.82,
      "duration_seconds": 3.78,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.53,
      "end_seconds": 128.22,
      "duration_seconds": 1.69,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.67,
      "end_seconds": 145.74,
      "duration_seconds": 2.07,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 146.82,
      "end_seconds": 152.72,
      "duration_seconds": 5.9,
      "text": "I had my appendix taken out when I was in my twenties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.14,
      "end_seconds": 166.81,
      "duration_seconds": 4.67,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.49,
      "end_seconds": 172.0,
      "duration_seconds": 3.51,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.34,
      "end_seconds": 186.74,
      "duration_seconds": 4.4,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.62,
      "end_seconds": 196.02,
      "duration_seconds": 2.4,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.87,
      "end_seconds": 218.11,
      "duration_seconds": 4.24,
      "text": "Okay: heart rate 66, blood pressure 119 over 73."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.91,
      "end_seconds": 222.05,
      "duration_seconds": 2.14,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.71,
      "end_seconds": 239.4,
      "duration_seconds": 2.69,
      "text": "Yeah, um, no problem."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.73,
      "end_seconds": 241.99,
      "duration_seconds": 1.26,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.44,
      "end_seconds": 254.17,
      "duration_seconds": 3.73,
      "text": "Gentle pressure over the shin bone is tender."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.58,
      "end_seconds": 278.8,
      "duration_seconds": 21.22,
      "text": "You can relax now. Taking everything into account, I think we're dealing with a vitamin deficiency at this stage. I want to be honest that this is an impression, not a final answer. Let's book a vitamin B12 level to look into tingling and tiredness."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.57,
      "end_seconds": 283.3,
      "duration_seconds": 2.73,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.66,
      "end_seconds": 312.24,
      "duration_seconds": 27.58,
      "text": "I want a full blood count done, that's for fatigue. Let's use vitamin D, 60000 units, once a week, for eight weeks. It's for possible deficiency. Some midday sunlight on the arms for fifteen minutes helps. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.83,
      "end_seconds": 334.13,
      "duration_seconds": 21.3,
      "text": "I see, go ahead. I'm not ordering a vitamin D level today. If things carry on in two weeks, we'll consider it. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency. See me again after the results are back."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.11,
      "end_seconds": 338.38,
      "duration_seconds": 3.27,
      "text": "I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.3,
      "end_seconds": 344.2,
      "duration_seconds": 3.9,
      "text": "Right, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 348.8,
      "end_seconds": 351.26,
      "duration_seconds": 2.46,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}