{
  "schema_version": "1.0",
  "encounter_id": "01463",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.37,
      "end_seconds": 6.72,
      "duration_seconds": 5.35,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.25,
      "end_seconds": 11.73,
      "duration_seconds": 4.48,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 13.19,
      "end_seconds": 19.38,
      "duration_seconds": 6.19,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.37,
      "end_seconds": 25.26,
      "duration_seconds": 3.89,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 26.42,
      "end_seconds": 34.19,
      "duration_seconds": 7.77,
      "text": "I wanted to get pins and needles in my hands and feet looked at."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.31,
      "end_seconds": 40.03,
      "duration_seconds": 4.72,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 40.71,
      "end_seconds": 44.31,
      "duration_seconds": 3.6,
      "text": "It's glibenclamide, 5 milligrams, before breakfast."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 46.59,
      "end_seconds": 54.71,
      "duration_seconds": 8.12,
      "text": "It's, It's a... um, I can't remember what it's called. It's a little pink tablet."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.88,
      "end_seconds": 58.91,
      "duration_seconds": 3.03,
      "text": "Okay, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 59.73,
      "end_seconds": 69.52,
      "duration_seconds": 9.79,
      "text": "Ah, for the reflux, I believe. My son sets them out for me, I just take what I'm given."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 75.1,
      "duration_seconds": 3.69,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.72,
      "end_seconds": 79.11,
      "duration_seconds": 3.39,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 81.1,
      "end_seconds": 84.84,
      "duration_seconds": 3.74,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.72,
      "end_seconds": 91.26,
      "duration_seconds": 4.54,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.97,
      "end_seconds": 99.18,
      "duration_seconds": 2.21,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.82,
      "end_seconds": 103.6,
      "duration_seconds": 3.78,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 104.15,
      "end_seconds": 105.13,
      "duration_seconds": 0.98,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 105.8,
      "end_seconds": 112.41,
      "duration_seconds": 6.61,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 112.51,
      "end_seconds": 117.9,
      "duration_seconds": 5.39,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 118.72,
      "end_seconds": 126.95,
      "duration_seconds": 8.23,
      "text": "I was getting to that! And I've been forgetting words as well, for nearly five years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.6,
      "end_seconds": 134.89,
      "duration_seconds": 7.29,
      "text": "Let me check a few things. Any diarrhoea, weakness of one side or weight loss?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 136.6,
      "end_seconds": 148.77,
      "duration_seconds": 12.17,
      "text": "No, no diarrhoea, no weakness of one side, no weight loss. I was feeling very tired at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.67,
      "end_seconds": 154.34,
      "duration_seconds": 3.67,
      "text": "Have you noticed loss of vision or bladder problems?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 156.29,
      "end_seconds": 161.84,
      "duration_seconds": 5.55,
      "text": "I haven't had loss of vision or bladder problems, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.51,
      "end_seconds": 165.09,
      "duration_seconds": 2.58,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 170.25,
      "end_seconds": 173.72,
      "duration_seconds": 3.47,
      "text": "Hmm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.74,
      "end_seconds": 177.94,
      "duration_seconds": 2.2,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 179.82,
      "end_seconds": 182.2,
      "duration_seconds": 2.38,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.03,
      "end_seconds": 185.06,
      "duration_seconds": 2.03,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 186.32,
      "end_seconds": 191.39,
      "duration_seconds": 5.07,
      "text": "Yes, I had my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.3,
      "end_seconds": 214.48,
      "duration_seconds": 4.18,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 216.18,
      "end_seconds": 221.34,
      "duration_seconds": 5.16,
      "text": "I have diabetes. Yes, acid reflux. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.48,
      "end_seconds": 231.91,
      "duration_seconds": 9.43,
      "text": "Sure. Right, so diabetes and acid reflux are already on your record. We'll keep that in mind today. How about smoking?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 233.06,
      "end_seconds": 236.1,
      "duration_seconds": 3.04,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.8,
      "end_seconds": 239.41,
      "duration_seconds": 1.61,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 240.11,
      "end_seconds": 244.08,
      "duration_seconds": 3.97,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.04,
      "end_seconds": 248.58,
      "duration_seconds": 3.54,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 250.52,
      "end_seconds": 254.53,
      "duration_seconds": 4.01,
      "text": "Right, no, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 259.13,
      "end_seconds": 267.56,
      "duration_seconds": 8.43,
      "text": "Actually, I remember she had some kind of reaction to erythromycin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 269.16,
      "end_seconds": 271.47,
      "duration_seconds": 2.31,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.43,
      "end_seconds": 278.41,
      "duration_seconds": 2.98,
      "text": "Okay, I'll note both of those."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 285.5,
      "end_seconds": 293.63,
      "duration_seconds": 8.13,
      "text": "Doctor, I've got the readings for you. SpO2 98 percent on room air, pressure 109 over 74, heart rate 75."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.7,
      "end_seconds": 296.79,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.82,
      "end_seconds": 302.63,
      "duration_seconds": 4.81,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 303.94,
      "end_seconds": 304.64,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.9,
      "end_seconds": 307.33,
      "duration_seconds": 1.43,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.07,
      "end_seconds": 324.8,
      "duration_seconds": 2.73,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.53,
      "end_seconds": 327.97,
      "duration_seconds": 1.44,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.69,
      "end_seconds": 346.82,
      "duration_seconds": 3.13,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.08,
      "end_seconds": 377.51,
      "duration_seconds": 25.43,
      "text": "Good, you can sit up again. Okay, thinking it through, I can't pin this down yet. We're looking at symptoms that fit a vitamin B12 deficiency or an under-active thyroid. So, to recap quickly. You've had pins and needles in your hands and feet, mild, and no weight loss or diarrhoea."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 379.56,
      "end_seconds": 381.32,
      "duration_seconds": 1.76,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.75,
      "end_seconds": 386.17,
      "duration_seconds": 3.42,
      "text": "Any scans or blood work done already?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 387.12,
      "end_seconds": 395.62,
      "duration_seconds": 8.5,
      "text": "I did have a vitamin B12 level done last year, but the paper's at home."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 397.57,
      "end_seconds": 401.57,
      "duration_seconds": 4.0,
      "text": "A thyroid test is what I'd like next, for tiredness."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 402.85,
      "end_seconds": 404.34,
      "duration_seconds": 1.49,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.46,
      "end_seconds": 410.26,
      "duration_seconds": 4.8,
      "text": "I'll request a full blood count, it'll help with tiredness."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 411.32,
      "end_seconds": 412.82,
      "duration_seconds": 1.5,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 414.2,
      "end_seconds": 433.41,
      "duration_seconds": 19.21,
      "text": "You'll be taking cyanocobalamin, 1000 micrograms, every other day, for two weeks. That should help with low vitamin B12. Eating more eggs, dairy and fortified cereals will help over time. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 435.31,
      "end_seconds": 437.34,
      "duration_seconds": 2.03,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 438.83,
      "end_seconds": 445.62,
      "duration_seconds": 6.79,
      "text": "See me again in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 447.44,
      "end_seconds": 449.83,
      "duration_seconds": 2.39,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 450.52,
      "end_seconds": 452.28,
      "duration_seconds": 1.76,
      "text": "Have a good day."
    }
  ]
}