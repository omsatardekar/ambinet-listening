{
  "schema_version": "1.0",
  "encounter_id": "01033",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.12,
      "end_seconds": 3.92,
      "duration_seconds": 2.8,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 8.63,
      "duration_seconds": 3.84,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.67,
      "end_seconds": 19.71,
      "duration_seconds": 8.04,
      "text": "I've been feeling shaky and sweaty. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.78,
      "end_seconds": 25.06,
      "duration_seconds": 3.28,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.62,
      "end_seconds": 38.63,
      "duration_seconds": 2.01,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.18,
      "end_seconds": 66.56,
      "duration_seconds": 16.38,
      "text": "Okay: BMI works out to 26.1, blood pressure 115 over 69, weight 72 kilos, temperature 36.7, SpO2 97 percent on room air, height 166 centimetres, respiratory rate 15, heart rate 70."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.64,
      "end_seconds": 70.27,
      "duration_seconds": 1.63,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.28,
      "end_seconds": 79.91,
      "duration_seconds": 7.63,
      "text": "They help me see the whole picture, more shortly. How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.99,
      "end_seconds": 93.22,
      "duration_seconds": 11.23,
      "text": "About... well, about a week. It's a relief to finally sit down and talk about it. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.43,
      "end_seconds": 97.11,
      "duration_seconds": 2.68,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.11,
      "end_seconds": 103.06,
      "duration_seconds": 4.95,
      "text": "Sudden hunger goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.06,
      "end_seconds": 111.53,
      "duration_seconds": 4.47,
      "text": "Did you get vomiting, fainting, chest pain or seizure?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.38,
      "end_seconds": 117.97,
      "duration_seconds": 4.59,
      "text": "No, no vomiting, fainting, chest pain or seizure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.97,
      "end_seconds": 121.19,
      "duration_seconds": 2.22,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.97,
      "end_seconds": 123.98,
      "duration_seconds": 2.01,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.29,
      "end_seconds": 150.81,
      "duration_seconds": 8.52,
      "text": "Are there any allergies I should be aware of? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.46,
      "end_seconds": 156.51,
      "duration_seconds": 4.05,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.11,
      "end_seconds": 162.0,
      "duration_seconds": 3.89,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.59,
      "end_seconds": 167.88,
      "duration_seconds": 4.29,
      "text": "I've, I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.81,
      "end_seconds": 170.9,
      "duration_seconds": 1.09,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.78,
      "end_seconds": 188.18,
      "duration_seconds": 2.4,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.13,
      "end_seconds": 201.7,
      "duration_seconds": 11.57,
      "text": "I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.87,
      "end_seconds": 221.0,
      "duration_seconds": 2.13,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.53,
      "end_seconds": 231.3,
      "duration_seconds": 8.77,
      "text": "Glycomet, 500 milligrams, twice a day for my sugar. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.51,
      "end_seconds": 246.67,
      "duration_seconds": 5.16,
      "text": "Alright, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.77,
      "end_seconds": 249.81,
      "duration_seconds": 2.04,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.8,
      "end_seconds": 283.18,
      "duration_seconds": 31.38,
      "text": "Going by what you've described, my working impression is episodes of low blood sugar related to diabetes treatment. I want a home sugar diary done, that's for hypoglycaemia. It's a routine test and it'll give us a much clearer picture. Blood tests is what I'd like next, for low sugar. Never skip meals when you take the sugar tablet, and keep glucose tablets or juice with you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.62,
      "end_seconds": 296.39,
      "duration_seconds": 12.77,
      "text": "Right, right. Keep an eye out, and if you have an episode that does not settle with sugar, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.14,
      "end_seconds": 300.79,
      "duration_seconds": 2.65,
      "text": "Okay, um, makes sense."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.05,
      "end_seconds": 309.3,
      "duration_seconds": 3.25,
      "text": "Let's plan a check after the blood tests."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.11,
      "end_seconds": 310.81,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.43,
      "end_seconds": 314.85,
      "duration_seconds": 2.42,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.4,
      "end_seconds": 318.2,
      "duration_seconds": 2.8,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.07,
      "end_seconds": 320.68,
      "duration_seconds": 1.61,
      "text": "Have a good day."
    }
  ]
}