      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 246.06,
      "duration_seconds": 2.71,
      "text": "good, you can sit up again"
