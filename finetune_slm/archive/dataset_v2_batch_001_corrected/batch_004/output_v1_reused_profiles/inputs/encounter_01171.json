      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.81,
      "end_seconds": 340.57,
      "duration_seconds": 13.76,
      "text": "Write down anything new you ate, took or used before this started, even small things. Book a review in two weeks. Anything else on your mind before you go?"
