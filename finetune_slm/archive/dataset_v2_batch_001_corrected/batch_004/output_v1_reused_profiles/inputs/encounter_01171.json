      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.44,
      "end_seconds": 270.61,
      "duration_seconds": 6.17,
      "text": "Okay so my impression is this: It fits best with acute urticaria, possibly allergic."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.89,
      "end_seconds": 274.99,
      "duration_seconds": 3.1,
      "text": "What are the odds it's serious?"
