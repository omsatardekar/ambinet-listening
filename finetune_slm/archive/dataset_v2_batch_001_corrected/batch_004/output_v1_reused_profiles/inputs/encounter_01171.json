      "role": "DOCTOR",
      "start_seconds": 196.22,
      "end_seconds": 203.13,
      "duration_seconds": 6.91,
      "text": "okay: respiratory rate 15 pulse 84. And blood pressure 123 over 82 temperature is 36.6 degrees"
