{
  "schema_version": "1.0",
  "encounter_id": "01192",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.89,
      "end_seconds": 3.34,
      "duration_seconds": 2.45,
      "text": "alright, welcome. Make yourself comfortable"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.38,
      "end_seconds": 6.51,
      "duration_seconds": 1.13,
      "text": "hello, doctor"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 7.8,
      "end_seconds": 12.22,
      "duration_seconds": 4.42,
      "text": "good morning, doctor i came along to help out"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.28,
      "end_seconds": 15.7,
      "duration_seconds": 2.42,
      "text": "did you find the place alright?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.71,
      "end_seconds": 22.36,
      "duration_seconds": 5.65,
      "text": "yes, it was easy enough. The parking was the hard part"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.62,
      "end_seconds": 26.99,
      "duration_seconds": 3.37,
      "text": "what would you like to start with today?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.43,
      "end_seconds": 31.53,
      "duration_seconds": 3.1,
      "text": "she's been having a sore tongue, doctor"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.12,
      "end_seconds": 36.7,
      "duration_seconds": 3.58,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.91,
      "end_seconds": 40.29,
      "duration_seconds": 2.38,
      "text": "around a week, I think"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.19,
      "end_seconds": 44.41,
      "duration_seconds": 3.22,
      "text": "it was closer to two weeks, doctor"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.02,
      "end_seconds": 49.93,
      "duration_seconds": 4.91,
      "text": "okay, so roughly one to two weeks is that that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.02,
      "end_seconds": 53.14,
      "duration_seconds": 2.12,
      "text": "that sounds about right"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.88,
      "end_seconds": 62.97,
      "duration_seconds": 9.09,
      "text": "alright, can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.31,
      "end_seconds": 71.93,
      "duration_seconds": 7.62,
      "text": "yes, spicy food that makes it worse pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.31,
      "end_seconds": 77.09,
      "duration_seconds": 3.78,
      "text": "Any being unsteady on your feet as well?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.87,
      "end_seconds": 82.44,
      "duration_seconds": 3.57,
      "text": "Yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.12,
      "end_seconds": 87.06,
      "duration_seconds": 2.94,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.65,
      "end_seconds": 89.28,
      "duration_seconds": 1.63,
      "text": "Moderate, I'd say."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.82,
      "end_seconds": 92.89,
      "duration_seconds": 2.07,
      "text": "Have you been forgetting words?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.09,
      "end_seconds": 99.94,
      "duration_seconds": 2.85,
      "text": "Yeah. Two years, I'd say."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.46,
      "end_seconds": 106.81,
      "duration_seconds": 5.35,
      "text": "Have you had a sore tongue before, or is this the first time?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.52,
      "end_seconds": 114.64,
      "duration_seconds": 7.12,
      "text": "I had a similar thing a couple of years ago it went away"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.39,
      "end_seconds": 135.32,
      "duration_seconds": 2.93,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.1,
      "end_seconds": 145.44,
      "duration_seconds": 9.34,
      "text": "I've had acid reflux for nearly five years now. My neighbour said I should get it looked at. Yes, diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.36,
      "end_seconds": 158.1,
      "duration_seconds": 10.74,
      "text": "yes, diabetes is known to us, good to have that clear so, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.9,
      "end_seconds": 164.46,
      "duration_seconds": 4.56,
      "text": "Glimepiride. I take it 2 milligrams, maybe, before breakfast."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.82,
      "end_seconds": 170.25,
      "duration_seconds": 4.43,
      "text": "do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.35,
      "end_seconds": 174.13,
      "duration_seconds": 2.78,
      "text": "um no it's at home"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.7,
      "end_seconds": 178.3,
      "duration_seconds": 2.6,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.32,
      "end_seconds": 192.98,
      "duration_seconds": 12.66,
      "text": "Not much, I mostly stay in these days. I'm a hairdresser, on my feet all day. Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.27,
      "end_seconds": 205.37,
      "duration_seconds": 4.1,
      "text": "A few quick ones: loss of vision or bladder problems?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.88,
      "end_seconds": 213.93,
      "duration_seconds": 5.05,
      "text": "No loss of vision or bladder problems, none of it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.45,
      "end_seconds": 218.38,
      "duration_seconds": 3.93,
      "text": "And what about weakness of one side or rash?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.59,
      "end_seconds": 224.1,
      "duration_seconds": 4.51,
      "text": "I haven't had weakness of one side or rash no"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.8,
      "end_seconds": 227.41,
      "duration_seconds": 2.61,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 228.58,
      "end_seconds": 231.18,
      "duration_seconds": 2.6,
      "text": "Nothing unusual you know no."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.13,
      "end_seconds": 233.93,
      "duration_seconds": 1.8,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.94,
      "end_seconds": 238.65,
      "duration_seconds": 2.71,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.66,
      "end_seconds": 247.2,
      "duration_seconds": 4.54,
      "text": "alright, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.03,
      "end_seconds": 257.41,
      "duration_seconds": 2.38,
      "text": "bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.22,
      "end_seconds": 283.37,
      "duration_seconds": 7.15,
      "text": "Okay: respiratory rate 18, pressure 113 over 72. And oxygen saturation is 97 percent, heart rate 68."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.07,
      "end_seconds": 288.68,
      "duration_seconds": 3.61,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.35,
      "end_seconds": 290.5,
      "duration_seconds": 1.15,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.49,
      "end_seconds": 293.49,
      "duration_seconds": 2.0,
      "text": "hold that for a second"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.22,
      "end_seconds": 308.74,
      "duration_seconds": 2.52,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.09,
      "end_seconds": 329.42,
      "duration_seconds": 16.33,
      "text": "All finished thank you. From what you've told me and what I found it fits best with symptoms that fit a vitamin B12 deficiency. It could also be an under-active thyroid so so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.28,
      "end_seconds": 334.39,
      "duration_seconds": 3.11,
      "text": "is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.24,
      "end_seconds": 352.33,
      "duration_seconds": 17.09,
      "text": "It's reasonable to be concerned, but right now symptoms that fit a vitamin B12 deficiency is my leading thought, not anything worse. I'm gonna order a vitamin B12 level, for tingling and tiredness. I'm going to order a thyroid test, for tiredness."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 354.34,
      "end_seconds": 355.44,
      "duration_seconds": 1.1,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.62,
      "end_seconds": 390.64,
      "duration_seconds": 34.02,
      "text": "I'll start you on cyanocobalamin, 1000 micrograms, every other day, for two weeks. It's for low vitamin B12. Eating more eggs, dairy and fortified cereals will help over time. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.64,
      "end_seconds": 401.42,
      "duration_seconds": 8.78,
      "text": "keep an eye out, and and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 402.63,
      "end_seconds": 406.09,
      "duration_seconds": 3.46,
      "text": "yes, I'll bear that in mind"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.81,
      "end_seconds": 412.56,
      "duration_seconds": 5.75,
      "text": "we'll catch up in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.87,
      "end_seconds": 415.54,
      "duration_seconds": 1.67,
      "text": "that's clear, thanks"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 420.21,
      "end_seconds": 421.6,
      "duration_seconds": 1.39,
      "text": "goodbye for now"
    }
  ]
}