{
  "schema_version": "1.0",
  "encounter_id": "01048",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 2.78,
      "duration_seconds": 1.51,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.06,
      "end_seconds": 8.48,
      "duration_seconds": 4.42,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 9.2,
      "end_seconds": 15.05,
      "duration_seconds": 5.85,
      "text": "Doctor, uh, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.13,
      "end_seconds": 21.36,
      "duration_seconds": 5.23,
      "text": "Mm, I've been dealing with pain in my right ear."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.45,
      "end_seconds": 27.38,
      "duration_seconds": 3.93,
      "text": "Alright, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.27,
      "end_seconds": 42.92,
      "duration_seconds": 2.65,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.39,
      "end_seconds": 63.67,
      "duration_seconds": 5.28,
      "text": "Okay: heart rate 67, BP is 112 over 73, saturation 97 percent."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.39,
      "end_seconds": 65.75,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.07,
      "end_seconds": 73.11,
      "duration_seconds": 6.04,
      "text": "We'll look at it together shortly. Okay, has this been going on for long?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.77,
      "end_seconds": 83.47,
      "duration_seconds": 9.7,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.66,
      "end_seconds": 87.03,
      "duration_seconds": 2.37,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.32,
      "end_seconds": 93.67,
      "duration_seconds": 2.35,
      "text": "Chewing definitely sets it off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.8,
      "end_seconds": 96.98,
      "duration_seconds": 2.18,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.38,
      "end_seconds": 109.77,
      "duration_seconds": 11.39,
      "text": "A discharge from the ear goes along with it, most of the time. The discharge from the ear? That's been since Monday."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.16,
      "end_seconds": 120.45,
      "duration_seconds": 3.29,
      "text": "Any ringing in the ear or fever?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.35,
      "end_seconds": 124.26,
      "duration_seconds": 2.91,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.73,
      "end_seconds": 128.14,
      "duration_seconds": 2.41,
      "text": "Any recent swimming or facial weakness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.18,
      "end_seconds": 132.73,
      "duration_seconds": 2.55,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.53,
      "end_seconds": 135.57,
      "duration_seconds": 2.04,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.73,
      "end_seconds": 140.26,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.92,
      "end_seconds": 145.32,
      "duration_seconds": 3.4,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.65,
      "end_seconds": 148.9,
      "duration_seconds": 2.25,
      "text": "Diabetes, for five years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.57,
      "end_seconds": 154.14,
      "duration_seconds": 4.57,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.01,
      "end_seconds": 159.88,
      "duration_seconds": 4.87,
      "text": "I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.39,
      "end_seconds": 161.6,
      "duration_seconds": 1.21,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.5,
      "end_seconds": 164.57,
      "duration_seconds": 2.07,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.4,
      "end_seconds": 167.91,
      "duration_seconds": 2.51,
      "text": "Okay, who lives with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.71,
      "end_seconds": 171.95,
      "duration_seconds": 2.24,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.83,
      "end_seconds": 179.66,
      "duration_seconds": 1.83,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.31,
      "end_seconds": 185.98,
      "duration_seconds": 4.67,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.74,
      "end_seconds": 207.22,
      "duration_seconds": 2.48,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.13,
      "end_seconds": 212.25,
      "duration_seconds": 3.12,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.55,
      "end_seconds": 216.7,
      "duration_seconds": 3.15,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.97,
      "end_seconds": 220.23,
      "duration_seconds": 2.26,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.91,
      "end_seconds": 242.82,
      "duration_seconds": 8.91,
      "text": "The ear canal is red and swollen with some debris, and it's painful when I pull the ear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 248.77,
      "duration_seconds": 2.61,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.98,
      "end_seconds": 274.1,
      "duration_seconds": 11.12,
      "text": "Right, here's what I'm thinking. It's hard to say. An outer ear canal infection is one possibility and wax another, and I'd rather not commit yet."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.04,
      "end_seconds": 280.82,
      "duration_seconds": 2.78,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.26,
      "end_seconds": 314.83,
      "duration_seconds": 32.57,
      "text": "Nothing I've seen today points to an emergency. It looks like an outer ear canal infection. I'm going to put you on antibiotic and steroid ear drops, 3 drops, twice a day, for seven days. That's for ear canal infection. Keep the ear dry, no swimming, and don't poke anything into it. See me again if it isn't better in three days. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.93,
      "end_seconds": 319.14,
      "duration_seconds": 3.21,
      "text": "Great, thank you for your help."
    }
  ]
}