{
  "schema_version": "1.0",
  "encounter_id": "01070",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 6.81,
      "duration_seconds": 5.72,
      "text": "Oh, um, doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.01,
      "end_seconds": 13.24,
      "duration_seconds": 5.23,
      "text": "So, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.46,
      "end_seconds": 20.1,
      "duration_seconds": 5.64,
      "text": "Actually, I've been dealing with trouble hearing in my left ear."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.83,
      "end_seconds": 22.93,
      "duration_seconds": 2.1,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.87,
      "end_seconds": 27.94,
      "duration_seconds": 3.07,
      "text": "It's been nearly five years now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.68,
      "end_seconds": 49.86,
      "duration_seconds": 3.18,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.75,
      "end_seconds": 55.92,
      "duration_seconds": 4.17,
      "text": "I, I take losartan, once a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.86,
      "end_seconds": 59.24,
      "duration_seconds": 2.38,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.92,
      "end_seconds": 62.55,
      "duration_seconds": 1.63,
      "text": "It's 50 milligrams."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.5,
      "end_seconds": 84.48,
      "duration_seconds": 3.98,
      "text": "Right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.19,
      "end_seconds": 89.3,
      "duration_seconds": 3.11,
      "text": "High blood pressure, for five years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.33,
      "end_seconds": 92.03,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.65,
      "end_seconds": 111.04,
      "duration_seconds": 1.39,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.65,
      "end_seconds": 115.16,
      "duration_seconds": 2.51,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.95,
      "end_seconds": 118.61,
      "duration_seconds": 1.66,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.1,
      "end_seconds": 121.85,
      "duration_seconds": 1.75,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.58,
      "end_seconds": 125.24,
      "duration_seconds": 2.66,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.92,
      "end_seconds": 130.63,
      "duration_seconds": 3.71,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.74,
      "end_seconds": 138.06,
      "duration_seconds": 3.32,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.7,
      "end_seconds": 143.01,
      "duration_seconds": 3.31,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.93,
      "end_seconds": 151.48,
      "duration_seconds": 3.55,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.56,
      "end_seconds": 158.78,
      "duration_seconds": 6.22,
      "text": "I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.88,
      "end_seconds": 169.05,
      "duration_seconds": 2.17,
      "text": "And dizziness, any of that?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.82,
      "end_seconds": 172.43,
      "duration_seconds": 1.61,
      "text": "Nope, no dizziness."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.2,
      "end_seconds": 176.81,
      "duration_seconds": 3.61,
      "text": "And what about discharge, ear pain or headache?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.39,
      "end_seconds": 182.41,
      "duration_seconds": 5.02,
      "text": "I, I haven't had discharge, ear pain or headache, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.61,
      "end_seconds": 187.65,
      "duration_seconds": 2.04,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.44,
      "end_seconds": 190.95,
      "duration_seconds": 2.51,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.91,
      "end_seconds": 194.83,
      "duration_seconds": 2.92,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.03,
      "end_seconds": 209.51,
      "duration_seconds": 2.48,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.17,
      "end_seconds": 226.14,
      "duration_seconds": 6.97,
      "text": "Okay: temperature is 36.8 degrees, pulse is 69 beats a minute, pressure 121 over 78."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.04,
      "end_seconds": 231.35,
      "duration_seconds": 3.31,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.25,
      "end_seconds": 237.09,
      "duration_seconds": 3.84,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.96,
      "end_seconds": 243.85,
      "duration_seconds": 3.89,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.9,
      "end_seconds": 247.49,
      "duration_seconds": 2.59,
      "text": "Okay, tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.93,
      "end_seconds": 262.57,
      "duration_seconds": 3.64,
      "text": "The right ear canal and drum are normal."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.28,
      "end_seconds": 274.67,
      "duration_seconds": 8.39,
      "text": "You can relax now. So, based on the history and the examination, my working impression is hearing loss from wax."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.71,
      "end_seconds": 277.63,
      "duration_seconds": 1.92,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.17,
      "end_seconds": 298.15,
      "duration_seconds": 18.98,
      "text": "It's reasonable to be concerned, but right now hearing loss from wax is my leading thought, not anything worse. Stop me if I've got anything wrong. You've had trouble hearing in your left ear for nearly five years, and no discharge or dizziness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.71,
      "end_seconds": 302.09,
      "duration_seconds": 3.38,
      "text": "Uh, yes, you've got it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.56,
      "end_seconds": 308.28,
      "duration_seconds": 4.72,
      "text": "Let's book a hearing test to look into hearing loss."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.27,
      "end_seconds": 311.27,
      "duration_seconds": 2.0,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.67,
      "end_seconds": 333.0,
      "duration_seconds": 20.33,
      "text": "Let's use ear drops, three times a day, for five days. That's for wax softening. Please don't use cotton buds or ear candles, they push the wax in further. Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.63,
      "end_seconds": 335.45,
      "duration_seconds": 1.82,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.91,
      "end_seconds": 340.06,
      "duration_seconds": 3.15,
      "text": "I'll want another look in a week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.5,
      "end_seconds": 346.15,
      "duration_seconds": 4.65,
      "text": "Okay, so I'll book it on my way out."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.03,
      "end_seconds": 349.92,
      "duration_seconds": 2.89,
      "text": "Right, have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.42,
      "end_seconds": 356.53,
      "duration_seconds": 3.11,
      "text": "I think I understand everything. Thanks."
    }
  ]
}