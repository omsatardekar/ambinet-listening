{
  "schema_version": "1.0",
  "encounter_id": "01108",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.72,
      "end_seconds": 2.52,
      "duration_seconds": 1.8,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.05,
      "end_seconds": 6.98,
      "duration_seconds": 2.93,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 8.63,
      "end_seconds": 13.95,
      "duration_seconds": 5.32,
      "text": "hello, doctor, I came in with them, if that's okay"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.52,
      "end_seconds": 17.11,
      "duration_seconds": 2.59,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 19.12,
      "end_seconds": 22.95,
      "duration_seconds": 3.83,
      "text": "She's been having an itch down below, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.15,
      "end_seconds": 27.0,
      "duration_seconds": 2.85,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.21,
      "end_seconds": 31.96,
      "duration_seconds": 3.75,
      "text": "it's been ten days, I'm fairly sure"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.51,
      "end_seconds": 37.09,
      "duration_seconds": 3.58,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.56,
      "end_seconds": 50.77,
      "duration_seconds": 12.21,
      "text": "mostly moderate i've had a thick white discharge too, for ten days i had pain when passing urine before that's settled now, um, though"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 51.71,
      "end_seconds": 66.25,
      "duration_seconds": 14.54,
      "text": "Doctor, I've got the readings for you. Weight 70 kilos, blood pressure 128 over 79, height 167 centimetres, pulse is 80 beats a minute, BMI works out to 25.1, saturation 98 percent, temperature 36.9."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.56,
      "end_seconds": 68.52,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.37,
      "end_seconds": 73.27,
      "duration_seconds": 2.9,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.8,
      "end_seconds": 76.89,
      "duration_seconds": 2.09,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.24,
      "end_seconds": 79.49,
      "duration_seconds": 1.25,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.82,
      "end_seconds": 102.19,
      "duration_seconds": 7.37,
      "text": "there is a thick white discharge with redness of the vulva and and no ulcers"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.29,
      "end_seconds": 107.91,
      "duration_seconds": 1.62,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.9,
      "end_seconds": 125.51,
      "duration_seconds": 5.61,
      "text": "Let me check a few things. Any smell, bleeding between periods or pelvic pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.13,
      "end_seconds": 132.08,
      "duration_seconds": 4.95,
      "text": "I mean, um, no, not a a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 133.15,
      "end_seconds": 136.07,
      "duration_seconds": 2.92,
      "text": "Okay, and fever, any of that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.05,
      "end_seconds": 138.43,
      "duration_seconds": 1.38,
      "text": "Definitely no fever."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 139.54,
      "end_seconds": 144.63,
      "duration_seconds": 5.09,
      "text": "Actually, doctor, I did notice fever. She doesn't always say."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 153.14,
      "duration_seconds": 7.3,
      "text": "no, um, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.98,
      "end_seconds": 163.54,
      "duration_seconds": 9.56,
      "text": "Alright, I'll note both what you've said and what you've noticed. Let me check a few things. Any being pregnant or new partner?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.36,
      "end_seconds": 167.99,
      "duration_seconds": 2.63,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.42,
      "end_seconds": 172.44,
      "duration_seconds": 3.02,
      "text": "Right, is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.41,
      "end_seconds": 176.17,
      "duration_seconds": 1.76,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.74,
      "end_seconds": 178.8,
      "duration_seconds": 2.06,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.74,
      "end_seconds": 183.64,
      "duration_seconds": 2.9,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.78,
      "end_seconds": 189.56,
      "duration_seconds": 4.78,
      "text": "Okay, what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.19,
      "end_seconds": 192.64,
      "duration_seconds": 2.45,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.69,
      "end_seconds": 195.11,
      "duration_seconds": 1.42,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.98,
      "end_seconds": 197.72,
      "duration_seconds": 1.74,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.64,
      "end_seconds": 201.36,
      "duration_seconds": 1.72,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 202.31,
      "end_seconds": 203.86,
      "duration_seconds": 1.55,
      "text": "Nothing, I'm teetotal"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.63,
      "end_seconds": 205.82,
      "duration_seconds": 1.19,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.88,
      "end_seconds": 211.13,
      "duration_seconds": 3.25,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.64,
      "end_seconds": 214.9,
      "duration_seconds": 2.26,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.11,
      "end_seconds": 221.84,
      "duration_seconds": 3.73,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.31,
      "end_seconds": 226.88,
      "duration_seconds": 3.57,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.86,
      "end_seconds": 240.28,
      "duration_seconds": 12.42,
      "text": "Mm, um, I had a reaction to diclofenac when I was younger, swelling of my lips, and I've avoided it since."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.34,
      "end_seconds": 246.07,
      "duration_seconds": 4.73,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.08,
      "end_seconds": 272.94,
      "duration_seconds": 25.86,
      "text": "Glimepiride, 2 milligrams, before breakfast. Telmisartan, 40 milligrams, once a day. I'd rather know what's going on than keep guessing. A neighbour of mine said I should see someone about it. Bisoprolol, 2.5 milligrams, once a day for the heart rhythm. Febuxostat, 80 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.75,
      "end_seconds": 279.14,
      "duration_seconds": 4.39,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.72,
      "end_seconds": 286.95,
      "duration_seconds": 7.23,
      "text": "no, it's at home i had metoprolol at one point, but I'm off it now"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.88,
      "end_seconds": 311.04,
      "duration_seconds": 6.16,
      "text": "Has anyone ever diagnosed you with something? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.89,
      "end_seconds": 315.98,
      "duration_seconds": 4.09,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.76,
      "end_seconds": 318.51,
      "duration_seconds": 0.75,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.03,
      "end_seconds": 332.37,
      "duration_seconds": 13.34,
      "text": "I have high blood pressure, for about a year. I told myself I'd wait and see, and here I am. I've got an irregular heartbeat"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.03,
      "end_seconds": 335.71,
      "duration_seconds": 1.68,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 336.75,
      "end_seconds": 338.82,
      "duration_seconds": 2.07,
      "text": "I've had gout, yes."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.19,
      "end_seconds": 364.61,
      "duration_seconds": 24.42,
      "text": "Yes, diabetes and high blood pressure are known to us, good to have that clear. Okay, thinking it through, this looks most like vaginal thrush. A urine infection is still possible. Bacterial vaginosis is still possible. Let me just check I've got this right. You've had an itch down below for ten days, moderate, and no new partner."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 366.17,
      "end_seconds": 366.87,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 367.84,
      "end_seconds": 374.05,
      "duration_seconds": 6.21,
      "text": "Doctor, I did a urine test before they came in, the result's on your screen."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.5,
      "end_seconds": 382.01,
      "duration_seconds": 6.51,
      "text": "Great, that's useful. I'm sending you for a swab because of vaginal discharge."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 382.66,
      "end_seconds": 385.88,
      "duration_seconds": 3.22,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.65,
      "end_seconds": 394.89,
      "duration_seconds": 7.24,
      "text": "Let's use clotrimazole pessary, 500 milligrams, once at night, for one day. It's for thrush."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 396.88,
      "end_seconds": 398.44,
      "duration_seconds": 1.56,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.21,
      "end_seconds": 412.43,
      "duration_seconds": 12.22,
      "text": "Wear cotton underwear and avoid scented soaps or washes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 413.82,
      "end_seconds": 417.09,
      "duration_seconds": 3.27,
      "text": "Um, that's fine by me."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.19,
      "end_seconds": 433.49,
      "duration_seconds": 14.3,
      "text": "please don't wait if the symptoms get worse that's when to be seen urgently see me again if it isn't better in a week does all of that make sense?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 434.31,
      "end_seconds": 437.2,
      "duration_seconds": 2.89,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 438.13,
      "end_seconds": 440.0,
      "duration_seconds": 1.87,
      "text": "Have a good day."
    }
  ]
}