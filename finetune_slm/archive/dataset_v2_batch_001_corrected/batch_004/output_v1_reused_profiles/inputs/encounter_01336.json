{
  "schema_version": "1.0",
  "encounter_id": "01336",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 2.74,
      "duration_seconds": 2.07,
      "text": "Right, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.71,
      "end_seconds": 5.77,
      "duration_seconds": 1.06,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 6.38,
      "end_seconds": 12.97,
      "duration_seconds": 6.59,
      "text": "Good afternoon, you know, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.42,
      "end_seconds": 21.97,
      "duration_seconds": 7.55,
      "text": "That's fine, sit down. We'll go through it together. What would you like to start with today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.17,
      "end_seconds": 25.55,
      "duration_seconds": 2.38,
      "text": "I've been feeling very thirsty."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 29.76,
      "end_seconds": 42.44,
      "duration_seconds": 12.68,
      "text": "Doctor, I've got the readings for you. Weight 57 kilos, BP is 110 over 70, BMI works out to 21.5. Height 163 centimetres, heart rate 73."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.28,
      "end_seconds": 46.63,
      "duration_seconds": 3.35,
      "text": "Good, thank you. Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 48.1,
      "end_seconds": 50.53,
      "duration_seconds": 2.43,
      "text": "It's been five days now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.53,
      "end_seconds": 54.95,
      "duration_seconds": 3.42,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 55.77,
      "end_seconds": 57.45,
      "duration_seconds": 1.68,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.57,
      "end_seconds": 60.97,
      "duration_seconds": 2.4,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.7,
      "end_seconds": 67.64,
      "duration_seconds": 4.94,
      "text": "Uh, it settles a little with drinking water."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.38,
      "end_seconds": 71.46,
      "duration_seconds": 3.08,
      "text": "Have you been losing weight without trying?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.28,
      "end_seconds": 75.09,
      "duration_seconds": 1.81,
      "text": "Yeah, that too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.71,
      "end_seconds": 79.37,
      "duration_seconds": 3.66,
      "text": "Have you had itching around the private area?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.19,
      "end_seconds": 97.32,
      "duration_seconds": 17.13,
      "text": "Yeah. Four weeks, I'd say. As for itching around the private area, it feels mild to me. I'd say a couple of times a week. I've also had tiredness, for two months."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.17,
      "end_seconds": 104.81,
      "duration_seconds": 5.64,
      "text": "A few quick ones: fruity smell on the breath, fever or blurred vision?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.83,
      "end_seconds": 112.93,
      "duration_seconds": 6.1,
      "text": "No, no fruity smell on the breath, fever or blurred vision."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.99,
      "end_seconds": 118.54,
      "duration_seconds": 3.55,
      "text": "A few quick ones: abdominal pain or breathlessness?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.98,
      "end_seconds": 126.12,
      "duration_seconds": 3.14,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.43,
      "end_seconds": 131.52,
      "duration_seconds": 4.09,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.17,
      "end_seconds": 134.52,
      "duration_seconds": 2.35,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.02,
      "end_seconds": 138.65,
      "duration_seconds": 2.63,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.21,
      "end_seconds": 152.76,
      "duration_seconds": 13.55,
      "text": "Febuxostat, 80 milligrams, once a day. It's metoprolol, 50 milligrams, twice a day for my heart. I take naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 153.66,
      "end_seconds": 159.0,
      "duration_seconds": 5.34,
      "text": "Doctor, our chart from the last visit lists it as 500 milligrams."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.2,
      "end_seconds": 164.57,
      "duration_seconds": 4.37,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.81,
      "end_seconds": 169.57,
      "duration_seconds": 3.76,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.46,
      "end_seconds": 181.07,
      "duration_seconds": 3.61,
      "text": "So, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.94,
      "end_seconds": 188.56,
      "duration_seconds": 5.62,
      "text": "Yeah, just a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.89,
      "end_seconds": 206.86,
      "duration_seconds": 3.97,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.91,
      "end_seconds": 209.96,
      "duration_seconds": 1.05,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.63,
      "end_seconds": 213.32,
      "duration_seconds": 1.69,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.23,
      "end_seconds": 220.85,
      "duration_seconds": 5.62,
      "text": "Heart failure, for nearly five years. Yes, arthritis in my knees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.21,
      "end_seconds": 236.53,
      "duration_seconds": 11.32,
      "text": "Mm, okay. Yes, gout and arthritis in your knees are known to us, good to have that clear. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.46,
      "end_seconds": 249.2,
      "duration_seconds": 10.74,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.06,
      "end_seconds": 253.89,
      "duration_seconds": 2.83,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 255.42,
      "end_seconds": 258.76,
      "duration_seconds": 3.34,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 260.66,
      "end_seconds": 263.47,
      "duration_seconds": 2.81,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.64,
      "end_seconds": 271.1,
      "duration_seconds": 3.46,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.51,
      "end_seconds": 277.37,
      "duration_seconds": 3.86,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.7,
      "end_seconds": 279.87,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.23,
      "end_seconds": 300.77,
      "duration_seconds": 2.54,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.32,
      "end_seconds": 304.35,
      "duration_seconds": 2.03,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.61,
      "end_seconds": 319.19,
      "duration_seconds": 4.58,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 320.63,
      "end_seconds": 321.33,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.91,
      "end_seconds": 327.67,
      "duration_seconds": 1.76,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.7,
      "end_seconds": 349.84,
      "duration_seconds": 15.14,
      "text": "Right, here's what I'm thinking. The most likely explanation is possible new-onset diabetes. I want to be honest that this is an impression, not a final answer. A urine infection is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 350.92,
      "end_seconds": 355.41,
      "duration_seconds": 4.49,
      "text": "I've already done a blood sugar test, it's ready for you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 357.11,
      "end_seconds": 368.66,
      "duration_seconds": 11.55,
      "text": "Right, thank you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 370.39,
      "end_seconds": 372.56,
      "duration_seconds": 2.17,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.09,
      "end_seconds": 382.49,
      "duration_seconds": 9.4,
      "text": "I don't need to add any tests or treatment at this point. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 383.56,
      "end_seconds": 385.55,
      "duration_seconds": 1.99,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.53,
      "end_seconds": 388.74,
      "duration_seconds": 1.21,
      "text": "All the best."
    }
  ]
}