{
  "schema_version": "1.0",
  "encounter_id": "01014",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.17,
      "end_seconds": 5.15,
      "duration_seconds": 3.98,
      "text": "Evening. Let's get started. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.89,
      "end_seconds": 12.94,
      "duration_seconds": 6.05,
      "text": "So, you know, I've been passing out once last week, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 14.68,
      "end_seconds": 22.62,
      "duration_seconds": 7.94,
      "text": "Doctor, I've got the readings for you. Heart rate 71, temp 36.8 degrees, blood pressure 128 over 79."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.59,
      "end_seconds": 27.3,
      "duration_seconds": 3.71,
      "text": "Okay, noted. How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.27,
      "end_seconds": 32.57,
      "duration_seconds": 3.3,
      "text": "It's been one week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.03,
      "end_seconds": 36.36,
      "duration_seconds": 2.33,
      "text": "Have you had blurred vision beforehand?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.18,
      "end_seconds": 40.39,
      "duration_seconds": 2.21,
      "text": "Yes, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.97,
      "end_seconds": 47.93,
      "duration_seconds": 6.96,
      "text": "Let me check a few things. Any chest pain, tongue biting or loss of bladder control?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.36,
      "end_seconds": 51.58,
      "duration_seconds": 2.22,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.9,
      "end_seconds": 56.13,
      "duration_seconds": 3.23,
      "text": "Have you had any shaking or jerking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.16,
      "end_seconds": 59.5,
      "duration_seconds": 2.34,
      "text": "Definitely no shaking or jerking."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.49,
      "end_seconds": 64.21,
      "duration_seconds": 3.72,
      "text": "anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.17,
      "end_seconds": 69.11,
      "duration_seconds": 0.94,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.81,
      "end_seconds": 88.16,
      "duration_seconds": 3.35,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.81,
      "end_seconds": 92.26,
      "duration_seconds": 3.45,
      "text": "It's hydrochlorothiazide, 12.5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.24,
      "end_seconds": 97.16,
      "duration_seconds": 2.92,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.94,
      "end_seconds": 101.04,
      "duration_seconds": 2.1,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.54,
      "end_seconds": 102.3,
      "duration_seconds": 0.76,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.8,
      "end_seconds": 111.83,
      "duration_seconds": 8.03,
      "text": "I take apixaban, 5 milligrams, twice a day. It's Thyronorm, 50 micrograms, maybe, every morning."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.85,
      "end_seconds": 118.67,
      "duration_seconds": 4.82,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.41,
      "end_seconds": 123.48,
      "duration_seconds": 3.07,
      "text": "No, uh, it's at home."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.47,
      "end_seconds": 133.98,
      "duration_seconds": 4.51,
      "text": "Let's talk a a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.57,
      "end_seconds": 144.62,
      "duration_seconds": 10.05,
      "text": "I'm vegetarian and have been for years. I live with my elderly mother. I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.33,
      "end_seconds": 158.46,
      "duration_seconds": 3.13,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.05,
      "end_seconds": 166.89,
      "duration_seconds": 3.84,
      "text": "I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.48,
      "end_seconds": 169.3,
      "duration_seconds": 0.82,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.41,
      "end_seconds": 175.15,
      "duration_seconds": 4.74,
      "text": "I've had an irregular heartbeat, yes. Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.15,
      "end_seconds": 180.58,
      "duration_seconds": 4.43,
      "text": "Alright, an irregular heartbeat, that matches what I have here."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.9,
      "end_seconds": 200.68,
      "duration_seconds": 4.78,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.35,
      "end_seconds": 207.33,
      "duration_seconds": 5.98,
      "text": "Nickel. I come out in... well, a rash on my skin."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.24,
      "end_seconds": 214.12,
      "duration_seconds": 4.88,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.0,
      "end_seconds": 217.0,
      "duration_seconds": 2.0,
      "text": "right, nearly finished here"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.18,
      "end_seconds": 228.76,
      "duration_seconds": 1.58,
      "text": "No murmurs on listening."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.54,
      "end_seconds": 233.14,
      "duration_seconds": 2.6,
      "text": "I'll listen to your chest now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.98,
      "end_seconds": 259.15,
      "duration_seconds": 7.17,
      "text": "Your pulse is regular and there's a small bruise on the right side of the head."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.0,
      "end_seconds": 278.61,
      "duration_seconds": 13.61,
      "text": "That's the examination finished. Right, here's what I'm thinking. I think we're dealing with a simple faint, probably reflex-related at this stage. I'm going to order an echocardiogram, for syncope."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 280.36,
      "end_seconds": 281.62,
      "duration_seconds": 1.26,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.34,
      "end_seconds": 289.73,
      "duration_seconds": 7.39,
      "text": "drink enough water and avoid standing still for long stretches, and sit if you feel it coming"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.08,
      "end_seconds": 299.72,
      "duration_seconds": 9.64,
      "text": "Yes, carry on. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.37,
      "end_seconds": 302.97,
      "duration_seconds": 1.6,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.03,
      "end_seconds": 308.62,
      "duration_seconds": 3.59,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.32,
      "end_seconds": 318.17,
      "duration_seconds": 4.85,
      "text": "Sorry, what was I saying, thank you, that's helpful."
    }
  ]
}