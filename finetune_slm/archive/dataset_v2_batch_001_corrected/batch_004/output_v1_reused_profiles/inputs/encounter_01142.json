{
  "schema_version": "1.0",
  "encounter_id": "01142",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 9.19,
      "duration_seconds": 8.45,
      "text": "Hmm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 13.98,
      "end_seconds": 17.85,
      "duration_seconds": 3.87,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.69,
      "end_seconds": 24.82,
      "duration_seconds": 5.13,
      "text": "Doctor, it's heavy periods. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.74,
      "end_seconds": 29.54,
      "duration_seconds": 3.8,
      "text": "So, can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.17,
      "end_seconds": 33.77,
      "duration_seconds": 3.6,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.38,
      "end_seconds": 38.09,
      "duration_seconds": 2.71,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.16,
      "end_seconds": 60.21,
      "duration_seconds": 20.05,
      "text": "Being breathless on the stairs goes along with it, most of the time. Actually, and I've been looking pale as well, for about a year. Right, the being breathless on the stairs? That's been for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.78,
      "end_seconds": 64.09,
      "duration_seconds": 3.31,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.01,
      "end_seconds": 81.23,
      "duration_seconds": 15.22,
      "text": "I quit smoking around ten years ago. I only drink at family occasions. Yes, I work in a bakery, early starts. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.01,
      "end_seconds": 85.79,
      "duration_seconds": 2.78,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.49,
      "end_seconds": 89.52,
      "duration_seconds": 2.03,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.09,
      "end_seconds": 92.42,
      "duration_seconds": 2.33,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.72,
      "end_seconds": 98.11,
      "duration_seconds": 4.39,
      "text": "I've had epilepsy, yes. I've got heart failure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.64,
      "end_seconds": 107.11,
      "duration_seconds": 7.47,
      "text": "Hm, okay. Alright, yes, heart failure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.68,
      "end_seconds": 121.52,
      "duration_seconds": 1.84,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.13,
      "end_seconds": 127.19,
      "duration_seconds": 5.06,
      "text": "Well, you know, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.64,
      "end_seconds": 132.56,
      "duration_seconds": 3.92,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.54,
      "end_seconds": 138.77,
      "duration_seconds": 4.23,
      "text": "Let me think, I've never had an allergy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.78,
      "end_seconds": 147.63,
      "duration_seconds": 6.85,
      "text": "Which medicines do you take at the moment? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.67,
      "end_seconds": 154.21,
      "duration_seconds": 5.54,
      "text": "It's carvedilol, 6.25 milligrams, maybe, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.63,
      "end_seconds": 158.54,
      "duration_seconds": 2.91,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.27,
      "end_seconds": 163.24,
      "duration_seconds": 3.97,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.04,
      "end_seconds": 179.34,
      "duration_seconds": 6.3,
      "text": "Let me check a few things. Any fainting, chest pain or pelvic pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.42,
      "end_seconds": 188.3,
      "duration_seconds": 7.88,
      "text": "Sorry, what was I saying, no, no fainting, chest pain or pelvic pain."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.71,
      "end_seconds": 191.14,
      "duration_seconds": 1.43,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.23,
      "end_seconds": 194.78,
      "duration_seconds": 1.55,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.88,
      "end_seconds": 205.05,
      "duration_seconds": 5.17,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.51,
      "end_seconds": 208.1,
      "duration_seconds": 1.59,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.28,
      "end_seconds": 223.74,
      "duration_seconds": 3.46,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.81,
      "end_seconds": 239.68,
      "duration_seconds": 2.87,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.3,
      "end_seconds": 258.92,
      "duration_seconds": 9.62,
      "text": "Okay: heart rate 66, temperature 36.8, SpO2 97 percent on room air. And blood pressure 127 over 80."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.7,
      "end_seconds": 262.28,
      "duration_seconds": 1.58,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.34,
      "end_seconds": 267.01,
      "duration_seconds": 2.67,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.44,
      "end_seconds": 272.16,
      "duration_seconds": 2.72,
      "text": "Okay, may I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.62,
      "end_seconds": 275.81,
      "duration_seconds": 2.19,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.48,
      "end_seconds": 291.45,
      "duration_seconds": 3.97,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.2,
      "end_seconds": 305.38,
      "duration_seconds": 11.18,
      "text": "Okay, that's enough for me. Putting it all together, it fits best with heavy periods with iron deficiency. I'd also keep a thyroid problem in mind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.23,
      "end_seconds": 310.87,
      "duration_seconds": 3.64,
      "text": "Mm, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.51,
      "end_seconds": 338.02,
      "duration_seconds": 25.51,
      "text": "Nothing I've seen today points to an emergency. It looks like heavy periods with iron deficiency. Iron can darken the stools and bother the stomach, so take it after food. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.73,
      "end_seconds": 341.01,
      "duration_seconds": 2.28,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}