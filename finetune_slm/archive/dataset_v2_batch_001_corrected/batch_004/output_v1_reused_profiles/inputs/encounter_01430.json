{
  "schema_version": "1.0",
  "encounter_id": "01430",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.74,
      "end_seconds": 7.55,
      "duration_seconds": 6.81,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.88,
      "end_seconds": 14.46,
      "duration_seconds": 3.58,
      "text": "okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 15.04,
      "end_seconds": 21.16,
      "duration_seconds": 6.12,
      "text": "Uh, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.06,
      "end_seconds": 25.37,
      "duration_seconds": 3.31,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 26.25,
      "end_seconds": 33.79,
      "duration_seconds": 7.54,
      "text": "Oh, you know, it's irregular periods, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.77,
      "end_seconds": 37.71,
      "duration_seconds": 2.94,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 39.44,
      "end_seconds": 41.5,
      "duration_seconds": 2.06,
      "text": "Probably three days. Yeah."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.37,
      "end_seconds": 50.28,
      "duration_seconds": 7.91,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 50.38,
      "end_seconds": 55.81,
      "duration_seconds": 5.43,
      "text": "tell the doctor about the other thing, that's what worries me"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.85,
      "end_seconds": 68.9,
      "duration_seconds": 11.05,
      "text": "Let me think, um, I was getting to that! I've also had night sweats, for two days."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.72,
      "end_seconds": 75.65,
      "duration_seconds": 2.93,
      "text": "is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 80.65,
      "end_seconds": 88.3,
      "duration_seconds": 7.65,
      "text": "Honestly, a few times a day. I've also had hot flushes, since this morning."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.25,
      "end_seconds": 93.19,
      "duration_seconds": 2.94,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.85,
      "end_seconds": 98.51,
      "duration_seconds": 4.66,
      "text": "Erm, I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.55,
      "end_seconds": 102.41,
      "duration_seconds": 2.86,
      "text": "okay, is it worse at certain times?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 103.09,
      "end_seconds": 106.64,
      "duration_seconds": 3.55,
      "text": "Well, it's worse with warm rooms."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 107.99,
      "end_seconds": 112.13,
      "duration_seconds": 4.14,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 129.49,
      "end_seconds": 141.78,
      "duration_seconds": 12.29,
      "text": "Here are the numbers, doctor. Temp 36.5 degrees, pressure 123 over 79, pulse is 83 beats a minute, oxygen saturation is 99 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.68,
      "end_seconds": 144.64,
      "duration_seconds": 1.96,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.04,
      "end_seconds": 148.67,
      "duration_seconds": 2.63,
      "text": "Right, may I examine you now?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 150.33,
      "end_seconds": 151.39,
      "duration_seconds": 1.06,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.54,
      "end_seconds": 154.62,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.76,
      "end_seconds": 173.5,
      "duration_seconds": 5.74,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.32,
      "end_seconds": 183.33,
      "duration_seconds": 5.01,
      "text": "Please sit back down. Any breast lumps or heavy bleeding at all?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 184.87,
      "end_seconds": 190.09,
      "duration_seconds": 5.22,
      "text": "No breast lumps or heavy bleeding, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.97,
      "end_seconds": 192.24,
      "duration_seconds": 1.27,
      "text": "Nothing like palpitations?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 193.41,
      "end_seconds": 199.64,
      "duration_seconds": 6.23,
      "text": "Okay, um, so no, I haven't had any palpitations."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 200.5,
      "end_seconds": 206.4,
      "duration_seconds": 5.9,
      "text": "Actually, doctor, I did notice palpitations. She doesn't always say."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 207.02,
      "end_seconds": 215.65,
      "duration_seconds": 8.63,
      "text": "no, you know, I don't think I did. Maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.22,
      "end_seconds": 226.34,
      "duration_seconds": 9.12,
      "text": "Alright, I'll note both what you've said and what you've noticed. And what about weight loss, chest pain or bleeding after sex?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 228.0,
      "end_seconds": 234.46,
      "duration_seconds": 6.46,
      "text": "No weight loss, chest pain or bleeding after sex, none of it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.48,
      "end_seconds": 240.21,
      "duration_seconds": 3.73,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 241.84,
      "end_seconds": 247.02,
      "duration_seconds": 5.18,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.08,
      "end_seconds": 250.48,
      "duration_seconds": 2.4,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 252.52,
      "end_seconds": 255.95,
      "duration_seconds": 3.43,
      "text": "No, you know, skin's been fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.54,
      "end_seconds": 260.65,
      "duration_seconds": 3.11,
      "text": "What operations have you had, if any?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 266.48,
      "end_seconds": 274.34,
      "duration_seconds": 7.86,
      "text": "I, I had a cataract operation in my left eye about a year ago."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.38,
      "end_seconds": 280.35,
      "duration_seconds": 3.97,
      "text": "so, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 286.07,
      "end_seconds": 289.04,
      "duration_seconds": 2.97,
      "text": "I have an underactive thyroid"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.98,
      "end_seconds": 291.68,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 293.56,
      "end_seconds": 298.55,
      "duration_seconds": 4.99,
      "text": "I've got high blood pressure. Thin bones, for five years."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.5,
      "end_seconds": 306.14,
      "duration_seconds": 5.64,
      "text": "yes, thin bones is known to us, good to have that clear"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.42,
      "end_seconds": 321.12,
      "duration_seconds": 4.7,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 321.74,
      "end_seconds": 325.78,
      "duration_seconds": 4.04,
      "text": "Not to my knowledge, uh, no."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.35,
      "end_seconds": 330.2,
      "duration_seconds": 3.85,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 330.93,
      "end_seconds": 338.18,
      "duration_seconds": 7.25,
      "text": "Yeah, my daughter has type 1 diabetes. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.82,
      "end_seconds": 341.93,
      "duration_seconds": 3.11,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 343.51,
      "end_seconds": 355.31,
      "duration_seconds": 11.8,
      "text": "I take Eltroxin, 100 micrograms, every morning. I'm on something called lisi... lisinopril, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.57,
      "end_seconds": 360.65,
      "duration_seconds": 4.08,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 361.67,
      "end_seconds": 370.57,
      "duration_seconds": 8.9,
      "text": "So, um, no, it's at home. Alendronate. I take it 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 371.23,
      "end_seconds": 381.23,
      "duration_seconds": 10.0,
      "text": "I mean, doctor, I think the last prescription for the alendronate was 140 milligrams. We changed it at the last visit"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.89,
      "end_seconds": 388.53,
      "duration_seconds": 5.64,
      "text": "okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 389.5,
      "end_seconds": 393.39,
      "duration_seconds": 3.89,
      "text": "I don't think I have it with me."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.67,
      "end_seconds": 395.84,
      "duration_seconds": 1.17,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 400.04,
      "end_seconds": 402.96,
      "duration_seconds": 2.92,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.94,
      "end_seconds": 406.12,
      "duration_seconds": 2.18,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 407.74,
      "end_seconds": 412.25,
      "duration_seconds": 4.51,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.97,
      "end_seconds": 427.47,
      "duration_seconds": 14.5,
      "text": "right, here's what I'm thinking this is probably perimenopausal symptoms we shouldn't forget anaemia just to be sure I understood you've had irregular periods for three days, and no breast lumps"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 432.3,
      "end_seconds": 435.54,
      "duration_seconds": 3.24,
      "text": "Yes, uh, you've got it."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 437.59,
      "end_seconds": 468.48,
      "duration_seconds": 30.89,
      "text": "I think blood tests makes sense here, for irregular periods. I think a bone density scan makes sense here, for menopause. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Cut down on salt and fried food for now, it really does make a difference. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 469.48,
      "end_seconds": 473.16,
      "duration_seconds": 3.68,
      "text": "yeah, I know what to watch for"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 474.85,
      "end_seconds": 486.1,
      "duration_seconds": 11.25,
      "text": "If it hasn't settled in a month, we'd think about a thyroid test, but not now. If the symptoms get worse, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 486.76,
      "end_seconds": 489.52,
      "duration_seconds": 2.76,
      "text": "Yes, uh, will do."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 491.14,
      "end_seconds": 495.86,
      "duration_seconds": 4.72,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 496.72,
      "end_seconds": 500.54,
      "duration_seconds": 3.82,
      "text": "Alright, you know, thanks, take care."
    }
  ]
}