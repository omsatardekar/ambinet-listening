    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.64,
      "end_seconds": 11.0,
      "duration_seconds": 1.36,
      "text": "what's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 19.74,
      "duration_seconds": 6.84,
      "text": "doctor, it's a strange episode where I blanked out it's getting on my nerves now"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.93,
      "end_seconds": 25.33,
      "duration_seconds": 4.4,
      "text": "When was the the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.13,
      "end_seconds": 40.54,
      "duration_seconds": 13.41,
      "text": "it's, It's been going on for about a month my sister suggested writing things down, um, but I forgot i just want to get back to normal, really"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.36,
      "end_seconds": 44.61,
      "duration_seconds": 2.25,
      "text": "have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 45.73,
      "end_seconds": 50.08,
      "duration_seconds": 4.35,
      "text": "I notice it it more with lack of sleep"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.98,
      "end_seconds": 54.74,
      "duration_seconds": 2.76,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.64,
      "end_seconds": 58.19,
      "duration_seconds": 1.55,
      "text": "it's mild, honestly"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.49,
      "end_seconds": 59.56,
      "duration_seconds": 1.07,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.18,
      "end_seconds": 69.53,
      "duration_seconds": 9.35,
      "text": "And I've been feeling groggy afterwards as well. I had staring spells that others noticed before. That's settled now, though."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.98,
      "end_seconds": 86.99,
      "duration_seconds": 2.01,
      "text": "Any tongue biting or fever?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.7,
      "end_seconds": 91.29,
      "duration_seconds": 2.59,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.2,
      "end_seconds": 99.84,
      "duration_seconds": 6.64,
      "text": "Any alcohol before it, losing control of the bladder or jerking movements at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.03,
      "end_seconds": 103.48,
      "duration_seconds": 2.45,
      "text": "no, I'd have said so"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.55,
      "end_seconds": 108.24,
      "duration_seconds": 2.69,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.22,
      "end_seconds": 110.16,
      "duration_seconds": 0.94,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 114.95,
      "duration_seconds": 2.73,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.78,
      "end_seconds": 117.86,
      "duration_seconds": 2.08,
