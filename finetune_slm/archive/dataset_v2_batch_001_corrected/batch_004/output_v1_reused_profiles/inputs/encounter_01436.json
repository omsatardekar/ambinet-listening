    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.62,
      "end_seconds": 122.59,
      "duration_seconds": 3.97,
      "text": "Are there any allergies I should be aware of?"
