    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.11,
      "end_seconds": 127.38,
      "duration_seconds": 3.27,
      "text": "No I've never reacted to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.97,
      "end_seconds": 142.43,
      "duration_seconds": 4.46,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.64,
      "end_seconds": 145.84,
      "duration_seconds": 2.2,
      "text": "Anxiety for two years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.66,
      "end_seconds": 153.29,
      "duration_seconds": 6.63,
      "text": "Okay yes anxiety is known to us good to have that clear. Any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.33,
      "end_seconds": 163.39,
      "duration_seconds": 4.06,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 168.01,
      "duration_seconds": 2.82,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.81,
      "end_seconds": 174.17,
      "duration_seconds": 4.36,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.81,
      "end_seconds": 179.97,
      "duration_seconds": 4.16,
      "text": "what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.9,
      "end_seconds": 184.32,
      "duration_seconds": 3.42,
      "text": "Lots of rice, lentils and some fruit"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.16,
      "end_seconds": 187.44,
      "duration_seconds": 1.28,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.99,
      "end_seconds": 196.28,
      "duration_seconds": 3.29,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.17,
      "end_seconds": 200.11,
      "duration_seconds": 2.94,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.94,
      "end_seconds": 206.28,
      "duration_seconds": 4.34,
      "text": "I had my septum straightened in my thirties"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.98,
      "end_seconds": 212.23,
      "duration_seconds": 3.25,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.16,
      "end_seconds": 221.17,
      "duration_seconds": 8.01,
      "text": "I take escitalopram, 10 milligrams, once a day. Though honestly, some days I forget to take it"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.72,
      "end_seconds": 224.2,
      "duration_seconds": 2.48,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.85,
      "end_seconds": 237.76,
      "duration_seconds": 2.91,
      "text": "that's it just a little longer.."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.5,
      "end_seconds": 265.2,
      "duration_seconds": 8.7,
      "text": "Okay: BP is 115 over 78, SpO2 99 percent on room air, temperature 36.9, pulse is 76 beats a minute."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.76,
      "end_seconds": 269.73,
      "duration_seconds": 2.97,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.74,
      "end_seconds": 272.89,
      "duration_seconds": 2.15,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.49,
      "end_seconds": 287.95,
      "duration_seconds": 2.46,
      "text": "Coordination is normal on finger-to-nose testing"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.85,
      "end_seconds": 292.79,
      "duration_seconds": 2.94,
      "text": "Hold that for a a second."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.9,
      "end_seconds": 311.83,
      "duration_seconds": 4.93,
      "text": "you're alert, speech is normal and cranial nerves are intact"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.7,
      "end_seconds": 317.62,
      "duration_seconds": 1.92,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.29,
      "end_seconds": 335.15,
      "duration_seconds": 9.86,
      "text": "Taking everything into account I can't pin this down yet. We're looking at a possible focal seizure that needs investigating or a panic episode."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.69,
      "end_seconds": 338.06,
      "duration_seconds": 2.37,
      "text": "Will it it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 341.74,
      "end_seconds": 362.83,
      "duration_seconds": 21.09,
      "text": "it's reasonable to be concerned but right now a possible focal seizure that needs investigating is my leading thought not anything worse. So to recap quickly. You've had a strange episode where you blanked out for about a month mild and no tongue biting or fever"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 363.91,
      "end_seconds": 365.55,
      "duration_seconds": 1.64,
      "text": "yes, that's right"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.14,
      "end_seconds": 383.23,
      "duration_seconds": 16.09,
      "text": "I'll request an MRI of the brain, it'll help with possible seizure. It's a routine test and it'll give us a much clearer picture. I'd like to arrange blood tests for episode of altered awareness."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 385.18,
      "end_seconds": 387.7,
      "duration_seconds": 2.52,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.46,
      "end_seconds": 423.78,
      "duration_seconds": 35.32,
      "text": "don't drive until we've looked into this please take the tablets with food so they don't upset your stomach let's hold off on an EEG for now, and if there's no change next month we can revisit it if you have another episode that lasts more than a few minutes, that's the point to come in urgently i'd like you back after the results are back okay, I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 424.79,
      "end_seconds": 428.28,
      "duration_seconds": 3.49,
      "text": "yeah, no, that's all thanks a lot"
    }
  ]
