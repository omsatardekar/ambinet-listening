{
  "schema_version": "1.0",
  "encounter_id": "01164",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.91,
      "duration_seconds": 4.08,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.79,
      "end_seconds": 10.31,
      "duration_seconds": 4.52,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.37,
      "end_seconds": 16.16,
      "duration_seconds": 4.79,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.14,
      "end_seconds": 21.66,
      "duration_seconds": 3.52,
      "text": "It's a lump in my armpit, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.37,
      "end_seconds": 25.78,
      "duration_seconds": 3.41,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.32,
      "end_seconds": 37.07,
      "duration_seconds": 10.75,
      "text": "I've had it for about a week. A low fever in the evenings was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.24,
      "end_seconds": 45.58,
      "duration_seconds": 7.34,
      "text": "Have you had a lump in your armpit before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.46,
      "end_seconds": 52.66,
      "duration_seconds": 5.2,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.02,
      "end_seconds": 74.88,
      "duration_seconds": 3.86,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.71,
      "end_seconds": 83.51,
      "duration_seconds": 7.8,
      "text": "I had a reaction to diclofenac when I was younger, wheezing, and I've avoided it since."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.77,
      "end_seconds": 101.55,
      "duration_seconds": 2.78,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.08,
      "end_seconds": 106.85,
      "duration_seconds": 4.77,
      "text": "I had part of my thyroid removed years back."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.94,
      "end_seconds": 114.77,
      "duration_seconds": 2.83,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.7,
      "end_seconds": 118.24,
      "duration_seconds": 2.54,
      "text": "My mother had a stroke."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.11,
      "end_seconds": 123.25,
      "duration_seconds": 3.14,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.85,
      "end_seconds": 128.88,
      "duration_seconds": 4.03,
      "text": "Dolo. I take it when I get the fever."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.05,
      "end_seconds": 132.37,
      "duration_seconds": 2.32,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.44,
      "end_seconds": 135.35,
      "duration_seconds": 0.91,
      "text": "650 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.65,
      "end_seconds": 137.91,
      "duration_seconds": 1.26,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.39,
      "end_seconds": 144.05,
      "duration_seconds": 1.66,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.03,
      "end_seconds": 145.94,
      "duration_seconds": 0.91,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.51,
      "end_seconds": 150.51,
      "duration_seconds": 3.0,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.62,
      "end_seconds": 153.72,
      "duration_seconds": 2.1,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.57,
      "end_seconds": 158.88,
      "duration_seconds": 4.31,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.96,
      "end_seconds": 163.92,
      "duration_seconds": 2.96,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.95,
      "end_seconds": 168.33,
      "duration_seconds": 3.38,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.84,
      "end_seconds": 172.66,
      "duration_seconds": 2.82,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.51,
      "end_seconds": 179.44,
      "duration_seconds": 4.93,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.51,
      "end_seconds": 200.4,
      "duration_seconds": 3.89,
      "text": "Okay, any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.03,
      "end_seconds": 207.93,
      "duration_seconds": 2.9,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.45,
      "end_seconds": 213.96,
      "duration_seconds": 4.51,
      "text": "A few quick ones: joint pain, recent travel or chest pain?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.98,
      "end_seconds": 217.69,
      "duration_seconds": 2.71,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.62,
      "end_seconds": 219.8,
      "duration_seconds": 1.18,
      "text": "Any weight loss?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.73,
      "end_seconds": 223.61,
      "duration_seconds": 2.88,
      "text": "Not at all, no weight loss."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.7,
      "end_seconds": 228.48,
      "duration_seconds": 3.78,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.55,
      "end_seconds": 238.58,
      "duration_seconds": 5.03,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.04,
      "end_seconds": 242.62,
      "duration_seconds": 2.58,
      "text": "So, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.39,
      "end_seconds": 246.16,
      "duration_seconds": 1.77,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.93,
      "end_seconds": 250.53,
      "duration_seconds": 2.6,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.67,
      "end_seconds": 252.91,
      "duration_seconds": 1.24,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.29,
      "end_seconds": 274.19,
      "duration_seconds": 5.9,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.96,
      "end_seconds": 293.28,
      "duration_seconds": 15.32,
      "text": "Alright, you can sit up now. Okay, thinking it through, my working impression is an enlarged gland with night sweats that needs a proper work-up. It could also be a lingering infection, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.07,
      "end_seconds": 298.29,
      "duration_seconds": 3.22,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.21,
      "end_seconds": 320.62,
      "duration_seconds": 20.41,
      "text": "Nothing I've seen today points to an emergency. It looks like an enlarged gland with night sweats that needs a proper work-up, but I'd like to confirm. I want a chest X-ray done, that's for night sweats. I want blood tests done, that's for night sweats."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.98,
      "end_seconds": 323.22,
      "duration_seconds": 1.24,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.86,
      "end_seconds": 342.78,
      "duration_seconds": 18.92,
      "text": "Keep a note of your temperature each evening. The thing that would worry me is if the symptoms get worse. If that happens, go to emergency. I'd like you back after the results are back. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.58,
      "end_seconds": 347.77,
      "duration_seconds": 3.19,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.52,
      "end_seconds": 350.7,
      "duration_seconds": 1.18,
      "text": "All the best."
    }
  ]
}