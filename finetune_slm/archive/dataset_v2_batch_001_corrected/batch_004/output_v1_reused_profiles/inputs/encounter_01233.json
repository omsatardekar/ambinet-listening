{
  "schema_version": "1.0",
  "encounter_id": "01233",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.63,
      "end_seconds": 5.92,
      "duration_seconds": 5.29,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.7,
      "end_seconds": 11.34,
      "duration_seconds": 4.64,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 17.21,
      "duration_seconds": 4.55,
      "text": "well, um, I've been having irregular periods"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.53,
      "end_seconds": 21.63,
      "duration_seconds": 3.1,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.52,
      "end_seconds": 26.24,
      "duration_seconds": 2.72,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.29,
      "end_seconds": 31.57,
      "duration_seconds": 3.28,
      "text": "how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.24,
      "end_seconds": 37.93,
      "duration_seconds": 4.69,
      "text": "I'd say severe. Oh, and thinning hair on the scalp."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.63,
      "end_seconds": 53.33,
      "duration_seconds": 4.7,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.17,
      "end_seconds": 62.15,
      "duration_seconds": 2.98,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.01,
      "end_seconds": 79.96,
      "duration_seconds": 4.95,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.61,
      "end_seconds": 92.37,
      "duration_seconds": 11.76,
      "text": "I live with my elderly mother. I hardly move around during the day. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.39,
      "end_seconds": 97.16,
      "duration_seconds": 3.77,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.42,
      "end_seconds": 104.31,
      "duration_seconds": 5.89,
      "text": "I, I take bisoprolol, 2.5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.39,
      "end_seconds": 110.87,
      "duration_seconds": 4.48,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.79,
      "end_seconds": 116.47,
      "duration_seconds": 3.68,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.56,
      "end_seconds": 133.43,
      "duration_seconds": 2.87,
      "text": "Alright, do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.78,
      "end_seconds": 139.91,
      "duration_seconds": 5.13,
      "text": "I've had heart failure, yes. Yes, an irregular heartbeat"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.68,
      "end_seconds": 150.9,
      "duration_seconds": 8.22,
      "text": "Alright, heart failure, that matches what I have here. Right, have you been to theatre before?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.55,
      "end_seconds": 158.37,
      "duration_seconds": 6.82,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.73,
      "end_seconds": 162.07,
      "duration_seconds": 2.34,
      "text": "Have you had any heavy bleeding?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.66,
      "end_seconds": 165.77,
      "duration_seconds": 2.11,
      "text": "No heavy bleeding, thankfully."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.52,
      "end_seconds": 176.94,
      "duration_seconds": 8.42,
      "text": "Let me check a few things. Any pelvic pain, milk from the breasts or headaches with vision changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.98,
      "end_seconds": 187.16,
      "duration_seconds": 8.18,
      "text": "Okay, so I haven't had pelvic pain, milk from the breasts or headaches with vision changes, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.86,
      "end_seconds": 193.09,
      "duration_seconds": 4.23,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.83,
      "end_seconds": 197.41,
      "duration_seconds": 2.58,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.1,
      "end_seconds": 200.44,
      "duration_seconds": 2.34,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.59,
      "end_seconds": 213.88,
      "duration_seconds": 3.29,
      "text": "That's it, just a a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.58,
      "end_seconds": 235.01,
      "duration_seconds": 6.43,
      "text": "Okay: pulse 80, blood pressure 112 over 69, temp 36.7 degrees, saturation 98 percent."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.81,
      "end_seconds": 241.91,
      "duration_seconds": 4.1,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.52,
      "end_seconds": 245.68,
      "duration_seconds": 2.16,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.02,
      "end_seconds": 267.99,
      "duration_seconds": 5.97,
      "text": "Facial acne along the jaw and some dark coarse hair on the chin."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.92,
      "end_seconds": 279.87,
      "duration_seconds": 8.95,
      "text": "Please sit back down. Taking everything into account, I think we're dealing with possible polycystic ovary syndrome at this stage."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.45,
      "end_seconds": 283.27,
      "duration_seconds": 2.82,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.91,
      "end_seconds": 309.63,
      "duration_seconds": 25.72,
      "text": "I understand the worry. At the moment I'd say it's possible polycystic ovary syndrome, and we'll watch how it goes. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Today I'm not changing anything. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.49,
      "end_seconds": 315.34,
      "duration_seconds": 3.85,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.28,
      "end_seconds": 317.93,
      "duration_seconds": 1.65,
      "text": "Have a good day."
    }
  ]
}