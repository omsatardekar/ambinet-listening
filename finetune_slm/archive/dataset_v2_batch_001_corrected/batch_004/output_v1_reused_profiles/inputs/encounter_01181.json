{
  "schema_version": "1.0",
  "encounter_id": "01181",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.92,
      "end_seconds": 3.67,
      "duration_seconds": 2.75,
      "text": "Morning doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.34,
      "end_seconds": 8.51,
      "duration_seconds": 4.17,
      "text": "of course, leave it it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.11,
      "end_seconds": 19.39,
      "duration_seconds": 9.28,
      "text": "it's a painful rash on one side of my chest i thought I'd wait but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.72,
      "end_seconds": 27.0,
      "duration_seconds": 6.28,
      "text": "what's the timeline, when did it begin? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.95,
      "end_seconds": 30.92,
      "duration_seconds": 2.97,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 40.62,
      "duration_seconds": 9.09,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.98,
      "end_seconds": 49.84,
      "duration_seconds": 7.86,
      "text": "Oh, uh, I'd call it mild. I notice it more with clothes rubbing."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.61,
      "end_seconds": 53.72,
      "duration_seconds": 2.11,
      "text": "have you been feeling feverish?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.26,
      "end_seconds": 60.73,
      "duration_seconds": 5.47,
      "text": "sorry, what was I saying, yes, since last weekend"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.02,
      "end_seconds": 67.49,
      "duration_seconds": 2.47,
      "text": "any vision changes, weakness or confusion?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.81,
      "end_seconds": 71.85,
      "duration_seconds": 3.04,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.67,
      "end_seconds": 78.02,
      "duration_seconds": 4.35,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.63,
      "end_seconds": 80.21,
      "duration_seconds": 1.58,
      "text": "nothing unusual, no"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.92,
      "end_seconds": 84.68,
      "duration_seconds": 3.76,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.43,
      "end_seconds": 88.87,
      "duration_seconds": 2.44,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.81,
      "end_seconds": 102.36,
      "duration_seconds": 4.55,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.82,
      "end_seconds": 108.79,
      "duration_seconds": 4.97,
      "text": "yes, nickel i get a rash on my skin"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.74,
      "end_seconds": 130.02,
      "duration_seconds": 2.28,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.46,
      "end_seconds": 135.87,
      "duration_seconds": 4.41,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.97,
      "end_seconds": 138.16,
      "duration_seconds": 1.19,
      "text": "and your job?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.23,
      "end_seconds": 143.71,
      "duration_seconds": 3.48,
      "text": "I work in accounts at a hospital"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.77,
      "end_seconds": 150.36,
      "duration_seconds": 2.59,
      "text": "anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.96,
      "end_seconds": 154.3,
      "duration_seconds": 3.34,
      "text": "I do a yoga class on Thursdays"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.01,
      "end_seconds": 159.23,
      "duration_seconds": 3.22,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.91,
      "end_seconds": 169.04,
      "duration_seconds": 8.13,
      "text": "Amlodipine, 5 milligrams, once a day i take Dolo, 650 milligrams, when I get the pain"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.97,
      "end_seconds": 175.2,
      "duration_seconds": 4.23,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.9,
      "end_seconds": 186.45,
      "duration_seconds": 5.55,
      "text": "I've had high blood pressure for nearly five years now"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.35,
      "end_seconds": 192.81,
      "duration_seconds": 4.46,
      "text": "Right, right. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.56,
      "end_seconds": 208.58,
      "duration_seconds": 2.02,
      "text": "nearly done with the readings.."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.24,
      "end_seconds": 231.04,
      "duration_seconds": 6.8,
      "text": "okay: saturation 98 percent, blood pressure 110 over 76, temp 38.6 degrees, pulse 95."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.01,
      "end_seconds": 236.89,
      "duration_seconds": 2.88,
      "text": "okay, time for me to examine you"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.8,
      "end_seconds": 239.95,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.77,
      "end_seconds": 262.56,
      "duration_seconds": 10.79,
      "text": "There are clustered blisters on a red base in a band across the right side of the chest not crossing the midline."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.36,
      "end_seconds": 270.18,
      "duration_seconds": 2.82,
      "text": "Good you can sit up again."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.67,
      "end_seconds": 291.39,
      "duration_seconds": 5.72,
      "text": "From what you've told me and and what I found, I'd lean towards shingles."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.87,
      "end_seconds": 296.69,
      "duration_seconds": 3.82,
      "text": "mm, is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.83,
      "end_seconds": 307.57,
      "duration_seconds": 9.74,
      "text": "I understand the worry. At the moment I'd say it's shingles, and we'll know more once the a swab from a blister is back"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.3,
      "end_seconds": 350.91,
      "duration_seconds": 27.61,
      "text": "I'd like to arrange a swab from a blister for vesicular rash. That will help us see what's going on underneath and decide the next step. What I'm giving you is aciclovir, 800 milligrams, five times a day, for seven days. That's for shingles. I'll put all of this in writing so you don't have to remember it"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.49,
      "end_seconds": 355.72,
      "duration_seconds": 3.23,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.57,
      "end_seconds": 371.66,
      "duration_seconds": 15.09,
      "text": "Keep the rash clean and dry and avoid contact with pregnant women or newborns until the blisters crust over. I'd like to see you again in one week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 373.36,
      "end_seconds": 377.25,
      "duration_seconds": 3.89,
      "text": "No, you know, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.56,
      "end_seconds": 383.94,
      "duration_seconds": 1.38,
      "text": "see you soon"
    }
  ]
}