{
  "schema_version": "1.0",
  "encounter_id": "01235",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.65,
      "end_seconds": 5.19,
      "duration_seconds": 4.54,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.74,
      "end_seconds": 10.98,
      "duration_seconds": 4.24,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.71,
      "end_seconds": 19.62,
      "duration_seconds": 7.91,
      "text": "Ah, it's a low fever in the evenings. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.9,
      "end_seconds": 23.15,
      "duration_seconds": 2.25,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.01,
      "end_seconds": 25.95,
      "duration_seconds": 1.94,
      "text": "Probably one week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.8,
      "end_seconds": 32.38,
      "duration_seconds": 4.58,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.01,
      "end_seconds": 46.12,
      "duration_seconds": 13.11,
      "text": "I'd say all the time. It's severe, honestly. And a lump in my armpit as well, since this morning. I've also had drenching night sweats."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.78,
      "end_seconds": 49.93,
      "duration_seconds": 3.15,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.74,
      "end_seconds": 69.16,
      "duration_seconds": 18.42,
      "text": "Mostly severe. As for itching all over, I honestly can't say when that began. It might have been last month or the month before. As for itching all over, it happens all the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.45,
      "end_seconds": 78.89,
      "duration_seconds": 2.44,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.37,
      "end_seconds": 82.63,
      "duration_seconds": 2.26,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.5,
      "end_seconds": 87.43,
      "duration_seconds": 2.93,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.67,
      "end_seconds": 91.41,
      "duration_seconds": 2.74,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.2,
      "end_seconds": 104.43,
      "duration_seconds": 11.23,
      "text": "Okay, go on. Okay, I can see high blood pressure in your file as well. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.53,
      "end_seconds": 110.56,
      "duration_seconds": 2.03,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.09,
      "end_seconds": 115.65,
      "duration_seconds": 4.56,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.0,
      "end_seconds": 121.29,
      "duration_seconds": 4.29,
      "text": "Yes, nickel. I get a rash on my skin."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.31,
      "end_seconds": 124.73,
      "duration_seconds": 2.42,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.37,
      "end_seconds": 143.27,
      "duration_seconds": 16.9,
      "text": "I had a bunion operation six years ago. Work has been very busy so I kept ignoring it. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.17,
      "end_seconds": 146.62,
      "duration_seconds": 2.45,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.75,
      "end_seconds": 151.89,
      "duration_seconds": 4.14,
      "text": "Rosuvastatin. I take it at night for my cholesterol."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.71,
      "end_seconds": 154.93,
      "duration_seconds": 2.22,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.71,
      "end_seconds": 160.17,
      "duration_seconds": 4.46,
      "text": "10 milligrams. Losartan, 50 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 161.24,
      "end_seconds": 166.31,
      "duration_seconds": 5.07,
      "text": "Doctor, our chart from the last visit lists it as 25 milligrams."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.83,
      "end_seconds": 172.74,
      "duration_seconds": 5.91,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.2,
      "end_seconds": 177.71,
      "duration_seconds": 3.51,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.36,
      "end_seconds": 182.1,
      "duration_seconds": 2.74,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.42,
      "end_seconds": 187.33,
      "duration_seconds": 3.91,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.69,
      "end_seconds": 191.43,
      "duration_seconds": 2.74,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.13,
      "end_seconds": 195.41,
      "duration_seconds": 3.28,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.29,
      "end_seconds": 201.3,
      "duration_seconds": 2.01,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.25,
      "end_seconds": 207.44,
      "duration_seconds": 5.19,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.07,
      "end_seconds": 222.73,
      "duration_seconds": 3.66,
      "text": "Have you had any chest pain or diarrhoea?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.72,
      "end_seconds": 227.45,
      "duration_seconds": 3.73,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.96,
      "end_seconds": 233.56,
      "duration_seconds": 4.6,
      "text": "A few quick ones: joint pain, weight loss or recent travel?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.5,
      "end_seconds": 236.85,
      "duration_seconds": 2.35,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.4,
      "end_seconds": 242.08,
      "duration_seconds": 3.68,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.62,
      "end_seconds": 249.85,
      "duration_seconds": 6.23,
      "text": "My heart's been fine, you know, as far as I know."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 251.0,
      "end_seconds": 260.59,
      "duration_seconds": 9.59,
      "text": "Doctor, I've got the readings for you. Pulse 92, blood pressure 111 over 72. Temperature 38.1, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.11,
      "end_seconds": 262.07,
      "duration_seconds": 0.96,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.73,
      "end_seconds": 267.47,
      "duration_seconds": 2.74,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.55,
      "end_seconds": 278.25,
      "duration_seconds": 1.7,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.05,
      "end_seconds": 281.47,
      "duration_seconds": 1.42,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.65,
      "end_seconds": 299.6,
      "duration_seconds": 6.95,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.41,
      "end_seconds": 302.5,
      "duration_seconds": 2.09,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.79,
      "end_seconds": 317.77,
      "duration_seconds": 1.98,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.84,
      "end_seconds": 320.64,
      "duration_seconds": 1.8,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.31,
      "end_seconds": 340.39,
      "duration_seconds": 14.08,
      "text": "Okay, that's enough for me. So, based on the history and the examination, I'd lean towards an enlarged gland with night sweats that needs a proper work-up. I'd also keep a lingering infection in mind."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.51,
      "end_seconds": 344.2,
      "duration_seconds": 2.69,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.29,
      "end_seconds": 370.56,
      "duration_seconds": 25.27,
      "text": "I can't promise yet, but most people with an enlarged gland with night sweats that needs a proper work-up do well once it's treated properly. I'll request an ultrasound of the armpit, it'll help with lymph node. I'd like to arrange blood tests for night sweats. Keep a note of your temperature each evening. I'll also refer you to the haematology clinic."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.42,
      "end_seconds": 380.98,
      "duration_seconds": 9.56,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.48,
      "end_seconds": 383.83,
      "duration_seconds": 1.35,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.16,
      "end_seconds": 398.34,
      "duration_seconds": 13.18,
      "text": "If it hasn't settled in a month, we'd think about a chest X-ray, but not now. Come back in a week. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.41,
      "end_seconds": 403.67,
      "duration_seconds": 3.26,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.06,
      "end_seconds": 406.29,
      "duration_seconds": 1.23,
      "text": "Take care now."
    }
  ]
}