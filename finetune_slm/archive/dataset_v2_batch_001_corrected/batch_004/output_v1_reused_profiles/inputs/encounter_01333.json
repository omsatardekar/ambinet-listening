{
  "schema_version": "1.0",
  "encounter_id": "01333",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 6.27,
      "duration_seconds": 5.14,
      "text": "Uh, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 12.08,
      "duration_seconds": 4.54,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.91,
      "end_seconds": 23.2,
      "duration_seconds": 10.29,
      "text": "Erm, you know, honestly, it's dark marks after they heal, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.82,
      "end_seconds": 25.95,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.51,
      "end_seconds": 32.21,
      "duration_seconds": 5.7,
      "text": "Sorry, what was I saying, it's been nearly five years now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.88,
      "end_seconds": 35.91,
      "duration_seconds": 3.03,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.07,
      "end_seconds": 38.13,
      "duration_seconds": 1.06,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.65,
      "end_seconds": 39.53,
      "duration_seconds": 0.88,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.08,
      "end_seconds": 57.56,
      "duration_seconds": 16.48,
      "text": "Hmm, you know, I've also had oily skin. As for oily skin, a three out of ten, I suppose. Oh, uh, and flare-ups before my period."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.24,
      "end_seconds": 65.99,
      "duration_seconds": 6.75,
      "text": "Have you had dark marks after they heal before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.0,
      "end_seconds": 77.07,
      "duration_seconds": 10.07,
      "text": "Uh, um, a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.23,
      "end_seconds": 82.5,
      "duration_seconds": 4.27,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.93,
      "end_seconds": 90.98,
      "duration_seconds": 2.05,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.11,
      "end_seconds": 109.75,
      "duration_seconds": 4.64,
      "text": "Okay: temp 36.4 degrees, pulse 68, pressure 116 over 72."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.62,
      "end_seconds": 112.45,
      "duration_seconds": 1.83,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.38,
      "end_seconds": 119.44,
      "duration_seconds": 3.06,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.73,
      "end_seconds": 124.19,
      "duration_seconds": 2.46,
      "text": "Alright, shall I start the examination?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.9,
      "end_seconds": 127.3,
      "duration_seconds": 1.4,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.28,
      "end_seconds": 150.64,
      "duration_seconds": 6.36,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.19,
      "end_seconds": 159.04,
      "duration_seconds": 2.85,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.75,
      "end_seconds": 176.51,
      "duration_seconds": 4.76,
      "text": "Have you had any excess hair growth or new face cream?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.95,
      "end_seconds": 184.74,
      "duration_seconds": 6.79,
      "text": "Well, I haven't had excess hair growth or new face cream, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.45,
      "end_seconds": 188.46,
      "duration_seconds": 3.01,
      "text": "Have you had any pregnancy or scarring?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.44,
      "end_seconds": 195.01,
      "duration_seconds": 5.57,
      "text": "Hmm, you know, no pregnancy or scarring, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.03,
      "end_seconds": 198.12,
      "duration_seconds": 2.09,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.8,
      "end_seconds": 200.77,
      "duration_seconds": 1.97,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.64,
      "end_seconds": 218.91,
      "duration_seconds": 2.27,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.53,
      "end_seconds": 238.77,
      "duration_seconds": 19.24,
      "text": "Apixaban. I take it 5 milligrams, twice a day for the heart rhythm. Let me think, you know, though honestly, some days I forget to take it. It's face wash, twice a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.45,
      "end_seconds": 243.36,
      "duration_seconds": 2.91,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.94,
      "end_seconds": 246.38,
      "duration_seconds": 2.44,
      "text": "For about three months."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.13,
      "end_seconds": 250.18,
      "duration_seconds": 2.05,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.76,
      "end_seconds": 254.83,
      "duration_seconds": 3.07,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.05,
      "end_seconds": 257.92,
      "duration_seconds": 1.87,
      "text": "Right, and your job?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.43,
      "end_seconds": 261.9,
      "duration_seconds": 3.47,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.6,
      "end_seconds": 266.8,
      "duration_seconds": 3.2,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.81,
      "end_seconds": 271.93,
      "duration_seconds": 3.12,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.76,
      "end_seconds": 276.1,
      "duration_seconds": 3.34,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.35,
      "end_seconds": 284.1,
      "duration_seconds": 6.75,
      "text": "I mean, yes, I had my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.99,
      "end_seconds": 289.05,
      "duration_seconds": 3.06,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.79,
      "end_seconds": 295.3,
      "duration_seconds": 2.51,
      "text": "I've got an irregular heartbeat."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.91,
      "end_seconds": 300.8,
      "duration_seconds": 4.89,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.05,
      "end_seconds": 305.19,
      "duration_seconds": 3.14,
      "text": "Um, no allergies at all."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.04,
      "end_seconds": 335.06,
      "duration_seconds": 15.02,
      "text": "Let me tell you where I've got to. My working impression is moderate acne. I want to be honest that this is an impression, not a final answer. A hormonal cause is also on my list."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.56,
      "end_seconds": 338.15,
      "duration_seconds": 1.59,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.98,
      "end_seconds": 361.1,
      "duration_seconds": 22.12,
      "text": "I understand the worry. At the moment I'd say it's moderate acne, and we'll watch how it goes. Let me repeat that back to make sure. You've had dark marks after they heal for nearly five years, moderate, and no new face cream or pregnancy."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.65,
      "end_seconds": 363.36,
      "duration_seconds": 1.71,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.14,
      "end_seconds": 374.56,
      "duration_seconds": 10.42,
      "text": "I'll start you on adapalene gel, at night, for eight weeks. That should help with acne. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.53,
      "end_seconds": 379.67,
      "duration_seconds": 4.14,
      "text": "Um, I think I understand everything. Thanks."
    }
  ]
}