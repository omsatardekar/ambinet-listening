{
  "schema_version": "1.0",
  "encounter_id": "01404",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.2,
      "end_seconds": 7.03,
      "duration_seconds": 5.83,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.77,
      "end_seconds": 11.14,
      "duration_seconds": 3.37,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.97,
      "end_seconds": 16.35,
      "duration_seconds": 3.38,
      "text": "I'm here because of my heart racing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 18.31,
      "end_seconds": 27.77,
      "duration_seconds": 9.46,
      "text": "Doctor, I've got the readings for you. Temp 36.5 degrees, heart rate 104, saturation 96 percent. Pressure 115 over 83."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.45,
      "end_seconds": 30.48,
      "duration_seconds": 1.03,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.63,
      "end_seconds": 39.98,
      "duration_seconds": 1.35,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.05,
      "end_seconds": 55.37,
      "duration_seconds": 9.32,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.32,
      "end_seconds": 66.74,
      "duration_seconds": 9.42,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 68.27,
      "end_seconds": 82.2,
      "duration_seconds": 13.93,
      "text": "Yes, coffee and stress. That makes it worse. Lying down helps a bit. Oh, and a fluttering in my chest. That's been about the same, two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.55,
      "end_seconds": 104.7,
      "duration_seconds": 4.15,
      "text": "And what about fainting, leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 105.81,
      "end_seconds": 108.76,
      "duration_seconds": 2.95,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.1,
      "end_seconds": 110.96,
      "duration_seconds": 0.86,
      "text": "Any tremor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.73,
      "end_seconds": 115.76,
      "duration_seconds": 3.03,
      "text": "Not that I've noticed, no tremor."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.21,
      "end_seconds": 119.8,
      "duration_seconds": 2.59,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 121.76,
      "end_seconds": 124.77,
      "duration_seconds": 3.01,
      "text": "No, um, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.22,
      "end_seconds": 131.97,
      "duration_seconds": 2.75,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.72,
      "end_seconds": 135.82,
      "duration_seconds": 2.1,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.09,
      "end_seconds": 141.04,
      "duration_seconds": 3.95,
      "text": "Okay, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.07,
      "end_seconds": 145.91,
      "duration_seconds": 2.84,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.99,
      "end_seconds": 152.4,
      "duration_seconds": 4.41,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 155.11,
      "end_seconds": 157.49,
      "duration_seconds": 2.38,
      "text": "Yes, I'm allergic to nickel."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.5,
      "end_seconds": 161.76,
      "duration_seconds": 3.26,
      "text": "Alright, what line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.88,
      "end_seconds": 167.5,
      "duration_seconds": 4.62,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.39,
      "end_seconds": 172.11,
      "duration_seconds": 2.72,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.82,
      "end_seconds": 175.56,
      "duration_seconds": 2.74,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.21,
      "end_seconds": 181.09,
      "duration_seconds": 3.88,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 182.4,
      "end_seconds": 188.1,
      "duration_seconds": 5.7,
      "text": "I've had high blood pressure, yes. I've got an underactive thyroid."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.97,
      "end_seconds": 195.39,
      "duration_seconds": 4.42,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.99,
      "end_seconds": 199.94,
      "duration_seconds": 2.95,
      "text": "Eltroxin, 100 micrograms, every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.87,
      "end_seconds": 206.65,
      "duration_seconds": 3.78,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.72,
      "end_seconds": 211.03,
      "duration_seconds": 3.31,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.98,
      "end_seconds": 227.85,
      "duration_seconds": 3.87,
      "text": "The pulse is irregular, around ninety beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.97,
      "end_seconds": 232.15,
      "duration_seconds": 3.18,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.23,
      "end_seconds": 249.66,
      "duration_seconds": 3.43,
      "text": "Heart sounds are normal with no murmur."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.23,
      "end_seconds": 257.07,
      "duration_seconds": 1.84,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.93,
      "end_seconds": 295.41,
      "duration_seconds": 28.48,
      "text": "I'm going to order a heart monitor for a few days, for palpitations. That will help us see what's going on underneath and decide the next step. I'll start you on bisoprolol, 2.5 milligrams, once a day, until review. You take it by mouth. That's for heart rate control. Cut right back on coffee, tea and energy drinks for now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.95,
      "end_seconds": 313.95,
      "duration_seconds": 17.0,
      "text": "Please don't wait if you faint or get chest pain with the racing. That's when to be seen urgently. We'll catch up after the monitor results are back. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.06,
      "end_seconds": 326.59,
      "duration_seconds": 11.53,
      "text": "So, I take the bisoprolol, 2.5 milligrams, once a day and come back after the monitor results are back. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.01,
      "end_seconds": 333.62,
      "duration_seconds": 5.61,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 334.8,
      "end_seconds": 338.05,
      "duration_seconds": 3.25,
      "text": "Great, thank you for your help."
    }
  ]
}