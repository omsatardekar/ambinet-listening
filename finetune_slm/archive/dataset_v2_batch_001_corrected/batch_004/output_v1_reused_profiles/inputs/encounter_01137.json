{
  "schema_version": "1.0",
  "encounter_id": "01137",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.63,
      "end_seconds": 3.32,
      "duration_seconds": 2.69,
      "text": "Alright, good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.39,
      "end_seconds": 6.38,
      "duration_seconds": 0.99,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.84,
      "end_seconds": 11.72,
      "duration_seconds": 3.88,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.27,
      "end_seconds": 20.0,
      "duration_seconds": 7.73,
      "text": "Yeah, it's red, cracked skin on my hands. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.08,
      "end_seconds": 25.55,
      "duration_seconds": 3.47,
      "text": "Right, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.4,
      "end_seconds": 27.97,
      "duration_seconds": 1.57,
      "text": "I'd say mild."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.2,
      "end_seconds": 30.44,
      "duration_seconds": 2.24,
      "text": "Sure. What brings it on?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.36,
      "end_seconds": 35.99,
      "duration_seconds": 3.63,
      "text": "So, I notice it more with gloves."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.46,
      "end_seconds": 42.12,
      "duration_seconds": 1.66,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.19,
      "end_seconds": 54.36,
      "duration_seconds": 10.17,
      "text": "Oh, moisturiser helps a bit. And there's dry flaky skin as well, you know, four weeks now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.89,
      "end_seconds": 58.41,
      "duration_seconds": 3.52,
      "text": "Did you get new soap or cream or oozing?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.18,
      "end_seconds": 64.69,
      "duration_seconds": 5.51,
      "text": "No new soap or cream or oozing, none of it."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.56,
      "end_seconds": 69.39,
      "duration_seconds": 3.83,
      "text": "Any nail changes, rash elsewhere or joint pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.62,
      "end_seconds": 75.32,
      "duration_seconds": 4.7,
      "text": "No, no nail changes, rash elsewhere or joint pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 76.38,
      "end_seconds": 78.67,
      "duration_seconds": 2.29,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.9,
      "end_seconds": 82.57,
      "duration_seconds": 2.67,
      "text": "Ah, no, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.38,
      "end_seconds": 87.21,
      "duration_seconds": 3.83,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.69,
      "end_seconds": 92.55,
      "duration_seconds": 3.86,
      "text": "Okay, so bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.4,
      "end_seconds": 103.74,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.28,
      "end_seconds": 112.08,
      "duration_seconds": 7.8,
      "text": "I mean, I had two stents put in my heart three years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.58,
      "end_seconds": 119.53,
      "duration_seconds": 5.95,
      "text": "What about your medical history? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.99,
      "end_seconds": 124.05,
      "duration_seconds": 3.06,
      "text": "I have eczema, for two years."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.73,
      "end_seconds": 126.47,
      "duration_seconds": 0.74,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.3,
      "end_seconds": 149.05,
      "duration_seconds": 20.75,
      "text": "I have COPD, for two years. I kept putting it off, which I know isn't sensible. I looked a few things up online, and that probably didn't help. I have heart disease. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.81,
      "end_seconds": 156.59,
      "duration_seconds": 5.78,
      "text": "Alright, eczema, that matches what I have here. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.88,
      "end_seconds": 161.72,
      "duration_seconds": 3.84,
      "text": "Not to my knowledge, uh, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.71,
      "end_seconds": 166.06,
      "duration_seconds": 3.35,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.56,
      "end_seconds": 180.49,
      "duration_seconds": 13.93,
      "text": "I take hydrocortisone cream, when needed. I'm on Tiotropium inhaler, once a day for my chest. Clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.14,
      "end_seconds": 183.58,
      "duration_seconds": 1.44,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.71,
      "end_seconds": 190.93,
      "duration_seconds": 6.22,
      "text": "About a year now. It's moisturiser, several times a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.75,
      "end_seconds": 197.62,
      "duration_seconds": 2.87,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.36,
      "end_seconds": 202.88,
      "duration_seconds": 4.52,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.81,
      "end_seconds": 206.52,
      "duration_seconds": 1.71,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 208.55,
      "end_seconds": 212.77,
      "duration_seconds": 4.22,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.14,
      "end_seconds": 220.02,
      "duration_seconds": 1.88,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.04,
      "end_seconds": 226.03,
      "duration_seconds": 3.99,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.65,
      "end_seconds": 246.73,
      "duration_seconds": 3.08,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.5,
      "end_seconds": 258.34,
      "duration_seconds": 2.84,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.22,
      "end_seconds": 281.4,
      "duration_seconds": 8.18,
      "text": "Okay: blood pressure 125 over 79, temperature is 36.4 degrees, pulse is 64 beats a minute."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.9,
      "end_seconds": 284.51,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.75,
      "end_seconds": 288.14,
      "duration_seconds": 2.39,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.11,
      "end_seconds": 295.31,
      "duration_seconds": 4.2,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.92,
      "end_seconds": 298.61,
      "duration_seconds": 1.69,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.24,
      "end_seconds": 319.78,
      "duration_seconds": 8.54,
      "text": "The skin on both hands is red, dry and cracked in the finger creases, with no weeping."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.84,
      "end_seconds": 327.41,
      "duration_seconds": 2.57,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.38,
      "end_seconds": 349.83,
      "duration_seconds": 9.45,
      "text": "Let me tell you where I've got to. My working impression is irritant hand dermatitis. Allergic contact dermatitis is also on my list."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 350.78,
      "end_seconds": 354.1,
      "duration_seconds": 3.32,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 354.74,
      "end_seconds": 366.54,
      "duration_seconds": 11.8,
      "text": "It's reasonable to be concerned, but right now irritant hand dermatitis is my leading thought, not anything worse. A patch test is what I'd like next, for dermatitis."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 372.04,
      "end_seconds": 375.4,
      "duration_seconds": 3.36,
      "text": "I can book that for Friday at 2 pm."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 376.35,
      "end_seconds": 377.53,
      "duration_seconds": 1.18,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 378.3,
      "end_seconds": 397.96,
      "duration_seconds": 19.66,
      "text": "Use gloves for washing up and moisturise straight after you dry your hands. Come back or go to emergency straight away if the symptoms get worse. See me again in three weeks. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 398.5,
      "end_seconds": 404.7,
      "duration_seconds": 6.2,
      "text": "So, I come back in three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 406.27,
      "end_seconds": 410.8,
      "duration_seconds": 4.53,
      "text": "Alright, yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 411.58,
      "end_seconds": 415.14,
      "duration_seconds": 3.56,
      "text": "Right, I think I understand everything. Thanks."
    }
  ]
}