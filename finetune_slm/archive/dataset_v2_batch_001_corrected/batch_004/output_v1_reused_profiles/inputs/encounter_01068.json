{
  "schema_version": "1.0",
  "encounter_id": "01068",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.59,
      "end_seconds": 5.09,
      "duration_seconds": 4.5,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.65,
      "end_seconds": 10.62,
      "duration_seconds": 3.97,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.01,
      "end_seconds": 22.33,
      "duration_seconds": 10.32,
      "text": "Oh, mainly swelling in my left calf. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.96,
      "end_seconds": 27.51,
      "duration_seconds": 3.55,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.27,
      "end_seconds": 32.15,
      "duration_seconds": 3.88,
      "text": "It's been about two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.77,
      "end_seconds": 36.49,
      "duration_seconds": 3.72,
      "text": "rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.93,
      "end_seconds": 41.3,
      "duration_seconds": 3.37,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.69,
      "end_seconds": 62.59,
      "duration_seconds": 2.9,
      "text": "have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.01,
      "end_seconds": 67.49,
      "duration_seconds": 3.48,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.37,
      "end_seconds": 84.39,
      "duration_seconds": 3.02,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.73,
      "end_seconds": 88.53,
      "duration_seconds": 2.8,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.48,
      "end_seconds": 93.27,
      "duration_seconds": 3.79,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.2,
      "end_seconds": 95.88,
      "duration_seconds": 1.68,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.16,
      "end_seconds": 110.12,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.39,
      "end_seconds": 113.83,
      "duration_seconds": 2.44,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.87,
      "end_seconds": 117.0,
      "duration_seconds": 2.13,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.89,
      "end_seconds": 122.62,
      "duration_seconds": 3.73,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 128.92,
      "duration_seconds": 4.24,
      "text": "alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.87,
      "end_seconds": 132.81,
      "duration_seconds": 2.94,
      "text": "It's paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.43,
      "end_seconds": 139.68,
      "duration_seconds": 6.25,
      "text": "Any breathlessness, coughing up blood or swelling in the other leg at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.64,
      "end_seconds": 144.37,
      "duration_seconds": 3.73,
      "text": "So, uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.68,
      "end_seconds": 150.25,
      "duration_seconds": 2.57,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.37,
      "end_seconds": 153.81,
      "duration_seconds": 2.44,
      "text": "no, that side's been fine"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.51,
      "end_seconds": 158.22,
      "duration_seconds": 2.71,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.25,
      "end_seconds": 160.35,
      "duration_seconds": 1.1,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.46,
      "end_seconds": 178.1,
      "duration_seconds": 4.64,
      "text": "So, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.29,
      "end_seconds": 193.71,
      "duration_seconds": 2.42,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.75,
      "end_seconds": 215.84,
      "duration_seconds": 8.09,
      "text": "Okay: pressure 134 over 77, SpO2 96 percent on room air. And temperature is 36.8 degrees, pulse 125."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.99,
      "end_seconds": 221.54,
      "duration_seconds": 3.55,
      "text": "could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.85,
      "end_seconds": 224.35,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.71,
      "end_seconds": 227.63,
      "duration_seconds": 1.92,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.34,
      "end_seconds": 250.18,
      "duration_seconds": 4.84,
      "text": "the left calf is bigger than the right, tender along the vein"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.79,
      "end_seconds": 263.32,
      "duration_seconds": 8.53,
      "text": "Okay, that's enough for me. Having listened and examined, I'd lean towards a possible deep vein clot."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.75,
      "end_seconds": 266.45,
      "duration_seconds": 1.7,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.36,
      "end_seconds": 303.55,
      "duration_seconds": 35.19,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible deep vein clot, but I'd like to confirm. I think a D-dimer blood test makes sense here, for suspected DVT. Keep walking gently, and don't massage the calf. I'm not ordering a Doppler scan of the leg today. If things carry on in a month, we'll consider it. If you get chest pain or sudden breathlessness, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.06,
      "end_seconds": 306.4,
      "duration_seconds": 2.34,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.99,
      "end_seconds": 310.34,
      "duration_seconds": 2.35,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.82,
      "end_seconds": 313.87,
      "duration_seconds": 2.05,
      "text": "Alright, goodbye for now."
    }
  ]
}