{
  "schema_version": "1.0",
  "encounter_id": "01231",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 9.5,
      "duration_seconds": 8.7,
      "text": "Actually, you know, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.02,
      "end_seconds": 14.65,
      "duration_seconds": 3.63,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.28,
      "end_seconds": 22.32,
      "duration_seconds": 3.04,
      "text": "I'm here because of a blister."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.11,
      "end_seconds": 26.88,
      "duration_seconds": 2.77,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.37,
      "end_seconds": 31.21,
      "duration_seconds": 2.84,
      "text": "Nothing regular, um, no."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.72,
      "end_seconds": 35.96,
      "duration_seconds": 3.24,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.1,
      "end_seconds": 46.34,
      "duration_seconds": 9.24,
      "text": "Ah, it's been going on for two weeks. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.27,
      "end_seconds": 50.59,
      "duration_seconds": 3.32,
      "text": "Did you get fever or trouble breathing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.26,
      "end_seconds": 55.62,
      "duration_seconds": 4.36,
      "text": "Ah, no fever or trouble breathing, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.49,
      "end_seconds": 57.77,
      "duration_seconds": 1.28,
      "text": "Any chemical exposure?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.92,
      "end_seconds": 62.94,
      "duration_seconds": 2.02,
      "text": "No. No chemical exposure."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.15,
      "end_seconds": 68.56,
      "duration_seconds": 4.41,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.14,
      "end_seconds": 71.28,
      "duration_seconds": 2.14,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.88,
      "end_seconds": 75.48,
      "duration_seconds": 2.6,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.79,
      "end_seconds": 78.46,
      "duration_seconds": 1.67,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.87,
      "end_seconds": 99.72,
      "duration_seconds": 2.85,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.44,
      "end_seconds": 103.57,
      "duration_seconds": 3.13,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.76,
      "end_seconds": 107.3,
      "duration_seconds": 2.54,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.37,
      "end_seconds": 112.64,
      "duration_seconds": 4.27,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.14,
      "end_seconds": 121.27,
      "duration_seconds": 4.13,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.95,
      "end_seconds": 126.0,
      "duration_seconds": 3.05,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.02,
      "end_seconds": 132.41,
      "duration_seconds": 4.39,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.39,
      "end_seconds": 136.65,
      "duration_seconds": 3.26,
      "text": "I have gout, for five years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.6,
      "end_seconds": 153.78,
      "duration_seconds": 4.18,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.65,
      "end_seconds": 156.62,
      "duration_seconds": 1.97,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.28,
      "end_seconds": 172.98,
      "duration_seconds": 3.7,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.19,
      "end_seconds": 188.38,
      "duration_seconds": 2.19,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.74,
      "end_seconds": 212.74,
      "duration_seconds": 11.0,
      "text": "Okay: saturation 97 percent, blood pressure 117 over 74, pulse is 80 beats a minute, temp 36.9 degrees, respiratory rate 14."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.71,
      "end_seconds": 216.07,
      "duration_seconds": 1.36,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.91,
      "end_seconds": 220.55,
      "duration_seconds": 3.64,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.92,
      "end_seconds": 227.45,
      "duration_seconds": 4.53,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.7,
      "end_seconds": 230.68,
      "duration_seconds": 1.98,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.25,
      "end_seconds": 248.48,
      "duration_seconds": 9.23,
      "text": "There is a five-centimetre area of redness with an intact blister on the left forearm, and it blanches and is painful."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.2,
      "end_seconds": 266.83,
      "duration_seconds": 12.63,
      "text": "You can relax now. Okay, thinking it through, I don't have a clear answer today: a superficial partial-thickness burn is possible, and so is a deeper burn."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.04,
      "end_seconds": 289.21,
      "duration_seconds": 9.17,
      "text": "I'm prescribing paracetamol, 1 gram, every six hours if needed, for three days. You take it by mouth. It's for burn pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.78,
      "end_seconds": 295.97,
      "duration_seconds": 5.19,
      "text": "So, should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.24,
      "end_seconds": 314.54,
      "duration_seconds": 17.3,
      "text": "Cool the area under running water for twenty minutes and cover it with a non-stick dressing, and leave the blister alone. One warning sign to remember: the burn becomes smelly, spreads or you get a fever. In that case don't wait."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.01,
      "end_seconds": 319.84,
      "duration_seconds": 3.83,
      "text": "Um, yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.62,
      "end_seconds": 326.29,
      "duration_seconds": 5.67,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.33,
      "end_seconds": 341.2,
      "duration_seconds": 9.87,
      "text": "So, uh, I take the paracetamol, 1 gram, every six hours if needed. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.35,
      "end_seconds": 346.76,
      "duration_seconds": 4.41,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.92,
      "end_seconds": 350.97,
      "duration_seconds": 3.05,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.68,
      "end_seconds": 354.6,
      "duration_seconds": 1.92,
      "text": "Have a good day."
    }
  ]
}