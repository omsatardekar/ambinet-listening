{
  "schema_version": "1.0",
  "encounter_id": "01120",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 7.64,
      "duration_seconds": 7.11,
      "text": "Hello, good to see you. Please sit. Is the form from the front desk all filled in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.89,
      "end_seconds": 17.24,
      "duration_seconds": 5.35,
      "text": "Erm, I think so, I handed it in at the counter."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.81,
      "end_seconds": 20.73,
      "duration_seconds": 2.92,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.61,
      "end_seconds": 30.14,
      "duration_seconds": 7.53,
      "text": "I wanted to get sharp pain in the left chest when I breathe in looked at."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.08,
      "end_seconds": 32.91,
      "duration_seconds": 1.83,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.75,
      "end_seconds": 37.65,
      "duration_seconds": 2.9,
      "text": "For about a week, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.17,
      "end_seconds": 47.2,
      "duration_seconds": 8.03,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.73,
      "end_seconds": 63.33,
      "duration_seconds": 15.6,
      "text": "Only shallow breathing, and it's not much. Yes, coughing. That makes it worse. Mostly moderate. I did have a dry cough at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.06,
      "end_seconds": 66.08,
      "duration_seconds": 2.02,
      "text": "Any injury to the chest?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.94,
      "end_seconds": 70.96,
      "duration_seconds": 4.02,
      "text": "Not at all, no injury to the chest."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.51,
      "end_seconds": 77.74,
      "duration_seconds": 5.23,
      "text": "A few quick ones: leg swelling, recent long travel or palpitations?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.44,
      "end_seconds": 81.73,
      "duration_seconds": 2.29,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.31,
      "end_seconds": 87.74,
      "duration_seconds": 5.43,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.44,
      "end_seconds": 91.53,
      "duration_seconds": 2.09,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.92,
      "end_seconds": 96.22,
      "duration_seconds": 3.3,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.25,
      "end_seconds": 100.33,
      "duration_seconds": 2.08,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.59,
      "end_seconds": 104.2,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.77,
      "end_seconds": 118.24,
      "duration_seconds": 12.47,
      "text": "I live with my elderly mother. I drink a lot of tea and snack through the day. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.08,
      "end_seconds": 136.26,
      "duration_seconds": 2.18,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.74,
      "end_seconds": 144.06,
      "duration_seconds": 6.32,
      "text": "Pantoprazole, 40 milligrams, before breakfast. I take ibuprofen, 400 milligrams, when it hurts."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.55,
      "end_seconds": 145.25,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.53,
      "end_seconds": 163.66,
      "duration_seconds": 4.13,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.95,
      "end_seconds": 167.0,
      "duration_seconds": 2.05,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.63,
      "end_seconds": 170.31,
      "duration_seconds": 1.68,
      "text": "Okay, any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.24,
      "end_seconds": 175.36,
      "duration_seconds": 3.12,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.53,
      "end_seconds": 182.19,
      "duration_seconds": 5.66,
      "text": "Do you have any long-term conditions? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.04,
      "end_seconds": 185.71,
      "duration_seconds": 1.67,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.59,
      "end_seconds": 190.59,
      "duration_seconds": 3.0,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.13,
      "end_seconds": 206.53,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.51,
      "end_seconds": 231.08,
      "duration_seconds": 8.57,
      "text": "Okay: respiratory rate 16, temperature 36.8, blood pressure 121 over 75, pulse 66, saturation 98 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.29,
      "end_seconds": 233.68,
      "duration_seconds": 1.39,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 234.73,
      "end_seconds": 238.05,
      "duration_seconds": 3.32,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.91,
      "end_seconds": 242.84,
      "duration_seconds": 2.93,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.76,
      "end_seconds": 245.03,
      "duration_seconds": 1.27,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.11,
      "end_seconds": 255.42,
      "duration_seconds": 3.31,
      "text": "Air entry is equal on both sides."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.11,
      "end_seconds": 258.07,
      "duration_seconds": 0.96,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.4,
      "end_seconds": 261.43,
      "duration_seconds": 2.03,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.64,
      "end_seconds": 277.7,
      "duration_seconds": 4.06,
      "text": "I can hear a faint rub on the left side."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.11,
      "end_seconds": 291.72,
      "duration_seconds": 11.61,
      "text": "Okay, that's enough for me. From what you've told me and what I found, it fits best with viral pleurisy. I'd also keep a chest infection in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.36,
      "end_seconds": 307.05,
      "duration_seconds": 3.69,
      "text": "We should do a chest X-ray for pleuritic pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 308.32,
      "end_seconds": 310.99,
      "duration_seconds": 2.67,
      "text": "The earliest is Thursday, 3:30 pm."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 315.77,
      "end_seconds": 330.97,
      "duration_seconds": 15.2,
      "text": "I'm sending you for an ECG because of chest pain. Regular pain relief makes it easier to take deep breaths, which protects the lung. Please come and see me after the X-ray."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.95,
      "end_seconds": 339.52,
      "duration_seconds": 3.57,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.27,
      "end_seconds": 343.77,
      "duration_seconds": 3.5,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.32,
      "end_seconds": 347.91,
      "duration_seconds": 3.59,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}