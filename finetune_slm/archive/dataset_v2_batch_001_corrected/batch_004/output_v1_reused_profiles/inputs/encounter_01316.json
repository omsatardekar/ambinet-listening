{
  "schema_version": "1.0",
  "encounter_id": "01316",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 9.49,
      "duration_seconds": 8.55,
      "text": "Um, um, doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.36,
      "end_seconds": 16.63,
      "duration_seconds": 5.27,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.3,
      "end_seconds": 23.36,
      "duration_seconds": 5.06,
      "text": "Um, so... pale stools. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.26,
      "end_seconds": 28.02,
      "duration_seconds": 2.76,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.05,
      "end_seconds": 47.59,
      "duration_seconds": 16.54,
      "text": "For two days, I'd say. Let me think, and there's dark urine as well, ten days now. Oh, and yellow eyes. That's been about the same, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.93,
      "end_seconds": 56.9,
      "duration_seconds": 1.97,
      "text": "Did you notice any fever?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.46,
      "end_seconds": 62.28,
      "duration_seconds": 3.82,
      "text": "Not that I've noticed, no fever."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.76,
      "end_seconds": 67.9,
      "duration_seconds": 5.14,
      "text": "Right, right. Any confusion, bleeding or severe abdominal pain at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.7,
      "end_seconds": 72.91,
      "duration_seconds": 3.21,
      "text": "Actually, no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.43,
      "end_seconds": 77.07,
      "duration_seconds": 3.64,
      "text": "So, any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.94,
      "end_seconds": 80.38,
      "duration_seconds": 2.44,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.78,
      "end_seconds": 85.02,
      "duration_seconds": 3.24,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.36,
      "end_seconds": 99.77,
      "duration_seconds": 13.41,
      "text": "Yes, diabetes. I wasn't sure whether to come in at all, to be honest. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.18,
      "end_seconds": 102.21,
      "duration_seconds": 1.03,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.15,
      "end_seconds": 111.63,
      "duration_seconds": 8.48,
      "text": "An irregular heartbeat, for about ten years. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.03,
      "end_seconds": 116.53,
      "duration_seconds": 3.5,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.35,
      "end_seconds": 124.11,
      "duration_seconds": 3.76,
      "text": "Actually, yes, naproxen. I get a rash."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.87,
      "end_seconds": 135.99,
      "duration_seconds": 2.12,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.81,
      "end_seconds": 141.59,
      "duration_seconds": 4.78,
      "text": "I take bisoprolol, 2.5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.18,
      "end_seconds": 146.33,
      "duration_seconds": 3.15,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.26,
      "end_seconds": 153.16,
      "duration_seconds": 5.9,
      "text": "Um, yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.82,
      "end_seconds": 156.42,
      "duration_seconds": 2.6,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.8,
      "end_seconds": 180.47,
      "duration_seconds": 22.67,
      "text": "I used to drink heavily but I stopped four years ago. I've never touched a cigarette. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours. My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.06,
      "end_seconds": 200.32,
      "duration_seconds": 3.26,
      "text": "Okay, I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.58,
      "end_seconds": 209.56,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.72,
      "end_seconds": 226.06,
      "duration_seconds": 6.34,
      "text": "Okay: respiratory rate 14, pulse is 80 beats a minute, blood pressure 108 over 80."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.14,
      "end_seconds": 229.29,
      "duration_seconds": 2.15,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.85,
      "end_seconds": 232.58,
      "duration_seconds": 1.73,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 236.63,
      "duration_seconds": 2.69,
      "text": "Alright, tell me if that's sore."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.56,
      "end_seconds": 261.08,
      "duration_seconds": 7.52,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.66,
      "end_seconds": 262.84,
      "duration_seconds": 1.18,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.91,
      "end_seconds": 285.0,
      "duration_seconds": 19.09,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. This is probably an acute viral hepatitis. I want to be honest that this is an impression, not a final answer. Another possibility is a drug-related liver problem. Let's get an ultrasound of the liver, for jaundice."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.89,
      "end_seconds": 288.83,
      "duration_seconds": 2.94,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.71,
      "end_seconds": 297.49,
      "duration_seconds": 6.78,
      "text": "Let's get liver blood tests, for jaundice. Let's get a hepatitis screen, for jaundice."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.09,
      "end_seconds": 302.56,
      "duration_seconds": 4.47,
      "text": "Yeah, um, when would that take place?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.39,
      "end_seconds": 326.01,
      "duration_seconds": 22.62,
      "text": "No alcohol at all and avoid paracetamol and other painkillers unless we say. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. The thing that would worry me is if you become drowsy or confused. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.64,
      "end_seconds": 330.78,
      "duration_seconds": 3.14,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.49,
      "end_seconds": 335.3,
      "duration_seconds": 2.81,
      "text": "I'd like you back after the results."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.3,
      "end_seconds": 339.77,
      "duration_seconds": 3.47,
      "text": "Uh, good, I'll return then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.71,
      "end_seconds": 343.22,
      "duration_seconds": 2.51,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.76,
      "end_seconds": 347.85,
      "duration_seconds": 3.09,
      "text": "Well, thank you, that's helpful."
    }
  ]
}