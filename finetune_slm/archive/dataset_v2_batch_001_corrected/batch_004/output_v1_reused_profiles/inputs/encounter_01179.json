{
  "schema_version": "1.0",
  "encounter_id": "01179",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.39,
      "end_seconds": 5.55,
      "duration_seconds": 4.16,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.8,
      "end_seconds": 10.67,
      "duration_seconds": 3.87,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.93,
      "end_seconds": 19.43,
      "duration_seconds": 7.5,
      "text": "Honestly, it's pain in my right ear, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.04,
      "end_seconds": 23.82,
      "duration_seconds": 3.78,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.86,
      "end_seconds": 30.8,
      "duration_seconds": 1.94,
      "text": "About... well, three days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.13,
      "end_seconds": 40.53,
      "duration_seconds": 9.4,
      "text": "Right, right. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.0,
      "end_seconds": 51.34,
      "duration_seconds": 9.34,
      "text": "It's worse with lying on it. I'd call it severe. I get some relief from a warm cloth."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.55,
      "end_seconds": 54.74,
      "duration_seconds": 2.19,
      "text": "Have you had muffled hearing?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.12,
      "end_seconds": 58.41,
      "duration_seconds": 2.29,
      "text": "Mm, um, yes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.88,
      "end_seconds": 66.94,
      "duration_seconds": 7.06,
      "text": "Have you had pain in your right ear before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.35,
      "end_seconds": 73.73,
      "duration_seconds": 5.38,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.53,
      "end_seconds": 78.7,
      "duration_seconds": 3.17,
      "text": "Alright, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.32,
      "end_seconds": 87.27,
      "duration_seconds": 7.95,
      "text": "I had a reaction to trimethoprim when I was younger, a rash, and I've avoided it since."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.62,
      "end_seconds": 96.8,
      "duration_seconds": 8.18,
      "text": "What conditions have you been treated for in the past? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.87,
      "end_seconds": 99.95,
      "duration_seconds": 2.08,
      "text": "Asthma, for two years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.75,
      "end_seconds": 109.26,
      "duration_seconds": 7.51,
      "text": "Yes, asthma is known to us, good to have that clear. Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.48,
      "end_seconds": 113.39,
      "duration_seconds": 2.91,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.24,
      "end_seconds": 118.24,
      "duration_seconds": 3.0,
      "text": "Right, have you ever had an operation?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.01,
      "end_seconds": 126.6,
      "duration_seconds": 5.59,
      "text": "I had a meniscus repair on my knee four years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.84,
      "end_seconds": 138.71,
      "duration_seconds": 2.87,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.04,
      "end_seconds": 146.95,
      "duration_seconds": 3.91,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.85,
      "end_seconds": 151.08,
      "duration_seconds": 3.23,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.92,
      "end_seconds": 156.09,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.86,
      "end_seconds": 178.95,
      "duration_seconds": 4.09,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.13,
      "end_seconds": 190.7,
      "duration_seconds": 10.57,
      "text": "It's Foracort inhaler, twice a day for my asthma. I had Asthalin inhaler at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.49,
      "end_seconds": 195.18,
      "duration_seconds": 3.69,
      "text": "And what about discharge from the ear or dizziness?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.7,
      "end_seconds": 198.12,
      "duration_seconds": 2.42,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.18,
      "end_seconds": 204.43,
      "duration_seconds": 5.25,
      "text": "Have you had any facial weakness, swelling behind the ear or ringing?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.23,
      "end_seconds": 208.76,
      "duration_seconds": 2.53,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.94,
      "end_seconds": 212.89,
      "duration_seconds": 2.95,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 213.43,
      "end_seconds": 215.71,
      "duration_seconds": 2.28,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.39,
      "end_seconds": 217.87,
      "duration_seconds": 1.48,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.6,
      "end_seconds": 221.9,
      "duration_seconds": 2.3,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 236.55,
      "end_seconds": 247.42,
      "duration_seconds": 10.87,
      "text": "Okay, so the vitals from earlier. Respiratory rate 22, saturation 97 percent, blood pressure 123 over 71. Temperature 38.2, pulse is 91 beats a minute."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.89,
      "end_seconds": 252.79,
      "duration_seconds": 0.9,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 258.4,
      "duration_seconds": 3.59,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.74,
      "end_seconds": 262.74,
      "duration_seconds": 3.0,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.16,
      "end_seconds": 279.42,
      "duration_seconds": 2.26,
      "text": "The left ear looks normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.65,
      "end_seconds": 292.35,
      "duration_seconds": 10.7,
      "text": "You can sit up now. We'll begin with paracetamol, 500 milligrams, every six hours if needed, for three days. It's for ear pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.1,
      "end_seconds": 296.7,
      "duration_seconds": 2.6,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.08,
      "end_seconds": 314.54,
      "duration_seconds": 16.46,
      "text": "Keep the ear dry for now and don't put anything in it, including cotton buds. Do get help quickly if you get discharge, swelling behind the ear or the pain gets much worse."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.16,
      "end_seconds": 318.45,
      "duration_seconds": 3.29,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.67,
      "end_seconds": 325.14,
      "duration_seconds": 5.47,
      "text": "We'll catch up in ten days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.7,
      "end_seconds": 329.41,
      "duration_seconds": 3.71,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}