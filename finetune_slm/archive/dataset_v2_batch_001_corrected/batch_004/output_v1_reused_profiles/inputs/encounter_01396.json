{
  "schema_version": "1.0",
  "encounter_id": "01396",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 4.04,
      "duration_seconds": 2.88,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.81,
      "end_seconds": 8.9,
      "duration_seconds": 4.09,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.84,
      "end_seconds": 17.46,
      "duration_seconds": 6.62,
      "text": "so the thing is, I've got a high fever with shaking chills"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.35,
      "end_seconds": 20.66,
      "duration_seconds": 1.31,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.31,
      "end_seconds": 46.85,
      "duration_seconds": 24.54,
      "text": "Probably three days. Yeah. I didn't want to bother you but it keeps coming back. Mm, and there's muscle aches as well, about two weeks now. As for muscle aches, it's mild, honestly. Honestly, a few times a day. I've had a pounding headache too, for five days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.75,
      "end_seconds": 55.18,
      "duration_seconds": 6.43,
      "text": "Have you had a high fever with shaking chills before, or is this the first time?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.63,
      "end_seconds": 68.15,
      "duration_seconds": 6.52,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.88,
      "end_seconds": 72.45,
      "duration_seconds": 3.57,
      "text": "Any cough, yellow eyes, diarrhoea or confusion?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.33,
      "end_seconds": 78.47,
      "duration_seconds": 4.14,
      "text": "No, no cough, yellow eyes, diarrhoea or confusion."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.14,
      "end_seconds": 82.83,
      "duration_seconds": 2.69,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.84,
      "end_seconds": 86.48,
      "duration_seconds": 2.64,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.37,
      "end_seconds": 103.21,
      "duration_seconds": 2.84,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.03,
      "end_seconds": 108.38,
      "duration_seconds": 4.35,
      "text": "My brother has epilepsy. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.93,
      "end_seconds": 111.36,
      "duration_seconds": 2.43,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.21,
      "end_seconds": 120.91,
      "duration_seconds": 3.7,
      "text": "I've had asthma for two years now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.65,
      "end_seconds": 127.35,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.85,
      "end_seconds": 132.67,
      "duration_seconds": 3.82,
      "text": "I've had eczema for nearly five years now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.92,
      "end_seconds": 143.04,
      "duration_seconds": 7.12,
      "text": "Yes, eczema is known to us, good to have that clear. How are your meals?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.1,
      "end_seconds": 148.11,
      "duration_seconds": 4.01,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.59,
      "end_seconds": 150.89,
      "duration_seconds": 1.3,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.43,
      "end_seconds": 155.17,
      "duration_seconds": 2.74,
      "text": "I walk the dog every morning"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.85,
      "end_seconds": 158.6,
      "duration_seconds": 2.75,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.45,
      "end_seconds": 162.69,
      "duration_seconds": 3.24,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.69,
      "end_seconds": 167.02,
      "duration_seconds": 2.33,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.05,
      "end_seconds": 172.73,
      "duration_seconds": 3.68,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.23,
      "end_seconds": 177.3,
      "duration_seconds": 3.07,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.25,
      "end_seconds": 182.71,
      "duration_seconds": 3.46,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.51,
      "end_seconds": 187.48,
      "duration_seconds": 2.97,
      "text": "Right, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.55,
      "end_seconds": 207.05,
      "duration_seconds": 17.5,
      "text": "Oh, I'm on Asthalin inhaler, when needed. Hydrocortisone cream, when needed. I'm supposed to take it it regularly, but I don't always manage. I take Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.92,
      "end_seconds": 211.31,
      "duration_seconds": 3.39,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.07,
      "end_seconds": 217.57,
      "duration_seconds": 1.5,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.22,
      "end_seconds": 220.94,
      "duration_seconds": 2.72,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.7,
      "end_seconds": 235.3,
      "duration_seconds": 2.6,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.49,
      "end_seconds": 259.17,
      "duration_seconds": 5.68,
      "text": "Okay: respiratory rate 21, heart rate 101, BP is 113 over 76."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.89,
      "end_seconds": 266.81,
      "duration_seconds": 4.92,
      "text": "I'll need to to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.15,
      "end_seconds": 278.28,
      "duration_seconds": 1.13,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.24,
      "end_seconds": 281.96,
      "duration_seconds": 2.72,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.38,
      "end_seconds": 302.37,
      "duration_seconds": 4.99,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.24,
      "end_seconds": 305.05,
      "duration_seconds": 1.81,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.01,
      "end_seconds": 323.76,
      "duration_seconds": 13.75,
      "text": "Okay, that's enough for me. Right, here's what I'm thinking. This is probably a fever after travel that must be treated as possible malaria. Typhoid fever is also on my list."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.05,
      "end_seconds": 327.42,
      "duration_seconds": 2.37,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.19,
      "end_seconds": 348.28,
      "duration_seconds": 19.09,
      "text": "nothing I've seen today points to an emergency. It looks like a fever after travel that must be treated as possible malaria, but I'd like to confirm. So, to recap quickly. You've had a high fever with shaking chills for three days, and no cough or yellow eyes"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.23,
      "end_seconds": 350.82,
      "duration_seconds": 1.59,
      "text": "That's it, yes."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.89,
      "end_seconds": 395.83,
      "duration_seconds": 26.94,
      "text": "I want blood tests done, that's for fever. I want blood cultures done, that's for fever. I want a malaria test done, that's for fever after travel. Avoid anti-inflammatory painkillers and keep drinking. Let's get you seen by the tropical diseases unit, I'll arrange the letter. Please come and see me in two days. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.89,
      "end_seconds": 400.59,
      "duration_seconds": 3.7,
      "text": "Right, no, that's all. Thanks a lot."
    }
  ]
}