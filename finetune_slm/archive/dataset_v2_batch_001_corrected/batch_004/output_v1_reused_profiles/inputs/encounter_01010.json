      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.02,
      "end_seconds": 250.42,
      "duration_seconds": 4.4,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
