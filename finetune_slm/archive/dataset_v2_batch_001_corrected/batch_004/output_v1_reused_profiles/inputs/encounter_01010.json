    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.68,
      "end_seconds": 70.36,
      "duration_seconds": 3.68,
      "text": "so on the cardiac side anything I should know?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.71,
      "end_seconds": 76.19,
      "duration_seconds": 1.48,
