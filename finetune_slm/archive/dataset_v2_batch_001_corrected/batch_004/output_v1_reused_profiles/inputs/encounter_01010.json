    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.36,
      "end_seconds": 54.29,
      "duration_seconds": 3.93,
      "text": "oh, it usually comes with a poor appetite"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.58,
      "end_seconds": 61.89,
      "duration_seconds": 6.31,
      "text": "let me check a few things. Any vomiting blood in the stool or coughing up blood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.14,
      "end_seconds": 65.43,
      "duration_seconds": 2.29,
      "text": "none of those, no"
