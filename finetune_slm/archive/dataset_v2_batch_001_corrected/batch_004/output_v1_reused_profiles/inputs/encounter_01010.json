    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.28,
      "end_seconds": 85.46,
      "duration_seconds": 3.18,
      "text": "I mean no joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.48,
      "end_seconds": 90.25,
      "duration_seconds": 2.77,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.2,
      "end_seconds": 96.63,
      "duration_seconds": 4.43,
      "text": "Yes, I work in a bakery, early starts."
