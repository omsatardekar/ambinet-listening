      "role": "PATIENT",
      "start_seconds": 102.6,
      "end_seconds": 105.93,
      "duration_seconds": 3.33,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.68,
      "end_seconds": 110.06,
      "duration_seconds": 2.38,
      "text": "is there someone at home?"
