      "start_seconds": 3.97,
      "end_seconds": 5.03,
      "duration_seconds": 1.06,
      "text": "hi thanks"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.53,
      "end_seconds": 8.61,
      "duration_seconds": 2.08,
      "text": "Alright, what's the the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.14,
      "end_seconds": 18.46,
      "duration_seconds": 8.32,
      "text": "Well I've been having night sweats. I thought it would sort itself out but it hasn't."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.0,
      "end_seconds": 20.28,
      "duration_seconds": 1.28,
      "text": "since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.36,
      "end_seconds": 33.56,
      "duration_seconds": 12.2,
      "text": "about... well, about three months i did try to ignore it for a a while i'm hoping you can tell me something definite"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.03,
      "end_seconds": 40.02,
      "duration_seconds": 2.99,
      "text": "would you say mild, moderate or severe?"
