    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.04,
      "end_seconds": 45.61,
      "duration_seconds": 4.57,
      "text": "I mean, pretty severe, if I'm being honest"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.48,
      "end_seconds": 49.34,
      "duration_seconds": 2.86,
      "text": "is there anything else with it?"
