{
  "schema_version": "1.0",
  "encounter_id": "01215",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.17,
      "end_seconds": 5.44,
      "duration_seconds": 4.27,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 10.22,
      "duration_seconds": 3.63,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.37,
      "end_seconds": 19.2,
      "duration_seconds": 7.83,
      "text": "Well, I've been having sharp pain on the right side when I breathe in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.48,
      "end_seconds": 22.45,
      "duration_seconds": 1.97,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.99,
      "end_seconds": 27.96,
      "duration_seconds": 3.97,
      "text": "Since this morning, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.33,
      "end_seconds": 48.89,
      "duration_seconds": 2.56,
      "text": "Any recent travel, confusion or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.43,
      "end_seconds": 55.16,
      "duration_seconds": 4.73,
      "text": "No recent travel, confusion or vomiting, none of it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.03,
      "end_seconds": 60.01,
      "duration_seconds": 3.98,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.97,
      "end_seconds": 63.51,
      "duration_seconds": 1.54,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.99,
      "end_seconds": 66.41,
      "duration_seconds": 1.42,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.34,
      "end_seconds": 72.32,
      "duration_seconds": 3.98,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.1,
      "end_seconds": 75.76,
      "duration_seconds": 2.66,
      "text": "So, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.64,
      "end_seconds": 81.92,
      "duration_seconds": 4.28,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.43,
      "end_seconds": 84.77,
      "duration_seconds": 2.34,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.85,
      "end_seconds": 90.62,
      "duration_seconds": 3.77,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.35,
      "end_seconds": 95.75,
      "duration_seconds": 3.4,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.11,
      "end_seconds": 103.18,
      "duration_seconds": 3.07,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.59,
      "end_seconds": 124.51,
      "duration_seconds": 4.92,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.25,
      "end_seconds": 130.29,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.49,
      "end_seconds": 134.8,
      "duration_seconds": 3.31,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.04,
      "end_seconds": 143.05,
      "duration_seconds": 2.01,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.59,
      "end_seconds": 146.64,
      "duration_seconds": 2.05,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.79,
      "end_seconds": 148.87,
      "duration_seconds": 1.08,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.02,
      "end_seconds": 154.32,
      "duration_seconds": 4.3,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.25,
      "end_seconds": 156.95,
      "duration_seconds": 1.7,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.7,
      "end_seconds": 161.42,
      "duration_seconds": 3.72,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.24,
      "end_seconds": 174.64,
      "duration_seconds": 2.4,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.29,
      "end_seconds": 204.95,
      "duration_seconds": 8.66,
      "text": "Okay: saturation 89 percent, temperature is 37.1 degrees, blood pressure 121 over 83, respiratory rate 24, pulse 86."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.81,
      "end_seconds": 207.17,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.94,
      "end_seconds": 215.46,
      "duration_seconds": 2.52,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.23,
      "end_seconds": 222.44,
      "duration_seconds": 4.21,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.95,
      "end_seconds": 226.36,
      "duration_seconds": 2.41,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 241.17,
      "duration_seconds": 2.6,
      "text": "Breathing rate is a bit fast."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.08,
      "end_seconds": 257.24,
      "duration_seconds": 1.16,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.73,
      "end_seconds": 260.79,
      "duration_seconds": 2.06,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.32,
      "end_seconds": 273.26,
      "duration_seconds": 3.94,
      "text": "There's bronchial breathing and crackles at the right lower zone."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.47,
      "end_seconds": 279.99,
      "duration_seconds": 3.52,
      "text": "Alright, good, you can sit up again."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.13,
      "end_seconds": 300.89,
      "duration_seconds": 3.76,
      "text": "Let's book a sputum culture to look into pneumonia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.81,
      "end_seconds": 304.3,
      "duration_seconds": 1.49,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.69,
      "end_seconds": 330.16,
      "duration_seconds": 22.47,
      "text": "You'll be taking amoxicillin-clavulanate, 625 milligrams, three times a day, for five days. You take it by mouth. That's for chest infection. Rest and fluids, and finish every dose of the antibiotic. Please don't wait if the breathlessness worsens or you become drowsy. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.95,
      "end_seconds": 333.25,
      "duration_seconds": 2.3,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.28,
      "end_seconds": 336.63,
      "duration_seconds": 2.35,
      "text": "See me again in three days."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.71,
      "end_seconds": 340.67,
      "duration_seconds": 1.96,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.03,
      "end_seconds": 346.87,
      "duration_seconds": 4.84,
      "text": "Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 348.6,
      "end_seconds": 351.88,
      "duration_seconds": 3.28,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.38,
      "end_seconds": 354.82,
      "duration_seconds": 1.44,
      "text": "Look after yourself."
    }
  ]
}