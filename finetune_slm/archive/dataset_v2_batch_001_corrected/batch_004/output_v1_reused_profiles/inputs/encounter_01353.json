{
  "schema_version": "1.0",
  "encounter_id": "01353",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 2.78,
      "duration_seconds": 1.52,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.44,
      "end_seconds": 8.97,
      "duration_seconds": 4.53,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.99,
      "end_seconds": 15.56,
      "duration_seconds": 4.57,
      "text": "It's a very painful, swollen big toe, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.41,
      "end_seconds": 20.63,
      "duration_seconds": 3.22,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.52,
      "end_seconds": 26.86,
      "duration_seconds": 3.34,
      "text": "I've had it for about four days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.74,
      "end_seconds": 34.49,
      "duration_seconds": 1.75,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.17,
      "end_seconds": 49.26,
      "duration_seconds": 14.09,
      "text": "I get some relief from ice. Oh, and a low fever. That's been about the same, about two weeks. Ah, with low fever, it happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.5,
      "end_seconds": 68.75,
      "duration_seconds": 3.25,
      "text": "Have you had rash, by any chance?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.49,
      "end_seconds": 73.57,
      "duration_seconds": 3.08,
      "text": "Not that I've noticed, no rash."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.8,
      "end_seconds": 79.16,
      "duration_seconds": 4.36,
      "text": "Right, on the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.92,
      "end_seconds": 84.15,
      "duration_seconds": 4.23,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.2,
      "end_seconds": 90.52,
      "duration_seconds": 4.32,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.2,
      "end_seconds": 104.54,
      "duration_seconds": 13.34,
      "text": "I drink a lot of tea and snack through the day. I hardly move around during the day. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.83,
      "end_seconds": 108.33,
      "duration_seconds": 2.5,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.59,
      "end_seconds": 111.36,
      "duration_seconds": 1.77,
      "text": "Yes, kidney disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.14,
      "end_seconds": 113.2,
      "duration_seconds": 1.06,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.95,
      "end_seconds": 125.22,
      "duration_seconds": 2.27,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.17,
      "end_seconds": 128.89,
      "duration_seconds": 1.72,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.2,
      "end_seconds": 132.88,
      "duration_seconds": 2.68,
      "text": "Okay, I'll do your observations first."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.8,
      "end_seconds": 146.53,
      "duration_seconds": 2.73,
      "text": "Right, nearly done with the readings..."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.97,
      "end_seconds": 175.98,
      "duration_seconds": 10.01,
      "text": "Okay: SpO2 97 percent on room air, respiratory rate 14, heart rate 72, temperature is 36.5 degrees, pressure 118 over 80."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.31,
      "end_seconds": 181.52,
      "duration_seconds": 4.21,
      "text": "Okay, I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.49,
      "end_seconds": 185.18,
      "duration_seconds": 1.69,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.44,
      "end_seconds": 188.96,
      "duration_seconds": 2.52,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.3,
      "end_seconds": 205.41,
      "duration_seconds": 6.11,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.69,
      "end_seconds": 211.98,
      "duration_seconds": 2.29,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.53,
      "end_seconds": 247.47,
      "duration_seconds": 17.94,
      "text": "So where does that leave us? The most likely explanation is an acute gout flare. Let me repeat that back to make sure. You've had a very painful, swollen big toe for about four days, and no rash."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.87,
      "end_seconds": 250.87,
      "duration_seconds": 2.0,
      "text": "Yes, you've got it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.62,
      "end_seconds": 291.08,
      "duration_seconds": 21.46,
      "text": "I'm sending you for kidney function tests because of gout. I'd rather check than guess, and this is the quickest way to know more. I'd like you to take colchicine, 0.5 milligrams, twice a day, for five days. You take it by mouth. It's for gout flare."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.74,
      "end_seconds": 294.36,
      "duration_seconds": 1.62,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.14,
      "end_seconds": 317.88,
      "duration_seconds": 21.74,
      "text": "Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. Let's hold off on a uric acid level for now, and if there's no change in a month we can revisit it. I'd like you back in a week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.08,
      "end_seconds": 321.31,
      "duration_seconds": 2.23,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.14,
      "end_seconds": 323.44,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}