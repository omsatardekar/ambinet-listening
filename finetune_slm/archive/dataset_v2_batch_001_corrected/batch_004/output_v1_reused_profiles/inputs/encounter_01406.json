{
  "schema_version": "1.0",
  "encounter_id": "01406",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 6.29,
      "duration_seconds": 5.03,
      "text": "hi, doctor, I came as soon as they called me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 11.58,
      "duration_seconds": 3.97,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.02,
      "end_seconds": 17.34,
      "duration_seconds": 4.32,
      "text": "It's pain in the neck and shoulders, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.4,
      "end_seconds": 21.82,
      "duration_seconds": 3.42,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.31,
      "end_seconds": 25.14,
      "duration_seconds": 1.83,
      "text": "Probably two years. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.47,
      "end_seconds": 30.22,
      "duration_seconds": 4.75,
      "text": "I see, go ahead. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.1,
      "end_seconds": 32.67,
      "duration_seconds": 1.57,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.32,
      "end_seconds": 39.08,
      "duration_seconds": 4.76,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.57,
      "end_seconds": 43.52,
      "duration_seconds": 2.95,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.7,
      "end_seconds": 55.12,
      "duration_seconds": 6.42,
      "text": "Any medical conditions, anything you've been treated for? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.2,
      "end_seconds": 57.71,
      "duration_seconds": 1.51,
      "text": "no, no conditions"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.91,
      "end_seconds": 66.98,
      "duration_seconds": 2.07,
      "text": "is there someone at home?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.1,
      "end_seconds": 71.89,
      "duration_seconds": 3.79,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.0,
      "end_seconds": 75.44,
      "duration_seconds": 2.44,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.65,
      "end_seconds": 79.85,
      "duration_seconds": 3.2,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.88,
      "end_seconds": 85.03,
      "duration_seconds": 4.15,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.56,
      "end_seconds": 88.54,
      "duration_seconds": 1.98,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.18,
      "end_seconds": 92.8,
      "duration_seconds": 2.62,
      "text": "Right, any regular medication at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.71,
      "end_seconds": 96.22,
      "duration_seconds": 1.51,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.26,
      "end_seconds": 101.5,
      "duration_seconds": 2.24,
      "text": "Did you notice any vomiting?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.09,
      "end_seconds": 104.48,
      "duration_seconds": 1.39,
      "text": "Definitely no vomiting."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.8,
      "end_seconds": 108.6,
      "duration_seconds": 2.8,
      "text": "Have you had any fever or numbness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.37,
      "end_seconds": 113.15,
      "duration_seconds": 3.78,
      "text": "I haven't had fever or numbness, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.54,
      "end_seconds": 117.35,
      "duration_seconds": 2.81,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.19,
      "end_seconds": 121.83,
      "duration_seconds": 2.64,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.97,
      "end_seconds": 140.72,
      "duration_seconds": 3.75,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.27,
      "end_seconds": 150.0,
      "duration_seconds": 2.73,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.6,
      "end_seconds": 168.86,
      "duration_seconds": 8.26,
      "text": "Okay: oxygen saturation is 99 percent, temperature is 36.8 degrees. And pulse 68, blood pressure 121 over 76."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.01,
      "end_seconds": 171.61,
      "duration_seconds": 1.6,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.38,
      "end_seconds": 176.98,
      "duration_seconds": 3.6,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.37,
      "end_seconds": 182.32,
      "duration_seconds": 2.95,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.66,
      "end_seconds": 194.56,
      "duration_seconds": 0.9,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.34,
      "end_seconds": 198.46,
      "duration_seconds": 2.12,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.84,
      "end_seconds": 219.14,
      "duration_seconds": 3.3,
      "text": "Your eye movements and and reflexes are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.39,
      "end_seconds": 222.83,
      "duration_seconds": 2.44,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.5,
      "end_seconds": 237.43,
      "duration_seconds": 4.93,
      "text": "The muscles at the back of your neck are tight and tender."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.09,
      "end_seconds": 257.61,
      "duration_seconds": 14.52,
      "text": "That's the examination finished. From what you've told me and what I found, I'd lean towards a tension-type headache. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.82,
      "end_seconds": 294.77,
      "duration_seconds": 22.95,
      "text": "Let's get an eye check, for headache and eye strain. We'll begin with amitriptyline, 10 milligrams, at night, for six weeks. That should help with headache prevention. Take a break from the screen every hour and do a few neck stretches. I'll want another look in four weeks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.64,
      "end_seconds": 299.14,
      "duration_seconds": 3.5,
      "text": "I'll note it it in my calendar"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.34,
      "end_seconds": 303.64,
      "duration_seconds": 3.3,
      "text": "Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.9,
      "end_seconds": 309.81,
      "duration_seconds": 2.91,
      "text": "Great, thank you for your help."
    }
  ]
}