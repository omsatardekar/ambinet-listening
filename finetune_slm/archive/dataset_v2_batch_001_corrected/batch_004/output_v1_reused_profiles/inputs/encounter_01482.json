{
  "schema_version": "1.0",
  "encounter_id": "01482",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.58,
      "end_seconds": 7.25,
      "duration_seconds": 6.67,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.81,
      "end_seconds": 16.88,
      "duration_seconds": 4.07,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 18.39,
      "end_seconds": 21.61,
      "duration_seconds": 3.22,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.51,
      "end_seconds": 26.55,
      "duration_seconds": 3.04,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.35,
      "end_seconds": 31.54,
      "duration_seconds": 3.19,
      "text": "He's been having been feeling low, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.19,
      "end_seconds": 35.66,
      "duration_seconds": 3.47,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.72,
      "end_seconds": 40.2,
      "duration_seconds": 2.48,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.91,
      "end_seconds": 44.42,
      "duration_seconds": 3.51,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.44,
      "end_seconds": 51.22,
      "duration_seconds": 4.78,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.81,
      "end_seconds": 55.71,
      "duration_seconds": 2.9,
      "text": "Yes, um, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.24,
      "end_seconds": 64.07,
      "duration_seconds": 7.83,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.87,
      "end_seconds": 69.3,
      "duration_seconds": 4.43,
      "text": "Work pressure definitely sets it off. It's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.45,
      "end_seconds": 73.01,
      "duration_seconds": 2.56,
      "text": "Has there been no energy too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.65,
      "end_seconds": 90.16,
      "duration_seconds": 16.51,
      "text": "Yeah. Two years, I'd say. With no energy, I'd call it mild. And a tight chest when stressed, too. As for tight chest when stressed, I'd call it mild."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.3,
      "end_seconds": 102.63,
      "duration_seconds": 3.33,
      "text": "Did you get weight loss or hearing voices?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.36,
      "end_seconds": 105.57,
      "duration_seconds": 2.21,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 110.71,
      "duration_seconds": 4.17,
      "text": "Did you get drinking more, panic attacks or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.55,
      "end_seconds": 114.84,
      "duration_seconds": 3.29,
      "text": "Okay, so none of those, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.49,
      "end_seconds": 118.48,
      "duration_seconds": 1.99,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.5,
      "end_seconds": 121.17,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.39,
      "end_seconds": 124.75,
      "duration_seconds": 2.36,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.26,
      "end_seconds": 128.07,
      "duration_seconds": 1.81,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.86,
      "end_seconds": 148.79,
      "duration_seconds": 3.93,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.34,
      "end_seconds": 158.26,
      "duration_seconds": 7.92,
      "text": "I had a reaction to tramadol when I was younger, vomiting, and I've avoided it since."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.9,
      "end_seconds": 162.35,
      "duration_seconds": 2.45,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.24,
      "end_seconds": 168.56,
      "duration_seconds": 4.32,
      "text": "I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 169.83,
      "end_seconds": 177.7,
      "duration_seconds": 7.87,
      "text": "He is supposed to take it once a day, but I can't say he always does."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.74,
      "end_seconds": 196.71,
      "duration_seconds": 2.97,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.73,
      "end_seconds": 199.39,
      "duration_seconds": 1.66,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.88,
      "end_seconds": 215.07,
      "duration_seconds": 10.19,
      "text": "Ah. Okay, I can see anxiety in your file as well. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.95,
      "end_seconds": 234.18,
      "duration_seconds": 17.23,
      "text": "I gave up cigarettes last spring. I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.85,
      "end_seconds": 238.21,
      "duration_seconds": 2.36,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.67,
      "end_seconds": 250.35,
      "duration_seconds": 2.68,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.7,
      "end_seconds": 272.61,
      "duration_seconds": 4.91,
      "text": "Okay: temperature 36.6, pulse 64, blood pressure 123 over 80."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.45,
      "end_seconds": 277.55,
      "duration_seconds": 2.1,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.85,
      "end_seconds": 280.88,
      "duration_seconds": 2.03,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.57,
      "end_seconds": 296.42,
      "duration_seconds": 5.85,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.05,
      "end_seconds": 324.17,
      "duration_seconds": 23.12,
      "text": "Okay, that's enough for me. Okay, so my impression is this: My working impression is low mood linked to work stress. It could also be an anxiety disorder, so we'll keep that open. Let me repeat that back to make sure. You've been feeling low, mild, and no chest pain or panic attacks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.03,
      "end_seconds": 325.73,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.08,
      "end_seconds": 339.95,
      "duration_seconds": 10.87,
      "text": "Let's get a blood count, for fatigue. Try a short walk each day and keep a regular bedtime. I'll also refer you to the talking therapies service."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.59,
      "end_seconds": 343.25,
      "duration_seconds": 1.66,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.74,
      "end_seconds": 365.68,
      "duration_seconds": 20.94,
      "text": "I'm not ordering a thyroid test today. If things carry on in two weeks, we'll consider it. Come back or go to emergency straight away if you have thoughts of harming yourself. I'd like you back in four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.47,
      "end_seconds": 370.66,
      "duration_seconds": 3.19,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}