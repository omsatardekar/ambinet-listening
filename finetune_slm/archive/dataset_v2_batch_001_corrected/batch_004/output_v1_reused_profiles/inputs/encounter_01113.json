{
  "schema_version": "1.0",
  "encounter_id": "01113",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.73,
      "duration_seconds": 3.87,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.25,
      "end_seconds": 10.26,
      "duration_seconds": 5.01,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.99,
      "end_seconds": 16.23,
      "duration_seconds": 4.24,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.72,
      "end_seconds": 21.1,
      "duration_seconds": 3.38,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.42,
      "end_seconds": 44.75,
      "duration_seconds": 20.33,
      "text": "It's irregular periods. I thought I'd wait, but it hasn't gone. I've also been putting on weight around the middle. I've also had excess hair on my face, since this morning. Oh, and acne along the jaw. Had that since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.84,
      "end_seconds": 49.64,
      "duration_seconds": 3.8,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.7,
      "end_seconds": 60.1,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.87,
      "end_seconds": 92.65,
      "duration_seconds": 10.78,
      "text": "Okay: SpO2 99 percent on room air, BP is 128 over 79. And pulse is 80 beats a minute, temperature 36.5."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.93,
      "end_seconds": 97.91,
      "duration_seconds": 3.98,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.68,
      "end_seconds": 103.16,
      "duration_seconds": 3.48,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.82,
      "end_seconds": 118.96,
      "duration_seconds": 6.14,
      "text": "Facial acne along the jaw and some dark coarse hair on the chin."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.83,
      "end_seconds": 123.63,
      "duration_seconds": 1.8,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.78,
      "end_seconds": 150.77,
      "duration_seconds": 8.99,
      "text": "Have you noticed milk from the breasts, headaches with vision changes, heavy bleeding or trying for a baby?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.59,
      "end_seconds": 154.21,
      "duration_seconds": 2.62,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.17,
      "end_seconds": 159.65,
      "duration_seconds": 4.48,
      "text": "Right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.05,
      "end_seconds": 163.59,
      "duration_seconds": 2.54,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.33,
      "end_seconds": 166.64,
      "duration_seconds": 2.31,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.72,
      "end_seconds": 177.77,
      "duration_seconds": 9.05,
      "text": "Yes, I had a bunion operation, six years ago. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.2,
      "end_seconds": 185.97,
      "duration_seconds": 6.77,
      "text": "So, do you take any prescribed or over-the-counter medicines? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.68,
      "end_seconds": 194.83,
      "duration_seconds": 8.15,
      "text": "It's losartan, 50 milligrams, once a day. Metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 200.63,
      "end_seconds": 209.6,
      "duration_seconds": 8.97,
      "text": "Doctor, I think the last prescription for the metoprolol was 25 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.46,
      "end_seconds": 217.27,
      "duration_seconds": 5.81,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.62,
      "end_seconds": 228.62,
      "duration_seconds": 10.0,
      "text": "I don't think I have it with me. Iron tablets. I take it once a day for my blood count."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.92,
      "end_seconds": 231.87,
      "duration_seconds": 1.95,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.66,
      "end_seconds": 238.43,
      "duration_seconds": 5.77,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.67,
      "end_seconds": 241.05,
      "duration_seconds": 1.38,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.86,
      "end_seconds": 245.79,
      "duration_seconds": 3.93,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.04,
      "end_seconds": 248.8,
      "duration_seconds": 1.76,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.44,
      "end_seconds": 254.89,
      "duration_seconds": 4.45,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.44,
      "end_seconds": 257.49,
      "duration_seconds": 2.05,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.52,
      "end_seconds": 262.99,
      "duration_seconds": 4.47,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.93,
      "end_seconds": 284.55,
      "duration_seconds": 4.62,
      "text": "Alright, any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.8,
      "end_seconds": 297.19,
      "duration_seconds": 11.39,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.63,
      "end_seconds": 304.63,
      "duration_seconds": 6.0,
      "text": "Do you have any chronic illnesses? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.01,
      "end_seconds": 309.47,
      "duration_seconds": 3.46,
      "text": "I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.16,
      "end_seconds": 313.14,
      "duration_seconds": 1.98,
      "text": "Right, any other things?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.7,
      "end_seconds": 322.18,
      "duration_seconds": 8.48,
      "text": "Heart disease, for nearly five years. I've had low haemoglobin for nearly five years now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.66,
      "end_seconds": 329.65,
      "duration_seconds": 5.99,
      "text": "Yes, carry on. Okay, I can see low haemoglobin in your file as well."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.08,
      "end_seconds": 371.37,
      "duration_seconds": 29.29,
      "text": "Taking everything into account, I think we're dealing with possible polycystic ovary syndrome at this stage. The reason I say that is that your story and my examination fit together. It could also be a thyroid problem, so we'll keep that open. Regular exercise and modest weight loss can bring cycles back. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.66,
      "end_seconds": 375.9,
      "duration_seconds": 3.24,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.5,
      "end_seconds": 379.1,
      "duration_seconds": 2.6,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 380.85,
      "end_seconds": 385.47,
      "duration_seconds": 4.62,
      "text": "Uh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.33,
      "end_seconds": 388.57,
      "duration_seconds": 1.24,
      "text": "Take care now."
    }
  ]
}