{
  "schema_version": "1.0",
  "encounter_id": "01204",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.68,
      "end_seconds": 3.7,
      "duration_seconds": 3.02,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.37,
      "end_seconds": 9.62,
      "duration_seconds": 5.25,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.42,
      "end_seconds": 15.42,
      "duration_seconds": 5.0,
      "text": "Well, so the thing is, I've got muffled hearing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.12,
      "end_seconds": 21.14,
      "duration_seconds": 4.02,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.08,
      "end_seconds": 31.28,
      "duration_seconds": 9.2,
      "text": "I take Seretide inhaler, twice a day for my asthma. I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.66,
      "end_seconds": 46.34,
      "duration_seconds": 1.68,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.07,
      "end_seconds": 52.47,
      "duration_seconds": 5.4,
      "text": "Two weeks, I think... sorry, one week, I got that wrong."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.46,
      "end_seconds": 56.56,
      "duration_seconds": 3.1,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.19,
      "end_seconds": 61.92,
      "duration_seconds": 3.73,
      "text": "I'd give it a eight, out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.58,
      "end_seconds": 65.84,
      "duration_seconds": 3.26,
      "text": "Alright, does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.63,
      "end_seconds": 82.98,
      "duration_seconds": 13.35,
      "text": "Actually, when it starts I tend to get a blocked feeling in the ear as well. Right, the blocked feeling in the ear? That's been for one week."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.7,
      "end_seconds": 87.89,
      "duration_seconds": 3.19,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.72,
      "end_seconds": 93.0,
      "duration_seconds": 4.28,
      "text": "A seven out of ten, um, I suppose."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.46,
      "end_seconds": 98.12,
      "duration_seconds": 3.66,
      "text": "Any recent swim, facial weakness or dizziness at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 103.72,
      "duration_seconds": 5.08,
      "text": "No recent swim, facial weakness or dizziness, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.52,
      "end_seconds": 111.05,
      "duration_seconds": 5.53,
      "text": "Any discharge from the ear or swelling behind the ear at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.83,
      "end_seconds": 119.03,
      "duration_seconds": 6.2,
      "text": "I haven't had discharge from the ear or swelling behind the ear, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.86,
      "end_seconds": 122.37,
      "duration_seconds": 2.51,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.1,
      "end_seconds": 125.17,
      "duration_seconds": 2.07,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.92,
      "end_seconds": 146.89,
      "duration_seconds": 3.97,
      "text": "Okay, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.91,
      "end_seconds": 150.36,
      "duration_seconds": 1.45,
      "text": "I've got asthma."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.25,
      "end_seconds": 154.84,
      "duration_seconds": 3.59,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.52,
      "end_seconds": 158.56,
      "duration_seconds": 2.04,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.11,
      "end_seconds": 162.93,
      "duration_seconds": 3.82,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.71,
      "end_seconds": 165.67,
      "duration_seconds": 1.96,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.75,
      "end_seconds": 174.21,
      "duration_seconds": 1.46,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.26,
      "end_seconds": 177.79,
      "duration_seconds": 1.53,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.7,
      "end_seconds": 184.47,
      "duration_seconds": 4.77,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.8,
      "end_seconds": 196.55,
      "duration_seconds": 10.75,
      "text": "I'm vegetarian and have been for years. I'm a hairdresser, on my feet all day. Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.21,
      "end_seconds": 200.14,
      "duration_seconds": 2.93,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.7,
      "end_seconds": 209.15,
      "duration_seconds": 2.45,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.21,
      "end_seconds": 230.15,
      "duration_seconds": 8.94,
      "text": "Okay: heart rate 107, blood pressure 112 over 72. And temperature is 38.3 degrees, saturation 95 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.28,
      "end_seconds": 235.62,
      "duration_seconds": 2.34,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.43,
      "end_seconds": 239.8,
      "duration_seconds": 2.37,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.0,
      "end_seconds": 244.43,
      "duration_seconds": 3.43,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.09,
      "end_seconds": 247.71,
      "duration_seconds": 1.62,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.66,
      "end_seconds": 252.1,
      "duration_seconds": 3.44,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.53,
      "end_seconds": 261.86,
      "duration_seconds": 2.33,
      "text": "The left ear looks normal."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.5,
      "end_seconds": 265.0,
      "duration_seconds": 1.5,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.12,
      "end_seconds": 268.17,
      "duration_seconds": 2.05,
      "text": "Okay, does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.57,
      "end_seconds": 289.75,
      "duration_seconds": 3.18,
      "text": "The right eardrum looks red and bulging."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.58,
      "end_seconds": 329.28,
      "duration_seconds": 33.7,
      "text": "You can relax now. Having listened and examined, this is probably a middle ear infection. The reason I say that is that your story and my examination fit together. A wax blockage is still possible. You'll be taking amoxicillin, 500 milligrams, three times a day, for five days. You take it by mouth. That's for ear infection. Keep the ear dry for now and don't put anything in it, including cotton buds."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.95,
      "end_seconds": 336.48,
      "duration_seconds": 4.53,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.47,
      "end_seconds": 340.41,
      "duration_seconds": 2.94,
      "text": "Great, thank you for your help."
    }
  ]
}