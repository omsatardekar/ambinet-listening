{
  "schema_version": "1.0",
  "encounter_id": "01219",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.31,
      "end_seconds": 5.45,
      "duration_seconds": 4.14,
      "text": "Ready for you, doctor. I'll stay in case you need anything."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.52,
      "end_seconds": 10.66,
      "duration_seconds": 4.14,
      "text": "Good, thank you. Welcome, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 18.34,
      "duration_seconds": 6.5,
      "text": "Erm, you know, I'm here because of trouble lifting my arm."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 19.82,
      "end_seconds": 27.11,
      "duration_seconds": 7.29,
      "text": "Okay, so the vitals from earlier. Respiratory rate 17, heart rate 74, BP is 120 over 81."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.35,
      "end_seconds": 33.3,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.72,
      "end_seconds": 53.5,
      "duration_seconds": 1.78,
      "text": "Alright, since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 54.97,
      "end_seconds": 57.92,
      "duration_seconds": 2.95,
      "text": "For two days, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.29,
      "end_seconds": 62.15,
      "duration_seconds": 2.86,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 63.92,
      "end_seconds": 65.05,
      "duration_seconds": 1.13,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.49,
      "end_seconds": 69.49,
      "duration_seconds": 3.0,
      "text": "Okay, does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 71.51,
      "end_seconds": 85.38,
      "duration_seconds": 13.87,
      "text": "When it starts I tend to get a click in the shoulder as well. The click in the shoulder? That's been for about two weeks."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.25,
      "end_seconds": 93.07,
      "duration_seconds": 5.82,
      "text": "Have you had trouble lifting your arm before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.07,
      "end_seconds": 100.96,
      "duration_seconds": 6.89,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.57,
      "end_seconds": 107.17,
      "duration_seconds": 5.6,
      "text": "Any chest pain, neck pain or numbness in the hand at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.68,
      "end_seconds": 110.57,
      "duration_seconds": 2.89,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.21,
      "end_seconds": 112.83,
      "duration_seconds": 1.62,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 113.42,
      "end_seconds": 115.35,
      "duration_seconds": 1.93,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.08,
      "end_seconds": 118.94,
      "duration_seconds": 2.86,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.59,
      "end_seconds": 123.27,
      "duration_seconds": 3.68,
      "text": "Uh, no, that side's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.89,
      "end_seconds": 129.23,
      "duration_seconds": 2.34,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 142.94,
      "duration_seconds": 13.17,
      "text": "Ramipril, 5 milligrams, every morning. It's, It's gliclazide, 80 milligrams, twice a day. Though honestly, you know, some days I forget to take it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.46,
      "end_seconds": 162.74,
      "duration_seconds": 3.28,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 163.32,
      "end_seconds": 169.18,
      "duration_seconds": 5.86,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.01,
      "end_seconds": 172.56,
      "duration_seconds": 2.55,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.07,
      "end_seconds": 177.01,
      "duration_seconds": 2.94,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 180.28,
      "duration_seconds": 1.78,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.54,
      "end_seconds": 186.27,
      "duration_seconds": 4.73,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.68,
      "end_seconds": 190.27,
      "duration_seconds": 2.59,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 195.12,
      "end_seconds": 203.19,
      "duration_seconds": 8.07,
      "text": "Yes, high blood pressure. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.17,
      "end_seconds": 206.0,
      "duration_seconds": 0.83,
      "text": "Anything else?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.8,
      "end_seconds": 215.57,
      "duration_seconds": 8.77,
      "text": "Diabetes, for nearly five years. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.39,
      "end_seconds": 227.42,
      "duration_seconds": 10.03,
      "text": "Sure. Right, so diabetes is already on your record. We'll keep that in mind today. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.79,
      "end_seconds": 232.1,
      "duration_seconds": 3.31,
      "text": "Actually, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.18,
      "end_seconds": 238.51,
      "duration_seconds": 5.33,
      "text": "Okay, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 239.54,
      "end_seconds": 242.81,
      "duration_seconds": 3.27,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.16,
      "end_seconds": 247.69,
      "duration_seconds": 3.53,
      "text": "Alright, any past operations I should know about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.51,
      "end_seconds": 261.86,
      "duration_seconds": 13.35,
      "text": "Erm, yes, I had my septum straightened, in my thirties. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.05,
      "end_seconds": 277.7,
      "duration_seconds": 14.65,
      "text": "Right, here's what I'm thinking. I think we're dealing with a rotator cuff problem at this stage. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.69,
      "end_seconds": 307.2,
      "duration_seconds": 21.51,
      "text": "An X-ray of the shoulder is what I'd like next, for shoulder pain. I'd like to arrange an ultrasound of the shoulder for shoulder pain. You'll be taking naproxen, 250 milligrams, twice a day after food, for five days. It's for shoulder pain."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.84,
      "end_seconds": 312.75,
      "duration_seconds": 3.91,
      "text": "Is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.99,
      "end_seconds": 322.81,
      "duration_seconds": 8.82,
      "text": "Gentle pendulum exercises, I'll show you a couple, but nothing overhead for a bit. See me again in three weeks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.24,
      "end_seconds": 327.52,
      "duration_seconds": 3.28,
      "text": "Yeah, alright, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.13,
      "end_seconds": 330.9,
      "duration_seconds": 2.77,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 332.36,
      "end_seconds": 335.22,
      "duration_seconds": 2.86,
      "text": "Erm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.25,
      "end_seconds": 337.42,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}