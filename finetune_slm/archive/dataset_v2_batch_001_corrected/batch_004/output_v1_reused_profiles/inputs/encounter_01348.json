{
  "schema_version": "1.0",
  "encounter_id": "01348",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 4.31,
      "duration_seconds": 3.23,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.38,
      "end_seconds": 9.57,
      "duration_seconds": 4.19,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 10.18,
      "end_seconds": 17.83,
      "duration_seconds": 7.65,
      "text": "Good afternoon, um, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.9,
      "end_seconds": 23.72,
      "duration_seconds": 3.82,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.89,
      "end_seconds": 29.68,
      "duration_seconds": 4.79,
      "text": "Well, I've been dealing with a feeling of blockage."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 30.37,
      "end_seconds": 39.9,
      "duration_seconds": 9.53,
      "text": "Here are the numbers, doctor. Heart rate 75, oxygen saturation is 99 percent. Temperature is 36.9 degrees, BP is 127 over 73."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.58,
      "end_seconds": 45.1,
      "duration_seconds": 2.52,
      "text": "Thanks. Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.92,
      "end_seconds": 53.65,
      "duration_seconds": 6.73,
      "text": "Mm, I'd say ten days. Actually, no, closer to three days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.89,
      "end_seconds": 58.13,
      "duration_seconds": 4.24,
      "text": "Right, right. How strong would you say it is?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.81,
      "end_seconds": 64.79,
      "duration_seconds": 4.98,
      "text": "Mostly severe. Mm, I've also had a bit of discharge."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.83,
      "end_seconds": 69.47,
      "duration_seconds": 3.64,
      "text": "Has there been an itchy painful right ear too?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.38,
      "end_seconds": 73.24,
      "duration_seconds": 1.86,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.94,
      "end_seconds": 78.71,
      "duration_seconds": 3.77,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.28,
      "end_seconds": 101.91,
      "duration_seconds": 21.63,
      "text": "It feels mild to me. Hmm, um, and there's muffled hearing on that side as well, six months now. Oh, as for muffled hearing on that side, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.44,
      "end_seconds": 108.68,
      "duration_seconds": 6.24,
      "text": "Have you had a feeling of blockage before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.32,
      "end_seconds": 115.19,
      "duration_seconds": 5.87,
      "text": "Mm, a bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.31,
      "end_seconds": 119.83,
      "duration_seconds": 3.52,
      "text": "A few quick ones: dizziness or facial weakness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.26,
      "end_seconds": 123.96,
      "duration_seconds": 2.7,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.94,
      "end_seconds": 130.89,
      "duration_seconds": 4.95,
      "text": "A few quick ones: recent cold, fever or swelling behind the ear?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.82,
      "end_seconds": 135.39,
      "duration_seconds": 3.57,
      "text": "Well, no, not a single one."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.45,
      "end_seconds": 140.32,
      "duration_seconds": 2.87,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.0,
      "end_seconds": 142.55,
      "duration_seconds": 1.55,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.76,
      "end_seconds": 158.22,
      "duration_seconds": 2.46,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.87,
      "end_seconds": 168.81,
      "duration_seconds": 5.94,
      "text": "I have eczema, for about a year. Diabetes, for five years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.51,
      "end_seconds": 174.17,
      "duration_seconds": 4.66,
      "text": "Understood. What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.83,
      "end_seconds": 178.88,
      "duration_seconds": 4.05,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.27,
      "end_seconds": 181.75,
      "duration_seconds": 1.48,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.73,
      "end_seconds": 187.25,
      "duration_seconds": 3.52,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.24,
      "end_seconds": 192.01,
      "duration_seconds": 2.77,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.98,
      "end_seconds": 200.2,
      "duration_seconds": 6.22,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.2,
      "end_seconds": 204.82,
      "duration_seconds": 2.62,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.51,
      "end_seconds": 219.15,
      "duration_seconds": 12.64,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.81,
      "end_seconds": 222.09,
      "duration_seconds": 2.28,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 223.52,
      "end_seconds": 227.12,
      "duration_seconds": 3.6,
      "text": "Well, she takes hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.24,
      "end_seconds": 233.77,
      "duration_seconds": 5.53,
      "text": "I had glimepiride at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.95,
      "end_seconds": 237.05,
      "duration_seconds": 2.1,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.29,
      "end_seconds": 257.98,
      "duration_seconds": 2.69,
      "text": "Yes, uh, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.16,
      "end_seconds": 261.04,
      "duration_seconds": 1.88,
      "text": "Right, does that hurt?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.89,
      "end_seconds": 283.9,
      "duration_seconds": 4.01,
      "text": "I can't see the eardrum properly because of the swelling."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.23,
      "end_seconds": 286.44,
      "duration_seconds": 1.21,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.42,
      "end_seconds": 302.04,
      "duration_seconds": 6.62,
      "text": "The ear canal is red and swollen with some debris, and pulling the ear hurts."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.52,
      "end_seconds": 320.62,
      "duration_seconds": 14.1,
      "text": "Alright, thank you, you can get dressed. Having listened and examined, the most likely explanation is an outer ear infection. I'd also keep a wax problem in mind."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.83,
      "end_seconds": 324.07,
      "duration_seconds": 2.24,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.01,
      "end_seconds": 331.15,
      "duration_seconds": 6.14,
      "text": "Nothing I've seen today points to an emergency. It looks like an outer ear infection."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.06,
      "end_seconds": 374.18,
      "duration_seconds": 27.12,
      "text": "I'm going to put you on ciprofloxacin ear drops, three times a day, for seven days. It's for outer ear infection. Keep water out of the ear and don't use cotton buds. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. I'll want another look in a week."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 375.87,
      "end_seconds": 379.35,
      "duration_seconds": 3.48,
      "text": "Okay, um, I'll arrange it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.64,
      "end_seconds": 387.47,
      "duration_seconds": 3.83,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.55,
      "end_seconds": 394.16,
      "duration_seconds": 4.61,
      "text": "Um, great, thank you for your help."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.7,
      "end_seconds": 397.04,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}