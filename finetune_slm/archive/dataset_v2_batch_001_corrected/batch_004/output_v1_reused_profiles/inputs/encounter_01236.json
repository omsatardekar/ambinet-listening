  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 7.22,
      "duration_seconds": 6.13,
      "text": "I mean, you know, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.83,
      "end_seconds": 12.52,
      "duration_seconds": 3.69,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.51,
      "end_seconds": 20.88,
      "duration_seconds": 6.37,
      "text": "yeah, it's being very thirsty i don't know what's causing it"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.71,
      "end_seconds": 28.44,
      "duration_seconds": 5.73,
      "text": "what's the timeline, when did it begin? I'll explain everything as we go along"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.32,
      "end_seconds": 35.43,
      "duration_seconds": 6.11,
      "text": "Two weeks, I think... sorry, four weeks, I got that wrong"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.84,
      "end_seconds": 39.83,
      "duration_seconds": 2.99,
      "text": "how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.86,
      "end_seconds": 49.13,
      "duration_seconds": 7.27,
      "text": "it's, It's severe, honestly. Hmm, I've had recurrent thrush too, for six months"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.48,
      "end_seconds": 54.55,
      "duration_seconds": 4.07,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.89,
      "end_seconds": 60.62,
      "duration_seconds": 4.73,
      "text": "I've had high blood pressure for five years now"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.9,
      "end_seconds": 62.8,
      "duration_seconds": 0.9,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.2,
      "end_seconds": 65.83,
      "duration_seconds": 1.63,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.63,
      "end_seconds": 67.33,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.4,
      "end_seconds": 91.3,
      "duration_seconds": 5.9,
      "text": "Has anything ever caused you a a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.93,
      "end_seconds": 98.08,
      "duration_seconds": 2.15,
      "text": "no allergies at all"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.77,
      "end_seconds": 115.9,
      "duration_seconds": 3.13,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.66,
      "end_seconds": 125.5,
      "duration_seconds": 7.84,
      "text": "Um, I take something called rami... ramipril, 5 milligrams, maybe, every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.07,
      "end_seconds": 130.62,
      "duration_seconds": 4.55,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.28,
      "end_seconds": 144.87,
      "duration_seconds": 10.59,
      "text": "Yeah, you know, no, it's at home. I take simvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.81,
      "end_seconds": 149.78,
      "duration_seconds": 2.97,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.13,
      "end_seconds": 154.23,
      "duration_seconds": 3.1,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.85,
      "end_seconds": 156.87,
      "duration_seconds": 2.02,
      "text": "do you get out much?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.1,
      "end_seconds": 162.55,
      "duration_seconds": 4.45,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.97,
      "end_seconds": 182.51,
      "duration_seconds": 4.54,
      "text": "and what about vomiting, fruity smelling breath or abdominal pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.48,
      "end_seconds": 186.71,
      "duration_seconds": 3.23,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.79,
      "end_seconds": 191.65,
      "duration_seconds": 3.86,
      "text": "A few quick ones: chest pain or confusion?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.18,
      "end_seconds": 196.24,
      "duration_seconds": 4.06,
      "text": "Uh, uh, nope, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.51,
      "end_seconds": 202.1,
      "duration_seconds": 2.59,
      "text": "so, your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.03,
      "end_seconds": 205.85,
      "duration_seconds": 2.82,
      "text": "No, you know, nothing there."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.52,
      "end_seconds": 210.94,
      "duration_seconds": 4.42,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 212.62,
      "end_seconds": 215.38,
      "duration_seconds": 2.76,
      "text": "erm, no, all normal there"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.89,
      "end_seconds": 219.32,
      "duration_seconds": 2.43,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.16,
      "end_seconds": 231.51,
      "duration_seconds": 2.35,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.11,
      "end_seconds": 255.39,
      "duration_seconds": 11.28,
      "text": "okay: temp 36.9 degrees, SpO2 99 percent on room air, blood pressure 169 over 96. And pulse is 90 beats a minute"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.65,
      "end_seconds": 258.9,
      "duration_seconds": 2.25,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.86,
      "end_seconds": 262.26,
      "duration_seconds": 2.4,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.01,
      "end_seconds": 285.76,
      "duration_seconds": 6.75,
      "text": "Your fingerprick sugar here is high, and and your feet have good pulses and normal feeling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.97,
      "end_seconds": 307.28,
      "duration_seconds": 18.31,
      "text": "all finished, thank you. Taking everything into account, I'd lean towards symptoms that point to newly developed type 2 diabetes. I wanna be honest that this is an impression, not a final answer. It could also be an overactive thyroid, so we'll keep that open"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.26,
      "end_seconds": 313.36,
      "duration_seconds": 3.1,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.41,
      "end_seconds": 332.57,
      "duration_seconds": 17.16,
      "text": "I understand the worry. At the moment I'd say it's symptoms that point to newly developed type 2 diabetes, and we'll know more once the an HbA1c is back. We should do an HbA1c for suspected diabetes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.18,
      "end_seconds": 335.25,
      "duration_seconds": 2.07,
      "text": "right, um, understood"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.25,
      "end_seconds": 365.84,
      "duration_seconds": 29.59,
      "text": "We should do a fasting blood sugar for thirst and polyuria. Let's get a urine test, for polyuria. It's a routine test and it'll give us a much clearer picture. I'm prescribing metformin, 500 milligrams, once a day with food, long term. It's for high blood sugar. Cut right down on sugary drinks and keep water with you. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 367.18,
      "end_seconds": 389.31,
      "duration_seconds": 22.13,
      "text": "I think the diabetes educator should see you too. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Please don't wait if you are vomiting or feel confused. That's when to be seen urgently. We'll catch up after the blood results."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.91,
      "end_seconds": 390.61,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.68,
      "end_seconds": 397.63,
      "duration_seconds": 4.95,
      "text": "How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.21,
      "end_seconds": 412.25,
      "duration_seconds": 13.04,
      "text": "so, I take the metformin, 500 milligrams, once a day with food and come back after the blood results. Is that right?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.86,
      "end_seconds": 417.61,
      "duration_seconds": 3.75,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 419.68,
      "end_seconds": 423.01,
      "duration_seconds": 3.33,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 428.65,
      "end_seconds": 429.83,
      "duration_seconds": 1.18,
      "text": "all the best"
    }
  ]
}