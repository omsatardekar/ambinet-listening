{
  "schema_version": "1.0",
  "encounter_id": "01283",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 7.78,
      "duration_seconds": 6.47,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.64,
      "end_seconds": 13.22,
      "duration_seconds": 4.58,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.57,
      "end_seconds": 16.96,
      "duration_seconds": 2.39,
      "text": "It's a gritty feeling, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.09,
      "end_seconds": 21.12,
      "duration_seconds": 3.03,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.17,
      "end_seconds": 25.26,
      "duration_seconds": 2.09,
      "text": "About... well, one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.15,
      "end_seconds": 29.69,
      "duration_seconds": 2.54,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.38,
      "end_seconds": 41.64,
      "duration_seconds": 10.26,
      "text": "Uh, um, about a seven out of ten. So, and there's watering as well, about two weeks now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.58,
      "end_seconds": 45.21,
      "duration_seconds": 2.63,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.32,
      "end_seconds": 48.47,
      "duration_seconds": 2.15,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.64,
      "end_seconds": 58.91,
      "duration_seconds": 7.27,
      "text": "Let me check a few things. Any pain in the eye, cold or sensitivity to light?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.88,
      "end_seconds": 63.58,
      "duration_seconds": 2.7,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.95,
      "end_seconds": 66.73,
      "duration_seconds": 1.78,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.96,
      "end_seconds": 68.89,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.71,
      "end_seconds": 73.37,
      "duration_seconds": 2.66,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.47,
      "end_seconds": 86.7,
      "duration_seconds": 12.23,
      "text": "Eczema, for about ten years. I told myself I'd wait and see, and here I am. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.02,
      "end_seconds": 100.1,
      "duration_seconds": 4.08,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.1,
      "end_seconds": 106.67,
      "duration_seconds": 5.57,
      "text": "So, I'm allergic to diclofenac, I get swelling of my lips."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.62,
      "end_seconds": 109.9,
      "duration_seconds": 1.28,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.59,
      "end_seconds": 114.71,
      "duration_seconds": 4.12,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.49,
      "end_seconds": 116.85,
      "duration_seconds": 1.36,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.51,
      "end_seconds": 121.19,
      "duration_seconds": 2.68,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.53,
      "end_seconds": 124.98,
      "duration_seconds": 2.45,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.77,
      "end_seconds": 130.19,
      "duration_seconds": 3.42,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.8,
      "end_seconds": 132.76,
      "duration_seconds": 1.96,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.58,
      "end_seconds": 139.1,
      "duration_seconds": 4.52,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.18,
      "end_seconds": 143.32,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.46,
      "end_seconds": 146.74,
      "duration_seconds": 2.28,
      "text": "Hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.88,
      "end_seconds": 150.03,
      "duration_seconds": 2.15,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.67,
      "end_seconds": 164.26,
      "duration_seconds": 12.59,
      "text": "Yes, I had a mole taken off my arm, a few years ago. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.35,
      "end_seconds": 170.08,
      "duration_seconds": 3.73,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.11,
      "end_seconds": 181.06,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.95,
      "end_seconds": 186.26,
      "duration_seconds": 3.31,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.23,
      "end_seconds": 203.79,
      "duration_seconds": 5.56,
      "text": "Your vision is normal on the chart and the pupil reacts well."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.76,
      "end_seconds": 206.23,
      "duration_seconds": 1.47,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.43,
      "end_seconds": 231.57,
      "duration_seconds": 7.14,
      "text": "The white of the eye is pink all over, and there's some sticky discharge on the lashes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.48,
      "end_seconds": 238.58,
      "duration_seconds": 2.1,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.0,
      "end_seconds": 256.07,
      "duration_seconds": 4.07,
      "text": "Having listened and examined, it fits best with conjunctivitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.67,
      "end_seconds": 259.1,
      "duration_seconds": 1.43,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.9,
      "end_seconds": 267.71,
      "duration_seconds": 6.81,
      "text": "Nothing I've seen today points to an emergency. It looks like conjunctivitis, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.5,
      "end_seconds": 295.62,
      "duration_seconds": 16.12,
      "text": "I'm sending you for an eye swab because of red eye. I'll start you on chloramphenicol eye drops, four times a day, for five days. That's for conjunctivitis. Wash your hands often, don't share towels, and don't rub the eye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.16,
      "end_seconds": 314.04,
      "duration_seconds": 17.88,
      "text": "Right, right. Make sure you're drinking plenty of fluids, two to three litres a day if you can, and get proper rest. Come back if it's not better in three days. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.11,
      "end_seconds": 327.64,
      "duration_seconds": 12.53,
      "text": "So, I take the chloramphenicol eye drops, four times a day and come back if it's not better in three days. Is that right?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.05,
      "end_seconds": 334.1,
      "duration_seconds": 5.05,
      "text": "Yes, exactly right. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.98,
      "end_seconds": 339.2,
      "duration_seconds": 3.22,
      "text": "Thank you, uh, doctor, goodbye."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.1,
      "end_seconds": 342.57,
      "duration_seconds": 1.47,
      "text": "Look after yourself."
    }
  ]
}