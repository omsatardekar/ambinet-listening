{
  "schema_version": "1.0",
  "encounter_id": "01012",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.07,
      "end_seconds": 4.3,
      "duration_seconds": 3.23,
      "text": "good morning i've just opened your notes"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.1,
      "end_seconds": 13.04,
      "duration_seconds": 6.94,
      "text": "so, uh, hi doctor, I got here as fast as I could"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.22,
      "end_seconds": 17.66,
      "duration_seconds": 3.44,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.19,
      "end_seconds": 24.04,
      "duration_seconds": 4.85,
      "text": "Mainly I've been feeling weak. That's why I came."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.9,
      "end_seconds": 27.83,
      "duration_seconds": 2.93,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.87,
      "end_seconds": 31.1,
      "duration_seconds": 2.23,
      "text": "about... well, five days"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.44,
      "end_seconds": 35.32,
      "duration_seconds": 3.88,
      "text": "mm-hmm is it bearing on you a a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.3,
      "end_seconds": 49.16,
      "duration_seconds": 12.86,
      "text": "Severe, I'd say. Oh, and nearly blacking out. Had that since last weekend. About nearly blacking out, it's a couple of times a week."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.82,
      "end_seconds": 52.8,
      "duration_seconds": 1.98,
      "text": "any palpitations or slurred speech?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.64,
      "end_seconds": 60.03,
      "duration_seconds": 5.39,
      "text": "Right, no palpitations or slurred speech, none of it."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.32,
      "end_seconds": 64.67,
      "duration_seconds": 3.35,
      "text": "And what about fainting or black stools?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.7,
      "end_seconds": 71.23,
      "duration_seconds": 4.53,
      "text": "I haven't had fainting or black stools, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.99,
      "end_seconds": 76.3,
      "duration_seconds": 3.31,
      "text": "how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.85,
      "end_seconds": 78.57,
      "duration_seconds": 1.72,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.52,
      "end_seconds": 83.42,
      "duration_seconds": 2.9,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 85.27,
      "end_seconds": 86.44,
      "duration_seconds": 1.17,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.28,
      "end_seconds": 97.31,
      "duration_seconds": 2.03,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.12,
      "end_seconds": 105.4,
      "duration_seconds": 6.28,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. Tamsulosin i take it at night"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.41,
      "end_seconds": 110.78,
      "duration_seconds": 2.37,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.22,
      "end_seconds": 121.42,
      "duration_seconds": 8.2,
      "text": "0.4 milligrams right, I'd been on metoprolol, not any more though, I stopped"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.17,
      "end_seconds": 124.69,
      "duration_seconds": 2.52,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.29,
      "end_seconds": 132.08,
      "duration_seconds": 5.79,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.05,
      "end_seconds": 151.66,
      "duration_seconds": 3.61,
      "text": "has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.75,
      "end_seconds": 157.07,
      "duration_seconds": 3.32,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.74,
      "end_seconds": 162.78,
      "duration_seconds": 4.04,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.54,
      "end_seconds": 171.35,
      "duration_seconds": 6.81,
      "text": "Well, um, I've had high blood pressure for nearly five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.94,
      "end_seconds": 173.64,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.43,
      "end_seconds": 184.21,
      "duration_seconds": 8.78,
      "text": "I have an enlarged prostate. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.02,
      "end_seconds": 196.73,
      "duration_seconds": 10.71,
      "text": "Yes, an enlarged prostate is known to us, good to have that clear. Alright, did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 197.78,
      "end_seconds": 203.02,
      "duration_seconds": 5.24,
      "text": "Yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.99,
      "end_seconds": 205.54,
      "duration_seconds": 1.55,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.21,
      "end_seconds": 212.0,
      "duration_seconds": 4.79,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 212.58,
      "end_seconds": 214.05,
      "duration_seconds": 1.47,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.48,
      "end_seconds": 219.68,
      "duration_seconds": 4.2,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.44,
      "end_seconds": 221.86,
      "duration_seconds": 1.42,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 223.43,
      "end_seconds": 227.32,
      "duration_seconds": 3.89,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.93,
      "end_seconds": 231.29,
      "duration_seconds": 2.36,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 232.25,
      "end_seconds": 236.27,
      "duration_seconds": 4.02,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.82,
      "end_seconds": 238.86,
      "duration_seconds": 2.04,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.53,
      "end_seconds": 243.77,
      "duration_seconds": 4.24,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.12,
      "end_seconds": 261.78,
      "duration_seconds": 2.66,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 269.67,
      "end_seconds": 271.69,
      "duration_seconds": 2.02,
      "text": "sit still for a moment.."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.91,
      "end_seconds": 288.47,
      "duration_seconds": 6.56,
      "text": "Okay: heart rate 105, temperature is 36.5 degrees, pressure 98 over 56."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.96,
      "end_seconds": 295.1,
      "duration_seconds": 4.14,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.15,
      "end_seconds": 297.39,
      "duration_seconds": 1.24,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.98,
      "end_seconds": 320.75,
      "duration_seconds": 6.77,
      "text": "Your blood pressure drops when you stand, from the the lying reading to standing."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.76,
      "end_seconds": 322.99,
      "duration_seconds": 1.23,
      "text": "of course"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.94,
      "end_seconds": 347.33,
      "duration_seconds": 18.39,
      "text": "Thank you, you can get dressed. Having listened and examined, I'd lean towards postural low blood pressure, possibly related to medicines or dehydration. I want to be honest that this is an impression, not a final answer. An abnormal heart rhythm is still possible."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 349.38,
      "end_seconds": 352.9,
      "duration_seconds": 3.52,
      "text": "Ah, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.11,
      "end_seconds": 379.96,
      "duration_seconds": 21.85,
      "text": "It's reasonable to be concerned, but right now postural low blood pressure, possibly related to medicines or dehydration is my leading thought, not anything worse. I want a lying and standing blood pressure check done, that's for dizziness. I think blood tests makes sense here, for dizziness."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 380.8,
      "end_seconds": 381.93,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.87,
      "end_seconds": 393.39,
      "duration_seconds": 6.52,
      "text": "Get up slowly from lying and sitting, and and keep drinking fluids through the day."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 395.27,
      "end_seconds": 399.03,
      "duration_seconds": 3.76,
      "text": "Can you send me for an ECG?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.89,
      "end_seconds": 417.1,
      "duration_seconds": 14.21,
      "text": "Alright, I don't think that's needed at this stage, the history doesn't call for it. I'd like you back in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 418.33,
      "end_seconds": 421.76,
      "duration_seconds": 3.43,
      "text": "Thank you, um, that's helpful."
    }
  ]
}