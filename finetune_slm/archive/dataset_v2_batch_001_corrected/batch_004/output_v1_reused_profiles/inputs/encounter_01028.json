{
  "schema_version": "1.0",
  "encounter_id": "01028",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.08,
      "end_seconds": 8.21,
      "duration_seconds": 7.13,
      "text": "Doctor, your next patient is here. I've done the basics, I'll read them out in a moment."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.16,
      "end_seconds": 14.87,
      "duration_seconds": 4.71,
      "text": "alright, perfect, thanks hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 16.02,
      "end_seconds": 20.12,
      "duration_seconds": 4.1,
      "text": "okay, so doctor, thank you for seeing us"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.49,
      "end_seconds": 23.99,
      "duration_seconds": 2.5,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 27.71,
      "end_seconds": 36.13,
      "duration_seconds": 8.42,
      "text": "Erm, um, it's not opening my bowels, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.03,
      "end_seconds": 40.58,
      "duration_seconds": 3.55,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.12,
      "end_seconds": 45.82,
      "duration_seconds": 3.7,
      "text": "Thyronorm. I take it 50 micrograms every morning."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 47.27,
      "end_seconds": 54.11,
      "duration_seconds": 6.84,
      "text": "it's meant to be every morning, though I don't see he take it every time"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 54.67,
      "end_seconds": 57.87,
      "duration_seconds": 3.2,
      "text": "I'm on febuxostat once a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.43,
      "end_seconds": 60.56,
      "duration_seconds": 2.13,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 61.18,
      "end_seconds": 65.86,
      "duration_seconds": 4.68,
      "text": "80 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.89,
      "end_seconds": 69.64,
      "duration_seconds": 2.75,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 70.18,
      "end_seconds": 72.37,
      "duration_seconds": 2.19,
      "text": "for about a month"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.26,
      "end_seconds": 76.0,
      "duration_seconds": 2.74,
      "text": "has this been going on for long?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.52,
      "end_seconds": 80.07,
      "duration_seconds": 3.55,
      "text": "it's been going on for two years"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.7,
      "end_seconds": 84.39,
      "duration_seconds": 2.69,
      "text": "Have you tried anything for it?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 86.35,
      "end_seconds": 90.15,
      "duration_seconds": 3.8,
      "text": "Only prune juice, and it's not much."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 90.71,
      "end_seconds": 96.54,
      "duration_seconds": 5.83,
      "text": "I was just gonna say that that the main thing is—"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 96.64,
      "end_seconds": 103.29,
      "duration_seconds": 6.65,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.24,
      "end_seconds": 107.79,
      "duration_seconds": 2.55,
      "text": "later, thanks. Please go on"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 109.85,
      "end_seconds": 122.21,
      "duration_seconds": 12.36,
      "text": "Oh and a bloated tummy. That's been about the same four weeks. I had hard small stools before. That's settled now though."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 123.5,
      "end_seconds": 126.0,
      "duration_seconds": 2.5,
      "text": "yes, exactly like that that"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.29,
      "end_seconds": 129.78,
      "duration_seconds": 2.49,
      "text": "Did you notice any black stools?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 131.86,
      "end_seconds": 135.28,
      "duration_seconds": 3.42,
      "text": "no, I haven't had any black stools"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.03,
      "end_seconds": 141.09,
      "duration_seconds": 4.06,
      "text": "Have you noticed passing wind, weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 142.35,
      "end_seconds": 147.03,
      "duration_seconds": 4.68,
      "text": "no, um, I haven't had any of them"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.22,
      "end_seconds": 156.65,
      "duration_seconds": 4.43,
      "text": "Did you get blood in the stool or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 157.32,
      "end_seconds": 163.1,
      "duration_seconds": 5.78,
      "text": "no, no blood in the stool or severe abdominal pain"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.17,
      "end_seconds": 166.54,
      "duration_seconds": 2.37,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 167.88,
      "end_seconds": 168.92,
      "duration_seconds": 1.04,
      "text": "breathing's normal"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.03,
      "end_seconds": 187.44,
      "duration_seconds": 2.41,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 189.22,
      "end_seconds": 199.35,
      "duration_seconds": 10.13,
      "text": "An underactive thyroid, for five years. I've had arthritis in my knees, yes. I have gout, for nearly five years"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.2,
      "end_seconds": 213.39,
      "duration_seconds": 10.19,
      "text": "Hm, okay. Alright, arthritis in your knees and gout, that matches what I have here. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 214.3,
      "end_seconds": 227.3,
      "duration_seconds": 13.0,
      "text": "I'll have a glass of wine with dinner. I have about eight cigarettes in a day. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.55,
      "end_seconds": 236.83,
      "duration_seconds": 5.28,
      "text": "are you allergic to anything? Any allergies to to medicines or foods?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 238.56,
      "end_seconds": 250.18,
      "duration_seconds": 11.62,
      "text": "Hmm there was some antibiotic I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.89,
      "end_seconds": 253.43,
      "duration_seconds": 2.54,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 254.07,
      "end_seconds": 256.95,
      "duration_seconds": 2.88,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.54,
      "end_seconds": 275.12,
      "duration_seconds": 4.58,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.81,
      "end_seconds": 278.97,
      "duration_seconds": 3.16,
      "text": "well, my father had bowel cancer"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 280.01,
      "end_seconds": 289.59,
      "duration_seconds": 9.58,
      "text": "doctor, I've got the readings for you. Blood pressure 122 over 71, heart rate 76, SpO2 97 percent on room air"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.12,
      "end_seconds": 291.43,
      "duration_seconds": 1.31,
      "text": "Good thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.05,
      "end_seconds": 296.5,
      "duration_seconds": 2.45,
      "text": "may I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.7,
      "end_seconds": 299.48,
      "duration_seconds": 1.78,
      "text": "let me feel here"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.09,
      "end_seconds": 318.53,
      "duration_seconds": 5.44,
      "text": "There is firm stool in the left lower abdomen and no mass."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.97,
      "end_seconds": 336.39,
      "duration_seconds": 13.42,
      "text": "good you can sit up again. Right here's what I'm thinking. I don't have a clear answer today: constipation, possibly related to diet or medicines is possible and so is low fibre intake"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 337.23,
      "end_seconds": 341.36,
      "duration_seconds": 4.13,
      "text": "um, is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.3,
      "end_seconds": 358.42,
      "duration_seconds": 15.12,
      "text": "I understand the worry. At the moment I'd say it's constipation, possibly related to diet or medicines, and we'll know more once the blood tests is back. I'll request blood tests, it'll help with constipation."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 359.48,
      "end_seconds": 360.65,
      "duration_seconds": 1.17,
      "text": "right, understood"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.62,
      "end_seconds": 375.44,
      "duration_seconds": 13.82,
      "text": "I'm sending you for a blood count because of constipation i'd like you to take macrogol, 1 sachet, once a day, for two weeks that should help with constipation"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 376.0,
      "end_seconds": 378.81,
      "duration_seconds": 2.81,
      "text": "Alright, I'll pick it up today."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.36,
      "end_seconds": 413.62,
      "duration_seconds": 33.26,
      "text": "more fibre plenty of water and a regular time on the toilet after breakfast. Don't skip meals and try to eat smaller portions more often through the day. If you are unable to pass wind or have severe tummy pain or you feel really unwell please come to the emergency department. Let's plan a check if it isn't working in a week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 414.65,
      "end_seconds": 418.83,
      "duration_seconds": 4.18,
      "text": "hmm, I think I understand everything thanks"
    }
  ]
}