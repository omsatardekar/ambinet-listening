{
  "schema_version": "1.0",
  "encounter_id": "01298",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.34,
      "end_seconds": 7.0,
      "duration_seconds": 5.66,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.66,
      "end_seconds": 13.76,
      "duration_seconds": 5.1,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.51,
      "end_seconds": 23.17,
      "duration_seconds": 5.66,
      "text": "I wanted to get a mole that has changed looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.07,
      "end_seconds": 26.6,
      "duration_seconds": 2.53,
      "text": "Right, did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.85,
      "end_seconds": 40.89,
      "duration_seconds": 10.04,
      "text": "Um, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.18,
      "end_seconds": 44.71,
      "duration_seconds": 2.53,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 48.68,
      "end_seconds": 58.87,
      "duration_seconds": 10.19,
      "text": "It usually comes with a bit of itching on it. The bit of itching on it? That's been for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.14,
      "end_seconds": 63.43,
      "duration_seconds": 4.29,
      "text": "I see, go ahead. Any it's got darker as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 64.21,
      "end_seconds": 67.17,
      "duration_seconds": 2.96,
      "text": "Right, yes, for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.86,
      "end_seconds": 77.88,
      "duration_seconds": 5.02,
      "text": "Have you noticed pain, history of sunburn or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.66,
      "end_seconds": 81.56,
      "duration_seconds": 2.9,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.25,
      "end_seconds": 85.86,
      "duration_seconds": 3.61,
      "text": "Have you had any history of skin cancer?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 87.92,
      "end_seconds": 90.88,
      "duration_seconds": 2.96,
      "text": "No, no history of skin cancer."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.41,
      "end_seconds": 96.39,
      "duration_seconds": 3.98,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.25,
      "end_seconds": 101.56,
      "duration_seconds": 3.31,
      "text": "No, you know, that's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.59,
      "end_seconds": 105.42,
      "duration_seconds": 2.83,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 106.1,
      "end_seconds": 110.25,
      "duration_seconds": 4.15,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.82,
      "end_seconds": 113.43,
      "duration_seconds": 2.61,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.9,
      "end_seconds": 118.29,
      "duration_seconds": 3.39,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.89,
      "end_seconds": 123.27,
      "duration_seconds": 3.38,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.66,
      "end_seconds": 129.83,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.49,
      "end_seconds": 136.18,
      "duration_seconds": 4.69,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 137.61,
      "end_seconds": 140.87,
      "duration_seconds": 3.26,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.13,
      "end_seconds": 145.34,
      "duration_seconds": 3.21,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 147.39,
      "end_seconds": 148.97,
      "duration_seconds": 1.58,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.54,
      "end_seconds": 150.24,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.98,
      "end_seconds": 152.68,
      "duration_seconds": 1.7,
      "text": "I've got depression."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.52,
      "end_seconds": 173.12,
      "duration_seconds": 2.6,
      "text": "Okay, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 174.07,
      "end_seconds": 181.81,
      "duration_seconds": 7.74,
      "text": "Gliclazide. I take it 80 milligrams, twice a day. Mirtazapine, 15 milligrams, at night."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.43,
      "end_seconds": 186.16,
      "duration_seconds": 2.73,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 187.84,
      "end_seconds": 189.68,
      "duration_seconds": 1.84,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 199.69,
      "end_seconds": 207.6,
      "duration_seconds": 7.91,
      "text": "Doctor, I've got the readings for you. BP is 118 over 79, saturation 97 percent, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.0,
      "end_seconds": 209.7,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.99,
      "end_seconds": 217.25,
      "duration_seconds": 5.26,
      "text": "So, I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 219.16,
      "end_seconds": 220.21,
      "duration_seconds": 1.05,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.29,
      "end_seconds": 223.52,
      "duration_seconds": 2.23,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.58,
      "end_seconds": 239.38,
      "duration_seconds": 5.8,
      "text": "It's about eight millimetres, with an uneven border and two shades of brown."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.47,
      "end_seconds": 241.7,
      "duration_seconds": 1.23,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.64,
      "end_seconds": 259.12,
      "duration_seconds": 3.48,
      "text": "I can't feel any glands in the armpit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.48,
      "end_seconds": 275.96,
      "duration_seconds": 12.48,
      "text": "Thank you, you can get dressed. Having listened and examined, the most likely explanation is a pigmented lesion that needs to be looked at more closely."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.57,
      "end_seconds": 310.43,
      "duration_seconds": 17.86,
      "text": "I'd like to arrange a dermoscopy for changing mole. Please use sunscreen and cover up in the midday sun, and check your skin once a month. Please don't wait if the symptoms get worse. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 311.99,
      "end_seconds": 314.02,
      "duration_seconds": 2.03,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.1,
      "end_seconds": 319.36,
      "duration_seconds": 3.26,
      "text": "I'll want another look in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 321.36,
      "end_seconds": 324.56,
      "duration_seconds": 3.2,
      "text": "I'll book it on my way out."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.36,
      "end_seconds": 330.15,
      "duration_seconds": 4.79,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.41,
      "end_seconds": 334.2,
      "duration_seconds": 2.79,
      "text": "Yeah, thank you, doctor, goodbye."
    }
  ]
}