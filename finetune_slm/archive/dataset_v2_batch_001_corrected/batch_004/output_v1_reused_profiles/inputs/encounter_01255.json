{
  "schema_version": "1.0",
  "encounter_id": "01255",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 5.07,
      "duration_seconds": 3.94,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.16,
      "end_seconds": 11.06,
      "duration_seconds": 3.9,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.14,
      "end_seconds": 17.89,
      "duration_seconds": 4.75,
      "text": "I've, I've been feeling dizzy when I stand up."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.89,
      "end_seconds": 22.99,
      "duration_seconds": 4.1,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.18,
      "end_seconds": 38.04,
      "duration_seconds": 2.86,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.79,
      "end_seconds": 56.99,
      "duration_seconds": 8.2,
      "text": "Okay: pulse is 112 beats a minute, oxygen saturation is 99 percent, blood pressure 96 over 56."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.61,
      "end_seconds": 60.31,
      "duration_seconds": 1.7,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.89,
      "end_seconds": 67.31,
      "duration_seconds": 2.42,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.82,
      "end_seconds": 88.07,
      "duration_seconds": 9.25,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.68,
      "end_seconds": 121.59,
      "duration_seconds": 31.91,
      "text": "Oh, honestly, a few times a day. Yes, getting out of bed. That makes it worse. Severe, I'd say. I've had a dry mouth too, for two weeks. With dry mouth, sipping water helps a bit. I've also had nearly blacking out, for about four days. With nearly blacking out, only lying down, and it's not much."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.18,
      "end_seconds": 125.94,
      "duration_seconds": 2.76,
      "text": "Did you get slurred speech or fainting?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.53,
      "end_seconds": 131.04,
      "duration_seconds": 3.51,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.95,
      "end_seconds": 136.29,
      "duration_seconds": 3.34,
      "text": "Any chest pain or palpitations at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.39,
      "end_seconds": 142.14,
      "duration_seconds": 3.75,
      "text": "Mm, no, no chest pain or palpitations."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.58,
      "end_seconds": 144.68,
      "duration_seconds": 2.1,
      "text": "Ah. How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.66,
      "end_seconds": 148.41,
      "duration_seconds": 2.75,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.7,
      "end_seconds": 153.81,
      "duration_seconds": 4.11,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.43,
      "end_seconds": 158.46,
      "duration_seconds": 3.03,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.9,
      "end_seconds": 173.83,
      "duration_seconds": 4.93,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.59,
      "end_seconds": 180.48,
      "duration_seconds": 5.89,
      "text": "I'm on lisinopril, 10 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.1,
      "end_seconds": 185.52,
      "duration_seconds": 4.42,
      "text": "Right, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.34,
      "end_seconds": 193.41,
      "duration_seconds": 6.07,
      "text": "Okay, so I've had high blood pressure for about ten years now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.86,
      "end_seconds": 204.83,
      "duration_seconds": 7.97,
      "text": "Yes. Right, so high blood pressure is already on your record. We'll keep that in mind today. How about smoking?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.58,
      "end_seconds": 210.22,
      "duration_seconds": 4.64,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.19,
      "end_seconds": 213.97,
      "duration_seconds": 1.78,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.79,
      "end_seconds": 219.54,
      "duration_seconds": 4.75,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.67,
      "end_seconds": 222.64,
      "duration_seconds": 1.97,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.09,
      "end_seconds": 226.71,
      "duration_seconds": 2.62,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.11,
      "end_seconds": 240.89,
      "duration_seconds": 4.78,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.83,
      "end_seconds": 246.02,
      "duration_seconds": 3.19,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.87,
      "end_seconds": 249.28,
      "duration_seconds": 1.41,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.59,
      "end_seconds": 254.32,
      "duration_seconds": 3.73,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.49,
      "end_seconds": 260.28,
      "duration_seconds": 3.79,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.02,
      "end_seconds": 264.54,
      "duration_seconds": 2.52,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.51,
      "end_seconds": 277.72,
      "duration_seconds": 5.21,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.04,
      "end_seconds": 280.95,
      "duration_seconds": 1.91,
      "text": "Okay, nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.52,
      "end_seconds": 300.05,
      "duration_seconds": 3.53,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.09,
      "end_seconds": 302.1,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.54,
      "end_seconds": 328.47,
      "duration_seconds": 20.93,
      "text": "That's the examination finished. Having listened and examined, it fits best with postural low blood pressure, possibly related to medicines or dehydration. I'm sending you for a lying and standing blood pressure check because of dizziness. We should do blood tests for dizziness."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.15,
      "end_seconds": 331.24,
      "duration_seconds": 2.09,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.06,
      "end_seconds": 352.05,
      "duration_seconds": 19.99,
      "text": "Get up slowly from lying and sitting, and keep drinking fluids through the day. Keep an eye out, and if you faint or have chest pain, call us the same day or go to emergency. I'd like you back in two weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.07,
      "end_seconds": 358.56,
      "duration_seconds": 5.49,
      "text": "Hmm, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.8,
      "end_seconds": 361.08,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}