  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.19,
      "end_seconds": 8.4,
      "duration_seconds": 7.21,
      "text": "Erm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.23,
      "end_seconds": 14.82,
      "duration_seconds": 4.59,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.45,
      "end_seconds": 22.22,
      "duration_seconds": 6.77,
      "text": "Yeah, um, it's a poor appetite. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.9,
      "end_seconds": 25.16,
      "duration_seconds": 1.26,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.07,
      "end_seconds": 28.33,
      "duration_seconds": 2.26,
      "text": "Probably four weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.28,
      "end_seconds": 35.4,
      "duration_seconds": 5.12,
      "text": "Have you had any blood in the stool, bone pain or vomiting?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.72,
      "end_seconds": 39.27,
      "duration_seconds": 2.55,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.23,
      "end_seconds": 43.71,
      "duration_seconds": 2.48,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.49,
      "end_seconds": 46.8,
      "duration_seconds": 2.31,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.73,
      "end_seconds": 52.33,
      "duration_seconds": 4.6,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.11,
      "end_seconds": 55.27,
      "duration_seconds": 2.16,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.98,
      "end_seconds": 75.39,
      "duration_seconds": 4.41,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.03,
      "end_seconds": 77.71,
      "duration_seconds": 1.68,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.5,
      "end_seconds": 95.02,
      "duration_seconds": 3.52,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.12,
      "end_seconds": 98.01,
      "duration_seconds": 1.89,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.86,
      "end_seconds": 101.61,
      "duration_seconds": 2.75,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.08,
      "end_seconds": 105.31,
      "duration_seconds": 2.23,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.71,
      "end_seconds": 121.77,
      "duration_seconds": 5.06,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.43,
      "end_seconds": 136.38,
      "duration_seconds": 13.95,
      "text": "I smoke roughly a pack every two days. I only drink at family occasions. I do a yoga class on Thursdays. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.93,
      "end_seconds": 147.87,
      "duration_seconds": 5.94,
      "text": "Alright, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.51,
      "end_seconds": 155.92,
      "duration_seconds": 6.41,
      "text": "Sorry, um, what was I saying, no, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.64,
      "end_seconds": 159.42,
      "duration_seconds": 2.78,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.92,
      "end_seconds": 171.63,
      "duration_seconds": 2.71,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.18,
      "end_seconds": 201.44,
      "duration_seconds": 13.26,
      "text": "Okay: temperature 36.8, blood pressure 114 over 82, height 152 centimetres, saturation 97 percent, weight 95 kilos, BMI works out to 41.1, heart rate 76."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.49,
      "end_seconds": 205.69,
      "duration_seconds": 2.2,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.72,
      "end_seconds": 212.43,
      "duration_seconds": 4.71,
      "text": "So, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.91,
      "end_seconds": 217.98,
      "duration_seconds": 4.07,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.56,
      "end_seconds": 219.51,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.46,
      "end_seconds": 223.92,
      "duration_seconds": 2.46,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.07,
      "end_seconds": 239.68,
      "duration_seconds": 4.61,
      "text": "your tummy is soft and I can't feel any lumps"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.64,
      "end_seconds": 258.7,
      "duration_seconds": 14.06,
      "text": "Thank you, you can get dressed. So, based on the history and the examination, the most likely explanation is an unexplained weight loss that needs a proper work-up."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.33,
      "end_seconds": 263.59,
      "duration_seconds": 3.26,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.64,
      "end_seconds": 276.67,
      "duration_seconds": 11.03,
      "text": "It's reasonable to be concerned, but right now an unexplained weight loss that needs a proper work-up is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.43,
      "end_seconds": 321.48,
      "duration_seconds": 29.05,
      "text": "I'll request a thyroid test, it'll help with weight loss. Let's book a chest X-ray to look into cough and weight loss. Weigh yourself once a week at the same time and note it down. I'd like you to see the chest clinic as well, and I'll write the referral. One warning sign to remember: the symptoms get worse. In that case don't wait. See me again in two weeks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.11,
      "end_seconds": 326.6,
      "duration_seconds": 3.49,
      "text": "Well, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.89,
      "end_seconds": 336.7,
      "duration_seconds": 4.81,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.26,
      "end_seconds": 339.44,
      "duration_seconds": 2.18,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.32,
      "end_seconds": 343.76,
      "duration_seconds": 1.44,
      "text": "See you soon."
    }
  ]
}