{
  "schema_version": "1.0",
  "encounter_id": "01419",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 6.17,
      "duration_seconds": 5.23,
      "text": "Doctor, if you're free, we can start. I've got the numbers noted down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.91,
      "end_seconds": 11.62,
      "duration_seconds": 4.71,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.9,
      "end_seconds": 17.52,
      "duration_seconds": 4.62,
      "text": "Mm, I'm here because of pressure in the face."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.44,
      "end_seconds": 21.29,
      "duration_seconds": 2.85,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.1,
      "end_seconds": 29.19,
      "duration_seconds": 7.09,
      "text": "Ever since... since last Tuesday, really. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.41,
      "end_seconds": 33.01,
      "duration_seconds": 2.6,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.76,
      "end_seconds": 48.68,
      "duration_seconds": 14.92,
      "text": "Sorry, what was I saying, only steam, and it's not much. A headache over my forehead was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.49,
      "end_seconds": 55.44,
      "duration_seconds": 5.95,
      "text": "Have you had pressure in the face before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.97,
      "end_seconds": 64.26,
      "duration_seconds": 8.29,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 64.76,
      "end_seconds": 77.4,
      "duration_seconds": 12.64,
      "text": "Doctor, I've got the readings for you. Pulse 74, SpO2 98 percent on room air, temperature is 36.4 degrees. Blood pressure 122 over 81, respiratory rate 15."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.77,
      "end_seconds": 80.24,
      "duration_seconds": 1.47,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.23,
      "end_seconds": 84.58,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.73,
      "end_seconds": 87.33,
      "duration_seconds": 1.6,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.91,
      "end_seconds": 100.22,
      "duration_seconds": 3.31,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.62,
      "end_seconds": 104.0,
      "duration_seconds": 2.38,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.4,
      "end_seconds": 121.5,
      "duration_seconds": 5.1,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.63,
      "end_seconds": 129.43,
      "duration_seconds": 2.8,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.04,
      "end_seconds": 149.29,
      "duration_seconds": 6.25,
      "text": "Any vision changes, swelling around the eyes, stiff neck or fever at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.85,
      "end_seconds": 153.71,
      "duration_seconds": 3.86,
      "text": "Well, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.89,
      "end_seconds": 158.38,
      "duration_seconds": 3.49,
      "text": "Have you had ear pain, by any chance?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.0,
      "end_seconds": 161.14,
      "duration_seconds": 2.14,
      "text": "No, no ear pain."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.71,
      "end_seconds": 165.62,
      "duration_seconds": 2.91,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 167.66,
      "end_seconds": 169.43,
      "duration_seconds": 1.77,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.58,
      "end_seconds": 189.19,
      "duration_seconds": 2.61,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 190.18,
      "end_seconds": 204.47,
      "duration_seconds": 14.29,
      "text": "No, I share a house with my brother. I hardly move around during the day. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.72,
      "end_seconds": 208.05,
      "duration_seconds": 2.33,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 209.45,
      "end_seconds": 217.28,
      "duration_seconds": 7.83,
      "text": "I've got eczema. I just want to get back to normal, uh, really."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.26,
      "end_seconds": 220.78,
      "duration_seconds": 2.52,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.5,
      "end_seconds": 227.72,
      "duration_seconds": 5.22,
      "text": "Yes, I had a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.63,
      "end_seconds": 232.12,
      "duration_seconds": 3.49,
      "text": "Right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.82,
      "end_seconds": 235.87,
      "duration_seconds": 3.05,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.55,
      "end_seconds": 244.37,
      "duration_seconds": 3.82,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.38,
      "end_seconds": 252.04,
      "duration_seconds": 3.66,
      "text": "Okay, so no allergies at all."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.65,
      "end_seconds": 274.57,
      "duration_seconds": 7.92,
      "text": "Let's get an X-ray of the sinuses, for sinusitis. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.3,
      "end_seconds": 278.38,
      "duration_seconds": 3.08,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.15,
      "end_seconds": 305.65,
      "duration_seconds": 25.5,
      "text": "I'm going to put you on amoxicillin-clavulanate, 625 milligrams, twice a day, for five days. You take it by mouth. That's for sinusitis. Let's use saline nasal spray, three times a day, for one week. That should help with nasal congestion. Steam a couple of times a day and saline rinses will help clear things. I'd like to see you again in ten days."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 308.74,
      "end_seconds": 311.57,
      "duration_seconds": 2.83,
      "text": "So, I can manage that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.57,
      "end_seconds": 320.86,
      "duration_seconds": 4.29,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 321.61,
      "end_seconds": 326.56,
      "duration_seconds": 4.95,
      "text": "Good, you know, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.57,
      "end_seconds": 329.27,
      "duration_seconds": 1.7,
      "text": "Have a good day."
    }
  ]
}