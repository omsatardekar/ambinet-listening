{
  "schema_version": "1.0",
  "encounter_id": "01133",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 7.28,
      "duration_seconds": 6.35,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.74,
      "end_seconds": 12.43,
      "duration_seconds": 3.69,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.03,
      "end_seconds": 17.76,
      "duration_seconds": 4.73,
      "text": "So, I've been losing weight without trying, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.82,
      "end_seconds": 22.58,
      "duration_seconds": 2.76,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.14,
      "end_seconds": 29.84,
      "duration_seconds": 6.7,
      "text": "Sorry, what was I saying, it's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.75,
      "end_seconds": 34.35,
      "duration_seconds": 2.6,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.23,
      "end_seconds": 39.67,
      "duration_seconds": 3.44,
      "text": "It usually comes with no real appetite."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.24,
      "end_seconds": 45.59,
      "duration_seconds": 5.35,
      "text": "Have you been losing weight without trying at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.71,
      "end_seconds": 54.58,
      "duration_seconds": 7.87,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.75,
      "end_seconds": 59.37,
      "duration_seconds": 3.62,
      "text": "Has there been any blood in the stool?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.88,
      "end_seconds": 64.54,
      "duration_seconds": 3.66,
      "text": "Definitely no blood in the stool."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.43,
      "end_seconds": 69.58,
      "duration_seconds": 3.15,
      "text": "Any bone pain, itching or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.88,
      "end_seconds": 74.59,
      "duration_seconds": 3.71,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.68,
      "end_seconds": 77.5,
      "duration_seconds": 1.82,
      "text": "Right, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.37,
      "end_seconds": 80.79,
      "duration_seconds": 2.42,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.68,
      "end_seconds": 86.8,
      "duration_seconds": 4.12,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.75,
      "end_seconds": 92.64,
      "duration_seconds": 3.89,
      "text": "Erm, I've had high blood pressure, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.0,
      "end_seconds": 98.94,
      "duration_seconds": 4.94,
      "text": "Right, right. Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.82,
      "end_seconds": 120.31,
      "duration_seconds": 20.49,
      "text": "Amlodipine, 5 milligrams, once a day. Sorry, um, what was I saying, I'm supposed to take it regularly, but I don't always manage. Hmm, uh, I used to take telmisartan, but I stopped it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.92,
      "end_seconds": 126.24,
      "duration_seconds": 4.32,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.34,
      "end_seconds": 147.28,
      "duration_seconds": 18.94,
      "text": "No, I've never smoked in my life. Nothing, I'm teetotal. I drink a lot of tea and snack through the day. I work in accounts at a hospital. I swim twice a week."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.92,
      "end_seconds": 151.33,
      "duration_seconds": 3.41,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.71,
      "end_seconds": 158.95,
      "duration_seconds": 6.24,
      "text": "Sorry, what was I saying, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.87,
      "end_seconds": 177.73,
      "duration_seconds": 2.86,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.33,
      "end_seconds": 188.82,
      "duration_seconds": 2.49,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.85,
      "end_seconds": 223.8,
      "duration_seconds": 14.95,
      "text": "Okay: weight 66 kilos, BP is 111 over 70. And respiratory rate 18, temp 36.8 degrees, height 173 centimetres, saturation 98 percent, heart rate 66, BMI works out to 22.1."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.79,
      "end_seconds": 229.54,
      "duration_seconds": 3.75,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.55,
      "end_seconds": 232.25,
      "duration_seconds": 1.7,
      "text": "Okay, look straight ahead."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.76,
      "end_seconds": 253.29,
      "duration_seconds": 6.53,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.38,
      "end_seconds": 260.05,
      "duration_seconds": 2.67,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.32,
      "end_seconds": 286.39,
      "duration_seconds": 8.07,
      "text": "Right, here's what I'm thinking. It points towards an unexplained weight loss that needs a proper work-up."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.34,
      "end_seconds": 293.97,
      "duration_seconds": 3.63,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.96,
      "end_seconds": 306.03,
      "duration_seconds": 10.07,
      "text": "I can't promise yet, but most people with an unexplained weight loss that needs a proper work-up do well once it's treated properly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.41,
      "end_seconds": 348.82,
      "duration_seconds": 24.41,
      "text": "I want a chest X-ray done, that's for cough and weight loss. Blood tests is what I'd like next, for weight loss. I want a thyroid test done, that's for weight loss. Weigh yourself once a week at the same time and note it down. I'd like you back in two weeks. Right, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.79,
      "end_seconds": 353.71,
      "duration_seconds": 3.92,
      "text": "I, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 355.4,
      "end_seconds": 356.85,
      "duration_seconds": 1.45,
      "text": "Take care now."
    }
  ]
}