{
  "schema_version": "1.0",
  "encounter_id": "01472",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.04,
      "end_seconds": 10.57,
      "duration_seconds": 9.53,
      "text": "Doctor, the patient's with us now. I did the usual checks at the front, so just say when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 12.34,
      "end_seconds": 17.85,
      "duration_seconds": 5.51,
      "text": "thanks hello, come in, sit down what brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 18.78,
      "end_seconds": 25.05,
      "duration_seconds": 6.27,
      "text": "I've been losing weight without trying, and I wanted to get it checked"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 26.93,
      "end_seconds": 36.43,
      "duration_seconds": 9.5,
      "text": "here are the numbers, doctor oxygen saturation is 99 percent, blood pressure 122 over 79, pulse 84, temperature is 36.8 degrees"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.58,
      "end_seconds": 42.31,
      "duration_seconds": 4.73,
      "text": "Okay, noted. Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 44.24,
      "end_seconds": 46.05,
      "duration_seconds": 1.81,
      "text": "Probably three weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.47,
      "end_seconds": 52.14,
      "duration_seconds": 5.67,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 52.24,
      "end_seconds": 58.44,
      "duration_seconds": 6.2,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.84,
      "end_seconds": 64.88,
      "duration_seconds": 5.04,
      "text": "Later, thanks. Please go on. Any a dry cough as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.69,
      "end_seconds": 75.88,
      "duration_seconds": 9.19,
      "text": "Oh, yes, for two months. Night sweats was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.22,
      "end_seconds": 96.11,
      "duration_seconds": 4.89,
      "text": "and and what about coughing up blood or blood in the stool?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 97.48,
      "end_seconds": 103.65,
      "duration_seconds": 6.17,
      "text": "I haven't had coughing up blood or blood in the stool, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.66,
      "end_seconds": 106.37,
      "duration_seconds": 1.71,
      "text": "any sign of itching?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.4,
      "end_seconds": 110.09,
      "duration_seconds": 2.69,
      "text": "I haven't noticed any itching."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.08,
      "end_seconds": 114.07,
      "duration_seconds": 1.99,
      "text": "Any bone pain or vomiting?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.57,
      "end_seconds": 117.98,
      "duration_seconds": 2.41,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.53,
      "end_seconds": 122.23,
      "duration_seconds": 3.7,
      "text": "Hm, okay. Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.12,
      "end_seconds": 125.09,
      "duration_seconds": 1.97,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.61,
      "end_seconds": 128.91,
      "duration_seconds": 3.3,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.77,
      "end_seconds": 137.55,
      "duration_seconds": 7.78,
      "text": "I'm allergic to to diclofenac, I get wheezing. I'm allergic to cat fur, I get wheezing."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.07,
      "end_seconds": 139.54,
      "duration_seconds": 1.47,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.1,
      "end_seconds": 142.23,
      "duration_seconds": 1.13,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.66,
      "end_seconds": 157.45,
      "duration_seconds": 3.79,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.04,
      "end_seconds": 162.99,
      "duration_seconds": 4.95,
      "text": "My sister had breast cancer. My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.87,
      "end_seconds": 170.77,
      "duration_seconds": 3.9,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.54,
      "end_seconds": 173.82,
      "duration_seconds": 2.28,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.45,
      "end_seconds": 175.74,
      "duration_seconds": 1.29,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.62,
      "end_seconds": 178.59,
      "duration_seconds": 1.97,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.81,
      "end_seconds": 181.13,
      "duration_seconds": 1.32,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 185.98,
      "end_seconds": 191.2,
      "duration_seconds": 5.22,
      "text": "I have an enlarged prostate, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.02,
      "end_seconds": 192.72,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.52,
      "end_seconds": 198.29,
      "duration_seconds": 3.77,
      "text": "I have heart disease, for nearly five years."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.91,
      "end_seconds": 209.58,
      "duration_seconds": 9.67,
      "text": "Okay, I can see high blood pressure and high cholesterol in your file as well. Is there someone at home?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.33,
      "end_seconds": 215.69,
      "duration_seconds": 4.36,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.7,
      "end_seconds": 222.43,
      "duration_seconds": 3.73,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 226.2,
      "end_seconds": 229.53,
      "duration_seconds": 3.33,
      "text": "it's ramipril, 5 milligrams, every morning"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.06,
      "end_seconds": 231.36,
      "duration_seconds": 1.3,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.09,
      "end_seconds": 244.91,
      "duration_seconds": 11.82,
      "text": "I take simvastatin, 20 milligrams, at night for my cholesterol. Tamsulosin i take it 0.4 milligrams, at night for the prostate"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.93,
      "end_seconds": 248.47,
      "duration_seconds": 2.54,
      "text": "Okay, when did you start it?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 249.72,
      "end_seconds": 256.01,
      "duration_seconds": 6.29,
      "text": "About a month now. I'm on metoprolol, twice a day for my heart."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.69,
      "end_seconds": 259.06,
      "duration_seconds": 2.37,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 260.46,
      "end_seconds": 265.33,
      "duration_seconds": 4.87,
      "text": "50 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.39,
      "end_seconds": 270.85,
      "duration_seconds": 4.46,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 272.28,
      "end_seconds": 273.24,
      "duration_seconds": 0.96,
      "text": "of course"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.96,
      "end_seconds": 277.31,
      "duration_seconds": 2.35,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.93,
      "end_seconds": 300.73,
      "duration_seconds": 5.8,
      "text": "I can feel a couple of small glands in your neck, not tender."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.58,
      "end_seconds": 302.75,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.16,
      "end_seconds": 323.54,
      "duration_seconds": 4.38,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.66,
      "end_seconds": 329.6,
      "duration_seconds": 0.94,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.01,
      "end_seconds": 361.76,
      "duration_seconds": 27.75,
      "text": "All finished, thank you. Let me tell you where I've got to. This is probably an unexplained weight loss that needs a proper work-up. The reason I say that is that your story and my examination fit together. It could also be a chronic infection, so we'll keep that open. We shouldn't forget an overactive thyroid."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 367.22,
      "end_seconds": 370.49,
      "duration_seconds": 3.27,
      "text": "what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.16,
      "end_seconds": 387.7,
      "duration_seconds": 15.54,
      "text": "it's reasonable to be concerned, but right now an unexplained weight loss that needs a proper work-up is my leading thought, not anything worse. I'm sending you for blood tests because of weight loss"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 389.2,
      "end_seconds": 394.77,
      "duration_seconds": 5.57,
      "text": "we have a slot Monday at 11:30 am, if that works"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.02,
      "end_seconds": 423.56,
      "duration_seconds": 25.54,
      "text": "I'll request a thyroid test, it'll help with weight loss. The result will help us decide whether anything more is needed. Weigh yourself once a week at the same time and note it down. I'd like you back after the results are back. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 425.45,
      "end_seconds": 428.46,
      "duration_seconds": 3.01,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 429.55,
      "end_seconds": 431.37,
      "duration_seconds": 1.82,
      "text": "Have a good day."
    }
  ]
}