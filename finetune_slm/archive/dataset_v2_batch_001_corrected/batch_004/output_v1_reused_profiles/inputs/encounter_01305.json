{
  "schema_version": "1.0",
  "encounter_id": "01305",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 5.1,
      "duration_seconds": 3.76,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.91,
      "end_seconds": 10.18,
      "duration_seconds": 4.27,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.37,
      "end_seconds": 22.86,
      "duration_seconds": 11.49,
      "text": "Ah, doctor, thank you for seeing us. I mean, doctor, it's fever and chills. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.73,
      "end_seconds": 27.95,
      "duration_seconds": 3.22,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.89,
      "end_seconds": 32.53,
      "duration_seconds": 3.64,
      "text": "It's been like this since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.63,
      "end_seconds": 35.31,
      "duration_seconds": 1.68,
      "text": "Does anything help it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.82,
      "end_seconds": 40.35,
      "duration_seconds": 3.53,
      "text": "Hmm, paracetamol helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.77,
      "end_seconds": 51.3,
      "duration_seconds": 5.53,
      "text": "Any sharp pain on the right side when you breathe in as well?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.8,
      "end_seconds": 58.67,
      "duration_seconds": 2.87,
      "text": "Yeah, you know, that too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.48,
      "end_seconds": 62.84,
      "duration_seconds": 3.36,
      "text": "Have you had a cough with phlegm?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.59,
      "end_seconds": 69.84,
      "duration_seconds": 5.25,
      "text": "Yeah, um, I've had that since last weekend."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.52,
      "end_seconds": 75.55,
      "duration_seconds": 5.03,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.64,
      "end_seconds": 91.03,
      "duration_seconds": 14.39,
      "text": "Nothing, I'm teetotal. I smoke roughly a pack every two days. I'm a bus driver, so I sit for long hours. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.12,
      "end_seconds": 111.27,
      "duration_seconds": 2.15,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.6,
      "end_seconds": 113.86,
      "duration_seconds": 1.26,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.62,
      "end_seconds": 119.21,
      "duration_seconds": 4.59,
      "text": "Yes. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.15,
      "end_seconds": 125.87,
      "duration_seconds": 4.72,
      "text": "No, you know, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 126.83,
      "end_seconds": 135.14,
      "duration_seconds": 8.31,
      "text": "Actually, I remember she had some kind of reaction to tramadol before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.08,
      "end_seconds": 138.87,
      "duration_seconds": 2.79,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.82,
      "end_seconds": 147.61,
      "duration_seconds": 6.79,
      "text": "Okay, fair enough, I'll write down both versions. Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.34,
      "end_seconds": 159.15,
      "duration_seconds": 6.81,
      "text": "Let me think, uh, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.51,
      "end_seconds": 163.36,
      "duration_seconds": 2.85,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.88,
      "end_seconds": 172.94,
      "duration_seconds": 9.06,
      "text": "Erm, I'm on something called sita... sitagliptin, 100 milligrams, maybe, once a day for my sugar."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.88,
      "end_seconds": 178.4,
      "duration_seconds": 4.52,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.8,
      "end_seconds": 186.81,
      "duration_seconds": 7.01,
      "text": "Oh, no, it's at home. Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.0,
      "end_seconds": 192.24,
      "duration_seconds": 4.24,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.08,
      "end_seconds": 199.52,
      "duration_seconds": 2.44,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.24,
      "end_seconds": 205.39,
      "duration_seconds": 5.15,
      "text": "Any confusion, leg swelling, vomiting or recent travel at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.07,
      "end_seconds": 213.66,
      "duration_seconds": 6.59,
      "text": "No confusion, leg swelling, vomiting or recent travel, none of it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.11,
      "end_seconds": 219.84,
      "duration_seconds": 4.73,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.72,
      "end_seconds": 226.17,
      "duration_seconds": 5.45,
      "text": "Let me think, you know, no weakness or anything."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.33,
      "end_seconds": 240.78,
      "duration_seconds": 2.45,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.67,
      "end_seconds": 257.19,
      "duration_seconds": 2.52,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.43,
      "end_seconds": 277.91,
      "duration_seconds": 9.48,
      "text": "Okay: pulse 84, SpO2 94 percent on room air. And respiratory rate 23, temperature 37.1, BP is 135 over 87."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.32,
      "end_seconds": 282.69,
      "duration_seconds": 3.37,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.63,
      "end_seconds": 287.12,
      "duration_seconds": 2.49,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.24,
      "end_seconds": 304.87,
      "duration_seconds": 2.63,
      "text": "Breathing rate is a bit fast."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.7,
      "end_seconds": 307.4,
      "duration_seconds": 1.7,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.22,
      "end_seconds": 322.96,
      "duration_seconds": 4.74,
      "text": "There's bronchial breathing and crackles at the right lower zone."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.6,
      "end_seconds": 333.71,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 339.25,
      "end_seconds": 351.89,
      "duration_seconds": 12.64,
      "text": "Thank you, you can get dressed. Okay, so my impression is this: This looks most like a possible pneumonia on the right side. I can't rule out a pulmonary embolism yet."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.43,
      "end_seconds": 355.0,
      "duration_seconds": 1.57,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.2,
      "end_seconds": 370.63,
      "duration_seconds": 14.43,
      "text": "It's reasonable to be concerned, but right now a possible pneumonia on the right side is my leading thought, not anything worse. I'm going to order a chest X-ray, for suspected pneumonia."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.34,
      "end_seconds": 376.63,
      "duration_seconds": 4.29,
      "text": "So, um, that's fine with me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.17,
      "end_seconds": 383.2,
      "duration_seconds": 5.03,
      "text": "I think a sputum culture makes sense here, for pneumonia."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.93,
      "end_seconds": 388.01,
      "duration_seconds": 4.08,
      "text": "Right, uh, that's fine with me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.71,
      "end_seconds": 419.8,
      "duration_seconds": 31.09,
      "text": "I'm going to order blood tests, for infection. What I'm giving you is amoxicillin-clavulanate, 625 milligrams, three times a day, for five days. You take it by mouth. It's for chest infection. Rest and fluids, and finish every dose of the antibiotic. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.83,
      "end_seconds": 434.43,
      "duration_seconds": 13.6,
      "text": "The thing that would worry me is if the breathlessness worsens or you become drowsy. If that happens, go to emergency. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 436.52,
      "end_seconds": 439.8,
      "duration_seconds": 3.28,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 441.54,
      "end_seconds": 443.79,
      "duration_seconds": 2.25,
      "text": "So, have a good day."
    }
  ]
}