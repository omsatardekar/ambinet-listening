{
  "schema_version": "1.0",
  "encounter_id": "01047",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.89,
      "end_seconds": 7.96,
      "duration_seconds": 7.07,
      "text": "okay doctor we're all set in here. I'll give you the numbers when you want them"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.86,
      "end_seconds": 12.91,
      "duration_seconds": 4.05,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.54,
      "end_seconds": 19.64,
      "duration_seconds": 5.1,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.36,
      "end_seconds": 27.43,
      "duration_seconds": 3.07,
      "text": "please do extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 28.94,
      "end_seconds": 36.32,
      "duration_seconds": 7.38,
      "text": "um, I've been dealing with a tight feeling in my chest when I walk uphill"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.29,
      "end_seconds": 41.31,
      "duration_seconds": 4.02,
      "text": "alright when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 42.71,
      "end_seconds": 56.79,
      "duration_seconds": 14.08,
      "text": "it's been about a year, I'm fairly sure. A neighbour of mine said I should see someone about it. I kept putting it off, which I know isn't sensible"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.38,
      "end_seconds": 60.53,
      "duration_seconds": 3.15,
      "text": "is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 62.78,
      "end_seconds": 68.92,
      "duration_seconds": 6.14,
      "text": "Well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.44,
      "end_seconds": 74.49,
      "duration_seconds": 5.05,
      "text": "take your time. Mild moderate or severe if you had to pick?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 76.56,
      "end_seconds": 77.97,
      "duration_seconds": 1.41,
      "text": "Moderate I'd say"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.9,
      "end_seconds": 81.75,
      "duration_seconds": 1.85,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 84.93,
      "end_seconds": 88.23,
      "duration_seconds": 3.3,
      "text": "Cold weather definitely sets it off."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.46,
      "end_seconds": 91.74,
      "duration_seconds": 2.28,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 93.02,
      "end_seconds": 99.41,
      "duration_seconds": 6.39,
      "text": "A heaviness in my left arm goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 100.39,
      "end_seconds": 107.24,
      "duration_seconds": 6.85,
      "text": "And the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 107.34,
      "end_seconds": 113.44,
      "duration_seconds": 6.1,
      "text": "tell the doctor about the other thing um that's what worries me"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 114.3,
      "end_seconds": 122.56,
      "duration_seconds": 8.26,
      "text": "I was getting to that! The heaviness in my left arm? That's been for nearly five years"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.4,
      "end_seconds": 128.27,
      "duration_seconds": 3.87,
      "text": "okay, has there been breathlessness on exertion too?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 129.54,
      "end_seconds": 130.68,
      "duration_seconds": 1.14,
      "text": "yes, actually"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.48,
      "end_seconds": 140.9,
      "duration_seconds": 9.42,
      "text": "tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 141.52,
      "end_seconds": 148.6,
      "duration_seconds": 7.08,
      "text": "it settles a little with resting i'd say once or twice a day"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_5",
      "role": "UNKNOWN",
      "start_seconds": 155.02,
      "end_seconds": 158.72,
      "duration_seconds": 3.7,
      "text": "yes, that's right, that's how it was"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.34,
      "end_seconds": 172.52,
      "duration_seconds": 3.18,
      "text": "And what about cough palpitations or fainting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 177.66,
      "end_seconds": 180.84,
      "duration_seconds": 3.18,
      "text": "No, no cough, palpitations or fainting."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.1,
      "end_seconds": 190.73,
      "duration_seconds": 4.63,
      "text": "Have you noticed ankle swelling or pain between the shoulder blades?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 192.47,
      "end_seconds": 195.46,
      "duration_seconds": 2.99,
      "text": "Nope, um, nothing like that."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.26,
      "end_seconds": 198.16,
      "duration_seconds": 1.9,
      "text": "Any pain at rest?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 200.02,
      "end_seconds": 202.57,
      "duration_seconds": 2.55,
      "text": "no no pain at rest"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.58,
      "end_seconds": 207.98,
      "duration_seconds": 4.4,
      "text": "okay, anything on the the skin I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 209.41,
      "end_seconds": 211.55,
      "duration_seconds": 2.14,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.78,
      "end_seconds": 216.99,
      "duration_seconds": 4.21,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 217.92,
      "end_seconds": 220.41,
      "duration_seconds": 2.49,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.75,
      "end_seconds": 226.48,
      "duration_seconds": 4.73,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 227.06,
      "end_seconds": 240.36,
      "duration_seconds": 13.3,
      "text": "hmm, uh, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.47,
      "end_seconds": 245.77,
      "duration_seconds": 4.3,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 247.81,
      "end_seconds": 250.31,
      "duration_seconds": 2.5,
      "text": "High cholesterol for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.12,
      "end_seconds": 252.43,
      "duration_seconds": 1.31,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 253.07,
      "end_seconds": 265.09,
      "duration_seconds": 12.02,
      "text": "I have diabetes, for nearly five years i'd rather not end up on lots of tablets if I can avoid it"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.69,
      "end_seconds": 268.15,
      "duration_seconds": 1.46,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.16,
      "end_seconds": 274.02,
      "duration_seconds": 3.86,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 275.95,
      "end_seconds": 278.56,
      "duration_seconds": 2.61,
      "text": "my sister had breast cancer"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.2,
      "end_seconds": 281.66,
      "duration_seconds": 1.46,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 283.24,
      "end_seconds": 287.56,
      "duration_seconds": 4.32,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.24,
      "end_seconds": 290.08,
      "duration_seconds": 1.84,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 291.15,
      "end_seconds": 296.23,
      "duration_seconds": 5.08,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.77,
      "end_seconds": 300.2,
      "duration_seconds": 2.43,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 301.77,
      "end_seconds": 306.0,
      "duration_seconds": 4.23,
      "text": "No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.73,
      "end_seconds": 311.08,
      "duration_seconds": 4.35,
      "text": "So what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 311.65,
      "end_seconds": 315.8,
      "duration_seconds": 4.15,
      "text": "Atorvastatin i take it 20 milligrams, at night"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 317.5,
      "end_seconds": 324.58,
      "duration_seconds": 7.08,
      "text": "It's meant to to be at night though I don't see he take it every time."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 325.61,
      "end_seconds": 334.61,
      "duration_seconds": 9.0,
      "text": "something called glyc... Glycomet. I take it it 500 milligrams maybe twice a day for my sugar."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.65,
      "end_seconds": 340.21,
      "duration_seconds": 4.56,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 341.26,
      "end_seconds": 345.65,
      "duration_seconds": 4.39,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.44,
      "end_seconds": 347.77,
      "duration_seconds": 1.33,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 349.37,
      "end_seconds": 352.7,
      "duration_seconds": 3.33,
      "text": "no, I've never been operated on"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 362.58,
      "end_seconds": 370.42,
      "duration_seconds": 7.84,
      "text": "doctor I've got the readings for you. Respiratory rate 17 BP is 125 over 68 pulse is 76 beats a minute"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.46,
      "end_seconds": 372.3,
      "duration_seconds": 0.84,
      "text": "okay noted"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.72,
      "end_seconds": 378.14,
      "duration_seconds": 4.42,
      "text": "I'll examine you in a second make yourself comfortable"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 378.69,
      "end_seconds": 380.2,
      "duration_seconds": 1.51,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.9,
      "end_seconds": 384.73,
      "duration_seconds": 2.83,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.59,
      "end_seconds": 402.89,
      "duration_seconds": 3.3,
      "text": "there is no swelling in your ankles"
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.97,
      "end_seconds": 405.2,
      "duration_seconds": 1.23,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 412.23,
      "end_seconds": 417.31,
      "duration_seconds": 5.08,
      "text": "Heart sounds are normal, no murmur, and and the chest is clear."
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.8,
      "end_seconds": 444.44,
      "duration_seconds": 23.64,
      "text": "Please sit back down. Right here's what I'm thinking. The most likely explanation is exertional angina until proven otherwise. I want to be honest that this is an impression not a final answer. Reflux-related chest pain is also on my list. A muscle strain is also on my list."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 445.05,
      "end_seconds": 448.29,
      "duration_seconds": 3.24,
      "text": "we've already done an ECG this morning, doctor"
    },
    {
      "segment_id": "SEG0067",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 449.54,
      "end_seconds": 461.8,
      "duration_seconds": 12.26,
      "text": "Okay, I'll take a look at that. I'm going to order an exercise stress test, for exertional chest tightness. I'm going to order blood tests, for cardiovascular risk."
    },
    {
      "segment_id": "SEG0068",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 462.36,
      "end_seconds": 463.31,
      "duration_seconds": 0.95,
      "text": "Right understood."
    },
    {
      "segment_id": "SEG0069",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 465.17,
      "end_seconds": 494.27,
      "duration_seconds": 29.1,
      "text": "let's use aspirin, 75 milligrams, once a day, long term that's for heart protection you'll be taking GTN spray, 400 micrograms, when needed for chest pain, long term that should help with chest pain if the tightness comes, stop, sit down and use the spray under your tongue don't skip meals, and try to eat smaller portions more often through the day i'm going to send a referral to the cardiology clinic"
    },
    {
      "segment_id": "SEG0070",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 496.03,
      "end_seconds": 505.05,
      "duration_seconds": 9.02,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0071",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 506.15,
      "end_seconds": 508.18,
      "duration_seconds": 2.03,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0072",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 509.27,
      "end_seconds": 516.81,
      "duration_seconds": 7.54,
      "text": "I'd like you back after the test results are back. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0073",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 518.33,
      "end_seconds": 522.36,
      "duration_seconds": 4.03,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}