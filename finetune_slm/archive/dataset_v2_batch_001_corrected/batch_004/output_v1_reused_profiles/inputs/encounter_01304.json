{
  "schema_version": "1.0",
  "encounter_id": "01304",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 6.78,
      "duration_seconds": 5.87,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.49,
      "end_seconds": 12.46,
      "duration_seconds": 3.97,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.42,
      "end_seconds": 18.9,
      "duration_seconds": 5.48,
      "text": "Um, so... tingling in my feet. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.57,
      "end_seconds": 20.85,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.06,
      "end_seconds": 25.81,
      "duration_seconds": 3.75,
      "text": "Right, it's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.38,
      "end_seconds": 31.39,
      "duration_seconds": 4.01,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.25,
      "end_seconds": 36.65,
      "duration_seconds": 3.4,
      "text": "A six out of ten, I suppose."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.68,
      "end_seconds": 41.28,
      "duration_seconds": 2.6,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.0,
      "end_seconds": 54.15,
      "duration_seconds": 12.15,
      "text": "I walk the dog every morning. No, I share a house with my brother. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.04,
      "end_seconds": 64.47,
      "duration_seconds": 4.43,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.0,
      "end_seconds": 68.27,
      "duration_seconds": 3.27,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.81,
      "end_seconds": 72.6,
      "duration_seconds": 3.79,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.52,
      "end_seconds": 77.01,
      "duration_seconds": 3.49,
      "text": "I take magnesium tablets, at night."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.2,
      "end_seconds": 88.37,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.49,
      "end_seconds": 91.71,
      "duration_seconds": 2.22,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.7,
      "end_seconds": 110.34,
      "duration_seconds": 7.64,
      "text": "Any allergies to tablets, food or anything in the environment? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.16,
      "end_seconds": 115.57,
      "duration_seconds": 3.41,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.63,
      "end_seconds": 131.93,
      "duration_seconds": 6.3,
      "text": "And what about shortness of breath, back pain or weakness in the legs?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.95,
      "end_seconds": 137.39,
      "duration_seconds": 3.44,
      "text": "Um, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.81,
      "end_seconds": 141.4,
      "duration_seconds": 2.59,
      "text": "Right, any swelling of the legs?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.92,
      "end_seconds": 145.73,
      "duration_seconds": 3.81,
      "text": "Not at all, no swelling of the legs."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.96,
      "end_seconds": 150.63,
      "duration_seconds": 3.67,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.31,
      "end_seconds": 153.74,
      "duration_seconds": 1.43,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.59,
      "end_seconds": 173.89,
      "duration_seconds": 4.3,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.15,
      "end_seconds": 187.09,
      "duration_seconds": 2.94,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.67,
      "end_seconds": 215.5,
      "duration_seconds": 9.83,
      "text": "Okay: oxygen saturation is 99 percent, temp 36.9 degrees, blood pressure 118 over 76, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.12,
      "end_seconds": 219.17,
      "duration_seconds": 2.05,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.25,
      "end_seconds": 222.46,
      "duration_seconds": 2.21,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.24,
      "end_seconds": 247.83,
      "duration_seconds": 6.59,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.46,
      "end_seconds": 272.75,
      "duration_seconds": 22.29,
      "text": "That's all I needed to check. So, based on the history and the examination, I can't pin this down yet. We're looking at night-time muscle cramps without a worrying cause or a side effect of a medicine. I'd like to arrange a blood sugar test for tingling feet."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 273.43,
      "end_seconds": 278.61,
      "duration_seconds": 5.18,
      "text": "We have a slot Monday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.09,
      "end_seconds": 298.32,
      "duration_seconds": 18.23,
      "text": "Gentle calf stretches against a wall before bed often help. Please don't wait if one leg becomes red, hot or swollen. That's when to be seen urgently. Please come and see me after the results are back. Okay, does all of that make sense?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.32,
      "end_seconds": 304.08,
      "duration_seconds": 3.76,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.44,
      "end_seconds": 307.34,
      "duration_seconds": 1.9,
      "text": "Have a good day."
    }
  ]
}