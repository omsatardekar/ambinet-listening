{
  "schema_version": "1.0",
  "encounter_id": "01081",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.58,
      "end_seconds": 3.4,
      "duration_seconds": 2.82,
      "text": "hello, come in. Mind the step"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.11,
      "end_seconds": 6.14,
      "duration_seconds": 1.03,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.57,
      "end_seconds": 9.98,
      "duration_seconds": 2.41,
      "text": "Okay, what's been worrying you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.06,
      "end_seconds": 28.85,
      "duration_seconds": 16.79,
      "text": "Yeah, it's itchy raised red welts. I don't know what's causing it. I just want to get back to normal, really. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.2,
      "end_seconds": 33.03,
      "duration_seconds": 2.83,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.24,
      "end_seconds": 37.5,
      "duration_seconds": 3.26,
      "text": "Since Monday, that's when it began."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 42.31,
      "duration_seconds": 4.41,
      "text": "Right, right. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.14,
      "end_seconds": 49.69,
      "duration_seconds": 5.55,
      "text": "I'd give it a three, you know, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.92,
      "end_seconds": 53.32,
      "duration_seconds": 2.4,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.29,
      "end_seconds": 57.85,
      "duration_seconds": 3.56,
      "text": "Erm, it settles a little with antihistamines."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.62,
      "end_seconds": 64.5,
      "duration_seconds": 4.88,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.25,
      "end_seconds": 69.5,
      "duration_seconds": 3.25,
      "text": "Actually, it sort of comes and goes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.97,
      "end_seconds": 70.79,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.39,
      "end_seconds": 83.1,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.3,
      "end_seconds": 86.52,
      "duration_seconds": 2.22,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.13,
      "end_seconds": 90.4,
      "duration_seconds": 3.27,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.19,
      "end_seconds": 97.22,
      "duration_seconds": 6.03,
      "text": "Seretide inhaler, twice a day. Mm, it's cetirizine, 10 milligrams, at night"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.31,
      "end_seconds": 108.58,
      "duration_seconds": 3.27,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.33,
      "end_seconds": 120.77,
      "duration_seconds": 11.44,
      "text": "I've never touched a cigarette. Yes, I work in a bakery, early starts. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.32,
      "end_seconds": 141.81,
      "duration_seconds": 2.49,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.87,
      "end_seconds": 149.47,
      "duration_seconds": 3.6,
      "text": "I've had asthma for nearly five years now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.03,
      "end_seconds": 154.39,
      "duration_seconds": 4.36,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 156.22,
      "end_seconds": 159.35,
      "duration_seconds": 3.13,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.14,
      "end_seconds": 165.25,
      "duration_seconds": 4.11,
      "text": "Did you get joint pain, new medicines or wheezing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.18,
      "end_seconds": 172.33,
      "duration_seconds": 6.15,
      "text": "Sorry, what was I saying, no, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.99,
      "end_seconds": 177.29,
      "duration_seconds": 3.3,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.71,
      "end_seconds": 180.76,
      "duration_seconds": 2.05,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.85,
      "end_seconds": 201.96,
      "duration_seconds": 3.11,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.8,
      "end_seconds": 214.34,
      "duration_seconds": 2.54,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.31,
      "end_seconds": 240.27,
      "duration_seconds": 9.96,
      "text": "Okay: weight 65 kilos, heart rate 74, pressure 122 over 73, respiratory rate 18, BMI works out to 27.1, height 155 centimetres."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.54,
      "end_seconds": 244.77,
      "duration_seconds": 3.23,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.75,
      "end_seconds": 262.58,
      "duration_seconds": 15.83,
      "text": "I'll come back to the numbers. From what you've told me, I'd lean towards acute urticaria, possibly allergic. So, to recap quickly. You've had itchy raised red welts, since Monday, and no joint pain or wheezing"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 263.41,
      "end_seconds": 264.88,
      "duration_seconds": 1.47,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.64,
      "end_seconds": 280.87,
      "duration_seconds": 15.23,
      "text": "An allergy test is what I'd like next, for recurrent urticaria. I'm going to put you on prednisolone, 20 milligrams, once a day, for three days. That should help with hives."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.35,
      "end_seconds": 284.6,
      "duration_seconds": 2.25,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.41,
      "end_seconds": 292.86,
      "duration_seconds": 6.45,
      "text": "write down anything new you ate, took or used before this started, even small things"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.2,
      "end_seconds": 299.69,
      "duration_seconds": 6.49,
      "text": "sure. Come back in two weeks. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.53,
      "end_seconds": 302.67,
      "duration_seconds": 2.14,
      "text": "thank you, that's helpful"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.76,
      "end_seconds": 305.15,
      "duration_seconds": 1.39,
      "text": "Look after yourself."
    }
  ]
}