{
  "schema_version": "1.0",
  "encounter_id": "01176",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.97,
      "end_seconds": 4.26,
      "duration_seconds": 3.29,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.09,
      "end_seconds": 14.77,
      "duration_seconds": 4.68,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.53,
      "end_seconds": 18.31,
      "duration_seconds": 1.78,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.59,
      "end_seconds": 29.13,
      "duration_seconds": 9.54,
      "text": "So, I've been passing clots, doctor. I've been feeling exhausted too. I'd been looking pale, but that went away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.42,
      "end_seconds": 33.85,
      "duration_seconds": 3.43,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.45,
      "end_seconds": 42.72,
      "duration_seconds": 2.27,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.16,
      "end_seconds": 59.49,
      "duration_seconds": 5.33,
      "text": "Okay: blood pressure 124 over 79, saturation 99 percent, pulse 80."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.74,
      "end_seconds": 63.21,
      "duration_seconds": 2.47,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.6,
      "end_seconds": 65.99,
      "duration_seconds": 1.39,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.11,
      "end_seconds": 86.15,
      "duration_seconds": 4.04,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.99,
      "end_seconds": 91.91,
      "duration_seconds": 1.92,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.99,
      "end_seconds": 109.77,
      "duration_seconds": 5.78,
      "text": "Did you get weight loss, bleeding between periods, fainting or pelvic pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.72,
      "end_seconds": 121.22,
      "duration_seconds": 7.5,
      "text": "No weight loss, bleeding between periods, fainting or pelvic pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.28,
      "end_seconds": 124.97,
      "duration_seconds": 1.69,
      "text": "How about chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.09,
      "end_seconds": 128.05,
      "duration_seconds": 1.96,
      "text": "No, no chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.05,
      "end_seconds": 135.45,
      "duration_seconds": 1.4,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.17,
      "end_seconds": 139.27,
      "duration_seconds": 2.1,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.38,
      "end_seconds": 143.7,
      "duration_seconds": 3.32,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.69,
      "end_seconds": 147.62,
      "duration_seconds": 2.93,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.66,
      "end_seconds": 152.87,
      "duration_seconds": 3.21,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.98,
      "end_seconds": 158.03,
      "duration_seconds": 4.05,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 159.96,
      "end_seconds": 162.23,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.69,
      "end_seconds": 168.73,
      "duration_seconds": 5.04,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.1,
      "end_seconds": 177.4,
      "duration_seconds": 4.3,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.61,
      "end_seconds": 181.43,
      "duration_seconds": 2.82,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.13,
      "end_seconds": 192.07,
      "duration_seconds": 2.94,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 193.53,
      "end_seconds": 197.39,
      "duration_seconds": 3.86,
      "text": "Just a bunion operation, six years ago."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.19,
      "end_seconds": 202.02,
      "duration_seconds": 2.83,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.61,
      "end_seconds": 205.72,
      "duration_seconds": 2.11,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.6,
      "end_seconds": 212.99,
      "duration_seconds": 5.39,
      "text": "Okay, I can see high cholesterol in your file as well."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.77,
      "end_seconds": 233.12,
      "duration_seconds": 7.35,
      "text": "Do you take any prescribed or over-the-counter medicines? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 234.24,
      "end_seconds": 237.56,
      "duration_seconds": 3.32,
      "text": "It's atorvastatin, 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.89,
      "end_seconds": 238.7,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.08,
      "end_seconds": 243.59,
      "duration_seconds": 3.51,
      "text": "I'm on iron tablets, once a day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.78,
      "end_seconds": 248.06,
      "duration_seconds": 3.28,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.67,
      "end_seconds": 250.35,
      "duration_seconds": 1.68,
      "text": "About two years."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.73,
      "end_seconds": 251.43,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.99,
      "end_seconds": 257.66,
      "duration_seconds": 4.67,
      "text": "Before this I was on rosuvastatin; that's been stopped."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.14,
      "end_seconds": 269.53,
      "duration_seconds": 10.39,
      "text": "Okay, thinking it through, my working impression is heavy periods with iron deficiency. I'm sending you for a pelvic ultrasound because of heavy periods."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 270.55,
      "end_seconds": 274.01,
      "duration_seconds": 3.46,
      "text": "I can book that for Wednesday at 2 pm."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 275.39,
      "end_seconds": 277.91,
      "duration_seconds": 2.52,
      "text": "Wednesday, that works for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.33,
      "end_seconds": 293.9,
      "duration_seconds": 14.57,
      "text": "I'm going to order a ferritin level, for iron deficiency. What I'm giving you is tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. It's for heavy periods."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 295.71,
      "end_seconds": 299.55,
      "duration_seconds": 3.84,
      "text": "Should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.39,
      "end_seconds": 310.89,
      "duration_seconds": 10.5,
      "text": "Iron can darken the stools and bother the stomach, so take it after food. Let's get you seen by the gynaecology clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.69,
      "end_seconds": 313.31,
      "duration_seconds": 1.62,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.2,
      "end_seconds": 321.54,
      "duration_seconds": 7.34,
      "text": "Let's plan a check after the results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.98,
      "end_seconds": 326.92,
      "duration_seconds": 3.94,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}