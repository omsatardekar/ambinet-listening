{
  "schema_version": "1.0",
  "encounter_id": "01202",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.67,
      "end_seconds": 2.46,
      "duration_seconds": 1.79,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.58,
      "end_seconds": 6.82,
      "duration_seconds": 3.24,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 7.75,
      "end_seconds": 9.43,
      "duration_seconds": 1.68,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.36,
      "end_seconds": 16.2,
      "duration_seconds": 4.84,
      "text": "Well, I've been having a high fever with shaking chills."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.71,
      "end_seconds": 20.52,
      "duration_seconds": 2.81,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.53,
      "end_seconds": 24.88,
      "duration_seconds": 3.35,
      "text": "It's been about two weeks now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.03,
      "end_seconds": 28.95,
      "duration_seconds": 2.92,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 30.65,
      "end_seconds": 33.71,
      "duration_seconds": 3.06,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.69,
      "end_seconds": 38.25,
      "duration_seconds": 3.56,
      "text": "Right, I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.85,
      "end_seconds": 53.23,
      "duration_seconds": 2.38,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.48,
      "end_seconds": 75.12,
      "duration_seconds": 6.64,
      "text": "Okay: respiratory rate 21, BP is 117 over 66, heart rate 95, temperature 38.3."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 77.01,
      "end_seconds": 82.35,
      "duration_seconds": 5.34,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.56,
      "end_seconds": 84.63,
      "duration_seconds": 1.07,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 85.54,
      "end_seconds": 87.51,
      "duration_seconds": 1.97,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 97.88,
      "end_seconds": 103.21,
      "duration_seconds": 5.33,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.87,
      "end_seconds": 108.09,
      "duration_seconds": 2.22,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.88,
      "end_seconds": 129.23,
      "duration_seconds": 2.35,
      "text": "Did you notice any yellow eyes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.78,
      "end_seconds": 134.82,
      "duration_seconds": 2.04,
      "text": "Nope, no yellow eyes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 143.2,
      "duration_seconds": 3.92,
      "text": "Any confusion, cough or neck stiffness at all?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.68,
      "end_seconds": 152.46,
      "duration_seconds": 7.78,
      "text": "Sorry, you know, what was I saying, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.27,
      "end_seconds": 157.93,
      "duration_seconds": 3.66,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.2,
      "end_seconds": 161.93,
      "duration_seconds": 2.73,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.7,
      "end_seconds": 166.04,
      "duration_seconds": 2.34,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.39,
      "end_seconds": 172.48,
      "duration_seconds": 2.09,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.49,
      "end_seconds": 189.14,
      "duration_seconds": 2.65,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 189.79,
      "end_seconds": 193.3,
      "duration_seconds": 3.51,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.6,
      "end_seconds": 200.46,
      "duration_seconds": 2.86,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.51,
      "end_seconds": 205.28,
      "duration_seconds": 3.77,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.65,
      "end_seconds": 226.47,
      "duration_seconds": 3.82,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.78,
      "end_seconds": 238.03,
      "duration_seconds": 10.25,
      "text": "I take Dolo, 650 milligrams, when I get the fever. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.76,
      "end_seconds": 242.73,
      "duration_seconds": 3.97,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.54,
      "end_seconds": 246.36,
      "duration_seconds": 2.82,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.43,
      "end_seconds": 255.85,
      "duration_seconds": 4.42,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 256.92,
      "end_seconds": 258.39,
      "duration_seconds": 1.47,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.51,
      "end_seconds": 278.55,
      "duration_seconds": 15.04,
      "text": "From what you've told me and what I found, I don't have a clear answer today: a fever after travel that must be treated as possible malaria is possible, and so is dengue fever."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.09,
      "end_seconds": 281.11,
      "duration_seconds": 2.02,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.87,
      "end_seconds": 294.57,
      "duration_seconds": 11.7,
      "text": "I can't promise yet, but most people with a fever after travel that must be treated as possible malaria do well once it's treated properly."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.38,
      "end_seconds": 318.06,
      "duration_seconds": 6.68,
      "text": "I want blood tests done, that's for fever. Avoid anti-inflammatory painkillers and keep drinking."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.39,
      "end_seconds": 323.9,
      "duration_seconds": 5.51,
      "text": "Right, right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.34,
      "end_seconds": 329.67,
      "duration_seconds": 4.33,
      "text": "Right, uh, I'll do that. Thank you, doctor."
    }
  ]
}