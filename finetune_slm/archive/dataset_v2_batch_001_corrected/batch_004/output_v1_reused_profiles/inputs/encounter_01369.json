{
  "schema_version": "1.0",
  "encounter_id": "01369",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.01,
      "end_seconds": 4.7,
      "duration_seconds": 3.69,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.51,
      "end_seconds": 12.61,
      "duration_seconds": 6.1,
      "text": "Alright, you're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.16,
      "end_seconds": 21.09,
      "duration_seconds": 7.93,
      "text": "Honestly, it's cramps in my calves at night, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.04,
      "end_seconds": 25.14,
      "duration_seconds": 3.1,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.59,
      "end_seconds": 30.52,
      "duration_seconds": 3.93,
      "text": "It's been going on for nearly five years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.44,
      "end_seconds": 40.52,
      "duration_seconds": 8.08,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.54,
      "end_seconds": 48.83,
      "duration_seconds": 7.29,
      "text": "Severe, really. I notice it more with pointing my toes and lying in bed."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.71,
      "end_seconds": 56.08,
      "duration_seconds": 5.37,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.39,
      "end_seconds": 67.48,
      "duration_seconds": 10.09,
      "text": "My partner and our baby. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.11,
      "end_seconds": 72.97,
      "duration_seconds": 3.86,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.0,
      "end_seconds": 77.68,
      "duration_seconds": 2.68,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.23,
      "end_seconds": 82.55,
      "duration_seconds": 3.32,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.64,
      "end_seconds": 86.92,
      "duration_seconds": 3.28,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.46,
      "end_seconds": 105.81,
      "duration_seconds": 2.35,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.77,
      "end_seconds": 110.03,
      "duration_seconds": 3.26,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.76,
      "end_seconds": 127.8,
      "duration_seconds": 5.04,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.09,
      "end_seconds": 133.43,
      "duration_seconds": 1.34,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.27,
      "end_seconds": 138.01,
      "duration_seconds": 2.74,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.26,
      "end_seconds": 140.95,
      "duration_seconds": 1.69,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.49,
      "end_seconds": 149.41,
      "duration_seconds": 6.92,
      "text": "Have you noticed shortness of breath, back pain, chest pain or weakness in the legs?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.28,
      "end_seconds": 159.48,
      "duration_seconds": 8.2,
      "text": "No, no shortness of breath, back pain, chest pain or weakness in the legs."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.81,
      "end_seconds": 164.2,
      "duration_seconds": 3.39,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.99,
      "end_seconds": 168.13,
      "duration_seconds": 2.14,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.77,
      "end_seconds": 171.09,
      "duration_seconds": 2.32,
      "text": "So, how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.12,
      "end_seconds": 173.1,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.52,
      "end_seconds": 186.52,
      "duration_seconds": 4.0,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.08,
      "end_seconds": 196.5,
      "duration_seconds": 2.42,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.92,
      "end_seconds": 224.68,
      "duration_seconds": 10.76,
      "text": "Okay: temp 36.7 degrees, pulse 77, BP is 112 over 69, respiratory rate 18, SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.74,
      "end_seconds": 230.16,
      "duration_seconds": 3.42,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.22,
      "end_seconds": 239.2,
      "duration_seconds": 0.98,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.07,
      "end_seconds": 243.25,
      "duration_seconds": 2.18,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.8,
      "end_seconds": 257.5,
      "duration_seconds": 6.7,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.21,
      "end_seconds": 277.52,
      "duration_seconds": 16.31,
      "text": "That's all I needed to check. So where does that leave us? I'd lean towards night-time muscle cramps without a worrying cause. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.22,
      "end_seconds": 280.15,
      "duration_seconds": 1.93,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.0,
      "end_seconds": 307.91,
      "duration_seconds": 25.91,
      "text": "I understand the worry. At the moment I'd say it's night-time muscle cramps without a worrying cause, and we'll know more once the a blood sugar test is back. I want a blood sugar test done, that's for tingling feet. It's a routine test and it'll give us a much clearer picture. Keep well hydrated through the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.85,
      "end_seconds": 332.92,
      "duration_seconds": 19.07,
      "text": "Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Blood tests is something we might do if this doesn't improve in a month. See me again in four weeks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.09,
      "end_seconds": 336.3,
      "duration_seconds": 2.21,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.59,
      "end_seconds": 342.52,
      "duration_seconds": 4.93,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.06,
      "end_seconds": 347.48,
      "duration_seconds": 3.42,
      "text": "Great, thank you for your help."
    }
  ]
}