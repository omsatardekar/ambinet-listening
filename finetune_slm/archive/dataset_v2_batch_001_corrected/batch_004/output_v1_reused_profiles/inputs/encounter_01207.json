{
  "schema_version": "1.0",
  "encounter_id": "01207",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.38,
      "end_seconds": 5.0,
      "duration_seconds": 3.62,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 6.01,
      "end_seconds": 11.27,
      "duration_seconds": 5.26,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.1,
      "end_seconds": 15.48,
      "duration_seconds": 3.38,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 16.17,
      "end_seconds": 23.04,
      "duration_seconds": 6.87,
      "text": "It's been feeling very thirsty, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.74,
      "end_seconds": 27.06,
      "duration_seconds": 3.32,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.21,
      "end_seconds": 32.53,
      "duration_seconds": 4.32,
      "text": "It's been about three months, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.24,
      "end_seconds": 39.5,
      "duration_seconds": 6.26,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 39.6,
      "end_seconds": 46.48,
      "duration_seconds": 6.88,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.52,
      "end_seconds": 49.74,
      "duration_seconds": 2.22,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.69,
      "end_seconds": 60.14,
      "duration_seconds": 8.45,
      "text": "I've also had tiredness, for about three months. And there's blurry vision as well, about three months now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.23,
      "end_seconds": 64.59,
      "duration_seconds": 3.36,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.17,
      "end_seconds": 67.77,
      "duration_seconds": 1.6,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.52,
      "end_seconds": 74.06,
      "duration_seconds": 4.54,
      "text": "Have you been feeling very thirsty at any time before this?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 75.79,
      "end_seconds": 80.96,
      "duration_seconds": 5.17,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.13,
      "end_seconds": 88.53,
      "duration_seconds": 6.4,
      "text": "Let me check a few things. Any chest pain, foot sores or weight loss?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.66,
      "end_seconds": 102.85,
      "duration_seconds": 13.19,
      "text": "No, no chest pain, no foot sores, no weight loss. I did have tingling in the feet at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.59,
      "end_seconds": 108.39,
      "duration_seconds": 3.8,
      "text": "Did you get vomiting, abdominal pain or fever?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.67,
      "end_seconds": 116.52,
      "duration_seconds": 4.85,
      "text": "No vomiting, abdominal pain or fever, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.32,
      "end_seconds": 121.64,
      "duration_seconds": 3.32,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 122.54,
      "end_seconds": 124.58,
      "duration_seconds": 2.04,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.57,
      "end_seconds": 129.98,
      "duration_seconds": 3.41,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 134.54,
      "end_seconds": 135.51,
      "duration_seconds": 0.97,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.18,
      "end_seconds": 138.39,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.98,
      "end_seconds": 146.94,
      "duration_seconds": 5.96,
      "text": "I'm on simvastatin, 20 milligrams, maybe, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.53,
      "end_seconds": 151.8,
      "duration_seconds": 3.27,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.61,
      "end_seconds": 155.0,
      "duration_seconds": 2.39,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.46,
      "end_seconds": 161.32,
      "duration_seconds": 4.86,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.98,
      "end_seconds": 172.92,
      "duration_seconds": 9.94,
      "text": "Yes, diabetes. I've, I've had high blood pressure, yes. I've had high cholesterol for about ten years now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.0,
      "end_seconds": 179.6,
      "duration_seconds": 4.6,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 180.73,
      "end_seconds": 190.28,
      "duration_seconds": 9.55,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.24,
      "end_seconds": 210.44,
      "duration_seconds": 1.2,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.83,
      "end_seconds": 216.05,
      "duration_seconds": 4.22,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.26,
      "end_seconds": 219.19,
      "duration_seconds": 1.93,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.29,
      "end_seconds": 224.13,
      "duration_seconds": 3.84,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.73,
      "end_seconds": 228.79,
      "duration_seconds": 3.06,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.37,
      "end_seconds": 234.63,
      "duration_seconds": 2.26,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 240.89,
      "end_seconds": 255.96,
      "duration_seconds": 15.07,
      "text": "Okay, so the vitals from earlier. Height 164 centimetres, temp 36.5 degrees, weight 81 kilos, BP is 154 over 100, BMI works out to 30.1, heart rate 93, oxygen saturation is 98 percent."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.91,
      "end_seconds": 258.61,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.42,
      "end_seconds": 265.08,
      "duration_seconds": 3.66,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 267.06,
      "end_seconds": 268.52,
      "duration_seconds": 1.46,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.21,
      "end_seconds": 282.85,
      "duration_seconds": 6.64,
      "text": "Your feet look fine, no ulcers or sores, and the pulses are palpable."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.49,
      "end_seconds": 286.46,
      "duration_seconds": 1.97,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.76,
      "end_seconds": 309.21,
      "duration_seconds": 4.45,
      "text": "Sensation to the monofilament is reduced on the right foot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.95,
      "end_seconds": 316.89,
      "duration_seconds": 2.94,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 325.31,
      "end_seconds": 352.77,
      "duration_seconds": 27.46,
      "text": "Let me tell you where I've got to. I'd lean towards diabetes that isn't well controlled. That's my thinking for now, and it may change as we learn more. A urine infection is also on my list. Let me repeat that back to make sure. You've been feeling very thirsty for about three months, and no fever or chest pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 354.59,
      "end_seconds": 357.74,
      "duration_seconds": 3.15,
      "text": "Uh, yes, you've got it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.84,
      "end_seconds": 385.87,
      "duration_seconds": 26.03,
      "text": "Let's book a urine protein test to look into diabetes. We should do kidney function tests for diabetes. For this, glimepiride, 1 milligrams, before breakfast, until we review. You take it by mouth. That should help with blood sugar control. Cut back on sweets, sugary drinks and white rice, and keep to regular meal times. I think a dietitian should see you too."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 387.0,
      "end_seconds": 388.75,
      "duration_seconds": 1.75,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 389.5,
      "end_seconds": 398.34,
      "duration_seconds": 8.84,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 399.18,
      "end_seconds": 407.62,
      "duration_seconds": 8.44,
      "text": "I, I know what to watch for. Do I need an eye check? I read it might help."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 408.19,
      "end_seconds": 428.21,
      "duration_seconds": 20.02,
      "text": "Not at this point, no. It isn't indicated yet. If you vomit repeatedly or become drowsy, or you feel really unwell, please come to the emergency department. We'll catch up after the results are back. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 429.96,
      "end_seconds": 432.79,
      "duration_seconds": 2.83,
      "text": "Great, thank you for your help."
    }
  ]
}