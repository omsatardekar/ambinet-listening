{
  "schema_version": "1.0",
  "encounter_id": "01090",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 4.12,
      "duration_seconds": 3.36,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.17,
      "end_seconds": 9.3,
      "duration_seconds": 4.13,
      "text": "Okay, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.39,
      "end_seconds": 15.63,
      "duration_seconds": 5.24,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.44,
      "end_seconds": 20.43,
      "duration_seconds": 3.99,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.38,
      "end_seconds": 26.53,
      "duration_seconds": 4.15,
      "text": "So the thing is, I've got trouble sleeping."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.66,
      "end_seconds": 31.41,
      "duration_seconds": 3.75,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.48,
      "end_seconds": 36.1,
      "duration_seconds": 2.62,
      "text": "Around two weeks, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 37.37,
      "end_seconds": 41.42,
      "duration_seconds": 4.05,
      "text": "Erm, hm, I'd say more like three weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.43,
      "end_seconds": 47.15,
      "duration_seconds": 4.72,
      "text": "Okay, so roughly two to three weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.21,
      "end_seconds": 50.27,
      "duration_seconds": 1.06,
      "text": "Yeah, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.44,
      "end_seconds": 54.31,
      "duration_seconds": 2.87,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.23,
      "end_seconds": 65.52,
      "duration_seconds": 10.29,
      "text": "A eight out of ten, I suppose. I've also had a tight chest when stressed, for about a year."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.61,
      "end_seconds": 70.03,
      "duration_seconds": 2.42,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.52,
      "end_seconds": 77.46,
      "duration_seconds": 5.94,
      "text": "It comes and goes. I've also been losing interest in things."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.14,
      "end_seconds": 83.44,
      "duration_seconds": 5.3,
      "text": "Have you had trouble sleeping before, or is this the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.26,
      "end_seconds": 92.16,
      "duration_seconds": 6.9,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.21,
      "end_seconds": 101.59,
      "duration_seconds": 7.38,
      "text": "A few quick ones: panic attacks, weight loss, thoughts of harming myself or drinking more?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.91,
      "end_seconds": 109.62,
      "duration_seconds": 6.71,
      "text": "No, no panic attacks, weight loss, thoughts of harming myself or drinking more."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.71,
      "end_seconds": 114.08,
      "duration_seconds": 2.37,
      "text": "Alright, what about chest pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.62,
      "end_seconds": 116.65,
      "duration_seconds": 2.03,
      "text": "No, no chest pain."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.88,
      "end_seconds": 121.1,
      "duration_seconds": 3.22,
      "text": "So, is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.76,
      "end_seconds": 123.53,
      "duration_seconds": 1.77,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.2,
      "end_seconds": 128.58,
      "duration_seconds": 4.38,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.16,
      "end_seconds": 131.09,
      "duration_seconds": 1.93,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.25,
      "end_seconds": 135.59,
      "duration_seconds": 3.34,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.68,
      "end_seconds": 142.15,
      "duration_seconds": 4.47,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.42,
      "end_seconds": 160.87,
      "duration_seconds": 1.45,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.25,
      "end_seconds": 165.29,
      "duration_seconds": 3.04,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.2,
      "end_seconds": 167.14,
      "duration_seconds": 0.94,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.32,
      "end_seconds": 171.55,
      "duration_seconds": 3.23,
      "text": "I gave up cigarettes last spring."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.31,
      "end_seconds": 178.38,
      "duration_seconds": 2.07,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.22,
      "end_seconds": 181.46,
      "duration_seconds": 2.24,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.28,
      "end_seconds": 187.13,
      "duration_seconds": 1.85,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.64,
      "end_seconds": 190.93,
      "duration_seconds": 2.29,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.45,
      "end_seconds": 192.74,
      "duration_seconds": 1.29,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.68,
      "end_seconds": 199.22,
      "duration_seconds": 4.54,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.68,
      "end_seconds": 218.64,
      "duration_seconds": 3.96,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.46,
      "end_seconds": 225.26,
      "duration_seconds": 4.8,
      "text": "It's escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.15,
      "end_seconds": 231.72,
      "duration_seconds": 4.57,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.61,
      "end_seconds": 234.53,
      "duration_seconds": 1.92,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.3,
      "end_seconds": 237.35,
      "duration_seconds": 2.05,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.81,
      "end_seconds": 240.21,
      "duration_seconds": 1.4,
      "text": "I've got anxiety."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.2,
      "end_seconds": 244.9,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.85,
      "end_seconds": 249.49,
      "duration_seconds": 2.64,
      "text": "Depression, for about ten years."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.55,
      "end_seconds": 252.86,
      "duration_seconds": 1.31,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.52,
      "end_seconds": 261.67,
      "duration_seconds": 8.15,
      "text": "Okay, I can see depression in your file as well. Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.24,
      "end_seconds": 264.72,
      "duration_seconds": 2.48,
      "text": "My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.69,
      "end_seconds": 268.22,
      "duration_seconds": 2.53,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.11,
      "end_seconds": 277.43,
      "duration_seconds": 2.32,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.21,
      "end_seconds": 302.56,
      "duration_seconds": 8.35,
      "text": "Okay: heart rate 86, BP is 111 over 73, oxygen saturation is 99 percent, temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.63,
      "end_seconds": 305.02,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.86,
      "end_seconds": 308.78,
      "duration_seconds": 2.92,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.78,
      "end_seconds": 316.22,
      "duration_seconds": 4.44,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.88,
      "end_seconds": 330.86,
      "duration_seconds": 0.98,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.89,
      "end_seconds": 335.2,
      "duration_seconds": 3.31,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.19,
      "end_seconds": 354.56,
      "duration_seconds": 6.37,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 358.08,
      "end_seconds": 372.15,
      "duration_seconds": 14.07,
      "text": "All finished, thank you. Let me tell you where I've got to. My working impression is low mood linked to work stress. It could also be an under-active thyroid, so we'll keep that open."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.17,
      "end_seconds": 377.41,
      "duration_seconds": 3.24,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.56,
      "end_seconds": 391.84,
      "duration_seconds": 13.28,
      "text": "Nothing I've seen today points to an emergency. It looks like low mood linked to work stress, but I'd like to confirm. I think a blood count makes sense here, for fatigue."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 392.91,
      "end_seconds": 394.99,
      "duration_seconds": 2.08,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.34,
      "end_seconds": 414.1,
      "duration_seconds": 17.76,
      "text": "Try a short walk each day and keep a regular bedtime. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 415.67,
      "end_seconds": 418.55,
      "duration_seconds": 2.88,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.36,
      "end_seconds": 421.3,
      "duration_seconds": 1.94,
      "text": "Right, goodbye for now."
    }
  ]
}