{
  "schema_version": "1.0",
  "encounter_id": "01451",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.6,
      "end_seconds": 7.09,
      "duration_seconds": 6.49,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.82,
      "end_seconds": 11.61,
      "duration_seconds": 3.79,
      "text": "Thanks, that's helpful. Hello, please sit. What's been happening?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.47,
      "end_seconds": 14.54,
      "duration_seconds": 2.07,
      "text": "It's occasional nausea, mostly."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.53,
      "end_seconds": 18.74,
      "duration_seconds": 2.21,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.48,
      "end_seconds": 29.69,
      "duration_seconds": 7.21,
      "text": "Around three days... no wait, um, it's more like two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.76,
      "end_seconds": 36.77,
      "duration_seconds": 5.01,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 39.27,
      "end_seconds": 46.53,
      "duration_seconds": 7.26,
      "text": "Ah, you know, it's moderate, honestly. Honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.07,
      "end_seconds": 49.45,
      "duration_seconds": 2.38,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.2,
      "end_seconds": 55.39,
      "duration_seconds": 4.19,
      "text": "It usually comes with headaches for a while."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 56.22,
      "end_seconds": 62.14,
      "duration_seconds": 5.92,
      "text": "I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 62.24,
      "end_seconds": 69.05,
      "duration_seconds": 6.81,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.53,
      "end_seconds": 75.08,
      "duration_seconds": 2.55,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.03,
      "end_seconds": 83.11,
      "duration_seconds": 6.08,
      "text": "Right, the headaches for a while? That's been for about a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.68,
      "end_seconds": 86.76,
      "duration_seconds": 3.08,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 88.82,
      "end_seconds": 95.18,
      "duration_seconds": 6.36,
      "text": "Okay, so maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.78,
      "end_seconds": 100.79,
      "duration_seconds": 3.01,
      "text": "Have you had any fever or seizures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.45,
      "end_seconds": 114.57,
      "duration_seconds": 13.12,
      "text": "No, no fever, no seizures. I did have pressure behind the eyes at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.74,
      "end_seconds": 118.56,
      "duration_seconds": 2.82,
      "text": "Did you get head injury or weakness?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 119.42,
      "end_seconds": 123.84,
      "duration_seconds": 4.42,
      "text": "Ah, uh, no, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.68,
      "end_seconds": 131.19,
      "duration_seconds": 5.51,
      "text": "Let me check a few things. Any confusion or jaw pain on chewing?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 133.01,
      "end_seconds": 138.31,
      "duration_seconds": 5.3,
      "text": "I haven't had confusion or jaw pain on chewing, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.95,
      "end_seconds": 141.76,
      "duration_seconds": 2.81,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.85,
      "end_seconds": 150.11,
      "duration_seconds": 6.26,
      "text": "I mean, um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.92,
      "end_seconds": 168.94,
      "duration_seconds": 3.02,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.3,
      "end_seconds": 176.17,
      "duration_seconds": 5.87,
      "text": "Actually, yes, I had part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.73,
      "end_seconds": 182.15,
      "duration_seconds": 5.42,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 184.05,
      "end_seconds": 197.68,
      "duration_seconds": 13.63,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.36,
      "end_seconds": 203.06,
      "duration_seconds": 3.7,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 204.66,
      "end_seconds": 218.17,
      "duration_seconds": 13.51,
      "text": "Sorry, what was I saying, I have high blood pressure. My sister suggested writing things down, but I forgot. I've got anxiety."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.04,
      "end_seconds": 228.24,
      "duration_seconds": 9.2,
      "text": "Alright, anxiety, that matches what I have here. So, any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.86,
      "end_seconds": 231.62,
      "duration_seconds": 2.76,
      "text": "Well, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.88,
      "end_seconds": 244.65,
      "duration_seconds": 3.77,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 245.66,
      "end_seconds": 255.19,
      "duration_seconds": 9.53,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. Escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 256.06,
      "end_seconds": 261.04,
      "duration_seconds": 4.98,
      "text": "Doctor, our chart from the last visit lists it as 5 milligrams."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.26,
      "end_seconds": 265.86,
      "duration_seconds": 3.6,
      "text": "Hm. Do you have the latest prescription with you?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 266.43,
      "end_seconds": 274.8,
      "duration_seconds": 8.37,
      "text": "Uh, I don't think I have it with me. Paracetamol, 500 milligrams, when it hurts."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 280.69,
      "duration_seconds": 4.64,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 281.56,
      "end_seconds": 297.8,
      "duration_seconds": 16.24,
      "text": "I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 298.35,
      "end_seconds": 306.24,
      "duration_seconds": 7.89,
      "text": "Okay, so the vitals from earlier. Pulse 86, saturation 98 percent, temperature 36.5. BP is 110 over 79."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.73,
      "end_seconds": 309.05,
      "duration_seconds": 1.32,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.21,
      "end_seconds": 313.16,
      "duration_seconds": 1.95,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.01,
      "end_seconds": 317.57,
      "duration_seconds": 2.56,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.25,
      "end_seconds": 331.38,
      "duration_seconds": 5.13,
      "text": "Visual fields are full to confrontation and the optic discs look normal."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.78,
      "end_seconds": 335.13,
      "duration_seconds": 2.35,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.5,
      "end_seconds": 350.14,
      "duration_seconds": 3.64,
      "text": "Power and reflexes are equal on both sides."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.37,
      "end_seconds": 366.35,
      "duration_seconds": 11.98,
      "text": "You can relax now. So, based on the history and the examination, this is probably a headache disorder of uncertain type. Another possibility is tension-type headache."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 368.37,
      "end_seconds": 373.23,
      "duration_seconds": 4.86,
      "text": "Hmm, you know, will it clear up?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.09,
      "end_seconds": 389.05,
      "duration_seconds": 13.96,
      "text": "It's reasonable to be concerned, but right now a headache disorder of uncertain type is my leading thought, not anything worse. I'm going to order an eye pressure check, for headache with blurred vision."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 391.12,
      "end_seconds": 394.54,
      "duration_seconds": 3.42,
      "text": "I can book that for Thursday at 9 am."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.28,
      "end_seconds": 420.12,
      "duration_seconds": 24.84,
      "text": "I'm sending you for an MRI of the brain because of headaches with visual symptoms. Note down each headache with the date, time and what you were doing. I'd like you to see a neurologist as well, and I'll write the referral. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.9,
      "end_seconds": 436.96,
      "duration_seconds": 15.06,
      "text": "The thing that would worry me is if you get sudden worst-ever headache or weakness. If that happens, go to emergency. Let's review you after the scan. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 437.55,
      "end_seconds": 441.83,
      "duration_seconds": 4.28,
      "text": "Right, good, thanks, I'll see you then."
    }
  ]
}