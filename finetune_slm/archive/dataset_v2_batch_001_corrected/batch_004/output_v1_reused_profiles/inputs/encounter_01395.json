{
  "schema_version": "1.0",
  "encounter_id": "01395",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 7.02,
      "duration_seconds": 6.4,
      "text": "doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.14,
      "end_seconds": 14.45,
      "duration_seconds": 4.31,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.95,
      "end_seconds": 24.25,
      "duration_seconds": 8.3,
      "text": "Actually, mainly swelling in my left calf. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.75,
      "end_seconds": 29.43,
      "duration_seconds": 4.68,
      "text": "When did this begin? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.42,
      "end_seconds": 33.27,
      "duration_seconds": 2.85,
      "text": "It's been like this since Monday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.73,
      "end_seconds": 43.33,
      "duration_seconds": 8.6,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.91,
      "end_seconds": 56.3,
      "duration_seconds": 12.39,
      "text": "Honestly, on and off. Mostly moderate. I get some relief from raising the leg. It's worse with standing. I've also had a bit of redness."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.91,
      "end_seconds": 60.54,
      "duration_seconds": 2.63,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.36,
      "end_seconds": 65.02,
      "duration_seconds": 3.66,
      "text": "I'm vegetarian and have been for years"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.02,
      "end_seconds": 69.76,
      "duration_seconds": 2.74,
      "text": "what line of work are you in?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.4,
      "end_seconds": 75.93,
      "duration_seconds": 5.53,
      "text": "I'm a bus driver, so I sit for long hours"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.78,
      "end_seconds": 82.08,
      "duration_seconds": 2.3,
      "text": "do you do any exercise?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.93,
      "end_seconds": 85.18,
      "duration_seconds": 2.25,
      "text": "I swim twice a week"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.88,
      "end_seconds": 89.88,
      "duration_seconds": 4.0,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.31,
      "end_seconds": 94.16,
      "duration_seconds": 2.85,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.48,
      "end_seconds": 106.62,
      "duration_seconds": 4.14,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.65,
      "end_seconds": 110.5,
      "duration_seconds": 1.85,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.81,
      "end_seconds": 130.02,
      "duration_seconds": 2.21,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.53,
      "end_seconds": 138.18,
      "duration_seconds": 2.65,
      "text": "I take paracetamol, when needed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.04,
      "end_seconds": 141.46,
      "duration_seconds": 2.42,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.64,
      "end_seconds": 143.64,
      "duration_seconds": 1.0,
      "text": "500 milligrams."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.72,
      "end_seconds": 166.6,
      "duration_seconds": 5.88,
      "text": "Have you had any swelling in the other leg, coughing up blood or breathlessness?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.05,
      "end_seconds": 172.53,
      "duration_seconds": 2.48,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.65,
      "end_seconds": 176.03,
      "duration_seconds": 2.38,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 177.77,
      "end_seconds": 181.2,
      "duration_seconds": 3.43,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.75,
      "end_seconds": 185.45,
      "duration_seconds": 3.7,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.95,
      "end_seconds": 196.59,
      "duration_seconds": 2.64,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.41,
      "end_seconds": 214.0,
      "duration_seconds": 6.59,
      "text": "Okay: pressure 129 over 81, oxygen saturation is 96 percent, heart rate 120."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.71,
      "end_seconds": 217.15,
      "duration_seconds": 1.44,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.16,
      "end_seconds": 222.07,
      "duration_seconds": 2.91,
      "text": "So, I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.66,
      "end_seconds": 226.13,
      "duration_seconds": 2.47,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.2,
      "end_seconds": 228.65,
      "duration_seconds": 1.45,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.43,
      "end_seconds": 250.26,
      "duration_seconds": 5.83,
      "text": "The left calf is bigger than the right, tender along the vein."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.74,
      "end_seconds": 258.12,
      "duration_seconds": 2.38,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.42,
      "end_seconds": 277.34,
      "duration_seconds": 5.92,
      "text": "Right, here's what I'm thinking. It fits best with a possible deep vein clot."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.81,
      "end_seconds": 281.87,
      "duration_seconds": 3.06,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.53,
      "end_seconds": 300.49,
      "duration_seconds": 17.96,
      "text": "I understand the worry at the moment I'd say it's a possible deep vein clot, and we'll know more once the a Doppler scan of the leg is back. a Doppler scan of the leg is what I'd like next, for suspected DVT"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.55,
      "end_seconds": 303.45,
      "duration_seconds": 1.9,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.23,
      "end_seconds": 323.49,
      "duration_seconds": 18.26,
      "text": "Keep walking gently, and don't massage the calf. Let's hold off on a D-dimer blood test for now, and if there's no change in a month we can revisit it. If you get chest pain or sudden breathlessness, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.82,
      "end_seconds": 328.22,
      "duration_seconds": 3.4,
      "text": "okay, I'll look out for that"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.99,
      "end_seconds": 331.92,
      "duration_seconds": 2.93,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.79,
      "end_seconds": 335.94,
      "duration_seconds": 3.15,
      "text": "I think I understand everything thanks"
    }
  ]
}