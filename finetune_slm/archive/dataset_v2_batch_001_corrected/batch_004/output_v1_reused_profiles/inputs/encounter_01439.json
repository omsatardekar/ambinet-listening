{
  "schema_version": "1.0",
  "encounter_id": "01439",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.7,
      "end_seconds": 5.84,
      "duration_seconds": 5.14,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.17,
      "end_seconds": 10.12,
      "duration_seconds": 2.95,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.87,
      "end_seconds": 12.12,
      "duration_seconds": 1.25,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.54,
      "end_seconds": 27.48,
      "duration_seconds": 11.94,
      "text": "Doctor, it's a bump on my head. It's getting on my nerves now. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.39,
      "end_seconds": 30.3,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.88,
      "end_seconds": 40.08,
      "duration_seconds": 8.2,
      "text": "I mean, for about four days, I'd say. I've had a sore neck too, for ten days."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.89,
      "end_seconds": 45.63,
      "duration_seconds": 3.74,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.39,
      "end_seconds": 57.73,
      "duration_seconds": 2.34,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.63,
      "end_seconds": 84.23,
      "duration_seconds": 10.6,
      "text": "Okay: pulse is 65 beats a minute, oxygen saturation is 97 percent, blood pressure 121 over 74. And temperature is 36.9 degrees."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.24,
      "end_seconds": 89.53,
      "duration_seconds": 3.29,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.56,
      "end_seconds": 93.34,
      "duration_seconds": 2.78,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.55,
      "end_seconds": 117.55,
      "duration_seconds": 8.0,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.18,
      "end_seconds": 132.42,
      "duration_seconds": 10.24,
      "text": "Okay, that's enough for me. Any clear fluid from the nose or ear, double vision, loss of consciousness or weakness at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.34,
      "end_seconds": 142.79,
      "duration_seconds": 8.45,
      "text": "No, no clear fluid from the nose or ear, double vision, loss of consciousness or weakness."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.15,
      "end_seconds": 146.65,
      "duration_seconds": 2.5,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.09,
      "end_seconds": 150.67,
      "duration_seconds": 2.58,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.27,
      "end_seconds": 154.28,
      "duration_seconds": 2.01,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.11,
      "end_seconds": 159.31,
      "duration_seconds": 4.2,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 160.17,
      "end_seconds": 161.38,
      "duration_seconds": 1.21,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.69,
      "end_seconds": 165.98,
      "duration_seconds": 3.29,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.59,
      "end_seconds": 178.92,
      "duration_seconds": 3.33,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 180.13,
      "end_seconds": 182.25,
      "duration_seconds": 2.12,
      "text": "No, uh, none."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.49,
      "end_seconds": 200.15,
      "duration_seconds": 3.66,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.69,
      "end_seconds": 204.09,
      "duration_seconds": 3.4,
      "text": "Ah, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.68,
      "end_seconds": 222.04,
      "duration_seconds": 1.36,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.88,
      "end_seconds": 225.81,
      "duration_seconds": 2.93,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 237.37,
      "duration_seconds": 10.26,
      "text": "Let me tell you where I've got to. I think we're dealing with a minor head injury without worrying signs at this stage."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.04,
      "end_seconds": 242.28,
      "duration_seconds": 3.24,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.62,
      "end_seconds": 265.2,
      "duration_seconds": 21.58,
      "text": "I understand the worry. At the moment I'd say it's a minor head injury without worrying signs, and we'll watch how it goes. Stop me if I've got anything wrong. You've had a bump on your head for about four days, and no loss of consciousness or double vision."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 270.28,
      "end_seconds": 270.98,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.91,
      "end_seconds": 314.56,
      "duration_seconds": 33.65,
      "text": "The treatment will be paracetamol, 1 gram, every six hours if needed, for three days. That's for headache. The pharmacy will go through the details again when you pick it up. Someone should stay with you tonight, and no alcohol or contact sport for now. If you vomit repeatedly, become drowsy or confused, or have a fit, or you feel really unwell, please come to the emergency department. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.24,
      "end_seconds": 317.37,
      "duration_seconds": 2.13,
      "text": "Thank you, that's helpful."
    }
  ]
}