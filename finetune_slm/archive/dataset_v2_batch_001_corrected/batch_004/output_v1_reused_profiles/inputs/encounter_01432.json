{
  "schema_version": "1.0",
  "encounter_id": "01432",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.85,
      "end_seconds": 4.88,
      "duration_seconds": 4.03,
      "text": "hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.25,
      "end_seconds": 11.14,
      "duration_seconds": 4.89,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.65,
      "end_seconds": 18.37,
      "duration_seconds": 6.72,
      "text": "Yeah, it's pain in my right ankle. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.18,
      "end_seconds": 21.06,
      "duration_seconds": 1.88,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.47,
      "end_seconds": 24.87,
      "duration_seconds": 2.4,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.13,
      "end_seconds": 30.35,
      "duration_seconds": 5.22,
      "text": "Yes. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.95,
      "end_seconds": 42.41,
      "duration_seconds": 10.46,
      "text": "Putting weight on it and walking definitely sets it off pretty severe, if I'm being honest and bruising, too"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.95,
      "end_seconds": 50.19,
      "duration_seconds": 6.24,
      "text": "did you get fever, pain at the back of the heel or pop or crack?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.41,
      "end_seconds": 59.78,
      "duration_seconds": 8.37,
      "text": "No, uh, no fever, pain at the back of the heel or pop or crack."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.58,
      "end_seconds": 63.1,
      "duration_seconds": 1.52,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.02,
      "end_seconds": 65.93,
      "duration_seconds": 1.91,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.72,
      "end_seconds": 70.28,
      "duration_seconds": 2.56,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.36,
      "end_seconds": 74.03,
      "duration_seconds": 1.67,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.32,
      "end_seconds": 78.72,
      "duration_seconds": 3.4,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.67,
      "end_seconds": 87.0,
      "duration_seconds": 6.33,
      "text": "I have low haemoglobin. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.6,
      "end_seconds": 89.41,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.02,
      "end_seconds": 92.55,
      "duration_seconds": 1.53,
      "text": "Yes, heart disease."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.53,
      "end_seconds": 104.53,
      "duration_seconds": 10.0,
      "text": "Right, so low haemoglobin is already on your record. We'll keep that in mind today. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.26,
      "end_seconds": 109.08,
      "duration_seconds": 2.82,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.87,
      "end_seconds": 125.83,
      "duration_seconds": 1.96,
      "text": "and alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.98,
      "end_seconds": 129.79,
      "duration_seconds": 2.81,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.86,
      "end_seconds": 134.74,
      "duration_seconds": 2.88,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.99,
      "end_seconds": 139.41,
      "duration_seconds": 3.42,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.06,
      "end_seconds": 143.92,
      "duration_seconds": 3.86,
      "text": "What do you do during the the day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.78,
      "end_seconds": 148.6,
      "duration_seconds": 3.82,
      "text": "I look after my grandchildren most days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.38,
      "end_seconds": 167.48,
      "duration_seconds": 2.1,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.6,
      "end_seconds": 179.36,
      "duration_seconds": 10.76,
      "text": "I'm on iron tablets, once a day for my blood count i'd been on clopidogrel, not any more though, I stopped"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.52,
      "end_seconds": 189.67,
      "duration_seconds": 2.15,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.23,
      "end_seconds": 195.99,
      "duration_seconds": 5.76,
      "text": "yes, I had two stents put in my heart, three years ago"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.61,
      "end_seconds": 200.77,
      "duration_seconds": 3.16,
      "text": "I'll note down your vital signs first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.78,
      "end_seconds": 216.74,
      "duration_seconds": 2.96,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.16,
      "end_seconds": 238.99,
      "duration_seconds": 8.83,
      "text": "Okay: blood pressure 110 over 76, oxygen saturation is 98 percent, pulse 80. And temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.97,
      "end_seconds": 242.15,
      "duration_seconds": 2.18,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.3,
      "end_seconds": 245.79,
      "duration_seconds": 2.49,
      "text": "we'll go over that that shortly"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.04,
      "end_seconds": 250.89,
      "duration_seconds": 3.85,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.81,
      "end_seconds": 255.76,
      "duration_seconds": 2.95,
      "text": "So, take a deep breath for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.67,
      "end_seconds": 277.99,
      "duration_seconds": 6.32,
      "text": "The bones themselves aren't tender and the ankle feels stable when I test it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.14,
      "end_seconds": 280.32,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.38,
      "end_seconds": 303.36,
      "duration_seconds": 6.98,
      "text": "There's swelling and bruising on the outer side of the ankle, tender over the ligament."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.73,
      "end_seconds": 313.97,
      "duration_seconds": 8.24,
      "text": "okay, that's enough for me. So, based on the history and the examination, my working impression is an ankle sprain"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.91,
      "end_seconds": 316.95,
      "duration_seconds": 2.04,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.68,
      "end_seconds": 329.54,
      "duration_seconds": 11.86,
      "text": "I can't promise yet, but most people with an ankle sprain do well once it's treated properly. I want an X-ray of the ankle done, that's for ankle injury."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.51,
      "end_seconds": 334.79,
      "duration_seconds": 2.28,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.74,
      "end_seconds": 362.0,
      "duration_seconds": 26.26,
      "text": "The treatment will be ibuprofen, 400 milligrams, three times a day after food, for three days. You take it by mouth. That's for ankle pain. Rest, ice for twenty minutes at a time, a compression bandage and keep the foot up. Don't skip meals, and try to eat smaller portions more often through the day. I'm going to send a referral to physiotherapy."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 362.66,
      "end_seconds": 365.09,
      "duration_seconds": 2.43,
      "text": "sure, where do I go?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.42,
      "end_seconds": 368.83,
      "duration_seconds": 2.41,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.69,
      "end_seconds": 372.87,
      "duration_seconds": 3.18,
      "text": "I think I understand everything thanks"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.53,
      "end_seconds": 375.98,
      "duration_seconds": 1.45,
      "text": "Take care now."
    }
  ]
}