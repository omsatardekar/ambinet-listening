{
  "schema_version": "1.0",
  "encounter_id": "01054",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.73,
      "end_seconds": 6.02,
      "duration_seconds": 5.29,
      "text": "Actually, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.9,
      "end_seconds": 11.14,
      "duration_seconds": 4.24,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.28,
      "end_seconds": 16.8,
      "duration_seconds": 4.52,
      "text": "So the thing is, I've got my heart racing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.72,
      "end_seconds": 20.98,
      "duration_seconds": 3.26,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.37,
      "end_seconds": 32.67,
      "duration_seconds": 10.3,
      "text": "Right, I've had it for two years. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.02,
      "end_seconds": 36.66,
      "duration_seconds": 2.64,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.7,
      "end_seconds": 41.54,
      "duration_seconds": 3.84,
      "text": "It happens once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.04,
      "end_seconds": 43.06,
      "duration_seconds": 1.02,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.8,
      "end_seconds": 47.97,
      "duration_seconds": 4.17,
      "text": "I've been losing weight despite eating well too."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.4,
      "end_seconds": 52.71,
      "duration_seconds": 3.31,
      "text": "Any eye pain, chest pain or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.69,
      "end_seconds": 58.78,
      "duration_seconds": 4.09,
      "text": "Hmm, no, none of those at all."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.79,
      "end_seconds": 63.16,
      "duration_seconds": 3.37,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.68,
      "end_seconds": 67.82,
      "duration_seconds": 3.14,
      "text": "Hmm, no, joints are fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.92,
      "end_seconds": 71.58,
      "duration_seconds": 2.66,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.22,
      "end_seconds": 76.05,
      "duration_seconds": 3.83,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.12,
      "end_seconds": 80.0,
      "duration_seconds": 2.88,
      "text": "Right, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.99,
      "end_seconds": 83.53,
      "duration_seconds": 2.54,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.96,
      "end_seconds": 99.8,
      "duration_seconds": 2.84,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.53,
      "end_seconds": 101.55,
      "duration_seconds": 1.02,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.46,
      "end_seconds": 112.98,
      "duration_seconds": 3.52,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.03,
      "end_seconds": 117.21,
      "duration_seconds": 3.18,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.51,
      "end_seconds": 123.17,
      "duration_seconds": 4.66,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.92,
      "end_seconds": 127.66,
      "duration_seconds": 2.74,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.82,
      "end_seconds": 132.12,
      "duration_seconds": 3.3,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.87,
      "end_seconds": 149.8,
      "duration_seconds": 16.93,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. I swim twice a week. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.64,
      "end_seconds": 155.53,
      "duration_seconds": 4.89,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.56,
      "end_seconds": 165.99,
      "duration_seconds": 2.43,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.61,
      "end_seconds": 199.62,
      "duration_seconds": 12.01,
      "text": "Okay: BMI works out to 21.3, respiratory rate 19, pressure 138 over 88. And height 180 centimetres, weight 69 kilos, heart rate 119, temperature 36.5."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.79,
      "end_seconds": 204.96,
      "duration_seconds": 4.17,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.82,
      "end_seconds": 207.14,
      "duration_seconds": 1.32,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.88,
      "end_seconds": 223.89,
      "duration_seconds": 5.01,
      "text": "There is a smooth, small swelling at the front of the neck."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.89,
      "end_seconds": 232.36,
      "duration_seconds": 2.47,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.69,
      "end_seconds": 269.6,
      "duration_seconds": 25.91,
      "text": "So where does that leave us? I'm honestly not certain yet. It could be an overactive thyroid, or it might be an abnormal heart rhythm. Let's get a thyroid scan, for neck swelling. An ECG is what I'd like next, for palpitations. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 270.25,
      "end_seconds": 271.39,
      "duration_seconds": 1.14,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.01,
      "end_seconds": 305.88,
      "duration_seconds": 33.87,
      "text": "I'm going to put you on propranolol, 20 milligrams, twice a day, until review. That should help with racing heart and tremor. Try to avoid caffeine while we sort this out. Thyroid blood tests is something we might do if this doesn't improve in a month. Do get help quickly if the symptoms get worse. Let's plan a check after the thyroid results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.97,
      "end_seconds": 311.55,
      "duration_seconds": 3.58,
      "text": "Ah, no, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.84,
      "end_seconds": 314.83,
      "duration_seconds": 1.99,
      "text": "Right, take care now."
    }
  ]
}