{
  "schema_version": "1.0",
  "encounter_id": "01286",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 4.78,
      "duration_seconds": 3.92,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.56,
      "end_seconds": 10.68,
      "duration_seconds": 5.12,
      "text": "right, you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.52,
      "end_seconds": 14.45,
      "duration_seconds": 2.93,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.74,
      "end_seconds": 18.9,
      "duration_seconds": 3.16,
      "text": "please do. Extra information is always welcome"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.56,
      "end_seconds": 32.23,
      "duration_seconds": 12.67,
      "text": "I'm here because of staring spells that others noticed i'm hoping you can tell me something definite i've been reading about it online and it worried me"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.41,
      "end_seconds": 37.01,
      "duration_seconds": 3.6,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.95,
      "end_seconds": 41.76,
      "duration_seconds": 3.81,
      "text": "It's been about two weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.91,
      "end_seconds": 45.75,
      "duration_seconds": 2.84,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.47,
      "end_seconds": 47.5,
      "duration_seconds": 1.03,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.27,
      "end_seconds": 53.26,
      "duration_seconds": 4.99,
      "text": "What about a metallic taste before it, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.97,
      "end_seconds": 59.72,
      "duration_seconds": 4.75,
      "text": "I mean, yes, about the same, about four days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.84,
      "end_seconds": 63.7,
      "duration_seconds": 2.86,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.54,
      "end_seconds": 79.46,
      "duration_seconds": 14.92,
      "text": "It feels mild to me. I've had an odd smell before it too, for one week. Erm, there was a strange episode where I blanked out, yes, but that went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.47,
      "end_seconds": 84.95,
      "duration_seconds": 4.48,
      "text": "have you had any alcohol before it, fever or tongue biting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.41,
      "end_seconds": 90.37,
      "duration_seconds": 3.96,
      "text": "No, uh, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.33,
      "end_seconds": 97.54,
      "duration_seconds": 5.21,
      "text": "Any losing control of the bladder, head injury or jerking movements at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.44,
      "end_seconds": 105.51,
      "duration_seconds": 7.07,
      "text": "let me think, no, no losing control of the bladder, head injury or jerking movements"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.41,
      "end_seconds": 110.51,
      "duration_seconds": 4.1,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.18,
      "end_seconds": 112.68,
      "duration_seconds": 1.5,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.39,
      "end_seconds": 116.34,
      "duration_seconds": 1.95,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.67,
      "end_seconds": 119.73,
      "duration_seconds": 2.06,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.77,
      "end_seconds": 143.14,
      "duration_seconds": 5.37,
      "text": "Any inherited conditions that you know of in the the family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.7,
      "end_seconds": 150.77,
      "duration_seconds": 7.07,
      "text": "Let me think, um, my son has asthma. My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.8,
      "end_seconds": 169.63,
      "duration_seconds": 5.83,
      "text": "do you have any chronic illnesses? Just so I get the full picture"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.5,
      "end_seconds": 173.28,
      "duration_seconds": 2.78,
      "text": "Anxiety, for about ten years"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.86,
      "end_seconds": 174.87,
      "duration_seconds": 1.01,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.58,
      "end_seconds": 186.18,
      "duration_seconds": 10.6,
      "text": "I've got asthma i did try to ignore it for a while i thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.09,
      "end_seconds": 197.78,
      "duration_seconds": 10.69,
      "text": "okay, I can see anxiety and asthma in your file as well okay, are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 198.46,
      "end_seconds": 208.35,
      "duration_seconds": 9.89,
      "text": "She takes escitalopram, 10 milligrams, once a day. She takes Foracort inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.98,
      "end_seconds": 215.57,
      "duration_seconds": 5.59,
      "text": "I used to take Seretide inhaler, but I stopped it."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.03,
      "end_seconds": 223.04,
      "duration_seconds": 3.01,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 223.87,
      "end_seconds": 228.24,
      "duration_seconds": 4.37,
      "text": "yeah, I don't think I have any, no"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 231.33,
      "end_seconds": 238.68,
      "duration_seconds": 7.35,
      "text": "Actually, I remember she had some kinda reaction to amoxicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.39,
      "end_seconds": 247.75,
      "duration_seconds": 3.36,
      "text": "Maybe, but I don't recall it."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.75,
      "end_seconds": 255.85,
      "duration_seconds": 6.1,
      "text": "Fair enough, I'll write down both versions. A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.9,
      "end_seconds": 270.6,
      "duration_seconds": 13.7,
      "text": "My husband and I live above the shop. I'm vegetarian and have been for years. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.0,
      "end_seconds": 274.92,
      "duration_seconds": 2.92,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.19,
      "end_seconds": 290.32,
      "duration_seconds": 2.13,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.02,
      "end_seconds": 321.7,
      "duration_seconds": 12.68,
      "text": "Okay: temperature is 36.5 degrees, blood pressure 121 over 68, pulse is 74 beats a minute. And oxygen saturation is 97 percent, respiratory rate 14."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.32,
      "end_seconds": 327.95,
      "duration_seconds": 4.63,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.07,
      "end_seconds": 330.07,
      "duration_seconds": 1.0,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.9,
      "end_seconds": 334.72,
      "duration_seconds": 3.82,
      "text": "Stay as you are for a a moment."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.12,
      "end_seconds": 351.05,
      "duration_seconds": 4.93,
      "text": "You're alert, speech is normal and and cranial nerves are intact."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.6,
      "end_seconds": 354.64,
      "duration_seconds": 2.04,
      "text": "Alright, does that hurt?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.51,
      "end_seconds": 373.13,
      "duration_seconds": 2.62,
      "text": "Coordination is normal on finger-to-nose testing"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.4,
      "end_seconds": 380.53,
      "duration_seconds": 2.13,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.35,
      "end_seconds": 406.06,
      "duration_seconds": 17.71,
      "text": "So where does that leave us? I can't pin this down yet. We're looking at a possible focal seizure that needs investigating or a panic episode. I'm sending you for blood tests because of episode of altered awareness."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 407.69,
      "end_seconds": 410.22,
      "duration_seconds": 2.53,
      "text": "Mm, is that done today?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 411.1,
      "end_seconds": 440.79,
      "duration_seconds": 29.69,
      "text": "I'm sending you for an MRI of the brain because of possible seizure don't drive until we've looked into this the neurology clinic would be the right next step, I'll refer you if you have another episode that lasts more than a few minutes, or you feel really unwell, please come to the emergency department i'd like to see you again in four weeks"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.08,
      "end_seconds": 446.78,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 447.48,
      "end_seconds": 450.93,
      "duration_seconds": 3.45,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 451.8,
      "end_seconds": 455.31,
      "duration_seconds": 3.51,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 456.78,
      "end_seconds": 458.04,
      "duration_seconds": 1.26,
      "text": "Goodbye for now."
    }
  ]
}