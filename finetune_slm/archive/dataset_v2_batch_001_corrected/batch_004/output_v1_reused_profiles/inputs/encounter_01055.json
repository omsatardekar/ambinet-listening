  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.0,
      "end_seconds": 6.68,
      "duration_seconds": 5.68,
      "text": "Well, you know, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.47,
      "end_seconds": 15.68,
      "duration_seconds": 5.21,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.34,
      "end_seconds": 21.78,
      "duration_seconds": 5.44,
      "text": "well, I've been dealing with tiny spots between my fingers"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.22,
      "end_seconds": 26.67,
      "duration_seconds": 3.45,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.59,
      "end_seconds": 29.92,
      "duration_seconds": 2.33,
      "text": "About... well, two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.34,
      "end_seconds": 35.25,
      "duration_seconds": 3.91,
      "text": "Alright, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.3,
      "end_seconds": 40.25,
      "duration_seconds": 2.95,
      "text": "It feels severe to me."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.2,
      "end_seconds": 44.96,
      "duration_seconds": 3.76,
      "text": "Has there been trouble sleeping because of it too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.03,
      "end_seconds": 50.7,
      "duration_seconds": 1.67,
      "text": "yes, I have"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.13,
      "end_seconds": 52.46,
      "duration_seconds": 1.33,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.64,
      "end_seconds": 73.73,
      "duration_seconds": 6.09,
      "text": "let me check a few things any pus, rash on the face or joint pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.45,
      "end_seconds": 79.29,
      "duration_seconds": 3.84,
      "text": "I mean, nope, nothing like that."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.35,
      "end_seconds": 89.61,
      "duration_seconds": 6.26,
      "text": "Let me check a few things. Any new soaps or itching in other family members?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.67,
      "end_seconds": 93.94,
      "duration_seconds": 3.27,
      "text": "ah, nope, nothing like that"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.19,
      "end_seconds": 102.88,
      "duration_seconds": 2.69,
      "text": "so, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.06,
      "end_seconds": 106.2,
      "duration_seconds": 2.14,
      "text": "no, all normal there"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.69,
      "end_seconds": 121.87,
      "duration_seconds": 1.18,
      "text": "any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.53,
      "end_seconds": 123.83,
      "duration_seconds": 1.3,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.39,
      "end_seconds": 128.21,
      "duration_seconds": 3.82,
      "text": "right, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.46,
      "end_seconds": 142.97,
      "duration_seconds": 13.51,
      "text": "sorry, what was I saying, I've had eczema for five years now i thought it would sort itself out, but it hasn't"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.43,
      "end_seconds": 155.88,
      "duration_seconds": 11.45,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.57,
      "end_seconds": 159.35,
      "duration_seconds": 1.78,
      "text": "no known allergies"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.38,
      "end_seconds": 165.04,
      "duration_seconds": 4.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.97,
      "end_seconds": 179.87,
      "duration_seconds": 12.9,
      "text": "I retired from the post office two years ago. I'm vegetarian and have been for years. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.71,
      "end_seconds": 192.85,
      "duration_seconds": 2.14,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.46,
      "end_seconds": 196.62,
      "duration_seconds": 3.16,
      "text": "It's, It's hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 201.46,
      "duration_seconds": 3.25,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.39,
      "end_seconds": 212.79,
      "duration_seconds": 2.4,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.52,
      "end_seconds": 237.64,
      "duration_seconds": 10.12,
      "text": "okay: pulse 72, respiratory rate 15. And temp 36.8 degrees, blood pressure 110 over 77, oxygen saturation is 99 percent"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.23,
      "end_seconds": 241.51,
      "duration_seconds": 2.28,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.08,
      "end_seconds": 244.8,
      "duration_seconds": 1.72,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.9,
      "end_seconds": 257.12,
      "duration_seconds": 5.22,
      "text": "Tiny linear burrows between the fingers and scratched papules on the wrists."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.42,
      "end_seconds": 271.61,
      "duration_seconds": 9.19,
      "text": "thank you, you can get dressed. So, based on the history and the examination, this is probably scabies"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.11,
      "end_seconds": 281.85,
      "duration_seconds": 4.74,
      "text": "Let me think, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.41,
      "end_seconds": 309.6,
      "duration_seconds": 27.19,
      "text": "I understand the worry at the moment I'd say it's scabies, and we'll watch how it goes what I'm giving you is permethrin cream, applied once, repeated in a week, for two applications that's for scabies everyone in the house should be treated at the same time, and bedding washed hot i'd like you back in two weeks anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.28,
      "end_seconds": 316.3,
      "duration_seconds": 5.02,
      "text": "yeah, okay, that makes sense thanks for explaining"
    }
  ]
}