{
  "schema_version": "1.0",
  "encounter_id": "01356",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.85,
      "end_seconds": 6.48,
      "duration_seconds": 5.63,
      "text": "Doctor, this one's ready for you. Everything's on the chart, but I'll go through it."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.24,
      "end_seconds": 11.56,
      "duration_seconds": 4.32,
      "text": "Thank you. Good morning, tell me what's been going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.56,
      "end_seconds": 21.14,
      "duration_seconds": 4.58,
      "text": "I've been dealing with pain low in the pelvis."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.66,
      "end_seconds": 24.77,
      "duration_seconds": 3.11,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 26.36,
      "end_seconds": 42.54,
      "duration_seconds": 16.18,
      "text": "Let me think, for two days, I'd say. I thought it would sort itself out, but it hasn't. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.22,
      "end_seconds": 45.88,
      "duration_seconds": 2.66,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 47.7,
      "end_seconds": 52.91,
      "duration_seconds": 5.21,
      "text": "I get some relief from a hot water bottle."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.92,
      "end_seconds": 57.88,
      "duration_seconds": 2.96,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.81,
      "end_seconds": 61.89,
      "duration_seconds": 2.08,
      "text": "It's every other day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.2,
      "end_seconds": 66.49,
      "duration_seconds": 3.29,
      "text": "Has there been pain during sex too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.99,
      "end_seconds": 87.82,
      "duration_seconds": 19.83,
      "text": "Yes, um, about the same, five days. So, you know, as for pain around my period, I honestly can't say when that began. It might have been last month or the month before. Right, there's bloating as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.77,
      "end_seconds": 93.06,
      "duration_seconds": 3.29,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 94.22,
      "end_seconds": 95.35,
      "duration_seconds": 1.13,
      "text": "Mostly severe."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.27,
      "end_seconds": 99.7,
      "duration_seconds": 2.43,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.53,
      "end_seconds": 102.76,
      "duration_seconds": 2.23,
      "text": "I have high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.74,
      "end_seconds": 105.44,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.09,
      "end_seconds": 112.55,
      "duration_seconds": 5.46,
      "text": "Actually, I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.22,
      "end_seconds": 122.12,
      "duration_seconds": 7.9,
      "text": "Mm, okay. Do you take any prescribed or over-the-counter medicines? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 123.33,
      "end_seconds": 127.54,
      "duration_seconds": 4.21,
      "text": "I'm on simvastatin, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.7,
      "end_seconds": 130.88,
      "duration_seconds": 2.18,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 131.94,
      "end_seconds": 137.72,
      "duration_seconds": 5.78,
      "text": "It's 20 milligrams. Ramipril. I take it 5 milligrams, every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 138.32,
      "end_seconds": 143.14,
      "duration_seconds": 4.82,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.02,
      "end_seconds": 148.91,
      "duration_seconds": 3.89,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 150.57,
      "end_seconds": 156.06,
      "duration_seconds": 5.49,
      "text": "I, I don't think I have it with me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.08,
      "end_seconds": 161.05,
      "duration_seconds": 2.97,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.34,
      "end_seconds": 166.39,
      "duration_seconds": 4.05,
      "text": "Just part of my thyroid removed, years back."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.58,
      "end_seconds": 180.71,
      "duration_seconds": 5.13,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 181.37,
      "end_seconds": 193.9,
      "duration_seconds": 12.53,
      "text": "I grab fast food at lunch most days. Not much, I mostly stay in these days. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.56,
      "end_seconds": 206.5,
      "duration_seconds": 3.94,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.41,
      "end_seconds": 214.13,
      "duration_seconds": 6.72,
      "text": "Yeah, my son has asthma. Okay, so my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.46,
      "end_seconds": 220.73,
      "duration_seconds": 5.27,
      "text": "Let me check a few things. Any fever or bleeding between periods?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 222.77,
      "end_seconds": 227.57,
      "duration_seconds": 4.8,
      "text": "Mm, uh, no, I'd have said so."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.47,
      "end_seconds": 233.27,
      "duration_seconds": 3.8,
      "text": "Have you noticed vomiting or burning when passing urine?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 233.97,
      "end_seconds": 240.94,
      "duration_seconds": 6.97,
      "text": "Hmm, I haven't had vomiting or burning when passing urine, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.28,
      "end_seconds": 244.24,
      "duration_seconds": 1.96,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 244.84,
      "end_seconds": 247.72,
      "duration_seconds": 2.88,
      "text": "Actually, no, skin's been fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 248.63,
      "end_seconds": 261.3,
      "duration_seconds": 12.67,
      "text": "Doctor, I've got the readings for you. Respiratory rate 14, temperature is 36.9 degrees, SpO2 97 percent on room air. Pulse is 64 beats a minute, blood pressure 118 over 74."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.97,
      "end_seconds": 264.37,
      "duration_seconds": 1.4,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.61,
      "end_seconds": 270.23,
      "duration_seconds": 4.62,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 271.95,
      "end_seconds": 272.65,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.38,
      "end_seconds": 276.8,
      "duration_seconds": 2.42,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.94,
      "end_seconds": 293.96,
      "duration_seconds": 5.02,
      "text": "There's tenderness in the lower tummy on the left, and no guarding."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.78,
      "end_seconds": 316.58,
      "duration_seconds": 17.8,
      "text": "Okay, that's enough for me. Okay, thinking it through, my working impression is chronic pelvic pain, possibly endometriosis. I want to be honest that this is an impression, not a final answer. I'd also keep a pelvic infection in mind."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 317.84,
      "end_seconds": 321.01,
      "duration_seconds": 3.17,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.82,
      "end_seconds": 333.32,
      "duration_seconds": 11.5,
      "text": "I understand the worry. At the moment I'd say it's chronic pelvic pain, possibly endometriosis, and we'll know more once the a pregnancy test is back."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 345.0,
      "end_seconds": 349.58,
      "duration_seconds": 4.58,
      "text": "I've already done a pregnancy test, it's ready for you."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.49,
      "end_seconds": 357.67,
      "duration_seconds": 6.18,
      "text": "Good, thanks for doing that. We should do a pelvic ultrasound for pelvic pain."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 358.22,
      "end_seconds": 363.06,
      "duration_seconds": 4.84,
      "text": "Okay, you know, so when would that take place?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.15,
      "end_seconds": 377.54,
      "duration_seconds": 13.39,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 378.18,
      "end_seconds": 382.07,
      "duration_seconds": 3.89,
      "text": "Uh, I think I understand everything. Thanks."
    }
  ]
}