{
  "schema_version": "1.0",
  "encounter_id": "01017",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.09,
      "end_seconds": 5.99,
      "duration_seconds": 4.9,
      "text": "Right, thanks for waiting, come in. Where shall we begin?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.49,
      "end_seconds": 11.36,
      "duration_seconds": 3.87,
      "text": "It's burning when I pass urine, mostly."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.88,
      "end_seconds": 19.56,
      "duration_seconds": 6.68,
      "text": "how long has it been like this? Bear with me, I'm just building up the picture"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.58,
      "end_seconds": 28.05,
      "duration_seconds": 6.47,
      "text": "It's been ten days, I'm fairly sure. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.63,
      "end_seconds": 32.71,
      "duration_seconds": 4.08,
      "text": "Have you been needing to go all the time?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 33.81,
      "end_seconds": 36.77,
      "duration_seconds": 2.96,
      "text": "Yeah. About four days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.53,
      "end_seconds": 42.3,
      "duration_seconds": 4.77,
      "text": "A few quick ones: vaginal discharge, loin pain or vomiting?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.21,
      "end_seconds": 48.17,
      "duration_seconds": 4.96,
      "text": "no vaginal discharge, loin pain or vomiting, none of it"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.57,
      "end_seconds": 52.6,
      "duration_seconds": 3.03,
      "text": "did you get fever or new partner?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.8,
      "end_seconds": 57.29,
      "duration_seconds": 3.49,
      "text": "no, no fever or new partner"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.16,
      "end_seconds": 62.21,
      "duration_seconds": 4.05,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.8,
      "end_seconds": 65.93,
      "duration_seconds": 3.13,
      "text": "Uh, no, that's all normal."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.34,
      "end_seconds": 74.64,
      "duration_seconds": 4.3,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.23,
      "end_seconds": 82.03,
      "duration_seconds": 5.8,
      "text": "Not currently, but as a youngster naproxen gave me a rash."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.3,
      "end_seconds": 87.33,
      "duration_seconds": 4.03,
      "text": "let's talk a little about your daily life and habits"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.8,
      "end_seconds": 99.51,
      "duration_seconds": 10.71,
      "text": "No, I share a house with my brother. I look after my grandchildren most days. I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.29,
      "end_seconds": 103.56,
      "duration_seconds": 3.27,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 105.29,
      "end_seconds": 106.34,
      "duration_seconds": 1.05,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.8,
      "end_seconds": 110.92,
      "duration_seconds": 3.12,
      "text": "do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.35,
      "end_seconds": 119.44,
      "duration_seconds": 7.09,
      "text": "I take Glycomet, 500 milligrams, twice a day. Cranberry juice i take it every day"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.72,
      "end_seconds": 130.94,
      "duration_seconds": 2.22,
      "text": "any surgery in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.59,
      "end_seconds": 138.33,
      "duration_seconds": 5.74,
      "text": "just a mole taken off my arm, a few years ago"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.52,
      "end_seconds": 149.91,
      "duration_seconds": 3.39,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.47,
      "end_seconds": 160.58,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 177.26,
      "end_seconds": 183.2,
      "duration_seconds": 5.94,
      "text": "okay: temperature 36.6, BP is 120 over 72, saturation 99 percent, pulse 79."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.62,
      "end_seconds": 190.17,
      "duration_seconds": 4.55,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.45,
      "end_seconds": 205.15,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.15,
      "end_seconds": 208.47,
      "duration_seconds": 1.32,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.44,
      "end_seconds": 230.68,
      "duration_seconds": 6.24,
      "text": "Your tummy is soft with mild tenderness low down and no pain in the loins."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.63,
      "end_seconds": 244.02,
      "duration_seconds": 10.39,
      "text": "All finished, thank you. Let me tell you where I've got to. It fits best with a lower urinary tract infection. Vaginal irritation is still possible."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.33,
      "end_seconds": 248.54,
      "duration_seconds": 3.21,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.22,
      "end_seconds": 262.16,
      "duration_seconds": 12.94,
      "text": "It's reasonable to be concerned, but right now a lower urinary tract infection is my leading thought, not anything worse. I'm sending you for a urine culture cos of recurrent urinary infection."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.11,
      "end_seconds": 267.06,
      "duration_seconds": 2.95,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.79,
      "end_seconds": 292.16,
      "duration_seconds": 23.37,
      "text": "I'm going to order a urine test, for dysuria. Let's use nitrofurantoin, 100 milligrams, twice a day, for three days. It's for urinary infection. I'll put all of this in writing so you don't have to remember it. Drink plenty of water and don't hold on when you need to go."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.49,
      "end_seconds": 299.12,
      "duration_seconds": 6.63,
      "text": "Ah. If you get fever, loin pain or vomiting, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.93,
      "end_seconds": 300.93,
      "duration_seconds": 1.0,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.13,
      "end_seconds": 310.42,
      "duration_seconds": 8.29,
      "text": "let's plan a check after the culture result. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.28,
      "end_seconds": 313.79,
      "duration_seconds": 2.51,
      "text": "Alright, thanks, take care."
    }
  ]
}