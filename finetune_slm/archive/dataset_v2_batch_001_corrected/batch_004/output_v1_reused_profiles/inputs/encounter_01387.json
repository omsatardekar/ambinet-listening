{
  "schema_version": "1.0",
  "encounter_id": "01387",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.3,
      "end_seconds": 4.32,
      "duration_seconds": 3.02,
      "text": "Hello, sorry about the delay, do sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.02,
      "end_seconds": 9.2,
      "duration_seconds": 3.18,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 10.67,
      "end_seconds": 14.22,
      "duration_seconds": 3.55,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.24,
      "end_seconds": 20.95,
      "duration_seconds": 5.71,
      "text": "Yes, that's no problem at all. Please sit. Have you been waiting long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.41,
      "end_seconds": 25.49,
      "duration_seconds": 3.08,
      "text": "Right, only about ten minutes, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.19,
      "end_seconds": 29.87,
      "duration_seconds": 2.68,
      "text": "what do you need help with?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.15,
      "end_seconds": 36.86,
      "duration_seconds": 5.71,
      "text": "it's nausea i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.6,
      "end_seconds": 48.54,
      "duration_seconds": 2.94,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 50.31,
      "end_seconds": 51.99,
      "duration_seconds": 1.68,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.34,
      "end_seconds": 60.77,
      "duration_seconds": 8.43,
      "text": "Yes, carry on. Alright, is it it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.25,
      "end_seconds": 69.6,
      "duration_seconds": 7.35,
      "text": "Honestly, a few times a day. I'd been feeling unsteady, but that went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.43,
      "end_seconds": 79.37,
      "duration_seconds": 4.94,
      "text": "Have you had nausea before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.03,
      "end_seconds": 89.48,
      "duration_seconds": 6.45,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.64,
      "end_seconds": 96.75,
      "duration_seconds": 6.11,
      "text": "Any slurred speech, numbness in the face, hearing loss or double vision at all?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.59,
      "end_seconds": 105.37,
      "duration_seconds": 6.78,
      "text": "No, no slurred speech, numbness in the face, hearing loss or double vision."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.54,
      "end_seconds": 108.13,
      "duration_seconds": 1.59,
      "text": "Any sign of headache?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.17,
      "end_seconds": 111.65,
      "duration_seconds": 2.48,
      "text": "No, none, no headache."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.22,
      "end_seconds": 116.6,
      "duration_seconds": 4.38,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.24,
      "end_seconds": 120.36,
      "duration_seconds": 3.12,
      "text": "Actually, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.25,
      "end_seconds": 124.96,
      "duration_seconds": 3.71,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.06,
      "end_seconds": 129.27,
      "duration_seconds": 2.21,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.43,
      "end_seconds": 140.1,
      "duration_seconds": 3.67,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.07,
      "end_seconds": 148.21,
      "duration_seconds": 4.14,
      "text": "I take Vertin, 16 milligrams, when it comes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.3,
      "end_seconds": 151.79,
      "duration_seconds": 2.49,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.8,
      "end_seconds": 161.91,
      "duration_seconds": 6.11,
      "text": "Just a mole taken off my arm, a few years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.61,
      "end_seconds": 165.19,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.48,
      "end_seconds": 171.95,
      "duration_seconds": 1.47,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.46,
      "end_seconds": 176.35,
      "duration_seconds": 2.89,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.55,
      "end_seconds": 192.03,
      "duration_seconds": 10.48,
      "text": "I swim twice a week. My husband and I live above the shop. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.75,
      "end_seconds": 195.92,
      "duration_seconds": 2.17,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.2,
      "end_seconds": 199.57,
      "duration_seconds": 2.37,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.61,
      "end_seconds": 215.33,
      "duration_seconds": 4.72,
      "text": "your walking is steady and the finger-nose test is normal"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 233.53,
      "end_seconds": 235.73,
      "duration_seconds": 2.2,
      "text": "okay, um, doctor"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.46,
      "end_seconds": 238.63,
      "duration_seconds": 1.17,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.21,
      "end_seconds": 257.23,
      "duration_seconds": 7.02,
      "text": "When I turn your head to the right, your eyes flick sideways, that's called nystagmus."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.04,
      "end_seconds": 260.1,
      "duration_seconds": 1.06,
      "text": "okay, doctor"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.23,
      "end_seconds": 277.8,
      "duration_seconds": 13.57,
      "text": "good, you can sit up again putting it all together, I don't have a clear answer today: benign positional vertigo is possible, and so is an inner ear infection"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.08,
      "end_seconds": 282.57,
      "duration_seconds": 3.49,
      "text": "is there something to to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.44,
      "end_seconds": 297.9,
      "duration_seconds": 14.46,
      "text": "It's reasonable to be concerned, but right now benign positional vertigo is my leading thought, not anything worse. I think a hearing test makes sense here, for tinnitus and vertigo."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.37,
      "end_seconds": 302.5,
      "duration_seconds": 1.13,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 332.78,
      "duration_seconds": 28.21,
      "text": "There's a simple head manoeuvre we can do, and I'll show you how to repeat it at home. The thing that would worry me is if you get weakness, slurred speech or a severe headache with the dizziness. If that happens, go to to emergency. Come back in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.21,
      "end_seconds": 338.19,
      "duration_seconds": 3.98,
      "text": "Erm, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.23,
      "end_seconds": 344.58,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}