{
  "schema_version": "1.0",
  "encounter_id": "01097",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 5.27,
      "duration_seconds": 4.05,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.97,
      "end_seconds": 12.08,
      "duration_seconds": 5.11,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.19,
      "end_seconds": 23.48,
      "duration_seconds": 6.29,
      "text": "Oh, good afternoon, doctor. I look after them so I thought I'd come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.6,
      "end_seconds": 27.6,
      "duration_seconds": 3.0,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.5,
      "end_seconds": 38.06,
      "duration_seconds": 9.56,
      "text": "I wanted to get straining to pass stool looked at. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.7,
      "end_seconds": 42.39,
      "duration_seconds": 3.69,
      "text": "Right, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.91,
      "end_seconds": 47.16,
      "duration_seconds": 4.25,
      "text": "Uh, I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 49.13,
      "end_seconds": 55.04,
      "duration_seconds": 5.91,
      "text": "Let me think, it was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.54,
      "end_seconds": 61.49,
      "duration_seconds": 4.95,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.68,
      "end_seconds": 91.57,
      "duration_seconds": 28.89,
      "text": "Let me think, that sounds about right. Right, um, as for heavy feeling in the lower tummy, I honestly can't say when that began. It might have been last month or the month before. There's constipation as well. Um, and there's hard pellet-like stools as well, about a month now."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.54,
      "end_seconds": 95.9,
      "duration_seconds": 3.36,
      "text": "A few quick ones: fever or black stools?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.54,
      "end_seconds": 100.55,
      "duration_seconds": 3.01,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.14,
      "end_seconds": 107.32,
      "duration_seconds": 5.18,
      "text": "Have you had any abdominal swelling or pain on passing stool?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.16,
      "end_seconds": 114.5,
      "duration_seconds": 6.34,
      "text": "I haven't had abdominal swelling or pain on passing stool, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.8,
      "end_seconds": 118.99,
      "duration_seconds": 3.19,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.93,
      "end_seconds": 125.03,
      "duration_seconds": 4.1,
      "text": "I mean, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.54,
      "end_seconds": 128.1,
      "duration_seconds": 2.56,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.83,
      "end_seconds": 130.56,
      "duration_seconds": 1.73,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.29,
      "end_seconds": 150.25,
      "duration_seconds": 1.96,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.63,
      "end_seconds": 158.38,
      "duration_seconds": 6.75,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.32,
      "end_seconds": 162.02,
      "duration_seconds": 1.7,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.61,
      "end_seconds": 166.31,
      "duration_seconds": 2.7,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.22,
      "end_seconds": 169.44,
      "duration_seconds": 1.22,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.6,
      "end_seconds": 174.96,
      "duration_seconds": 4.36,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.54,
      "end_seconds": 177.67,
      "duration_seconds": 2.13,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.25,
      "end_seconds": 186.08,
      "duration_seconds": 7.83,
      "text": "Thyroxine. I take it 75 micrograms, every morning. It's, It's Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.41,
      "end_seconds": 189.52,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.59,
      "end_seconds": 196.69,
      "duration_seconds": 6.1,
      "text": "500 milligrams. I, I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 198.24,
      "end_seconds": 207.26,
      "duration_seconds": 9.02,
      "text": "Doctor, I think the last prescription for the clopidogrel was 150 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.25,
      "end_seconds": 213.14,
      "duration_seconds": 4.89,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.79,
      "end_seconds": 221.06,
      "duration_seconds": 6.27,
      "text": "I don't think I have it with me. Cremaffin, at night."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.99,
      "end_seconds": 244.1,
      "duration_seconds": 4.11,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.26,
      "end_seconds": 256.17,
      "duration_seconds": 8.91,
      "text": "I have an underactive thyroid, for about ten years. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.56,
      "end_seconds": 258.76,
      "duration_seconds": 1.2,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.59,
      "end_seconds": 274.85,
      "duration_seconds": 14.26,
      "text": "I've, I've had diabetes for nearly five years now. I kept putting it off, which I know isn't sensible. I've had heart disease for nearly five years now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.21,
      "end_seconds": 291.26,
      "duration_seconds": 12.05,
      "text": "Yes, diabetes and heart disease are known to us, good to have that clear. Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.18,
      "end_seconds": 295.84,
      "duration_seconds": 3.66,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 297.83,
      "end_seconds": 307.94,
      "duration_seconds": 10.11,
      "text": "Here are the numbers, doctor. Blood pressure 113 over 73, pulse is 80 beats a minute. Saturation 97 percent, temperature is 36.7 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.39,
      "end_seconds": 310.09,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.84,
      "end_seconds": 315.94,
      "duration_seconds": 4.1,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.16,
      "end_seconds": 323.86,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.74,
      "end_seconds": 327.71,
      "duration_seconds": 2.97,
      "text": "Okay, take a deep breath for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.88,
      "end_seconds": 346.58,
      "duration_seconds": 4.7,
      "text": "I can feel firm stool in the left lower abdomen."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.06,
      "end_seconds": 351.05,
      "duration_seconds": 2.99,
      "text": "Okay, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.05,
      "end_seconds": 366.97,
      "duration_seconds": 2.92,
      "text": "There's no mass in the tummy."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 372.42,
      "end_seconds": 383.04,
      "duration_seconds": 10.62,
      "text": "Okay, that's enough for me. Let's book blood tests to look into constipation. Let's book a colonoscopy to look into constipation and rectal bleeding."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 383.87,
      "end_seconds": 387.89,
      "duration_seconds": 4.02,
      "text": "Mm, where would I go for that?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 388.78,
      "end_seconds": 423.83,
      "duration_seconds": 35.05,
      "text": "Let's use lactulose, 15 ml, at night, for two weeks. You take it by mouth. That should help with constipation. I'll put all of this in writing so you don't have to remember it. More fibre, more water, and give yourself ten unhurried minutes after breakfast. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's plan a check in a month."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 424.9,
      "end_seconds": 427.44,
      "duration_seconds": 2.54,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 428.66,
      "end_seconds": 432.22,
      "duration_seconds": 3.56,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 433.91,
      "end_seconds": 435.25,
      "duration_seconds": 1.34,
      "text": "See you soon."
    }
  ]
}