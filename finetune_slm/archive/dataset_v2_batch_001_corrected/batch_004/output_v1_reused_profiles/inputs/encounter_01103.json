{
  "schema_version": "1.0",
  "encounter_id": "01103",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.08,
      "end_seconds": 5.78,
      "duration_seconds": 4.7,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.07,
      "end_seconds": 11.77,
      "duration_seconds": 4.7,
      "text": "So, no problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.8,
      "end_seconds": 18.67,
      "duration_seconds": 5.87,
      "text": "Honestly, it's constipation, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.19,
      "end_seconds": 23.84,
      "duration_seconds": 3.65,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.56,
      "end_seconds": 36.4,
      "duration_seconds": 10.84,
      "text": "It's gliclazide, 80 milligrams, twice a day for my sugar. Thyronorm, 50 micrograms, every morning. Cremaffin. I take it at night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.92,
      "end_seconds": 41.35,
      "duration_seconds": 3.43,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.93,
      "end_seconds": 45.29,
      "duration_seconds": 3.36,
      "text": "For about a month, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.84,
      "end_seconds": 50.18,
      "duration_seconds": 4.34,
      "text": "Sure. Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.98,
      "end_seconds": 52.67,
      "duration_seconds": 1.69,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.72,
      "end_seconds": 56.07,
      "duration_seconds": 2.35,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.79,
      "end_seconds": 63.2,
      "duration_seconds": 5.41,
      "text": "It usually comes with a little bright blood on the paper."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.78,
      "end_seconds": 69.4,
      "duration_seconds": 4.62,
      "text": "Have you had constipation before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.38,
      "end_seconds": 76.37,
      "duration_seconds": 5.99,
      "text": "Oh, I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.16,
      "end_seconds": 81.88,
      "duration_seconds": 4.72,
      "text": "And what about weight loss, black stools, vomiting or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.71,
      "end_seconds": 86.3,
      "duration_seconds": 2.59,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.16,
      "end_seconds": 90.59,
      "duration_seconds": 2.43,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.67,
      "end_seconds": 94.17,
      "duration_seconds": 1.5,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.31,
      "end_seconds": 100.56,
      "duration_seconds": 5.25,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.38,
      "end_seconds": 103.77,
      "duration_seconds": 1.39,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.73,
      "end_seconds": 107.81,
      "duration_seconds": 3.08,
      "text": "Right, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.49,
      "end_seconds": 111.79,
      "duration_seconds": 2.3,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 112.42,
      "end_seconds": 114.77,
      "duration_seconds": 2.35,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.64,
      "end_seconds": 119.78,
      "duration_seconds": 3.14,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.82,
      "end_seconds": 125.62,
      "duration_seconds": 1.8,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 135.92,
      "duration_seconds": 5.24,
      "text": "I've had an underactive thyroid for about ten years now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.52,
      "end_seconds": 145.03,
      "duration_seconds": 8.51,
      "text": "Alright, diabetes, that matches what I have here. So, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.32,
      "end_seconds": 158.42,
      "duration_seconds": 12.1,
      "text": "I'm vegetarian and have been for years. I walk the dog every morning. Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.98,
      "end_seconds": 178.04,
      "duration_seconds": 3.06,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.83,
      "end_seconds": 187.29,
      "duration_seconds": 2.46,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.2,
      "end_seconds": 212.22,
      "duration_seconds": 9.02,
      "text": "Okay: saturation 99 percent, temp 37.0 degrees, respiratory rate 15, pressure 110 over 77, pulse is 85 beats a minute."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.51,
      "end_seconds": 216.12,
      "duration_seconds": 2.61,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.72,
      "end_seconds": 219.03,
      "duration_seconds": 1.31,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.26,
      "end_seconds": 233.67,
      "duration_seconds": 2.41,
      "text": "There's no mass in the tummy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.67,
      "end_seconds": 235.62,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.91,
      "end_seconds": 238.35,
      "duration_seconds": 1.44,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.18,
      "end_seconds": 251.54,
      "duration_seconds": 4.36,
      "text": "I can feel firm stool in the left lower abdomen."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.77,
      "end_seconds": 255.38,
      "duration_seconds": 1.61,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.34,
      "end_seconds": 279.05,
      "duration_seconds": 4.71,
      "text": "Okay, so my impression is this: It points towards chronic constipation."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.84,
      "end_seconds": 282.18,
      "duration_seconds": 2.34,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.79,
      "end_seconds": 289.48,
      "duration_seconds": 6.69,
      "text": "I can't promise yet, but most people with chronic constipation do well once it's treated properly."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.95,
      "end_seconds": 311.91,
      "duration_seconds": 7.96,
      "text": "I'd like to arrange a colonoscopy for constipation and rectal bleeding. Let's book blood tests to look into constipation."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.47,
      "end_seconds": 314.88,
      "duration_seconds": 2.41,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.35,
      "end_seconds": 324.41,
      "duration_seconds": 8.06,
      "text": "I'd like you to take lactulose, 15 ml, at night, for two weeks. That should help with constipation."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.67,
      "end_seconds": 328.06,
      "duration_seconds": 2.39,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.63,
      "end_seconds": 341.2,
      "duration_seconds": 11.57,
      "text": "More fibre, more water, and give yourself ten unhurried minutes after breakfast. I'll want another look in a month. Right, does all of that make sense?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.28,
      "end_seconds": 344.47,
      "duration_seconds": 2.19,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.18,
      "end_seconds": 347.14,
      "duration_seconds": 1.96,
      "text": "Have a good day."
    }
  ]
}