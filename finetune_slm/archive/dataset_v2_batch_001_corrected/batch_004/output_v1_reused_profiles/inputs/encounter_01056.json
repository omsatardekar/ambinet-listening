{
  "schema_version": "1.0",
  "encounter_id": "01056",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 5.24,
      "duration_seconds": 4.29,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.81,
      "end_seconds": 9.58,
      "duration_seconds": 3.77,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.9,
      "end_seconds": 27.73,
      "duration_seconds": 16.83,
      "text": "Mainly I've been forgetting recent things. That's why I came. As for repeating the same question, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.68,
      "end_seconds": 32.38,
      "duration_seconds": 3.7,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.15,
      "end_seconds": 38.06,
      "duration_seconds": 3.91,
      "text": "Wheat. I come out in... well, itchy skin."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.68,
      "end_seconds": 41.48,
      "duration_seconds": 2.8,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.56,
      "end_seconds": 48.04,
      "duration_seconds": 4.48,
      "text": "I have high cholesterol. I've got heart disease."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.45,
      "end_seconds": 56.46,
      "duration_seconds": 7.01,
      "text": "Right, right. Alright, yes, high cholesterol is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.82,
      "end_seconds": 67.36,
      "duration_seconds": 2.54,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.46,
      "end_seconds": 74.15,
      "duration_seconds": 4.69,
      "text": "Just two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.16,
      "end_seconds": 77.56,
      "duration_seconds": 2.4,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.66,
      "end_seconds": 90.95,
      "duration_seconds": 11.29,
      "text": "I'm on rosuvastatin, 10 milligrams, at night for my cholesterol. Metoprolol. I take it twice a day for my heart."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.97,
      "end_seconds": 94.29,
      "duration_seconds": 2.32,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.9,
      "end_seconds": 95.81,
      "duration_seconds": 0.91,
      "text": "50 milligrams."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.71,
      "end_seconds": 100.15,
      "duration_seconds": 2.44,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.14,
      "end_seconds": 105.61,
      "duration_seconds": 3.47,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.36,
      "end_seconds": 109.51,
      "duration_seconds": 2.15,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.52,
      "end_seconds": 114.18,
      "duration_seconds": 3.66,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.76,
      "end_seconds": 118.4,
      "duration_seconds": 2.64,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.69,
      "end_seconds": 122.84,
      "duration_seconds": 3.15,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.57,
      "end_seconds": 126.46,
      "duration_seconds": 1.89,
      "text": "How about bladder problems?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.89,
      "end_seconds": 130.51,
      "duration_seconds": 2.62,
      "text": "No, none, no bladder problems."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.07,
      "end_seconds": 137.31,
      "duration_seconds": 6.24,
      "text": "Right, right. Let me check a few things. Any hallucinations, headache or head injury?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.51,
      "end_seconds": 142.86,
      "duration_seconds": 4.35,
      "text": "No hallucinations, headache or head injury, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.42,
      "end_seconds": 146.98,
      "duration_seconds": 2.56,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.02,
      "end_seconds": 150.13,
      "duration_seconds": 2.11,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.31,
      "end_seconds": 161.09,
      "duration_seconds": 2.78,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.47,
      "end_seconds": 173.33,
      "duration_seconds": 2.86,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.99,
      "end_seconds": 204.64,
      "duration_seconds": 11.65,
      "text": "Okay: BP is 110 over 75, pulse is 81 beats a minute, SpO2 97 percent on room air, respiratory rate 14, temperature 36.7."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.33,
      "end_seconds": 207.68,
      "duration_seconds": 1.35,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.24,
      "end_seconds": 210.72,
      "duration_seconds": 2.48,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.12,
      "end_seconds": 215.37,
      "duration_seconds": 2.25,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.2,
      "end_seconds": 219.26,
      "duration_seconds": 2.06,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.88,
      "end_seconds": 240.16,
      "duration_seconds": 7.28,
      "text": "The memory test score is a little low today and the rest of the neurological check is normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.17,
      "end_seconds": 257.45,
      "duration_seconds": 15.28,
      "text": "That's all I needed to check. Okay, so my impression is this: I think we're dealing with a gradual memory problem that needs further assessment at this stage. We shouldn't forget a vitamin deficiency."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 258.62,
      "end_seconds": 260.94,
      "duration_seconds": 2.32,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.31,
      "end_seconds": 272.88,
      "duration_seconds": 10.57,
      "text": "Nothing I've seen today points to an emergency. It looks like a gradual memory problem that needs further assessment, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.44,
      "end_seconds": 296.36,
      "duration_seconds": 4.92,
      "text": "I think a brain scan makes sense here, for memory loss."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 298.22,
      "end_seconds": 300.74,
      "duration_seconds": 2.52,
      "text": "The earliest is Wednesday, 9 am."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.35,
      "end_seconds": 328.0,
      "duration_seconds": 25.65,
      "text": "I'll request a memory test, it'll help with memory loss. Keep a daily routine and write things down, a notebook by the door works well. I'd like you to see the older adults' assessment service as well, and I'll write the referral. Come back after the results. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.15,
      "end_seconds": 333.2,
      "duration_seconds": 4.05,
      "text": "Actually, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.14,
      "end_seconds": 336.31,
      "duration_seconds": 1.17,
      "text": "Goodbye for now."
    }
  ]
}