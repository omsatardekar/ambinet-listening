      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.86,
      "end_seconds": 317.31,
      "duration_seconds": 10.45,
      "text": "mm okay. Let's review you if the headache gets worse. Tell me what you've taken from all that so I can fill in any gaps"
    },
