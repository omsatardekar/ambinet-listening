{
  "schema_version": "1.0",
  "encounter_id": "01084",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.76,
      "end_seconds": 7.35,
      "duration_seconds": 6.59,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.37,
      "end_seconds": 12.84,
      "duration_seconds": 3.47,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.39,
      "end_seconds": 19.33,
      "duration_seconds": 4.94,
      "text": "Mainly I've been feeling drowsy. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.87,
      "end_seconds": 23.96,
      "duration_seconds": 3.09,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 25.52,
      "end_seconds": 29.56,
      "duration_seconds": 4.04,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.14,
      "end_seconds": 35.06,
      "duration_seconds": 3.92,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.7,
      "end_seconds": 39.47,
      "duration_seconds": 1.77,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.89,
      "end_seconds": 40.59,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 42.08,
      "end_seconds": 55.38,
      "duration_seconds": 13.3,
      "text": "I've also had tiredness, for about a week. I've also had a bit of confusion afterwards. Let me think, about bit of confusion afterwards, mild, I'd say."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.74,
      "end_seconds": 61.29,
      "duration_seconds": 4.55,
      "text": "Have you been feeling drowsy at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 61.98,
      "end_seconds": 67.27,
      "duration_seconds": 5.29,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.29,
      "end_seconds": 72.15,
      "duration_seconds": 2.86,
      "text": "Have you had headache, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.24,
      "end_seconds": 76.16,
      "duration_seconds": 2.92,
      "text": "Not that I've noticed, no headache."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.82,
      "end_seconds": 83.63,
      "duration_seconds": 6.81,
      "text": "And what about loss of bladder control, weakness on one side or head injury?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.42,
      "end_seconds": 88.44,
      "duration_seconds": 4.02,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.1,
      "end_seconds": 93.89,
      "duration_seconds": 3.79,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 98.23,
      "end_seconds": 101.01,
      "duration_seconds": 2.78,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.45,
      "end_seconds": 105.14,
      "duration_seconds": 2.69,
      "text": "Alright, anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.06,
      "end_seconds": 108.41,
      "duration_seconds": 1.35,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.24,
      "end_seconds": 110.51,
      "duration_seconds": 1.27,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 111.62,
      "end_seconds": 114.91,
      "duration_seconds": 3.29,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.28,
      "end_seconds": 117.74,
      "duration_seconds": 1.46,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 118.92,
      "end_seconds": 121.17,
      "duration_seconds": 2.25,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.97,
      "end_seconds": 124.95,
      "duration_seconds": 1.98,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 129.93,
      "end_seconds": 134.3,
      "duration_seconds": 4.37,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.38,
      "end_seconds": 139.3,
      "duration_seconds": 2.92,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.58,
      "end_seconds": 144.2,
      "duration_seconds": 3.62,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.84,
      "end_seconds": 148.66,
      "duration_seconds": 2.82,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.83,
      "end_seconds": 153.14,
      "duration_seconds": 3.31,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.39,
      "end_seconds": 157.47,
      "duration_seconds": 3.08,
      "text": "So, what about your medical history?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.18,
      "end_seconds": 173.39,
      "duration_seconds": 14.21,
      "text": "Um, I have epilepsy. Work has been very busy so I kept ignoring it. I thought it would sort itself out, but it hasn't. Yes, anxiety."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.36,
      "end_seconds": 177.22,
      "duration_seconds": 2.86,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.96,
      "end_seconds": 187.78,
      "duration_seconds": 4.82,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 189.61,
      "end_seconds": 206.52,
      "duration_seconds": 16.91,
      "text": "It's carbamazepine, 200 milligrams, twice a day for the seizures. I'm supposed to take it regularly, but I don't always manage. I'm on escitalopram, 10 milligrams, once a day for the anxiety."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 207.71,
      "end_seconds": 212.95,
      "duration_seconds": 5.24,
      "text": "Doctor, our chart from the last visit lists it as 5 milligrams."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.2,
      "end_seconds": 220.12,
      "duration_seconds": 5.92,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 221.53,
      "end_seconds": 225.82,
      "duration_seconds": 4.29,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.72,
      "end_seconds": 248.0,
      "duration_seconds": 5.28,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 250.03,
      "end_seconds": 252.31,
      "duration_seconds": 2.28,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 257.39,
      "end_seconds": 267.19,
      "duration_seconds": 9.8,
      "text": "Here are the numbers, doctor. Pulse is 84 beats a minute, temperature is 36.6 degrees, respiratory rate 18. Pressure 117 over 78, saturation 98 percent."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.1,
      "end_seconds": 269.02,
      "duration_seconds": 0.92,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.98,
      "end_seconds": 275.06,
      "duration_seconds": 4.08,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.52,
      "end_seconds": 277.87,
      "duration_seconds": 1.35,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.07,
      "end_seconds": 295.02,
      "duration_seconds": 2.95,
      "text": "You're alert and orientated, speech is clear."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.95,
      "end_seconds": 297.73,
      "duration_seconds": 1.78,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.17,
      "end_seconds": 316.54,
      "duration_seconds": 3.37,
      "text": "Reflexes and power are symmetrical on both sides."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.14,
      "end_seconds": 321.79,
      "duration_seconds": 2.65,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 336.35,
      "end_seconds": 352.52,
      "duration_seconds": 16.17,
      "text": "Let me tell you where I've got to. It fits best with breakthrough seizure on known epilepsy. That's my thinking for now, and it may change as we learn more. Another possibility is a provoked seizure from missed medication."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 366.51,
      "end_seconds": 384.62,
      "duration_seconds": 18.11,
      "text": "Let's get an EEG, for seizure. I'll request an MRI of the brain, it'll help with seizure. No driving until we've reviewed you again, I'm sorry, but that's the rule. Let's get you seen by the epilepsy clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 385.56,
      "end_seconds": 388.17,
      "duration_seconds": 2.61,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.04,
      "end_seconds": 397.99,
      "duration_seconds": 8.95,
      "text": "And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 399.81,
      "end_seconds": 401.62,
      "duration_seconds": 1.81,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 403.58,
      "end_seconds": 410.71,
      "duration_seconds": 7.13,
      "text": "I'll want another look after the results are back. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 412.81,
      "end_seconds": 415.63,
      "duration_seconds": 2.82,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.04,
      "end_seconds": 418.48,
      "duration_seconds": 1.44,
      "text": "See you soon."
    }
  ]
}