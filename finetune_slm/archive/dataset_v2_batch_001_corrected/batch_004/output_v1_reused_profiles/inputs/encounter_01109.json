{
  "schema_version": "1.0",
  "encounter_id": "01109",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 2.92,
      "duration_seconds": 1.82,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.86,
      "end_seconds": 9.94,
      "duration_seconds": 5.08,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.17,
      "end_seconds": 22.88,
      "duration_seconds": 11.71,
      "text": "Um, um, so... pain around my cheeks. That's why I came. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.28,
      "end_seconds": 27.23,
      "duration_seconds": 2.95,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.24,
      "end_seconds": 47.6,
      "duration_seconds": 18.36,
      "text": "A three out of ten, I suppose. Okay, so as for blocked nose, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.51,
      "end_seconds": 51.68,
      "duration_seconds": 3.17,
      "text": "Have you noticed stiff neck or double vision?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.75,
      "end_seconds": 60.35,
      "duration_seconds": 6.6,
      "text": "Let me think, you know, no, none of those at all."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.7,
      "end_seconds": 65.2,
      "duration_seconds": 3.5,
      "text": "Have you noticed swelling around the eyes or toothache?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.25,
      "end_seconds": 71.67,
      "duration_seconds": 5.42,
      "text": "Sorry, what was I saying, no, I'd have said so."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.13,
      "end_seconds": 75.63,
      "duration_seconds": 2.5,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.3,
      "end_seconds": 78.39,
      "duration_seconds": 1.09,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.38,
      "end_seconds": 82.78,
      "duration_seconds": 2.4,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.18,
      "end_seconds": 85.76,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.91,
      "end_seconds": 98.86,
      "duration_seconds": 2.95,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.06,
      "end_seconds": 104.08,
      "duration_seconds": 4.02,
      "text": "Just an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.95,
      "end_seconds": 109.89,
      "duration_seconds": 3.94,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.98,
      "end_seconds": 122.19,
      "duration_seconds": 10.21,
      "text": "Let me think, I'm on Asthalin inhaler, when needed. Metoprolol. I take it 50 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.47,
      "end_seconds": 123.43,
      "duration_seconds": 0.96,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.36,
      "end_seconds": 129.26,
      "duration_seconds": 4.9,
      "text": "Saline nasal spray. I take it several times a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.94,
      "end_seconds": 133.64,
      "duration_seconds": 2.7,
      "text": "Okay, what about your medical history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.44,
      "end_seconds": 146.27,
      "duration_seconds": 10.83,
      "text": "Asthma, for about ten years. I mean, you know, I've got heart disease. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.24,
      "end_seconds": 148.53,
      "duration_seconds": 1.29,
      "text": "Is that everything?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.05,
      "end_seconds": 160.82,
      "duration_seconds": 2.77,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.75,
      "end_seconds": 167.11,
      "duration_seconds": 4.36,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.93,
      "end_seconds": 170.74,
      "duration_seconds": 2.81,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.08,
      "end_seconds": 188.69,
      "duration_seconds": 16.61,
      "text": "I'll have a glass of wine with dinner. I have about eight cigarettes in a day. I swim twice a week. I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.97,
      "end_seconds": 193.25,
      "duration_seconds": 3.28,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.02,
      "end_seconds": 205.2,
      "duration_seconds": 2.18,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.89,
      "end_seconds": 231.93,
      "duration_seconds": 11.04,
      "text": "Okay: pressure 116 over 73, respiratory rate 19, weight 87 kilos, pulse 95, temp 38.6 degrees, height 175 centimetres, oxygen saturation is 97 percent."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 236.16,
      "end_seconds": 237.72,
      "duration_seconds": 1.56,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.76,
      "end_seconds": 242.61,
      "duration_seconds": 2.85,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.32,
      "end_seconds": 248.83,
      "duration_seconds": 4.51,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.73,
      "end_seconds": 252.36,
      "duration_seconds": 1.63,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.64,
      "end_seconds": 276.23,
      "duration_seconds": 5.59,
      "text": "There is tenderness over both cheeks and the nose is blocked with swollen lining."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.73,
      "end_seconds": 282.49,
      "duration_seconds": 1.76,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.61,
      "end_seconds": 297.35,
      "duration_seconds": 4.74,
      "text": "Okay, so my impression is this: It points towards acute sinusitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.25,
      "end_seconds": 302.93,
      "duration_seconds": 3.68,
      "text": "Mm, um, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.92,
      "end_seconds": 321.93,
      "duration_seconds": 17.01,
      "text": "I understand the worry. At the moment I'd say it's acute sinusitis, and we'll watch how it goes. We'll begin with fluticasone nasal spray, 50 micrograms, two sprays each side once a day, for two weeks. That should help with sinus congestion."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.58,
      "end_seconds": 328.21,
      "duration_seconds": 1.63,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.68,
      "end_seconds": 348.25,
      "duration_seconds": 18.57,
      "text": "Steam inhalation and saline rinses can help clear the nose. If the eye swells or you get a severe headache, that's the point to come in urgently. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.69,
      "end_seconds": 353.94,
      "duration_seconds": 4.25,
      "text": "Um, good, thanks, I'll see you then."
    }
  ]
}