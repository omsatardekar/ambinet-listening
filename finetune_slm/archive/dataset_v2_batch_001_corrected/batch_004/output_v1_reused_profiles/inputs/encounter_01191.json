{
  "schema_version": "1.0",
  "encounter_id": "01191",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.51,
      "end_seconds": 5.69,
      "duration_seconds": 5.18,
      "text": "Right, thanks for waiting, come in. Did you come far?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.52,
      "end_seconds": 11.91,
      "duration_seconds": 5.39,
      "text": "mm, not too far, about half an hour by bus"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.58,
      "end_seconds": 15.4,
      "duration_seconds": 2.82,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.04,
      "end_seconds": 30.88,
      "duration_seconds": 12.84,
      "text": "Doctor, uh, it's pain in the lower right tummy. It's getting on my nerves now. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.0,
      "end_seconds": 35.02,
      "duration_seconds": 3.02,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.28,
      "end_seconds": 40.11,
      "duration_seconds": 3.83,
      "text": "It's been going on for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.62,
      "end_seconds": 43.69,
      "duration_seconds": 3.07,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.51,
      "end_seconds": 48.88,
      "duration_seconds": 4.37,
      "text": "Um, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 49.44,
      "end_seconds": 51.5,
      "duration_seconds": 2.06,
      "text": "what aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.55,
      "end_seconds": 57.37,
      "duration_seconds": 3.82,
      "text": "I notice it more with moving and coughing"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.25,
      "end_seconds": 61.03,
      "duration_seconds": 2.78,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.91,
      "end_seconds": 77.93,
      "duration_seconds": 12.02,
      "text": "Actually, when it starts I tend to get a low fever as well. The low fever? That's been for one week."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.38,
      "end_seconds": 89.01,
      "duration_seconds": 5.63,
      "text": "and what about burning when passing urine, diarrhoea or blood in the stool?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.46,
      "end_seconds": 100.18,
      "duration_seconds": 8.72,
      "text": "I mean, no burning when passing urine, diarrhoea or blood in the stool, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.78,
      "end_seconds": 105.3,
      "duration_seconds": 3.52,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.13,
      "end_seconds": 108.61,
      "duration_seconds": 1.48,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.93,
      "end_seconds": 113.98,
      "duration_seconds": 2.05,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.23,
      "end_seconds": 119.58,
      "duration_seconds": 4.35,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.3,
      "end_seconds": 124.07,
      "duration_seconds": 2.77,
      "text": "do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 125.23,
      "end_seconds": 128.38,
      "duration_seconds": 3.15,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.21,
      "end_seconds": 144.8,
      "duration_seconds": 2.59,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 145.84,
      "end_seconds": 147.89,
      "duration_seconds": 2.05,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.15,
      "end_seconds": 152.42,
      "duration_seconds": 3.27,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.83,
      "end_seconds": 155.78,
      "duration_seconds": 1.95,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.13,
      "end_seconds": 175.47,
      "duration_seconds": 2.34,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.82,
      "end_seconds": 178.04,
      "duration_seconds": 1.22,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.29,
      "end_seconds": 194.69,
      "duration_seconds": 4.4,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.48,
      "end_seconds": 209.11,
      "duration_seconds": 2.63,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.65,
      "end_seconds": 237.14,
      "duration_seconds": 7.49,
      "text": "okay: respiratory rate 22, pulse 93, pressure 124 over 80. And temperature is 39.2 degrees"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.63,
      "end_seconds": 240.16,
      "duration_seconds": 1.53,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.18,
      "end_seconds": 245.43,
      "duration_seconds": 3.25,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.69,
      "end_seconds": 252.56,
      "duration_seconds": 4.87,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.74,
      "end_seconds": 255.97,
      "duration_seconds": 2.23,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 271.76,
      "duration_seconds": 6.96,
      "text": "There's tenderness in the right lower part and it it hurts when I let go suddenly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 274.54,
      "end_seconds": 276.24,
      "duration_seconds": 1.7,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.2,
      "end_seconds": 303.0,
      "duration_seconds": 8.8,
      "text": "Right, here's what I'm thinking. It points towards possible appendicitis. A urine test is what I'd like next, for abdominal pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.64,
      "end_seconds": 308.65,
      "duration_seconds": 4.01,
      "text": "I can book that for Thursday at 11:30 am."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 310.17,
      "end_seconds": 311.08,
      "duration_seconds": 0.91,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.8,
      "end_seconds": 318.5,
      "duration_seconds": 5.7,
      "text": "please don't eat or drink anything until the surgeons have seen you"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.09,
      "end_seconds": 324.97,
      "duration_seconds": 5.88,
      "text": "Yes. Right, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 331.0,
      "end_seconds": 334.15,
      "duration_seconds": 3.15,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.72,
      "end_seconds": 337.17,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}