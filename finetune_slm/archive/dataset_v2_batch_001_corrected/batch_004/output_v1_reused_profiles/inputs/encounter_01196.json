{
  "schema_version": "1.0",
  "encounter_id": "01196",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.43,
      "duration_seconds": 3.21,
      "text": "sorry I'm a little late, doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.9,
      "end_seconds": 14.53,
      "duration_seconds": 4.63,
      "text": "so, that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.14,
      "end_seconds": 22.3,
      "duration_seconds": 6.16,
      "text": "So, I've been feeling lightheaded, doctor. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.63,
      "end_seconds": 24.83,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.56,
      "end_seconds": 29.53,
      "duration_seconds": 3.97,
      "text": "Ah, it's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 41.06,
      "duration_seconds": 9.53,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.01,
      "end_seconds": 50.93,
      "duration_seconds": 8.92,
      "text": "Sorry, what was I saying, mostly moderate. Yes, standing up. That makes it worse. I'd say on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.93,
      "end_seconds": 55.97,
      "duration_seconds": 3.04,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.83,
      "end_seconds": 62.21,
      "duration_seconds": 4.38,
      "text": "Um, it usually comes with nearly passing out."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.22,
      "end_seconds": 68.76,
      "duration_seconds": 4.54,
      "text": "what about a pounding in the head, have you noticed that?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.34,
      "end_seconds": 76.36,
      "duration_seconds": 7.02,
      "text": "Yeah, that too. Uh, the nearly passing out? That's been since yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.22,
      "end_seconds": 83.05,
      "duration_seconds": 4.83,
      "text": "Have you been feeling lightheaded at any time before this?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.51,
      "end_seconds": 94.9,
      "duration_seconds": 10.39,
      "text": "uh, yes, something like this happened a couple of years ago, and it it went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.61,
      "end_seconds": 114.65,
      "duration_seconds": 3.04,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.47,
      "end_seconds": 126.8,
      "duration_seconds": 2.33,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.24,
      "end_seconds": 153.36,
      "duration_seconds": 9.12,
      "text": "okay: pulse is 112 beats a minute, BP is 100 over 65, saturation 98 percent, temp 36.6 degrees"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.15,
      "end_seconds": 155.74,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.46,
      "end_seconds": 158.9,
      "duration_seconds": 2.44,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.55,
      "end_seconds": 163.79,
      "duration_seconds": 2.24,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.19,
      "end_seconds": 167.5,
      "duration_seconds": 2.31,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.05,
      "end_seconds": 183.55,
      "duration_seconds": 4.5,
      "text": "Your blood pressure drops when you stand, I'll note that."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.25,
      "end_seconds": 187.27,
      "duration_seconds": 2.02,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.05,
      "end_seconds": 196.99,
      "duration_seconds": 1.94,
      "text": "heart rhythm is regular"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.9,
      "end_seconds": 208.69,
      "duration_seconds": 5.79,
      "text": "Thank you, you can get dressed. A few quick ones: chest pain or vomiting?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.87,
      "end_seconds": 212.66,
      "duration_seconds": 2.79,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.65,
      "end_seconds": 220.5,
      "duration_seconds": 2.85,
      "text": "Any palpitations, slurred speech or fainting completely?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.92,
      "end_seconds": 227.31,
      "duration_seconds": 5.39,
      "text": "I haven't had palpitations, slurred speech or fainting completely, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.37,
      "end_seconds": 233.15,
      "duration_seconds": 3.78,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 233.98,
      "end_seconds": 237.31,
      "duration_seconds": 3.33,
      "text": "No, uh, that's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.31,
      "end_seconds": 241.99,
      "duration_seconds": 2.68,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.51,
      "end_seconds": 244.87,
      "duration_seconds": 2.36,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.92,
      "end_seconds": 250.6,
      "duration_seconds": 3.68,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.16,
      "end_seconds": 254.53,
      "duration_seconds": 3.37,
      "text": "I've had diabetes for two years now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 271.76,
      "duration_seconds": 3.04,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.9,
      "end_seconds": 278.87,
      "duration_seconds": 5.97,
      "text": "Just my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.81,
      "end_seconds": 293.38,
      "duration_seconds": 4.57,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.22,
      "end_seconds": 300.77,
      "duration_seconds": 5.55,
      "text": "Amoxicillin. I come out in... well, a rash all over."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.52,
      "end_seconds": 302.85,
      "duration_seconds": 1.33,
      "text": "do you smoke?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.93,
      "end_seconds": 307.35,
      "duration_seconds": 3.42,
      "text": "I quit smoking around ten years ago"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.89,
      "end_seconds": 310.24,
      "duration_seconds": 1.35,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.88,
      "end_seconds": 316.94,
      "duration_seconds": 5.06,
      "text": "I used to drink heavily but I stopped four years ago"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.68,
      "end_seconds": 321.94,
      "duration_seconds": 1.26,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.45,
      "end_seconds": 327.94,
      "duration_seconds": 4.49,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 331.18,
      "end_seconds": 333.03,
      "duration_seconds": 1.85,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.77,
      "end_seconds": 337.09,
      "duration_seconds": 3.32,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.68,
      "end_seconds": 340.83,
      "duration_seconds": 3.15,
      "text": "Alright, do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.58,
      "end_seconds": 344.76,
      "duration_seconds": 3.18,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.46,
      "end_seconds": 351.37,
      "duration_seconds": 4.91,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.23,
      "end_seconds": 358.9,
      "duration_seconds": 6.67,
      "text": "I, I take sitagliptin, 100 milligrams, maybe, once a day for my sugar."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.52,
      "end_seconds": 363.97,
      "duration_seconds": 4.45,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.81,
      "end_seconds": 369.49,
      "duration_seconds": 3.68,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.5,
      "end_seconds": 376.32,
      "duration_seconds": 4.82,
      "text": "Having listened and examined, I'd lean towards postural low blood pressure."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.37,
      "end_seconds": 380.28,
      "duration_seconds": 1.91,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.38,
      "end_seconds": 413.77,
      "duration_seconds": 31.39,
      "text": "I can't promise yet, but most people with postural low blood pressure do well once it's treated properly. I'd like to arrange a blood sugar test for dizziness. Get up in stages, sit on the edge of the bed for a minute first, and keep drinking water. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.07,
      "end_seconds": 419.88,
      "duration_seconds": 4.81,
      "text": "right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 421.42,
      "end_seconds": 423.48,
      "duration_seconds": 2.06,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.15,
      "end_seconds": 426.58,
      "duration_seconds": 1.43,
      "text": "take care now"
    }
  ]
}