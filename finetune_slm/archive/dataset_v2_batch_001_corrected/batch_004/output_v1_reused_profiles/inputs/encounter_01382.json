{
  "schema_version": "1.0",
  "encounter_id": "01382",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 6.28,
      "duration_seconds": 5.21,
      "text": "Good evening, uh, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.6,
      "end_seconds": 12.01,
      "duration_seconds": 4.41,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.63,
      "end_seconds": 18.4,
      "duration_seconds": 5.77,
      "text": "Doctor, it's an itch down below. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.27,
      "end_seconds": 23.62,
      "duration_seconds": 3.35,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.23,
      "end_seconds": 30.92,
      "duration_seconds": 5.69,
      "text": "Around four weeks... no wait, it's more like one week."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.26,
      "end_seconds": 46.41,
      "duration_seconds": 14.15,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.63,
      "end_seconds": 58.41,
      "duration_seconds": 5.78,
      "text": "I get some relief from a cool compress. Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.97,
      "end_seconds": 61.22,
      "duration_seconds": 2.25,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.94,
      "end_seconds": 69.74,
      "duration_seconds": 6.8,
      "text": "Soreness goes along with it, most of the time. With soreness, I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.5,
      "end_seconds": 74.36,
      "duration_seconds": 2.86,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.61,
      "end_seconds": 79.24,
      "duration_seconds": 3.63,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.6,
      "end_seconds": 83.09,
      "duration_seconds": 2.49,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.07,
      "end_seconds": 93.0,
      "duration_seconds": 3.93,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.22,
      "end_seconds": 95.54,
      "duration_seconds": 1.32,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.16,
      "end_seconds": 100.16,
      "duration_seconds": 3.0,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.0,
      "end_seconds": 108.26,
      "duration_seconds": 3.26,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.43,
      "end_seconds": 112.78,
      "duration_seconds": 3.35,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.45,
      "end_seconds": 117.91,
      "duration_seconds": 3.46,
      "text": "Alright, does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.45,
      "end_seconds": 121.53,
      "duration_seconds": 2.08,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.2,
      "end_seconds": 132.29,
      "duration_seconds": 2.09,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.97,
      "end_seconds": 136.47,
      "duration_seconds": 2.5,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.15,
      "end_seconds": 156.97,
      "duration_seconds": 2.82,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.79,
      "end_seconds": 161.15,
      "duration_seconds": 3.36,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.93,
      "end_seconds": 167.94,
      "duration_seconds": 5.01,
      "text": "A few quick ones: smell, being pregnant, bleeding between periods or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.0,
      "end_seconds": 171.82,
      "duration_seconds": 2.82,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.13,
      "end_seconds": 175.43,
      "duration_seconds": 2.3,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.6,
      "end_seconds": 184.23,
      "duration_seconds": 2.63,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.85,
      "end_seconds": 189.23,
      "duration_seconds": 3.38,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.96,
      "end_seconds": 193.07,
      "duration_seconds": 2.11,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.39,
      "end_seconds": 207.39,
      "duration_seconds": 6.0,
      "text": "There is a thick white discharge with redness of the vulva and no ulcers."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.55,
      "end_seconds": 212.15,
      "duration_seconds": 2.6,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.57,
      "end_seconds": 234.52,
      "duration_seconds": 3.95,
      "text": "Putting it all together, it points towards vaginal thrush."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.77,
      "end_seconds": 237.94,
      "duration_seconds": 2.17,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.69,
      "end_seconds": 246.41,
      "duration_seconds": 7.72,
      "text": "I can't promise yet, but most people with vaginal thrush do well once it's treated properly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.3,
      "end_seconds": 265.69,
      "duration_seconds": 6.39,
      "text": "Let's book a swab to look into vaginal discharge. Let's get a urine test, for dysuria."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.82,
      "end_seconds": 268.71,
      "duration_seconds": 1.89,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.84,
      "end_seconds": 291.51,
      "duration_seconds": 21.67,
      "text": "You'll be taking fluconazole, 150 milligrams, once, for one day. It's for thrush. Wear cotton underwear and avoid scented soaps or washes. I'll want another look if it isn't better in a week. Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.83,
      "end_seconds": 306.7,
      "duration_seconds": 10.87,
      "text": "So, I take the fluconazole, 150 milligrams, once and come back if it isn't better in a week. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.46,
      "end_seconds": 313.37,
      "duration_seconds": 4.91,
      "text": "Yes, exactly right. Okay, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.43,
      "end_seconds": 319.4,
      "duration_seconds": 3.97,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}