{
  "schema_version": "1.0",
  "encounter_id": "01198",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 4.79,
      "duration_seconds": 3.86,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.59,
      "end_seconds": 11.55,
      "duration_seconds": 4.96,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.62,
      "end_seconds": 17.2,
      "duration_seconds": 4.58,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.22,
      "end_seconds": 28.0,
      "duration_seconds": 9.78,
      "text": "Doctor, it's blurry vision. It's getting on my nerves now. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.72,
      "end_seconds": 31.96,
      "duration_seconds": 3.24,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.83,
      "end_seconds": 35.5,
      "duration_seconds": 2.67,
      "text": "About... well, about three months."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.78,
      "end_seconds": 39.86,
      "duration_seconds": 3.08,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.98,
      "end_seconds": 45.71,
      "duration_seconds": 4.73,
      "text": "Uh, I'd give it a five, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.68,
      "end_seconds": 49.15,
      "duration_seconds": 2.47,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.93,
      "end_seconds": 56.61,
      "duration_seconds": 5.68,
      "text": "It usually comes with tiredness. The tiredness? That's been for three weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.78,
      "end_seconds": 60.7,
      "duration_seconds": 2.92,
      "text": "Have you been feeling very thirsty?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.62,
      "end_seconds": 66.26,
      "duration_seconds": 3.64,
      "text": "Yes, about the same, six months."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.72,
      "end_seconds": 82.01,
      "duration_seconds": 4.29,
      "text": "Right, have you noticed chest pain, fever or vomiting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.83,
      "end_seconds": 87.49,
      "duration_seconds": 4.66,
      "text": "No chest pain, fever or vomiting, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.99,
      "end_seconds": 93.32,
      "duration_seconds": 4.33,
      "text": "A few quick ones: foot sores or abdominal pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.26,
      "end_seconds": 97.18,
      "duration_seconds": 2.92,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.61,
      "end_seconds": 104.43,
      "duration_seconds": 2.82,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.83,
      "end_seconds": 108.53,
      "duration_seconds": 2.7,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.12,
      "end_seconds": 114.76,
      "duration_seconds": 4.64,
      "text": "Right, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.2,
      "end_seconds": 118.08,
      "duration_seconds": 1.88,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.05,
      "end_seconds": 122.77,
      "duration_seconds": 2.72,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.55,
      "end_seconds": 127.53,
      "duration_seconds": 3.98,
      "text": "Just a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.4,
      "end_seconds": 146.53,
      "duration_seconds": 5.13,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.67,
      "end_seconds": 150.99,
      "duration_seconds": 3.32,
      "text": "Yes, amoxicillin, it gives me hives."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.07,
      "end_seconds": 158.04,
      "duration_seconds": 5.97,
      "text": "Do you have any long-term conditions? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.86,
      "end_seconds": 162.37,
      "duration_seconds": 3.51,
      "text": "I've had diabetes for five years now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 166.7,
      "duration_seconds": 2.58,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 169.61,
      "end_seconds": 173.44,
      "duration_seconds": 3.83,
      "text": "She takes sitagliptin, 100 milligrams, once a day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.28,
      "end_seconds": 178.52,
      "duration_seconds": 3.24,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 180.4,
      "end_seconds": 182.29,
      "duration_seconds": 1.89,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.55,
      "end_seconds": 183.25,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.13,
      "end_seconds": 198.41,
      "duration_seconds": 3.28,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.7,
      "end_seconds": 202.51,
      "duration_seconds": 2.81,
      "text": "Mm, my uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.73,
      "end_seconds": 206.08,
      "duration_seconds": 2.35,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.16,
      "end_seconds": 220.09,
      "duration_seconds": 12.93,
      "text": "I only drink at family occasions. I grab fast food at lunch most days. I live with my elderly mother. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.19,
      "end_seconds": 228.42,
      "duration_seconds": 3.23,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.55,
      "end_seconds": 238.19,
      "duration_seconds": 2.64,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.85,
      "end_seconds": 266.53,
      "duration_seconds": 15.68,
      "text": "Okay: temperature 36.6, BP is 167 over 93. And heart rate 74, SpO2 96 percent on room air. Let me tell you where I've got to. It points towards diabetes that isn't well controlled."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.4,
      "end_seconds": 269.55,
      "duration_seconds": 2.15,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.39,
      "end_seconds": 289.72,
      "duration_seconds": 18.33,
      "text": "I can't promise yet, but most people with diabetes that isn't well controlled do well once it's treated properly. I'm going to order a urine protein test, for diabetes. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 294.05,
      "end_seconds": 296.35,
      "duration_seconds": 2.3,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.01,
      "end_seconds": 310.51,
      "duration_seconds": 12.5,
      "text": "Let's book an HbA1c to look into diabetes control. What I'm giving you is glimepiride, 1 milligrams, before breakfast, until we review. That's for blood sugar control."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.02,
      "end_seconds": 315.31,
      "duration_seconds": 4.29,
      "text": "Ah, is that safe with my other medicines?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.05,
      "end_seconds": 337.97,
      "duration_seconds": 20.92,
      "text": "Check your feet every day, and never walk barefoot. I'm going to send a referral to a dietitian. Please don't wait if you vomit repeatedly or become drowsy. That's when to be seen urgently. I'd like to see you again after the results are back. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.28,
      "end_seconds": 341.6,
      "duration_seconds": 2.32,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.55,
      "end_seconds": 343.92,
      "duration_seconds": 1.37,
      "text": "Look after yourself."
    }
  ]
}