{
  "schema_version": "1.0",
  "encounter_id": "01151",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 6.18,
      "duration_seconds": 5.12,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.74,
      "end_seconds": 13.73,
      "duration_seconds": 3.99,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.52,
      "end_seconds": 21.17,
      "duration_seconds": 5.65,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.89,
      "end_seconds": 28.2,
      "duration_seconds": 3.31,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.24,
      "end_seconds": 35.88,
      "duration_seconds": 6.64,
      "text": "Doctor, it's a cut on my finger. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.73,
      "end_seconds": 39.84,
      "duration_seconds": 3.11,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.82,
      "end_seconds": 44.12,
      "duration_seconds": 3.3,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.84,
      "end_seconds": 48.53,
      "duration_seconds": 3.69,
      "text": "What do you do to make it better?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.44,
      "end_seconds": 53.29,
      "duration_seconds": 2.85,
      "text": "It settles a little with pressure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.66,
      "end_seconds": 56.72,
      "duration_seconds": 2.06,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.54,
      "end_seconds": 71.25,
      "duration_seconds": 12.71,
      "text": "Bleeding goes along with it, most of the time. The bleeding? That's been since Monday. I mean, with bleeding, pressure helps a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.09,
      "end_seconds": 77.4,
      "duration_seconds": 5.31,
      "text": "A few quick ones: redness spreading, fever or weakness of the hand?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.93,
      "end_seconds": 84.54,
      "duration_seconds": 6.61,
      "text": "No redness spreading, fever or weakness of the hand, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.31,
      "end_seconds": 88.17,
      "duration_seconds": 2.86,
      "text": "Any dirt in the wound or bite?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.65,
      "end_seconds": 94.53,
      "duration_seconds": 4.88,
      "text": "I haven't had dirt in the wound or bite, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.6,
      "end_seconds": 98.68,
      "duration_seconds": 3.08,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.45,
      "end_seconds": 103.23,
      "duration_seconds": 1.78,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.75,
      "end_seconds": 107.48,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 109.56,
      "end_seconds": 125.04,
      "duration_seconds": 15.48,
      "text": "She takes paracetamol, 650 milligrams, when needed for the knee pain. She is on lisinopril, 10 milligrams, once a day for my pressure, I give it to her."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.53,
      "end_seconds": 129.71,
      "duration_seconds": 3.18,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.53,
      "end_seconds": 134.18,
      "duration_seconds": 3.65,
      "text": "I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.51,
      "end_seconds": 139.33,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.26,
      "end_seconds": 145.31,
      "duration_seconds": 5.05,
      "text": "I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.48,
      "end_seconds": 158.7,
      "duration_seconds": 12.22,
      "text": "Sure. Yes, arthritis in your knees is known to us, good to have that clear. Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 164.39,
      "duration_seconds": 3.99,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.3,
      "end_seconds": 178.3,
      "duration_seconds": 3.0,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.54,
      "end_seconds": 181.72,
      "duration_seconds": 2.18,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.36,
      "end_seconds": 184.97,
      "duration_seconds": 2.61,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.22,
      "end_seconds": 192.02,
      "duration_seconds": 5.8,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.01,
      "end_seconds": 200.35,
      "duration_seconds": 4.34,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.34,
      "end_seconds": 206.15,
      "duration_seconds": 3.81,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.01,
      "end_seconds": 208.95,
      "duration_seconds": 1.94,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.77,
      "end_seconds": 212.39,
      "duration_seconds": 2.62,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.42,
      "end_seconds": 217.42,
      "duration_seconds": 3.0,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.97,
      "end_seconds": 222.9,
      "duration_seconds": 3.93,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.52,
      "end_seconds": 238.94,
      "duration_seconds": 3.42,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 249.11,
      "duration_seconds": 2.95,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.5,
      "end_seconds": 279.6,
      "duration_seconds": 12.1,
      "text": "Okay: pulse is 74 beats a minute, blood pressure 128 over 71, oxygen saturation is 99 percent, temp 36.7 degrees, respiratory rate 18."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.01,
      "end_seconds": 283.5,
      "duration_seconds": 2.49,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.44,
      "end_seconds": 288.35,
      "duration_seconds": 2.91,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.38,
      "end_seconds": 308.8,
      "duration_seconds": 8.42,
      "text": "There is a two-centimetre clean cut over the first knuckle, the finger moves fully and the fingertip feels normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 314.12,
      "end_seconds": 316.24,
      "duration_seconds": 2.12,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.06,
      "end_seconds": 343.75,
      "duration_seconds": 13.69,
      "text": "Right, here's what I'm thinking. I don't have a clear answer today: a clean finger laceration without nerve or tendon injury is possible, and so is an infected wound."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.71,
      "end_seconds": 348.06,
      "duration_seconds": 3.35,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.67,
      "end_seconds": 378.37,
      "duration_seconds": 29.7,
      "text": "Nothing I've seen today points to an emergency. It looks like a clean finger laceration without nerve or tendon injury, but I'd like to confirm. I'm going to order an X-ray of the finger, for laceration. The result will help us decide whether anything more is needed. You'll be taking tetanus booster, 0.5 ml, once, for one day. That should help with tetanus prevention."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.13,
      "end_seconds": 383.61,
      "duration_seconds": 1.48,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.24,
      "end_seconds": 390.45,
      "duration_seconds": 6.21,
      "text": "Keep the dressing dry for two days and watch for redness or pus."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 390.96,
      "end_seconds": 396.02,
      "duration_seconds": 5.06,
      "text": "Understood. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.59,
      "end_seconds": 399.69,
      "duration_seconds": 2.1,
      "text": "Alright, thanks, take care."
    }
  ]
}