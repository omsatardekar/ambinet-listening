{
  "schema_version": "1.0",
  "encounter_id": "01093",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.13,
      "end_seconds": 8.22,
      "duration_seconds": 7.09,
      "text": "Hi, um, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.62,
      "end_seconds": 15.91,
      "duration_seconds": 4.29,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.26,
      "end_seconds": 20.76,
      "duration_seconds": 3.5,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 22.05,
      "end_seconds": 31.01,
      "duration_seconds": 8.96,
      "text": "it's pain in my left wrist after a fall, doctor she didn't want to come, but I insisted"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.01,
      "end_seconds": 34.84,
      "duration_seconds": 2.83,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.47,
      "end_seconds": 39.0,
      "duration_seconds": 3.53,
      "text": "For about four days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.28,
      "end_seconds": 43.21,
      "duration_seconds": 2.93,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.26,
      "end_seconds": 54.16,
      "duration_seconds": 6.9,
      "text": "Mm, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.71,
      "end_seconds": 56.32,
      "duration_seconds": 1.61,
      "text": "anything that improves it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.25,
      "end_seconds": 63.07,
      "duration_seconds": 5.82,
      "text": "Actually, uh, it settles a little with holding it still."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.97,
      "end_seconds": 66.01,
      "duration_seconds": 2.04,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.73,
      "end_seconds": 70.44,
      "duration_seconds": 3.71,
      "text": "it's, It's once or twice a day"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.77,
      "end_seconds": 73.94,
      "duration_seconds": 2.17,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.22,
      "end_seconds": 78.3,
      "duration_seconds": 3.08,
      "text": "it usually comes with swelling"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.07,
      "end_seconds": 88.13,
      "duration_seconds": 9.06,
      "text": "mm, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 88.23,
      "end_seconds": 95.02,
      "duration_seconds": 6.79,
      "text": "So, tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.02,
      "end_seconds": 114.49,
      "duration_seconds": 18.47,
      "text": "Hmm, I was getting to that! Sorry, what was I saying, the swelling? That's been for five days. Actually, uh, as for swelling, I'd call it moderate. And tingling in the fingers, too."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.23,
      "end_seconds": 119.86,
      "duration_seconds": 3.63,
      "text": "so, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.72,
      "end_seconds": 122.86,
      "duration_seconds": 2.14,
      "text": "I'd call it severe."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.73,
      "end_seconds": 143.72,
      "duration_seconds": 5.99,
      "text": "Any pain in the shoulder, numbness or loss of consciousness at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.27,
      "end_seconds": 160.28,
      "duration_seconds": 15.01,
      "text": "mm, no, no pain in the shoulder, no numbness, no loss of consciousness. I did have a weak grip at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.55,
      "end_seconds": 169.32,
      "duration_seconds": 7.77,
      "text": "let me check a few things any bump to the head, deformity or pain in the elbow?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.11,
      "end_seconds": 173.43,
      "duration_seconds": 3.32,
      "text": "Erm, nope, nothing like that."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.99,
      "end_seconds": 176.46,
      "duration_seconds": 2.47,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.22,
      "end_seconds": 180.2,
      "duration_seconds": 1.98,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.81,
      "end_seconds": 198.29,
      "duration_seconds": 4.48,
      "text": "Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.07,
      "end_seconds": 213.81,
      "duration_seconds": 14.74,
      "text": "Hmm, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it it was called or what it did."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.2,
      "end_seconds": 218.38,
      "duration_seconds": 3.18,
      "text": "Alright, have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.34,
      "end_seconds": 229.36,
      "duration_seconds": 9.02,
      "text": "Yes, uh, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.05,
      "end_seconds": 233.11,
      "duration_seconds": 3.06,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 234.92,
      "end_seconds": 237.51,
      "duration_seconds": 2.59,
      "text": "Right, my grandmother had dementia."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.2,
      "end_seconds": 240.46,
      "duration_seconds": 2.26,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 241.56,
      "end_seconds": 246.31,
      "duration_seconds": 4.75,
      "text": "mm, I take Tiotropium inhaler, once a day"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.07,
      "end_seconds": 252.54,
      "duration_seconds": 1.47,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.42,
      "end_seconds": 261.59,
      "duration_seconds": 8.17,
      "text": "about about a year. Carbamazepine i take it 200 milligrams, twice a day for the seizures"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 262.87,
      "end_seconds": 273.74,
      "duration_seconds": 10.87,
      "text": "Well, doctor, I think the last prescription for the carbamazepine was 100 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.2,
      "end_seconds": 278.11,
      "duration_seconds": 2.91,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.71,
      "end_seconds": 284.81,
      "duration_seconds": 6.1,
      "text": "I mean, not with me. I'll bring it it next time."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.37,
      "end_seconds": 294.08,
      "duration_seconds": 7.71,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.6,
      "end_seconds": 298.81,
      "duration_seconds": 3.21,
      "text": "okay, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.63,
      "end_seconds": 318.29,
      "duration_seconds": 17.66,
      "text": "So, um, for the joint pain, I believe. My wife sets them out for me, I just take what I'm given. I take paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.96,
      "end_seconds": 321.9,
      "duration_seconds": 2.94,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.54,
      "end_seconds": 335.78,
      "duration_seconds": 13.24,
      "text": "I smoke roughly a pack every two days. I'll have a glass of wine with dinner. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.77,
      "end_seconds": 340.35,
      "duration_seconds": 2.58,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.75,
      "end_seconds": 360.95,
      "duration_seconds": 19.2,
      "text": "I have thin bones. I've, I've had COPD for about a year now. Mm, I've had epilepsy, yes. Yeah, I have arthritis in my knees, for nearly five years. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.87,
      "end_seconds": 368.85,
      "duration_seconds": 6.98,
      "text": "Ah. Yes, thin bones and epilepsy are known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 369.49,
      "end_seconds": 380.03,
      "duration_seconds": 10.54,
      "text": "Okay, so the vitals from earlier. Pressure 108 over 72, respiratory rate 18, temperature is 37.0 degrees, saturation 98 percent, pulse is 74 beats a minute."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.94,
      "end_seconds": 381.86,
      "duration_seconds": 0.92,
      "text": "okay, noted"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 384.5,
      "end_seconds": 388.97,
      "duration_seconds": 4.47,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.99,
      "end_seconds": 392.12,
      "duration_seconds": 1.13,
      "text": "of course"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.96,
      "end_seconds": 395.72,
      "duration_seconds": 2.76,
      "text": "okay, I'm just checking this side"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.29,
      "end_seconds": 411.9,
      "duration_seconds": 6.61,
      "text": "There's swelling and tenderness at the base of the thumb side of the wrist."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 413.71,
      "end_seconds": 416.81,
      "duration_seconds": 3.1,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 425.37,
      "end_seconds": 429.81,
      "duration_seconds": 4.44,
      "text": "Fingers have good colour and the pulses are fine."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 434.61,
      "end_seconds": 470.82,
      "duration_seconds": 36.21,
      "text": "You can relax now. So, based on the history and the examination, I'd lean towards a wrist sprain, but a small fracture is possible. I can't rule out a distal radius fracture yet. I think an X-ray of the wrist makes sense here, for wrist injury. I'd rather check than guess, and this is the quickest way to know more. I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 472.75,
      "end_seconds": 482.05,
      "duration_seconds": 9.3,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 483.86,
      "end_seconds": 485.56,
      "duration_seconds": 1.7,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 487.57,
      "end_seconds": 501.52,
      "duration_seconds": 13.95,
      "text": "If the symptoms get worse, or you feel really unwell, please come to the emergency department. Book a review after the X-ray. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 503.6,
      "end_seconds": 506.79,
      "duration_seconds": 3.19,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 507.79,
      "end_seconds": 509.03,
      "duration_seconds": 1.24,
      "text": "All the best."
    }
  ]
}