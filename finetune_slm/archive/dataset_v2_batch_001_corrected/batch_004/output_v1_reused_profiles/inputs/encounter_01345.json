{
  "schema_version": "1.0",
  "encounter_id": "01345",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 5.59,
      "duration_seconds": 4.28,
      "text": "Yeah, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.5,
      "end_seconds": 11.92,
      "duration_seconds": 4.42,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.36,
      "end_seconds": 17.6,
      "duration_seconds": 4.24,
      "text": "I've been dealing with aching in my thighs."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.69,
      "end_seconds": 21.06,
      "duration_seconds": 1.37,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.01,
      "end_seconds": 31.75,
      "duration_seconds": 9.74,
      "text": "About... well, one week. I just want to get back to normal, really. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.32,
      "end_seconds": 41.0,
      "duration_seconds": 8.68,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.67,
      "end_seconds": 50.21,
      "duration_seconds": 8.54,
      "text": "I notice it more with climbing stairs. Moderate, really. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.28,
      "end_seconds": 70.59,
      "duration_seconds": 6.31,
      "text": "Let me check a few things. Any recent heavy exercise, trouble swallowing or numbness?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.08,
      "end_seconds": 76.06,
      "duration_seconds": 3.98,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.82,
      "end_seconds": 80.36,
      "duration_seconds": 3.54,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.12,
      "end_seconds": 86.89,
      "duration_seconds": 4.77,
      "text": "Sorry, what was I saying, no, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.81,
      "end_seconds": 92.87,
      "duration_seconds": 4.06,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.24,
      "end_seconds": 96.55,
      "duration_seconds": 2.31,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.46,
      "end_seconds": 107.18,
      "duration_seconds": 2.72,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 108.67,
      "end_seconds": 112.49,
      "duration_seconds": 3.82,
      "text": "No, you know, I'm not on anything."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.87,
      "end_seconds": 120.6,
      "duration_seconds": 3.73,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.26,
      "end_seconds": 125.49,
      "duration_seconds": 4.23,
      "text": "I don't think I have any, um, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.97,
      "end_seconds": 130.38,
      "duration_seconds": 3.41,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.55,
      "end_seconds": 137.88,
      "duration_seconds": 3.33,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.67,
      "end_seconds": 140.9,
      "duration_seconds": 1.23,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.26,
      "end_seconds": 145.49,
      "duration_seconds": 3.23,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.91,
      "end_seconds": 149.71,
      "duration_seconds": 2.8,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.3,
      "end_seconds": 153.09,
      "duration_seconds": 1.79,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.97,
      "end_seconds": 172.28,
      "duration_seconds": 1.31,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.47,
      "end_seconds": 175.45,
      "duration_seconds": 1.98,
      "text": "No, uh, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.03,
      "end_seconds": 179.45,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.97,
      "end_seconds": 196.02,
      "duration_seconds": 3.05,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.94,
      "end_seconds": 218.53,
      "duration_seconds": 8.59,
      "text": "Okay: temperature is 36.8 degrees, blood pressure 123 over 77. And pulse is 77 beats a minute, respiratory rate 14."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.57,
      "end_seconds": 222.54,
      "duration_seconds": 1.97,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.45,
      "end_seconds": 226.58,
      "duration_seconds": 2.13,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.95,
      "end_seconds": 243.13,
      "duration_seconds": 3.18,
      "text": "The muscles are mildly tender when I squeeze."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.11,
      "end_seconds": 256.2,
      "duration_seconds": 10.09,
      "text": "That's the examination finished. So, based on the history and the examination, it points towards muscle symptoms that may be related to the cholesterol tablet."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.43,
      "end_seconds": 259.46,
      "duration_seconds": 2.03,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.76,
      "end_seconds": 270.87,
      "duration_seconds": 10.11,
      "text": "It's reasonable to be concerned, but right now muscle symptoms that may be related to the cholesterol tablet is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.81,
      "end_seconds": 294.61,
      "duration_seconds": 5.8,
      "text": "A vitamin D level is what I'd like next, for muscle weakness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.49,
      "end_seconds": 299.66,
      "duration_seconds": 3.17,
      "text": "Erm, do I need to prepare?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.58,
      "end_seconds": 328.75,
      "duration_seconds": 27.17,
      "text": "I want a thyroid test done, that's for muscle weakness. Don't stop any of your tablets on your own, we'll decide after the blood test. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. If it hasn't settled in a month, we'd think about a creatine kinase level, but not now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.8,
      "end_seconds": 338.93,
      "duration_seconds": 8.13,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.89,
      "end_seconds": 343.16,
      "duration_seconds": 3.27,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.66,
      "end_seconds": 351.31,
      "duration_seconds": 6.65,
      "text": "Let's review you in two weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.45,
      "end_seconds": 355.61,
      "duration_seconds": 3.16,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}