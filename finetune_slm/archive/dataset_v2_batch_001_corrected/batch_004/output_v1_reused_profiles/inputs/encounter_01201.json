    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 226.33,
      "end_seconds": 229.07,
      "duration_seconds": 2.74,
      "text": "What are the odds it's serious?"
