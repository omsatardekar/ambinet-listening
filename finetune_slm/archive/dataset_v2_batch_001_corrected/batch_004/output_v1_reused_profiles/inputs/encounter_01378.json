{
  "schema_version": "1.0",
  "encounter_id": "01378",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 2.83,
      "duration_seconds": 1.52,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.36,
      "end_seconds": 8.78,
      "duration_seconds": 4.42,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.21,
      "end_seconds": 18.83,
      "duration_seconds": 8.62,
      "text": "I wanted to get cramps in my calves at night looked at. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.55,
      "end_seconds": 24.19,
      "duration_seconds": 3.64,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.62,
      "end_seconds": 39.47,
      "duration_seconds": 13.85,
      "text": "Sorry, what was I saying, honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.15,
      "end_seconds": 45.29,
      "duration_seconds": 5.14,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.64,
      "end_seconds": 61.97,
      "duration_seconds": 15.33,
      "text": "I notice it more with lying in bed. It settles a little with stretching and walking about. Honestly, every other day. Pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.42,
      "end_seconds": 65.83,
      "duration_seconds": 2.41,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.95,
      "end_seconds": 82.92,
      "duration_seconds": 15.97,
      "text": "mm, uh, when it starts I tend to get a dull ache after the cramp as well um, um, the dull ache after the cramp? That's been for about a year"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.8,
      "end_seconds": 87.59,
      "duration_seconds": 2.79,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.52,
      "end_seconds": 97.54,
      "duration_seconds": 8.02,
      "text": "I'd say moderate. Oh, and tingling in my feet. That's been about the same, two years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.74,
      "end_seconds": 102.55,
      "duration_seconds": 3.81,
      "text": "so, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.41,
      "end_seconds": 105.82,
      "duration_seconds": 1.41,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.39,
      "end_seconds": 108.18,
      "duration_seconds": 1.79,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.51,
      "end_seconds": 109.31,
      "duration_seconds": 0.8,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.57,
      "end_seconds": 122.48,
      "duration_seconds": 2.91,
      "text": "Nothing like redness of the leg?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.25,
      "end_seconds": 127.63,
      "duration_seconds": 3.38,
      "text": "no no redness of the leg"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.31,
      "end_seconds": 133.35,
      "duration_seconds": 5.04,
      "text": "Did you get back pain, chest pain or swelling of the legs?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.0,
      "end_seconds": 142.57,
      "duration_seconds": 7.57,
      "text": "No back pain, chest pain or swelling of the legs, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.2,
      "end_seconds": 145.77,
      "duration_seconds": 2.57,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.58,
      "end_seconds": 147.57,
      "duration_seconds": 0.99,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.39,
      "end_seconds": 151.98,
      "duration_seconds": 2.59,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.97,
      "end_seconds": 167.69,
      "duration_seconds": 14.72,
      "text": "I quit smoking around ten years ago. I drink a lot of tea and snack through the day. Not much, I mostly stay in these days. My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.44,
      "end_seconds": 172.24,
      "duration_seconds": 2.8,
      "text": "So, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.37,
      "end_seconds": 181.95,
      "duration_seconds": 6.58,
      "text": "Right, I'm on ramipril, 5 milligrams, every morning. It's magnesium tablets, at night."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.24,
      "end_seconds": 185.36,
      "duration_seconds": 3.12,
      "text": "I follow have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.37,
      "end_seconds": 188.33,
      "duration_seconds": 1.96,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.13,
      "end_seconds": 195.54,
      "duration_seconds": 2.41,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.37,
      "end_seconds": 208.05,
      "duration_seconds": 10.68,
      "text": "Erm, I've had high blood pressure for about ten years now. I've had diabetes for about ten years now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.83,
      "end_seconds": 212.63,
      "duration_seconds": 3.8,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.66,
      "end_seconds": 217.01,
      "duration_seconds": 2.35,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.69,
      "end_seconds": 223.46,
      "duration_seconds": 2.77,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.02,
      "end_seconds": 234.54,
      "duration_seconds": 2.52,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.2,
      "end_seconds": 261.89,
      "duration_seconds": 7.69,
      "text": "Okay: pressure 124 over 75, temp 36.5 degrees, pulse is 74 beats a minute, respiratory rate 16."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.52,
      "end_seconds": 268.76,
      "duration_seconds": 2.24,
      "text": "Is that that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.81,
      "end_seconds": 273.56,
      "duration_seconds": 3.75,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.13,
      "end_seconds": 279.04,
      "duration_seconds": 2.91,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.98,
      "end_seconds": 283.79,
      "duration_seconds": 2.81,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.6,
      "end_seconds": 308.36,
      "duration_seconds": 6.76,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.61,
      "end_seconds": 312.97,
      "duration_seconds": 2.36,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.74,
      "end_seconds": 339.84,
      "duration_seconds": 9.1,
      "text": "Let me tell you where I've got to. My working impression is night-time muscle cramps without a worrying cause."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 341.2,
      "end_seconds": 342.55,
      "duration_seconds": 1.35,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.41,
      "end_seconds": 351.84,
      "duration_seconds": 8.43,
      "text": "I can't promise yet, but most people with night-time muscle cramps without a worrying cause do well once it's treated properly."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.14,
      "end_seconds": 380.98,
      "duration_seconds": 18.84,
      "text": "Let's book blood tests to look into muscle cramps. I'm sending you for a blood sugar test because of tingling feet. Keep well hydrated through the day. Please take the tablets with food so they don't upset your stomach. See me again after the results are back."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 381.71,
      "end_seconds": 384.43,
      "duration_seconds": 2.72,
      "text": "Well, okay, I'll arrange it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.03,
      "end_seconds": 391.01,
      "duration_seconds": 4.98,
      "text": "Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.81,
      "end_seconds": 394.63,
      "duration_seconds": 2.82,
      "text": "no, that's all. Thanks a lot"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.27,
      "end_seconds": 397.75,
      "duration_seconds": 1.48,
      "text": "goodbye for now"
    }
  ]
}