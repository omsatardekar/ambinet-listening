{
  "schema_version": "1.0",
  "encounter_id": "01375",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.95,
      "duration_seconds": 4.12,
      "text": "Uh, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.26,
      "end_seconds": 14.39,
      "duration_seconds": 4.13,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.2,
      "end_seconds": 31.0,
      "duration_seconds": 14.8,
      "text": "It's a burning in the chest after meals, mostly. Work has been very busy so I kept ignoring it. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.53,
      "end_seconds": 35.92,
      "duration_seconds": 4.39,
      "text": "Alright, when was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.62,
      "end_seconds": 41.71,
      "duration_seconds": 4.09,
      "text": "Mm, it's been going on for six months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.11,
      "end_seconds": 54.8,
      "duration_seconds": 8.69,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.41,
      "end_seconds": 61.52,
      "duration_seconds": 6.11,
      "text": "Large meals definitely sets it off. Only antacids, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.83,
      "end_seconds": 68.34,
      "duration_seconds": 2.51,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.04,
      "end_seconds": 82.0,
      "duration_seconds": 11.96,
      "text": "It usually comes with a dry cough that won't go away. The dry cough that won't go away? That's been for three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.74,
      "end_seconds": 92.18,
      "duration_seconds": 8.44,
      "text": "Have you had a burning in the chest after meals before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.02,
      "end_seconds": 97.63,
      "duration_seconds": 4.61,
      "text": "A bit, last year. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 109.75,
      "end_seconds": 119.07,
      "duration_seconds": 9.32,
      "text": "Here are the numbers, doctor. Blood pressure 126 over 76, respiratory rate 17. Saturation 99 percent, pulse 64, temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.8,
      "end_seconds": 121.61,
      "duration_seconds": 1.81,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.12,
      "end_seconds": 125.1,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.13,
      "end_seconds": 129.82,
      "duration_seconds": 2.69,
      "text": "Yes, um, that's fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.77,
      "end_seconds": 133.79,
      "duration_seconds": 2.02,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.07,
      "end_seconds": 153.15,
      "duration_seconds": 5.08,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.08,
      "end_seconds": 157.84,
      "duration_seconds": 1.76,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.76,
      "end_seconds": 172.83,
      "duration_seconds": 2.07,
      "text": "Any sign of night sweats?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.85,
      "end_seconds": 176.88,
      "duration_seconds": 2.03,
      "text": "Nope, no night sweats."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.76,
      "end_seconds": 183.73,
      "duration_seconds": 4.97,
      "text": "Have you noticed coughing up blood, trouble swallowing or shortness of breath?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.36,
      "end_seconds": 190.65,
      "duration_seconds": 6.29,
      "text": "No coughing up blood, trouble swallowing or shortness of breath, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.42,
      "end_seconds": 198.69,
      "duration_seconds": 3.27,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.75,
      "end_seconds": 203.21,
      "duration_seconds": 2.46,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.09,
      "end_seconds": 206.89,
      "duration_seconds": 1.8,
      "text": "So, neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.51,
      "end_seconds": 209.82,
      "duration_seconds": 2.31,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.81,
      "end_seconds": 215.28,
      "duration_seconds": 3.47,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.15,
      "end_seconds": 218.24,
      "duration_seconds": 2.09,
      "text": "It's Digene, after meals."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.32,
      "end_seconds": 223.62,
      "duration_seconds": 3.3,
      "text": "Okay, how long have you taken that?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.72,
      "end_seconds": 227.11,
      "duration_seconds": 1.39,
      "text": "About six months."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.23,
      "end_seconds": 234.38,
      "duration_seconds": 6.15,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.95,
      "end_seconds": 250.46,
      "duration_seconds": 14.51,
      "text": "I quit smoking around ten years ago. I swim twice a week. I work in accounts at a hospital. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.38,
      "end_seconds": 254.54,
      "duration_seconds": 3.16,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.54,
      "end_seconds": 258.03,
      "duration_seconds": 2.49,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.03,
      "end_seconds": 266.43,
      "duration_seconds": 7.4,
      "text": "Any medical conditions, anything you've been treated for? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 268.02,
      "end_seconds": 270.44,
      "duration_seconds": 2.42,
      "text": "No, um, no conditions."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.41,
      "end_seconds": 275.93,
      "duration_seconds": 3.52,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.79,
      "end_seconds": 281.65,
      "duration_seconds": 3.86,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.74,
      "end_seconds": 290.43,
      "duration_seconds": 6.69,
      "text": "Okay, thinking it through, my working impression is a cough driven by acid reflux."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 292.47,
      "end_seconds": 294.4,
      "duration_seconds": 1.93,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.96,
      "end_seconds": 305.5,
      "duration_seconds": 9.54,
      "text": "I can't promise yet, but most people with a cough driven by acid reflux do well once it's treated properly."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 316.88,
      "end_seconds": 321.91,
      "duration_seconds": 5.03,
      "text": "I'm sending you for a chest X-ray because of chronic cough."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.78,
      "end_seconds": 328.92,
      "duration_seconds": 6.14,
      "text": "Sorry, what was I saying, where would I go for that?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.72,
      "end_seconds": 333.98,
      "duration_seconds": 4.26,
      "text": "Let's book breathing tests to look into chronic cough."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.44,
      "end_seconds": 337.89,
      "duration_seconds": 2.45,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.78,
      "end_seconds": 350.77,
      "duration_seconds": 11.99,
      "text": "Let's use pantoprazole, 40 milligrams, before breakfast, for four weeks. That's for reflux. I'll put all of this in writing so you don't have to remember it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.58,
      "end_seconds": 353.94,
      "duration_seconds": 1.36,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.57,
      "end_seconds": 368.98,
      "duration_seconds": 14.41,
      "text": "Don't eat for two or three hours before lying down, and raise the head of the bed a little. Come back in four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.68,
      "end_seconds": 373.05,
      "duration_seconds": 3.37,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}