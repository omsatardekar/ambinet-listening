{
  "schema_version": "1.0",
  "encounter_id": "01450",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.66,
      "end_seconds": 3.73,
      "duration_seconds": 3.07,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.5,
      "end_seconds": 5.52,
      "duration_seconds": 1.02,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.41,
      "end_seconds": 9.74,
      "duration_seconds": 3.33,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.07,
      "end_seconds": 12.93,
      "duration_seconds": 1.86,
      "text": "It's tiredness, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.83,
      "end_seconds": 16.6,
      "duration_seconds": 2.77,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.77,
      "end_seconds": 39.32,
      "duration_seconds": 21.55,
      "text": "Hmm, uh, it's been six months now. I'd rather not end up on lots of tablets if I can avoid it. My family kept telling me to get it checked. I've been feeling cold all the time too."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 40.75,
      "end_seconds": 45.54,
      "duration_seconds": 4.79,
      "text": "Have you had tiredness before, or is this the first time?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.53,
      "end_seconds": 55.39,
      "duration_seconds": 8.86,
      "text": "Ah, um, a bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.36,
      "end_seconds": 78.23,
      "duration_seconds": 3.87,
      "text": "Did you get trouble swallowing, palpitations or heavy periods?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 80.04,
      "end_seconds": 87.52,
      "duration_seconds": 7.48,
      "text": "I mean, uh, no, no trouble swallowing, palpitations or heavy periods."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.61,
      "end_seconds": 91.53,
      "duration_seconds": 1.92,
      "text": "How about low mood?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.56,
      "end_seconds": 99.48,
      "duration_seconds": 4.92,
      "text": "Hmm, uh, I haven't noticed any low mood."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.67,
      "end_seconds": 102.67,
      "duration_seconds": 2.0,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.33,
      "end_seconds": 106.33,
      "duration_seconds": 3.0,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.84,
      "end_seconds": 110.64,
      "duration_seconds": 2.8,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.61,
      "end_seconds": 112.96,
      "duration_seconds": 1.35,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.46,
      "end_seconds": 116.8,
      "duration_seconds": 3.34,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.14,
      "end_seconds": 121.02,
      "duration_seconds": 2.88,
      "text": "Not really, um, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.85,
      "end_seconds": 123.5,
      "duration_seconds": 1.65,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.36,
      "end_seconds": 129.8,
      "duration_seconds": 5.44,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 130.36,
      "end_seconds": 132.32,
      "duration_seconds": 1.96,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.19,
      "end_seconds": 135.63,
      "duration_seconds": 2.44,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.35,
      "end_seconds": 140.08,
      "duration_seconds": 2.73,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 140.88,
      "end_seconds": 145.5,
      "duration_seconds": 4.62,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.77,
      "end_seconds": 148.48,
      "duration_seconds": 1.71,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.43,
      "end_seconds": 155.02,
      "duration_seconds": 4.59,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.51,
      "end_seconds": 176.33,
      "duration_seconds": 3.82,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.43,
      "end_seconds": 180.67,
      "duration_seconds": 3.24,
      "text": "Mm, my grandfather had a stroke."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.56,
      "end_seconds": 202.91,
      "duration_seconds": 3.35,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.84,
      "end_seconds": 208.88,
      "duration_seconds": 4.04,
      "text": "I mean, I've never had an allergy."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.72,
      "end_seconds": 215.44,
      "duration_seconds": 3.72,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.69,
      "end_seconds": 219.63,
      "duration_seconds": 2.94,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.02,
      "end_seconds": 239.41,
      "duration_seconds": 3.39,
      "text": "Reflexes are a bit slow to relax."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.95,
      "end_seconds": 251.08,
      "duration_seconds": 9.13,
      "text": "You can relax now. Putting it all together, I think we're dealing with an underactive thyroid at this stage."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 252.34,
      "end_seconds": 255.39,
      "duration_seconds": 3.05,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.67,
      "end_seconds": 295.46,
      "duration_seconds": 38.79,
      "text": "It's reasonable to be concerned, but right now an underactive thyroid is my leading thought, not anything worse. I think a thyroid test makes sense here, for hypothyroid symptoms. I think blood tests makes sense here, for fatigue. What I'm giving you is levothyroxine, 50 micrograms, every morning on an empty stomach, until we review. That's for hypothyroidism. Take the thyroid tablet on an empty stomach, half an hour before breakfast, and not with calcium or iron."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.21,
      "end_seconds": 305.26,
      "duration_seconds": 8.05,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 307.33,
      "end_seconds": 311.5,
      "duration_seconds": 4.17,
      "text": "Uh, I know what to watch for."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 312.91,
      "end_seconds": 318.56,
      "duration_seconds": 5.65,
      "text": "See me again in six weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.87,
      "end_seconds": 323.08,
      "duration_seconds": 3.21,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.37,
      "end_seconds": 325.62,
      "duration_seconds": 1.25,
      "text": "Look after yourself."
    }
  ]
}