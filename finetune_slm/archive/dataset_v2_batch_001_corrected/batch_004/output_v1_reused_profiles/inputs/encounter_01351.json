{
  "schema_version": "1.0",
  "encounter_id": "01351",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 8.57,
      "duration_seconds": 7.3,
      "text": "sorry, what was I saying, good evening, doctor, thanks for seeing me"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.77,
      "end_seconds": 13.76,
      "duration_seconds": 3.99,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.4,
      "end_seconds": 19.45,
      "duration_seconds": 5.05,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.5,
      "end_seconds": 26.51,
      "duration_seconds": 3.01,
      "text": "alright, absolutely, come and sit beside them"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.13,
      "end_seconds": 36.0,
      "duration_seconds": 7.87,
      "text": "Let me think, so the thing is, I've got a very painful, swollen big toe."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.63,
      "end_seconds": 44.4,
      "duration_seconds": 2.77,
      "text": "So, did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.6,
      "end_seconds": 50.05,
      "duration_seconds": 4.45,
      "text": "I, I'd say about a month, maybe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 52.04,
      "end_seconds": 56.0,
      "duration_seconds": 3.96,
      "text": "It was closer to about two months, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.88,
      "end_seconds": 61.52,
      "duration_seconds": 4.64,
      "text": "Okay, so roughly one to two months. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.59,
      "end_seconds": 65.91,
      "duration_seconds": 3.32,
      "text": "Yes, uh, somewhere around that."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.1,
      "end_seconds": 77.09,
      "duration_seconds": 9.99,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.0,
      "end_seconds": 85.6,
      "duration_seconds": 7.6,
      "text": "Um, it's a few times a day. It feels mild to me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.75,
      "end_seconds": 94.63,
      "duration_seconds": 3.88,
      "text": "Has there been redness over the joint too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.25,
      "end_seconds": 110.97,
      "duration_seconds": 15.72,
      "text": "Yes, about the same, two days. Um, I've also had warmth in the toe. Oh, and a low fever. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.54,
      "end_seconds": 118.85,
      "duration_seconds": 7.31,
      "text": "have you had a very painful, swollen big toe before, or is this the the first time?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.94,
      "end_seconds": 127.62,
      "duration_seconds": 7.68,
      "text": "Okay, so a bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.71,
      "end_seconds": 132.71,
      "duration_seconds": 4.0,
      "text": "have you noticed rash, chills or recent illness?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.89,
      "end_seconds": 138.89,
      "duration_seconds": 5.0,
      "text": "Hmm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.51,
      "end_seconds": 145.69,
      "duration_seconds": 2.18,
      "text": "any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.34,
      "end_seconds": 151.47,
      "duration_seconds": 4.13,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.56,
      "end_seconds": 157.76,
      "duration_seconds": 4.2,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.9,
      "end_seconds": 163.0,
      "duration_seconds": 4.1,
      "text": "No, uh, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 164.06,
      "end_seconds": 172.14,
      "duration_seconds": 8.08,
      "text": "Hold on, doctor, I think she reacted to trimethoprim once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.66,
      "end_seconds": 176.81,
      "duration_seconds": 4.15,
      "text": "actually, um, really? I don't think so"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.07,
      "end_seconds": 183.68,
      "duration_seconds": 5.61,
      "text": "Okay, I'll note both of those. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 185.09,
      "end_seconds": 202.26,
      "duration_seconds": 17.17,
      "text": "She is on febuxostat, 80 milligrams, once a day, I give it to her. Um, uh, it's valsartan, 80 milligrams, once a day, doctor. She takes aspirin, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.76,
      "end_seconds": 212.24,
      "duration_seconds": 2.48,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.22,
      "end_seconds": 218.1,
      "duration_seconds": 3.88,
      "text": "Just a triple bypass, eight years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.94,
      "end_seconds": 221.01,
      "duration_seconds": 2.07,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.44,
      "end_seconds": 226.83,
      "duration_seconds": 4.39,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.09,
      "end_seconds": 231.28,
      "duration_seconds": 3.19,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.1,
      "end_seconds": 236.64,
      "duration_seconds": 4.54,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.21,
      "end_seconds": 242.11,
      "duration_seconds": 3.9,
      "text": "any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.94,
      "end_seconds": 246.05,
      "duration_seconds": 3.11,
      "text": "Kidney disease, for about a year"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.34,
      "end_seconds": 248.11,
      "duration_seconds": 0.77,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.25,
      "end_seconds": 264.76,
      "duration_seconds": 11.51,
      "text": "I've, I've had gout, yes i've had high blood pressure, yes yes, heart disease it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.26,
      "end_seconds": 272.47,
      "duration_seconds": 6.21,
      "text": "right, so gout is already on your record we'll keep that in mind today"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.95,
      "end_seconds": 286.81,
      "duration_seconds": 2.86,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.05,
      "end_seconds": 298.92,
      "duration_seconds": 2.87,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.28,
      "end_seconds": 318.68,
      "duration_seconds": 7.4,
      "text": "okay: blood pressure 126 over 75, respiratory rate 18, temperature is 36.4 degrees, heart rate 80."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.76,
      "end_seconds": 323.06,
      "duration_seconds": 2.3,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.01,
      "end_seconds": 326.5,
      "duration_seconds": 2.49,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.68,
      "end_seconds": 331.81,
      "duration_seconds": 4.13,
      "text": "Now I'm gonna to do a short physical check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.76,
      "end_seconds": 334.12,
      "duration_seconds": 1.36,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.86,
      "end_seconds": 349.3,
      "duration_seconds": 5.44,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 353.58,
      "end_seconds": 355.65,
      "duration_seconds": 2.07,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.95,
      "end_seconds": 404.8,
      "duration_seconds": 32.85,
      "text": "Having listened and examined, it's hard to say. An acute gout flare is one possibility and septic arthritis another, and I'd rather not commit yet. A uric acid level is what I'd like next, for suspected gout. I'll request kidney function tests, it'll help with gout. Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. A short walk every day, even twenty minutes, will help more than you'd think."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 405.41,
      "end_seconds": 410.46,
      "duration_seconds": 5.05,
      "text": "Book a review in a week. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 411.85,
      "end_seconds": 416.13,
      "duration_seconds": 4.28,
      "text": "Oh, good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.01,
      "end_seconds": 418.56,
      "duration_seconds": 1.55,
      "text": "Have a good day."
    }
  ]
}