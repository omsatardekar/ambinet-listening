{
  "schema_version": "1.0",
  "encounter_id": "01222",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.01,
      "end_seconds": 7.51,
      "duration_seconds": 6.5,
      "text": "Okay, doctor, we're all set in here. I'll give you the numbers when you want them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.8,
      "end_seconds": 12.73,
      "duration_seconds": 3.93,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.79,
      "end_seconds": 24.52,
      "duration_seconds": 8.73,
      "text": "Uh, so the thing is, I've got a red, hot area on my lower leg."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.6,
      "end_seconds": 28.71,
      "duration_seconds": 3.11,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.75,
      "end_seconds": 36.89,
      "duration_seconds": 6.14,
      "text": "Around about a week... no wait, it's more like two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.94,
      "end_seconds": 41.81,
      "duration_seconds": 2.87,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 43.81,
      "end_seconds": 45.84,
      "duration_seconds": 2.03,
      "text": "Elevation helps a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.53,
      "end_seconds": 49.67,
      "duration_seconds": 2.14,
      "text": "Have you been feeling feverish?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 51.45,
      "end_seconds": 60.85,
      "duration_seconds": 9.4,
      "text": "Yes, you know, for ten days. As for feeling feverish, about a four out of ten."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.8,
      "end_seconds": 76.86,
      "duration_seconds": 6.06,
      "text": "Any wound, vomiting, red streaks up the leg or breathlessness at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 77.44,
      "end_seconds": 83.72,
      "duration_seconds": 6.28,
      "text": "I haven't had wound, vomiting, red streaks up the leg or breathlessness, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.32,
      "end_seconds": 91.48,
      "duration_seconds": 2.16,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.52,
      "end_seconds": 93.98,
      "duration_seconds": 1.46,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.63,
      "end_seconds": 109.47,
      "duration_seconds": 2.84,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.99,
      "end_seconds": 111.02,
      "duration_seconds": 1.03,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.54,
      "end_seconds": 128.89,
      "duration_seconds": 2.35,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 132.17,
      "end_seconds": 136.18,
      "duration_seconds": 4.01,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.08,
      "end_seconds": 141.44,
      "duration_seconds": 4.36,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.34,
      "end_seconds": 147.22,
      "duration_seconds": 3.88,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.79,
      "end_seconds": 156.68,
      "duration_seconds": 3.89,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.31,
      "end_seconds": 162.2,
      "duration_seconds": 3.89,
      "text": "No, um, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.18,
      "end_seconds": 168.86,
      "duration_seconds": 4.68,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.7,
      "end_seconds": 173.85,
      "duration_seconds": 3.15,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.9,
      "end_seconds": 177.7,
      "duration_seconds": 2.8,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 178.56,
      "end_seconds": 180.08,
      "duration_seconds": 1.52,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 180.65,
      "end_seconds": 192.03,
      "duration_seconds": 11.38,
      "text": "Here are the numbers, doctor. Pulse is 106 beats a minute, temperature is 38.6 degrees, saturation 98 percent, BP is 106 over 77."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.96,
      "end_seconds": 194.33,
      "duration_seconds": 1.37,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 199.3,
      "duration_seconds": 2.07,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.27,
      "end_seconds": 203.22,
      "duration_seconds": 1.95,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.09,
      "end_seconds": 222.44,
      "duration_seconds": 7.35,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.11,
      "end_seconds": 228.85,
      "duration_seconds": 1.74,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.99,
      "end_seconds": 252.42,
      "duration_seconds": 12.43,
      "text": "From what you've told me and what I found, it points towards cellulitis of the right leg. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 254.33,
      "end_seconds": 255.73,
      "duration_seconds": 1.4,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.48,
      "end_seconds": 281.95,
      "duration_seconds": 24.47,
      "text": "I understand the worry. At the moment I'd say it's cellulitis of the right leg, and we'll know more once the an ultrasound of the leg veins is back. Stop me if I've got anything wrong. You've had a red, hot area on your lower leg for two weeks, and no breathlessness or red streaks up the leg."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 284.02,
      "end_seconds": 284.72,
      "duration_seconds": 0.7,
      "text": "Exactly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.55,
      "end_seconds": 306.3,
      "duration_seconds": 19.75,
      "text": "I'll request an ultrasound of the leg veins, it'll help with leg swelling. We'll begin with flucloxacillin, 500 milligrams, four times a day, for seven days. That's for cellulitis. Mark the edge of the redness with a pen and keep the leg raised when sitting."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.83,
      "end_seconds": 319.2,
      "duration_seconds": 12.37,
      "text": "Okay, go on. One warning sign to remember: the redness spreads quickly or you get a high fever. In that case don't wait. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 321.2,
      "end_seconds": 325.84,
      "duration_seconds": 4.64,
      "text": "Hmm, okay, that makes sense. Thanks for explaining."
    }
  ]
}