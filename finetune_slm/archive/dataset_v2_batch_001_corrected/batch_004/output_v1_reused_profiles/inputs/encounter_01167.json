  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 3.93,
      "duration_seconds": 2.87,
      "text": "morning, doctor. Lovely to meet you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.84,
      "end_seconds": 11.85,
      "duration_seconds": 5.01,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.9,
      "end_seconds": 20.33,
      "duration_seconds": 6.43,
      "text": "it's a mole that is itching i thought I'd wait, but it hasn't gone"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.05,
      "end_seconds": 24.79,
      "duration_seconds": 2.74,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.65,
      "end_seconds": 41.04,
      "duration_seconds": 2.39,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.48,
      "end_seconds": 66.11,
      "duration_seconds": 9.63,
      "text": "Okay: temperature is 36.5 degrees, oxygen saturation is 97 percent, pressure 127 over 82, pulse 77. Did it come on recently?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.2,
      "end_seconds": 72.31,
      "duration_seconds": 2.11,
      "text": "probably six months yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.78,
      "end_seconds": 76.4,
      "duration_seconds": 3.62,
      "text": "I see, go ahead. How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.35,
      "end_seconds": 81.98,
      "duration_seconds": 3.63,
      "text": "I'd say once or twice a day"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.33,
      "end_seconds": 86.9,
      "duration_seconds": 3.57,
      "text": "A few quick ones: pain or other new moles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.02,
      "end_seconds": 89.98,
      "duration_seconds": 1.96,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.03,
      "end_seconds": 96.69,
      "duration_seconds": 4.66,
      "text": "Have you noticed night sweats or family history of melanoma?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.68,
      "end_seconds": 100.35,
      "duration_seconds": 2.67,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.61,
      "end_seconds": 104.64,
      "duration_seconds": 3.03,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.33,
      "end_seconds": 107.95,
      "duration_seconds": 2.62,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.3,
      "end_seconds": 114.48,
      "duration_seconds": 5.18,
      "text": "Alright, have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.45,
      "end_seconds": 117.66,
      "duration_seconds": 2.21,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.13,
      "end_seconds": 124.67,
      "duration_seconds": 5.54,
      "text": "Alright, has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.34,
      "end_seconds": 133.07,
      "duration_seconds": 3.73,
      "text": "yes, diclofenac i get swelling of my lips"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.18,
      "end_seconds": 136.94,
      "duration_seconds": 2.76,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.97,
      "end_seconds": 140.26,
      "duration_seconds": 2.29,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.85,
      "end_seconds": 159.11,
      "duration_seconds": 8.26,
      "text": "tell me about any past illnesses or ongoing conditions. I ask because it helps me narrow things down"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.84,
      "end_seconds": 166.01,
      "duration_seconds": 4.17,
      "text": "I've, I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.59,
      "end_seconds": 171.29,
      "duration_seconds": 3.7,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.04,
      "end_seconds": 176.12,
      "duration_seconds": 3.08,
      "text": "It's thyroxine, 75 micrograms, every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.09,
      "end_seconds": 180.84,
      "duration_seconds": 2.75,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.55,
      "end_seconds": 197.97,
      "duration_seconds": 16.42,
      "text": "I used to drink heavily but I stopped four years ago. I work in accounts at a hospital. I walk the dog every morning. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.29,
      "end_seconds": 203.2,
      "duration_seconds": 3.91,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.87,
      "end_seconds": 207.1,
      "duration_seconds": 2.23,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.4,
      "end_seconds": 225.86,
      "duration_seconds": 8.46,
      "text": "there is a dark, six-millimetre mole with an irregular border and two shades of brown on the upper back"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.93,
      "end_seconds": 232.06,
      "duration_seconds": 2.13,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.61,
      "end_seconds": 265.98,
      "duration_seconds": 17.37,
      "text": "From what you've told me and what I found, this is probably a pigmented lesion that needs removal for a proper diagnosis. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.68,
      "end_seconds": 269.64,
      "duration_seconds": 2.96,
      "text": "Hmm, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.0,
      "end_seconds": 281.79,
      "duration_seconds": 10.79,
      "text": "I understand the worry. At the moment I'd say it's a pigmented lesion that needs removal for a proper diagnosis, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.48,
      "end_seconds": 301.65,
      "duration_seconds": 9.17,
      "text": "There's nothing new for me to to start or arrange today. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 307.71,
      "end_seconds": 309.68,
      "duration_seconds": 1.97,
      "text": "thank you, that's helpful"
    }
  ]
}