{
  "schema_version": "1.0",
  "encounter_id": "01177",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.06,
      "end_seconds": 3.45,
      "duration_seconds": 2.39,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.89,
      "end_seconds": 10.6,
      "duration_seconds": 2.71,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.65,
      "end_seconds": 13.84,
      "duration_seconds": 2.19,
      "text": "Lovely day outside, isn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.02,
      "end_seconds": 19.62,
      "duration_seconds": 4.6,
      "text": "It is, I almost forgot I was coming here."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.7,
      "end_seconds": 24.22,
      "duration_seconds": 2.52,
      "text": "Okay, where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.73,
      "end_seconds": 27.23,
      "duration_seconds": 1.5,
      "text": "It's wheezing, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.68,
      "end_seconds": 31.09,
      "duration_seconds": 2.41,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.68,
      "end_seconds": 46.16,
      "duration_seconds": 2.48,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.31,
      "end_seconds": 81.14,
      "duration_seconds": 15.83,
      "text": "Okay: pulse is 84 beats a minute, weight 67 kilos, temperature is 37.4 degrees, saturation 90 percent, blood pressure 119 over 86, respiratory rate 25, height 186 centimetres. How long has it been like this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 83.12,
      "end_seconds": 85.64,
      "duration_seconds": 2.52,
      "text": "For three days, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.86,
      "end_seconds": 91.55,
      "duration_seconds": 4.69,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.93,
      "end_seconds": 103.96,
      "duration_seconds": 11.03,
      "text": "Severe, really. Only my inhaler, and it's not much. I told my wife I'd come today. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 128.68,
      "duration_seconds": 6.3,
      "text": "A few quick ones: leg swelling, weight loss, sharp chest pain or ankle swelling?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.12,
      "end_seconds": 132.48,
      "duration_seconds": 2.36,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.58,
      "end_seconds": 137.97,
      "duration_seconds": 3.39,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.79,
      "end_seconds": 140.34,
      "duration_seconds": 1.55,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.77,
      "end_seconds": 143.74,
      "duration_seconds": 1.97,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 144.45,
      "end_seconds": 145.98,
      "duration_seconds": 1.53,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.43,
      "end_seconds": 148.29,
      "duration_seconds": 0.86,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 148.83,
      "end_seconds": 152.42,
      "duration_seconds": 3.59,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.8,
      "end_seconds": 155.06,
      "duration_seconds": 1.26,
      "text": "What about alcohol?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 155.92,
      "end_seconds": 159.66,
      "duration_seconds": 3.74,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.23,
      "end_seconds": 168.26,
      "duration_seconds": 4.03,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.15,
      "end_seconds": 172.4,
      "duration_seconds": 3.25,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.98,
      "end_seconds": 174.28,
      "duration_seconds": 1.3,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 175.61,
      "end_seconds": 179.41,
      "duration_seconds": 3.8,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.71,
      "end_seconds": 185.24,
      "duration_seconds": 2.53,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.55,
      "end_seconds": 189.03,
      "duration_seconds": 2.48,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.13,
      "end_seconds": 207.74,
      "duration_seconds": 4.61,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.76,
      "end_seconds": 211.86,
      "duration_seconds": 2.1,
      "text": "I've had COPD, yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.59,
      "end_seconds": 217.28,
      "duration_seconds": 3.69,
      "text": "Right, right. Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.16,
      "end_seconds": 225.02,
      "duration_seconds": 6.86,
      "text": "Actually, you know, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.48,
      "end_seconds": 241.72,
      "duration_seconds": 5.24,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.15,
      "end_seconds": 245.63,
      "duration_seconds": 2.48,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.7,
      "end_seconds": 249.1,
      "duration_seconds": 2.4,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.79,
      "end_seconds": 253.03,
      "duration_seconds": 2.24,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.08,
      "end_seconds": 267.38,
      "duration_seconds": 4.3,
      "text": "There are scattered wheezes on both sides and no crackles."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.41,
      "end_seconds": 273.95,
      "duration_seconds": 3.54,
      "text": "Alright, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.92,
      "end_seconds": 300.1,
      "duration_seconds": 11.18,
      "text": "Taking everything into account, I'm honestly not certain yet. It could be an infective exacerbation of chronic lung disease, or it might be a flare of asthma."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.12,
      "end_seconds": 305.2,
      "duration_seconds": 3.08,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.93,
      "end_seconds": 325.84,
      "duration_seconds": 19.91,
      "text": "I understand the worry. At the moment I'd say it's an infective exacerbation of chronic lung disease, and we'll know more once the a sputum sample is back. Stop me if I've got anything wrong. You've had wheezing for three days, severe, and no leg swelling or weight loss."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.38,
      "end_seconds": 327.89,
      "duration_seconds": 1.51,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 329.26,
      "end_seconds": 332.98,
      "duration_seconds": 3.72,
      "text": "Let's get a sputum sample, for purulent sputum."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 333.81,
      "end_seconds": 336.6,
      "duration_seconds": 2.79,
      "text": "The earliest is Friday, 10 am."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 337.6,
      "end_seconds": 338.61,
      "duration_seconds": 1.01,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.22,
      "end_seconds": 368.85,
      "duration_seconds": 29.63,
      "text": "For this, prednisolone, 30 milligrams, once a day, for five days. That's for flare of lung disease. Keep using your inhaler as before and drink plenty of fluids. One warning sign to remember: you become more breathless or your lips turn blue. In that case don't wait. I'd like you back in two weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 369.95,
      "end_seconds": 373.83,
      "duration_seconds": 3.88,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 374.52,
      "end_seconds": 375.88,
      "duration_seconds": 1.36,
      "text": "All the best."
    }
  ]
}