{
  "schema_version": "1.0",
  "encounter_id": "01264",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.64,
      "duration_seconds": 3.8,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.12,
      "end_seconds": 10.48,
      "duration_seconds": 4.36,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.19,
      "end_seconds": 16.89,
      "duration_seconds": 5.7,
      "text": "Morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.03,
      "end_seconds": 21.8,
      "duration_seconds": 3.77,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 23.58,
      "end_seconds": 30.45,
      "duration_seconds": 6.87,
      "text": "Uh, she's been having cramping in the calves when I walk, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.23,
      "end_seconds": 34.96,
      "duration_seconds": 2.73,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.58,
      "end_seconds": 39.71,
      "duration_seconds": 2.13,
      "text": "About... well, five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.51,
      "end_seconds": 44.99,
      "duration_seconds": 3.48,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.45,
      "end_seconds": 50.44,
      "duration_seconds": 3.99,
      "text": "A three out of ten, I suppose."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.06,
      "end_seconds": 53.42,
      "duration_seconds": 2.36,
      "text": "Is it worse at certain times?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.54,
      "end_seconds": 65.11,
      "duration_seconds": 10.57,
      "text": "I, I notice it more with walking. Oh, and cold feet. That's been about the same, five days."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.04,
      "end_seconds": 69.97,
      "duration_seconds": 2.93,
      "text": "Have you had dry cracked heels?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.85,
      "end_seconds": 72.48,
      "duration_seconds": 1.63,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.09,
      "end_seconds": 80.24,
      "duration_seconds": 7.15,
      "text": "Have you had cramping in the calves when you walk before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.92,
      "end_seconds": 87.92,
      "duration_seconds": 6.0,
      "text": "I had a similar thing about six months ago. It went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.76,
      "end_seconds": 109.64,
      "duration_seconds": 4.88,
      "text": "Any redness spreading up the foot, smell from the foot or pus?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.61,
      "end_seconds": 119.06,
      "duration_seconds": 8.45,
      "text": "I haven't had redness spreading up the foot, smell from the foot or pus, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.21,
      "end_seconds": 124.6,
      "duration_seconds": 4.39,
      "text": "Any black skin or foot pain at rest at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.53,
      "end_seconds": 129.51,
      "duration_seconds": 2.98,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.22,
      "end_seconds": 137.07,
      "duration_seconds": 1.85,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.33,
      "end_seconds": 141.87,
      "duration_seconds": 3.54,
      "text": "No, um, my breathing's been fine."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.82,
      "end_seconds": 148.48,
      "duration_seconds": 4.66,
      "text": "Alright, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 149.42,
      "end_seconds": 153.56,
      "duration_seconds": 4.14,
      "text": "It's metformin, 500 milligrams, twice a day, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.47,
      "end_seconds": 157.4,
      "duration_seconds": 1.93,
      "text": "And for how long?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 159.15,
      "end_seconds": 161.1,
      "duration_seconds": 1.95,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.85,
      "end_seconds": 177.21,
      "duration_seconds": 7.36,
      "text": "Let me ask about allergies, anything at all? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.17,
      "end_seconds": 184.51,
      "duration_seconds": 5.34,
      "text": "Sorry, what was I saying, yes, amoxicillin. I get hives."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 185.5,
      "end_seconds": 186.7,
      "duration_seconds": 1.2,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.62,
      "end_seconds": 191.05,
      "duration_seconds": 3.43,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.64,
      "end_seconds": 194.94,
      "duration_seconds": 3.3,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.73,
      "end_seconds": 199.49,
      "duration_seconds": 3.76,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.86,
      "end_seconds": 204.51,
      "duration_seconds": 3.65,
      "text": "Right, are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.1,
      "end_seconds": 209.08,
      "duration_seconds": 2.98,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.9,
      "end_seconds": 214.23,
      "duration_seconds": 4.33,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.3,
      "end_seconds": 219.45,
      "duration_seconds": 4.15,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.41,
      "end_seconds": 233.86,
      "duration_seconds": 3.45,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.34,
      "end_seconds": 247.87,
      "duration_seconds": 2.53,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.19,
      "end_seconds": 278.42,
      "duration_seconds": 9.23,
      "text": "Okay: heart rate 85, respiratory rate 18, blood pressure 145 over 89. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.59,
      "end_seconds": 282.57,
      "duration_seconds": 1.98,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.56,
      "end_seconds": 284.82,
      "duration_seconds": 1.26,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.97,
      "end_seconds": 301.67,
      "duration_seconds": 2.7,
      "text": "Pulses at the ankle are weak."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 303.09,
      "end_seconds": 305.34,
      "duration_seconds": 2.25,
      "text": "Okay, uh, doctor."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.7,
      "end_seconds": 322.59,
      "duration_seconds": 12.89,
      "text": "You can sit up now. So where does that leave us? The most likely explanation is a diabetic foot ulcer with some circulation concern. I can't rule out an infected wound yet."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 323.61,
      "end_seconds": 327.79,
      "duration_seconds": 4.18,
      "text": "Yeah, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.62,
      "end_seconds": 350.53,
      "duration_seconds": 21.91,
      "text": "I understand the worry. At the moment I'd say it's a diabetic foot ulcer with some circulation concern, and we'll watch how it goes. Look at your feet every day with a mirror and never go barefoot. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.94,
      "end_seconds": 356.77,
      "duration_seconds": 4.83,
      "text": "Right, you know, I'll do that. Thank you, doctor."
    }
  ]
}