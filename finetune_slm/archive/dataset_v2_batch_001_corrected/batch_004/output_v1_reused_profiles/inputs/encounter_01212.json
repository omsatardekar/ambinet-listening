{
  "schema_version": "1.0",
  "encounter_id": "01212",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.8,
      "end_seconds": 4.78,
      "duration_seconds": 3.98,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.88,
      "end_seconds": 10.51,
      "duration_seconds": 3.63,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.72,
      "end_seconds": 20.1,
      "duration_seconds": 8.38,
      "text": "It's itching in the groin, mostly. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.9,
      "end_seconds": 23.88,
      "duration_seconds": 2.98,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.85,
      "end_seconds": 37.13,
      "duration_seconds": 11.28,
      "text": "Ten days, I think... sorry, five days, I got that wrong. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.06,
      "end_seconds": 42.14,
      "duration_seconds": 3.08,
      "text": "So, how often do you get it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.59,
      "end_seconds": 46.02,
      "duration_seconds": 2.43,
      "text": "I'd say on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.41,
      "end_seconds": 49.69,
      "duration_seconds": 2.28,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.79,
      "end_seconds": 58.81,
      "duration_seconds": 6.02,
      "text": "A ring-shaped itchy patch goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.6,
      "end_seconds": 70.6,
      "duration_seconds": 6.0,
      "text": "Have you had any similar rash on the scalp, rash on the palms or fever?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.11,
      "end_seconds": 78.11,
      "duration_seconds": 7.0,
      "text": "I haven't had similar rash on the scalp, rash on the palms or fever, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.34,
      "end_seconds": 81.86,
      "duration_seconds": 3.52,
      "text": "Mm, okay. Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.95,
      "end_seconds": 87.17,
      "duration_seconds": 3.22,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.46,
      "end_seconds": 92.74,
      "duration_seconds": 4.28,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.26,
      "end_seconds": 96.53,
      "duration_seconds": 2.27,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.02,
      "end_seconds": 100.64,
      "duration_seconds": 2.62,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.14,
      "end_seconds": 106.12,
      "duration_seconds": 3.98,
      "text": "Candid cream. I take it twice a day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.62,
      "end_seconds": 110.65,
      "duration_seconds": 3.03,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.43,
      "end_seconds": 116.41,
      "duration_seconds": 3.98,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.06,
      "end_seconds": 119.97,
      "duration_seconds": 2.91,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.61,
      "end_seconds": 128.75,
      "duration_seconds": 3.14,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.14,
      "end_seconds": 131.81,
      "duration_seconds": 1.67,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.45,
      "end_seconds": 135.73,
      "duration_seconds": 2.28,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.34,
      "end_seconds": 148.29,
      "duration_seconds": 2.95,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.99,
      "end_seconds": 151.16,
      "duration_seconds": 1.17,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.59,
      "end_seconds": 165.03,
      "duration_seconds": 4.44,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.59,
      "end_seconds": 168.86,
      "duration_seconds": 2.27,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.27,
      "end_seconds": 182.36,
      "duration_seconds": 2.09,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.14,
      "end_seconds": 196.35,
      "duration_seconds": 2.21,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.18,
      "end_seconds": 224.69,
      "duration_seconds": 10.51,
      "text": "Okay: saturation 98 percent, pulse is 72 beats a minute. And temperature is 36.5 degrees, BP is 121 over 76."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.11,
      "end_seconds": 230.19,
      "duration_seconds": 4.08,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.78,
      "end_seconds": 231.87,
      "duration_seconds": 1.09,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.54,
      "end_seconds": 234.96,
      "duration_seconds": 1.42,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.01,
      "end_seconds": 252.35,
      "duration_seconds": 3.34,
      "text": "Skin between the toes is white and peeling."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.42,
      "end_seconds": 255.66,
      "duration_seconds": 2.24,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.7,
      "end_seconds": 275.17,
      "duration_seconds": 6.47,
      "text": "There's a red ring-shaped scaly patch with a clearer centre in the groin crease."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.03,
      "end_seconds": 293.96,
      "duration_seconds": 12.93,
      "text": "You can sit up now. Okay, so my impression is this: I don't have a clear answer today: a fungal skin infection is possible, and so is psoriasis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 295.12,
      "end_seconds": 296.65,
      "duration_seconds": 1.53,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.22,
      "end_seconds": 308.82,
      "duration_seconds": 11.6,
      "text": "I understand the worry. At the moment I'd say it's a fungal skin infection, and we'll know more once the a skin scraping is back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.95,
      "end_seconds": 343.2,
      "duration_seconds": 27.25,
      "text": "Let's book a skin scraping to look into suspected fungal infection. It's a routine test and it'll give us a much clearer picture. You'll be taking terbinafine cream, once a day, for two weeks. That's for fungal infection. The pharmacy will go through the details again when you pick it up. Keep the area dry, wear loose cotton, and don't share towels."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.12,
      "end_seconds": 352.98,
      "duration_seconds": 7.86,
      "text": "The thing that would worry me is if the symptoms get worse. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 353.92,
      "end_seconds": 357.37,
      "duration_seconds": 3.45,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.11,
      "end_seconds": 368.65,
      "duration_seconds": 9.54,
      "text": "Book a review in two weeks. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.15,
      "end_seconds": 379.41,
      "duration_seconds": 10.26,
      "text": "So, I take the terbinafine cream, once a day and come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.98,
      "end_seconds": 384.86,
      "duration_seconds": 4.88,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 386.3,
      "end_seconds": 388.58,
      "duration_seconds": 2.28,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 393.7,
      "end_seconds": 395.18,
      "duration_seconds": 1.48,
      "text": "Look after yourself."
    }
  ]
}