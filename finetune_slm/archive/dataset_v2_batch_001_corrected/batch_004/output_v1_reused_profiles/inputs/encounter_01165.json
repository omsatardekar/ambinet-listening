{
  "schema_version": "1.0",
  "encounter_id": "01165",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 4.24,
      "duration_seconds": 3.48,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.14,
      "end_seconds": 6.33,
      "duration_seconds": 1.19,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.1,
      "end_seconds": 9.66,
      "duration_seconds": 1.56,
      "text": "Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.96,
      "end_seconds": 14.74,
      "duration_seconds": 3.78,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.55,
      "end_seconds": 17.18,
      "duration_seconds": 1.63,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 18.74,
      "end_seconds": 23.74,
      "duration_seconds": 5.0,
      "text": "Um, so... yellow eyes. That's why I came."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.29,
      "end_seconds": 28.33,
      "duration_seconds": 4.04,
      "text": "Right, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.29,
      "end_seconds": 32.0,
      "duration_seconds": 2.71,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.38,
      "end_seconds": 35.58,
      "duration_seconds": 3.2,
      "text": "Sure. Does anything else come with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.28,
      "end_seconds": 40.81,
      "duration_seconds": 4.53,
      "text": "When it starts I tend to get tiredness as well."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.06,
      "end_seconds": 45.3,
      "duration_seconds": 3.24,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 46.07,
      "end_seconds": 48.78,
      "duration_seconds": 2.71,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.0,
      "end_seconds": 52.86,
      "duration_seconds": 2.86,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.5,
      "end_seconds": 63.35,
      "duration_seconds": 5.85,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.1,
      "end_seconds": 68.34,
      "duration_seconds": 3.24,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.08,
      "end_seconds": 77.95,
      "duration_seconds": 8.87,
      "text": "I live with my elderly mother. I look after my grandchildren most days. I swim twice a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.97,
      "end_seconds": 82.71,
      "duration_seconds": 2.74,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 84.38,
      "end_seconds": 88.4,
      "duration_seconds": 4.02,
      "text": "Right, you know, I've never had an allergy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.72,
      "end_seconds": 93.92,
      "duration_seconds": 4.2,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.81,
      "end_seconds": 97.3,
      "duration_seconds": 1.49,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.49,
      "end_seconds": 112.75,
      "duration_seconds": 3.26,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.53,
      "end_seconds": 117.68,
      "duration_seconds": 3.15,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.85,
      "end_seconds": 134.47,
      "duration_seconds": 4.62,
      "text": "Have you noticed fever, vomiting blood or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 136.11,
      "end_seconds": 141.46,
      "duration_seconds": 5.35,
      "text": "No fever, vomiting blood or severe abdominal pain, none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.46,
      "end_seconds": 147.38,
      "duration_seconds": 2.92,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.29,
      "end_seconds": 151.4,
      "duration_seconds": 2.11,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.35,
      "end_seconds": 160.24,
      "duration_seconds": 2.89,
      "text": "Right, any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 161.06,
      "end_seconds": 164.64,
      "duration_seconds": 3.58,
      "text": "Oh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 168.29,
      "duration_seconds": 2.87,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.57,
      "end_seconds": 184.13,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.07,
      "end_seconds": 211.64,
      "duration_seconds": 7.57,
      "text": "Okay: temperature 37.0, SpO2 99 percent on room air, blood pressure 110 over 82, pulse 70."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.75,
      "end_seconds": 214.26,
      "duration_seconds": 1.51,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.4,
      "end_seconds": 218.03,
      "duration_seconds": 2.63,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.53,
      "end_seconds": 221.99,
      "duration_seconds": 2.46,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 239.99,
      "end_seconds": 241.58,
      "duration_seconds": 1.59,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.57,
      "end_seconds": 243.79,
      "duration_seconds": 1.22,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.44,
      "end_seconds": 266.08,
      "duration_seconds": 7.64,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.26,
      "end_seconds": 273.09,
      "duration_seconds": 1.83,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.61,
      "end_seconds": 316.27,
      "duration_seconds": 33.66,
      "text": "So, based on the history and the examination, the most likely explanation is an acute viral hepatitis. I'm going to order a hepatitis screen, for jaundice. No alcohol at all and avoid paracetamol and other painkillers unless we say. One warning sign to remember: you become drowsy or confused. In that case don't wait. I'd like you back after the results. So, can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.21,
      "end_seconds": 322.17,
      "duration_seconds": 4.96,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 322.86,
      "end_seconds": 328.41,
      "duration_seconds": 5.55,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.48,
      "end_seconds": 336.07,
      "duration_seconds": 1.59,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.61,
      "end_seconds": 337.91,
      "duration_seconds": 1.3,
      "text": "Take care now."
    }
  ]
}