{
  "schema_version": "1.0",
  "encounter_id": "01315",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.11,
      "end_seconds": 4.03,
      "duration_seconds": 2.92,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.31,
      "end_seconds": 12.1,
      "duration_seconds": 3.79,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.12,
      "end_seconds": 19.51,
      "duration_seconds": 5.39,
      "text": "Erm, mainly I've been feeling very thirsty. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.73,
      "end_seconds": 23.66,
      "duration_seconds": 2.93,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.61,
      "end_seconds": 29.0,
      "duration_seconds": 3.39,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.51,
      "end_seconds": 32.47,
      "duration_seconds": 1.96,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.81,
      "end_seconds": 41.64,
      "duration_seconds": 3.83,
      "text": "It settles a little with drinking water."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.44,
      "end_seconds": 46.29,
      "duration_seconds": 2.85,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.08,
      "end_seconds": 58.98,
      "duration_seconds": 10.9,
      "text": "I'd say moderate. I've, I've also been going to the toilet a lot, even at night, since last night."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.65,
      "end_seconds": 63.85,
      "duration_seconds": 4.2,
      "text": "Any vomiting, abdominal pain, fever or breathlessness at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.66,
      "end_seconds": 68.21,
      "duration_seconds": 3.55,
      "text": "No, um, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.59,
      "end_seconds": 74.09,
      "duration_seconds": 4.5,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.87,
      "end_seconds": 82.7,
      "duration_seconds": 2.83,
      "text": "No, that side's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.93,
      "end_seconds": 89.01,
      "duration_seconds": 2.08,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.85,
      "end_seconds": 94.36,
      "duration_seconds": 3.51,
      "text": "Hmm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.0,
      "end_seconds": 107.79,
      "duration_seconds": 4.79,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.48,
      "end_seconds": 112.6,
      "duration_seconds": 3.12,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.54,
      "end_seconds": 119.07,
      "duration_seconds": 4.53,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.97,
      "end_seconds": 125.74,
      "duration_seconds": 5.77,
      "text": "Oh, I'm allergic to plasters, I get a red itchy rash."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.6,
      "end_seconds": 129.17,
      "duration_seconds": 1.57,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 132.77,
      "duration_seconds": 2.43,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.54,
      "end_seconds": 135.9,
      "duration_seconds": 2.36,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.99,
      "end_seconds": 142.33,
      "duration_seconds": 3.34,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.08,
      "end_seconds": 157.34,
      "duration_seconds": 3.26,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.57,
      "end_seconds": 159.6,
      "duration_seconds": 1.03,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.45,
      "end_seconds": 164.24,
      "duration_seconds": 2.79,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.51,
      "end_seconds": 175.97,
      "duration_seconds": 2.46,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.2,
      "end_seconds": 206.11,
      "duration_seconds": 9.91,
      "text": "Okay: weight 72 kilos, oxygen saturation is 99 percent. And temperature is 36.4 degrees, height 182 centimetres, pressure 109 over 76, pulse 76."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.6,
      "end_seconds": 208.94,
      "duration_seconds": 1.34,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.93,
      "end_seconds": 216.15,
      "duration_seconds": 3.22,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.44,
      "end_seconds": 219.49,
      "duration_seconds": 2.05,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.58,
      "end_seconds": 222.59,
      "duration_seconds": 2.01,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.79,
      "end_seconds": 234.71,
      "duration_seconds": 4.92,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.03,
      "end_seconds": 238.5,
      "duration_seconds": 2.47,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.95,
      "end_seconds": 257.39,
      "duration_seconds": 2.44,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 262.6,
      "end_seconds": 265.05,
      "duration_seconds": 2.45,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.61,
      "end_seconds": 290.7,
      "duration_seconds": 9.09,
      "text": "Okay, thinking it through, the most likely explanation is possible new-onset diabetes. I'll request a urine test, it'll help with polyuria."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.39,
      "end_seconds": 292.63,
      "duration_seconds": 1.24,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.12,
      "end_seconds": 311.74,
      "duration_seconds": 17.62,
      "text": "I'd like to arrange a blood sugar test for polydipsia and polyuria. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. Let's plan a check after the results are back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 312.48,
      "end_seconds": 314.33,
      "duration_seconds": 1.85,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.38,
      "end_seconds": 318.28,
      "duration_seconds": 2.9,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.18,
      "end_seconds": 323.08,
      "duration_seconds": 2.9,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.68,
      "end_seconds": 325.97,
      "duration_seconds": 1.29,
      "text": "Goodbye for now."
    }
  ]
}