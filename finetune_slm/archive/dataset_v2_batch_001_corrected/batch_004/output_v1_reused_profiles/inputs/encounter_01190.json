{
  "schema_version": "1.0",
  "encounter_id": "01190",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.05,
      "end_seconds": 5.08,
      "duration_seconds": 4.03,
      "text": "Oh, sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 11.57,
      "duration_seconds": 4.88,
      "text": "Right, that's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.53,
      "end_seconds": 19.71,
      "duration_seconds": 7.18,
      "text": "right, hello, doctor i hope it's alright if I stay in for this"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.64,
      "end_seconds": 27.83,
      "duration_seconds": 6.19,
      "text": "it's nausea i thought I'd wait, but it it hasn't gone"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.13,
      "end_seconds": 32.85,
      "duration_seconds": 3.72,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.13,
      "end_seconds": 44.65,
      "duration_seconds": 10.52,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.9,
      "end_seconds": 48.77,
      "duration_seconds": 3.87,
      "text": "Hm, okay. How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.32,
      "end_seconds": 55.06,
      "duration_seconds": 1.74,
      "text": "Mild, I'd say."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.81,
      "end_seconds": 60.7,
      "duration_seconds": 4.89,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.51,
      "end_seconds": 70.82,
      "duration_seconds": 8.31,
      "text": "It's a few times a day. I've also been feeling dehydrated, for about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.31,
      "end_seconds": 75.22,
      "duration_seconds": 2.91,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.78,
      "end_seconds": 82.93,
      "duration_seconds": 6.15,
      "text": "well, it's... hard to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.03,
      "end_seconds": 89.93,
      "duration_seconds": 5.9,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.33,
      "end_seconds": 92.84,
      "duration_seconds": 1.51,
      "text": "it's moderate, honestly"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 94.59,
      "end_seconds": 97.4,
      "duration_seconds": 2.81,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.13,
      "end_seconds": 100.71,
      "duration_seconds": 2.58,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.68,
      "end_seconds": 107.31,
      "duration_seconds": 5.63,
      "text": "I had a wisdom tooth extraction under sedation five years ago."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.23,
      "end_seconds": 110.38,
      "duration_seconds": 2.15,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.25,
      "end_seconds": 115.44,
      "duration_seconds": 4.19,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.19,
      "end_seconds": 117.85,
      "duration_seconds": 1.66,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.07,
      "end_seconds": 121.52,
      "duration_seconds": 2.45,
      "text": "My partner and our baby"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.62,
      "end_seconds": 126.89,
      "duration_seconds": 4.27,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 128.54,
      "end_seconds": 142.46,
      "duration_seconds": 13.92,
      "text": "it's lisinopril, 10 milligrams, once a day, doctor. Right, she is on paracetamol, 650 milligrams, when needed, I give it to her. She takes ORS, after each loose stool"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.84,
      "end_seconds": 143.54,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.8,
      "end_seconds": 149.85,
      "duration_seconds": 5.05,
      "text": "I was on hydrochlorothiazide before i stopped taking it"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.14,
      "end_seconds": 157.64,
      "duration_seconds": 3.5,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.5,
      "end_seconds": 161.94,
      "duration_seconds": 2.44,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.74,
      "end_seconds": 166.82,
      "duration_seconds": 1.08,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.42,
      "end_seconds": 170.59,
      "duration_seconds": 2.17,
      "text": "I've had depression, yes"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.9,
      "end_seconds": 177.3,
      "duration_seconds": 1.4,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.94,
      "end_seconds": 182.95,
      "duration_seconds": 4.01,
      "text": "Arthritis in my knees, for two years"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.96,
      "end_seconds": 196.22,
      "duration_seconds": 11.26,
      "text": "Okay, I can see depression and arthritis in your knees in your file as well. A few quick ones: black stools, vomiting blood or severe abdominal pain?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.15,
      "end_seconds": 211.21,
      "duration_seconds": 13.06,
      "text": "no, no black stools, no vomiting blood, no severe abdominal pain i did have watery diarrhoea at one point, but that went away on its own"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.13,
      "end_seconds": 217.44,
      "duration_seconds": 4.31,
      "text": "a few quick ones: dizziness or blood in the stool?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.7,
      "end_seconds": 221.62,
      "duration_seconds": 2.92,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.18,
      "end_seconds": 226.9,
      "duration_seconds": 1.72,
      "text": "how's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.48,
      "end_seconds": 229.55,
      "duration_seconds": 1.07,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 230.6,
      "end_seconds": 237.79,
      "duration_seconds": 7.19,
      "text": "Okay, so the vitals from earlier. Heart rate 100, saturation 97 percent, BP is 124 over 75."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.03,
      "end_seconds": 240.08,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.84,
      "end_seconds": 245.68,
      "duration_seconds": 2.84,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.92,
      "end_seconds": 248.29,
      "duration_seconds": 1.37,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.93,
      "end_seconds": 265.91,
      "duration_seconds": 6.98,
      "text": "your mouth is a bit dry and your tummy is soft with mild tenderness all over"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.81,
      "end_seconds": 274.37,
      "duration_seconds": 2.56,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.81,
      "end_seconds": 302.75,
      "duration_seconds": 15.94,
      "text": "Okay, so my impression is this: I'm honestly not certain yet. It could be infective gastroenteritis, likely after recent travel, or it might be a parasitic infection. I'd also keep food poisoning in mind."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.4,
      "end_seconds": 347.78,
      "duration_seconds": 26.38,
      "text": "let's book blood tests to look into dehydration. It's a routine test and it'll give us a much clearer picture. A stool test is what I'd like next, for diarrhoea. Small sips often are better than large drinks, and eat plain food as soon as you can. Come back after the stool result. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 349.67,
      "end_seconds": 352.43,
      "duration_seconds": 2.76,
      "text": "That's clear, you know, thanks."
    }
  ]
}