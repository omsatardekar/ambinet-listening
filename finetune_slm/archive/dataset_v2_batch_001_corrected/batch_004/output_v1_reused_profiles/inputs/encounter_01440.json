{
  "schema_version": "1.0",
  "encounter_id": "01440",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.16,
      "end_seconds": 7.53,
      "duration_seconds": 6.37,
      "text": "Doctor, I've checked them in and done the preliminary measurements, I'll hand them over when you ask."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.08,
      "end_seconds": 14.32,
      "duration_seconds": 5.24,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 15.06,
      "end_seconds": 18.28,
      "duration_seconds": 3.22,
      "text": "I've been dealing with a dry cough."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 19.29,
      "end_seconds": 29.17,
      "duration_seconds": 9.88,
      "text": "Here are the numbers, doctor. Respiratory rate 20, pulse 97, temperature is 36.7 degrees, oxygen saturation is 93 percent, pressure 119 over 83."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.49,
      "end_seconds": 35.57,
      "duration_seconds": 5.08,
      "text": "Good, thank you. Alright, how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 37.22,
      "end_seconds": 39.9,
      "duration_seconds": 2.68,
      "text": "For ten days, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.37,
      "end_seconds": 44.62,
      "duration_seconds": 3.25,
      "text": "Okay, how troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.09,
      "end_seconds": 56.85,
      "duration_seconds": 10.76,
      "text": "It's moderate, honestly. I've had a high temperature too, for about four days. With high temperature, only paracetamol, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.98,
      "end_seconds": 64.94,
      "duration_seconds": 6.96,
      "text": "Okay, have you had a dry cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.74,
      "end_seconds": 74.22,
      "duration_seconds": 6.48,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.54,
      "end_seconds": 84.66,
      "duration_seconds": 4.12,
      "text": "Any leg swelling, vomiting, chest pain or confusion at all?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.03,
      "end_seconds": 92.2,
      "duration_seconds": 6.17,
      "text": "I haven't had leg swelling, vomiting, chest pain or confusion, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.07,
      "end_seconds": 97.04,
      "duration_seconds": 3.97,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.09,
      "end_seconds": 100.5,
      "duration_seconds": 1.41,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.63,
      "end_seconds": 106.13,
      "duration_seconds": 4.5,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.09,
      "end_seconds": 110.1,
      "duration_seconds": 3.01,
      "text": "No, you know, all normal there."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.65,
      "end_seconds": 113.08,
      "duration_seconds": 2.43,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 115.02,
      "end_seconds": 118.74,
      "duration_seconds": 3.72,
      "text": "I have diabetes, for about ten years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.31,
      "end_seconds": 120.01,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.5,
      "end_seconds": 135.16,
      "duration_seconds": 2.66,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 141.35,
      "end_seconds": 147.29,
      "duration_seconds": 5.94,
      "text": "Sorry, what was I saying, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.97,
      "end_seconds": 160.78,
      "duration_seconds": 2.81,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 161.52,
      "end_seconds": 169.94,
      "duration_seconds": 8.42,
      "text": "It's glimepiride, 2 milligrams, before breakfast. It's Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.3,
      "end_seconds": 178.2,
      "duration_seconds": 2.9,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.64,
      "end_seconds": 187.53,
      "duration_seconds": 3.89,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.96,
      "end_seconds": 192.33,
      "duration_seconds": 3.37,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 193.63,
      "end_seconds": 198.7,
      "duration_seconds": 5.07,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 203.33,
      "duration_seconds": 2.73,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 205.29,
      "end_seconds": 208.13,
      "duration_seconds": 2.84,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.04,
      "end_seconds": 217.43,
      "duration_seconds": 3.39,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 218.8,
      "end_seconds": 221.07,
      "duration_seconds": 2.27,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.04,
      "end_seconds": 227.0,
      "duration_seconds": 2.96,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.36,
      "end_seconds": 229.62,
      "duration_seconds": 1.26,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.91,
      "end_seconds": 247.17,
      "duration_seconds": 9.26,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.14,
      "end_seconds": 255.22,
      "duration_seconds": 3.08,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.31,
      "end_seconds": 289.23,
      "duration_seconds": 16.92,
      "text": "So where does that leave us? I think we're dealing with a viral chest infection with mildly low oxygen at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 290.96,
      "end_seconds": 292.47,
      "duration_seconds": 1.51,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.33,
      "end_seconds": 324.48,
      "duration_seconds": 31.15,
      "text": "Nothing I've seen today points to an emergency. It looks like a viral chest infection with mildly low oxygen, but I'd like to confirm. I think a viral swab makes sense here, for fever and cough. We should do a chest X-ray for low oxygen and crackles. Rest, keep your fluids up and lie on your tummy or side to help your breathing. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 325.48,
      "end_seconds": 329.34,
      "duration_seconds": 3.86,
      "text": "Right, okay, that makes sense. Thanks for explaining."
    }
  ]
}