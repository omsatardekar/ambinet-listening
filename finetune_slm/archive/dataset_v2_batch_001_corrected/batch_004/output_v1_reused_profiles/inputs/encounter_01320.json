{
  "schema_version": "1.0",
  "encounter_id": "01320",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.32,
      "end_seconds": 8.59,
      "duration_seconds": 7.27,
      "text": "Hello doctor, uh, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.69,
      "end_seconds": 15.75,
      "duration_seconds": 5.06,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.81,
      "end_seconds": 24.81,
      "duration_seconds": 8.0,
      "text": "Honestly, it's extra hair on my chin, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.56,
      "end_seconds": 28.33,
      "duration_seconds": 2.77,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.2,
      "end_seconds": 41.34,
      "duration_seconds": 12.14,
      "text": "It's been going on for three weeks. I took the morning off to come in today. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.82,
      "end_seconds": 45.13,
      "duration_seconds": 2.31,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.67,
      "end_seconds": 52.24,
      "duration_seconds": 5.57,
      "text": "Spots on my face goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.75,
      "end_seconds": 55.7,
      "duration_seconds": 1.95,
      "text": "Have you had irregular periods?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.84,
      "end_seconds": 69.13,
      "duration_seconds": 12.29,
      "text": "Yes, I have. The spots on my face? That's been for two months. As for spots on my face, face wash helps a bit."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.16,
      "end_seconds": 77.12,
      "duration_seconds": 6.96,
      "text": "Let me check a few things. Any being pregnant, headaches with vision changes or heavy bleeding?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.2,
      "end_seconds": 81.76,
      "duration_seconds": 2.56,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.87,
      "end_seconds": 86.4,
      "duration_seconds": 3.53,
      "text": "Have you noticed pelvic pain or breast discharge?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.82,
      "end_seconds": 92.24,
      "duration_seconds": 4.42,
      "text": "No pelvic pain or breast discharge, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.29,
      "end_seconds": 97.29,
      "duration_seconds": 3.0,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.52,
      "end_seconds": 99.89,
      "duration_seconds": 1.37,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.47,
      "end_seconds": 117.37,
      "duration_seconds": 3.9,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.67,
      "end_seconds": 133.34,
      "duration_seconds": 14.67,
      "text": "I've had anxiety for five years now. I wasn't sure whether to come in at all, to be honest. I didn't want to make a fuss, you know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.75,
      "end_seconds": 135.56,
      "duration_seconds": 0.81,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.05,
      "end_seconds": 145.59,
      "duration_seconds": 2.54,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.85,
      "end_seconds": 149.38,
      "duration_seconds": 2.53,
      "text": "Yes, kiwi. I get hives."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.35,
      "end_seconds": 154.64,
      "duration_seconds": 4.29,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.2,
      "end_seconds": 164.18,
      "duration_seconds": 7.98,
      "text": "Escitalopram, 10 milligrams, once a day. I do miss it now and then, to be fair."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.93,
      "end_seconds": 182.37,
      "duration_seconds": 2.44,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.73,
      "end_seconds": 190.36,
      "duration_seconds": 3.63,
      "text": "I had a varicose vein procedure last year."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.02,
      "end_seconds": 192.29,
      "duration_seconds": 1.27,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.81,
      "end_seconds": 197.0,
      "duration_seconds": 3.19,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.99,
      "end_seconds": 199.65,
      "duration_seconds": 1.66,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.98,
      "end_seconds": 205.24,
      "duration_seconds": 4.26,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.77,
      "end_seconds": 208.61,
      "duration_seconds": 1.84,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.23,
      "end_seconds": 212.0,
      "duration_seconds": 2.77,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.51,
      "end_seconds": 217.6,
      "duration_seconds": 4.09,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.35,
      "end_seconds": 227.79,
      "duration_seconds": 2.44,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.71,
      "end_seconds": 256.17,
      "duration_seconds": 8.46,
      "text": "Okay: pulse is 69 beats a minute, pressure 128 over 79, temperature is 36.9 degrees. And saturation 98 percent."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.56,
      "end_seconds": 258.94,
      "duration_seconds": 1.38,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.89,
      "end_seconds": 264.26,
      "duration_seconds": 4.37,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.87,
      "end_seconds": 270.27,
      "duration_seconds": 4.4,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.18,
      "end_seconds": 272.95,
      "duration_seconds": 1.77,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.87,
      "end_seconds": 276.26,
      "duration_seconds": 1.39,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.06,
      "end_seconds": 291.98,
      "duration_seconds": 7.92,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.02,
      "end_seconds": 312.42,
      "duration_seconds": 18.4,
      "text": "Please sit back down. So where does that leave us? I'd lean towards a pattern that fits polycystic ovary syndrome. I can't rule out raised prolactin yet. I think a pelvic ultrasound makes sense here, for irregular periods."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 313.73,
      "end_seconds": 317.53,
      "duration_seconds": 3.8,
      "text": "I can book that for Thursday at 9 am."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.65,
      "end_seconds": 323.83,
      "duration_seconds": 5.18,
      "text": "I think a thyroid test makes sense here, for weight gain."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 325.14,
      "end_seconds": 326.67,
      "duration_seconds": 1.53,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.46,
      "end_seconds": 359.35,
      "duration_seconds": 30.89,
      "text": "I'd like you to take metformin, 500 milligrams, once a day with food, for three months. That should help with cycle regulation and weight. I'll put all of this in writing so you don't have to remember it. Regular exercise and a small weight loss can make cycles more regular. Come back or go to emergency straight away if you get very heavy bleeding or severe pelvic pain. Let's review you after the scan."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.96,
      "end_seconds": 363.89,
      "duration_seconds": 3.93,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.76,
      "end_seconds": 367.79,
      "duration_seconds": 2.03,
      "text": "Thank you, that's helpful."
    }
  ]
}