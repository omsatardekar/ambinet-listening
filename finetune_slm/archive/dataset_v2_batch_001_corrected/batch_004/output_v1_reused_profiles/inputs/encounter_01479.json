{
  "schema_version": "1.0",
  "encounter_id": "01479",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.91,
      "end_seconds": 6.56,
      "duration_seconds": 5.65,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.92,
      "end_seconds": 15.7,
      "duration_seconds": 3.78,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.55,
      "end_seconds": 24.3,
      "duration_seconds": 6.75,
      "text": "Honestly, it's pain in my lower back, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.32,
      "end_seconds": 30.0,
      "duration_seconds": 1.68,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.96,
      "end_seconds": 34.47,
      "duration_seconds": 2.51,
      "text": "probably nearly five years yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.49,
      "end_seconds": 41.08,
      "duration_seconds": 5.59,
      "text": "Is it it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.22,
      "end_seconds": 46.86,
      "duration_seconds": 4.64,
      "text": "It, It happens once or twice a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.69,
      "end_seconds": 51.99,
      "duration_seconds": 3.3,
      "text": "so, how strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.56,
      "end_seconds": 56.93,
      "duration_seconds": 4.37,
      "text": "I'd give it a seven, out of ten"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.53,
      "end_seconds": 64.83,
      "duration_seconds": 2.3,
      "text": "is anything making it worse?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.43,
      "end_seconds": 73.37,
      "duration_seconds": 6.94,
      "text": "it's worse with lifting and bending i've also been feeling unsteady, for two months"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.73,
      "end_seconds": 77.89,
      "duration_seconds": 3.16,
      "text": "A few quick ones: fever or weight loss?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.77,
      "end_seconds": 87.01,
      "duration_seconds": 4.24,
      "text": "No fever or weight loss, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.65,
      "end_seconds": 92.59,
      "duration_seconds": 4.94,
      "text": "Have you noticed chest pain, night pain or bladder problems?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.62,
      "end_seconds": 96.02,
      "duration_seconds": 2.4,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.29,
      "end_seconds": 99.48,
      "duration_seconds": 2.19,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.26,
      "end_seconds": 103.42,
      "duration_seconds": 2.16,
      "text": "no, skin's been fine"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.92,
      "end_seconds": 110.69,
      "duration_seconds": 2.77,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.41,
      "end_seconds": 116.57,
      "duration_seconds": 4.16,
      "text": "I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.45,
      "end_seconds": 127.77,
      "duration_seconds": 2.32,
      "text": "let's run through your medicines"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.85,
      "end_seconds": 133.92,
      "duration_seconds": 4.07,
      "text": "I'm on Eltroxin, every morning for my thyroid."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.84,
      "end_seconds": 140.8,
      "duration_seconds": 1.96,
      "text": "do you know the dose?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.56,
      "end_seconds": 151.64,
      "duration_seconds": 9.08,
      "text": "100 micrograms, I think that's what's on the box. It's alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.51,
      "end_seconds": 154.95,
      "duration_seconds": 2.44,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.22,
      "end_seconds": 157.72,
      "duration_seconds": 1.5,
      "text": "it's 70 milligrams"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.32,
      "end_seconds": 160.37,
      "duration_seconds": 2.05,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.93,
      "end_seconds": 169.06,
      "duration_seconds": 7.13,
      "text": "For about a year. It's something called rosu... rosuvastatin, 10 milligrams, maybe, at night."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.4,
      "end_seconds": 175.13,
      "duration_seconds": 4.73,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.51,
      "end_seconds": 179.44,
      "duration_seconds": 2.93,
      "text": "No, uh, it's at home."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.08,
      "end_seconds": 201.22,
      "duration_seconds": 3.14,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.19,
      "end_seconds": 205.32,
      "duration_seconds": 3.13,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.34,
      "end_seconds": 209.21,
      "duration_seconds": 2.87,
      "text": "right, do you work outside the home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.26,
      "end_seconds": 214.47,
      "duration_seconds": 4.21,
      "text": "I'm a hairdresser, on my feet all day"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.8,
      "end_seconds": 219.69,
      "duration_seconds": 3.89,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.21,
      "end_seconds": 225.08,
      "duration_seconds": 3.87,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.97,
      "end_seconds": 228.61,
      "duration_seconds": 2.64,
      "text": "do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.37,
      "end_seconds": 233.25,
      "duration_seconds": 2.88,
      "text": "I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.7,
      "end_seconds": 236.46,
      "duration_seconds": 1.76,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 237.04,
      "end_seconds": 244.24,
      "duration_seconds": 7.2,
      "text": "Thin bones, for nearly five years i've had high cholesterol for about a year now"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.59,
      "end_seconds": 255.0,
      "duration_seconds": 9.41,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.82,
      "end_seconds": 268.03,
      "duration_seconds": 2.21,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.43,
      "end_seconds": 294.36,
      "duration_seconds": 12.93,
      "text": "okay: heart rate 64, weight 97 kilos, BMI works out to 30.6, height 178 centimetres, pressure 113 over 69, temperature is 36.6 degrees"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.26,
      "end_seconds": 299.64,
      "duration_seconds": 2.38,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.24,
      "end_seconds": 303.85,
      "duration_seconds": 2.61,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.98,
      "end_seconds": 322.87,
      "duration_seconds": 6.89,
      "text": "There is tenderness over the mid lower spine and no weakness in the legs."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.21,
      "end_seconds": 327.27,
      "duration_seconds": 2.06,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.99,
      "end_seconds": 370.37,
      "duration_seconds": 34.38,
      "text": "right, here's what I'm thinking. It points towards thin bones with a fragility fracture and back pain. I want a bone density scan done, that's for fracture risk. I think a spine X-ray makes sense here, for back pain. Take the weekly tablet first thing with a full glass of water and stay upright for half an hour. Don't skip meals, and try to eat smaller portions more often through the day"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.83,
      "end_seconds": 388.49,
      "duration_seconds": 16.66,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so so we can settle the dose. One warning sign to remember: you have new weakness or numbness in your legs. In that case don't wait"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.07,
      "end_seconds": 390.88,
      "duration_seconds": 1.81,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 391.73,
      "end_seconds": 397.26,
      "duration_seconds": 5.53,
      "text": "I'll want another look in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 399.34,
      "end_seconds": 403.17,
      "duration_seconds": 3.83,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}