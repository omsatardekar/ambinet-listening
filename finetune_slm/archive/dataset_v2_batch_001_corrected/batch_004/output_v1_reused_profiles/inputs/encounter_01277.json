{
  "schema_version": "1.0",
  "encounter_id": "01277",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.72,
      "duration_seconds": 4.39,
      "text": "Hi doctor, you know, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.45,
      "end_seconds": 10.78,
      "duration_seconds": 4.33,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.31,
      "end_seconds": 17.28,
      "duration_seconds": 5.97,
      "text": "I wanted to get pain in the neck and shoulders looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.88,
      "end_seconds": 21.01,
      "duration_seconds": 3.13,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.13,
      "end_seconds": 23.94,
      "duration_seconds": 1.81,
      "text": "probably six months yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.41,
      "end_seconds": 35.38,
      "duration_seconds": 10.97,
      "text": "Yes, carry on. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.28,
      "end_seconds": 39.35,
      "duration_seconds": 3.07,
      "text": "Mostly mild. It comes and goes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.3,
      "end_seconds": 42.33,
      "duration_seconds": 2.03,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.29,
      "end_seconds": 50.4,
      "duration_seconds": 7.11,
      "text": "Let me think, when it starts I tend to get irritability as well."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.39,
      "end_seconds": 53.67,
      "duration_seconds": 2.28,
      "text": "Any tired eyes as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.66,
      "end_seconds": 63.62,
      "duration_seconds": 7.96,
      "text": "yes, for about a year oh, with tired eyes, pretty moderate, if I'm being honest"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.92,
      "end_seconds": 67.09,
      "duration_seconds": 2.17,
      "text": "Any trouble sleeping as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.28,
      "end_seconds": 74.06,
      "duration_seconds": 5.78,
      "text": "Yes, for nearly five years. The irritability? That's been for two years."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 74.86,
      "end_seconds": 82.35,
      "duration_seconds": 7.49,
      "text": "doctor, I've got the readings for you. BP is 125 over 69, temperature is 36.5 degrees, pulse 72."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.22,
      "end_seconds": 84.19,
      "duration_seconds": 0.97,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.72,
      "end_seconds": 87.94,
      "duration_seconds": 2.22,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.35,
      "end_seconds": 94.27,
      "duration_seconds": 0.92,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.45,
      "end_seconds": 98.38,
      "duration_seconds": 2.93,
      "text": "Alright, take a deep breath for me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.33,
      "end_seconds": 116.34,
      "duration_seconds": 3.01,
      "text": "your eye movements and reflexes are normal"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.32,
      "end_seconds": 118.51,
      "duration_seconds": 1.19,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.45,
      "end_seconds": 142.52,
      "duration_seconds": 5.07,
      "text": "The muscles at the back of your neck are tight and tender."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.43,
      "end_seconds": 149.21,
      "duration_seconds": 2.78,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.56,
      "end_seconds": 161.9,
      "duration_seconds": 4.34,
      "text": "Any jaw pain when chewing, blurred vision, fever or numbness?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.02,
      "end_seconds": 170.13,
      "duration_seconds": 7.11,
      "text": "no jaw pain when chewing, blurred vision, fever or numbness, none of it it"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.53,
      "end_seconds": 173.44,
      "duration_seconds": 2.91,
      "text": "ah. Have you had any vomiting?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.56,
      "end_seconds": 176.08,
      "duration_seconds": 1.52,
      "text": "Nope, no vomiting."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.64,
      "end_seconds": 181.74,
      "duration_seconds": 4.1,
      "text": "what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.07,
      "end_seconds": 185.52,
      "duration_seconds": 2.45,
      "text": "Bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.95,
      "end_seconds": 191.94,
      "duration_seconds": 4.99,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.22,
      "end_seconds": 209.08,
      "duration_seconds": 15.86,
      "text": "I quit smoking around ten years ago. I'll have a glass of wine with dinner. Lots of rice, lentils and some fruit. No, I share a house with my brother"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.74,
      "end_seconds": 221.94,
      "duration_seconds": 4.2,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.46,
      "end_seconds": 241.33,
      "duration_seconds": 16.87,
      "text": "Escitalopram, 10 milligrams, once a day for the anxiety though honestly, some days I forget to take it. Ramipril i take it 5 milligrams, every morning for my blood pressure"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 242.62,
      "end_seconds": 247.59,
      "duration_seconds": 4.97,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.62,
      "end_seconds": 253.29,
      "duration_seconds": 4.67,
      "text": "right. Do you happen to have the the current prescription here?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.45,
      "end_seconds": 261.32,
      "duration_seconds": 5.87,
      "text": "Not with me. I'll bring it next time. It's Combiflam, most days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.19,
      "end_seconds": 265.29,
      "duration_seconds": 2.1,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.94,
      "end_seconds": 270.76,
      "duration_seconds": 3.82,
      "text": "Yes, anxiety. I have high blood pressure."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.56,
      "end_seconds": 282.93,
      "duration_seconds": 11.37,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today. Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.78,
      "end_seconds": 289.0,
      "duration_seconds": 4.22,
      "text": "Yes, tramadol, it gives me feeling very drowsy."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.44,
      "end_seconds": 298.23,
      "duration_seconds": 4.79,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.16,
      "end_seconds": 304.16,
      "duration_seconds": 5.0,
      "text": "My mother has an underactive thyroid. My mother had a stroke."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.49,
      "end_seconds": 313.85,
      "duration_seconds": 2.36,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 315.01,
      "end_seconds": 321.63,
      "duration_seconds": 6.62,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.4,
      "end_seconds": 340.95,
      "duration_seconds": 17.55,
      "text": "what I'm giving you is amitriptyline, 10 milligrams, at night, for six weeks that should help with headache prevention and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.64,
      "end_seconds": 344.3,
      "duration_seconds": 1.66,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.21,
      "end_seconds": 351.98,
      "duration_seconds": 6.77,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 352.87,
      "end_seconds": 359.36,
      "duration_seconds": 6.49,
      "text": "So, I take the amitriptyline, 10 milligrams, at night. Is that right?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.95,
      "end_seconds": 365.72,
      "duration_seconds": 5.77,
      "text": "Yes, exactly right. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 367.46,
      "end_seconds": 369.02,
      "duration_seconds": 1.56,
      "text": "that's clear, thanks"
    }
  ]
}