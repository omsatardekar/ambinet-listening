{
  "schema_version": "1.0",
  "encounter_id": "01079",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 4.6,
      "duration_seconds": 3.48,
      "text": "Okay, good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.48,
      "end_seconds": 7.66,
      "duration_seconds": 1.18,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.37,
      "end_seconds": 12.35,
      "duration_seconds": 2.98,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.17,
      "end_seconds": 23.2,
      "duration_seconds": 9.03,
      "text": "Erm, mainly an itchy rash. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.87,
      "end_seconds": 27.21,
      "duration_seconds": 3.34,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.9,
      "end_seconds": 31.82,
      "duration_seconds": 2.92,
      "text": "It's been three days now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.21,
      "end_seconds": 36.08,
      "duration_seconds": 2.87,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.36,
      "end_seconds": 61.72,
      "duration_seconds": 20.36,
      "text": "Pretty mild, if I'm being honest. As for redness, I honestly can't say when that began. It might have been last month or the month before. Dry, scaly patches was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.91,
      "end_seconds": 76.7,
      "duration_seconds": 4.79,
      "text": "Did you get joint pain, new soap or detergent or oozing?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.91,
      "end_seconds": 80.67,
      "duration_seconds": 2.76,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.2,
      "end_seconds": 85.58,
      "duration_seconds": 3.38,
      "text": "A few quick ones: breathing trouble or fever?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.87,
      "end_seconds": 94.88,
      "duration_seconds": 5.01,
      "text": "I haven't had breathing trouble or fever, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.45,
      "end_seconds": 102.86,
      "duration_seconds": 2.41,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.5,
      "end_seconds": 108.29,
      "duration_seconds": 4.79,
      "text": "Um, that's normal as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.03,
      "end_seconds": 112.17,
      "duration_seconds": 3.14,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.05,
      "end_seconds": 121.34,
      "duration_seconds": 7.29,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.67,
      "end_seconds": 129.04,
      "duration_seconds": 2.37,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.47,
      "end_seconds": 136.64,
      "duration_seconds": 6.17,
      "text": "Seretide inhaler. I take it twice a day for my asthma."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.84,
      "end_seconds": 140.79,
      "duration_seconds": 2.95,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.84,
      "end_seconds": 143.31,
      "duration_seconds": 1.47,
      "text": "Two years now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.06,
      "end_seconds": 148.82,
      "duration_seconds": 4.76,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.17,
      "end_seconds": 162.61,
      "duration_seconds": 12.44,
      "text": "My husband and I live above the shop. I'm a bus driver, so I sit for long hours. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.13,
      "end_seconds": 166.79,
      "duration_seconds": 3.66,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.87,
      "end_seconds": 177.96,
      "duration_seconds": 5.09,
      "text": "So, yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.52,
      "end_seconds": 196.7,
      "duration_seconds": 2.18,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 198.0,
      "end_seconds": 210.27,
      "duration_seconds": 12.27,
      "text": "I have asthma, for about ten years. Work has been very busy so I kept ignoring it. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.89,
      "end_seconds": 219.86,
      "duration_seconds": 8.97,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.23,
      "end_seconds": 229.21,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.94,
      "end_seconds": 252.86,
      "duration_seconds": 9.92,
      "text": "Okay: respiratory rate 17, heart rate 72, temperature is 36.6 degrees. And saturation 98 percent, pressure 125 over 82."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.16,
      "end_seconds": 255.79,
      "duration_seconds": 1.63,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 257.69,
      "end_seconds": 260.96,
      "duration_seconds": 3.27,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 262.17,
      "end_seconds": 266.61,
      "duration_seconds": 4.44,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.45,
      "end_seconds": 269.12,
      "duration_seconds": 1.67,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.87,
      "end_seconds": 272.87,
      "duration_seconds": 2.0,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.86,
      "end_seconds": 290.74,
      "duration_seconds": 5.88,
      "text": "There are dry red patches in the creases of both elbows with scratch marks."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.24,
      "end_seconds": 293.88,
      "duration_seconds": 1.64,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.68,
      "end_seconds": 312.21,
      "duration_seconds": 12.53,
      "text": "Good, you can sit up again. Okay, so my impression is this: I can't pin this down yet. We're looking at an eczema flare-up or contact dermatitis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 313.1,
      "end_seconds": 317.18,
      "duration_seconds": 4.08,
      "text": "Okay, so what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.74,
      "end_seconds": 326.07,
      "duration_seconds": 8.33,
      "text": "I understand the worry. At the moment I'd say it's an eczema flare-up, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.43,
      "end_seconds": 356.46,
      "duration_seconds": 20.03,
      "text": "We'll begin with cetirizine, 10 milligrams, at night, for one week. You take it by mouth. That should help with itching. Moisturise right after a bath, thick creams are better than lotions, and use a mild soap. Let's review you in three weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.12,
      "end_seconds": 361.19,
      "duration_seconds": 4.07,
      "text": "So, no, that's all. Thanks a lot."
    }
  ]
}