{
  "schema_version": "1.0",
  "encounter_id": "01388",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.27,
      "end_seconds": 4.41,
      "duration_seconds": 3.14,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.37,
      "end_seconds": 10.4,
      "duration_seconds": 4.03,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.43,
      "end_seconds": 19.37,
      "duration_seconds": 6.94,
      "text": "It's pressure in the face. I thought I'd wait, but it it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.22,
      "end_seconds": 23.91,
      "duration_seconds": 3.69,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.9,
      "end_seconds": 29.88,
      "duration_seconds": 1.98,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.17,
      "end_seconds": 33.0,
      "duration_seconds": 2.83,
      "text": "Yes. Is anything making it it worse?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.52,
      "end_seconds": 37.43,
      "duration_seconds": 3.91,
      "text": "Okay, so it's worse with bending forward."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.16,
      "end_seconds": 43.69,
      "duration_seconds": 4.53,
      "text": "Has there been thick yellow discharge from the nose too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.24,
      "end_seconds": 47.71,
      "duration_seconds": 3.47,
      "text": "Yes, about the same, two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.11,
      "end_seconds": 49.09,
      "duration_seconds": 0.98,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.31,
      "end_seconds": 60.1,
      "duration_seconds": 3.79,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.25,
      "end_seconds": 74.23,
      "duration_seconds": 1.98,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.06,
      "end_seconds": 108.55,
      "duration_seconds": 16.49,
      "text": "Okay: pressure 109 over 81, height 182 centimetres, weight 71 kilos, respiratory rate 18, temperature is 37.0 degrees, oxygen saturation is 98 percent, BMI works out to 21.4, pulse is 80 beats a minute."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.12,
      "end_seconds": 113.48,
      "duration_seconds": 2.36,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.96,
      "end_seconds": 116.33,
      "duration_seconds": 1.37,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.9,
      "end_seconds": 133.1,
      "duration_seconds": 5.2,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.08,
      "end_seconds": 136.1,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.49,
      "end_seconds": 155.52,
      "duration_seconds": 3.03,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.76,
      "end_seconds": 157.46,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.52,
      "end_seconds": 165.52,
      "duration_seconds": 3.0,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.89,
      "end_seconds": 188.96,
      "duration_seconds": 6.07,
      "text": "Let me check a few things. Any stiff neck, vision changes, ear pain or nosebleeds?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.65,
      "end_seconds": 192.46,
      "duration_seconds": 2.81,
      "text": "no, none that I've noticed"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.01,
      "end_seconds": 195.43,
      "duration_seconds": 1.42,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.14,
      "end_seconds": 197.76,
      "duration_seconds": 1.62,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.64,
      "end_seconds": 202.06,
      "duration_seconds": 3.42,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.97,
      "end_seconds": 207.93,
      "duration_seconds": 4.96,
      "text": "It's Seretide inhaler, twice a day for my asthma."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.42,
      "end_seconds": 214.55,
      "duration_seconds": 5.13,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 215.93,
      "end_seconds": 228.11,
      "duration_seconds": 12.18,
      "text": "I only drink at family occasions. I gave up cigarettes last spring. I do a yoga class on Thursdays. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.89,
      "end_seconds": 231.34,
      "duration_seconds": 2.45,
      "text": "do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.11,
      "end_seconds": 235.89,
      "duration_seconds": 3.78,
      "text": "I have asthma, for about a year."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.73,
      "end_seconds": 240.51,
      "duration_seconds": 3.78,
      "text": "Alright, asthma, that matches what I have here."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.31,
      "end_seconds": 260.39,
      "duration_seconds": 4.08,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.69,
      "end_seconds": 263.13,
      "duration_seconds": 1.44,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.04,
      "end_seconds": 309.22,
      "duration_seconds": 32.18,
      "text": "I'd like to arrange an X-ray of the sinuses for sinusitis. The treatment will be saline nasal spray, three times a day, for one week. That should help with nasal congestion. The pharmacy will go through the details again when you pick it up. Steam a couple of times a day and saline rinses will help clear things. Please come and see me if it's not better in a week. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.63,
      "end_seconds": 312.67,
      "duration_seconds": 2.04,
      "text": "Thank you, that's helpful."
    }
  ]
}