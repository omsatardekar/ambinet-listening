{
  "schema_version": "1.0",
  "encounter_id": "01311",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 3.69,
      "duration_seconds": 2.84,
      "text": "Hello, come in. Mind the step."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.42,
      "end_seconds": 5.64,
      "duration_seconds": 1.22,
      "text": "Evening, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.9,
      "end_seconds": 13.82,
      "duration_seconds": 3.92,
      "text": "Is this your first time with this clinic?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.15,
      "end_seconds": 21.83,
      "duration_seconds": 6.68,
      "text": "Mm, uh, first time with this one, yes. A friend recommended it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.32,
      "end_seconds": 25.27,
      "duration_seconds": 1.95,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.5,
      "end_seconds": 34.12,
      "duration_seconds": 7.62,
      "text": "It's a pounding headache. I thought I'd wait, you know, but it hasn't gone."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.93,
      "end_seconds": 38.81,
      "duration_seconds": 2.88,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.45,
      "end_seconds": 43.66,
      "duration_seconds": 4.21,
      "text": "It's been going on for about two weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.16,
      "end_seconds": 53.65,
      "duration_seconds": 8.49,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.58,
      "end_seconds": 59.74,
      "duration_seconds": 5.16,
      "text": "Honestly, a couple of times a week. I'd call it mild."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.8,
      "end_seconds": 63.59,
      "duration_seconds": 2.79,
      "text": "Any yellow eyes, confusion or rash?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.86,
      "end_seconds": 69.07,
      "duration_seconds": 4.21,
      "text": "No, no yellow eyes, confusion or rash."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.27,
      "end_seconds": 75.13,
      "duration_seconds": 5.86,
      "text": "Yes, carry on. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.87,
      "end_seconds": 82.83,
      "duration_seconds": 4.96,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.51,
      "end_seconds": 87.02,
      "duration_seconds": 3.51,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.86,
      "end_seconds": 89.44,
      "duration_seconds": 1.58,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.13,
      "end_seconds": 93.42,
      "duration_seconds": 3.29,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.23,
      "end_seconds": 107.99,
      "duration_seconds": 12.76,
      "text": "I smoke roughly a pack every two days. I swim twice a week. I live with my elderly mother. I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 109.71,
      "end_seconds": 112.09,
      "duration_seconds": 2.38,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.74,
      "end_seconds": 115.94,
      "duration_seconds": 3.2,
      "text": "Gliclazide, 80 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.29,
      "end_seconds": 120.49,
      "duration_seconds": 3.2,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 123.38,
      "duration_seconds": 1.2,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.64,
      "end_seconds": 131.05,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.89,
      "end_seconds": 134.8,
      "duration_seconds": 2.91,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 150.52,
      "end_seconds": 153.1,
      "duration_seconds": 2.58,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 154.16,
      "end_seconds": 160.01,
      "duration_seconds": 5.85,
      "text": "Yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.0,
      "end_seconds": 171.77,
      "duration_seconds": 3.77,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.47,
      "end_seconds": 187.87,
      "duration_seconds": 2.4,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.71,
      "end_seconds": 211.09,
      "duration_seconds": 10.38,
      "text": "Okay: saturation 95 percent, blood pressure 121 over 75. And respiratory rate 16, pulse is 103 beats a minute, temp 38.3 degrees."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.79,
      "end_seconds": 214.15,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.75,
      "end_seconds": 217.26,
      "duration_seconds": 2.51,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.81,
      "end_seconds": 222.47,
      "duration_seconds": 3.66,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.12,
      "end_seconds": 225.65,
      "duration_seconds": 1.53,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.65,
      "end_seconds": 229.99,
      "duration_seconds": 2.34,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.16,
      "end_seconds": 244.54,
      "duration_seconds": 5.38,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.97,
      "end_seconds": 249.79,
      "duration_seconds": 1.82,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.82,
      "end_seconds": 272.52,
      "duration_seconds": 8.7,
      "text": "Having listened and examined, it fits best with a fever after travel that must be treated as possible malaria."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.53,
      "end_seconds": 300.67,
      "duration_seconds": 20.14,
      "text": "I'm going to order blood tests, for fever. Avoid anti-inflammatory painkillers and keep drinking. Do get help quickly if you become confused or cannot keep fluids down. I'll want another look in two days. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.57,
      "end_seconds": 304.68,
      "duration_seconds": 3.11,
      "text": "I think I understand everything. Thanks."
    }
  ]
}