{
  "schema_version": "1.0",
  "encounter_id": "01250",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.85,
      "end_seconds": 5.44,
      "duration_seconds": 4.59,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.9,
      "end_seconds": 14.76,
      "duration_seconds": 3.86,
      "text": "Actually, hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.46,
      "end_seconds": 18.08,
      "duration_seconds": 1.62,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.34,
      "end_seconds": 27.27,
      "duration_seconds": 7.93,
      "text": "Mainly swelling of my lips. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 28.57,
      "end_seconds": 30.87,
      "duration_seconds": 2.3,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.92,
      "end_seconds": 42.7,
      "duration_seconds": 9.78,
      "text": "So, I'd say three days. Actually, no, closer to five days. There's a tingling mouth as well."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.65,
      "end_seconds": 59.73,
      "duration_seconds": 5.08,
      "text": "Let me check a few things. Any vomiting, trouble breathing or wheeze?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.65,
      "end_seconds": 64.6,
      "duration_seconds": 2.95,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.15,
      "end_seconds": 69.39,
      "duration_seconds": 4.24,
      "text": "Okay, go on. Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.56,
      "end_seconds": 72.05,
      "duration_seconds": 1.49,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.46,
      "end_seconds": 77.33,
      "duration_seconds": 3.87,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 81.68,
      "end_seconds": 83.6,
      "duration_seconds": 1.92,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.95,
      "end_seconds": 95.48,
      "duration_seconds": 2.53,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 97.12,
      "end_seconds": 99.64,
      "duration_seconds": 2.52,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.39,
      "end_seconds": 105.28,
      "duration_seconds": 3.89,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.62,
      "end_seconds": 110.07,
      "duration_seconds": 3.45,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.89,
      "end_seconds": 113.51,
      "duration_seconds": 2.62,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.91,
      "end_seconds": 117.8,
      "duration_seconds": 2.89,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 119.16,
      "end_seconds": 121.64,
      "duration_seconds": 2.48,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.87,
      "end_seconds": 125.03,
      "duration_seconds": 2.16,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.61,
      "end_seconds": 127.59,
      "duration_seconds": 1.98,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.53,
      "end_seconds": 133.35,
      "duration_seconds": 3.82,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.33,
      "end_seconds": 137.73,
      "duration_seconds": 2.4,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 138.28,
      "end_seconds": 144.43,
      "duration_seconds": 6.15,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.39,
      "end_seconds": 159.87,
      "duration_seconds": 2.48,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.04,
      "end_seconds": 173.61,
      "duration_seconds": 2.57,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.09,
      "end_seconds": 202.72,
      "duration_seconds": 9.63,
      "text": "Okay: height 150 centimetres, saturation 98 percent. And heart rate 64, weight 52 kilos, temp 36.5 degrees, blood pressure 110 over 81."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.64,
      "end_seconds": 209.63,
      "duration_seconds": 3.99,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 210.84,
      "end_seconds": 212.55,
      "duration_seconds": 1.71,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.39,
      "end_seconds": 216.61,
      "duration_seconds": 2.22,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.2,
      "end_seconds": 234.12,
      "duration_seconds": 9.92,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.34,
      "end_seconds": 248.17,
      "duration_seconds": 9.83,
      "text": "You can relax now. Taking everything into account, the most likely explanation is an allergic reaction, possibly to a recently started medicine."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.63,
      "end_seconds": 298.65,
      "duration_seconds": 34.02,
      "text": "You'll be taking chlorphenamine, 4 milligrams, every six hours, for three days. That should help with allergic rash. Stop the new tablet until we know what caused it and write down every medicine you took in the last week. Please take the tablets with food so they don't upset your stomach. One warning sign to remember: your throat tightens, your lips swell further or you get breathless. In that case don't wait."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 299.77,
      "end_seconds": 305.15,
      "duration_seconds": 5.38,
      "text": "I'll want another look after the review. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 306.12,
      "end_seconds": 307.72,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    }
  ]
}