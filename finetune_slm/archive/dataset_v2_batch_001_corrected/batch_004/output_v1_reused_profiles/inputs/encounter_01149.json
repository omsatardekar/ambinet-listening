{
  "schema_version": "1.0",
  "encounter_id": "01149",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.9,
      "end_seconds": 3.54,
      "duration_seconds": 2.64,
      "text": "so, hi, sit anywhere you like"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 4.87,
      "end_seconds": 12.39,
      "duration_seconds": 7.52,
      "text": "actually, doctor, I'll sit in if that's okay, I know what's been happening"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.28,
      "end_seconds": 16.82,
      "duration_seconds": 2.54,
      "text": "tell me what's brought you in"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.37,
      "end_seconds": 24.85,
      "duration_seconds": 7.48,
      "text": "I've, I've been passing urine a lot, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 26.24,
      "end_seconds": 29.8,
      "duration_seconds": 3.56,
      "text": "Which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.79,
      "end_seconds": 35.71,
      "duration_seconds": 4.92,
      "text": "Simvastatin. I take it 20 milligrams, at night."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 37.14,
      "end_seconds": 42.11,
      "duration_seconds": 4.97,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.57,
      "end_seconds": 47.82,
      "duration_seconds": 4.25,
      "text": "right do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 67.98,
      "duration_seconds": 18.92,
      "text": "Well, no, I left it at home. Glimepiride. I take it 2 milligrams, before breakfast for my sugar. I'd rather know what's going on than keep guessing. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.53,
      "end_seconds": 77.27,
      "duration_seconds": 3.74,
      "text": "can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 78.52,
      "end_seconds": 84.31,
      "duration_seconds": 5.79,
      "text": "Probably two months. Yeah. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.37,
      "end_seconds": 89.27,
      "duration_seconds": 2.9,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 89.83,
      "end_seconds": 94.78,
      "duration_seconds": 4.95,
      "text": "Oh, um, pretty mild, if I'm being honest."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 99.08,
      "duration_seconds": 2.37,
      "text": "Have you been feeling very thirsty?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 100.2,
      "end_seconds": 110.62,
      "duration_seconds": 10.42,
      "text": "Yeah. Six months, I'd say. I did have tingling in the feet at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.41,
      "end_seconds": 127.08,
      "duration_seconds": 3.67,
      "text": "Okay, and what about weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 128.28,
      "end_seconds": 130.83,
      "duration_seconds": 2.55,
      "text": "no, nothing to report there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.72,
      "end_seconds": 138.26,
      "duration_seconds": 6.54,
      "text": "Let me check a few things. Any abdominal pain, foot sores or chest pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.06,
      "end_seconds": 146.36,
      "duration_seconds": 6.3,
      "text": "No abdominal pain, foot sores or chest pain, none of it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.89,
      "end_seconds": 148.18,
      "duration_seconds": 1.29,
      "text": "nothing like fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.28,
      "end_seconds": 153.34,
      "duration_seconds": 4.06,
      "text": "Ah, no, I haven't had any fever."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 154.61,
      "end_seconds": 160.19,
      "duration_seconds": 5.58,
      "text": "Actually, doctor, I did notice fever. He doesn't always say."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.63,
      "end_seconds": 172.79,
      "duration_seconds": 7.16,
      "text": "no, I don't think I did maybe a little, I'm not sure"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.48,
      "end_seconds": 182.95,
      "duration_seconds": 9.47,
      "text": "Alright, I'll note both what you've said and what you've noticed. Okay, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.64,
      "end_seconds": 185.77,
      "duration_seconds": 2.13,
      "text": "no, joints are fine"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.17,
      "end_seconds": 193.49,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.44,
      "end_seconds": 197.57,
      "duration_seconds": 3.13,
      "text": "No, I've never reacted to anything."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.61,
      "end_seconds": 201.56,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 203.11,
      "end_seconds": 207.75,
      "duration_seconds": 4.64,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 208.77,
      "end_seconds": 212.07,
      "duration_seconds": 3.3,
      "text": "are you on your own at home?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 213.4,
      "end_seconds": 216.85,
      "duration_seconds": 3.45,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 218.63,
      "end_seconds": 223.02,
      "duration_seconds": 4.39,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 228.09,
      "end_seconds": 244.29,
      "duration_seconds": 16.2,
      "text": "Well, I've had high cholesterol for two years now. I mean, I have diabetes, for about ten years. I, I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 245.39,
      "end_seconds": 250.8,
      "duration_seconds": 5.41,
      "text": "Okay, I can see high cholesterol in your file as well."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.73,
      "end_seconds": 262.03,
      "duration_seconds": 3.3,
      "text": "Did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.76,
      "end_seconds": 268.06,
      "duration_seconds": 5.3,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.32,
      "end_seconds": 274.78,
      "duration_seconds": 3.46,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 275.71,
      "end_seconds": 277.94,
      "duration_seconds": 2.23,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 279.86,
      "end_seconds": 290.27,
      "duration_seconds": 10.41,
      "text": "here are the numbers, doctor oxygen saturation is 96 percent, pressure 168 over 96, heart rate 83, temperature is 36.5 degrees"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.98,
      "end_seconds": 292.02,
      "duration_seconds": 1.04,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.52,
      "end_seconds": 296.71,
      "duration_seconds": 2.19,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.07,
      "end_seconds": 299.29,
      "duration_seconds": 1.22,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 306.37,
      "end_seconds": 310.26,
      "duration_seconds": 3.89,
      "text": "Sensation to the monofilament is reduced on the right foot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.89,
      "end_seconds": 314.29,
      "duration_seconds": 2.4,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.84,
      "end_seconds": 338.71,
      "duration_seconds": 5.87,
      "text": "Your feet look fine, no ulcers or sores, and the pulses are palpable."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 343.93,
      "end_seconds": 346.54,
      "duration_seconds": 2.61,
      "text": "thank you, you can get dressed"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.89,
      "end_seconds": 374.76,
      "duration_seconds": 11.87,
      "text": "right, here's what I'm thinking this is probably diabetes that isn't well controlled another possibility is a urine infection let's book an HbA1c to look into diabetes control"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 376.01,
      "end_seconds": 377.23,
      "duration_seconds": 1.22,
      "text": "mm, alright"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 383.26,
      "end_seconds": 391.61,
      "duration_seconds": 8.35,
      "text": "and please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 393.02,
      "end_seconds": 394.9,
      "duration_seconds": 1.88,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.96,
      "end_seconds": 402.79,
      "duration_seconds": 6.83,
      "text": "come back after the results are back is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 403.88,
      "end_seconds": 407.42,
      "duration_seconds": 3.54,
      "text": "Erm, I think I understand everything. Thanks."
    }
  ]
}