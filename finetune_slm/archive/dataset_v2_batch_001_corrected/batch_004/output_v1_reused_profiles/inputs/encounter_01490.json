{
  "schema_version": "1.0",
  "encounter_id": "01490",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.94,
      "end_seconds": 6.64,
      "duration_seconds": 5.7,
      "text": "doctor, this one's ready for you everything's on the chart, but I'll go through it"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.3,
      "end_seconds": 13.48,
      "duration_seconds": 5.18,
      "text": "Thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.33,
      "end_seconds": 26.43,
      "duration_seconds": 12.1,
      "text": "Hello, doctor. I hope it's alright if I stay in for this. Doctor, uh, it's a missed period. That's what we're worried about."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.85,
      "end_seconds": 31.61,
      "duration_seconds": 3.76,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 33.24,
      "end_seconds": 36.74,
      "duration_seconds": 3.5,
      "text": "I've had it for about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.59,
      "end_seconds": 43.1,
      "duration_seconds": 4.51,
      "text": "what about nausea in the mornings, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 44.3,
      "end_seconds": 51.19,
      "duration_seconds": 6.89,
      "text": "Yes, about the same, four weeks. With nausea in the mornings, I'd say severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.21,
      "end_seconds": 57.08,
      "duration_seconds": 3.87,
      "text": "Have you been needing to pass urine more?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 57.98,
      "end_seconds": 59.68,
      "duration_seconds": 1.7,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.47,
      "end_seconds": 63.5,
      "duration_seconds": 3.03,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 64.97,
      "end_seconds": 66.35,
      "duration_seconds": 1.38,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 68.14,
      "end_seconds": 74.51,
      "duration_seconds": 6.37,
      "text": "I'm not sure that's right. I seem to recall a problem with amoxicillin."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 75.88,
      "end_seconds": 79.15,
      "duration_seconds": 3.27,
      "text": "Okay, so really? I don't think so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.84,
      "end_seconds": 88.97,
      "duration_seconds": 8.13,
      "text": "Alright, so so that's unclear. I'll record what each of you said. Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 91.01,
      "end_seconds": 92.61,
      "duration_seconds": 1.6,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.55,
      "end_seconds": 95.4,
      "duration_seconds": 0.85,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 96.93,
      "end_seconds": 99.18,
      "duration_seconds": 2.25,
      "text": "I've never touched a cigarette"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.69,
      "end_seconds": 102.58,
      "duration_seconds": 1.89,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 107.91,
      "end_seconds": 112.42,
      "duration_seconds": 4.51,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.44,
      "end_seconds": 120.26,
      "duration_seconds": 2.82,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 122.18,
      "end_seconds": 127.79,
      "duration_seconds": 5.61,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.39,
      "end_seconds": 129.75,
      "duration_seconds": 1.36,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 130.66,
      "end_seconds": 133.46,
      "duration_seconds": 2.8,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.87,
      "end_seconds": 137.27,
      "duration_seconds": 2.4,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 138.52,
      "end_seconds": 142.32,
      "duration_seconds": 3.8,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.64,
      "end_seconds": 163.49,
      "duration_seconds": 2.85,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 164.89,
      "end_seconds": 176.3,
      "duration_seconds": 11.41,
      "text": "An underactive thyroid, for about ten years. I have diabetes, for two years. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.52,
      "end_seconds": 179.07,
      "duration_seconds": 1.55,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.55,
      "end_seconds": 183.67,
      "duration_seconds": 3.12,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 185.35,
      "end_seconds": 188.28,
      "duration_seconds": 2.93,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.93,
      "end_seconds": 194.69,
      "duration_seconds": 3.76,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 196.54,
      "end_seconds": 212.3,
      "duration_seconds": 15.76,
      "text": "I'm on Eltroxin, 100 micrograms, every morning for my thyroid. It's sitagliptin, 100 milligrams, once a day. I'm on folic acid, 5 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.22,
      "end_seconds": 218.12,
      "duration_seconds": 3.9,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 219.8,
      "end_seconds": 223.79,
      "duration_seconds": 3.99,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.87,
      "end_seconds": 232.11,
      "duration_seconds": 4.24,
      "text": "any vomiting everything or severe abdominal pain at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 234.14,
      "end_seconds": 236.53,
      "duration_seconds": 2.39,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.57,
      "end_seconds": 242.19,
      "duration_seconds": 3.62,
      "text": "any fever or burning when passing urine at all?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 244.11,
      "end_seconds": 249.84,
      "duration_seconds": 5.73,
      "text": "No fever or burning when passing urine, none of it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.69,
      "end_seconds": 252.52,
      "duration_seconds": 1.83,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 257.95,
      "end_seconds": 259.94,
      "duration_seconds": 1.99,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 269.09,
      "end_seconds": 279.79,
      "duration_seconds": 10.7,
      "text": "Here are the numbers, doctor. Respiratory rate 15, oxygen saturation is 99 percent, pressure 119 over 81, temperature is 36.8 degrees, pulse 67."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.6,
      "end_seconds": 282.3,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.0,
      "end_seconds": 289.17,
      "duration_seconds": 5.17,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.53,
      "end_seconds": 292.24,
      "duration_seconds": 1.71,
      "text": "Okay, breathe out slowly."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.31,
      "end_seconds": 316.29,
      "duration_seconds": 5.98,
      "text": "Tummy is soft, non-tender, and the uterus isn't palpable above the pelvic bone yet."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.6,
      "end_seconds": 338.5,
      "duration_seconds": 19.9,
      "text": "Good, you can sit up again. Taking everything into account, the most likely explanation is an early pregnancy. The reason I say that is that your story and my examination fit together. It could also be a a late period for another reason, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.3,
      "end_seconds": 373.02,
      "duration_seconds": 26.72,
      "text": "we should do an early scan for early pregnancy. The result will help us decide whether anything more is needed. We should do a pregnancy test for missed period. Small, frequent meals and dry crackers before getting out of bed can calm the morning nausea. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 376.86,
      "end_seconds": 379.73,
      "duration_seconds": 2.87,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.7,
      "end_seconds": 401.96,
      "duration_seconds": 20.26,
      "text": "Blood tests is something we might do if this doesn't improve in a month. If you have bleeding or sharp pain on one side, that's the point to come in urgently. I'll want another look after the scan. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 403.17,
      "end_seconds": 408.23,
      "duration_seconds": 5.06,
      "text": "So, I come back after the scan. Is that right?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.8,
      "end_seconds": 413.81,
      "duration_seconds": 4.01,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 415.48,
      "end_seconds": 417.7,
      "duration_seconds": 2.22,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.64,
      "end_seconds": 419.98,
      "duration_seconds": 1.34,
      "text": "look after yourself"
    }
  ]
}