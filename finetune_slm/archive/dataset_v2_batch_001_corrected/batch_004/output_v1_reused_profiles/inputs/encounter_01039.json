{
  "schema_version": "1.0",
  "encounter_id": "01039",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.52,
      "end_seconds": 5.06,
      "duration_seconds": 4.54,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.03,
      "end_seconds": 9.85,
      "duration_seconds": 3.82,
      "text": "Erm, morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.36,
      "end_seconds": 13.35,
      "duration_seconds": 1.99,
      "text": "Have you been waiting long?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.16,
      "end_seconds": 18.1,
      "duration_seconds": 3.94,
      "text": "Only about ten minutes, uh, honestly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.66,
      "end_seconds": 21.37,
      "duration_seconds": 1.71,
      "text": "What's been worrying you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.59,
      "end_seconds": 32.29,
      "duration_seconds": 9.7,
      "text": "so the thing is, I've got an itchy rash all over. My neighbour said I should get it looked at"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.04,
      "end_seconds": 40.22,
      "duration_seconds": 3.18,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.1,
      "end_seconds": 42.91,
      "duration_seconds": 1.81,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.62,
      "end_seconds": 51.48,
      "duration_seconds": 7.86,
      "text": "can you describe it a bit more for me? How strong it is, what the pattern is, what helps"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 52.43,
      "end_seconds": 67.21,
      "duration_seconds": 14.78,
      "text": "I get some relief from an antihistamine. It's a couple of times a week. I'd call it severe. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.17,
      "end_seconds": 72.21,
      "duration_seconds": 3.04,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.84,
      "end_seconds": 83.29,
      "duration_seconds": 2.45,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.28,
      "end_seconds": 109.3,
      "duration_seconds": 6.02,
      "text": "Okay: respiratory rate 17, pulse is 75 beats a minute, pressure 120 over 68."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.94,
      "end_seconds": 114.38,
      "duration_seconds": 2.44,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.79,
      "end_seconds": 118.06,
      "duration_seconds": 2.27,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.26,
      "end_seconds": 137.8,
      "duration_seconds": 9.54,
      "text": "There are raised pink welts on the trunk and arms, the lips are a little puffy, and the tongue and throat look normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 139.74,
      "end_seconds": 140.44,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.44,
      "end_seconds": 145.5,
      "duration_seconds": 2.06,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.17,
      "end_seconds": 159.53,
      "duration_seconds": 4.36,
      "text": "Have you had any vomiting, wheeze or new food?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 162.92,
      "end_seconds": 165.34,
      "duration_seconds": 2.42,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.63,
      "end_seconds": 168.11,
      "duration_seconds": 1.48,
      "text": "any trouble breathing?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 168.94,
      "end_seconds": 171.16,
      "duration_seconds": 2.22,
      "text": "No. No trouble breathing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.66,
      "end_seconds": 175.35,
      "duration_seconds": 3.69,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.01,
      "end_seconds": 177.54,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 178.29,
      "end_seconds": 180.72,
      "duration_seconds": 2.43,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.27,
      "end_seconds": 188.76,
      "duration_seconds": 2.49,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.11,
      "end_seconds": 194.9,
      "duration_seconds": 4.79,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.89,
      "end_seconds": 208.31,
      "duration_seconds": 8.42,
      "text": "I take Foracort inhaler, twice a day. Cetirizine. I take it 10 milligrams, when it flares."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.67,
      "end_seconds": 214.55,
      "duration_seconds": 4.88,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.58,
      "end_seconds": 222.0,
      "duration_seconds": 3.42,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.28,
      "end_seconds": 237.18,
      "duration_seconds": 3.9,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.96,
      "end_seconds": 241.46,
      "duration_seconds": 3.5,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.96,
      "end_seconds": 245.09,
      "duration_seconds": 2.13,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 245.63,
      "end_seconds": 250.13,
      "duration_seconds": 4.5,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.65,
      "end_seconds": 252.27,
      "duration_seconds": 1.62,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.12,
      "end_seconds": 258.63,
      "duration_seconds": 4.51,
      "text": "I retired from the post office two years ago"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.83,
      "end_seconds": 263.08,
      "duration_seconds": 3.25,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 264.63,
      "end_seconds": 268.98,
      "duration_seconds": 4.35,
      "text": "I've had asthma for about ten years now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.2,
      "end_seconds": 272.61,
      "duration_seconds": 2.41,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.42,
      "end_seconds": 279.72,
      "duration_seconds": 5.3,
      "text": "I had keyhole surgery on my gallbladder two years back"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.32,
      "end_seconds": 300.88,
      "duration_seconds": 7.56,
      "text": "Right, here's what I'm thinking. This is probably an allergic reaction, possibly to a recently started medicine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.46,
      "end_seconds": 316.51,
      "duration_seconds": 8.05,
      "text": "let's use chlorphenamine, 4 milligrams, every six hours, for three days. That should help with allergic rash"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 317.47,
      "end_seconds": 318.49,
      "duration_seconds": 1.02,
      "text": "Mm, alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 319.8,
      "end_seconds": 338.7,
      "duration_seconds": 18.9,
      "text": "stop the new tablet until we know what caused it and write down every medicine you took in the last week. Keep an eye out, and if your throat tightens, your lips swell further or you get breathless, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.68,
      "end_seconds": 346.23,
      "duration_seconds": 1.55,
      "text": "okay, makes sense"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.37,
      "end_seconds": 355.18,
      "duration_seconds": 7.81,
      "text": "I'd like to see you again after the review. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.85,
      "end_seconds": 359.13,
      "duration_seconds": 2.28,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 359.66,
      "end_seconds": 361.43,
      "duration_seconds": 1.77,
      "text": "so, take care now"
    }
  ]
}