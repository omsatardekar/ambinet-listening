{
  "schema_version": "1.0",
  "encounter_id": "01411",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.64,
      "end_seconds": 5.54,
      "duration_seconds": 4.9,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.35,
      "end_seconds": 11.05,
      "duration_seconds": 3.7,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.21,
      "end_seconds": 18.85,
      "duration_seconds": 6.64,
      "text": "Uh, doctor, it's my heart racing. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.38,
      "end_seconds": 21.51,
      "duration_seconds": 2.13,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 22.46,
      "end_seconds": 26.22,
      "duration_seconds": 3.76,
      "text": "It's been going on for four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.72,
      "end_seconds": 30.14,
      "duration_seconds": 2.42,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.78,
      "end_seconds": 32.51,
      "duration_seconds": 1.73,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.95,
      "end_seconds": 39.37,
      "duration_seconds": 2.42,
      "text": "Has there been shaky hands too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.45,
      "end_seconds": 68.49,
      "duration_seconds": 27.04,
      "text": "Yeah, that too. So, as for shaky hands, pretty mild, if I'm being honest. Sorry, uh, what was I saying, and I've been losing weight even though I'm eating well as well. Erm, I'd been feeling anxious and jittery, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.32,
      "end_seconds": 72.1,
      "duration_seconds": 2.78,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.17,
      "end_seconds": 76.35,
      "duration_seconds": 3.18,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.92,
      "end_seconds": 91.71,
      "duration_seconds": 3.79,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.5,
      "end_seconds": 95.52,
      "duration_seconds": 3.02,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.28,
      "end_seconds": 101.61,
      "duration_seconds": 5.33,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.64,
      "end_seconds": 105.75,
      "duration_seconds": 2.11,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.5,
      "end_seconds": 108.77,
      "duration_seconds": 2.27,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 109.62,
      "end_seconds": 113.19,
      "duration_seconds": 3.57,
      "text": "I have arthritis in my knees."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.14,
      "end_seconds": 116.04,
      "duration_seconds": 0.9,
      "text": "Mm, okay."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 117.5,
      "end_seconds": 120.41,
      "duration_seconds": 2.91,
      "text": "Depression, for about ten years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.33,
      "end_seconds": 123.76,
      "duration_seconds": 1.43,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.13,
      "end_seconds": 136.97,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 138.88,
      "end_seconds": 141.32,
      "duration_seconds": 2.44,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.07,
      "end_seconds": 147.91,
      "duration_seconds": 1.84,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.41,
      "end_seconds": 151.14,
      "duration_seconds": 1.73,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 151.75,
      "end_seconds": 155.24,
      "duration_seconds": 3.49,
      "text": "Okay, do you work outside the home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.8,
      "end_seconds": 160.94,
      "duration_seconds": 4.14,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.97,
      "end_seconds": 164.72,
      "duration_seconds": 2.75,
      "text": "Right, do you do any exercise?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 165.4,
      "end_seconds": 167.95,
      "duration_seconds": 2.55,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.93,
      "end_seconds": 170.92,
      "duration_seconds": 1.99,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 172.31,
      "end_seconds": 178.02,
      "duration_seconds": 5.71,
      "text": "I'm on diclofenac, 50 milligrams, when needed for the joint pain."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 182.53,
      "end_seconds": 187.92,
      "duration_seconds": 5.39,
      "text": "Doctor, our chart from the last visit lists it as 25 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.78,
      "end_seconds": 192.92,
      "duration_seconds": 4.14,
      "text": "Right. Do you happen to have the current prescription here?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 196.14,
      "end_seconds": 212.58,
      "duration_seconds": 16.44,
      "text": "Okay, so not with me. I'll bring it next time. Escitalopram. I take it 10 milligrams, once a day. I'm supposed to take it regularly, but I don't always manage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.04,
      "end_seconds": 218.22,
      "duration_seconds": 4.18,
      "text": "Did you get trouble sleeping, eye bulging or diarrhoea?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 220.2,
      "end_seconds": 226.53,
      "duration_seconds": 6.33,
      "text": "No trouble sleeping, eye bulging or diarrhoea, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.73,
      "end_seconds": 231.58,
      "duration_seconds": 3.85,
      "text": "Did you notice any lump in the neck?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 232.18,
      "end_seconds": 235.71,
      "duration_seconds": 3.53,
      "text": "Definitely no lump in the neck."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.44,
      "end_seconds": 239.56,
      "duration_seconds": 3.12,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 241.45,
      "end_seconds": 243.57,
      "duration_seconds": 2.12,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.73,
      "end_seconds": 247.56,
      "duration_seconds": 2.83,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 248.09,
      "end_seconds": 249.08,
      "duration_seconds": 0.99,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 260.19,
      "end_seconds": 273.01,
      "duration_seconds": 12.82,
      "text": "Doctor, I've got the readings for you. Pulse is 120 beats a minute, temperature is 36.6 degrees. Pressure 135 over 80, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.77,
      "end_seconds": 277.72,
      "duration_seconds": 0.95,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.45,
      "end_seconds": 282.8,
      "duration_seconds": 2.35,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 283.98,
      "end_seconds": 285.11,
      "duration_seconds": 1.13,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.05,
      "end_seconds": 289.72,
      "duration_seconds": 2.67,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.97,
      "end_seconds": 306.24,
      "duration_seconds": 6.27,
      "text": "There's a fine tremor in the outstretched hands, and your palms are warm and moist."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.27,
      "end_seconds": 309.8,
      "duration_seconds": 2.53,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.1,
      "end_seconds": 324.93,
      "duration_seconds": 3.83,
      "text": "Your thyroid feels a little enlarged and smooth."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.46,
      "end_seconds": 349.35,
      "duration_seconds": 19.89,
      "text": "Good, you can sit up again. Right, here's what I'm thinking. I can't pin this down yet. We're looking at an overactive thyroid or a heart rhythm problem. A thyroid scan is what I'd like next, for hyperthyroidism. We should do a thyroid test for hyperthyroid symptoms."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 350.89,
      "end_seconds": 352.56,
      "duration_seconds": 1.67,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.1,
      "end_seconds": 380.55,
      "duration_seconds": 24.45,
      "text": "I'm prescribing propranolol, 20 milligrams, twice a day, until we review. You take it by mouth. It's for palpitations and tremor. Limit tea, coffee and anything that speeds up the heart for now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 383.88,
      "end_seconds": 385.59,
      "duration_seconds": 1.71,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.68,
      "end_seconds": 391.26,
      "duration_seconds": 4.58,
      "text": "Right, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 391.79,
      "end_seconds": 395.37,
      "duration_seconds": 3.58,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 396.45,
      "end_seconds": 397.64,
      "duration_seconds": 1.19,
      "text": "Look after yourself."
    }
  ]
}