{
  "schema_version": "1.0",
  "encounter_id": "01470",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.26,
      "end_seconds": 5.73,
      "duration_seconds": 4.47,
      "text": "Um, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.15,
      "end_seconds": 12.13,
      "duration_seconds": 4.98,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.09,
      "end_seconds": 17.41,
      "duration_seconds": 4.32,
      "text": "I've been feeling dizzy when I stand up."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.92,
      "end_seconds": 23.92,
      "duration_seconds": 3.0,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.03,
      "end_seconds": 28.8,
      "duration_seconds": 3.77,
      "text": "I've, I've had it since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.4,
      "end_seconds": 39.5,
      "duration_seconds": 9.1,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.16,
      "end_seconds": 52.37,
      "duration_seconds": 11.21,
      "text": "yes, getting out of bed and standing up quickly that makes it worse it settles a little with sitting back down. Moderate, really"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.13,
      "end_seconds": 62.25,
      "duration_seconds": 4.12,
      "text": "So, shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.12,
      "end_seconds": 78.53,
      "duration_seconds": 2.41,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.39,
      "end_seconds": 104.06,
      "duration_seconds": 6.67,
      "text": "Okay: temperature 36.9, saturation 97 percent, pressure 97 over 63. And And heart rate 106."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.05,
      "end_seconds": 109.55,
      "duration_seconds": 2.5,
      "text": "Okay, may I examine you now?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.02,
      "end_seconds": 112.38,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.0,
      "end_seconds": 133.51,
      "duration_seconds": 3.51,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.88,
      "end_seconds": 136.99,
      "duration_seconds": 2.11,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.98,
      "end_seconds": 154.2,
      "duration_seconds": 5.22,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.38,
      "end_seconds": 159.1,
      "duration_seconds": 2.72,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.45,
      "end_seconds": 170.51,
      "duration_seconds": 4.06,
      "text": "did you get palpitations, fainting or chest pain?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.07,
      "end_seconds": 173.24,
      "duration_seconds": 2.17,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.25,
      "end_seconds": 177.48,
      "duration_seconds": 3.23,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.99,
      "end_seconds": 183.22,
      "duration_seconds": 4.23,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.71,
      "end_seconds": 187.05,
      "duration_seconds": 2.34,
      "text": "is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.82,
      "end_seconds": 191.36,
      "duration_seconds": 2.54,
      "text": "bowels are regular, nothing odd"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.73,
      "end_seconds": 209.68,
      "duration_seconds": 1.95,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.21,
      "end_seconds": 213.78,
      "duration_seconds": 2.57,
      "text": "I've got high blood pressure."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.62,
      "end_seconds": 218.19,
      "duration_seconds": 2.57,
      "text": "Right, do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.95,
      "end_seconds": 222.77,
      "duration_seconds": 3.82,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.36,
      "end_seconds": 226.48,
      "duration_seconds": 2.12,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.27,
      "end_seconds": 232.45,
      "duration_seconds": 4.18,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.17,
      "end_seconds": 254.34,
      "duration_seconds": 4.17,
      "text": "which medicines do you take at the the moment?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.17,
      "end_seconds": 260.49,
      "duration_seconds": 4.32,
      "text": "I take amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.76,
      "end_seconds": 275.17,
      "duration_seconds": 2.41,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.53,
      "end_seconds": 281.08,
      "duration_seconds": 1.55,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.79,
      "end_seconds": 309.05,
      "duration_seconds": 27.26,
      "text": "Okay, thinking it through, I'd lean towards postural low blood pressure, possibly related to medicines or dehydration. I'm sending you for blood tests because of dizziness. Get up slowly from lying and sitting, and keep drinking fluids through the day. One warning sign to remember: you faint or have chest pain. In that case don't wait."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.52,
      "end_seconds": 311.52,
      "duration_seconds": 1.0,
      "text": "I understand."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.85,
      "end_seconds": 317.15,
      "duration_seconds": 4.3,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 318.62,
      "end_seconds": 320.44,
      "duration_seconds": 1.82,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.42,
      "end_seconds": 323.69,
      "duration_seconds": 1.27,
      "text": "Goodbye for now."
    }
  ]
}