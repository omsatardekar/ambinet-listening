{
  "schema_version": "1.0",
  "encounter_id": "01460",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.31,
      "end_seconds": 4.3,
      "duration_seconds": 2.99,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.33,
      "duration_seconds": 4.27,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.09,
      "end_seconds": 18.37,
      "duration_seconds": 7.28,
      "text": "Honestly, it's more breathlessness than usual, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.5,
      "end_seconds": 23.31,
      "duration_seconds": 3.81,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.57,
      "end_seconds": 29.48,
      "duration_seconds": 2.91,
      "text": "About... well, about two weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.19,
      "end_seconds": 32.62,
      "duration_seconds": 2.43,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.14,
      "end_seconds": 38.25,
      "duration_seconds": 4.11,
      "text": "Ah, pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.25,
      "end_seconds": 43.23,
      "duration_seconds": 2.98,
      "text": "Has there been a rattling chest too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.81,
      "end_seconds": 47.81,
      "duration_seconds": 3.0,
      "text": "Hmm, yes, since last Tuesday."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.95,
      "end_seconds": 54.26,
      "duration_seconds": 3.31,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.96,
      "end_seconds": 59.83,
      "duration_seconds": 4.87,
      "text": "Actually, uh, about a four out of ten."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.39,
      "end_seconds": 75.55,
      "duration_seconds": 5.16,
      "text": "A few quick ones: chest pain, swollen ankles, weight loss or fever?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.83,
      "end_seconds": 79.82,
      "duration_seconds": 2.99,
      "text": "None of those, um, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.57,
      "end_seconds": 83.68,
      "duration_seconds": 2.11,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.98,
      "end_seconds": 88.58,
      "duration_seconds": 3.6,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.67,
      "end_seconds": 92.78,
      "duration_seconds": 2.11,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.5,
      "end_seconds": 96.87,
      "duration_seconds": 3.37,
      "text": "I mean, I've had COPD, yes."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.51,
      "end_seconds": 118.89,
      "duration_seconds": 5.38,
      "text": "What's on your current medicine list? Just so I get the full picture."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.64,
      "end_seconds": 124.42,
      "duration_seconds": 3.78,
      "text": "I'm on Tiotropium inhaler, once a day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.84,
      "end_seconds": 128.2,
      "duration_seconds": 3.36,
      "text": "Ah. Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.68,
      "end_seconds": 139.11,
      "duration_seconds": 9.43,
      "text": "I hardly move around during the day. I work in accounts at a hospital. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.6,
      "end_seconds": 153.47,
      "duration_seconds": 2.87,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.97,
      "end_seconds": 159.0,
      "duration_seconds": 5.03,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.09,
      "end_seconds": 180.98,
      "duration_seconds": 3.89,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.31,
      "end_seconds": 191.28,
      "duration_seconds": 1.97,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.37,
      "end_seconds": 214.97,
      "duration_seconds": 8.6,
      "text": "Okay: pulse is 86 beats a minute, SpO2 90 percent on room air, pressure 129 over 78, respiratory rate 20."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.35,
      "end_seconds": 218.41,
      "duration_seconds": 2.06,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.9,
      "end_seconds": 222.83,
      "duration_seconds": 2.93,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.18,
      "end_seconds": 228.32,
      "duration_seconds": 4.14,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.85,
      "end_seconds": 231.96,
      "duration_seconds": 2.11,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.42,
      "end_seconds": 244.69,
      "duration_seconds": 5.27,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.84,
      "end_seconds": 248.44,
      "duration_seconds": 2.6,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.83,
      "end_seconds": 261.75,
      "duration_seconds": 3.92,
      "text": "There's some wheeze, and no swelling in the legs."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.81,
      "end_seconds": 297.47,
      "duration_seconds": 30.66,
      "text": "That's all I needed to check. We should do a chest X-ray for breathlessness. I'm going to order blood tests, for infective exacerbation. Let's use doxycycline, 100 milligrams, twice a day, for five days. It's for chest infection. I'm not ordering a sputum culture today. If things carry on in two weeks, we'll consider it. Let's review you in two weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 301.86,
      "end_seconds": 305.2,
      "duration_seconds": 3.34,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.61,
      "end_seconds": 308.03,
      "duration_seconds": 1.42,
      "text": "All the best."
    }
  ]
}