{
  "schema_version": "1.0",
  "encounter_id": "01372",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.9,
      "end_seconds": 6.19,
      "duration_seconds": 5.29,
      "text": "Doctor, I've brought them through. The observations are done, whenever you need them."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.29,
      "end_seconds": 10.9,
      "duration_seconds": 3.61,
      "text": "Perfect, thanks. Hello there, so what's the trouble?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 12.54,
      "end_seconds": 15.8,
      "duration_seconds": 3.26,
      "text": "I wanted to get bloating looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 17.27,
      "end_seconds": 28.2,
      "duration_seconds": 10.93,
      "text": "Doctor, I've got the readings for you. Respiratory rate 17, BP is 125 over 69, pulse is 82 beats a minute, saturation 99 percent."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.76,
      "end_seconds": 35.46,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.89,
      "end_seconds": 54.29,
      "duration_seconds": 4.4,
      "text": "Alright, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.53,
      "end_seconds": 59.84,
      "duration_seconds": 4.31,
      "text": "It's been going on for about a year."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.54,
      "end_seconds": 64.92,
      "duration_seconds": 3.38,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 66.51,
      "end_seconds": 68.2,
      "duration_seconds": 1.69,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.93,
      "end_seconds": 71.05,
      "duration_seconds": 2.12,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.14,
      "end_seconds": 90.45,
      "duration_seconds": 18.31,
      "text": "It usually comes with alternating constipation and loose stools. With alternating constipation and loose stools, about a six out of ten. I've also been passing a lot of wind, for two months."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.78,
      "end_seconds": 100.71,
      "duration_seconds": 4.93,
      "text": "Have you had bloating before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 101.39,
      "end_seconds": 109.74,
      "duration_seconds": 8.35,
      "text": "Yes, something like this happened a couple of years ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.73,
      "end_seconds": 112.93,
      "duration_seconds": 1.2,
      "text": "How about fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.5,
      "end_seconds": 115.99,
      "duration_seconds": 1.49,
      "text": "No. No fever."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.42,
      "end_seconds": 124.81,
      "duration_seconds": 7.39,
      "text": "Let me check a few things. Any blood in the stool, anaemia or night-time diarrhoea?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.68,
      "end_seconds": 133.69,
      "duration_seconds": 7.01,
      "text": "No blood in the stool, anaemia or night-time diarrhoea, none of it."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.03,
      "end_seconds": 138.93,
      "duration_seconds": 3.9,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 140.43,
      "end_seconds": 142.74,
      "duration_seconds": 2.31,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.21,
      "end_seconds": 148.0,
      "duration_seconds": 3.79,
      "text": "Anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 148.64,
      "end_seconds": 151.33,
      "duration_seconds": 2.69,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.04,
      "end_seconds": 158.42,
      "duration_seconds": 3.38,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 158.98,
      "end_seconds": 161.39,
      "duration_seconds": 2.41,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.42,
      "end_seconds": 165.07,
      "duration_seconds": 2.65,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 170.22,
      "end_seconds": 175.73,
      "duration_seconds": 5.51,
      "text": "I've got anxiety. Yes, acid reflux. I've got high blood pressure."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.69,
      "end_seconds": 190.22,
      "duration_seconds": 13.53,
      "text": "Right, so acid reflux and high blood pressure are already on your record. We'll keep that in mind today. Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 191.16,
      "end_seconds": 195.67,
      "duration_seconds": 4.51,
      "text": "I'm allergic to cat fur, I get sneezing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.71,
      "end_seconds": 202.12,
      "duration_seconds": 4.41,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 202.87,
      "end_seconds": 233.64,
      "duration_seconds": 30.77,
      "text": "I'm on escitalopram, 10 milligrams, once a day for the anxiety. I'm on omeprazole, 20 milligrams, once a day for the reflux. Lisinopril, 10 milligrams, once a day. Work has been very busy so I kept ignoring it. I've been putting this off for weeks. I'm on Colospa, when it cramps. I used to take hydrochlorothiazide, but I stopped it."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.45,
      "end_seconds": 249.4,
      "duration_seconds": 3.95,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 251.28,
      "end_seconds": 260.21,
      "duration_seconds": 8.93,
      "text": "I swim twice a week. My husband and I live above the shop. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.02,
      "end_seconds": 263.67,
      "duration_seconds": 2.65,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 265.77,
      "end_seconds": 272.95,
      "duration_seconds": 7.18,
      "text": "Right, just a cataract operation in my left eye, about a year ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.35,
      "end_seconds": 278.26,
      "duration_seconds": 2.91,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.18,
      "end_seconds": 283.72,
      "duration_seconds": 3.54,
      "text": "Right, stay as you are for a moment."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.45,
      "end_seconds": 297.26,
      "duration_seconds": 5.81,
      "text": "Soft tummy, a bit tender on the left lower side, no masses."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.37,
      "end_seconds": 305.05,
      "duration_seconds": 2.68,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.36,
      "end_seconds": 338.48,
      "duration_seconds": 19.12,
      "text": "Okay, so my impression is this: This is probably irritable bowel syndrome as a working diagnosis. The reason I say that is that your story and my examination fit together. I can't rule out a food intolerance yet. Let's get a stool calprotectin, for bowel symptoms."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 339.88,
      "end_seconds": 340.99,
      "duration_seconds": 1.11,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.57,
      "end_seconds": 345.5,
      "duration_seconds": 2.93,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 347.06,
      "end_seconds": 348.73,
      "duration_seconds": 1.67,
      "text": "That's clear, thanks."
    }
  ]
}