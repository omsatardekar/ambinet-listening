{
  "schema_version": "1.0",
  "encounter_id": "01044",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.71,
      "end_seconds": 3.29,
      "duration_seconds": 2.58,
      "text": "Okay, evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.73,
      "end_seconds": 8.23,
      "duration_seconds": 3.5,
      "text": "Morning, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.53,
      "end_seconds": 11.85,
      "duration_seconds": 2.32,
      "text": "Have you been here before?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.68,
      "end_seconds": 16.41,
      "duration_seconds": 3.73,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 21.43,
      "end_seconds": 24.02,
      "duration_seconds": 2.59,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.09,
      "end_seconds": 30.24,
      "duration_seconds": 4.15,
      "text": "I wanted to get watery diarrhoea looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.71,
      "end_seconds": 36.96,
      "duration_seconds": 1.25,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.42,
      "end_seconds": 47.62,
      "duration_seconds": 6.2,
      "text": "Ten days, I think... sorry, about four days, I got that wrong."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.63,
      "end_seconds": 51.79,
      "duration_seconds": 3.16,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.15,
      "end_seconds": 57.75,
      "duration_seconds": 4.6,
      "text": "I'd give it a seven, out of ten."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.46,
      "end_seconds": 65.91,
      "duration_seconds": 3.45,
      "text": "Right, is there anything else with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.75,
      "end_seconds": 71.58,
      "duration_seconds": 4.83,
      "text": "Nausea goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.89,
      "end_seconds": 78.23,
      "duration_seconds": 5.34,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.32,
      "end_seconds": 90.14,
      "duration_seconds": 10.82,
      "text": "I quit smoking around ten years ago. I'm vegetarian and have been for years. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.79,
      "end_seconds": 94.75,
      "duration_seconds": 3.96,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.6,
      "end_seconds": 97.15,
      "duration_seconds": 1.55,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.11,
      "end_seconds": 103.36,
      "duration_seconds": 4.25,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.89,
      "end_seconds": 107.82,
      "duration_seconds": 2.93,
      "text": "It's ORS, after each loose stool."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.73,
      "end_seconds": 129.07,
      "duration_seconds": 4.34,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.21,
      "end_seconds": 133.06,
      "duration_seconds": 2.85,
      "text": "Yes, wheat. I get itchy skin."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.9,
      "end_seconds": 149.89,
      "duration_seconds": 2.99,
      "text": "And vomiting blood, any of that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.61,
      "end_seconds": 152.77,
      "duration_seconds": 2.16,
      "text": "Definitely no vomiting blood."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.62,
      "end_seconds": 158.75,
      "duration_seconds": 4.13,
      "text": "Have you noticed severe abdominal pain, black stools or confusion?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.36,
      "end_seconds": 164.72,
      "duration_seconds": 4.36,
      "text": "No, no severe abdominal pain, black stools or confusion."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 169.0,
      "duration_seconds": 3.97,
      "text": "Right, right. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.21,
      "end_seconds": 172.49,
      "duration_seconds": 2.28,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.54,
      "end_seconds": 176.09,
      "duration_seconds": 2.55,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.85,
      "end_seconds": 178.78,
      "duration_seconds": 1.93,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 183.88,
      "end_seconds": 193.87,
      "duration_seconds": 9.99,
      "text": "Okay, so the vitals from earlier. Saturation 97 percent, blood pressure 111 over 66. Pulse is 107 beats a minute, temperature 39.1, respiratory rate 16."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.97,
      "end_seconds": 197.04,
      "duration_seconds": 2.07,
      "text": "Alright, good, thank you."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.03,
      "end_seconds": 204.59,
      "duration_seconds": 4.56,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.37,
      "end_seconds": 207.65,
      "duration_seconds": 1.28,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 221.26,
      "end_seconds": 227.71,
      "duration_seconds": 6.45,
      "text": "Your mouth is a bit dry and your tummy is soft with mild tenderness all over."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.28,
      "end_seconds": 232.04,
      "duration_seconds": 1.76,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.0,
      "end_seconds": 260.27,
      "duration_seconds": 12.27,
      "text": "From what you've told me and what I found, I'm honestly not certain yet. It could be infective gastroenteritis, likely after recent travel, or it might be a parasitic infection."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.93,
      "end_seconds": 278.0,
      "duration_seconds": 4.07,
      "text": "I think blood tests makes sense here, for dehydration."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 278.96,
      "end_seconds": 281.04,
      "duration_seconds": 2.08,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 282.18,
      "end_seconds": 297.09,
      "duration_seconds": 14.91,
      "text": "Small sips often are better than large drinks, and eat plain food as soon as you can. If you see blood in the stool or cannot keep fluids down, that's the point to come in urgently."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 298.81,
      "end_seconds": 301.99,
      "duration_seconds": 3.18,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.94,
      "end_seconds": 309.69,
      "duration_seconds": 6.75,
      "text": "See me again if it isn't better in three days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 315.15,
      "end_seconds": 316.66,
      "duration_seconds": 1.51,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.18,
      "end_seconds": 318.47,
      "duration_seconds": 1.29,
      "text": "Take care now."
    }
  ]
}