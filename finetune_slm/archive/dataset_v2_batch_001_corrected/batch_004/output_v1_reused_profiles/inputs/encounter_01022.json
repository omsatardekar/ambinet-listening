  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 7.22,
      "duration_seconds": 6.15,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.47,
      "end_seconds": 13.24,
      "duration_seconds": 4.77,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 14.59,
      "end_seconds": 18.91,
      "duration_seconds": 4.32,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.85,
      "end_seconds": 24.4,
      "duration_seconds": 3.55,
      "text": "Right, please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.37,
      "end_seconds": 30.99,
      "duration_seconds": 5.62,
      "text": "Okay, so doctor, it's it's got darker. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.94,
      "end_seconds": 34.81,
      "duration_seconds": 1.87,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.89,
      "end_seconds": 43.81,
      "duration_seconds": 7.92,
      "text": "I've had it since last Tuesday. And another new spot on my arm, too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.52,
      "end_seconds": 49.58,
      "duration_seconds": 5.06,
      "text": "Any history of skin cancer or history of sunburn at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.39,
      "end_seconds": 54.64,
      "duration_seconds": 3.25,
      "text": "Ah, no, nothing to report there."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.92,
      "end_seconds": 61.02,
      "duration_seconds": 5.1,
      "text": "Have you had any fever, weight loss or lumps in the armpit?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.88,
      "end_seconds": 66.73,
      "duration_seconds": 4.85,
      "text": "No, no fever, weight loss or lumps in the armpit."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.48,
      "end_seconds": 70.46,
      "duration_seconds": 2.98,
      "text": "Right, any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.3,
      "end_seconds": 75.88,
      "duration_seconds": 3.58,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.98,
      "end_seconds": 90.91,
      "duration_seconds": 4.93,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.42,
      "end_seconds": 95.99,
      "duration_seconds": 4.57,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.46,
      "end_seconds": 100.59,
      "duration_seconds": 3.13,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 101.1,
      "end_seconds": 109.96,
      "duration_seconds": 8.86,
      "text": "Hmm, she is on Thyronorm, 50 micrograms, every morning for my thyroid, I give it to her."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.7,
      "end_seconds": 120.52,
      "duration_seconds": 2.82,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.63,
      "end_seconds": 126.25,
      "duration_seconds": 4.62,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.2,
      "end_seconds": 130.57,
      "duration_seconds": 2.37,
      "text": "Okay, how are your meals?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.12,
      "end_seconds": 136.55,
      "duration_seconds": 4.43,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.04,
      "end_seconds": 142.33,
      "duration_seconds": 4.29,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.01,
      "end_seconds": 145.82,
      "duration_seconds": 2.81,
      "text": "I've had an underactive thyroid, yes."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.68,
      "end_seconds": 150.18,
      "duration_seconds": 2.5,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.83,
      "end_seconds": 155.62,
      "duration_seconds": 4.79,
      "text": "I had my womb taken out fifteen years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.19,
      "end_seconds": 161.09,
      "duration_seconds": 3.9,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 168.81,
      "end_seconds": 171.69,
      "duration_seconds": 2.88,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.82,
      "end_seconds": 198.4,
      "duration_seconds": 8.58,
      "text": "Okay: blood pressure 128 over 70, respiratory rate 18, temperature 36.9. And oxygen saturation is 99 percent, heart rate 75."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.55,
      "end_seconds": 201.84,
      "duration_seconds": 2.29,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.65,
      "end_seconds": 206.12,
      "duration_seconds": 3.47,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.96,
      "end_seconds": 212.39,
      "duration_seconds": 4.43,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.46,
      "end_seconds": 214.82,
      "duration_seconds": 1.36,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.43,
      "end_seconds": 228.7,
      "duration_seconds": 3.27,
      "text": "I can't feel any glands in the armpit."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.38,
      "end_seconds": 232.37,
      "duration_seconds": 1.99,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.45,
      "end_seconds": 251.07,
      "duration_seconds": 5.62,
      "text": "It's about eight millimetres, with an uneven border and two shades of brown."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.19,
      "end_seconds": 257.0,
      "duration_seconds": 1.81,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.38,
      "end_seconds": 275.73,
      "duration_seconds": 4.35,
      "text": "I'll request a dermoscopy, it'll help with changing mole."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.77,
      "end_seconds": 283.56,
      "duration_seconds": 2.79,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.05,
      "end_seconds": 300.25,
      "duration_seconds": 15.2,
      "text": "Please use sunscreen and cover up in the midday sun, and check your skin once a month. Please come and see me after the biopsy results. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.09,
      "end_seconds": 305.45,
      "duration_seconds": 3.36,
      "text": "Okay, that makes sense. Thanks for explaining."
    }
  ]
}