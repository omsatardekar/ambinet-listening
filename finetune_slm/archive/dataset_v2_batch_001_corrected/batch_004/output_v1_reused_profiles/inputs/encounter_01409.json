{
  "schema_version": "1.0",
  "encounter_id": "01409",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 7.08,
      "duration_seconds": 6.51,
      "text": "Hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.58,
      "end_seconds": 12.51,
      "duration_seconds": 3.93,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.81,
      "end_seconds": 20.17,
      "duration_seconds": 6.36,
      "text": "It's being unsteady. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.81,
      "end_seconds": 27.52,
      "duration_seconds": 3.71,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.21,
      "end_seconds": 31.73,
      "duration_seconds": 3.52,
      "text": "It's been like this since last weekend."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.45,
      "end_seconds": 36.3,
      "duration_seconds": 2.85,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.7,
      "end_seconds": 42.57,
      "duration_seconds": 4.87,
      "text": "Maybe a three out of ten on a bad day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.3,
      "end_seconds": 46.03,
      "duration_seconds": 1.73,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.0,
      "end_seconds": 51.08,
      "duration_seconds": 4.08,
      "text": "It settles a little with holding on to things."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.68,
      "end_seconds": 58.97,
      "duration_seconds": 4.29,
      "text": "So, any hearing loss, headache or double vision at all?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 60.84,
      "end_seconds": 62.79,
      "duration_seconds": 1.95,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.76,
      "end_seconds": 68.7,
      "duration_seconds": 3.94,
      "text": "Have you had slurred speech, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.59,
      "end_seconds": 72.82,
      "duration_seconds": 2.23,
      "text": "Nope, no slurred speech."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.33,
      "end_seconds": 75.88,
      "duration_seconds": 2.55,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.41,
      "end_seconds": 79.57,
      "duration_seconds": 2.16,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.28,
      "end_seconds": 85.01,
      "duration_seconds": 3.73,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.54,
      "end_seconds": 87.91,
      "duration_seconds": 1.37,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.24,
      "end_seconds": 90.49,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.87,
      "end_seconds": 94.85,
      "duration_seconds": 2.98,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.48,
      "end_seconds": 98.39,
      "duration_seconds": 2.91,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.8,
      "end_seconds": 117.3,
      "duration_seconds": 17.5,
      "text": "Nothing, I'm teetotal. I have about eight cigarettes in a day. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.52,
      "end_seconds": 131.77,
      "duration_seconds": 5.25,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.88,
      "end_seconds": 136.25,
      "duration_seconds": 3.37,
      "text": "Yes, erythromycin, it gives me a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.18,
      "end_seconds": 139.64,
      "duration_seconds": 2.46,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.73,
      "end_seconds": 147.08,
      "duration_seconds": 5.35,
      "text": "Sorry, what was I saying, no, I don't take any tablets."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.11,
      "end_seconds": 153.13,
      "duration_seconds": 4.02,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.02,
      "end_seconds": 157.1,
      "duration_seconds": 2.08,
      "text": "No, nothing at all."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.11,
      "end_seconds": 169.6,
      "duration_seconds": 2.49,
      "text": "Okay, I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.03,
      "end_seconds": 182.44,
      "duration_seconds": 2.41,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.19,
      "end_seconds": 203.24,
      "duration_seconds": 6.05,
      "text": "Okay: heart rate 75, temp 36.9 degrees, BP is 126 over 77."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.04,
      "end_seconds": 209.32,
      "duration_seconds": 3.28,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.64,
      "end_seconds": 212.68,
      "duration_seconds": 2.04,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.45,
      "end_seconds": 233.11,
      "duration_seconds": 7.66,
      "text": "I can see a fine jerking of the eyes to the left and your walking is a little unsteady."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.75,
      "end_seconds": 240.25,
      "duration_seconds": 2.5,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.87,
      "end_seconds": 270.67,
      "duration_seconds": 13.8,
      "text": "Let me tell you where I've got to. My working impression is an inner-ear balance problem such as vestibular neuritis. I'd like to arrange blood tests for dizziness."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 272.16,
      "end_seconds": 275.99,
      "duration_seconds": 3.83,
      "text": "I can book that for Tuesday at 10 am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.5,
      "end_seconds": 289.57,
      "duration_seconds": 13.07,
      "text": "I'd like to arrange a positional test for vertigo. I'm going to put you on prochlorperazine, 5 milligrams, three times a day, for three days. It's for nausea and vertigo."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.52,
      "end_seconds": 294.47,
      "duration_seconds": 2.95,
      "text": "Should I take that with food?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.97,
      "end_seconds": 319.01,
      "duration_seconds": 23.04,
      "text": "Start moving around gently as soon as you can, since resting too long slows recovery. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit. Let's get you seen by the balance clinic, I'll arrange the letter."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 322.6,
      "end_seconds": 325.28,
      "duration_seconds": 2.68,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.32,
      "end_seconds": 337.59,
      "duration_seconds": 10.27,
      "text": "If you get double vision, weakness or trouble speaking, that's the point to come in urgently. Let's plan a check in a week."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.12,
      "end_seconds": 340.97,
      "duration_seconds": 1.85,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.68,
      "end_seconds": 350.22,
      "duration_seconds": 8.54,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.35,
      "end_seconds": 362.5,
      "duration_seconds": 11.15,
      "text": "So, I take the prochlorperazine, 5 milligrams, three times a day and come back in a week. Is that right?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.55,
      "end_seconds": 370.18,
      "duration_seconds": 6.63,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 372.05,
      "end_seconds": 374.01,
      "duration_seconds": 1.96,
      "text": "Thank you, that's helpful."
    }
  ]
}