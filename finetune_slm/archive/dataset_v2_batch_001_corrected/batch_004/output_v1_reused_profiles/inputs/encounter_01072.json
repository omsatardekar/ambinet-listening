{
  "schema_version": "1.0",
  "encounter_id": "01072",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.53,
      "end_seconds": 4.4,
      "duration_seconds": 3.87,
      "text": "hello, doctor. I think it's my turn"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.0,
      "end_seconds": 10.51,
      "duration_seconds": 5.51,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.54,
      "end_seconds": 15.6,
      "duration_seconds": 4.06,
      "text": "doctor I'm just here to help with the details"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 16.39,
      "end_seconds": 19.67,
      "duration_seconds": 3.28,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 20.69,
      "end_seconds": 29.3,
      "duration_seconds": 8.61,
      "text": "It's cramps in my calves at night, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.54,
      "end_seconds": 38.86,
      "duration_seconds": 3.32,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.62,
      "end_seconds": 51.27,
      "duration_seconds": 11.65,
      "text": "It's been three weeks, I'm fairly sure. A neighbour of mine said I should see someone about it. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.09,
      "end_seconds": 62.95,
      "duration_seconds": 7.86,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 63.9,
      "end_seconds": 78.39,
      "duration_seconds": 14.49,
      "text": "I notice it more with lying in bed and pointing my toes. Only walking about and stretching, and it's not much. It's every other day. It feels moderate to me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.89,
      "end_seconds": 80.95,
      "duration_seconds": 2.06,
      "text": "any other symptoms with it?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.68,
      "end_seconds": 95.06,
      "duration_seconds": 12.38,
      "text": "when it starts I tend to get a dull ache after the cramp as well. The dull ache after the cramp? That's been for three weeks"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.87,
      "end_seconds": 99.83,
      "duration_seconds": 2.96,
      "text": "okay, how frequently does it come?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.6,
      "end_seconds": 118.52,
      "duration_seconds": 17.92,
      "text": "honestly, a couple of times a week. And there's trouble sleeping as well, six months now. I've had tingling in my feet too, for about a year. About tingling in my feet, honestly, a few times a day"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.11,
      "end_seconds": 126.89,
      "duration_seconds": 7.78,
      "text": "have you had cramps in your calves at night before or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.45,
      "end_seconds": 134.77,
      "duration_seconds": 7.32,
      "text": "Yes something like this happened about six months ago and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.99,
      "end_seconds": 158.38,
      "duration_seconds": 5.39,
      "text": "alright, any chest pain, weakness in the legs or back pain?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.52,
      "end_seconds": 162.38,
      "duration_seconds": 2.86,
      "text": "no, not a single one"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.55,
      "end_seconds": 169.27,
      "duration_seconds": 5.72,
      "text": "any redness of the leg, swelling of the legs or shortness of breath?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.02,
      "end_seconds": 172.57,
      "duration_seconds": 2.55,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.36,
      "end_seconds": 177.3,
      "duration_seconds": 3.94,
      "text": "Any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.21,
      "end_seconds": 180.89,
      "duration_seconds": 1.68,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.9,
      "end_seconds": 184.92,
      "duration_seconds": 2.02,
      "text": "what about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.4,
      "end_seconds": 189.71,
      "duration_seconds": 3.31,
      "text": "I have diabetes, for two years"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.1,
      "end_seconds": 191.85,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.37,
      "end_seconds": 194.67,
      "duration_seconds": 2.3,
      "text": "I've got high blood pressure"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.42,
      "end_seconds": 204.26,
      "duration_seconds": 7.84,
      "text": "Right, so diabetes and high blood pressure are already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.03,
      "end_seconds": 220.74,
      "duration_seconds": 2.71,
      "text": "have you been to theatre before?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.68,
      "end_seconds": 230.23,
      "duration_seconds": 8.55,
      "text": "yes uh I had a cataract operation in my left eye about a year ago"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.95,
      "end_seconds": 235.1,
      "duration_seconds": 3.15,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.13,
      "end_seconds": 242.43,
      "duration_seconds": 4.3,
      "text": "my sister had breast cancer. My grandmother had dementia"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.74,
      "end_seconds": 251.39,
      "duration_seconds": 2.65,
      "text": "have you got any known allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 253.4,
      "end_seconds": 255.89,
      "duration_seconds": 2.49,
      "text": "I've never had an allergy"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 257.58,
      "end_seconds": 264.24,
      "duration_seconds": 6.66,
      "text": "Hmm, I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 264.75,
      "end_seconds": 267.85,
      "duration_seconds": 3.1,
      "text": "maybe, but I don't recall it"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.36,
      "end_seconds": 276.14,
      "duration_seconds": 6.78,
      "text": "okay, I'll note both of those. Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 277.53,
      "end_seconds": 284.35,
      "duration_seconds": 6.82,
      "text": "she is on Glycomet, 500 milligrams, twice a day, I give it to her"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.01,
      "end_seconds": 289.26,
      "duration_seconds": 3.25,
      "text": "a few questions about your lifestyle now"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.51,
      "end_seconds": 308.64,
      "duration_seconds": 15.13,
      "text": "I used to drink heavily but I stopped four years ago. I grab fast food at lunch most days. Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.2,
      "end_seconds": 312.64,
      "duration_seconds": 2.44,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.24,
      "end_seconds": 323.49,
      "duration_seconds": 2.25,
      "text": "okay this won't take long.."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.63,
      "end_seconds": 354.75,
      "duration_seconds": 11.12,
      "text": "okay: pulse is 77 beats a a minute, respiratory rate 17, BP is 124 over 79, oxygen saturation is 99 percent, temp 36.6 degrees"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.2,
      "end_seconds": 360.69,
      "duration_seconds": 4.49,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.2,
      "end_seconds": 363.63,
      "duration_seconds": 1.43,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.37,
      "end_seconds": 383.79,
      "duration_seconds": 6.42,
      "text": "both calves are soft and not tender, and the pulses at your feet are good"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.82,
      "end_seconds": 389.99,
      "duration_seconds": 2.17,
      "text": "okay, that's enough for me"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 407.17,
      "end_seconds": 423.56,
      "duration_seconds": 16.39,
      "text": "right, here's what I'm thinking. It points towards night-time muscle cramps without a worrying cause. Another possibility is a low salt level or low magnesium. Today I'm not changing anything. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 425.53,
      "end_seconds": 428.97,
      "duration_seconds": 3.44,
      "text": "I mean, thank you, doctor, goodbye"
    }
  ]
}