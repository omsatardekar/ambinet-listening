{
  "schema_version": "1.0",
  "encounter_id": "01367",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.7,
      "end_seconds": 6.83,
      "duration_seconds": 6.13,
      "text": "Doctor, hi, where would you like me to to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.61,
      "end_seconds": 12.23,
      "duration_seconds": 4.62,
      "text": "Yes come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.94,
      "end_seconds": 23.1,
      "duration_seconds": 10.16,
      "text": "doctor, it's constant thirst. It's getting on my nerves now. I looked a few things up online, and that probably didn't help"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.28,
      "end_seconds": 26.39,
      "duration_seconds": 2.11,
      "text": "tell me your medicines please"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.24,
      "end_seconds": 32.53,
      "duration_seconds": 5.29,
      "text": "I'm on gliclazide, 80 milligrams, twice a day for my sugar."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.66,
      "end_seconds": 35.32,
      "duration_seconds": 1.66,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.3,
      "end_seconds": 44.41,
      "duration_seconds": 8.11,
      "text": "For nearly five years I'd say. I didn't wanna bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.21,
      "end_seconds": 47.55,
      "duration_seconds": 2.34,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.62,
      "end_seconds": 61.02,
      "duration_seconds": 11.4,
      "text": "I'd give it a three, out of ten. So, you know, and I've been passing urine a lot as well, for about three months"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.26,
      "end_seconds": 61.96,
      "duration_seconds": 0.7,
      "text": "understood"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.52,
      "end_seconds": 77.18,
      "duration_seconds": 3.66,
      "text": "Have you had any weight loss or abdominal pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.9,
      "end_seconds": 83.97,
      "duration_seconds": 5.07,
      "text": "I haven't had weight loss or abdominal pain, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.93,
      "end_seconds": 88.12,
      "duration_seconds": 3.19,
      "text": "Have you had any vomiting or chest pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.74,
      "end_seconds": 92.79,
      "duration_seconds": 4.05,
      "text": "I haven't had vomiting or chest pain, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.71,
      "end_seconds": 99.03,
      "duration_seconds": 4.32,
      "text": "any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.9,
      "end_seconds": 102.79,
      "duration_seconds": 1.89,
      "text": "no weakness or anything"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.12,
      "end_seconds": 106.08,
      "duration_seconds": 1.96,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.97,
      "end_seconds": 110.57,
      "duration_seconds": 2.6,
      "text": "well, no problems with breathing"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.83,
      "end_seconds": 125.18,
      "duration_seconds": 4.35,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.21,
      "end_seconds": 130.18,
      "duration_seconds": 3.97,
      "text": "No, um, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.49,
      "end_seconds": 137.07,
      "duration_seconds": 5.58,
      "text": "tell me about your routine, work, habits, that that sort of thing"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.36,
      "end_seconds": 152.56,
      "duration_seconds": 14.2,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. I do a yoga class on Thursdays. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.26,
      "end_seconds": 160.39,
      "duration_seconds": 3.13,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.3,
      "end_seconds": 164.2,
      "duration_seconds": 1.9,
      "text": "Diabetes for two years"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.14,
      "end_seconds": 170.56,
      "duration_seconds": 4.42,
      "text": "Okay, I can see diabetes in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.35,
      "end_seconds": 184.23,
      "duration_seconds": 2.88,
      "text": "does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.53,
      "end_seconds": 191.23,
      "duration_seconds": 2.7,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.56,
      "end_seconds": 195.93,
      "duration_seconds": 3.37,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.65,
      "end_seconds": 209.16,
      "duration_seconds": 2.51,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.01,
      "end_seconds": 230.34,
      "duration_seconds": 10.33,
      "text": "okay: SpO2 99 percent on room air pressure 172 over 92 height 177 centimetres pulse 88 weight 92 kilos temperature 36.4."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 232.24,
      "end_seconds": 234.38,
      "duration_seconds": 2.14,
      "text": "is that alright doctor?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.17,
      "end_seconds": 242.84,
      "duration_seconds": 2.67,
      "text": "I'll come back to the numbers"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.74,
      "end_seconds": 250.18,
      "duration_seconds": 4.44,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.63,
      "end_seconds": 252.92,
      "duration_seconds": 1.29,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.11,
      "end_seconds": 274.57,
      "duration_seconds": 4.46,
      "text": "sensation to to the monofilament is reduced on the right foot"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.05,
      "end_seconds": 277.44,
      "duration_seconds": 1.39,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.64,
      "end_seconds": 294.89,
      "duration_seconds": 6.25,
      "text": "your feet look fine no ulcers or sores and the pulses are palpable"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 296.98,
      "end_seconds": 298.1,
      "duration_seconds": 1.12,
      "text": "sure thing"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.95,
      "end_seconds": 333.22,
      "duration_seconds": 29.27,
      "text": "Thank you you can get dressed. Okay so my impression is this: This is probably diabetes that isn't well controlled. That's my thinking for now and it may change as we learn more. A medication issue is still possible. I'm going to order an HbA1c for diabetes control. Cut back on sweets sugary drinks and white rice and keep to regular meal times."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 334.82,
      "end_seconds": 341.75,
      "duration_seconds": 6.93,
      "text": "I'm not ordering an eye check today if things carry on in two weeks, we'll consider it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.73,
      "end_seconds": 346.99,
      "duration_seconds": 4.26,
      "text": "can you send me for kidney function tests?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.64,
      "end_seconds": 356.66,
      "duration_seconds": 8.02,
      "text": "So, not at this point, no. It isn't indicated yet. I'd like you back in four weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.77,
      "end_seconds": 362.98,
      "duration_seconds": 3.21,
      "text": "I'll book it on my way out"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.86,
      "end_seconds": 368.5,
      "duration_seconds": 4.64,
      "text": "right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.3,
      "end_seconds": 373.93,
      "duration_seconds": 3.63,
      "text": "okay that that makes sense. Thanks for explaining"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 375.0,
      "end_seconds": 377.03,
      "duration_seconds": 2.03,
      "text": "Have a a good day."
    }
  ]
