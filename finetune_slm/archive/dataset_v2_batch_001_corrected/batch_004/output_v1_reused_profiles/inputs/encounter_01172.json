{
  "schema_version": "1.0",
  "encounter_id": "01172",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.79,
      "end_seconds": 7.48,
      "duration_seconds": 6.69,
      "text": "Erm, hello doctor, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.22,
      "end_seconds": 11.98,
      "duration_seconds": 3.76,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.63,
      "end_seconds": 17.88,
      "duration_seconds": 5.25,
      "text": "Hello, doctor. I'm here with them in case I can help."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.21,
      "end_seconds": 23.46,
      "duration_seconds": 4.25,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 24.64,
      "end_seconds": 30.31,
      "duration_seconds": 5.67,
      "text": "Doctor, it's food coming back up. That's what we're worried about."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.2,
      "end_seconds": 34.0,
      "duration_seconds": 2.8,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.57,
      "end_seconds": 38.58,
      "duration_seconds": 3.01,
      "text": "I've had it for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.07,
      "end_seconds": 48.43,
      "duration_seconds": 9.36,
      "text": "Okay, go on. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.01,
      "end_seconds": 61.49,
      "duration_seconds": 12.48,
      "text": "Bending over definitely sets it off. Pretty severe, if I'm being honest. I've also had a cough at night, for two months."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.37,
      "end_seconds": 65.8,
      "duration_seconds": 2.43,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.88,
      "end_seconds": 70.11,
      "duration_seconds": 2.23,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.7,
      "end_seconds": 71.4,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.41,
      "end_seconds": 80.26,
      "duration_seconds": 6.85,
      "text": "Uh, I had chest discomfort after eating before. That's settled now, though."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.23,
      "end_seconds": 88.51,
      "duration_seconds": 7.28,
      "text": "Okay, have you had food coming back up before, or is this the first time?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 90.09,
      "end_seconds": 96.66,
      "duration_seconds": 6.57,
      "text": "Yes, something like this happened last winter, and it went away on its own."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.75,
      "end_seconds": 102.99,
      "duration_seconds": 4.24,
      "text": "Have you had any vomiting blood or black stools?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.75,
      "end_seconds": 107.24,
      "duration_seconds": 3.49,
      "text": "No, no vomiting blood or black stools."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.06,
      "end_seconds": 111.69,
      "duration_seconds": 3.63,
      "text": "Any anaemia, trouble swallowing or pain on exertion?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.93,
      "end_seconds": 115.35,
      "duration_seconds": 2.42,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.67,
      "end_seconds": 120.76,
      "duration_seconds": 4.09,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.39,
      "end_seconds": 124.3,
      "duration_seconds": 1.91,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.32,
      "end_seconds": 128.27,
      "duration_seconds": 2.95,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.96,
      "end_seconds": 130.0,
      "duration_seconds": 1.04,
      "text": "Skin's normal."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.85,
      "end_seconds": 134.78,
      "duration_seconds": 2.93,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.71,
      "end_seconds": 140.41,
      "duration_seconds": 3.7,
      "text": "Mm, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.5,
      "end_seconds": 147.38,
      "duration_seconds": 4.88,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.56,
      "end_seconds": 151.42,
      "duration_seconds": 2.86,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.41,
      "end_seconds": 156.89,
      "duration_seconds": 3.48,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 158.91,
      "end_seconds": 164.99,
      "duration_seconds": 6.08,
      "text": "It's pantoprazole, 40 milligrams, before breakfast, doctor. He takes Digene, when it burns."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.43,
      "end_seconds": 180.31,
      "duration_seconds": 2.88,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.38,
      "end_seconds": 187.42,
      "duration_seconds": 5.04,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 188.77,
      "end_seconds": 192.03,
      "duration_seconds": 3.26,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.0,
      "end_seconds": 196.95,
      "duration_seconds": 2.95,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.26,
      "end_seconds": 200.21,
      "duration_seconds": 1.95,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.27,
      "end_seconds": 205.49,
      "duration_seconds": 3.22,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.34,
      "end_seconds": 218.91,
      "duration_seconds": 3.57,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.88,
      "end_seconds": 226.61,
      "duration_seconds": 6.73,
      "text": "Sorry, what was I saying, I have acid reflux, for two years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.75,
      "end_seconds": 234.57,
      "duration_seconds": 6.82,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.23,
      "end_seconds": 241.6,
      "duration_seconds": 4.37,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.72,
      "end_seconds": 244.81,
      "duration_seconds": 2.09,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.79,
      "end_seconds": 260.77,
      "duration_seconds": 1.98,
      "text": "Tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.8,
      "end_seconds": 266.9,
      "duration_seconds": 2.1,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.11,
      "end_seconds": 288.52,
      "duration_seconds": 10.41,
      "text": "Let me just check I've got this right. You've had food coming back up for five days, severe, and no trouble swallowing or pain on exertion."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.19,
      "end_seconds": 289.89,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.91,
      "end_seconds": 301.53,
      "duration_seconds": 10.62,
      "text": "I'm going to order an ECG, for chest discomfort. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.98,
      "end_seconds": 304.03,
      "duration_seconds": 1.05,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.69,
      "end_seconds": 324.51,
      "duration_seconds": 18.82,
      "text": "I'd like to arrange an upper endoscopy for persistent reflux. Smaller dinners, earlier in the evening, and prop up the head of the bed with a couple of extra pillows. Please come and see me in six weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.48,
      "end_seconds": 329.87,
      "duration_seconds": 3.39,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.51,
      "end_seconds": 331.78,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}