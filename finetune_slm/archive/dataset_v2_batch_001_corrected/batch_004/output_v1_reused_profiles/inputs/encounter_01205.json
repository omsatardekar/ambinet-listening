{
  "schema_version": "1.0",
  "encounter_id": "01205",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.92,
      "end_seconds": 4.34,
      "duration_seconds": 3.42,
      "text": "Okay, good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.12,
      "end_seconds": 7.16,
      "duration_seconds": 1.04,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.35,
      "end_seconds": 14.87,
      "duration_seconds": 2.52,
      "text": "Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 16.23,
      "end_seconds": 29.56,
      "duration_seconds": 13.33,
      "text": "I've been getting out of puff on the stairs. I took the morning off to come in today. I did try to ignore it for a while."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.41,
      "end_seconds": 34.0,
      "duration_seconds": 3.59,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 34.6,
      "end_seconds": 45.35,
      "duration_seconds": 10.75,
      "text": "About four days, I think... sorry, two days, I got that wrong. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.21,
      "end_seconds": 49.3,
      "duration_seconds": 2.09,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 49.96,
      "end_seconds": 57.03,
      "duration_seconds": 7.07,
      "text": "It's worse with carrying shopping. I've also been having put on weight, for ten days."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 74.21,
      "end_seconds": 82.53,
      "duration_seconds": 8.32,
      "text": "Doctor, I've got the readings for you. Temperature 36.8, saturation 98 percent, BP is 126 over 69, heart rate 69."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.5,
      "end_seconds": 85.55,
      "duration_seconds": 1.05,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 88.4,
      "end_seconds": 91.78,
      "duration_seconds": 3.38,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.63,
      "end_seconds": 95.09,
      "duration_seconds": 1.46,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.72,
      "end_seconds": 109.85,
      "duration_seconds": 6.13,
      "text": "Your BMI is on the high side and you look a little pale."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.52,
      "end_seconds": 118.16,
      "duration_seconds": 2.64,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.74,
      "end_seconds": 131.55,
      "duration_seconds": 2.81,
      "text": "Did you notice any calf swelling?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.1,
      "end_seconds": 135.0,
      "duration_seconds": 1.9,
      "text": "No. No calf swelling."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.54,
      "end_seconds": 142.73,
      "duration_seconds": 4.19,
      "text": "Alright, any chest pain, fever or wheezing at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.49,
      "end_seconds": 146.94,
      "duration_seconds": 3.45,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.97,
      "end_seconds": 151.22,
      "duration_seconds": 2.25,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.85,
      "end_seconds": 155.35,
      "duration_seconds": 2.5,
      "text": "Actually, no, skin's been fine."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.95,
      "end_seconds": 161.76,
      "duration_seconds": 4.81,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.63,
      "end_seconds": 165.88,
      "duration_seconds": 2.25,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.6,
      "end_seconds": 173.77,
      "duration_seconds": 4.17,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 174.32,
      "end_seconds": 178.22,
      "duration_seconds": 3.9,
      "text": "No, uh, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.59,
      "end_seconds": 182.42,
      "duration_seconds": 2.83,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 183.95,
      "end_seconds": 186.8,
      "duration_seconds": 2.85,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 187.68,
      "end_seconds": 190.42,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.3,
      "end_seconds": 195.33,
      "duration_seconds": 3.03,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.34,
      "end_seconds": 211.71,
      "duration_seconds": 2.37,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.29,
      "end_seconds": 216.62,
      "duration_seconds": 3.33,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.98,
      "end_seconds": 223.17,
      "duration_seconds": 2.19,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.2,
      "end_seconds": 229.76,
      "duration_seconds": 5.56,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.47,
      "end_seconds": 238.8,
      "duration_seconds": 8.33,
      "text": "Has anything ever caused you a reaction? I mean any allergies. Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.77,
      "end_seconds": 244.61,
      "duration_seconds": 3.84,
      "text": "So, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 246.16,
      "end_seconds": 255.58,
      "duration_seconds": 9.42,
      "text": "Okay, thinking it through, I don't have a clear answer today: breathlessness with several possible contributors is possible, and so is deconditioning."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 257.35,
      "end_seconds": 260.14,
      "duration_seconds": 2.79,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.13,
      "end_seconds": 272.71,
      "duration_seconds": 11.58,
      "text": "I understand the worry. At the moment I'd say it's breathlessness with several possible contributors, and we'll know more once the blood tests is back."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 287.53,
      "end_seconds": 301.47,
      "duration_seconds": 13.94,
      "text": "Blood tests is what I'd like next, for breathlessness. A short daily walk, building up slowly, is a sensible start. Let's review you after the results are back."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.61,
      "end_seconds": 305.58,
      "duration_seconds": 2.97,
      "text": "Alright, uh, I'll be back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.74,
      "end_seconds": 314.93,
      "duration_seconds": 6.19,
      "text": "So, how would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 316.45,
      "end_seconds": 322.95,
      "duration_seconds": 6.5,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.67,
      "end_seconds": 331.18,
      "duration_seconds": 6.51,
      "text": "Yes, exactly right. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 335.35,
      "end_seconds": 338.72,
      "duration_seconds": 3.37,
      "text": "Hmm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.46,
      "end_seconds": 341.83,
      "duration_seconds": 1.37,
      "text": "See you soon."
    }
  ]
}