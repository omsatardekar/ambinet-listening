{
  "schema_version": "1.0",
  "encounter_id": "01031",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.87,
      "end_seconds": 5.49,
      "duration_seconds": 4.62,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.13,
      "end_seconds": 13.33,
      "duration_seconds": 6.2,
      "text": "Hi doctor, I got here as fast as I could."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 18.79,
      "end_seconds": 24.41,
      "duration_seconds": 5.62,
      "text": "Yeah, morning, doctor. I'll stay and fill in anything that's missed."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.99,
      "end_seconds": 27.2,
      "duration_seconds": 1.21,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.81,
      "end_seconds": 43.52,
      "duration_seconds": 15.71,
      "text": "Right, honestly, it's a burning pain in the upper tummy, and my family pushed me to come. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.76,
      "end_seconds": 49.83,
      "duration_seconds": 6.07,
      "text": "Okay, go on. Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.56,
      "end_seconds": 55.52,
      "duration_seconds": 3.96,
      "text": "I'd say a few times a day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 56.91,
      "end_seconds": 59.26,
      "duration_seconds": 2.35,
      "text": "Have you been belching a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 65.28,
      "end_seconds": 82.28,
      "duration_seconds": 17.0,
      "text": "Yes, since Friday. Hmm, with belching a lot, about a three out of ten. Mm, you know, I've also had bloating after meals. As for bloating after meals, I'd say mild."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.86,
      "end_seconds": 84.43,
      "duration_seconds": 1.57,
      "text": "Any nausea as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.2,
      "end_seconds": 94.05,
      "duration_seconds": 4.85,
      "text": "Um, uh, yeah. Two days, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.08,
      "end_seconds": 103.13,
      "duration_seconds": 7.05,
      "text": "Have you had a burning pain in the upper tummy before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 103.98,
      "end_seconds": 110.48,
      "duration_seconds": 6.5,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 112.22,
      "end_seconds": 120.77,
      "duration_seconds": 8.55,
      "text": "Doctor, I've got the readings for you. Pulse is 83 beats a minute, temp 37.0 degrees, BP is 126 over 80."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.71,
      "end_seconds": 122.73,
      "duration_seconds": 1.02,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 125.61,
      "end_seconds": 127.56,
      "duration_seconds": 1.95,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.23,
      "end_seconds": 131.02,
      "duration_seconds": 1.79,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 132.28,
      "end_seconds": 133.52,
      "duration_seconds": 1.24,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 145.69,
      "end_seconds": 150.99,
      "duration_seconds": 5.3,
      "text": "Your tummy is soft, with mild tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.34,
      "end_seconds": 154.48,
      "duration_seconds": 2.14,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 168.26,
      "end_seconds": 170.58,
      "duration_seconds": 2.32,
      "text": "No guarding and no lumps."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.39,
      "end_seconds": 177.34,
      "duration_seconds": 2.95,
      "text": "So, that's all I needed to check."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.06,
      "end_seconds": 198.37,
      "duration_seconds": 4.31,
      "text": "A few quick ones: vomiting blood or trouble swallowing?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.59,
      "end_seconds": 203.4,
      "duration_seconds": 3.81,
      "text": "No, no vomiting blood or trouble swallowing."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 204.19,
      "end_seconds": 207.83,
      "duration_seconds": 3.64,
      "text": "A few quick ones: weight loss or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.43,
      "end_seconds": 213.54,
      "duration_seconds": 4.11,
      "text": "No, uh, nothing to report there."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.51,
      "end_seconds": 216.81,
      "duration_seconds": 2.3,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.72,
      "end_seconds": 219.81,
      "duration_seconds": 1.09,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.74,
      "end_seconds": 241.54,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 242.7,
      "end_seconds": 263.82,
      "duration_seconds": 21.12,
      "text": "Arthritis in my knees, for five years. Acid reflux, for five years. I have high cholesterol. Yeah, you know, I have an underactive thyroid, for about a year. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.88,
      "end_seconds": 274.06,
      "duration_seconds": 8.18,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 274.7,
      "end_seconds": 279.39,
      "duration_seconds": 4.69,
      "text": "I had an operation for a hernia last spring."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.11,
      "end_seconds": 297.23,
      "duration_seconds": 4.12,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 299.23,
      "end_seconds": 302.99,
      "duration_seconds": 3.76,
      "text": "Mm, you know, no allergies at all."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 304.11,
      "end_seconds": 312.88,
      "duration_seconds": 8.77,
      "text": "Actually, I remember she had some kind of reaction to amoxicillin before. I couldn't swear to it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 314.75,
      "end_seconds": 317.06,
      "duration_seconds": 2.31,
      "text": "I don't remember that."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.75,
      "end_seconds": 324.95,
      "duration_seconds": 6.2,
      "text": "Fair enough, I'll write down both versions. Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 326.1,
      "end_seconds": 328.53,
      "duration_seconds": 2.43,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.29,
      "end_seconds": 332.24,
      "duration_seconds": 1.95,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 334.17,
      "end_seconds": 338.55,
      "duration_seconds": 4.38,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 339.53,
      "end_seconds": 340.97,
      "duration_seconds": 1.44,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.67,
      "end_seconds": 345.67,
      "duration_seconds": 3.0,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.58,
      "end_seconds": 350.7,
      "duration_seconds": 4.12,
      "text": "Alright, what do you take on a normal day?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 352.54,
      "end_seconds": 378.52,
      "duration_seconds": 25.98,
      "text": "She is on pantoprazole, 40 milligrams, before breakfast, I give it to her. She is on atorvastatin, 20 milligrams, at night for my cholesterol, I give it to her. Ah, uh, she takes Thyronorm, 50 micrograms, every morning. Well, she is on Digene, when it burns, I give it to her."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 379.4,
      "end_seconds": 385.33,
      "duration_seconds": 5.93,
      "text": "I, I'd been on simvastatin, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 386.8,
      "end_seconds": 393.64,
      "duration_seconds": 6.84,
      "text": "Having listened and examined, this looks most like gastritis. Another possibility is acid reflux."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 394.16,
      "end_seconds": 397.11,
      "duration_seconds": 2.95,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.94,
      "end_seconds": 414.22,
      "duration_seconds": 15.28,
      "text": "I can't promise yet, but most people with gastritis do well once it's treated properly. Stop me if I've got anything wrong. You've had a burning pain in the upper tummy, and no fever or weight loss."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 415.77,
      "end_seconds": 417.41,
      "duration_seconds": 1.64,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 419.38,
      "end_seconds": 448.3,
      "duration_seconds": 28.92,
      "text": "Let's get blood tests, for dyspepsia. That will help us see what's going on underneath and decide the next step. I'm sending you for an upper endoscopy because of persistent dyspepsia. Avoid spicy, oily food and don't take anti-inflammatory painkillers on an empty stomach. Please don't wait if you vomit blood or pass black stools. That's when to be seen urgently."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 448.84,
      "end_seconds": 452.09,
      "duration_seconds": 3.25,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 454.05,
      "end_seconds": 463.25,
      "duration_seconds": 9.2,
      "text": "I'd like to see you again after the results are back. Before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 464.56,
      "end_seconds": 470.89,
      "duration_seconds": 6.33,
      "text": "So, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 474.67,
      "end_seconds": 479.08,
      "duration_seconds": 4.41,
      "text": "Yes, exactly right. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 479.87,
      "end_seconds": 482.92,
      "duration_seconds": 3.05,
      "text": "That's clear, um, thanks."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 484.0,
      "end_seconds": 485.21,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}