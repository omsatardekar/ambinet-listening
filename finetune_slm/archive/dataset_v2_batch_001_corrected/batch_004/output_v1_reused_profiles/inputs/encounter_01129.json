{
  "schema_version": "1.0",
  "encounter_id": "01129",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 6.97,
      "duration_seconds": 5.63,
      "text": "So, you know, hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.17,
      "end_seconds": 12.46,
      "duration_seconds": 4.29,
      "text": "yes, have a seat tell me what's going on"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.39,
      "end_seconds": 20.39,
      "duration_seconds": 7.0,
      "text": "Yeah, you know, it's a rattling chest. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.56,
      "end_seconds": 24.6,
      "duration_seconds": 3.04,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.37,
      "end_seconds": 47.81,
      "duration_seconds": 17.44,
      "text": "So, I'd say three weeks. Actually, no, closer to about two weeks. My family kept telling me to get it checked. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.9,
      "end_seconds": 53.14,
      "duration_seconds": 3.24,
      "text": "Right, how much does it limit you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.83,
      "end_seconds": 59.43,
      "duration_seconds": 5.6,
      "text": "Ah, you know, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.29,
      "end_seconds": 63.76,
      "duration_seconds": 2.47,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.59,
      "end_seconds": 88.32,
      "duration_seconds": 21.73,
      "text": "A wheeze goes along with it, most of the time. So, um, I've also been coughing up green phlegm, for about four days. With coughing up green phlegm, about a six out of ten. With wheeze, honestly, once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.58,
      "end_seconds": 92.75,
      "duration_seconds": 4.17,
      "text": "I follow. Any fever, swollen ankles or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.93,
      "end_seconds": 98.44,
      "duration_seconds": 4.51,
      "text": "No, no fever, swollen ankles or weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.27,
      "end_seconds": 102.06,
      "duration_seconds": 1.79,
      "text": "Any coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.65,
      "end_seconds": 109.91,
      "duration_seconds": 6.26,
      "text": "Oh, um, not at all, no coughing up blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.78,
      "end_seconds": 115.14,
      "duration_seconds": 3.36,
      "text": "So, any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.62,
      "end_seconds": 120.8,
      "duration_seconds": 1.18,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.36,
      "end_seconds": 124.27,
      "duration_seconds": 2.91,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.89,
      "end_seconds": 136.5,
      "duration_seconds": 10.61,
      "text": "Telmisartan, 40 milligrams, once a day. Mm, I take Tiotropium inhaler, once a day for my chest"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.06,
      "end_seconds": 145.23,
      "duration_seconds": 1.17,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.75,
      "end_seconds": 150.36,
      "duration_seconds": 3.61,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.03,
      "end_seconds": 169.93,
      "duration_seconds": 3.9,
      "text": "tell me about any past illnesses or ongoing conditions"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.15,
      "end_seconds": 177.97,
      "duration_seconds": 6.82,
      "text": "I have high blood pressure. I, I have COPD, for about ten years"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.54,
      "end_seconds": 187.89,
      "duration_seconds": 9.35,
      "text": "Okay, I can see high blood pressure in your file as well. What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.29,
      "end_seconds": 192.91,
      "duration_seconds": 3.62,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.66,
      "end_seconds": 197.08,
      "duration_seconds": 2.42,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.44,
      "end_seconds": 202.73,
      "duration_seconds": 4.29,
      "text": "Not much, I mostly stay in these days"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.16,
      "end_seconds": 225.6,
      "duration_seconds": 4.44,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 227.64,
      "end_seconds": 238.04,
      "duration_seconds": 10.4,
      "text": "Right, yes, grass pollen. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.76,
      "end_seconds": 241.05,
      "duration_seconds": 2.29,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.18,
      "end_seconds": 252.72,
      "duration_seconds": 2.54,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.65,
      "end_seconds": 276.28,
      "duration_seconds": 9.63,
      "text": "Okay: blood pressure 120 over 73, temp 36.7 degrees, respiratory rate 23, pulse 98, oxygen saturation is 94 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.45,
      "end_seconds": 279.02,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.43,
      "end_seconds": 283.69,
      "duration_seconds": 3.26,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.08,
      "end_seconds": 289.72,
      "duration_seconds": 3.64,
      "text": "right, let's have a proper look at you"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.41,
      "end_seconds": 293.86,
      "duration_seconds": 2.45,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.52,
      "end_seconds": 312.82,
      "duration_seconds": 5.3,
      "text": "Air entry is reduced on both sides with a prolonged breathing out phase."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.83,
      "end_seconds": 315.15,
      "duration_seconds": 1.32,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.38,
      "end_seconds": 337.52,
      "duration_seconds": 4.14,
      "text": "there's some wheeze, and no swelling in the legs"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.14,
      "end_seconds": 357.19,
      "duration_seconds": 14.05,
      "text": "You can sit up now. From what you've told me and what I found, I think we're dealing with a flare-up of COPD at this stage. We shouldn't forget pneumonia."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.83,
      "end_seconds": 362.56,
      "duration_seconds": 4.73,
      "text": "Right, um, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.79,
      "end_seconds": 387.49,
      "duration_seconds": 23.7,
      "text": "I understand the worry. At the moment I'd say it's a flare-up of COPD, and we'll know more once the a sputum culture is back. I'd like to arrange a sputum culture for productive cough. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 388.83,
      "end_seconds": 393.5,
      "duration_seconds": 4.67,
      "text": "We have a slot Friday at 9 am, if that works."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 394.03,
      "end_seconds": 397.74,
      "duration_seconds": 3.71,
      "text": "I'd like to arrange blood tests for infective exacerbation."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 398.27,
      "end_seconds": 401.24,
      "duration_seconds": 2.97,
      "text": "Do I need to prepare?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 401.88,
      "end_seconds": 412.23,
      "duration_seconds": 10.35,
      "text": "I'm going to put you on prednisolone, 30 milligrams, once a day, for five days. That should help with COPD flare-up."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.04,
      "end_seconds": 418.95,
      "duration_seconds": 1.91,
      "text": "Thank you, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 420.22,
      "end_seconds": 441.26,
      "duration_seconds": 21.04,
      "text": "you'll be taking doxycycline, 100 milligrams, twice a day, for five days. It's for chest infection. Come back or go to emergency straight away if you become more breathless or your lips turn blue. Please come and see me in one week"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 442.29,
      "end_seconds": 446.34,
      "duration_seconds": 4.05,
      "text": "I, I'll note it in my calendar."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 448.09,
      "end_seconds": 450.86,
      "duration_seconds": 2.77,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 452.64,
      "end_seconds": 456.55,
      "duration_seconds": 3.91,
      "text": "Right, I'll do that. Thank you, doctor."
    }
  ]
}