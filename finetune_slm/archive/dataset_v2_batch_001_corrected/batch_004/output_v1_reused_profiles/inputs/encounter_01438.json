  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.76,
      "end_seconds": 6.9,
      "duration_seconds": 6.14,
      "text": "Right, thanks for waiting, come in. How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.5,
      "end_seconds": 16.96,
      "duration_seconds": 9.46,
      "text": "Okay, so so the thing is, I've got aching in my thighs. I've never really been one for hospitals."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 17.97,
      "end_seconds": 22.31,
      "duration_seconds": 4.34,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.4,
      "end_seconds": 30.49,
      "duration_seconds": 7.09,
      "text": "it's been about two weeks, I'm fairly sure i told my wife I'd come today"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.74,
      "end_seconds": 34.46,
      "duration_seconds": 3.72,
      "text": "mm, okay i'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.34,
      "end_seconds": 45.32,
      "duration_seconds": 1.98,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.59,
      "end_seconds": 68.66,
      "duration_seconds": 7.07,
      "text": "okay: temp 36.9 degrees, pressure 114 over 75, pulse 65. And saturation 97 percent"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 69.66,
      "end_seconds": 71.27,
      "duration_seconds": 1.61,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.78,
      "end_seconds": 74.57,
      "duration_seconds": 2.79,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 75.79,
      "end_seconds": 79.27,
      "duration_seconds": 3.48,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.47,
      "end_seconds": 82.92,
      "duration_seconds": 2.45,
      "text": "Right, I'm just checking this side."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.39,
      "end_seconds": 98.83,
      "duration_seconds": 3.44,
      "text": "The muscles are mildly tender when I squeeze."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.66,
      "end_seconds": 103.27,
      "duration_seconds": 1.61,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.54,
      "end_seconds": 113.19,
      "duration_seconds": 1.65,
      "text": "What about trouble swallowing?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 115.18,
      "end_seconds": 117.35,
      "duration_seconds": 2.17,
      "text": "No trouble swallowing, thankfully."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 118.27,
      "end_seconds": 121.99,
      "duration_seconds": 3.72,
      "text": "Any fever or recent heavy exercise at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.76,
      "end_seconds": 126.49,
      "duration_seconds": 2.73,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 127.36,
      "end_seconds": 130.56,
      "duration_seconds": 3.2,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.11,
      "end_seconds": 134.4,
      "duration_seconds": 3.29,
      "text": "No, uh, nothing with my heart."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 136.28,
      "end_seconds": 140.74,
      "duration_seconds": 4.46,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.81,
      "end_seconds": 147.48,
      "duration_seconds": 4.67,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.34,
      "end_seconds": 150.99,
      "duration_seconds": 2.65,
      "text": "So, what about your medical history?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 152.78,
      "end_seconds": 161.23,
      "duration_seconds": 8.45,
      "text": "Uh, I have high blood pressure. My family kept telling me to get it checked."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.88,
      "end_seconds": 168.23,
      "duration_seconds": 6.35,
      "text": "Right, so high blood pressure is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.17,
      "end_seconds": 182.18,
      "duration_seconds": 3.01,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.56,
      "end_seconds": 188.62,
      "duration_seconds": 2.06,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.97,
      "end_seconds": 191.84,
      "duration_seconds": 1.87,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.29,
      "end_seconds": 200.26,
      "duration_seconds": 4.97,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.87,
      "end_seconds": 203.33,
      "duration_seconds": 2.46,
      "text": "do you live by yourself?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 204.23,
      "end_seconds": 208.19,
      "duration_seconds": 3.96,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.09,
      "end_seconds": 210.69,
      "duration_seconds": 1.6,
      "text": "Have you retired yet?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.43,
      "end_seconds": 215.64,
      "duration_seconds": 4.21,
      "text": "I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.28,
      "end_seconds": 236.48,
      "duration_seconds": 3.2,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 238.25,
      "end_seconds": 243.37,
      "duration_seconds": 5.12,
      "text": "Yes, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.24,
      "end_seconds": 265.38,
      "duration_seconds": 4.14,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.32,
      "end_seconds": 273.95,
      "duration_seconds": 6.63,
      "text": "Amlodipine. I take it 5 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.57,
      "end_seconds": 296.34,
      "duration_seconds": 20.77,
      "text": "taking everything into account, this is probably muscle symptoms that may be related to the cholesterol tablet. I'll request a vitamin D level, it'll help with muscle weakness. The result will help us decide whether anything more is needed. I think we're done unless you have questions"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 297.95,
      "end_seconds": 300.55,
      "duration_seconds": 2.6,
      "text": "Mm, alright, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.94,
      "end_seconds": 303.19,
      "duration_seconds": 1.25,
      "text": "all the best"
    }
  ]
