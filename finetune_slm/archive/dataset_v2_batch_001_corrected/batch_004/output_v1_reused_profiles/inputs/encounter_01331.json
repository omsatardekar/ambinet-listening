      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.48,
      "end_seconds": 110.91,
      "duration_seconds": 3.43,
      "text": "that's normal as far as I know"
