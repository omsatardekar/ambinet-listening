    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.22,
      "end_seconds": 106.18,
      "duration_seconds": 1.96,
      "text": "any trouble with the waterworks?"
