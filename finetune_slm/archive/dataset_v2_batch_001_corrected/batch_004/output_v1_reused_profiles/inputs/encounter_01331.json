      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 237.53,
      "end_seconds": 241.11,
      "duration_seconds": 3.58,
      "text": "Do you take any prescribed or over-the-counter medicines?"
