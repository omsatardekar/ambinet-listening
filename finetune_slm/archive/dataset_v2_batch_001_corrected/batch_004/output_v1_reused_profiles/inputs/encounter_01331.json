      "role": "DOCTOR",
      "start_seconds": 112.82,
      "end_seconds": 116.61,
      "duration_seconds": 3.79,
      "text": "Alright, anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.13,
      "end_seconds": 120.63,
      "duration_seconds": 2.5,
      "text": "No, that's all normal."
