    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 30.81,
      "end_seconds": 32.96,
      "duration_seconds": 2.15,
      "text": "I'll do your observations first."
