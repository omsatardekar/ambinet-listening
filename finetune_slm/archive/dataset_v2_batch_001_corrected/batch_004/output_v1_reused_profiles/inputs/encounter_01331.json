      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.43,
      "end_seconds": 91.41,
      "duration_seconds": 3.98,
      "text": "no, uh, I'd have said so"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.04,
      "end_seconds": 97.34,
      "duration_seconds": 5.3,
      "text": "Let me check a few things. Any irregular periods or increased thirst?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.4,
      "end_seconds": 102.44,
      "duration_seconds": 4.04,
      "text": "No, I haven't had any of them."
