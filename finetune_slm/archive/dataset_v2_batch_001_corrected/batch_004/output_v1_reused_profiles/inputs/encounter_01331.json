    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.84,
      "end_seconds": 142.22,
      "duration_seconds": 3.38,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.33,
      "end_seconds": 151.07,
      "duration_seconds": 3.74,
      "text": "no, I'm not allergic to anything"
