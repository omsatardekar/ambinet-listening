      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 241.61,
      "end_seconds": 250.26,
      "duration_seconds": 8.65,
      "text": "It's, It's simvastatin, 20 milligrams, at night. Glimepiride, 2 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.95,
      "end_seconds": 255.61,
      "duration_seconds": 3.66,
      "text": "Let me look at the area, I'll be gentle."
