{
  "schema_version": "1.0",
  "encounter_id": "01195",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.74,
      "end_seconds": 4.76,
      "duration_seconds": 4.02,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.6,
      "end_seconds": 10.83,
      "duration_seconds": 4.23,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.32,
      "end_seconds": 19.01,
      "duration_seconds": 6.69,
      "text": "I've been passing out once last week, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.52,
      "end_seconds": 25.07,
      "duration_seconds": 2.55,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.14,
      "end_seconds": 28.78,
      "duration_seconds": 2.64,
      "text": "No, nothing at the moment."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.55,
      "end_seconds": 53.55,
      "duration_seconds": 6.0,
      "text": "Did it come on recently? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.01,
      "end_seconds": 71.35,
      "duration_seconds": 16.34,
      "text": "I've had it for three days. I'd rather not end up on lots of tablets if I can avoid it. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.57,
      "end_seconds": 77.68,
      "duration_seconds": 5.11,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.19,
      "end_seconds": 91.22,
      "duration_seconds": 12.03,
      "text": "I get some relief from lying down. It happens all the time. Mostly mild. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.25,
      "end_seconds": 111.04,
      "duration_seconds": 2.79,
      "text": "Did you notice any chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.06,
      "end_seconds": 117.38,
      "duration_seconds": 4.32,
      "text": "No, uh, I haven't had any chest pain."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.0,
      "end_seconds": 123.61,
      "duration_seconds": 4.61,
      "text": "Have you noticed shaking or jerking, palpitations or tongue biting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.46,
      "end_seconds": 126.97,
      "duration_seconds": 2.51,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.77,
      "end_seconds": 132.65,
      "duration_seconds": 3.88,
      "text": "What about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.55,
      "end_seconds": 135.34,
      "duration_seconds": 1.79,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.25,
      "end_seconds": 142.16,
      "duration_seconds": 3.91,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.69,
      "end_seconds": 145.13,
      "duration_seconds": 1.44,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.23,
      "end_seconds": 150.49,
      "duration_seconds": 1.26,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.37,
      "end_seconds": 153.42,
      "duration_seconds": 1.05,
      "text": "No, never."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.0,
      "end_seconds": 169.29,
      "duration_seconds": 3.29,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.97,
      "end_seconds": 171.45,
      "duration_seconds": 1.48,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.86,
      "end_seconds": 177.44,
      "duration_seconds": 4.58,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.13,
      "end_seconds": 189.44,
      "duration_seconds": 10.31,
      "text": "Okay, um, so I was told I'm allergic to wheat, but I don't remember what reaction I had."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.1,
      "end_seconds": 197.37,
      "duration_seconds": 2.27,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.38,
      "end_seconds": 204.07,
      "duration_seconds": 5.69,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.85,
      "end_seconds": 209.29,
      "duration_seconds": 3.44,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.08,
      "end_seconds": 214.07,
      "duration_seconds": 3.99,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.72,
      "end_seconds": 216.0,
      "duration_seconds": 1.28,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.23,
      "end_seconds": 220.16,
      "duration_seconds": 2.93,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.12,
      "end_seconds": 223.93,
      "duration_seconds": 2.81,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.65,
      "end_seconds": 234.05,
      "duration_seconds": 2.4,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.85,
      "end_seconds": 260.84,
      "duration_seconds": 7.99,
      "text": "Okay: pulse 72, blood pressure 113 over 77. And temperature is 36.8 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.8,
      "end_seconds": 265.84,
      "duration_seconds": 2.04,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.43,
      "end_seconds": 270.08,
      "duration_seconds": 2.65,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.9,
      "end_seconds": 279.49,
      "duration_seconds": 1.59,
      "text": "No murmurs on listening."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.79,
      "end_seconds": 283.16,
      "duration_seconds": 2.37,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.27,
      "end_seconds": 302.22,
      "duration_seconds": 6.95,
      "text": "Your pulse is regular and there's a small bruise on the right side of the head."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.87,
      "end_seconds": 309.54,
      "duration_seconds": 1.67,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.86,
      "end_seconds": 348.89,
      "duration_seconds": 31.03,
      "text": "Okay, thinking it through, my working impression is a simple faint, probably reflex-related. I'm going to order an echocardiogram, for syncope. Drink enough water and avoid standing still for long stretches, and sit if you feel it coming. The thing that would worry me is if you pass out again, especially with chest pain or palpitations. If that happens, go to emergency. I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 349.97,
      "end_seconds": 355.12,
      "duration_seconds": 5.15,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.89,
      "end_seconds": 359.93,
      "duration_seconds": 2.04,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.78,
      "end_seconds": 362.99,
      "duration_seconds": 1.21,
      "text": "Look after yourself."
    }
  ]
}