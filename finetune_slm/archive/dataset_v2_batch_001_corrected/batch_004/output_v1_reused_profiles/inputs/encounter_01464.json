{
  "schema_version": "1.0",
  "encounter_id": "01464",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.56,
      "end_seconds": 5.55,
      "duration_seconds": 4.99,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.63,
      "end_seconds": 12.14,
      "duration_seconds": 4.51,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.92,
      "end_seconds": 19.34,
      "duration_seconds": 5.42,
      "text": "Mainly I've been losing weight without trying. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.69,
      "end_seconds": 23.69,
      "duration_seconds": 3.0,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.7,
      "end_seconds": 27.89,
      "duration_seconds": 3.19,
      "text": "For about a year, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.13,
      "end_seconds": 31.89,
      "duration_seconds": 2.76,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.53,
      "end_seconds": 42.32,
      "duration_seconds": 8.79,
      "text": "It usually comes with a poor appetite. So, the poor appetite? That's been for about a month."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.92,
      "end_seconds": 48.27,
      "duration_seconds": 5.35,
      "text": "Have you been losing weight without trying at any time before this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.76,
      "end_seconds": 56.35,
      "duration_seconds": 6.59,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 57.61,
      "end_seconds": 61.15,
      "duration_seconds": 3.54,
      "text": "Okay, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.35,
      "end_seconds": 65.32,
      "duration_seconds": 2.97,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.51,
      "end_seconds": 83.6,
      "duration_seconds": 4.09,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 84.53,
      "end_seconds": 87.94,
      "duration_seconds": 3.41,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.34,
      "end_seconds": 106.26,
      "duration_seconds": 2.92,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.8,
      "end_seconds": 115.08,
      "duration_seconds": 4.28,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.05,
      "end_seconds": 117.8,
      "duration_seconds": 1.75,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.93,
      "end_seconds": 124.5,
      "duration_seconds": 2.57,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.39,
      "end_seconds": 127.96,
      "duration_seconds": 2.57,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.23,
      "end_seconds": 133.37,
      "duration_seconds": 4.14,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.03,
      "end_seconds": 139.32,
      "duration_seconds": 3.29,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.96,
      "end_seconds": 149.85,
      "duration_seconds": 8.89,
      "text": "I mean, you know, yes, I had keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.97,
      "end_seconds": 159.05,
      "duration_seconds": 8.08,
      "text": "Any health conditions I should have on record? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.78,
      "end_seconds": 162.03,
      "duration_seconds": 2.25,
      "text": "I've got high cholesterol."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.73,
      "end_seconds": 167.62,
      "duration_seconds": 3.89,
      "text": "Right, right. Have you noticed vomiting or difficulty swallowing?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.38,
      "end_seconds": 173.9,
      "duration_seconds": 4.52,
      "text": "I haven't had vomiting or difficulty swallowing, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.78,
      "end_seconds": 179.13,
      "duration_seconds": 4.35,
      "text": "Have you noticed blood in the stool or bone pain?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.29,
      "end_seconds": 185.94,
      "duration_seconds": 5.65,
      "text": "Ah, uh, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.02,
      "end_seconds": 189.82,
      "duration_seconds": 2.8,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.57,
      "end_seconds": 194.41,
      "duration_seconds": 2.84,
      "text": "Erm, no, that's all fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.93,
      "end_seconds": 196.4,
      "duration_seconds": 1.47,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.92,
      "end_seconds": 200.95,
      "duration_seconds": 3.03,
      "text": "Oh, no, that's all normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.51,
      "end_seconds": 207.45,
      "duration_seconds": 4.94,
      "text": "Okay, now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.03,
      "end_seconds": 209.15,
      "duration_seconds": 1.12,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.04,
      "end_seconds": 212.28,
      "duration_seconds": 1.24,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.57,
      "end_seconds": 234.33,
      "duration_seconds": 4.76,
      "text": "Your tummy is soft and I can't feel any lumps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.82,
      "end_seconds": 241.26,
      "duration_seconds": 2.44,
      "text": "Okay, you can relax now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.33,
      "end_seconds": 271.84,
      "duration_seconds": 13.51,
      "text": "Okay, so my impression is this: I can't pin this down yet. We're looking at an unexplained weight loss that needs a proper work-up or an overactive thyroid."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.06,
      "end_seconds": 283.06,
      "duration_seconds": 6.0,
      "text": "Hmm, you know, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.9,
      "end_seconds": 304.59,
      "duration_seconds": 20.69,
      "text": "I can't promise yet, but most people with an unexplained weight loss that needs a proper work-up do well once it's treated properly. Let me repeat that back to make sure. You've been losing weight without trying for about a year, and no bone pain or difficulty swallowing."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.75,
      "end_seconds": 308.98,
      "duration_seconds": 3.23,
      "text": "Yes, um, you've got it."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.67,
      "end_seconds": 320.4,
      "duration_seconds": 10.73,
      "text": "I think a chest X-ray makes sense here, for cough and weight loss. I'd rather check than guess, and this is the quickest way to know more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 321.43,
      "end_seconds": 325.35,
      "duration_seconds": 3.92,
      "text": "I can book that for Wednesday at 9 am."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.36,
      "end_seconds": 342.83,
      "duration_seconds": 15.47,
      "text": "Weigh yourself once a week at the same time and note it down. Cut down on salt and fried food for now, it really does make a difference. Let's review you in two weeks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.54,
      "end_seconds": 345.24,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.61,
      "end_seconds": 352.73,
      "duration_seconds": 6.12,
      "text": "Tell me what you've taken from all that, so I can fill in any gaps."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.36,
      "end_seconds": 361.3,
      "duration_seconds": 6.94,
      "text": "So, you know, I come back in two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.28,
      "end_seconds": 367.03,
      "duration_seconds": 3.75,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.11,
      "end_seconds": 374.13,
      "duration_seconds": 5.02,
      "text": "Sorry, what was I saying, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.08,
      "end_seconds": 377.87,
      "duration_seconds": 1.79,
      "text": "Have a good day."
    }
  ]
}