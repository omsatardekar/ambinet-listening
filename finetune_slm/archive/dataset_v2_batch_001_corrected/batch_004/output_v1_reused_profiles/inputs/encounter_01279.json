{
  "schema_version": "1.0",
  "encounter_id": "01279",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.84,
      "end_seconds": 6.27,
      "duration_seconds": 5.43,
      "text": "Good morning. I've just opened your notes. What do you need help with?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.48,
      "end_seconds": 20.36,
      "duration_seconds": 12.88,
      "text": "I wanted to get a very painful, swollen big toe looked at i looked a few things up online, and that probably didn't help"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.86,
      "end_seconds": 24.77,
      "duration_seconds": 3.91,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.41,
      "end_seconds": 30.0,
      "duration_seconds": 3.59,
      "text": "Hmm, for ten days, I'd say."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.92,
      "end_seconds": 43.42,
      "duration_seconds": 10.5,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.31,
      "end_seconds": 55.72,
      "duration_seconds": 11.41,
      "text": "I'd say all the time. A four out of ten, I suppose. I notice it more with the bedsheet touching it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.2,
      "end_seconds": 59.56,
      "duration_seconds": 2.36,
      "text": "Is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.07,
      "end_seconds": 79.37,
      "duration_seconds": 19.3,
      "text": "Ah, you know, when it starts I tend to get trouble walking as well. I've also had a low fever, for about four days. Mm, about low fever, I'd give it a four, out of ten."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.37,
      "end_seconds": 85.45,
      "duration_seconds": 2.08,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 99.25,
      "end_seconds": 101.56,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.03,
      "end_seconds": 119.5,
      "duration_seconds": 8.47,
      "text": "Okay: pulse 76, temperature 36.9, SpO2 98 percent on room air, respiratory rate 16, BP is 124 over 75."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 121.06,
      "end_seconds": 124.31,
      "duration_seconds": 3.25,
      "text": "Is that alright, um, doctor?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.87,
      "end_seconds": 132.36,
      "duration_seconds": 2.49,
      "text": "that's fine, I'll explain it soon"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.02,
      "end_seconds": 136.47,
      "duration_seconds": 2.45,
      "text": "shall I start the examination?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 138.32,
      "end_seconds": 139.64,
      "duration_seconds": 1.32,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.99,
      "end_seconds": 159.74,
      "duration_seconds": 5.75,
      "text": "The big toe joint is red, hot, swollen and extremely tender to touch."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 162.71,
      "end_seconds": 165.47,
      "duration_seconds": 2.76,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.44,
      "end_seconds": 178.48,
      "duration_seconds": 4.04,
      "text": "Have you noticed recent illness, kidney problems or chills?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.87,
      "end_seconds": 184.62,
      "duration_seconds": 4.75,
      "text": "Let me think, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.33,
      "end_seconds": 188.05,
      "duration_seconds": 2.72,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 188.84,
      "end_seconds": 190.69,
      "duration_seconds": 1.85,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.72,
      "end_seconds": 198.83,
      "duration_seconds": 2.11,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.88,
      "end_seconds": 202.15,
      "duration_seconds": 2.27,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 203.56,
      "end_seconds": 207.13,
      "duration_seconds": 3.57,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 211.44,
      "end_seconds": 215.87,
      "duration_seconds": 4.43,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.74,
      "end_seconds": 221.17,
      "duration_seconds": 3.43,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 222.75,
      "end_seconds": 225.89,
      "duration_seconds": 3.14,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.31,
      "end_seconds": 228.88,
      "duration_seconds": 1.57,
      "text": "And And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.94,
      "end_seconds": 233.83,
      "duration_seconds": 3.89,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.46,
      "end_seconds": 245.41,
      "duration_seconds": 2.95,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.06,
      "end_seconds": 260.72,
      "duration_seconds": 14.66,
      "text": "I had a a triple bypass eight years ago. I did try to ignore it for a while. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.95,
      "end_seconds": 266.03,
      "duration_seconds": 4.08,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 267.13,
      "end_seconds": 268.43,
      "duration_seconds": 1.3,
      "text": "Yes, gout."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.04,
      "end_seconds": 272.03,
      "duration_seconds": 1.99,
      "text": "I see, go ahead."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 273.49,
      "end_seconds": 282.66,
      "duration_seconds": 9.17,
      "text": "High blood pressure, for nearly five years. Sorry, I know I'm rambling a bit. Yes, heart disease."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.22,
      "end_seconds": 289.84,
      "duration_seconds": 6.62,
      "text": "Okay, I can see gout and high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 301.25,
      "end_seconds": 304.88,
      "duration_seconds": 3.63,
      "text": "which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.82,
      "end_seconds": 316.2,
      "duration_seconds": 10.38,
      "text": "I take febuxostat, 80 milligrams, once a day. Well, I'm on valsartan, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.04,
      "end_seconds": 320.92,
      "duration_seconds": 2.88,
      "text": "so, and what strength is that?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 321.65,
      "end_seconds": 329.69,
      "duration_seconds": 8.04,
      "text": "80 milligrams. Sorry, what was I saying, I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.17,
      "end_seconds": 346.38,
      "duration_seconds": 12.21,
      "text": "Let me tell you where I've got to. This is probably an acute gout flare. Pseudogout is also on my list. Kidney function tests is what I'd like next, for gout."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 352.1,
      "end_seconds": 354.67,
      "duration_seconds": 2.57,
      "text": "the earliest is Wednesday, 10 am"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 356.51,
      "end_seconds": 357.52,
      "duration_seconds": 1.01,
      "text": "that's fine"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.39,
      "end_seconds": 367.46,
      "duration_seconds": 9.07,
      "text": "What I'm giving you is naproxen, 500 milligrams, twice a day after food, for five days. That should help with gout flare."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 368.18,
      "end_seconds": 370.81,
      "duration_seconds": 2.63,
      "text": "how soon will it work?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 375.7,
      "end_seconds": 385.04,
      "duration_seconds": 9.34,
      "text": "Cut right back on red meat, organ meats, beer and sugary drinks, and drink plenty of water. Come back in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 386.15,
      "end_seconds": 389.23,
      "duration_seconds": 3.08,
      "text": "Um, alright, I'll be back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.2,
      "end_seconds": 392.77,
      "duration_seconds": 2.57,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 393.49,
      "end_seconds": 397.61,
      "duration_seconds": 4.12,
      "text": "Well, great, thank you for your help."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.45,
      "end_seconds": 400.17,
      "duration_seconds": 1.72,
      "text": "Have a good day."
    }
  ]
}