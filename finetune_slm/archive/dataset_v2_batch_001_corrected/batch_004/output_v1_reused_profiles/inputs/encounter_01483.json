{
  "schema_version": "1.0",
  "encounter_id": "01483",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 5.94,
      "duration_seconds": 4.6,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 10.93,
      "duration_seconds": 4.24,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.09,
      "end_seconds": 20.61,
      "duration_seconds": 8.52,
      "text": "Mainly headaches in the morning. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.95,
      "end_seconds": 25.83,
      "duration_seconds": 4.88,
      "text": "Understood. Has there been a pounding feeling in your neck too?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.68,
      "end_seconds": 29.43,
      "duration_seconds": 2.75,
      "text": "Mm, yes, for two years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 30.15,
      "end_seconds": 32.69,
      "duration_seconds": 2.54,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.49,
      "end_seconds": 43.7,
      "duration_seconds": 3.21,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.34,
      "end_seconds": 60.71,
      "duration_seconds": 6.37,
      "text": "Okay: blood pressure 157 over 103, heart rate 83, temp 36.6 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.59,
      "end_seconds": 66.23,
      "duration_seconds": 2.64,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.75,
      "end_seconds": 68.92,
      "duration_seconds": 1.17,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.09,
      "end_seconds": 91.24,
      "duration_seconds": 6.15,
      "text": "The back of your eyes looks fine and your heart sounds are normal."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.89,
      "end_seconds": 98.0,
      "duration_seconds": 2.11,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.17,
      "end_seconds": 114.4,
      "duration_seconds": 6.23,
      "text": "A few quick ones: ankle swelling, weakness on one side or passing less urine?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 115.39,
      "end_seconds": 122.95,
      "duration_seconds": 7.56,
      "text": "No ankle swelling, weakness on one side or passing less urine, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.55,
      "end_seconds": 128.23,
      "duration_seconds": 4.68,
      "text": "Have you had any shortness of breath or chest pain?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.74,
      "end_seconds": 134.9,
      "duration_seconds": 6.16,
      "text": "I haven't had shortness of breath or chest pain, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.82,
      "end_seconds": 139.45,
      "duration_seconds": 2.63,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.32,
      "end_seconds": 144.44,
      "duration_seconds": 4.12,
      "text": "Oh, you know, no, all normal there."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.43,
      "end_seconds": 150.23,
      "duration_seconds": 3.8,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.44,
      "end_seconds": 162.45,
      "duration_seconds": 9.01,
      "text": "Amlodipine, 5 milligrams, once a day. Hmm, I was on losartan before. I stopped taking it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.97,
      "end_seconds": 167.61,
      "duration_seconds": 4.64,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.29,
      "end_seconds": 181.14,
      "duration_seconds": 11.85,
      "text": "I retired from the post office two years ago. My husband and I live above the shop. I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.11,
      "end_seconds": 184.72,
      "duration_seconds": 2.61,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.8,
      "end_seconds": 189.8,
      "duration_seconds": 4.0,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.99,
      "end_seconds": 194.25,
      "duration_seconds": 3.26,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.36,
      "end_seconds": 202.95,
      "duration_seconds": 7.59,
      "text": "High cholesterol, for two years. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.8,
      "end_seconds": 205.5,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 208.37,
      "end_seconds": 214.31,
      "duration_seconds": 5.94,
      "text": "I mean, I have high blood pressure, for nearly five years."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.38,
      "end_seconds": 222.59,
      "duration_seconds": 7.21,
      "text": "Right, so high cholesterol is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.63,
      "end_seconds": 245.37,
      "duration_seconds": 4.74,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.8,
      "end_seconds": 250.49,
      "duration_seconds": 3.69,
      "text": "I mean, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.12,
      "end_seconds": 284.74,
      "duration_seconds": 28.62,
      "text": "Taking everything into account, my working impression is poorly controlled high blood pressure. The reason I say that is that your story and my examination fit together. Another possibility is a side effect of a medicine. A home blood pressure diary is what I'd like next, for hypertension. I'll request blood tests, it'll help with hypertension. Check your blood pressure at home twice a day for a week and bring the readings."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.3,
      "end_seconds": 297.24,
      "duration_seconds": 10.94,
      "text": "Please don't wait if you get chest pain, weakness or trouble speaking. That's when to be seen urgently. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.28,
      "end_seconds": 302.8,
      "duration_seconds": 3.52,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.89,
      "end_seconds": 306.93,
      "duration_seconds": 2.04,
      "text": "Okay, look after yourself."
    }
  ]
}