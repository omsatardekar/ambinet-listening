{
  "schema_version": "1.0",
  "encounter_id": "01328",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 3.06,
      "duration_seconds": 1.7,
      "text": "morning, come on through"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.9,
      "end_seconds": 12.43,
      "duration_seconds": 5.53,
      "text": "mm, um, hello, thanks for fitting me in"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 17.46,
      "end_seconds": 21.5,
      "duration_seconds": 4.04,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.36,
      "end_seconds": 29.85,
      "duration_seconds": 6.49,
      "text": "Yes, that's no problem at all. Please sit. You came on your own today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.24,
      "end_seconds": 35.77,
      "duration_seconds": 4.53,
      "text": "Ah, yes, I managed on my own."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.37,
      "end_seconds": 39.49,
      "duration_seconds": 2.12,
      "text": "so, where shall we begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.68,
      "end_seconds": 45.32,
      "duration_seconds": 4.64,
      "text": "She's been having a bump on my head, doctor."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.37,
      "end_seconds": 50.56,
      "duration_seconds": 3.19,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.47,
      "end_seconds": 58.66,
      "duration_seconds": 4.19,
      "text": "It's been ten days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.08,
      "end_seconds": 62.48,
      "duration_seconds": 2.4,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.8,
      "end_seconds": 72.11,
      "duration_seconds": 8.31,
      "text": "When it starts I tend to get a headache since the fall as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 72.65,
      "end_seconds": 79.55,
      "duration_seconds": 6.9,
      "text": "well, I was just gonna say that the main thing is—"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 79.65,
      "end_seconds": 86.34,
      "duration_seconds": 6.69,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.12,
      "end_seconds": 93.04,
      "duration_seconds": 5.92,
      "text": "Later, thanks. Please go on. Has there been a bit of nausea too?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 94.8,
      "end_seconds": 99.62,
      "duration_seconds": 4.82,
      "text": "Ah, uh, yeah. Three days, I'd say."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.7,
      "end_seconds": 112.35,
      "duration_seconds": 10.65,
      "text": "Right, tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.46,
      "end_seconds": 125.93,
      "duration_seconds": 8.47,
      "text": "I mean, you know, I'd say on and off. Pretty moderate, if I'm being honest"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.78,
      "end_seconds": 132.98,
      "duration_seconds": 3.2,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.03,
      "end_seconds": 141.61,
      "duration_seconds": 6.58,
      "text": "Well, it's... hard to to say, it's kind of... I don't know—"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 142.55,
      "end_seconds": 148.37,
      "duration_seconds": 5.82,
      "text": "Take your time. Mild, moderate, or severe, if you had to pick?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.26,
      "end_seconds": 151.9,
      "duration_seconds": 1.64,
      "text": "I'd say severe"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.92,
      "end_seconds": 155.86,
      "duration_seconds": 2.94,
      "text": "So, have you been feeling dizzy?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.22,
      "end_seconds": 160.09,
      "duration_seconds": 2.87,
      "text": "Yes, uh, I have."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_6",
      "role": "UNKNOWN",
      "start_seconds": 161.48,
      "end_seconds": 164.56,
      "duration_seconds": 3.08,
      "text": "mm, that's what happened, yes"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.23,
      "end_seconds": 169.9,
      "duration_seconds": 4.67,
      "text": "okay, can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.5,
      "end_seconds": 179.4,
      "duration_seconds": 7.9,
      "text": "It's a... um, I can't remember what it's called. It's a round yellow one."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.02,
      "end_seconds": 183.89,
      "duration_seconds": 2.87,
      "text": "do you remember what it's for?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 184.41,
      "end_seconds": 196.21,
      "duration_seconds": 11.8,
      "text": "well, for my blood pressure, I believe my son sets them out for me, I just take what I'm given. Thyronorm, every morning"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.52,
      "end_seconds": 203.47,
      "duration_seconds": 2.95,
      "text": "Right, how much do you take?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.96,
      "end_seconds": 219.67,
      "duration_seconds": 11.71,
      "text": "50 micrograms, I think that's what's on the box i'm on escitalopram, 10 milligrams, once a day for my mood"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 220.6,
      "end_seconds": 231.43,
      "duration_seconds": 10.83,
      "text": "Doctor, I think the last prescription for the escitalopram was 20 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.63,
      "end_seconds": 236.04,
      "duration_seconds": 3.41,
      "text": "Alright. Did you bring the up-to-date prescription?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.74,
      "end_seconds": 239.86,
      "duration_seconds": 3.12,
      "text": "No, I left it at home."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.51,
      "end_seconds": 242.95,
      "duration_seconds": 1.44,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.71,
      "end_seconds": 252.69,
      "duration_seconds": 3.98,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.1,
      "end_seconds": 255.68,
      "duration_seconds": 1.58,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.66,
      "end_seconds": 262.7,
      "duration_seconds": 3.04,
      "text": "I only drink at family occasions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.27,
      "end_seconds": 266.75,
      "duration_seconds": 2.48,
      "text": "alright, is there someone at home?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.7,
      "end_seconds": 273.37,
      "duration_seconds": 4.67,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.99,
      "end_seconds": 277.31,
      "duration_seconds": 3.32,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 279.35,
      "end_seconds": 283.7,
      "duration_seconds": 4.35,
      "text": "No, um, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_4",
      "role": "FAMILY_MEMBER",
      "start_seconds": 284.96,
      "end_seconds": 292.31,
      "duration_seconds": 7.35,
      "text": "I'm not sure that's right. I seem to recall a problem with naproxen."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.12,
      "end_seconds": 296.94,
      "duration_seconds": 3.82,
      "text": "Let me think, I don't remember that."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.65,
      "end_seconds": 304.09,
      "duration_seconds": 6.44,
      "text": "alright, so that's unclear. I'll record what each of you said. What about your medical history?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.65,
      "end_seconds": 307.23,
      "duration_seconds": 2.58,
      "text": "I've got high blood pressure"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.7,
      "end_seconds": 309.53,
      "duration_seconds": 0.83,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 311.23,
      "end_seconds": 315.79,
      "duration_seconds": 4.56,
      "text": "I've, I've got an underactive thyroid. Yes, depression"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 317.54,
      "end_seconds": 330.61,
      "duration_seconds": 13.07,
      "text": "sure right, so high blood pressure and an underactive thyroid are already on your record we'll keep that in mind today have you ever had an operation?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 332.1,
      "end_seconds": 337.95,
      "duration_seconds": 5.85,
      "text": "Hmm, I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.99,
      "end_seconds": 352.26,
      "duration_seconds": 4.27,
      "text": "Have you had loss of consciousness, by any chance?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 353.91,
      "end_seconds": 356.8,
      "duration_seconds": 2.89,
      "text": "No. No loss of consciousness."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.08,
      "end_seconds": 365.48,
      "duration_seconds": 2.4,
      "text": "Have you noticed vomiting or confusion?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.4,
      "end_seconds": 371.91,
      "duration_seconds": 4.51,
      "text": "Yeah, no vomiting or confusion, none of it."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.2,
      "end_seconds": 379.35,
      "duration_seconds": 6.15,
      "text": "Have you noticed weakness, double vision or clear fluid from the nose or ear?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 382.17,
      "end_seconds": 391.91,
      "duration_seconds": 9.74,
      "text": "Actually, no weakness, double vision or clear fluid from the nose or ear, none of it."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 393.33,
      "end_seconds": 395.7,
      "duration_seconds": 2.37,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 397.26,
      "end_seconds": 402.16,
      "duration_seconds": 4.9,
      "text": "Okay, so that's normal as far as I know."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_5",
      "role": "NURSE",
      "start_seconds": 403.46,
      "end_seconds": 412.86,
      "duration_seconds": 9.4,
      "text": "Here are the numbers, doctor. Temperature 36.7, oxygen saturation is 98 percent, BP is 114 over 75, respiratory rate 16, heart rate 65."
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 413.92,
      "end_seconds": 431.9,
      "duration_seconds": 17.98,
      "text": "okay, noted. Let me tell you where I've got to. This is probably a minor head injury without worrying signs. I want to be honest that this is an impression, not a final answer. We shouldn't forget a neck strain. A concussion is still possible"
    },
    {
      "segment_id": "SEG0060",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 443.23,
      "end_seconds": 457.87,
      "duration_seconds": 14.64,
      "text": "You'll be taking paracetamol, 1 gram, every six hours if needed, for three days. That should help with headache. It's a commonly used medicine and most people tolerate it well."
    },
    {
      "segment_id": "SEG0061",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 459.32,
      "end_seconds": 460.91,
      "duration_seconds": 1.59,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0062",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 462.63,
      "end_seconds": 479.12,
      "duration_seconds": 16.49,
      "text": "Someone should stay with you tonight, and no alcohol or contact sport for now. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0063",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 481.09,
      "end_seconds": 482.7,
      "duration_seconds": 1.61,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0064",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 483.4,
      "end_seconds": 485.74,
      "duration_seconds": 2.34,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0065",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 486.31,
      "end_seconds": 488.67,
      "duration_seconds": 2.36,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0066",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 490.09,
      "end_seconds": 491.42,
      "duration_seconds": 1.33,
      "text": "Look after yourself."
    }
  ]
}