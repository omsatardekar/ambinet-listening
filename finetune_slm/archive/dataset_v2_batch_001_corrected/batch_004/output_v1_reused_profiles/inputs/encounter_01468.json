{
  "schema_version": "1.0",
  "encounter_id": "01468",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.27,
      "duration_seconds": 4.39,
      "text": "Oh, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.21,
      "end_seconds": 11.5,
      "duration_seconds": 4.29,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.49,
      "end_seconds": 17.35,
      "duration_seconds": 3.86,
      "text": "Well, you know, I've been having hot flushes."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.36,
      "end_seconds": 24.23,
      "duration_seconds": 2.87,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.35,
      "end_seconds": 33.81,
      "duration_seconds": 3.46,
      "text": "It's been four weeks, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.76,
      "end_seconds": 43.9,
      "duration_seconds": 8.14,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.36,
      "end_seconds": 62.08,
      "duration_seconds": 12.72,
      "text": "It's worse with caffeine and warm rooms. Honestly, a few times a day. I've also had mood swings, for nearly five years. With mood swings, mostly severe."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.88,
      "end_seconds": 80.49,
      "duration_seconds": 5.61,
      "text": "A few quick ones: chest pain, breast lumps or bleeding after sex?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.91,
      "end_seconds": 86.67,
      "duration_seconds": 4.76,
      "text": "No, no chest pain, breast lumps or bleeding after sex."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.44,
      "end_seconds": 92.13,
      "duration_seconds": 3.69,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.98,
      "end_seconds": 98.82,
      "duration_seconds": 1.84,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.32,
      "end_seconds": 102.36,
      "duration_seconds": 2.04,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.13,
      "end_seconds": 107.44,
      "duration_seconds": 4.31,
      "text": "I'm on alendronate, 70 milligrams, once a week."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.3,
      "end_seconds": 122.0,
      "duration_seconds": 3.7,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.28,
      "end_seconds": 125.17,
      "duration_seconds": 1.89,
      "text": "I've got thin bones."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.3,
      "end_seconds": 129.38,
      "duration_seconds": 3.08,
      "text": "Mm-hmm. Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.24,
      "end_seconds": 133.25,
      "duration_seconds": 3.01,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.1,
      "end_seconds": 152.85,
      "duration_seconds": 3.75,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.07,
      "end_seconds": 157.94,
      "duration_seconds": 3.87,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.78,
      "end_seconds": 163.22,
      "duration_seconds": 3.44,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.46,
      "end_seconds": 170.36,
      "duration_seconds": 2.9,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.95,
      "end_seconds": 172.78,
      "duration_seconds": 1.83,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.56,
      "end_seconds": 180.48,
      "duration_seconds": 3.92,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.39,
      "end_seconds": 183.86,
      "duration_seconds": 2.47,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 185.87,
      "end_seconds": 189.64,
      "duration_seconds": 3.77,
      "text": "I had my septum straightened in my thirties."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.16,
      "end_seconds": 192.13,
      "duration_seconds": 1.97,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.62,
      "end_seconds": 204.73,
      "duration_seconds": 2.11,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.78,
      "end_seconds": 225.55,
      "duration_seconds": 9.77,
      "text": "Okay: blood pressure 126 over 76, heart rate 73, oxygen saturation is 97 percent, respiratory rate 18, temperature 36.8."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 226.94,
      "end_seconds": 231.1,
      "duration_seconds": 4.16,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.2,
      "end_seconds": 233.87,
      "duration_seconds": 1.67,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.21,
      "end_seconds": 257.87,
      "duration_seconds": 6.66,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.99,
      "end_seconds": 262.73,
      "duration_seconds": 1.74,
      "text": "That's the examination finished."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.76,
      "end_seconds": 283.21,
      "duration_seconds": 4.45,
      "text": "Taking everything into account, this is probably perimenopausal symptoms."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 284.74,
      "end_seconds": 287.02,
      "duration_seconds": 2.28,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.8,
      "end_seconds": 302.34,
      "duration_seconds": 11.54,
      "text": "I can't promise yet, but most people with perimenopausal symptoms do well once it's treated properly. I'll request a bone density scan, it'll help with menopause bone health."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 303.33,
      "end_seconds": 307.89,
      "duration_seconds": 4.56,
      "text": "We have a slot Friday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.45,
      "end_seconds": 323.32,
      "duration_seconds": 14.87,
      "text": "Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. I'll want another look after the blood tests. Okay, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.89,
      "end_seconds": 330.37,
      "duration_seconds": 2.48,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}