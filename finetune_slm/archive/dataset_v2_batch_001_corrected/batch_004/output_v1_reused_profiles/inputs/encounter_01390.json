{
  "schema_version": "1.0",
  "encounter_id": "01390",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.22,
      "end_seconds": 4.83,
      "duration_seconds": 3.61,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 11.99,
      "duration_seconds": 5.33,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.89,
      "end_seconds": 19.08,
      "duration_seconds": 5.19,
      "text": "Actually, so the thing is, I've got breathlessness on exertion."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.99,
      "end_seconds": 22.2,
      "duration_seconds": 2.21,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.99,
      "end_seconds": 24.8,
      "duration_seconds": 1.81,
      "text": "Probably six months. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.7,
      "end_seconds": 29.79,
      "duration_seconds": 3.09,
      "text": "Have you been sweating with the tightness?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.03,
      "end_seconds": 33.89,
      "duration_seconds": 2.86,
      "text": "Yeah. Three weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.18,
      "end_seconds": 43.06,
      "duration_seconds": 4.88,
      "text": "Any pain between the shoulder blades or pain at rest at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.02,
      "end_seconds": 47.41,
      "duration_seconds": 2.39,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.61,
      "end_seconds": 53.84,
      "duration_seconds": 5.23,
      "text": "Let me check a few things. Any ankle swelling or cough?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.73,
      "end_seconds": 57.45,
      "duration_seconds": 2.72,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.27,
      "end_seconds": 60.84,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.32,
      "end_seconds": 63.71,
      "duration_seconds": 1.39,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.78,
      "end_seconds": 84.67,
      "duration_seconds": 3.89,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.59,
      "end_seconds": 87.22,
      "duration_seconds": 1.63,
      "text": "Yes, high cholesterol."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.77,
      "end_seconds": 90.3,
      "duration_seconds": 1.53,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.32,
      "end_seconds": 111.5,
      "duration_seconds": 5.18,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.93,
      "end_seconds": 122.24,
      "duration_seconds": 9.31,
      "text": "Lots of rice, lentils and some fruit. My partner and our baby. I walk the dog every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.99,
      "end_seconds": 139.24,
      "duration_seconds": 3.25,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.05,
      "end_seconds": 142.65,
      "duration_seconds": 2.6,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.61,
      "end_seconds": 153.81,
      "duration_seconds": 3.2,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.33,
      "end_seconds": 156.73,
      "duration_seconds": 2.4,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.7,
      "end_seconds": 161.24,
      "duration_seconds": 3.54,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.01,
      "end_seconds": 166.98,
      "duration_seconds": 4.97,
      "text": "Yes, nickel, it gives me a rash on my skin."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.25,
      "end_seconds": 172.06,
      "duration_seconds": 2.81,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.95,
      "end_seconds": 175.29,
      "duration_seconds": 1.34,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.28,
      "end_seconds": 196.16,
      "duration_seconds": 2.88,
      "text": "There is no swelling in your ankles."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.8,
      "end_seconds": 216.07,
      "duration_seconds": 15.27,
      "text": "Good, you can sit up again. Taking everything into account, I think we're dealing with exertional angina until proven otherwise at this stage. I want to be honest that this is an impression, not a final answer."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.73,
      "end_seconds": 219.66,
      "duration_seconds": 1.93,
      "text": "Is this serious, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 220.9,
      "end_seconds": 235.43,
      "duration_seconds": 14.53,
      "text": "I understand the worry. At the moment I'd say it's exertional angina until proven otherwise, and we'll know more once the an ECG is back. I'd like to arrange an ECG for chest tightness."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 236.82,
      "end_seconds": 239.5,
      "duration_seconds": 2.68,
      "text": "The earliest is Friday, 9 am."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.05,
      "end_seconds": 253.18,
      "duration_seconds": 12.13,
      "text": "I'd like to arrange blood tests for cardiovascular risk. I'll start you on GTN spray, 400 micrograms, when needed for chest pain, long term. That should help with chest pain."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.8,
      "end_seconds": 257.43,
      "duration_seconds": 2.63,
      "text": "How soon will it work?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.94,
      "end_seconds": 283.16,
      "duration_seconds": 25.22,
      "text": "If the tightness comes, stop, sit down and use the spray under your tongue. I'll also refer you to the cardiology clinic. An exercise stress test is something we might do if this doesn't improve in two weeks. The thing that would worry me is if the chest pain lasts more than ten minutes or comes at rest. If that happens, go to emergency."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.57,
      "end_seconds": 289.06,
      "duration_seconds": 1.49,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.44,
      "end_seconds": 296.34,
      "duration_seconds": 5.9,
      "text": "We'll catch up in two weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.35,
      "end_seconds": 302.07,
      "duration_seconds": 3.72,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.13,
      "end_seconds": 305.41,
      "duration_seconds": 1.28,
      "text": "Goodbye for now."
    }
  ]
}