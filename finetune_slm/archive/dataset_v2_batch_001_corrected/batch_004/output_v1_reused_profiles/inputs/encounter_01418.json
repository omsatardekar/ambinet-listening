    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 111.4,
      "end_seconds": 115.9,
      "duration_seconds": 4.5,
      "text": "No hand symptoms or foot ulcers, none of it."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.92,
      "end_seconds": 121.84,
      "duration_seconds": 3.92,
      "text": "any weakness in the legs or back pain?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 122.51,
      "end_seconds": 128.22,
      "duration_seconds": 5.71,
      "text": "No weakness in the legs or back pain, none of it."
    },
    {
      "segment_id": "SEG0021",
