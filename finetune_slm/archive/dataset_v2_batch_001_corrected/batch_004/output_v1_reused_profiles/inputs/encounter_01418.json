    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.75,
      "end_seconds": 137.87,
      "duration_seconds": 2.12,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.06,
      "end_seconds": 143.64,
      "duration_seconds": 2.58,
      "text": "Right, no, skin's been fine."
