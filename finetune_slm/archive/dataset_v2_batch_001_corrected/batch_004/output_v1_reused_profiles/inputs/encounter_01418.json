    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.48,
      "end_seconds": 158.58,
      "duration_seconds": 3.1,
      "text": "Alright, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.16,
      "end_seconds": 160.75,
      "duration_seconds": 1.59,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.49,
      "end_seconds": 164.94,
      "duration_seconds": 3.45,
      "text": "is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 171.15,
      "end_seconds": 174.51,
      "duration_seconds": 3.36,
      "text": "right, my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.41,
      "end_seconds": 180.65,
      "duration_seconds": 4.24,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.26,
      "end_seconds": 184.48,
      "duration_seconds": 3.22,
      "text": "Acid reflux, for about a year"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.32,
      "end_seconds": 189.9,
      "duration_seconds": 4.58,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.33,
      "end_seconds": 192.88,
      "duration_seconds": 1.55,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.37,
      "end_seconds": 199.03,
      "duration_seconds": 4.66,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.03,
      "end_seconds": 209.08,
      "duration_seconds": 9.05,
      "text": "I look after my grandchildren most days. My partner and our baby. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.76,
      "end_seconds": 224.06,
      "duration_seconds": 3.3,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.49,
      "end_seconds": 238.78,
      "duration_seconds": 2.29,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.65,
      "end_seconds": 267.45,
      "duration_seconds": 7.8,
      "text": "Okay: pulse is 83 beats a minute, respiratory rate 16. And saturation 97 percent, BP is 109 over 69."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.98,
      "end_seconds": 270.43,
      "duration_seconds": 1.45,
      "text": "is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.27,
      "end_seconds": 275.1,
      "duration_seconds": 3.83,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.56,
      "end_seconds": 280.22,
      "duration_seconds": 3.66,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.25,
      "end_seconds": 283.75,
      "duration_seconds": 1.5,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.02,
      "end_seconds": 287.77,
      "duration_seconds": 2.75,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 297.56,
      "end_seconds": 301.43,
      "duration_seconds": 3.87,
      "text": "feeling of light touch is reduced in both feet"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 302.21,
      "end_seconds": 303.21,
      "duration_seconds": 1.0,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 306.51,
      "duration_seconds": 1.94,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 321.12,
      "end_seconds": 322.82,
      "duration_seconds": 1.7,
      "text": "Ankle reflexes are absent."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.28,
      "end_seconds": 328.86,
      "duration_seconds": 1.58,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.78,
      "end_seconds": 360.63,
      "duration_seconds": 14.85,
      "text": "So where does that leave us? I think we're dealing with peripheral neuropathy, possibly related to sugar at this stage. A nerve conduction study is what I'd like next, for neuropathy."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 362.64,
      "end_seconds": 365.47,
      "duration_seconds": 2.83,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 367.35,
      "end_seconds": 389.53,
      "duration_seconds": 22.18,
      "text": "let's get a vitamin B12 level, for neuropathy we'll begin with pregabalin, 75 milligrams, at night, for four weeks you take it by mouth that should help with nerve pain check your feet every evening for cuts or blisters, you may not feel them i'll also refer you to podiatry"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.28,
      "end_seconds": 397.58,
      "duration_seconds": 6.3,
      "text": "alright, thank you. Um, can you send me for an HbA1c?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 398.42,
      "end_seconds": 409.71,
      "duration_seconds": 11.29,
      "text": "Not at this point, no. It isn't indicated yet. If the symptoms get worse, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 411.62,
      "end_seconds": 414.59,
      "duration_seconds": 2.97,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 416.49,
      "end_seconds": 425.09,
      "duration_seconds": 8.6,
      "text": "we'll catch up after the results are back. Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 426.85,
      "end_seconds": 438.53,
      "duration_seconds": 11.68,
      "text": "so, I take the pregabalin, 75 milligrams, at night and come back after the results are back is that right?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 440.5,
      "end_seconds": 444.36,
      "duration_seconds": 3.86,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0059",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 445.65,
      "end_seconds": 450.55,
      "duration_seconds": 4.9,
      "text": "yeah, um, no, that's all. Thanks a lot"
    }
