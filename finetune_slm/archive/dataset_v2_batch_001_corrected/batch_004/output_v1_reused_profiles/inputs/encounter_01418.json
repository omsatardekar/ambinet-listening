    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.33,
      "end_seconds": 151.26,
      "duration_seconds": 4.93,
      "text": "right, what about your tummy and bowels, anything unusual there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.89,
      "end_seconds": 153.42,
      "duration_seconds": 1.53,
      "text": "Nothing unusual, no."
