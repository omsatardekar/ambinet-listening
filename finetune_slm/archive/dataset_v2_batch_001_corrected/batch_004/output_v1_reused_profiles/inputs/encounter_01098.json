{
  "schema_version": "1.0",
  "encounter_id": "01098",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.13,
      "end_seconds": 4.05,
      "duration_seconds": 2.92,
      "text": "Good afternoon, how are you today?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.14,
      "end_seconds": 7.35,
      "duration_seconds": 1.21,
      "text": "Hello, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.81,
      "end_seconds": 10.76,
      "duration_seconds": 1.95,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 12.55,
      "end_seconds": 31.4,
      "duration_seconds": 18.85,
      "text": "Yeah, it's pain when I pass stool. I don't know what's causing it. I thought it would sort itself out, but it hasn't. I looked a few things up online, and that probably didn't help."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 33.29,
      "end_seconds": 36.23,
      "duration_seconds": 2.94,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.32,
      "end_seconds": 45.18,
      "duration_seconds": 6.86,
      "text": "It's been going on for two days. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.54,
      "end_seconds": 49.96,
      "duration_seconds": 3.42,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.03,
      "end_seconds": 55.97,
      "duration_seconds": 4.94,
      "text": "Maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.94,
      "end_seconds": 60.2,
      "duration_seconds": 2.26,
      "text": "Is anything making it worse?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 61.4,
      "end_seconds": 64.17,
      "duration_seconds": 2.77,
      "text": "Straining definitely sets it off."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.42,
      "end_seconds": 66.99,
      "duration_seconds": 2.57,
      "text": "Yes. How frequently does it come?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.09,
      "end_seconds": 70.0,
      "duration_seconds": 1.91,
      "text": "Honestly, on and off."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.53,
      "end_seconds": 76.22,
      "duration_seconds": 4.69,
      "text": "Have you had any weight loss or family history of bowel cancer?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.9,
      "end_seconds": 83.4,
      "duration_seconds": 5.5,
      "text": "No weight loss or family history of bowel cancer, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.56,
      "end_seconds": 88.14,
      "duration_seconds": 3.58,
      "text": "Did you get fever or change in bowel habit?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.49,
      "end_seconds": 94.98,
      "duration_seconds": 5.49,
      "text": "I haven't had fever or change in bowel habit, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.44,
      "end_seconds": 104.78,
      "duration_seconds": 4.34,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 106.33,
      "end_seconds": 109.0,
      "duration_seconds": 2.67,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.07,
      "end_seconds": 132.19,
      "duration_seconds": 8.12,
      "text": "Can you list what you take, tablets, creams or inhalers? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 132.91,
      "end_seconds": 138.9,
      "duration_seconds": 5.99,
      "text": "I'm on iron tablets, once a day for my blood count."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.97,
      "end_seconds": 158.53,
      "duration_seconds": 2.56,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.09,
      "end_seconds": 166.64,
      "duration_seconds": 6.55,
      "text": "Yes, I had a meniscus repair on my knee, four years ago."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 167.88,
      "end_seconds": 172.58,
      "duration_seconds": 4.7,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 173.31,
      "end_seconds": 192.96,
      "duration_seconds": 19.65,
      "text": "I've never touched a cigarette. I'll have a glass of wine with dinner. I hardly move around during the day. I'm a hairdresser, on my feet all day. I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.72,
      "end_seconds": 208.28,
      "duration_seconds": 2.56,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.8,
      "end_seconds": 212.66,
      "duration_seconds": 2.86,
      "text": "I've had low haemoglobin, yes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.7,
      "end_seconds": 218.55,
      "duration_seconds": 3.85,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 219.88,
      "end_seconds": 223.68,
      "duration_seconds": 3.8,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 238.56,
      "end_seconds": 252.16,
      "duration_seconds": 13.6,
      "text": "From what you've told me, this looks most like haemorrhoids. Blood tests is what I'd like next, for rectal bleeding. I'm going to order a colonoscopy, for rectal bleeding."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 253.87,
      "end_seconds": 257.18,
      "duration_seconds": 3.31,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.87,
      "end_seconds": 290.82,
      "duration_seconds": 31.95,
      "text": "The treatment will be lactulose, 15 ml, at night, for two weeks. You take it by mouth. It's for constipation. Soak in a warm bath for ten minutes after you pass stool, and don't strain. If you smoke, this is a good moment to think about stopping, and we can help you with that. I'm going to send a referral to a colorectal surgeon."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 292.87,
      "end_seconds": 294.36,
      "duration_seconds": 1.49,
      "text": "Alright, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.42,
      "end_seconds": 303.54,
      "duration_seconds": 7.12,
      "text": "Come back or go to emergency straight away if you pass a lot of blood or feel faint."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.7,
      "end_seconds": 307.92,
      "duration_seconds": 3.22,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.54,
      "end_seconds": 317.66,
      "duration_seconds": 8.12,
      "text": "I'd like to see you again after the results are back. Alright, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 318.64,
      "end_seconds": 320.91,
      "duration_seconds": 2.27,
      "text": "Thank you, that's helpful."
    }
  ]
}