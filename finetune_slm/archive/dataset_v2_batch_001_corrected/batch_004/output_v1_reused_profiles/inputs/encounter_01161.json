{
  "schema_version": "1.0",
  "encounter_id": "01161",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 5.95,
      "duration_seconds": 4.66,
      "text": "Morning, um, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.86,
      "end_seconds": 14.38,
      "duration_seconds": 4.52,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 15.23,
      "end_seconds": 24.74,
      "duration_seconds": 9.51,
      "text": "Mainly bright red blood on the paper. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.09,
      "end_seconds": 29.93,
      "duration_seconds": 3.84,
      "text": "Right, has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.48,
      "end_seconds": 35.39,
      "duration_seconds": 3.91,
      "text": "It's been two days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.28,
      "end_seconds": 38.78,
      "duration_seconds": 2.5,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 40.87,
      "end_seconds": 47.96,
      "duration_seconds": 7.09,
      "text": "Straining definitely sets it off. I've had hard stools too, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.02,
      "end_seconds": 68.05,
      "duration_seconds": 6.03,
      "text": "Have you had any black stools, dizziness, severe pain or change in bowel habit?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.29,
      "end_seconds": 76.16,
      "duration_seconds": 6.87,
      "text": "No black stools, dizziness, severe pain or change in bowel habit, none of it."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.34,
      "end_seconds": 80.32,
      "duration_seconds": 2.98,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.25,
      "end_seconds": 82.74,
      "duration_seconds": 1.49,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.09,
      "end_seconds": 87.01,
      "duration_seconds": 2.92,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.02,
      "end_seconds": 92.33,
      "duration_seconds": 3.31,
      "text": "That's normal as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.85,
      "end_seconds": 111.59,
      "duration_seconds": 4.74,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.24,
      "end_seconds": 115.92,
      "duration_seconds": 3.68,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.73,
      "end_seconds": 119.89,
      "duration_seconds": 3.16,
      "text": "Right, do you work outside the home?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.04,
      "end_seconds": 125.06,
      "duration_seconds": 4.02,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.93,
      "end_seconds": 128.45,
      "duration_seconds": 2.52,
      "text": "So, who lives with you?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.35,
      "end_seconds": 133.14,
      "duration_seconds": 2.79,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.01,
      "end_seconds": 135.74,
      "duration_seconds": 1.73,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.31,
      "end_seconds": 140.97,
      "duration_seconds": 3.66,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.28,
      "end_seconds": 145.53,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.92,
      "end_seconds": 150.85,
      "duration_seconds": 3.93,
      "text": "Actually, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.57,
      "end_seconds": 156.03,
      "duration_seconds": 3.46,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.11,
      "end_seconds": 161.55,
      "duration_seconds": 3.44,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.2,
      "end_seconds": 165.25,
      "duration_seconds": 3.05,
      "text": "Any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.55,
      "end_seconds": 167.73,
      "duration_seconds": 1.18,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.62,
      "end_seconds": 178.99,
      "duration_seconds": 2.37,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.58,
      "end_seconds": 194.83,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.37,
      "end_seconds": 216.85,
      "duration_seconds": 8.48,
      "text": "Okay: heart rate 84, temperature 36.8, BP is 128 over 76, SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.29,
      "end_seconds": 223.13,
      "duration_seconds": 3.84,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.5,
      "end_seconds": 226.0,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.49,
      "end_seconds": 228.76,
      "duration_seconds": 1.27,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.71,
      "end_seconds": 250.21,
      "duration_seconds": 7.5,
      "text": "There is a small soft lump at the edge of the anus and no tear that I can see."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.29,
      "end_seconds": 261.72,
      "duration_seconds": 6.43,
      "text": "Okay, that's enough for me. Taking everything into account, this looks most like haemorrhoids."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 262.3,
      "end_seconds": 265.26,
      "duration_seconds": 2.96,
      "text": "Ah, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.68,
      "end_seconds": 273.32,
      "duration_seconds": 6.64,
      "text": "It's reasonable to be concerned, but right now haemorrhoids is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.94,
      "end_seconds": 317.29,
      "duration_seconds": 34.35,
      "text": "I'm going to order a camera test of the bowel, for rectal bleeding. The treatment will be haemorrhoid cream, twice a day, for a week. That should help with haemorrhoids. I'll put all of this in writing so you don't have to remember it. Fibre, plenty of water, and don't sit on the toilet for long. A blood count is something we might do if this doesn't improve in a month."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 317.96,
      "end_seconds": 325.44,
      "duration_seconds": 7.48,
      "text": "Please come and see me in four weeks. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 327.02,
      "end_seconds": 329.9,
      "duration_seconds": 2.88,
      "text": "Great, thank you for your help."
    }
  ]
}