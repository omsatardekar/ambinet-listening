{
  "schema_version": "1.0",
  "encounter_id": "01408",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 4.57,
      "duration_seconds": 3.38,
      "text": "Good morning. I've just opened your notes."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "CAREGIVER",
      "start_seconds": 5.96,
      "end_seconds": 10.51,
      "duration_seconds": 4.55,
      "text": "Good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 12.41,
      "end_seconds": 15.77,
      "duration_seconds": 3.36,
      "text": "So, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 17.58,
      "end_seconds": 21.85,
      "duration_seconds": 4.27,
      "text": "I've been waking at night with my hand numb."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.15,
      "end_seconds": 25.96,
      "duration_seconds": 2.81,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 27.74,
      "end_seconds": 43.03,
      "duration_seconds": 15.29,
      "text": "Mild, really. Oh, and an ache in my wrist. That's been about the same, about a year. As for ache in my wrist, I'd say all the time."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 44.55,
      "end_seconds": 48.67,
      "duration_seconds": 4.12,
      "text": "What about numbness in your fingers, have you noticed that?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 49.18,
      "end_seconds": 53.06,
      "duration_seconds": 3.88,
      "text": "Yes, about the same, about a month."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.05,
      "end_seconds": 56.99,
      "duration_seconds": 1.94,
      "text": "Have you noticed any triggers?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 57.89,
      "end_seconds": 61.87,
      "duration_seconds": 3.98,
      "text": "Erm, uh, it's worse with night."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.66,
      "end_seconds": 66.86,
      "duration_seconds": 3.2,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 67.78,
      "end_seconds": 69.39,
      "duration_seconds": 1.61,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.58,
      "end_seconds": 82.84,
      "duration_seconds": 2.26,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 84.03,
      "end_seconds": 85.8,
      "duration_seconds": 1.77,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.83,
      "end_seconds": 89.36,
      "duration_seconds": 2.53,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 90.47,
      "end_seconds": 92.79,
      "duration_seconds": 2.32,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 93.65,
      "end_seconds": 98.03,
      "duration_seconds": 4.38,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.2,
      "end_seconds": 106.92,
      "duration_seconds": 3.72,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.34,
      "end_seconds": 110.51,
      "duration_seconds": 2.17,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.44,
      "end_seconds": 116.46,
      "duration_seconds": 4.02,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.23,
      "end_seconds": 119.46,
      "duration_seconds": 2.23,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 120.55,
      "end_seconds": 123.03,
      "duration_seconds": 2.48,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.68,
      "end_seconds": 129.68,
      "duration_seconds": 5.0,
      "text": "Alright, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 130.48,
      "end_seconds": 132.07,
      "duration_seconds": 1.59,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.89,
      "end_seconds": 143.01,
      "duration_seconds": 3.12,
      "text": "Any weakness in the legs or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.26,
      "end_seconds": 146.81,
      "duration_seconds": 2.55,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.41,
      "end_seconds": 151.77,
      "duration_seconds": 3.36,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.72,
      "end_seconds": 154.84,
      "duration_seconds": 2.12,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.84,
      "end_seconds": 159.54,
      "duration_seconds": 2.7,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 160.59,
      "end_seconds": 164.23,
      "duration_seconds": 3.64,
      "text": "Bowels are regular, uh, nothing odd."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.75,
      "end_seconds": 168.64,
      "duration_seconds": 3.89,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.77,
      "end_seconds": 181.85,
      "duration_seconds": 2.08,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.82,
      "end_seconds": 209.93,
      "duration_seconds": 13.11,
      "text": "Okay: SpO2 99 percent on room air, pulse is 70 beats a minute, respiratory rate 18. And BP is 112 over 80, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 211.61,
      "end_seconds": 213.89,
      "duration_seconds": 2.28,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 215.38,
      "end_seconds": 218.81,
      "duration_seconds": 3.43,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.52,
      "end_seconds": 225.73,
      "duration_seconds": 5.21,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.3,
      "end_seconds": 229.79,
      "duration_seconds": 2.49,
      "text": "Alright, I'm just checking this side."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 240.92,
      "end_seconds": 249.18,
      "duration_seconds": 8.26,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.68,
      "end_seconds": 267.1,
      "duration_seconds": 14.42,
      "text": "That's all I needed to check. Let me tell you where I've got to. I'm honestly not certain yet. It could be carpal tunnel syndrome, or it might be a pinched nerve in the neck."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 268.69,
      "end_seconds": 271.84,
      "duration_seconds": 3.15,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.68,
      "end_seconds": 280.59,
      "duration_seconds": 7.91,
      "text": "I understand the worry. At the moment I'd say it's carpal tunnel syndrome, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 291.82,
      "end_seconds": 298.61,
      "duration_seconds": 6.79,
      "text": "There's nothing new for me to start or arrange today. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 300.17,
      "end_seconds": 303.45,
      "duration_seconds": 3.28,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 304.11,
      "end_seconds": 305.8,
      "duration_seconds": 1.69,
      "text": "Have a good day."
    }
  ]
}