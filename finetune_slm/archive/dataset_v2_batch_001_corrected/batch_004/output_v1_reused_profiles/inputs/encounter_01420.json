{
  "schema_version": "1.0",
  "encounter_id": "01420",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.69,
      "end_seconds": 7.28,
      "duration_seconds": 6.59,
      "text": "All set here, doctor. Chart's updated, and I'll read the readings out when you're ready."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.19,
      "end_seconds": 12.3,
      "duration_seconds": 4.11,
      "text": "Okay, thanks. Hi, how can I help today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 14.31,
      "end_seconds": 24.52,
      "duration_seconds": 10.21,
      "text": "Well, I've been having red scaly patches on my elbows. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.83,
      "end_seconds": 29.3,
      "duration_seconds": 3.47,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 30.39,
      "end_seconds": 34.63,
      "duration_seconds": 4.24,
      "text": "It's been about a year, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.3,
      "end_seconds": 40.08,
      "duration_seconds": 3.78,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.41,
      "end_seconds": 48.99,
      "duration_seconds": 3.58,
      "text": "Pretty moderate, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.71,
      "end_seconds": 53.76,
      "duration_seconds": 3.05,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 55.72,
      "end_seconds": 84.03,
      "duration_seconds": 28.31,
      "text": "it usually comes with itching. Hmm, the itching? That's been for three weeks. Hmm, as for itching, honestly, on and off. I've also had stiff fingers in the morning, for four weeks. As for stiff fingers in the morning, honestly, a couple of times a week"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.64,
      "end_seconds": 97.12,
      "duration_seconds": 7.48,
      "text": "Okay, have you had red scaly patches on your elbows before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 99.19,
      "end_seconds": 110.47,
      "duration_seconds": 11.28,
      "text": "yes, uh, something like this happened a couple of years ago, and it went away on its own"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 121.8,
      "end_seconds": 125.09,
      "duration_seconds": 3.29,
      "text": "and what about eye redness or new medicines?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 126.02,
      "end_seconds": 130.02,
      "duration_seconds": 4.0,
      "text": "No, no eye redness or new medicines."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.27,
      "end_seconds": 139.22,
      "duration_seconds": 7.95,
      "text": "let me check a a few things. Any weeping, sore throat before it started or fever?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 144.12,
      "end_seconds": 148.25,
      "duration_seconds": 4.13,
      "text": "no, you know, not a single one"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.8,
      "end_seconds": 151.37,
      "duration_seconds": 2.57,
      "text": "Anything different when you pass water?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 152.64,
      "end_seconds": 154.21,
      "duration_seconds": 1.57,
      "text": "no changes there"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.83,
      "end_seconds": 158.15,
      "duration_seconds": 3.32,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 159.15,
      "end_seconds": 162.0,
      "duration_seconds": 2.85,
      "text": "Mm, no, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.42,
      "end_seconds": 164.32,
      "duration_seconds": 0.9,
      "text": "any smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 166.02,
      "end_seconds": 170.28,
      "duration_seconds": 4.26,
      "text": "I quit smoking around ten years ago."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.15,
      "end_seconds": 174.37,
      "duration_seconds": 2.22,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 176.46,
      "end_seconds": 179.01,
      "duration_seconds": 2.55,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.54,
      "end_seconds": 181.92,
      "duration_seconds": 2.38,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 183.88,
      "end_seconds": 189.51,
      "duration_seconds": 5.63,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.33,
      "end_seconds": 196.56,
      "duration_seconds": 3.23,
      "text": "Are you in work at the moment?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 197.12,
      "end_seconds": 201.89,
      "duration_seconds": 4.77,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.62,
      "end_seconds": 205.84,
      "duration_seconds": 2.22,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.67,
      "end_seconds": 225.56,
      "duration_seconds": 17.89,
      "text": "I take hydrochlorothiazide, 12.5 milligrams, every morning. Yeah, I do miss it now and then, to be fair. I'm on glibenclamide, 5 milligrams, before breakfast for my sugar."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 229.75,
      "end_seconds": 234.92,
      "duration_seconds": 5.17,
      "text": "Doctor, our chart from the last visit lists it as 10 milligrams."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.15,
      "end_seconds": 244.24,
      "duration_seconds": 5.09,
      "text": "okay have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 246.15,
      "end_seconds": 257.69,
      "duration_seconds": 11.54,
      "text": "I don't think I have it with me. It's coconut oil, daily. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.21,
      "end_seconds": 261.06,
      "duration_seconds": 1.85,
      "text": "and for how long?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 262.24,
      "end_seconds": 264.05,
      "duration_seconds": 1.81,
      "text": "Six months now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 276.09,
      "duration_seconds": 7.37,
      "text": "Okay, any health conditions I should have on record? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 277.37,
      "end_seconds": 287.88,
      "duration_seconds": 10.51,
      "text": "High blood pressure, for about a year i wasn't sure whether to come in at all, to be honest"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.12,
      "end_seconds": 290.55,
      "duration_seconds": 1.43,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 291.89,
      "end_seconds": 293.41,
      "duration_seconds": 1.52,
      "text": "I've got diabetes"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.93,
      "end_seconds": 302.81,
      "duration_seconds": 8.88,
      "text": "Yes, diabetes is known to us, good to have that clear. What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 304.67,
      "end_seconds": 310.43,
      "duration_seconds": 5.76,
      "text": "My aunt has rheumatoid arthritis. My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 311.89,
      "end_seconds": 314.22,
      "duration_seconds": 2.33,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.44,
      "end_seconds": 319.71,
      "duration_seconds": 4.27,
      "text": "Let me think, I've never had an allergy."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.34,
      "end_seconds": 341.09,
      "duration_seconds": 2.75,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 342.43,
      "end_seconds": 346.1,
      "duration_seconds": 3.67,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 346.68,
      "end_seconds": 357.92,
      "duration_seconds": 11.24,
      "text": "Here are the numbers, doctor. Oxygen saturation is 97 percent, temperature 36.5, pulse is 66 beats a minute, BP is 109 over 70."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 359.92,
      "end_seconds": 361.01,
      "duration_seconds": 1.09,
      "text": "Okay, noted."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.24,
      "end_seconds": 366.66,
      "duration_seconds": 3.42,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.43,
      "end_seconds": 370.14,
      "duration_seconds": 1.71,
      "text": "right, look straight ahead"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.29,
      "end_seconds": 385.46,
      "duration_seconds": 3.17,
      "text": "a few small pits in the fingernails"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.19,
      "end_seconds": 389.13,
      "duration_seconds": 1.94,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.4,
      "end_seconds": 404.45,
      "duration_seconds": 4.05,
      "text": "Well-defined thick silvery plaques over both elbows and knees."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 409.13,
      "end_seconds": 411.16,
      "duration_seconds": 2.03,
      "text": "all finished, thank you"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.08,
      "end_seconds": 450.62,
      "duration_seconds": 24.54,
      "text": "Right, here's what I'm thinking. The most likely explanation is plaque psoriasis. We shouldn't forget eczema. And please bring the latest prescription or the the medicine boxes to the next visit, so we can settle the dose. There's nothing new for me to start or arrange today. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 451.15,
      "end_seconds": 453.35,
      "duration_seconds": 2.2,
      "text": "Thank you, that's helpful."
    }
  ]
}