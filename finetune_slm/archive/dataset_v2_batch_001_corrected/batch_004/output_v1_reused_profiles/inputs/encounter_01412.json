{
  "schema_version": "1.0",
  "encounter_id": "01412",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.33,
      "end_seconds": 5.25,
      "duration_seconds": 3.92,
      "text": "Well, hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.08,
      "end_seconds": 12.06,
      "duration_seconds": 4.98,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.06,
      "end_seconds": 21.8,
      "duration_seconds": 7.74,
      "text": "I, I wanted to get burning pain in the upper tummy looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.75,
      "end_seconds": 31.27,
      "duration_seconds": 8.52,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.86,
      "end_seconds": 41.91,
      "duration_seconds": 9.05,
      "text": "Milk helps a bit. It's all the time. I'd rather know what's going on than keep guessing."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.95,
      "end_seconds": 46.94,
      "duration_seconds": 2.99,
      "text": "Right, is there anything else with it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 52.08,
      "end_seconds": 61.05,
      "duration_seconds": 8.97,
      "text": "Mild nausea goes along with it, most of the time. Erm, I've also been belching."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.73,
      "end_seconds": 81.09,
      "duration_seconds": 2.36,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.26,
      "end_seconds": 93.03,
      "duration_seconds": 2.77,
      "text": "Alright, sit still for a moment..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.07,
      "end_seconds": 115.55,
      "duration_seconds": 7.48,
      "text": "Okay: saturation 97 percent, heart rate 78. And BP is 110 over 79, temperature 36.4."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.11,
      "end_seconds": 119.1,
      "duration_seconds": 2.99,
      "text": "So, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.12,
      "end_seconds": 122.89,
      "duration_seconds": 2.77,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.26,
      "end_seconds": 129.38,
      "duration_seconds": 4.12,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.97,
      "end_seconds": 140.67,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.39,
      "end_seconds": 143.69,
      "duration_seconds": 1.3,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 155.2,
      "end_seconds": 160.08,
      "duration_seconds": 4.88,
      "text": "Your tummy is soft with some tenderness in the upper middle part."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.11,
      "end_seconds": 167.1,
      "duration_seconds": 3.99,
      "text": "Please sit back down. Has there been any difficulty swallowing?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.76,
      "end_seconds": 172.35,
      "duration_seconds": 3.59,
      "text": "I haven't noticed any difficulty swallowing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.26,
      "end_seconds": 179.62,
      "duration_seconds": 6.36,
      "text": "Let me check a few things. Any vomiting blood, jaundice or weight loss?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.66,
      "end_seconds": 184.93,
      "duration_seconds": 4.27,
      "text": "I mean, um, none of those, no."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.2,
      "end_seconds": 189.62,
      "duration_seconds": 3.42,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 190.24,
      "end_seconds": 193.06,
      "duration_seconds": 2.82,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.88,
      "end_seconds": 198.18,
      "duration_seconds": 3.3,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.44,
      "end_seconds": 201.37,
      "duration_seconds": 1.93,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.04,
      "end_seconds": 206.07,
      "duration_seconds": 4.03,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.17,
      "end_seconds": 210.61,
      "duration_seconds": 3.44,
      "text": "My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.15,
      "end_seconds": 225.7,
      "duration_seconds": 3.55,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.47,
      "end_seconds": 234.36,
      "duration_seconds": 7.89,
      "text": "It's something called pant... pantoprazole, 40 milligrams, maybe, before breakfast for my acidity."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.13,
      "end_seconds": 239.56,
      "duration_seconds": 3.43,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.38,
      "end_seconds": 251.96,
      "duration_seconds": 11.58,
      "text": "Not with me. I'll bring it next time. Antacid. I take it when needed. Omeprazole I don't take anymore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.59,
      "end_seconds": 256.87,
      "duration_seconds": 3.28,
      "text": "Right, do you work outside the home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 257.88,
      "end_seconds": 262.86,
      "duration_seconds": 4.98,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.78,
      "end_seconds": 265.48,
      "duration_seconds": 1.7,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.21,
      "end_seconds": 270.99,
      "duration_seconds": 3.78,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.51,
      "end_seconds": 273.89,
      "duration_seconds": 2.38,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.64,
      "end_seconds": 293.23,
      "duration_seconds": 17.59,
      "text": "I've had acid reflux for nearly five years now. I'm hoping you can tell me something definite. I told myself I'd wait and see, you know, and here I am."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.17,
      "end_seconds": 312.0,
      "duration_seconds": 14.83,
      "text": "Right, so acid reflux is already on your record. We'll keep that in mind today. Okay, so my impression is this: I think we're dealing with dyspepsia possibly related to anti-inflammatory tablets at this stage."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 316.02,
      "end_seconds": 319.72,
      "duration_seconds": 3.7,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.81,
      "end_seconds": 355.47,
      "duration_seconds": 33.66,
      "text": "I can't promise yet, but most people with dyspepsia possibly related to anti-inflammatory tablets do well once it's treated properly. Blood tests is what I'd like next, for dyspepsia. I'd like to arrange a test for the stomach germ for dyspepsia. Please stop taking the anti-inflammatory tablets for now and use paracetamol for the pain. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.71,
      "end_seconds": 360.41,
      "duration_seconds": 3.7,
      "text": "Yes, I'll bear that in mind."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.45,
      "end_seconds": 368.08,
      "duration_seconds": 6.63,
      "text": "Let's review you after the test result. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.19,
      "end_seconds": 372.95,
      "duration_seconds": 3.76,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.41,
      "end_seconds": 375.7,
      "duration_seconds": 1.29,
      "text": "Look after yourself."
    }
  ]
}