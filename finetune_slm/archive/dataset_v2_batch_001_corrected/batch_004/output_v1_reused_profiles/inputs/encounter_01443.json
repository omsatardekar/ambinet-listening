{
  "schema_version": "1.0",
  "encounter_id": "01443",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 4.99,
      "duration_seconds": 4.42,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 11.13,
      "duration_seconds": 4.34,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.01,
      "end_seconds": 19.64,
      "duration_seconds": 6.63,
      "text": "Yeah, it's itchy raised red welts. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.61,
      "end_seconds": 23.72,
      "duration_seconds": 3.11,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.6,
      "end_seconds": 28.94,
      "duration_seconds": 3.34,
      "text": "Yesterday, it came on out of nowhere."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.89,
      "end_seconds": 33.7,
      "duration_seconds": 3.81,
      "text": "Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.43,
      "end_seconds": 36.25,
      "duration_seconds": 1.82,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.99,
      "end_seconds": 40.59,
      "duration_seconds": 2.6,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.9,
      "end_seconds": 48.89,
      "duration_seconds": 2.99,
      "text": "Well, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.4,
      "end_seconds": 52.79,
      "duration_seconds": 3.39,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.55,
      "end_seconds": 58.1,
      "duration_seconds": 3.55,
      "text": "Hmm, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.07,
      "end_seconds": 62.83,
      "duration_seconds": 2.76,
      "text": "Do you take any regular medication?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.24,
      "end_seconds": 68.0,
      "duration_seconds": 3.76,
      "text": "No, uh, I'm not on anything."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.99,
      "end_seconds": 70.87,
      "duration_seconds": 1.88,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.06,
      "end_seconds": 76.38,
      "duration_seconds": 4.32,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.9,
      "end_seconds": 82.01,
      "duration_seconds": 2.11,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.26,
      "end_seconds": 87.78,
      "duration_seconds": 4.52,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.01,
      "end_seconds": 91.38,
      "duration_seconds": 2.37,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.4,
      "end_seconds": 97.11,
      "duration_seconds": 3.71,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.71,
      "end_seconds": 102.14,
      "duration_seconds": 3.43,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.18,
      "end_seconds": 104.92,
      "duration_seconds": 1.74,
      "text": "Not really, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.0,
      "end_seconds": 110.63,
      "duration_seconds": 3.63,
      "text": "Have you noticed throat tightness or joint pain?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.06,
      "end_seconds": 117.79,
      "duration_seconds": 5.73,
      "text": "I mean, uh, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 119.76,
      "end_seconds": 122.73,
      "duration_seconds": 2.97,
      "text": "Right, any new medicines or fever?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.98,
      "end_seconds": 126.9,
      "duration_seconds": 2.92,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.51,
      "end_seconds": 131.05,
      "duration_seconds": 2.54,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.88,
      "end_seconds": 134.37,
      "duration_seconds": 1.49,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.01,
      "end_seconds": 149.07,
      "duration_seconds": 2.06,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.55,
      "end_seconds": 162.65,
      "duration_seconds": 2.1,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.86,
      "end_seconds": 180.1,
      "duration_seconds": 7.24,
      "text": "Okay: heart rate 68, temperature 36.5, blood pressure 113 over 81. And saturation 99 percent."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 181.7,
      "end_seconds": 185.73,
      "duration_seconds": 4.03,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.62,
      "end_seconds": 202.3,
      "duration_seconds": 1.68,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.01,
      "end_seconds": 205.42,
      "duration_seconds": 1.41,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.86,
      "end_seconds": 229.53,
      "duration_seconds": 5.67,
      "text": "Lips look a little puffy, but the tongue and throat are normal."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.18,
      "end_seconds": 232.45,
      "duration_seconds": 1.27,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.17,
      "end_seconds": 249.48,
      "duration_seconds": 5.31,
      "text": "There are raised pink welts on the chest and back, some joined together."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.27,
      "end_seconds": 255.33,
      "duration_seconds": 3.06,
      "text": "Alright, thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.18,
      "end_seconds": 275.32,
      "duration_seconds": 4.14,
      "text": "Let's book an allergy test to look into recurrent urticaria."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 280.35,
      "end_seconds": 283.02,
      "duration_seconds": 2.67,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.61,
      "end_seconds": 308.47,
      "duration_seconds": 23.86,
      "text": "What I'm giving you is prednisolone, 20 milligrams, once a day, for three days. That's for hives. Write down anything new you ate, took or used before this started, even small things. I'd like you back in two weeks. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.77,
      "end_seconds": 314.74,
      "duration_seconds": 3.97,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.98,
      "end_seconds": 317.2,
      "duration_seconds": 1.22,
      "text": "Take care now."
    }
  ]
}