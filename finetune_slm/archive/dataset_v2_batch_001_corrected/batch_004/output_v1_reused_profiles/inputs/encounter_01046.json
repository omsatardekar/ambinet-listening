{
  "schema_version": "1.0",
  "encounter_id": "01046",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.54,
      "end_seconds": 4.75,
      "duration_seconds": 4.21,
      "text": "Hello? Doctor? I was told to come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.15,
      "end_seconds": 10.2,
      "duration_seconds": 4.05,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.17,
      "end_seconds": 22.16,
      "duration_seconds": 7.99,
      "text": "Mainly a sore throat. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.94,
      "end_seconds": 27.28,
      "duration_seconds": 3.34,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.37,
      "end_seconds": 32.87,
      "duration_seconds": 4.5,
      "text": "Actually, I'm on Dolo, when I get the fever."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.78,
      "end_seconds": 36.04,
      "duration_seconds": 2.26,
      "text": "And what strength is that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.5,
      "end_seconds": 38.57,
      "duration_seconds": 1.07,
      "text": "650 milligrams."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.97,
      "end_seconds": 53.65,
      "duration_seconds": 3.68,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.6,
      "end_seconds": 61.35,
      "duration_seconds": 2.75,
      "text": "Ever since... since Monday, really."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.68,
      "end_seconds": 71.52,
      "duration_seconds": 9.84,
      "text": "Yes, carry on. Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.34,
      "end_seconds": 81.02,
      "duration_seconds": 7.68,
      "text": "Oh, it settles a little with lozenges and warm drinks. Swallowing definitely sets it off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.93,
      "end_seconds": 83.85,
      "duration_seconds": 1.92,
      "text": "Any drooling or rash?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.49,
      "end_seconds": 88.95,
      "duration_seconds": 2.46,
      "text": "No, no drooling or rash."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.83,
      "end_seconds": 96.56,
      "duration_seconds": 5.73,
      "text": "Let me check a few things. Any trouble opening the mouth or ear pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.96,
      "end_seconds": 102.17,
      "duration_seconds": 4.21,
      "text": "Let me think, nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.11,
      "end_seconds": 105.58,
      "duration_seconds": 2.47,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.67,
      "end_seconds": 108.43,
      "duration_seconds": 1.76,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.08,
      "end_seconds": 112.52,
      "duration_seconds": 3.44,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.8,
      "end_seconds": 115.9,
      "duration_seconds": 2.1,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.08,
      "end_seconds": 126.83,
      "duration_seconds": 3.75,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.57,
      "end_seconds": 131.45,
      "duration_seconds": 2.88,
      "text": "No, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.18,
      "end_seconds": 151.41,
      "duration_seconds": 3.23,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 153.44,
      "end_seconds": 156.92,
      "duration_seconds": 3.48,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.08,
      "end_seconds": 160.31,
      "duration_seconds": 2.23,
      "text": "Okay, do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.38,
      "end_seconds": 171.75,
      "duration_seconds": 5.37,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.97,
      "end_seconds": 175.88,
      "duration_seconds": 2.91,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.86,
      "end_seconds": 182.05,
      "duration_seconds": 5.19,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.58,
      "end_seconds": 184.54,
      "duration_seconds": 1.96,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 186.34,
      "end_seconds": 190.06,
      "duration_seconds": 3.72,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.76,
      "end_seconds": 193.77,
      "duration_seconds": 2.01,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.46,
      "end_seconds": 204.13,
      "duration_seconds": 2.67,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.75,
      "end_seconds": 228.84,
      "duration_seconds": 10.09,
      "text": "Okay: pressure 107 over 67, pulse is 98 beats a minute, saturation 97 percent, respiratory rate 21, temperature is 38.9 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 230.09,
      "end_seconds": 231.53,
      "duration_seconds": 1.44,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.61,
      "end_seconds": 236.42,
      "duration_seconds": 2.81,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.65,
      "end_seconds": 240.48,
      "duration_seconds": 2.83,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.58,
      "end_seconds": 244.38,
      "duration_seconds": 2.8,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.81,
      "end_seconds": 264.36,
      "duration_seconds": 6.55,
      "text": "Both tonsils are red and enlarged with white patches, and the neck glands are tender."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.44,
      "end_seconds": 269.1,
      "duration_seconds": 1.66,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.07,
      "end_seconds": 303.76,
      "duration_seconds": 15.69,
      "text": "So where does that leave us? My working impression is tonsillitis. The reason I say that is that your story and my examination fit together. I think a throat swab makes sense here, for sore throat."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.21,
      "end_seconds": 306.56,
      "duration_seconds": 1.35,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.59,
      "end_seconds": 335.28,
      "duration_seconds": 27.69,
      "text": "Let's use phenoxymethylpenicillin, 500 milligrams, four times a day, for ten days. You take it by mouth. It's for tonsillitis. Gargle with warm salt water and drink plenty of fluids. Cut down on salt and fried food for now, it really does make a difference. If you cannot swallow your saliva or have trouble breathing, or you feel really unwell, please come to the emergency department."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.87,
      "end_seconds": 340.29,
      "duration_seconds": 3.42,
      "text": "Actually, okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.26,
      "end_seconds": 350.52,
      "duration_seconds": 9.26,
      "text": "See me again if it isn't better in three days. Right, anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 355.67,
      "end_seconds": 357.19,
      "duration_seconds": 1.52,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.79,
      "end_seconds": 362.24,
      "duration_seconds": 1.45,
      "text": "All the best."
    }
  ]
}