{
  "schema_version": "1.0",
  "encounter_id": "01094",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.23,
      "end_seconds": 8.16,
      "duration_seconds": 6.93,
      "text": "Alright, good morning. I've just opened your notes. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.65,
      "end_seconds": 12.79,
      "duration_seconds": 3.14,
      "text": "Well, I've been having trouble sleeping."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.25,
      "end_seconds": 18.02,
      "duration_seconds": 4.77,
      "text": "Hm, okay. Rate it for me, mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 19.29,
      "end_seconds": 20.83,
      "duration_seconds": 1.54,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.33,
      "end_seconds": 25.53,
      "duration_seconds": 3.2,
      "text": "Have you noticed anything else alongside it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.49,
      "end_seconds": 31.98,
      "duration_seconds": 4.49,
      "text": "It usually comes with a tight chest when stressed."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.49,
      "end_seconds": 34.65,
      "duration_seconds": 2.16,
      "text": "Have you been feeling low?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.93,
      "end_seconds": 37.46,
      "duration_seconds": 1.53,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 39.02,
      "end_seconds": 42.3,
      "duration_seconds": 3.28,
      "text": "Right, have you been losing interest in things?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.1,
      "end_seconds": 47.06,
      "duration_seconds": 3.96,
      "text": "Yes, about the same, nearly five years."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 48.52,
      "end_seconds": 51.63,
      "duration_seconds": 3.11,
      "text": "Okay, how much does it limit you?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.38,
      "end_seconds": 55.0,
      "duration_seconds": 1.62,
      "text": "It's mild, honestly."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.55,
      "end_seconds": 56.25,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.35,
      "end_seconds": 62.7,
      "duration_seconds": 5.35,
      "text": "The tight chest when stressed? That's been for about a month."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 73.39,
      "end_seconds": 86.16,
      "duration_seconds": 12.77,
      "text": "Okay, so the vitals from earlier. BP is 125 over 72, height 168 centimetres, pulse 81, respiratory rate 18, weight 95 kilos, oxygen saturation is 97 percent, temperature is 36.6 degrees."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.93,
      "end_seconds": 88.63,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.83,
      "end_seconds": 94.86,
      "duration_seconds": 5.03,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.87,
      "end_seconds": 99.28,
      "duration_seconds": 3.41,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 117.58,
      "end_seconds": 124.0,
      "duration_seconds": 6.42,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.13,
      "end_seconds": 134.66,
      "duration_seconds": 8.53,
      "text": "Good, you can sit up again. Let me check a few things. Any weight loss, chest pain or panic attacks?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.69,
      "end_seconds": 140.73,
      "duration_seconds": 5.04,
      "text": "No, no weight loss, chest pain or panic attacks."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.44,
      "end_seconds": 148.31,
      "duration_seconds": 6.87,
      "text": "Let me check a few things. Any hearing voices, thoughts of harming myself or drinking more?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.39,
      "end_seconds": 152.27,
      "duration_seconds": 2.88,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.29,
      "end_seconds": 158.77,
      "duration_seconds": 3.48,
      "text": "Alright, how are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.75,
      "end_seconds": 161.27,
      "duration_seconds": 1.52,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.78,
      "end_seconds": 168.4,
      "duration_seconds": 3.62,
      "text": "Alright, any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.24,
      "end_seconds": 177.74,
      "duration_seconds": 8.5,
      "text": "I've had depression for about a year now. I've had anxiety for about ten years now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 179.09,
      "end_seconds": 179.79,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.76,
      "end_seconds": 185.14,
      "duration_seconds": 3.38,
      "text": "High blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 185.81,
      "end_seconds": 192.0,
      "duration_seconds": 6.19,
      "text": "Okay, I can see depression and anxiety in your file as well. How about smoking?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.92,
      "end_seconds": 196.65,
      "duration_seconds": 3.73,
      "text": "I have about eight cigarettes in a day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.82,
      "end_seconds": 199.61,
      "duration_seconds": 1.79,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.37,
      "end_seconds": 206.73,
      "duration_seconds": 5.36,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.89,
      "end_seconds": 210.78,
      "duration_seconds": 2.89,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 212.17,
      "end_seconds": 216.07,
      "duration_seconds": 3.9,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 217.19,
      "end_seconds": 219.47,
      "duration_seconds": 2.28,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 221.27,
      "end_seconds": 223.61,
      "duration_seconds": 2.34,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.15,
      "end_seconds": 228.85,
      "duration_seconds": 3.7,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 229.38,
      "end_seconds": 233.12,
      "duration_seconds": 3.74,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 243.12,
      "end_seconds": 247.23,
      "duration_seconds": 4.11,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 251.03,
      "end_seconds": 254.69,
      "duration_seconds": 3.66,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 256.52,
      "end_seconds": 258.86,
      "duration_seconds": 2.34,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 260.86,
      "end_seconds": 267.78,
      "duration_seconds": 6.92,
      "text": "Yes, I had my appendix taken out, when I was in my twenties."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.33,
      "end_seconds": 279.58,
      "duration_seconds": 3.25,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.64,
      "end_seconds": 288.34,
      "duration_seconds": 5.7,
      "text": "My daughter has type 1 diabetes. My father had bowel cancer."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.89,
      "end_seconds": 291.81,
      "duration_seconds": 2.92,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 293.89,
      "end_seconds": 297.39,
      "duration_seconds": 3.5,
      "text": "Escitalopram, 10 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.12,
      "end_seconds": 302.4,
      "duration_seconds": 4.28,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 304.33,
      "end_seconds": 306.49,
      "duration_seconds": 2.16,
      "text": "No, it's at home."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.41,
      "end_seconds": 326.87,
      "duration_seconds": 19.46,
      "text": "Okay, so my impression is this: This looks most like low mood linked to work stress. It could also be an under-active thyroid, so we'll keep that open. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 330.47,
      "end_seconds": 332.06,
      "duration_seconds": 1.59,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.76,
      "end_seconds": 340.11,
      "duration_seconds": 6.35,
      "text": "There's nothing new for me to start or arrange today. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 341.02,
      "end_seconds": 344.26,
      "duration_seconds": 3.24,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.08,
      "end_seconds": 347.31,
      "duration_seconds": 1.23,
      "text": "Look after yourself."
    }
  ]
}