{
  "schema_version": "1.0",
  "encounter_id": "01480",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.53,
      "end_seconds": 4.15,
      "duration_seconds": 3.62,
      "text": "Come in, have a seat by the desk."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.0,
      "end_seconds": 7.68,
      "duration_seconds": 2.68,
      "text": "Hello. I hope I'm not late."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.59,
      "end_seconds": 12.49,
      "duration_seconds": 3.9,
      "text": "What would you like to start with today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.29,
      "end_seconds": 16.87,
      "duration_seconds": 3.58,
      "text": "I've been feeling dizzy when I stand up."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 18.97,
      "end_seconds": 22.16,
      "duration_seconds": 3.19,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.76,
      "end_seconds": 24.71,
      "duration_seconds": 1.95,
      "text": "Probably two weeks. Yeah."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.76,
      "end_seconds": 27.35,
      "duration_seconds": 1.59,
      "text": "Anything that improves it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.47,
      "end_seconds": 32.25,
      "duration_seconds": 3.78,
      "text": "Well, sitting back down helps a bit."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 34.13,
      "end_seconds": 37.03,
      "duration_seconds": 2.9,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.86,
      "end_seconds": 40.1,
      "duration_seconds": 1.24,
      "text": "Mild, really."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.83,
      "end_seconds": 47.34,
      "duration_seconds": 6.51,
      "text": "I, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 47.44,
      "end_seconds": 53.42,
      "duration_seconds": 5.98,
      "text": "Sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.3,
      "end_seconds": 57.66,
      "duration_seconds": 2.36,
      "text": "Later, thanks. Please go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 58.96,
      "end_seconds": 65.05,
      "duration_seconds": 6.09,
      "text": "I've had a pounding in my head too, for about a week."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 65.78,
      "end_seconds": 68.77,
      "duration_seconds": 2.99,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.46,
      "end_seconds": 73.13,
      "duration_seconds": 2.67,
      "text": "I, I'd call it severe."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_4",
      "role": "UNKNOWN",
      "start_seconds": 75.06,
      "end_seconds": 78.85,
      "duration_seconds": 3.79,
      "text": "Yes, that's right, that's how it was."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.62,
      "end_seconds": 84.05,
      "duration_seconds": 3.43,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.08,
      "end_seconds": 91.3,
      "duration_seconds": 5.22,
      "text": "My uncle has high cholesterol. My grandfather had a stroke."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.97,
      "end_seconds": 94.29,
      "duration_seconds": 2.32,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.05,
      "end_seconds": 105.19,
      "duration_seconds": 9.14,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. Tamsulosin. I take it 0.4 milligrams, maybe, at night for the prostate."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.01,
      "end_seconds": 111.76,
      "duration_seconds": 4.75,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 112.46,
      "end_seconds": 120.02,
      "duration_seconds": 7.56,
      "text": "No, it's at home. I take hydrocortisone cream, when needed. Losartan I don't take anymore."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.91,
      "end_seconds": 123.14,
      "duration_seconds": 2.23,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 123.84,
      "end_seconds": 130.03,
      "duration_seconds": 6.19,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.51,
      "end_seconds": 133.61,
      "duration_seconds": 2.1,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.42,
      "end_seconds": 139.08,
      "duration_seconds": 4.66,
      "text": "I have high blood pressure, for about ten years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.72,
      "end_seconds": 141.42,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.3,
      "end_seconds": 144.39,
      "duration_seconds": 2.09,
      "text": "Yes, an enlarged prostate."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 146.47,
      "end_seconds": 147.29,
      "duration_seconds": 0.82,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.3,
      "end_seconds": 152.87,
      "duration_seconds": 3.57,
      "text": "I've had eczema for two years now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.39,
      "end_seconds": 158.54,
      "duration_seconds": 5.15,
      "text": "Okay, I can see high blood pressure in your file as well."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.57,
      "end_seconds": 176.93,
      "duration_seconds": 4.36,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 177.76,
      "end_seconds": 192.0,
      "duration_seconds": 14.24,
      "text": "Hmm, you know, there was some antibiotic, I was told I was allergic. But I couldn't tell you what it was called or what it did."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 192.97,
      "end_seconds": 197.2,
      "duration_seconds": 4.23,
      "text": "Have you had any fainting, chest pain or slurred speech?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.22,
      "end_seconds": 213.79,
      "duration_seconds": 14.57,
      "text": "Uh, no, no fainting, no chest pain, no slurred speech. I was feeling weak at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.41,
      "end_seconds": 217.68,
      "duration_seconds": 3.27,
      "text": "And what about black stools, vomiting or palpitations?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.82,
      "end_seconds": 223.36,
      "duration_seconds": 4.54,
      "text": "No black stools, vomiting or palpitations, none of it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.95,
      "end_seconds": 226.72,
      "duration_seconds": 2.77,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 227.5,
      "end_seconds": 228.43,
      "duration_seconds": 0.93,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 229.24,
      "end_seconds": 239.87,
      "duration_seconds": 10.63,
      "text": "Okay, so the vitals from earlier. BP is 98 over 66, respiratory rate 18, saturation 96 percent, heart rate 107, temp 36.7 degrees."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.73,
      "end_seconds": 243.08,
      "duration_seconds": 1.35,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.77,
      "end_seconds": 248.91,
      "duration_seconds": 4.14,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.42,
      "end_seconds": 250.37,
      "duration_seconds": 0.95,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.55,
      "end_seconds": 253.23,
      "duration_seconds": 1.68,
      "text": "Okay, nearly finished here."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.25,
      "end_seconds": 274.37,
      "duration_seconds": 4.12,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 276.33,
      "end_seconds": 277.71,
      "duration_seconds": 1.38,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.35,
      "end_seconds": 297.94,
      "duration_seconds": 5.59,
      "text": "Your blood pressure drops when you stand, from the lying reading to standing."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.61,
      "end_seconds": 306.13,
      "duration_seconds": 2.52,
      "text": "Good, you can sit up again."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.33,
      "end_seconds": 331.31,
      "duration_seconds": 14.98,
      "text": "Taking everything into account, it fits best with postural low blood pressure, possibly related to medicines or dehydration. I can't rule out an abnormal heart rhythm yet. Another possibility is dehydration."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.4,
      "end_seconds": 334.75,
      "duration_seconds": 1.35,
      "text": "Is this permanent?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 335.8,
      "end_seconds": 350.37,
      "duration_seconds": 14.57,
      "text": "It's reasonable to be concerned, but right now postural low blood pressure, possibly related to medicines or dehydration is my leading thought, not anything worse. I'm going to order an ECG, for dizziness."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_5",
      "role": "CLINICAL_STAFF",
      "start_seconds": 353.64,
      "end_seconds": 357.12,
      "duration_seconds": 3.48,
      "text": "I can book that for Friday at 10 am."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 357.99,
      "end_seconds": 360.74,
      "duration_seconds": 2.75,
      "text": "Friday, that works for me."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 363.19,
      "end_seconds": 389.08,
      "duration_seconds": 25.89,
      "text": "I want a lying and standing blood pressure check done, that's for dizziness. Get up slowly from lying and sitting, and keep drinking fluids through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Come back in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.27,
      "end_seconds": 393.56,
      "duration_seconds": 3.29,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.06,
      "end_seconds": 396.41,
      "duration_seconds": 1.35,
      "text": "Take care now."
    }
  ]
}