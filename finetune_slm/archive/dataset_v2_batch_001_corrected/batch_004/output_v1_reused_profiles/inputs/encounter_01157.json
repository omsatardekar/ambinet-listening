{
  "schema_version": "1.0",
  "encounter_id": "01157",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.88,
      "end_seconds": 5.48,
      "duration_seconds": 4.6,
      "text": "Hello, um, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.12,
      "end_seconds": 11.53,
      "duration_seconds": 4.41,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.84,
      "end_seconds": 18.17,
      "duration_seconds": 5.33,
      "text": "Uh, good morning, doctor. I came along to help out."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.27,
      "end_seconds": 22.62,
      "duration_seconds": 3.35,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.85,
      "end_seconds": 29.92,
      "duration_seconds": 6.07,
      "text": "Well, I've been having tight shoes by the end of the day."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 31.82,
      "end_seconds": 35.03,
      "duration_seconds": 3.21,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.93,
      "end_seconds": 38.97,
      "duration_seconds": 3.04,
      "text": "It's been one week now."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.26,
      "end_seconds": 49.71,
      "duration_seconds": 9.45,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.2,
      "end_seconds": 79.89,
      "duration_seconds": 28.69,
      "text": "A three out of ten, I suppose. Honestly, once or twice a day. And there's a bit of a headache as well, two days now. And a flushed face sometimes, too. As for flushed face sometimes, I'd say severe. It's every other day. I had a heavy feeling in the legs before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 81.8,
      "end_seconds": 90.81,
      "duration_seconds": 9.01,
      "text": "Have you had tight shoes by the end of the day before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.91,
      "end_seconds": 99.2,
      "duration_seconds": 6.29,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.77,
      "end_seconds": 110.93,
      "duration_seconds": 10.16,
      "text": "Okay, a few quick ones: breathlessness lying flat, one leg more swollen than the other, weight gain or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.35,
      "end_seconds": 122.86,
      "duration_seconds": 10.51,
      "text": "No, no breathlessness lying flat, one leg more swollen than the other, weight gain or chest pain."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.52,
      "end_seconds": 126.07,
      "duration_seconds": 2.55,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.18,
      "end_seconds": 130.83,
      "duration_seconds": 3.65,
      "text": "Um, nothing on the skin, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.96,
      "end_seconds": 136.18,
      "duration_seconds": 4.22,
      "text": "Alright, anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.87,
      "end_seconds": 140.47,
      "duration_seconds": 2.6,
      "text": "I have high blood pressure."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.71,
      "end_seconds": 144.7,
      "duration_seconds": 2.99,
      "text": "Right, and anything else to add?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 146.28,
      "end_seconds": 150.18,
      "duration_seconds": 3.9,
      "text": "I have migraines, for nearly five years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.3,
      "end_seconds": 155.64,
      "duration_seconds": 2.34,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.65,
      "end_seconds": 161.24,
      "duration_seconds": 4.59,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.47,
      "end_seconds": 165.79,
      "duration_seconds": 3.32,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.52,
      "end_seconds": 171.12,
      "duration_seconds": 3.6,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.95,
      "end_seconds": 175.69,
      "duration_seconds": 2.74,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 176.87,
      "end_seconds": 180.51,
      "duration_seconds": 3.64,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.17,
      "end_seconds": 186.86,
      "duration_seconds": 4.69,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.42,
      "end_seconds": 192.42,
      "duration_seconds": 4.0,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 194.12,
      "end_seconds": 202.01,
      "duration_seconds": 7.89,
      "text": "Hold on, doctor, I think she reacted to naproxen once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.66,
      "end_seconds": 209.44,
      "duration_seconds": 2.78,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.61,
      "end_seconds": 215.8,
      "duration_seconds": 3.19,
      "text": "Fair enough, I'll write down both versions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.14,
      "end_seconds": 235.72,
      "duration_seconds": 7.58,
      "text": "Can you list what you take, tablets, creams or inhalers? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 237.53,
      "end_seconds": 250.99,
      "duration_seconds": 13.46,
      "text": "She is on telmisartan, 40 milligrams, once a day, I give it to her. She takes propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 255.76,
      "duration_seconds": 4.06,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.68,
      "end_seconds": 263.36,
      "duration_seconds": 6.68,
      "text": "My daughter has type 1 diabetes. My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.28,
      "end_seconds": 270.81,
      "duration_seconds": 4.53,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.13,
      "end_seconds": 283.83,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.74,
      "end_seconds": 286.7,
      "duration_seconds": 1.96,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.08,
      "end_seconds": 301.34,
      "duration_seconds": 4.26,
      "text": "Mild pitting swelling around both ankles, equal on both sides."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.05,
      "end_seconds": 305.48,
      "duration_seconds": 2.43,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.11,
      "end_seconds": 326.72,
      "duration_seconds": 3.61,
      "text": "Chest is clear and the neck veins aren't raised."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.41,
      "end_seconds": 334.03,
      "duration_seconds": 1.62,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.86,
      "end_seconds": 350.42,
      "duration_seconds": 6.56,
      "text": "For now, no new medicines or tests are needed. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.37,
      "end_seconds": 354.97,
      "duration_seconds": 3.6,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.85,
      "end_seconds": 358.09,
      "duration_seconds": 1.24,
      "text": "See you soon."
    }
  ]
}