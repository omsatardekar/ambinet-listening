{
  "schema_version": "1.0",
  "encounter_id": "01025",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.3,
      "end_seconds": 5.11,
      "duration_seconds": 3.81,
      "text": "Good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.95,
      "end_seconds": 10.46,
      "duration_seconds": 4.51,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.84,
      "end_seconds": 18.84,
      "duration_seconds": 7.0,
      "text": "Right, it's aching bones and muscles. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.81,
      "end_seconds": 26.23,
      "duration_seconds": 2.42,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.94,
      "end_seconds": 41.49,
      "duration_seconds": 2.55,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.54,
      "end_seconds": 61.21,
      "duration_seconds": 7.67,
      "text": "Okay: heart rate 86, height 167 centimetres. And temperature 36.4, pressure 123 over 70, weight 86 kilos."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.92,
      "end_seconds": 77.88,
      "duration_seconds": 1.96,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.37,
      "end_seconds": 89.78,
      "duration_seconds": 10.41,
      "text": "For two weeks, I'd say. It's the not knowing that gets to me. I'm hoping you can tell me something definite."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.93,
      "end_seconds": 100.02,
      "duration_seconds": 9.09,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.86,
      "end_seconds": 109.41,
      "duration_seconds": 7.55,
      "text": "A seven out of ten, I suppose. I'd say a few times a day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.62,
      "end_seconds": 114.71,
      "duration_seconds": 4.09,
      "text": "Did you get weight loss, poor diet or black stools?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.77,
      "end_seconds": 122.65,
      "duration_seconds": 5.88,
      "text": "I haven't had weight loss, poor diet or black stools, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.37,
      "end_seconds": 126.14,
      "duration_seconds": 2.77,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.65,
      "end_seconds": 129.27,
      "duration_seconds": 2.62,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.52,
      "end_seconds": 132.52,
      "duration_seconds": 2.0,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.38,
      "end_seconds": 145.63,
      "duration_seconds": 11.25,
      "text": "Yes, I had a varicose vein procedure, last year. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.97,
      "end_seconds": 160.42,
      "duration_seconds": 3.45,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.29,
      "end_seconds": 168.14,
      "duration_seconds": 4.85,
      "text": "Sorry, what was I saying, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.71,
      "end_seconds": 171.75,
      "duration_seconds": 2.04,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.69,
      "end_seconds": 176.65,
      "duration_seconds": 3.96,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.92,
      "end_seconds": 179.29,
      "duration_seconds": 1.37,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.24,
      "end_seconds": 185.38,
      "duration_seconds": 4.14,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.41,
      "end_seconds": 190.32,
      "duration_seconds": 2.91,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 191.26,
      "end_seconds": 195.4,
      "duration_seconds": 4.14,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.23,
      "end_seconds": 199.05,
      "duration_seconds": 1.82,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 199.67,
      "end_seconds": 203.45,
      "duration_seconds": 3.78,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.8,
      "end_seconds": 208.98,
      "duration_seconds": 4.18,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.63,
      "end_seconds": 212.15,
      "duration_seconds": 1.52,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.63,
      "end_seconds": 215.69,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.54,
      "end_seconds": 218.64,
      "duration_seconds": 2.1,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.5,
      "end_seconds": 230.96,
      "duration_seconds": 3.46,
      "text": "Gentle pressure over the shin bone is tender."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.01,
      "end_seconds": 235.89,
      "duration_seconds": 1.88,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.34,
      "end_seconds": 251.31,
      "duration_seconds": 4.97,
      "text": "Right, here's what I'm thinking. My working impression is a vitamin deficiency."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.52,
      "end_seconds": 256.6,
      "duration_seconds": 4.08,
      "text": "Actually, you know, is this serious, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.33,
      "end_seconds": 286.23,
      "duration_seconds": 28.9,
      "text": "I understand the worry. At the moment I'd say it's a vitamin deficiency, and we'll know more once the a vitamin B12 level is back. I think a vitamin B12 level makes sense here, for tingling and tiredness. What I'm giving you is vitamin D, 60000 units, once a week, for eight weeks. You take it by mouth. It's for possible deficiency. Some midday sunlight on the arms for fifteen minutes helps."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.86,
      "end_seconds": 303.75,
      "duration_seconds": 11.89,
      "text": "Please take the tablets with food so they don't upset your stomach. Book a review in two months. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.39,
      "end_seconds": 307.95,
      "duration_seconds": 3.56,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.0,
      "end_seconds": 310.31,
      "duration_seconds": 1.31,
      "text": "All the best."
    }
  ]
}