  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.01,
      "end_seconds": 3.96,
      "duration_seconds": 2.95,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.13,
      "end_seconds": 7.74,
      "duration_seconds": 2.61,
      "text": "Good morning, doctor, thank you."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.67,
      "end_seconds": 12.76,
      "duration_seconds": 2.09,
      "text": "What's the main thing today?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 14.81,
      "end_seconds": 19.28,
      "duration_seconds": 4.47,
      "text": "It's pain after sitting for a while, mostly."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.21,
      "end_seconds": 21.39,
      "duration_seconds": 1.18,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 22.31,
      "end_seconds": 33.45,
      "duration_seconds": 11.14,
      "text": "honestly I can't say exactly when it started it might have been last month or the month before, I really can't pin it down"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.92,
      "end_seconds": 39.71,
      "duration_seconds": 2.79,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.39,
      "end_seconds": 55.64,
      "duration_seconds": 14.25,
      "text": "I'd say severe. And there's pain in my heel as well, three weeks now. An ache along the arch was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.73,
      "end_seconds": 62.13,
      "duration_seconds": 4.4,
      "text": "So, do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.29,
      "end_seconds": 66.41,
      "duration_seconds": 3.12,
      "text": "No, I've always been fairly healthy."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 68.22,
      "end_seconds": 72.89,
      "duration_seconds": 4.67,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.83,
      "end_seconds": 79.89,
      "duration_seconds": 3.06,
      "text": "Insoles. I take it every day."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.22,
      "end_seconds": 86.18,
      "duration_seconds": 4.96,
      "text": "are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.75,
      "end_seconds": 89.29,
      "duration_seconds": 2.54,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 105.86,
      "end_seconds": 107.17,
      "duration_seconds": 1.31,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.01,
      "end_seconds": 113.1,
      "duration_seconds": 4.09,
      "text": "No, I've never smoked in my life"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.23,
      "end_seconds": 116.4,
      "duration_seconds": 2.17,
      "text": "Do you do any exercise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.7,
      "end_seconds": 120.4,
      "duration_seconds": 2.7,
      "text": "I swim twice a week."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.3,
      "end_seconds": 122.98,
      "duration_seconds": 1.68,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 124.35,
      "end_seconds": 128.16,
      "duration_seconds": 3.81,
      "text": "I grab fast food at lunch most days"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.08,
      "end_seconds": 139.81,
      "duration_seconds": 2.73,
      "text": "Did you get back pain or injury?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.15,
      "end_seconds": 145.53,
      "duration_seconds": 4.38,
      "text": "I haven't had back pain or injury, no."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.15,
      "end_seconds": 152.0,
      "duration_seconds": 4.85,
      "text": "Any fever, joint pain elsewhere or numbness in the foot?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.2,
      "end_seconds": 159.56,
      "duration_seconds": 6.36,
      "text": "No, no fever, joint pain elsewhere or numbness in the foot."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.29,
      "end_seconds": 163.88,
      "duration_seconds": 2.59,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 164.45,
      "end_seconds": 165.58,
      "duration_seconds": 1.13,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.84,
      "end_seconds": 170.47,
      "duration_seconds": 3.63,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.5,
      "end_seconds": 174.52,
      "duration_seconds": 2.02,
      "text": "no, that's been fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.78,
      "end_seconds": 179.44,
      "duration_seconds": 3.66,
      "text": "I'll examine you in a second, make yourself comfortable"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.36,
      "end_seconds": 182.65,
      "duration_seconds": 2.29,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 193.23,
      "end_seconds": 203.56,
      "duration_seconds": 10.33,
      "text": "There is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.79,
      "end_seconds": 209.92,
      "duration_seconds": 3.13,
      "text": "That's all I needed to to check."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.37,
      "end_seconds": 235.55,
      "duration_seconds": 10.18,
      "text": "okay, thinking it through, my working impression is plantar fasciitis the reason I say that is that your story and my examination fit together"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 237.35,
      "end_seconds": 240.73,
      "duration_seconds": 3.38,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.5,
      "end_seconds": 273.76,
      "duration_seconds": 32.26,
      "text": "I can't promise yet, but most people with plantar fasciitis do well once it's treated properly. I'll request a foot X-ray, it'll help with heel pain. For this, ibuprofen gel, three times a day, for two weeks. It's for heel pain. I'll put all of this in writing so you don't have to remember it. Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.05,
      "end_seconds": 287.63,
      "duration_seconds": 8.58,
      "text": "keep an eye out, and if the symptoms get worse, call us the same day or go to emergency"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 289.37,
      "end_seconds": 290.83,
      "duration_seconds": 1.46,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 292.11,
      "end_seconds": 299.79,
      "duration_seconds": 7.68,
      "text": "Let's plan a check in six weeks. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.5,
      "end_seconds": 304.84,
      "duration_seconds": 3.34,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}