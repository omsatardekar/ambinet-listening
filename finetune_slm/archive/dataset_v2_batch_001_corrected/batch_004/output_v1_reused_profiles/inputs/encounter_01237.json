  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 4.69,
      "duration_seconds": 3.87,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.88,
      "end_seconds": 12.59,
      "duration_seconds": 3.71,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.35,
      "end_seconds": 26.37,
      "duration_seconds": 13.02,
      "text": "So, honestly, it's some bleeding, and my family pushed me to come. My neighbour said I should get it looked at. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.58,
      "end_seconds": 30.4,
      "duration_seconds": 2.82,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.36,
      "end_seconds": 39.92,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.3,
      "end_seconds": 64.4,
      "duration_seconds": 14.1,
      "text": "Okay: BMI works out to 23.8, heart rate 83, temperature is 36.8 degrees, weight 77 kilos, oxygen saturation is 97 percent, height 180 centimetres, BP is 125 over 72."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.3,
      "end_seconds": 67.72,
      "duration_seconds": 1.42,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.4,
      "end_seconds": 75.3,
      "duration_seconds": 5.9,
      "text": "I'll come back to the numbers. Has this been going on for long?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 75.89,
      "end_seconds": 79.26,
      "duration_seconds": 3.37,
      "text": "It's been going on for one week."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.84,
      "end_seconds": 84.97,
      "duration_seconds": 5.13,
      "text": "Have you noticed fever, shoulder tip pain, passing tissue or fainting?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.78,
      "end_seconds": 91.55,
      "duration_seconds": 5.77,
      "text": "No, no fever, shoulder tip pain, passing tissue or fainting."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.15,
      "end_seconds": 97.82,
      "duration_seconds": 5.67,
      "text": "Right, right. Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.07,
      "end_seconds": 102.34,
      "duration_seconds": 3.27,
      "text": "No, um, nothing with my heart."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.13,
      "end_seconds": 122.48,
      "duration_seconds": 4.35,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.59,
      "end_seconds": 125.09,
      "duration_seconds": 1.5,
      "text": "I have eczema."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.72,
      "end_seconds": 129.15,
      "duration_seconds": 3.43,
      "text": "Alright, eczema, that matches what I have here."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.68,
      "end_seconds": 147.32,
      "duration_seconds": 3.64,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.77,
      "end_seconds": 151.67,
      "duration_seconds": 2.9,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.45,
      "end_seconds": 154.8,
      "duration_seconds": 2.35,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.93,
      "end_seconds": 160.41,
      "duration_seconds": 4.48,
      "text": "No, uh, I've never been operated on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.09,
      "end_seconds": 164.49,
      "duration_seconds": 2.4,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.08,
      "end_seconds": 171.63,
      "duration_seconds": 5.55,
      "text": "Mm, I'm on hydrocortisone cream, when needed for the eczema."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.23,
      "end_seconds": 177.04,
      "duration_seconds": 2.81,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.75,
      "end_seconds": 182.25,
      "duration_seconds": 3.5,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.55,
      "end_seconds": 187.78,
      "duration_seconds": 1.23,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.31,
      "end_seconds": 192.51,
      "duration_seconds": 3.2,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.62,
      "end_seconds": 199.38,
      "duration_seconds": 2.76,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 200.73,
      "end_seconds": 204.49,
      "duration_seconds": 3.76,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.99,
      "end_seconds": 210.94,
      "duration_seconds": 3.95,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.83,
      "end_seconds": 213.77,
      "duration_seconds": 1.94,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.11,
      "end_seconds": 231.27,
      "duration_seconds": 7.16,
      "text": "Your tummy is soft with mild tenderness low down and your blood pressure is normal."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.56,
      "end_seconds": 244.6,
      "duration_seconds": 1.04,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.56,
      "end_seconds": 260.07,
      "duration_seconds": 11.51,
      "text": "That's the examination finished. Okay, thinking it through, I think we're dealing with bleeding in early pregnancy that needs a scan at this stage."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.69,
      "end_seconds": 285.38,
      "duration_seconds": 10.69,
      "text": "I want a pregnancy hormone level done, that's for bleeding in early pregnancy. I'm sending you for an early pregnancy scan because of bleeding in early pregnancy."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 286.25,
      "end_seconds": 287.8,
      "duration_seconds": 1.55,
      "text": "Does it hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.7,
      "end_seconds": 307.66,
      "duration_seconds": 18.96,
      "text": "Use pads rather than tampons and avoid intercourse until the scan. Let's get you seen by the early pregnancy unit, I'll arrange the letter. Book a review after the scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.32,
      "end_seconds": 312.55,
      "duration_seconds": 3.23,
      "text": "No, that's all. Thanks a lot."
    }
  ]
}