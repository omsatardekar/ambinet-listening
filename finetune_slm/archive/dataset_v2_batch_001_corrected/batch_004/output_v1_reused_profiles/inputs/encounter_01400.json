{
  "schema_version": "1.0",
  "encounter_id": "01400",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.76,
      "end_seconds": 2.25,
      "duration_seconds": 1.49,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.25,
      "end_seconds": 8.1,
      "duration_seconds": 3.85,
      "text": "Yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.79,
      "end_seconds": 17.44,
      "duration_seconds": 7.65,
      "text": "Mainly spots on my face. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.98,
      "end_seconds": 21.93,
      "duration_seconds": 2.95,
      "text": "how long has this been bothering you?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 23.19,
      "end_seconds": 25.57,
      "duration_seconds": 2.38,
      "text": "it's been three weeks now"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.14,
      "end_seconds": 29.45,
      "duration_seconds": 3.31,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.22,
      "end_seconds": 33.04,
      "duration_seconds": 1.82,
      "text": "I'd call it mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.54,
      "end_seconds": 34.34,
      "duration_seconds": 0.8,
      "text": "mm-hmm"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.85,
      "end_seconds": 45.48,
      "duration_seconds": 9.63,
      "text": "And I've been feeling low as well. So, and there's extra hair on my chin as well, three weeks now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.33,
      "end_seconds": 54.25,
      "duration_seconds": 6.92,
      "text": "Let me check a a few things. Any hot flushes, pelvic pain, heavy bleeding or breast discharge?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 55.38,
      "end_seconds": 59.67,
      "duration_seconds": 4.29,
      "text": "No, um, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.66,
      "end_seconds": 65.51,
      "duration_seconds": 4.85,
      "text": "so, anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.48,
      "end_seconds": 72.39,
      "duration_seconds": 4.91,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.05,
      "end_seconds": 75.6,
      "duration_seconds": 1.55,
      "text": "Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.4,
      "end_seconds": 78.33,
      "duration_seconds": 1.93,
      "text": "no, that's all normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.93,
      "end_seconds": 83.07,
      "duration_seconds": 4.14,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.95,
      "end_seconds": 85.93,
      "duration_seconds": 1.98,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.52,
      "end_seconds": 90.63,
      "duration_seconds": 3.11,
      "text": "So, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.05,
      "end_seconds": 96.52,
      "duration_seconds": 4.47,
      "text": "Uh, um, no, I'm not on anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.53,
      "end_seconds": 102.39,
      "duration_seconds": 3.86,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.82,
      "end_seconds": 110.13,
      "duration_seconds": 3.31,
      "text": "ah, my daughter has type 1 diabetes"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.87,
      "end_seconds": 116.32,
      "duration_seconds": 5.45,
      "text": "Before we go further, any allergies? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.26,
      "end_seconds": 121.77,
      "duration_seconds": 3.51,
      "text": "Yes, tramadol. I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.62,
      "end_seconds": 127.29,
      "duration_seconds": 3.67,
      "text": "So, what operations have you had, if any?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.9,
      "end_seconds": 136.68,
      "duration_seconds": 5.78,
      "text": "Erm, yes, I had an operation for a hernia, last spring."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.27,
      "end_seconds": 155.56,
      "duration_seconds": 1.29,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.36,
      "end_seconds": 160.36,
      "duration_seconds": 4.0,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.36,
      "end_seconds": 165.18,
      "duration_seconds": 2.82,
      "text": "Right, is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.96,
      "end_seconds": 169.8,
      "duration_seconds": 3.84,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.55,
      "end_seconds": 185.63,
      "duration_seconds": 2.08,
      "text": "I'll do your observations first"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.33,
      "end_seconds": 199.98,
      "duration_seconds": 2.65,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.46,
      "end_seconds": 227.57,
      "duration_seconds": 8.11,
      "text": "okay: temperature 36.9, saturation 97 percent. And pulse is 71 beats a minute, pressure 115 over 76."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.9,
      "end_seconds": 230.26,
      "duration_seconds": 1.36,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.07,
      "end_seconds": 234.88,
      "duration_seconds": 3.81,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.66,
      "end_seconds": 242.2,
      "duration_seconds": 5.54,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.35,
      "end_seconds": 244.57,
      "duration_seconds": 1.22,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.11,
      "end_seconds": 261.09,
      "duration_seconds": 7.98,
      "text": "There is some acne on the face and extra hair on the chin, and your blood pressure is fine."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 261.99,
      "end_seconds": 263.06,
      "duration_seconds": 1.07,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.65,
      "end_seconds": 268.59,
      "duration_seconds": 1.94,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.63,
      "end_seconds": 290.87,
      "duration_seconds": 5.24,
      "text": "I'm sending you for hormone blood tests because of irregular periods."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 291.67,
      "end_seconds": 293.9,
      "duration_seconds": 2.23,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.85,
      "end_seconds": 331.74,
      "duration_seconds": 36.89,
      "text": "A thyroid test is what I'd like next, for weight gain i'd rather check than guess, and this is the quickest way to know more you'll be taking metformin, 500 milligrams, once a day with food, for three months that's for cycle regulation and weight regular exercise and a small weight loss can make cycles more regular please don't wait if you get very heavy bleeding or severe pelvic pain that's when to be seen urgently"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 332.88,
      "end_seconds": 339.25,
      "duration_seconds": 6.37,
      "text": "I'd like you back after the scan. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 340.92,
      "end_seconds": 343.79,
      "duration_seconds": 2.87,
      "text": "Great, thank you for your help."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.82,
      "end_seconds": 346.58,
      "duration_seconds": 1.76,
      "text": "have a good day"
    }
  ]
}