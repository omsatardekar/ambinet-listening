{
  "schema_version": "1.0",
  "encounter_id": "01276",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.62,
      "end_seconds": 2.86,
      "duration_seconds": 2.24,
      "text": "Good morning, grab a seat."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.95,
      "end_seconds": 9.85,
      "duration_seconds": 4.9,
      "text": "Morning, uh, doctor, sorry about the rush."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.76,
      "end_seconds": 14.22,
      "duration_seconds": 2.46,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.26,
      "end_seconds": 46.14,
      "duration_seconds": 30.88,
      "text": "Um, um, so... a pounding headache. That's why I came. As for high fever with shaking chills, I honestly can't say when that began. It might have been last month or the month before. Well, um, I've been feeling sick too, for about two weeks. As for feeling sick, I'd give it a three, out of ten."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.44,
      "end_seconds": 58.33,
      "duration_seconds": 2.89,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.27,
      "end_seconds": 68.9,
      "duration_seconds": 8.63,
      "text": "High cholesterol, for about a year. My neighbour said I should get it looked at."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.54,
      "end_seconds": 70.55,
      "duration_seconds": 1.01,
      "text": "Hm, okay."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.74,
      "end_seconds": 79.6,
      "duration_seconds": 4.86,
      "text": "Um, I have depression, for about ten years."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 80.97,
      "end_seconds": 82.3,
      "duration_seconds": 1.33,
      "text": "Any other things?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.26,
      "end_seconds": 89.97,
      "duration_seconds": 6.71,
      "text": "Okay, I can see depression in your file as well. Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.03,
      "end_seconds": 100.49,
      "duration_seconds": 9.46,
      "text": "Atorvastatin, 20 milligrams, at night for my cholesterol. I take escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.35,
      "end_seconds": 103.94,
      "duration_seconds": 2.59,
      "text": "How long have you taken that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 104.87,
      "end_seconds": 114.13,
      "duration_seconds": 9.26,
      "text": "About nearly five years. Okay, so I used to take sertraline, but I stopped it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 119.9,
      "duration_seconds": 3.94,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.52,
      "end_seconds": 123.12,
      "duration_seconds": 2.6,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.74,
      "end_seconds": 128.41,
      "duration_seconds": 4.67,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 130.07,
      "end_seconds": 132.35,
      "duration_seconds": 2.28,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 134.21,
      "end_seconds": 136.56,
      "duration_seconds": 2.35,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.97,
      "end_seconds": 157.19,
      "duration_seconds": 19.22,
      "text": "Oh, I had my septum straightened in my thirties. Work has been very busy so I kept ignoring it. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 161.62,
      "duration_seconds": 3.16,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 163.33,
      "end_seconds": 169.23,
      "duration_seconds": 5.9,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.8,
      "end_seconds": 173.2,
      "duration_seconds": 2.4,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.24,
      "end_seconds": 180.35,
      "duration_seconds": 4.11,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 180.95,
      "end_seconds": 184.83,
      "duration_seconds": 3.88,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 186.67,
      "end_seconds": 190.2,
      "duration_seconds": 3.53,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 191.03,
      "end_seconds": 194.75,
      "duration_seconds": 3.72,
      "text": "Have you noticed rash, neck stiffness or cough?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.84,
      "end_seconds": 198.51,
      "duration_seconds": 2.67,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.83,
      "end_seconds": 201.66,
      "duration_seconds": 1.83,
      "text": "Okay, any yellow eyes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 203.24,
      "end_seconds": 205.4,
      "duration_seconds": 2.16,
      "text": "No yellow eyes, thankfully."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.92,
      "end_seconds": 213.2,
      "duration_seconds": 3.28,
      "text": "Right, have you noticed confusion or diarrhoea?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 214.06,
      "end_seconds": 218.78,
      "duration_seconds": 4.72,
      "text": "Okay, uh, so no, nothing to report there."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 220.54,
      "end_seconds": 222.42,
      "duration_seconds": 1.88,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 224.0,
      "end_seconds": 226.69,
      "duration_seconds": 2.69,
      "text": "Actually, no problems with breathing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.48,
      "end_seconds": 231.75,
      "duration_seconds": 3.27,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.45,
      "end_seconds": 240.16,
      "duration_seconds": 4.71,
      "text": "Let me think, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.84,
      "end_seconds": 256.74,
      "duration_seconds": 2.9,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 266.04,
      "end_seconds": 268.76,
      "duration_seconds": 2.72,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 289.54,
      "end_seconds": 298.49,
      "duration_seconds": 8.95,
      "text": "Okay: pressure 120 over 75, heart rate 90. And temperature is 38.3 degrees, oxygen saturation is 96 percent."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 300.14,
      "end_seconds": 301.83,
      "duration_seconds": 1.69,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 302.41,
      "end_seconds": 304.79,
      "duration_seconds": 2.38,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 307.71,
      "end_seconds": 311.16,
      "duration_seconds": 3.45,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 325.79,
      "end_seconds": 326.49,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.92,
      "end_seconds": 329.37,
      "duration_seconds": 1.45,
      "text": "Look straight ahead."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.38,
      "end_seconds": 343.0,
      "duration_seconds": 4.62,
      "text": "The spleen tip is just palpable and the chest is clear."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 344.07,
      "end_seconds": 345.3,
      "duration_seconds": 1.23,
      "text": "Okay, doctor."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 347.66,
      "end_seconds": 365.72,
      "duration_seconds": 18.06,
      "text": "You can relax now. Taking everything into account, it fits best with a fever after travel that must be treated as possible malaria. I can't rule out typhoid fever yet. We should do blood tests for fever."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 367.43,
      "end_seconds": 372.89,
      "duration_seconds": 5.46,
      "text": "We have a slot Wednesday at 3:30 pm, if that works."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 373.56,
      "end_seconds": 383.02,
      "duration_seconds": 9.46,
      "text": "I want blood cultures done, that's for fever. Avoid anti-inflammatory painkillers and keep drinking. I'll also refer you to the tropical diseases unit."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.42,
      "end_seconds": 388.35,
      "duration_seconds": 3.93,
      "text": "Can you send me for a malaria test?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 390.34,
      "end_seconds": 400.22,
      "duration_seconds": 9.88,
      "text": "Not at this point, no. It isn't indicated yet. Let's review you in two days. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 405.24,
      "end_seconds": 407.57,
      "duration_seconds": 2.33,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 409.62,
      "end_seconds": 410.8,
      "duration_seconds": 1.18,
      "text": "Take care now."
    }
  ]
}