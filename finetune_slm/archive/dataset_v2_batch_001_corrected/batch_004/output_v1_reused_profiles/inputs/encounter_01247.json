{
  "schema_version": "1.0",
  "encounter_id": "01247",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.64,
      "end_seconds": 7.35,
      "duration_seconds": 6.71,
      "text": "Hi there, the chair's free, sit down. Okay, tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.23,
      "end_seconds": 12.39,
      "duration_seconds": 3.16,
      "text": "Well, I've been having a cough."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 14.46,
      "end_seconds": 21.22,
      "duration_seconds": 6.76,
      "text": "Did it it come on recently? These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.75,
      "end_seconds": 24.21,
      "duration_seconds": 2.46,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.53,
      "end_seconds": 28.83,
      "duration_seconds": 3.3,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 29.47,
      "end_seconds": 33.56,
      "duration_seconds": 4.09,
      "text": "A A four out of ten, I suppose."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.8,
      "end_seconds": 39.89,
      "duration_seconds": 3.09,
      "text": "have you been coughing up yellow phlegm?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 40.89,
      "end_seconds": 42.98,
      "duration_seconds": 2.09,
      "text": "Yeah, that that too."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 43.76,
      "end_seconds": 46.45,
      "duration_seconds": 2.69,
      "text": "have you had a tight chest?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.17,
      "end_seconds": 53.68,
      "duration_seconds": 6.51,
      "text": "Yeah, yes, since last Tuesday. About tight chest, I'd say moderate."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.5,
      "end_seconds": 66.25,
      "duration_seconds": 4.75,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.28,
      "end_seconds": 81.15,
      "duration_seconds": 12.87,
      "text": "I look after my grandchildren most days. Lots of rice, lentils and some fruit. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.05,
      "end_seconds": 85.0,
      "duration_seconds": 2.95,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.92,
      "end_seconds": 91.91,
      "duration_seconds": 4.99,
      "text": "I had keyhole surgery on my gallbladder two years back."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 106.78,
      "end_seconds": 108.98,
      "duration_seconds": 2.2,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 110.67,
      "end_seconds": 115.07,
      "duration_seconds": 4.4,
      "text": "Paracetamol. I take it 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 116.05,
      "end_seconds": 118.74,
      "duration_seconds": 2.69,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.35,
      "end_seconds": 122.11,
      "duration_seconds": 1.76,
      "text": "for two years"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 126.08,
      "end_seconds": 130.09,
      "duration_seconds": 4.01,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 131.01,
      "end_seconds": 133.02,
      "duration_seconds": 2.01,
      "text": "My son has asthma."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 135.08,
      "end_seconds": 139.91,
      "duration_seconds": 4.83,
      "text": "what conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.05,
      "end_seconds": 152.58,
      "duration_seconds": 11.53,
      "text": "sorry, what was I saying, I've had asthma for five years now. I've been putting this off for weeks"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 154.45,
      "end_seconds": 155.15,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 169.33,
      "end_seconds": 175.35,
      "duration_seconds": 6.02,
      "text": "Did you get coughing up blood, shortness of breath, leg swelling or weight loss?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 176.22,
      "end_seconds": 180.55,
      "duration_seconds": 4.33,
      "text": "Ah, you know, none of those, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.23,
      "end_seconds": 185.13,
      "duration_seconds": 2.9,
      "text": "alright, did you notice any night sweats?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 185.86,
      "end_seconds": 189.39,
      "duration_seconds": 3.53,
      "text": "no, uh, no night sweats"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.9,
      "end_seconds": 193.33,
      "duration_seconds": 2.43,
      "text": "Has your skin been okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.38,
      "end_seconds": 197.99,
      "duration_seconds": 2.61,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.62,
      "end_seconds": 201.79,
      "duration_seconds": 2.17,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.36,
      "end_seconds": 212.75,
      "duration_seconds": 2.39,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.11,
      "end_seconds": 235.33,
      "duration_seconds": 9.22,
      "text": "Okay: heart rate 92, BP is 117 over 72, saturation 97 percent, temperature is 38.6 degrees, respiratory rate 20."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.29,
      "end_seconds": 237.86,
      "duration_seconds": 1.57,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.34,
      "end_seconds": 242.59,
      "duration_seconds": 3.25,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.21,
      "end_seconds": 248.03,
      "duration_seconds": 3.82,
      "text": "let me look at the area, I'll be gentle"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 249.41,
      "end_seconds": 250.46,
      "duration_seconds": 1.05,
      "text": "that's alright"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.54,
      "end_seconds": 254.16,
      "duration_seconds": 2.62,
      "text": "So, raise your arm for me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 270.88,
      "end_seconds": 274.45,
      "duration_seconds": 3.57,
      "text": "There are a few scattered wheezes on both sides."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 275.4,
      "end_seconds": 277.88,
      "duration_seconds": 2.48,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 285.92,
      "end_seconds": 288.18,
      "duration_seconds": 2.26,
      "text": "No crackles at the bases"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.78,
      "end_seconds": 304.2,
      "duration_seconds": 13.42,
      "text": "Please sit back down. Okay, so my impression is this: It fits best with acute bronchitis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 305.87,
      "end_seconds": 310.4,
      "duration_seconds": 4.53,
      "text": "Hmm, do you think it's something serious?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 311.88,
      "end_seconds": 333.38,
      "duration_seconds": 21.5,
      "text": "Nothing I've seen today points to an emergency. It looks like acute bronchitis, but I'd like to confirm. I want blood tests done, that's for cough. I'd like you to take salbutamol inhaler, 100 micrograms, two puffs when needed, for one week. That should help with wheeze."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 333.88,
      "end_seconds": 336.11,
      "duration_seconds": 2.23,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 336.78,
      "end_seconds": 343.59,
      "duration_seconds": 6.81,
      "text": "Steam and warm fluids can ease the cough, and try to sleep with your head propped up."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 345.21,
      "end_seconds": 352.14,
      "duration_seconds": 6.93,
      "text": "Right, um, could I get a chest X-ray done? A friend had it."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 353.12,
      "end_seconds": 365.88,
      "duration_seconds": 12.76,
      "text": "Not right now, it wouldn't change what we do today. I'd like you back in a week. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 367.73,
      "end_seconds": 371.81,
      "duration_seconds": 4.08,
      "text": "Actually, good, thanks, I'll see you then."
    }
  ]
}