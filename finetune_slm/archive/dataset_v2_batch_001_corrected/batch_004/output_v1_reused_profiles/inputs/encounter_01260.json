  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 2.05,
      "duration_seconds": 1.36,
      "text": "good afternoon doctor"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.44,
      "end_seconds": 10.95,
      "duration_seconds": 4.51,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.48,
      "end_seconds": 18.72,
      "duration_seconds": 6.24,
      "text": "doctor, um, I've come along because I know the history, if it helps"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.4,
      "end_seconds": 24.3,
      "duration_seconds": 4.9,
      "text": "that's fine, sit down we'll go through it it together"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 25.88,
      "end_seconds": 31.87,
      "duration_seconds": 5.99,
      "text": "It's, It's shaky spells, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.19,
      "end_seconds": 34.89,
      "duration_seconds": 1.7,
      "text": "when did this begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 35.93,
      "end_seconds": 38.74,
      "duration_seconds": 2.81,
      "text": "probably about four days yeah"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.57,
      "end_seconds": 48.36,
      "duration_seconds": 8.79,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.63,
      "end_seconds": 73.92,
      "duration_seconds": 24.29,
      "text": "it It settles a little with eating something sweet. Missing meals definitely sets it off right I've also had a pounding heart with it about pounding heart with it it feels mild to me um I had a headache afterwards before that's settled now though"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.72,
      "end_seconds": 81.82,
      "duration_seconds": 6.1,
      "text": "Let me check a few things. Any seizure, chest pain or losing consciousness?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 83.44,
      "end_seconds": 88.47,
      "duration_seconds": 5.03,
      "text": "no seizure chest pain or losing consciousness none of it"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.28,
      "end_seconds": 92.74,
      "duration_seconds": 2.46,
      "text": "have you had any confusion?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 93.78,
      "end_seconds": 97.67,
      "duration_seconds": 3.89,
      "text": "Yeah, uh, no, none, no confusion."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.36,
      "end_seconds": 103.84,
      "duration_seconds": 2.48,
      "text": "any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.44,
      "end_seconds": 105.34,
      "duration_seconds": 0.9,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.18,
      "end_seconds": 109.46,
      "duration_seconds": 2.28,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.7,
      "end_seconds": 112.36,
      "duration_seconds": 1.66,
      "text": "nothing unusual no"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.31,
      "end_seconds": 129.06,
      "duration_seconds": 3.75,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.17,
      "end_seconds": 137.57,
      "duration_seconds": 7.4,
      "text": "Hmm, you know, my father had bowel cancer. My daughter has type 1 diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.75,
      "end_seconds": 154.1,
      "duration_seconds": 3.35,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.29,
      "end_seconds": 160.5,
      "duration_seconds": 5.21,
      "text": "Glimepiride. I take it 2 milligrams, before breakfast for my sugar"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 161.66,
      "end_seconds": 168.58,
      "duration_seconds": 6.92,
      "text": "He is supposed to take it before breakfast, but I can't say he always does."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.35,
      "end_seconds": 173.91,
      "duration_seconds": 4.56,
      "text": "Before this I was on metformin; that's been stopped."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.52,
      "end_seconds": 178.53,
      "duration_seconds": 3.01,
      "text": "did you ever have any procedures done?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.48,
      "end_seconds": 186.13,
      "duration_seconds": 5.65,
      "text": "Yes, um, I had a varicose vein procedure, last year."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.94,
      "end_seconds": 205.99,
      "duration_seconds": 4.05,
      "text": "alright, what do you do during the day?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.68,
      "end_seconds": 211.26,
      "duration_seconds": 3.58,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.03,
      "end_seconds": 214.21,
      "duration_seconds": 2.18,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.58,
      "end_seconds": 224.81,
      "duration_seconds": 5.23,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.43,
      "end_seconds": 228.0,
      "duration_seconds": 2.57,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 231.96,
      "end_seconds": 241.3,
      "duration_seconds": 9.34,
      "text": "I have diabetes, for five years. I'd rather not end up on lots of tablets if I can avoid it."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.11,
      "end_seconds": 251.07,
      "duration_seconds": 7.96,
      "text": "okay, I can see diabetes in your file as well let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 251.68,
      "end_seconds": 256.08,
      "duration_seconds": 4.4,
      "text": "Tramadol. I come out in... well, feeling very drowsy."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.07,
      "end_seconds": 261.88,
      "duration_seconds": 4.81,
      "text": "can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 274.49,
      "end_seconds": 277.0,
      "duration_seconds": 2.51,
      "text": "that's it, just a little longer.."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.06,
      "end_seconds": 300.32,
      "duration_seconds": 14.26,
      "text": "okay: BMI works out to 17.9, height 183 centimetres, BP is 113 over 76, weight 60 kilos, pulse is 64 beats a minute, SpO2 97 percent on room air, temp 36.7 degrees"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.11,
      "end_seconds": 306.51,
      "duration_seconds": 3.4,
      "text": "Right let's have a proper look at you."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 307.98,
      "end_seconds": 310.94,
      "duration_seconds": 2.96,
      "text": "take a deep breath for me"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.8,
      "end_seconds": 322.32,
      "duration_seconds": 3.52,
      "text": "Pulse is normal and there's no tremor right now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.65,
      "end_seconds": 346.81,
      "duration_seconds": 20.16,
      "text": "That's all I needed to check. So based on the history and the examination the most likely explanation is low sugar episodes related to diabetes medication. A meal-timing issue is also on my list. I want a blood sugar test done that's for hypoglycaemia."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 347.68,
      "end_seconds": 350.12,
      "duration_seconds": 2.44,
      "text": "when would that take place?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.53,
      "end_seconds": 377.19,
      "duration_seconds": 25.66,
      "text": "I want an HbA1c done, that's for diabetes control. Always keep glucose tablets or a sweet in your bag, and don't skip meals if you've taken your sugar tablet. Do get help quickly if you black out or can't wake up properly after an episode. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.96,
      "end_seconds": 382.29,
      "duration_seconds": 4.33,
      "text": "no, uh, that's all thanks a lot"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 386.02,
      "end_seconds": 387.28,
      "duration_seconds": 1.26,
      "text": "See you soon."
    }
  ]
}