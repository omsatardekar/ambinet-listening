{
  "schema_version": "1.0",
  "encounter_id": "01337",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.34,
      "end_seconds": 6.54,
      "duration_seconds": 5.2,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.28,
      "end_seconds": 12.03,
      "duration_seconds": 3.75,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.09,
      "end_seconds": 24.66,
      "duration_seconds": 10.57,
      "text": "Yeah, it's my heart racing. I don't know what's causing it. I didn't want to bother you but it keeps coming back."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.57,
      "end_seconds": 31.97,
      "duration_seconds": 3.4,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.98,
      "end_seconds": 34.89,
      "duration_seconds": 1.91,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.55,
      "end_seconds": 40.42,
      "duration_seconds": 4.87,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.21,
      "end_seconds": 56.38,
      "duration_seconds": 15.17,
      "text": "I'd say severe. Honestly, a couple of times a week. Oh, you know, and shaky hands. Had that since Friday. Oh, about shaky hands, I'd say every other day."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 73.66,
      "end_seconds": 76.26,
      "duration_seconds": 2.6,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.59,
      "end_seconds": 89.86,
      "duration_seconds": 2.27,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.63,
      "end_seconds": 111.57,
      "duration_seconds": 9.94,
      "text": "Okay: temperature is 37.0 degrees, pulse 111, blood pressure 120 over 70. And SpO2 96 percent on room air."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.9,
      "end_seconds": 116.93,
      "duration_seconds": 3.03,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.67,
      "end_seconds": 121.44,
      "duration_seconds": 2.77,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.94,
      "end_seconds": 141.35,
      "duration_seconds": 7.41,
      "text": "There's a fine tremor in the outstretched hands, and your palms are warm and moist."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.11,
      "end_seconds": 145.88,
      "duration_seconds": 2.77,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.32,
      "end_seconds": 157.12,
      "duration_seconds": 3.8,
      "text": "Your thyroid feels a little enlarged and smooth."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.81,
      "end_seconds": 164.28,
      "duration_seconds": 2.47,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.64,
      "end_seconds": 176.07,
      "duration_seconds": 2.43,
      "text": "Any sign of shortness of breath?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 180.35,
      "end_seconds": 182.63,
      "duration_seconds": 2.28,
      "text": "No. No shortness of breath."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.63,
      "end_seconds": 191.26,
      "duration_seconds": 6.63,
      "text": "Let me check a few things. Any chest pain, lump in the neck or eye bulging?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.67,
      "end_seconds": 198.98,
      "duration_seconds": 3.31,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.93,
      "end_seconds": 203.99,
      "duration_seconds": 3.06,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.94,
      "end_seconds": 209.78,
      "duration_seconds": 3.84,
      "text": "Um, uh, I move fine otherwise."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.73,
      "end_seconds": 224.49,
      "duration_seconds": 6.76,
      "text": "Tell me about any past illnesses or ongoing conditions. These questions might sound routine, but they matter."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.28,
      "end_seconds": 230.28,
      "duration_seconds": 5.0,
      "text": "I've had arthritis in my knees for five years now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.61,
      "end_seconds": 239.02,
      "duration_seconds": 7.41,
      "text": "Mm, okay. Okay, I can see arthritis in your knees in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.24,
      "end_seconds": 259.37,
      "duration_seconds": 3.13,
      "text": "Right, before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.0,
      "end_seconds": 266.92,
      "duration_seconds": 3.92,
      "text": "Yes, kiwi, it gives me an itchy mouth."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.72,
      "end_seconds": 272.1,
      "duration_seconds": 3.38,
      "text": "So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 273.4,
      "end_seconds": 276.32,
      "duration_seconds": 2.92,
      "text": "Paracetamol, 650 milligrams, when needed."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.98,
      "end_seconds": 280.56,
      "duration_seconds": 2.58,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.98,
      "end_seconds": 297.06,
      "duration_seconds": 15.08,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I grab fast food at lunch most days. I retired from the post office two years ago."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.3,
      "end_seconds": 310.08,
      "duration_seconds": 11.78,
      "text": "From what you've told me and what I found, I think we're dealing with an overactive thyroid at this stage. We should do a thyroid scan for hyperthyroidism."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 311.33,
      "end_seconds": 314.29,
      "duration_seconds": 2.96,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 315.39,
      "end_seconds": 319.47,
      "duration_seconds": 4.08,
      "text": "We should do a thyroid test for hyperthyroid symptoms."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.32,
      "end_seconds": 322.69,
      "duration_seconds": 2.37,
      "text": "How long will it take?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 323.51,
      "end_seconds": 344.12,
      "duration_seconds": 20.61,
      "text": "I'd like you to take propranolol, 20 milligrams, twice a day, until we review. You take it by mouth. That should help with palpitations and tremor. Limit tea, coffee and anything that speeds up the heart for now. Do get help quickly if the symptoms get worse."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.91,
      "end_seconds": 348.02,
      "duration_seconds": 3.11,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.83,
      "end_seconds": 356.14,
      "duration_seconds": 7.31,
      "text": "I'll want another look in two weeks. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.14,
      "end_seconds": 359.27,
      "duration_seconds": 2.13,
      "text": "Thank you, that's helpful."
    }
  ]
}