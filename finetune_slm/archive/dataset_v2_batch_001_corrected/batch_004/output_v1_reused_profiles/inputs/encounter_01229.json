{
  "schema_version": "1.0",
  "encounter_id": "01229",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 0.84,
      "end_seconds": 5.12,
      "duration_seconds": 4.28,
      "text": "Doctor, we're ready in room two, I've already taken the observations."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.82,
      "end_seconds": 12.26,
      "duration_seconds": 5.44,
      "text": "Okay, thanks. Hello, come in, sit down. What brings you in today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.05,
      "end_seconds": 21.69,
      "duration_seconds": 8.64,
      "text": "Yeah, it's a sore on the bottom of my foot. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.32,
      "end_seconds": 26.71,
      "duration_seconds": 3.39,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 28.19,
      "end_seconds": 34.56,
      "duration_seconds": 6.37,
      "text": "Sorry, what was I saying, it's been going on for two days."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.79,
      "end_seconds": 40.79,
      "duration_seconds": 6.0,
      "text": "Sure. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 41.62,
      "end_seconds": 47.81,
      "duration_seconds": 6.19,
      "text": "Erm, pretty severe, if I'm being honest. Yes, walking. That makes it worse."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 48.53,
      "end_seconds": 52.22,
      "duration_seconds": 3.69,
      "text": "Has there been a smell from the dressing too?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 53.96,
      "end_seconds": 59.64,
      "duration_seconds": 5.68,
      "text": "Sorry, what was I saying, yes, about the same, three days."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.81,
      "end_seconds": 64.15,
      "duration_seconds": 3.34,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.14,
      "end_seconds": 68.94,
      "duration_seconds": 3.8,
      "text": "I have diabetes, for nearly five years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.8,
      "end_seconds": 71.2,
      "duration_seconds": 1.4,
      "text": "Do you smoke?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 72.69,
      "end_seconds": 77.15,
      "duration_seconds": 4.46,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.19,
      "end_seconds": 85.04,
      "duration_seconds": 1.85,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 86.35,
      "end_seconds": 88.06,
      "duration_seconds": 1.71,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.39,
      "end_seconds": 91.4,
      "duration_seconds": 2.01,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 92.31,
      "end_seconds": 97.44,
      "duration_seconds": 5.13,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.13,
      "end_seconds": 101.55,
      "duration_seconds": 2.42,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 103.5,
      "end_seconds": 106.71,
      "duration_seconds": 3.21,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.59,
      "end_seconds": 110.78,
      "duration_seconds": 2.19,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 112.29,
      "end_seconds": 116.18,
      "duration_seconds": 3.89,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.75,
      "end_seconds": 126.89,
      "duration_seconds": 2.14,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 127.67,
      "end_seconds": 129.32,
      "duration_seconds": 1.65,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.67,
      "end_seconds": 133.05,
      "duration_seconds": 2.38,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 135.1,
      "end_seconds": 137.2,
      "duration_seconds": 2.1,
      "text": "No, you know, never."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.54,
      "end_seconds": 155.1,
      "duration_seconds": 2.56,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 156.81,
      "end_seconds": 158.34,
      "duration_seconds": 1.53,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.12,
      "end_seconds": 169.42,
      "duration_seconds": 3.3,
      "text": "Right, any confusion, black toes or vomiting?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 171.29,
      "end_seconds": 173.65,
      "duration_seconds": 2.36,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.09,
      "end_seconds": 177.03,
      "duration_seconds": 1.94,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 177.87,
      "end_seconds": 179.69,
      "duration_seconds": 1.82,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 184.18,
      "end_seconds": 199.86,
      "duration_seconds": 15.68,
      "text": "Okay, so the vitals from earlier. Heart rate 93, height 181 centimetres, BMI works out to 26.6. Weight 87 kilos, SpO2 98 percent on room air, BP is 124 over 76, temp 38.8 degrees."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.89,
      "end_seconds": 202.41,
      "duration_seconds": 1.52,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.05,
      "end_seconds": 207.98,
      "duration_seconds": 3.93,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.48,
      "end_seconds": 210.76,
      "duration_seconds": 1.28,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.63,
      "end_seconds": 234.54,
      "duration_seconds": 4.91,
      "text": "The pulses at the ankle are weak but I can feel them."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.21,
      "end_seconds": 242.29,
      "duration_seconds": 2.08,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.14,
      "end_seconds": 289.56,
      "duration_seconds": 29.42,
      "text": "From what you've told me and what I found, I think we're dealing with an infected diabetic foot ulcer at this stage. I'm sending you for blood tests because of infection. What I'm giving you is amoxicillin/clavulanic acid, 625 milligrams, three times a day, for seven days. That should help with foot infection. Keep the weight off that foot and keep the dressing dry."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.56,
      "end_seconds": 296.54,
      "duration_seconds": 5.98,
      "text": "I'd like you to see the foot clinic as well, and I'll write the referral."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 298.28,
      "end_seconds": 300.76,
      "duration_seconds": 2.48,
      "text": "Sure, where do I go?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.06,
      "end_seconds": 304.79,
      "duration_seconds": 2.73,
      "text": "We'll catch up in three days."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 306.32,
      "end_seconds": 309.93,
      "duration_seconds": 3.61,
      "text": "Alright, you know, I'll be back."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.64,
      "end_seconds": 314.65,
      "duration_seconds": 4.01,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 315.8,
      "end_seconds": 317.96,
      "duration_seconds": 2.16,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.47,
      "end_seconds": 319.69,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
