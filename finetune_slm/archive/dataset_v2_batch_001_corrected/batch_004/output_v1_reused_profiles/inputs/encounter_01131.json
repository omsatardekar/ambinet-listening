{
  "schema_version": "1.0",
  "encounter_id": "01131",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.58,
      "duration_seconds": 4.77,
      "text": "Erm, hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.79,
      "end_seconds": 10.44,
      "duration_seconds": 3.65,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.76,
      "end_seconds": 15.86,
      "duration_seconds": 4.1,
      "text": "Thank you for fitting us in, um, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.95,
      "end_seconds": 20.89,
      "duration_seconds": 2.94,
      "text": "Please do. Extra information is always welcome."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 23.92,
      "end_seconds": 28.19,
      "duration_seconds": 4.27,
      "text": "We came because of pins and needles in the legs."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.01,
      "end_seconds": 32.38,
      "duration_seconds": 3.37,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.29,
      "end_seconds": 36.67,
      "duration_seconds": 2.38,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 38.58,
      "end_seconds": 42.22,
      "duration_seconds": 3.64,
      "text": "It was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.88,
      "end_seconds": 48.29,
      "duration_seconds": 4.41,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.84,
      "end_seconds": 52.0,
      "duration_seconds": 2.16,
      "text": "I suppose so, yes."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.21,
      "end_seconds": 55.56,
      "duration_seconds": 2.35,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.22,
      "end_seconds": 61.88,
      "duration_seconds": 5.66,
      "text": "Numbness in the toes goes along with it, most of the time."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.13,
      "end_seconds": 80.55,
      "duration_seconds": 4.42,
      "text": "Alright, any weakness in the legs or fever at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.27,
      "end_seconds": 85.6,
      "duration_seconds": 3.33,
      "text": "Ah, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.19,
      "end_seconds": 90.73,
      "duration_seconds": 3.54,
      "text": "Any hand symptoms or back pain at all?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.74,
      "end_seconds": 97.82,
      "duration_seconds": 5.08,
      "text": "No hand symptoms or back pain, none of it."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.35,
      "end_seconds": 102.91,
      "duration_seconds": 4.56,
      "text": "I see, go ahead. Right, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.31,
      "end_seconds": 106.21,
      "duration_seconds": 1.9,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.96,
      "end_seconds": 109.72,
      "duration_seconds": 2.76,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 110.61,
      "end_seconds": 114.78,
      "duration_seconds": 4.17,
      "text": "No, um, I'm not allergic to anything."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.08,
      "end_seconds": 118.28,
      "duration_seconds": 2.2,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.21,
      "end_seconds": 129.1,
      "duration_seconds": 6.89,
      "text": "I take Glycomet, 500 milligrams, twice a day. It's paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.57,
      "end_seconds": 137.62,
      "duration_seconds": 3.05,
      "text": "How long has that been going on?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.52,
      "end_seconds": 141.39,
      "duration_seconds": 1.87,
      "text": "About a month now."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.69,
      "end_seconds": 145.48,
      "duration_seconds": 2.79,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.47,
      "end_seconds": 151.32,
      "duration_seconds": 3.85,
      "text": "Actually, nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.15,
      "end_seconds": 156.58,
      "duration_seconds": 3.43,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.6,
      "end_seconds": 169.19,
      "duration_seconds": 11.59,
      "text": "I have about eight cigarettes in a day. I'm vegetarian and have been for years. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.91,
      "end_seconds": 172.37,
      "duration_seconds": 2.46,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.08,
      "end_seconds": 175.27,
      "duration_seconds": 1.19,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.92,
      "end_seconds": 185.15,
      "duration_seconds": 9.23,
      "text": "Yes, diabetes is known to us, good to have that clear. Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.28,
      "end_seconds": 192.06,
      "duration_seconds": 2.78,
      "text": "Uh, my son has asthma."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 200.38,
      "end_seconds": 203.18,
      "duration_seconds": 2.8,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.91,
      "end_seconds": 217.45,
      "duration_seconds": 2.54,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 238.64,
      "end_seconds": 245.36,
      "duration_seconds": 6.72,
      "text": "Okay: pressure 120 over 81, temperature is 36.9 degrees, heart rate 79, saturation 99 percent."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 245.87,
      "end_seconds": 247.4,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.05,
      "end_seconds": 250.52,
      "duration_seconds": 2.47,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.55,
      "end_seconds": 255.91,
      "duration_seconds": 4.36,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 267.82,
      "end_seconds": 268.86,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 269.85,
      "end_seconds": 271.03,
      "duration_seconds": 1.18,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.25,
      "end_seconds": 288.05,
      "duration_seconds": 1.8,
      "text": "Ankle reflexes are absent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.08,
      "end_seconds": 315.68,
      "duration_seconds": 22.6,
      "text": "Alright, thank you, you can get dressed. From what you've told me and what I found, the most likely explanation is peripheral neuropathy, possibly related to sugar. A vitamin B12 deficiency is still possible. Alright, I don't need to add any tests or treatment at this point. Alright, I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.73,
      "end_seconds": 320.91,
      "duration_seconds": 3.18,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.64,
      "end_seconds": 324.1,
      "duration_seconds": 1.46,
      "text": "Look after yourself."
    }
  ]
}