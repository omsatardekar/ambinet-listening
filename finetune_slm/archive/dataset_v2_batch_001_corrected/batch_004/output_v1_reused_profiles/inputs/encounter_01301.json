{
  "schema_version": "1.0",
  "encounter_id": "01301",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.74,
      "end_seconds": 3.75,
      "duration_seconds": 3.01,
      "text": "Hi there, the chair's free, sit down."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.6,
      "end_seconds": 6.73,
      "duration_seconds": 1.13,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.28,
      "end_seconds": 9.54,
      "duration_seconds": 1.26,
      "text": "What's the problem?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.32,
      "end_seconds": 18.24,
      "duration_seconds": 7.92,
      "text": "Yeah, it's stiffness in the hip after sitting. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 19.23,
      "end_seconds": 21.97,
      "duration_seconds": 2.74,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.14,
      "end_seconds": 39.79,
      "duration_seconds": 16.65,
      "text": "I'd say about three months. Actually, no, closer to six months. I've been reading about it online and it worried me. A neighbour of mine said I should see someone about it."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 41.09,
      "end_seconds": 43.87,
      "duration_seconds": 2.78,
      "text": "How much does it limit you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 44.62,
      "end_seconds": 50.14,
      "duration_seconds": 5.52,
      "text": "Ah, maybe a four out of ten on a bad day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 51.03,
      "end_seconds": 53.48,
      "duration_seconds": 2.45,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 54.38,
      "end_seconds": 57.42,
      "duration_seconds": 3.04,
      "text": "It happens every other day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 59.08,
      "end_seconds": 61.59,
      "duration_seconds": 2.51,
      "text": "What eases it, if anything?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.62,
      "end_seconds": 67.52,
      "duration_seconds": 3.9,
      "text": "It settles a little with moving around."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.1,
      "end_seconds": 72.42,
      "duration_seconds": 3.32,
      "text": "Have you had pain in your right groin?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 76.28,
      "end_seconds": 78.9,
      "duration_seconds": 2.62,
      "text": "Yes, um, I have."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 79.83,
      "end_seconds": 85.39,
      "duration_seconds": 5.56,
      "text": "Let me check a few things. Any back pain or swelling of the leg?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 86.59,
      "end_seconds": 91.16,
      "duration_seconds": 4.57,
      "text": "No, no back pain or swelling of the leg."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.98,
      "end_seconds": 96.8,
      "duration_seconds": 3.82,
      "text": "Any fall or numbness in the leg at all?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 98.34,
      "end_seconds": 101.57,
      "duration_seconds": 3.23,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.47,
      "end_seconds": 105.87,
      "duration_seconds": 3.4,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.86,
      "end_seconds": 113.97,
      "duration_seconds": 6.11,
      "text": "My heart's been fine, uh, as far as I know."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 114.53,
      "end_seconds": 117.47,
      "duration_seconds": 2.94,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.28,
      "end_seconds": 123.07,
      "duration_seconds": 4.79,
      "text": "Oh, uh, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.15,
      "end_seconds": 127.23,
      "duration_seconds": 3.08,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.29,
      "end_seconds": 133.72,
      "duration_seconds": 4.43,
      "text": "Yeah, just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.82,
      "end_seconds": 150.22,
      "duration_seconds": 2.4,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.64,
      "end_seconds": 160.65,
      "duration_seconds": 9.01,
      "text": "Oh, it's valsartan, 80 milligrams, once a day. Diclofenac, 50 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 161.78,
      "end_seconds": 166.33,
      "duration_seconds": 4.55,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 166.91,
      "end_seconds": 171.84,
      "duration_seconds": 4.93,
      "text": "Not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 189.05,
      "end_seconds": 193.36,
      "duration_seconds": 4.31,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 195.11,
      "end_seconds": 197.28,
      "duration_seconds": 2.17,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.23,
      "end_seconds": 200.0,
      "duration_seconds": 1.77,
      "text": "Is there anything more?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.88,
      "end_seconds": 207.41,
      "duration_seconds": 6.53,
      "text": "Okay, so I've had arthritis in my knees for two years now."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.35,
      "end_seconds": 219.54,
      "duration_seconds": 10.19,
      "text": "Okay, I can see arthritis in your knees in your file as well. Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.38,
      "end_seconds": 237.11,
      "duration_seconds": 16.73,
      "text": "I gave up cigarettes last spring. I'll have a glass of wine with dinner. I do a yoga class on Thursdays. I'm vegetarian and have been for years. My partner and our baby."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.05,
      "end_seconds": 242.99,
      "duration_seconds": 3.94,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 246.62,
      "end_seconds": 249.73,
      "duration_seconds": 3.11,
      "text": "Yes, cat fur. I get wheezing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 253.62,
      "end_seconds": 256.62,
      "duration_seconds": 3.0,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.82,
      "end_seconds": 266.99,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.68,
      "end_seconds": 287.31,
      "duration_seconds": 8.63,
      "text": "Okay: temp 36.7 degrees, oxygen saturation is 97 percent, blood pressure 126 over 70, heart rate 83."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 288.31,
      "end_seconds": 289.97,
      "duration_seconds": 1.66,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.89,
      "end_seconds": 294.61,
      "duration_seconds": 3.72,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 296.68,
      "end_seconds": 301.08,
      "duration_seconds": 4.4,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 312.51,
      "end_seconds": 313.55,
      "duration_seconds": 1.04,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.5,
      "end_seconds": 317.41,
      "duration_seconds": 2.91,
      "text": "Okay, raise your arm for me."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 334.86,
      "end_seconds": 341.1,
      "duration_seconds": 6.24,
      "text": "Rotation of the right hip is painful and limited compared with the left."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.12,
      "end_seconds": 344.12,
      "duration_seconds": 1.0,
      "text": "That's alright."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 346.24,
      "end_seconds": 381.39,
      "duration_seconds": 35.15,
      "text": "That's the examination finished. So where does that leave us? My working impression is osteoarthritis of the right hip. Bursitis is also on my list. I'm prescribing paracetamol, 1 gram, up to four times a day, long term. You take it by mouth. That's for hip pain. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Let's plan a check in six weeks."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 381.93,
      "end_seconds": 382.63,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 387.5,
      "end_seconds": 391.44,
      "duration_seconds": 3.94,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 392.01,
      "end_seconds": 396.49,
      "duration_seconds": 4.48,
      "text": "Uh, I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.09,
      "end_seconds": 401.55,
      "duration_seconds": 1.46,
      "text": "Take care now."
    }
  ]
}