{
  "schema_version": "1.0",
  "encounter_id": "01029",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.62,
      "end_seconds": 4.15,
      "duration_seconds": 3.53,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.02,
      "end_seconds": 9.04,
      "duration_seconds": 4.02,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.62,
      "end_seconds": 14.79,
      "duration_seconds": 4.17,
      "text": "I've been dealing with a ring-shaped itchy patch."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.86,
      "end_seconds": 18.77,
      "duration_seconds": 2.91,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 20.22,
      "end_seconds": 22.95,
      "duration_seconds": 2.73,
      "text": "I've had it since this morning."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.2,
      "end_seconds": 32.58,
      "duration_seconds": 9.38,
      "text": "Ah. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.38,
      "end_seconds": 38.57,
      "duration_seconds": 4.19,
      "text": "Yes, sweating. That makes it worse. Severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.36,
      "end_seconds": 43.71,
      "duration_seconds": 4.35,
      "text": "What about itching between the toes, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.24,
      "end_seconds": 60.82,
      "duration_seconds": 15.58,
      "text": "Yes, for about two weeks. With itching between the toes, it's every other day. I did have darker skin around the patch at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.5,
      "end_seconds": 68.47,
      "duration_seconds": 5.97,
      "text": "Have you had a ring-shaped itchy patch before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.85,
      "end_seconds": 75.66,
      "duration_seconds": 5.81,
      "text": "I had a similar thing a couple of years ago. It went away."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.71,
      "end_seconds": 93.95,
      "duration_seconds": 2.24,
      "text": "And pus, any of that?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.49,
      "end_seconds": 96.09,
      "duration_seconds": 1.6,
      "text": "Definitely no pus."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.85,
      "end_seconds": 103.49,
      "duration_seconds": 6.64,
      "text": "Have you noticed new partner, similar rash on the scalp, fever or rash on the palms?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.09,
      "end_seconds": 111.71,
      "duration_seconds": 7.62,
      "text": "No, no new partner, similar rash on the scalp, fever or rash on the palms."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.13,
      "end_seconds": 118.58,
      "duration_seconds": 5.45,
      "text": "Have you noticed any weakness, or anything odd with your balance?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.66,
      "end_seconds": 121.63,
      "duration_seconds": 1.97,
      "text": "No, that's all normal."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.39,
      "end_seconds": 125.85,
      "duration_seconds": 2.46,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.89,
      "end_seconds": 128.8,
      "duration_seconds": 1.91,
      "text": "No, that's all fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.72,
      "end_seconds": 135.25,
      "duration_seconds": 4.53,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 136.98,
      "end_seconds": 146.97,
      "duration_seconds": 9.99,
      "text": "It's gliclazide, 80 milligrams, twice a day. I take metoprolol, 50 milligrams, twice a day for my heart."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 152.69,
      "duration_seconds": 4.5,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.52,
      "end_seconds": 157.08,
      "duration_seconds": 2.56,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.58,
      "end_seconds": 174.58,
      "duration_seconds": 2.0,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.56,
      "end_seconds": 181.89,
      "duration_seconds": 6.33,
      "text": "I've had diabetes for five years now. I've, I've had heart disease, yes."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.72,
      "end_seconds": 191.22,
      "duration_seconds": 7.5,
      "text": "Okay, I can see heart disease in your file as well. Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.15,
      "end_seconds": 194.72,
      "duration_seconds": 1.57,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 196.31,
      "end_seconds": 197.7,
      "duration_seconds": 1.39,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.3,
      "end_seconds": 202.09,
      "duration_seconds": 3.79,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.52,
      "end_seconds": 206.16,
      "duration_seconds": 2.64,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.33,
      "end_seconds": 211.91,
      "duration_seconds": 4.58,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.43,
      "end_seconds": 215.82,
      "duration_seconds": 2.39,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.75,
      "end_seconds": 224.42,
      "duration_seconds": 3.67,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.84,
      "end_seconds": 228.39,
      "duration_seconds": 2.55,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.59,
      "end_seconds": 243.76,
      "duration_seconds": 2.17,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.31,
      "end_seconds": 263.22,
      "duration_seconds": 9.91,
      "text": "Okay: pressure 120 over 73, heart rate 65, respiratory rate 15. And temperature is 37.0 degrees, saturation 99 percent."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 263.93,
      "end_seconds": 265.27,
      "duration_seconds": 1.34,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.31,
      "end_seconds": 269.97,
      "duration_seconds": 2.66,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.77,
      "end_seconds": 274.41,
      "duration_seconds": 2.64,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 275.38,
      "end_seconds": 277.03,
      "duration_seconds": 1.65,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.84,
      "end_seconds": 280.28,
      "duration_seconds": 2.44,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.24,
      "end_seconds": 301.71,
      "duration_seconds": 3.47,
      "text": "Skin between the toes is white and peeling."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.74,
      "end_seconds": 305.75,
      "duration_seconds": 3.01,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.48,
      "end_seconds": 325.69,
      "duration_seconds": 6.21,
      "text": "There's a red ring-shaped scaly patch with a clearer centre in the groin crease."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.4,
      "end_seconds": 330.54,
      "duration_seconds": 2.14,
      "text": "You can sit up now."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 348.0,
      "end_seconds": 358.33,
      "duration_seconds": 10.33,
      "text": "Okay, thinking it through, my working impression is a fungal skin infection. It could also be psoriasis, so we'll keep that open."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 359.79,
      "end_seconds": 362.77,
      "duration_seconds": 2.98,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 364.47,
      "end_seconds": 395.67,
      "duration_seconds": 31.2,
      "text": "It's reasonable to be concerned, but right now a fungal skin infection is my leading thought, not anything worse. I'd like to arrange a skin scraping for suspected fungal infection. I'll start you on fluconazole, 150 milligrams, once a week, for two weeks. That's for fungal infection. Keep the area dry, wear loose cotton, and don't share towels. I'd like to see you again in two weeks. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 397.38,
      "end_seconds": 401.11,
      "duration_seconds": 3.73,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 402.76,
      "end_seconds": 404.6,
      "duration_seconds": 1.84,
      "text": "Have a good day."
    }
  ]
}