{
  "schema_version": "1.0",
  "encounter_id": "01273",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 5.73,
      "duration_seconds": 4.8,
      "text": "doctor? Hello, I hope this is the right time"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.12,
      "end_seconds": 11.34,
      "duration_seconds": 4.22,
      "text": "okay, that's fine, sit down tell me why you came"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 15.68,
      "end_seconds": 21.9,
      "duration_seconds": 6.22,
      "text": "Hello, doctor. I hope it's alright if I stay in for this."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.5,
      "end_seconds": 24.98,
      "duration_seconds": 2.48,
      "text": "Absolutely, come and sit beside them."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.95,
      "end_seconds": 33.36,
      "duration_seconds": 6.41,
      "text": "It's hot flushes, doctor. She didn't want to to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.41,
      "end_seconds": 37.93,
      "duration_seconds": 3.52,
      "text": "so, what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.8,
      "end_seconds": 41.36,
      "duration_seconds": 2.56,
      "text": "about... well, nearly five years"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.46,
      "end_seconds": 52.75,
      "duration_seconds": 9.29,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.33,
      "end_seconds": 65.85,
      "duration_seconds": 12.52,
      "text": "A fan helps a bit. Yes, warm rooms and caffeine. That makes it worse. Oh, and irregular periods. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.02,
      "end_seconds": 70.23,
      "duration_seconds": 3.21,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.06,
      "end_seconds": 84.92,
      "duration_seconds": 10.86,
      "text": "Mild, I'd say. Oh, and night sweats. That's been about the same, six months. As for night sweats, it happens on and off."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 86.13,
      "end_seconds": 89.81,
      "duration_seconds": 3.68,
      "text": "Did you get weight loss or heavy bleeding?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 96.1,
      "end_seconds": 100.4,
      "duration_seconds": 4.3,
      "text": "no weight loss or heavy bleeding, none of it"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.94,
      "end_seconds": 105.88,
      "duration_seconds": 4.94,
      "text": "mm, okay. Did you get palpitations, bleeding after sex or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.55,
      "end_seconds": 109.59,
      "duration_seconds": 2.04,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.49,
      "end_seconds": 114.44,
      "duration_seconds": 2.95,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 116.06,
      "end_seconds": 120.46,
      "duration_seconds": 4.4,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.38,
      "end_seconds": 125.38,
      "duration_seconds": 3.0,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.67,
      "end_seconds": 128.5,
      "duration_seconds": 1.83,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.69,
      "end_seconds": 135.49,
      "duration_seconds": 5.8,
      "text": "Has anything ever caused you a a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 137.23,
      "end_seconds": 140.88,
      "duration_seconds": 3.65,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.62,
      "end_seconds": 143.9,
      "duration_seconds": 2.28,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 144.68,
      "end_seconds": 148.67,
      "duration_seconds": 3.99,
      "text": "It's alendronate, 70 milligrams, once a week, doctor."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.07,
      "end_seconds": 155.2,
      "duration_seconds": 3.13,
      "text": "Has anyone in your family had anything serious?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.54,
      "end_seconds": 158.82,
      "duration_seconds": 2.28,
      "text": "My sister had breast cancer."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.62,
      "end_seconds": 164.3,
      "duration_seconds": 3.68,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.51,
      "end_seconds": 167.54,
      "duration_seconds": 2.03,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.54,
      "end_seconds": 174.66,
      "duration_seconds": 2.12,
      "text": "Right, right. And your job?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.3,
      "end_seconds": 183.09,
      "duration_seconds": 3.79,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.06,
      "end_seconds": 185.67,
      "duration_seconds": 1.61,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.75,
      "end_seconds": 191.45,
      "duration_seconds": 3.7,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.27,
      "end_seconds": 193.9,
      "duration_seconds": 1.63,
      "text": "how are your meals?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 194.64,
      "end_seconds": 198.88,
      "duration_seconds": 4.24,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.89,
      "end_seconds": 211.8,
      "duration_seconds": 2.91,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.01,
      "end_seconds": 221.44,
      "duration_seconds": 3.43,
      "text": "So, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.63,
      "end_seconds": 245.36,
      "duration_seconds": 7.73,
      "text": "Okay: pulse is 83 beats a minute, temperature is 36.7 degrees, pressure 127 over 70."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.55,
      "end_seconds": 252.65,
      "duration_seconds": 5.1,
      "text": "I'll need to examine you for this, it won't take long."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.05,
      "end_seconds": 255.4,
      "duration_seconds": 1.35,
      "text": "breathe out slowly"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.87,
      "end_seconds": 278.49,
      "duration_seconds": 5.62,
      "text": "Blood pressure and pulse are fine and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.4,
      "end_seconds": 284.94,
      "duration_seconds": 1.54,
      "text": "yes, that's fine"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.09,
      "end_seconds": 289.44,
      "duration_seconds": 2.35,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 296.52,
      "end_seconds": 303.83,
      "duration_seconds": 7.31,
      "text": "Okay, so my impression is this: It fits best with perimenopausal symptoms. Anaemia is still possible."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.19,
      "end_seconds": 307.27,
      "duration_seconds": 2.08,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.29,
      "end_seconds": 316.62,
      "duration_seconds": 7.33,
      "text": "I understand the worry. At the moment I'd say it's perimenopausal symptoms, and we'll watch how it goes"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.69,
      "end_seconds": 343.81,
      "duration_seconds": 13.12,
      "text": "Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.66,
      "end_seconds": 347.75,
      "duration_seconds": 2.09,
      "text": "Alright, thanks, take care."
    }
  ]
}