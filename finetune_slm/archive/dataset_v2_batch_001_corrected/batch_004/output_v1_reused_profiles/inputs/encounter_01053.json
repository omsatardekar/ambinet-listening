{
  "schema_version": "1.0",
  "encounter_id": "01053",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.93,
      "end_seconds": 3.87,
      "duration_seconds": 2.94,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.01,
      "end_seconds": 9.45,
      "duration_seconds": 4.44,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.06,
      "end_seconds": 19.94,
      "duration_seconds": 8.88,
      "text": "Mainly tingling in my fingers. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.07,
      "end_seconds": 25.93,
      "duration_seconds": 4.86,
      "text": "Is it there all the time or does it come and go?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.02,
      "end_seconds": 30.84,
      "duration_seconds": 2.82,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.65,
      "end_seconds": 37.61,
      "duration_seconds": 4.96,
      "text": "Have you been waking up at night with pins and needles?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.37,
      "end_seconds": 42.6,
      "duration_seconds": 3.23,
      "text": "I mean, yes, for ten days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.12,
      "end_seconds": 46.94,
      "duration_seconds": 2.82,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.74,
      "end_seconds": 53.57,
      "duration_seconds": 4.83,
      "text": "It's all the time. Oh, and a weak grip."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.88,
      "end_seconds": 70.89,
      "duration_seconds": 2.01,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.85,
      "end_seconds": 74.55,
      "duration_seconds": 2.7,
      "text": "Paracetamol, 500 milligrams, when needed."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.36,
      "end_seconds": 78.38,
      "duration_seconds": 2.02,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.6,
      "end_seconds": 83.5,
      "duration_seconds": 3.9,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.42,
      "end_seconds": 85.62,
      "duration_seconds": 1.2,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.69,
      "end_seconds": 90.43,
      "duration_seconds": 3.74,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.52,
      "end_seconds": 95.41,
      "duration_seconds": 3.89,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.35,
      "end_seconds": 101.13,
      "duration_seconds": 3.78,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.81,
      "end_seconds": 108.04,
      "duration_seconds": 6.23,
      "text": "Any health conditions I should have on record? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.83,
      "end_seconds": 112.28,
      "duration_seconds": 2.45,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.37,
      "end_seconds": 124.4,
      "duration_seconds": 9.03,
      "text": "Yes, an underactive thyroid is known to us, good to have that clear. Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.98,
      "end_seconds": 134.06,
      "duration_seconds": 9.08,
      "text": "Yes, tramadol. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.29,
      "end_seconds": 137.68,
      "duration_seconds": 2.39,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.34,
      "end_seconds": 143.69,
      "duration_seconds": 4.35,
      "text": "Just keyhole surgery on my gallbladder, two years back."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.98,
      "end_seconds": 151.49,
      "duration_seconds": 6.51,
      "text": "Did you get neck pain, bladder problems, trouble walking or swelling in the joints?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.42,
      "end_seconds": 160.45,
      "duration_seconds": 8.03,
      "text": "I haven't had neck pain, bladder problems, trouble walking or swelling in the joints, no."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.08,
      "end_seconds": 163.37,
      "duration_seconds": 2.29,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 164.63,
      "end_seconds": 166.14,
      "duration_seconds": 1.51,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.86,
      "end_seconds": 170.01,
      "duration_seconds": 2.15,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.77,
      "end_seconds": 173.24,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 173.9,
      "end_seconds": 176.35,
      "duration_seconds": 2.45,
      "text": "So, I'll do your observations first."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 182.41,
      "end_seconds": 184.73,
      "duration_seconds": 2.32,
      "text": "Nearly done with the readings..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.39,
      "end_seconds": 205.48,
      "duration_seconds": 11.09,
      "text": "Okay: pulse is 75 beats a minute, pressure 108 over 73, temp 36.7 degrees. And SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.3,
      "end_seconds": 208.29,
      "duration_seconds": 1.99,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.79,
      "end_seconds": 213.69,
      "duration_seconds": 4.9,
      "text": "Right, they help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.41,
      "end_seconds": 219.33,
      "duration_seconds": 2.92,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.06,
      "end_seconds": 223.21,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.29,
      "end_seconds": 244.14,
      "duration_seconds": 2.85,
      "text": "Tapping over the wrist reproduces the tingling."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 248.22,
      "end_seconds": 250.1,
      "duration_seconds": 1.88,
      "text": "You can relax now."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 265.3,
      "end_seconds": 288.16,
      "duration_seconds": 22.86,
      "text": "Putting it all together, this is probably carpal tunnel syndrome. The reason I say that is that your story and my examination fit together. Let me just check I've got this right. You've had tingling in your fingers, and no neck pain or swelling in the joints."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.71,
      "end_seconds": 292.53,
      "duration_seconds": 2.82,
      "text": "Mm, uh, that's right."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.89,
      "end_seconds": 321.28,
      "duration_seconds": 20.39,
      "text": "Let's get a blood sugar test, for neuropathy screen. Let's get a nerve conduction study, for hand numbness. Take short breaks from typing and keep the wrist straight. Let's get you seen by physiotherapy, I'll arrange the letter. Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.86,
      "end_seconds": 325.59,
      "duration_seconds": 3.73,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.43,
      "end_seconds": 330.71,
      "duration_seconds": 1.28,
      "text": "See you soon."
    }
  ]
}