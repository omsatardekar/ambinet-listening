{
  "schema_version": "1.0",
  "encounter_id": "01199",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.81,
      "end_seconds": 5.23,
      "duration_seconds": 4.42,
      "text": "Doctor? Hello, I hope this is the right time."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.91,
      "end_seconds": 15.47,
      "duration_seconds": 4.56,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.49,
      "end_seconds": 26.9,
      "duration_seconds": 9.41,
      "text": "I'm here because of a twisted ankle. I'm not great at remembering details, so bear with me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.3,
      "end_seconds": 30.27,
      "duration_seconds": 1.97,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.52,
      "end_seconds": 39.25,
      "duration_seconds": 7.73,
      "text": "For five days, I'd say. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.08,
      "end_seconds": 46.34,
      "duration_seconds": 5.26,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.14,
      "end_seconds": 53.15,
      "duration_seconds": 6.01,
      "text": "It's worse with putting weight on it. Only ice, and it's not much."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.41,
      "end_seconds": 72.59,
      "duration_seconds": 1.18,
      "text": "Any calf pain?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.41,
      "end_seconds": 77.79,
      "duration_seconds": 4.38,
      "text": "Mm, not that I've noticed, no calf pain."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.37,
      "end_seconds": 85.27,
      "duration_seconds": 6.9,
      "text": "Did you get cracking sound at the time, numbness in the foot or previous fracture?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.82,
      "end_seconds": 94.85,
      "duration_seconds": 9.03,
      "text": "hmm, I haven't had cracking sound at the time, numbness in the foot or previous fracture, no"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.8,
      "end_seconds": 99.51,
      "duration_seconds": 3.71,
      "text": "anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.65,
      "end_seconds": 102.86,
      "duration_seconds": 2.21,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.64,
      "end_seconds": 122.59,
      "duration_seconds": 1.95,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 123.43,
      "end_seconds": 127.93,
      "duration_seconds": 4.5,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.94,
      "end_seconds": 137.29,
      "duration_seconds": 3.35,
      "text": "So, what line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.97,
      "end_seconds": 144.67,
      "duration_seconds": 5.7,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.75,
      "end_seconds": 149.72,
      "duration_seconds": 2.97,
      "text": "So, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.59,
      "end_seconds": 155.82,
      "duration_seconds": 4.23,
      "text": "I'm allergic to wheat, I get itchy skin."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.61,
      "end_seconds": 161.47,
      "duration_seconds": 4.86,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 163.27,
      "end_seconds": 165.41,
      "duration_seconds": 2.14,
      "text": "no, nothing at all"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.64,
      "end_seconds": 180.03,
      "duration_seconds": 1.39,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.11,
      "end_seconds": 184.18,
      "duration_seconds": 2.07,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.39,
      "end_seconds": 204.57,
      "duration_seconds": 3.18,
      "text": "so, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.41,
      "end_seconds": 208.29,
      "duration_seconds": 2.88,
      "text": "No, I'm not on anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.28,
      "end_seconds": 215.18,
      "duration_seconds": 4.9,
      "text": "I'd like to check you over now, if that's alright"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.76,
      "end_seconds": 219.75,
      "duration_seconds": 2.99,
      "text": "so, tell me if that's sore"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.33,
      "end_seconds": 239.38,
      "duration_seconds": 11.05,
      "text": "There is swelling and bruising over the outer ankle and I can't find any bony tenderness at the back of the ankle bone."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.77,
      "end_seconds": 253.98,
      "duration_seconds": 9.21,
      "text": "That's all I needed to check. Okay, so my impression is this: It points towards an ankle sprain without signs of a fracture."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.36,
      "end_seconds": 259.27,
      "duration_seconds": 3.91,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.25,
      "end_seconds": 279.9,
      "duration_seconds": 19.65,
      "text": "I understand the worry. At the moment I'd say it's an ankle sprain without signs of a fracture, and we'll know more once the an ankle X-ray is back. I think an ankle X-ray makes sense here, for ankle injury"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 283.46,
      "end_seconds": 285.73,
      "duration_seconds": 2.27,
      "text": "the earliest is Thursday, 10 am"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.6,
      "end_seconds": 298.43,
      "duration_seconds": 11.83,
      "text": "I'd like you to take paracetamol, 1 gram, every six hours if needed, for five days. You take it by mouth. That's for ankle pain."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 299.4,
      "end_seconds": 304.05,
      "duration_seconds": 4.65,
      "text": "let me think, alright, I'll pick it up today"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.19,
      "end_seconds": 317.18,
      "duration_seconds": 11.99,
      "text": "rest, ice, a firm bandage and keep it raised, and start gentle movement after two days i'd like you to see physiotherapy as well, and I'll write the referral"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 319.26,
      "end_seconds": 319.96,
      "duration_seconds": 0.7,
      "text": "Okay."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.5,
      "end_seconds": 330.69,
      "duration_seconds": 9.19,
      "text": "Please come and see me if it isn't better in a week. What are the next steps as you understand them?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 332.56,
      "end_seconds": 346.08,
      "duration_seconds": 13.52,
      "text": "So, um, I take the paracetamol, 1 gram, every six hours if needed and come back if it isn't better in a week. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.5,
      "end_seconds": 353.19,
      "duration_seconds": 5.69,
      "text": "Yes, exactly right. Okay, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.68,
      "end_seconds": 359.71,
      "duration_seconds": 2.03,
      "text": "Alright, thanks, take care."
    }
  ]
}