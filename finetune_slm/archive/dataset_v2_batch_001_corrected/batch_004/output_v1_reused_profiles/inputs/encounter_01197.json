{
  "schema_version": "1.0",
  "encounter_id": "01197",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.83,
      "end_seconds": 4.0,
      "duration_seconds": 3.17,
      "text": "Morning, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.79,
      "end_seconds": 8.98,
      "duration_seconds": 4.19,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.05,
      "end_seconds": 17.03,
      "duration_seconds": 5.98,
      "text": "Honestly, it's periods lasting longer, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.04,
      "end_seconds": 20.97,
      "duration_seconds": 2.93,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.86,
      "end_seconds": 25.4,
      "duration_seconds": 2.54,
      "text": "For four weeks, I'd say."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.88,
      "end_seconds": 31.93,
      "duration_seconds": 6.05,
      "text": "I see, go ahead. Right, how much trouble does it give you?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.71,
      "end_seconds": 38.84,
      "duration_seconds": 5.13,
      "text": "It feels severe to me. Oh, I've also had tiredness."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 39.65,
      "end_seconds": 49.66,
      "duration_seconds": 10.01,
      "text": "Doctor, I've got the readings for you. Pulse is 78 beats a minute, pressure 121 over 77, oxygen saturation is 98 percent. Temperature is 36.4 degrees."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.67,
      "end_seconds": 52.08,
      "duration_seconds": 1.41,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.35,
      "end_seconds": 57.33,
      "duration_seconds": 2.98,
      "text": "So, shall I start the examination?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.08,
      "end_seconds": 77.74,
      "duration_seconds": 1.66,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.94,
      "end_seconds": 80.93,
      "duration_seconds": 1.99,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.71,
      "end_seconds": 98.66,
      "duration_seconds": 1.95,
      "text": "You look a little pale."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.35,
      "end_seconds": 102.7,
      "duration_seconds": 2.35,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.07,
      "end_seconds": 121.21,
      "duration_seconds": 6.14,
      "text": "The tummy is soft, a little tender in the lower part, and there's no mass."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.78,
      "end_seconds": 129.39,
      "duration_seconds": 4.61,
      "text": "Please sit back down. Did you notice any weight loss?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.12,
      "end_seconds": 134.34,
      "duration_seconds": 3.22,
      "text": "Yeah, no, none, no weight loss."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.09,
      "end_seconds": 138.85,
      "duration_seconds": 2.76,
      "text": "Any fever or vaginal discharge at all?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.2,
      "end_seconds": 150.64,
      "duration_seconds": 10.44,
      "text": "No, no fever, no vaginal discharge. I did have very heavy periods at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.07,
      "end_seconds": 156.14,
      "duration_seconds": 4.07,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.99,
      "end_seconds": 159.53,
      "duration_seconds": 2.54,
      "text": "Ah, no, that's all normal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.51,
      "end_seconds": 166.27,
      "duration_seconds": 2.76,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.82,
      "end_seconds": 168.84,
      "duration_seconds": 2.02,
      "text": "No, skin's been fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.73,
      "end_seconds": 171.57,
      "duration_seconds": 0.84,
      "text": "Any smoking?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.37,
      "end_seconds": 176.8,
      "duration_seconds": 3.43,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.91,
      "end_seconds": 180.16,
      "duration_seconds": 2.25,
      "text": "Okay, and alcohol, how much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.5,
      "end_seconds": 183.28,
      "duration_seconds": 1.78,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.41,
      "end_seconds": 186.98,
      "duration_seconds": 2.57,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.74,
      "end_seconds": 192.17,
      "duration_seconds": 4.43,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.11,
      "end_seconds": 196.56,
      "duration_seconds": 2.45,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.69,
      "end_seconds": 201.74,
      "duration_seconds": 4.05,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.03,
      "end_seconds": 206.2,
      "duration_seconds": 3.17,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.65,
      "end_seconds": 209.45,
      "duration_seconds": 1.8,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.24,
      "end_seconds": 213.43,
      "duration_seconds": 2.19,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.22,
      "end_seconds": 220.72,
      "duration_seconds": 6.5,
      "text": "An underactive thyroid, for about a year. I've, I've got high cholesterol."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.91,
      "end_seconds": 223.35,
      "duration_seconds": 1.44,
      "text": "And besides that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.98,
      "end_seconds": 228.67,
      "duration_seconds": 3.69,
      "text": "I have heart disease, for five years."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 229.49,
      "end_seconds": 240.86,
      "duration_seconds": 11.37,
      "text": "Ah. Right, so an underactive thyroid is already on your record. We'll keep that in mind today. What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 242.0,
      "end_seconds": 253.46,
      "duration_seconds": 11.46,
      "text": "I'm on thyroxine, 75 micrograms, every morning for my thyroid. I take atorvastatin, 20 milligrams, at night for my cholesterol."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.22,
      "end_seconds": 257.59,
      "duration_seconds": 2.37,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 259.16,
      "end_seconds": 268.11,
      "duration_seconds": 8.95,
      "text": "For about a month. Clopidogrel. I take it 75 milligrams, maybe, once a day for the stent."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.83,
      "end_seconds": 271.8,
      "duration_seconds": 2.97,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.56,
      "end_seconds": 277.75,
      "duration_seconds": 5.19,
      "text": "Mm, not with me. I'll bring it next time."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.52,
      "end_seconds": 283.43,
      "duration_seconds": 4.91,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.22,
      "end_seconds": 296.17,
      "duration_seconds": 10.95,
      "text": "I think I reacted to some antibiotic once, uh, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 305.07,
      "end_seconds": 322.82,
      "duration_seconds": 17.75,
      "text": "Okay, thinking it through, it points towards heavy periods with a cause still to find. A hormonal imbalance is still possible. We shouldn't forget fibroids. I'm sending you for a pelvic ultrasound because of heavy periods."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_4",
      "role": "CLINICAL_STAFF",
      "start_seconds": 324.23,
      "end_seconds": 328.47,
      "duration_seconds": 4.24,
      "text": "I can book that for Monday at 3:30 pm."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.05,
      "end_seconds": 345.99,
      "duration_seconds": 15.94,
      "text": "I'm sending you for a pregnancy test because of abnormal bleeding. The result will help us decide whether anything more is needed. Let's use ferrous sulfate, 200 milligrams, once a day, for three months. That's for possible iron deficiency."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.92,
      "end_seconds": 352.48,
      "duration_seconds": 5.56,
      "text": "Okay, so should I carry on if I feel better?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 352.99,
      "end_seconds": 363.1,
      "duration_seconds": 10.11,
      "text": "I'd like you to take tranexamic acid, 500 milligrams, three times a day during periods, for three cycles. That's for heavy bleeding."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.19,
      "end_seconds": 366.79,
      "duration_seconds": 1.6,
      "text": "Okay, I understand."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 368.67,
      "end_seconds": 388.02,
      "duration_seconds": 19.35,
      "text": "Keep a note of how many pads you use each day and the dates, it helps us a lot. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.8,
      "end_seconds": 391.74,
      "duration_seconds": 2.94,
      "text": "I know what to watch for."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.35,
      "end_seconds": 415.87,
      "duration_seconds": 23.52,
      "text": "I'm not ordering blood tests today. If things carry on next month, we'll consider it. If you soak through a pad every hour or feel faint, or you feel really unwell, please come to the emergency department. I'd like to see you again after the results are back."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 417.26,
      "end_seconds": 418.94,
      "duration_seconds": 1.68,
      "text": "Yes, that's manageable."
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 421.02,
      "end_seconds": 425.37,
      "duration_seconds": 4.35,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 427.12,
      "end_seconds": 430.38,
      "duration_seconds": 3.26,
      "text": "I mean, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 432.18,
      "end_seconds": 433.45,
      "duration_seconds": 1.27,
      "text": "Take care now."
    }
  ]
}