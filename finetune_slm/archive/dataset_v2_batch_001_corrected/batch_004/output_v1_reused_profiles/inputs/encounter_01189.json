{
  "schema_version": "1.0",
  "encounter_id": "01189",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.84,
      "end_seconds": 4.14,
      "duration_seconds": 3.3,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.28,
      "end_seconds": 9.3,
      "duration_seconds": 4.02,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.84,
      "end_seconds": 16.97,
      "duration_seconds": 6.13,
      "text": "It's pain in the calf. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.35,
      "end_seconds": 25.36,
      "duration_seconds": 7.01,
      "text": "How long has it been like this? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 26.17,
      "end_seconds": 28.17,
      "duration_seconds": 2.0,
      "text": "Probably five days. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.87,
      "end_seconds": 33.08,
      "duration_seconds": 3.21,
      "text": "Okay, is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.52,
      "end_seconds": 37.36,
      "duration_seconds": 2.84,
      "text": "I'd say all the time."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.61,
      "end_seconds": 44.57,
      "duration_seconds": 5.96,
      "text": "Any wound, chest pain or red streaks up the leg at all?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.72,
      "end_seconds": 52.62,
      "duration_seconds": 2.9,
      "text": "Yeah, none of those, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.41,
      "end_seconds": 55.91,
      "duration_seconds": 2.5,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.63,
      "end_seconds": 59.25,
      "duration_seconds": 1.62,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.29,
      "end_seconds": 64.38,
      "duration_seconds": 4.09,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.99,
      "end_seconds": 73.81,
      "duration_seconds": 7.82,
      "text": "High blood pressure, for about ten years. It's the not knowing that gets to me."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.59,
      "end_seconds": 81.28,
      "duration_seconds": 5.69,
      "text": "Yes, high blood pressure is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.11,
      "end_seconds": 103.61,
      "duration_seconds": 4.5,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.02,
      "end_seconds": 108.21,
      "duration_seconds": 3.19,
      "text": "Hydrochlorothiazide, every morning for my pressure."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.16,
      "end_seconds": 112.27,
      "duration_seconds": 2.11,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.45,
      "end_seconds": 115.57,
      "duration_seconds": 2.12,
      "text": "It's 12.5 milligrams."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.11,
      "end_seconds": 118.08,
      "duration_seconds": 1.97,
      "text": "So, are you active?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.91,
      "end_seconds": 121.98,
      "duration_seconds": 3.07,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.57,
      "end_seconds": 126.7,
      "duration_seconds": 3.13,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.05,
      "end_seconds": 131.49,
      "duration_seconds": 3.44,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.9,
      "end_seconds": 147.72,
      "duration_seconds": 5.82,
      "text": "Right, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.26,
      "end_seconds": 155.13,
      "duration_seconds": 3.87,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.92,
      "end_seconds": 167.87,
      "duration_seconds": 2.95,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.5,
      "end_seconds": 180.72,
      "duration_seconds": 3.22,
      "text": "So, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.45,
      "end_seconds": 204.13,
      "duration_seconds": 6.68,
      "text": "Okay: saturation 98 percent, temperature is 38.6 degrees, pulse 102, blood pressure 124 over 66."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 205.75,
      "end_seconds": 208.04,
      "duration_seconds": 2.29,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.55,
      "end_seconds": 210.94,
      "duration_seconds": 2.39,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.74,
      "end_seconds": 216.69,
      "duration_seconds": 3.95,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.55,
      "end_seconds": 220.45,
      "duration_seconds": 2.9,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.84,
      "end_seconds": 246.92,
      "duration_seconds": 9.08,
      "text": "There is a warm, red, tender patch about ten centimetres across on the right shin with mild swelling."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.16,
      "end_seconds": 254.69,
      "duration_seconds": 2.53,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.02,
      "end_seconds": 278.23,
      "duration_seconds": 6.21,
      "text": "Okay, so my impression is this: I'd lean towards cellulitis of the right leg."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.86,
      "end_seconds": 283.08,
      "duration_seconds": 3.22,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.34,
      "end_seconds": 318.97,
      "duration_seconds": 34.63,
      "text": "It's reasonable to be concerned, but right now cellulitis of the right leg is my leading thought, not anything worse. I'm going to order blood tests, for skin infection. I'd like to arrange an ultrasound of the leg veins for leg swelling. It's a routine test and it'll give us a much clearer picture. What I'm giving you is flucloxacillin, 500 milligrams, four times a day, for seven days. You take it by mouth. That's for cellulitis."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.78,
      "end_seconds": 342.05,
      "duration_seconds": 21.27,
      "text": "Mark the edge of the redness with a pen and keep the leg raised when sitting. If the redness spreads quickly or you get a high fever, that's the point to come in urgently. Book a review in two days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.99,
      "end_seconds": 344.51,
      "duration_seconds": 1.52,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.35,
      "end_seconds": 347.77,
      "duration_seconds": 1.42,
      "text": "See you soon."
    }
  ]
}