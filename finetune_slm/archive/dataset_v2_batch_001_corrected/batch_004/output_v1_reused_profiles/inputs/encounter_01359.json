{
  "schema_version": "1.0",
  "encounter_id": "01359",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.06,
      "end_seconds": 4.92,
      "duration_seconds": 3.86,
      "text": "Morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.47,
      "end_seconds": 10.6,
      "duration_seconds": 4.13,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.51,
      "end_seconds": 17.64,
      "duration_seconds": 6.13,
      "text": "Honestly, it's skipped beats, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.4,
      "end_seconds": 21.31,
      "duration_seconds": 1.91,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.28,
      "end_seconds": 25.71,
      "duration_seconds": 3.43,
      "text": "I've, I've had it for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.71,
      "end_seconds": 28.75,
      "duration_seconds": 2.04,
      "text": "does anything set it off?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.22,
      "end_seconds": 35.05,
      "duration_seconds": 4.83,
      "text": "Coffee and lying on the left definitely sets it off"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.8,
      "end_seconds": 37.83,
      "duration_seconds": 2.03,
      "text": "is it accompanied by anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.64,
      "end_seconds": 54.14,
      "duration_seconds": 15.5,
      "text": "Poor sleep goes along with it, most of the time the Poor sleep? That's been for about a month with Poor sleep, it feels moderate to me"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.9,
      "end_seconds": 58.23,
      "duration_seconds": 3.33,
      "text": "Any sign of family history of sudden death?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.9,
      "end_seconds": 63.53,
      "duration_seconds": 4.63,
      "text": "Not that I've noticed, no family history of sudden death."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 64.17,
      "end_seconds": 68.26,
      "duration_seconds": 4.09,
      "text": "Let me check a few things. Any breathlessness or fainting?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 69.67,
      "end_seconds": 72.5,
      "duration_seconds": 2.83,
      "text": "No, no breathlessness or fainting."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.27,
      "end_seconds": 76.84,
      "duration_seconds": 2.57,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.29,
      "end_seconds": 85.91,
      "duration_seconds": 3.62,
      "text": "that's normal as far as I know"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.01,
      "end_seconds": 90.76,
      "duration_seconds": 2.75,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.64,
      "end_seconds": 94.74,
      "duration_seconds": 3.1,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.08,
      "end_seconds": 106.69,
      "duration_seconds": 2.61,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.96,
      "end_seconds": 113.1,
      "duration_seconds": 1.14,
      "text": "no, never"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.12,
      "end_seconds": 133.49,
      "duration_seconds": 2.37,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.28,
      "end_seconds": 136.52,
      "duration_seconds": 1.24,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.56,
      "end_seconds": 142.36,
      "duration_seconds": 4.8,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.15,
      "end_seconds": 147.51,
      "duration_seconds": 4.36,
      "text": "Okay, so I don't think I have any, no."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.59,
      "end_seconds": 164.93,
      "duration_seconds": 2.34,
      "text": "alright, how active are you?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.76,
      "end_seconds": 169.21,
      "duration_seconds": 3.45,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.82,
      "end_seconds": 172.11,
      "duration_seconds": 1.29,
      "text": "what's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.65,
      "end_seconds": 176.49,
      "duration_seconds": 3.84,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.48,
      "end_seconds": 182.55,
      "duration_seconds": 4.07,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.67,
      "end_seconds": 186.77,
      "duration_seconds": 3.1,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.51,
      "end_seconds": 190.0,
      "duration_seconds": 2.49,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.02,
      "end_seconds": 199.58,
      "duration_seconds": 2.56,
      "text": "Sit still for a a moment..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.54,
      "end_seconds": 220.63,
      "duration_seconds": 8.09,
      "text": "okay: heart rate 75, pressure 108 over 73, oxygen saturation is 98 percent, temp 36.8 degrees"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.0,
      "end_seconds": 226.17,
      "duration_seconds": 3.17,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.62,
      "end_seconds": 229.62,
      "duration_seconds": 2.0,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.23,
      "end_seconds": 244.25,
      "duration_seconds": 3.02,
      "text": "heart sounds are normal with no murmur"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.18,
      "end_seconds": 265.37,
      "duration_seconds": 15.19,
      "text": "Thank you, you can get dressed. Okay, thinking it through, I can't pin this down yet. We're looking at benign extra heartbeats, though we should confirm or a rhythm problem."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 266.81,
      "end_seconds": 270.17,
      "duration_seconds": 3.36,
      "text": "do you think it's something serious?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.97,
      "end_seconds": 281.84,
      "duration_seconds": 9.87,
      "text": "I can't promise yet, but most people with benign extra heartbeats, though we should confirm do well once it's treated properly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.75,
      "end_seconds": 319.68,
      "duration_seconds": 28.93,
      "text": "I'll request a thyroid test, it'll help with palpitations. A Holter monitor is what I'd like next, for palpitations try cutting out caffeine for two weeks and see if the beats settle if the symptoms get worse, or you feel really unwell, please come to the emergency department i'll want another look in four weeks anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.03,
      "end_seconds": 323.11,
      "duration_seconds": 2.08,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 324.09,
      "end_seconds": 325.36,
      "duration_seconds": 1.27,
      "text": "goodbye for now"
    }
  ]
}