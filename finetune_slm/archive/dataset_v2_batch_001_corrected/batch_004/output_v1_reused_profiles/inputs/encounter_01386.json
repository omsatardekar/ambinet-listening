      "role": "PATIENT",
      "start_seconds": 52.92,
      "end_seconds": 59.32,
      "duration_seconds": 6.4,
      "text": "So, I was just going to say that the main thing is—"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 59.42,
      "end_seconds": 65.46,
      "duration_seconds": 6.04,
      "text": "sorry to cut in, doctor, quick question: shall I bring the trolley in now or later?"
    },
