      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.55,
      "end_seconds": 71.76,
      "duration_seconds": 4.21,
      "text": "Later thanks. Please go on. Any dark urine as well?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_4",
      "role": "PATIENT",
      "start_seconds": 73.72,
      "end_seconds": 80.65,
