{
  "schema_version": "1.0",
  "encounter_id": "01077",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.35,
      "end_seconds": 3.71,
      "duration_seconds": 2.36,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.5,
      "end_seconds": 6.68,
      "duration_seconds": 1.18,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.01,
      "end_seconds": 9.84,
      "duration_seconds": 1.83,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 10.76,
      "end_seconds": 21.61,
      "duration_seconds": 10.85,
      "text": "Well, I've been having pain going to the shoulder blade. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.06,
      "end_seconds": 26.19,
      "duration_seconds": 3.13,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.71,
      "end_seconds": 31.24,
      "duration_seconds": 3.53,
      "text": "I mean, I've had it since Monday."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.03,
      "end_seconds": 40.84,
      "duration_seconds": 8.81,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 42.89,
      "end_seconds": 50.52,
      "duration_seconds": 7.63,
      "text": "it, It feels mild to me it comes and goes i've also had bloating"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 52.33,
      "end_seconds": 54.25,
      "duration_seconds": 1.92,
      "text": "Have you been belching?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 56.13,
      "end_seconds": 58.59,
      "duration_seconds": 2.46,
      "text": "Yes, for about a month."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 60.68,
      "end_seconds": 63.08,
      "duration_seconds": 2.4,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.48,
      "end_seconds": 68.07,
      "duration_seconds": 3.59,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 69.5,
      "end_seconds": 72.72,
      "duration_seconds": 3.22,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 74.56,
      "end_seconds": 79.15,
      "duration_seconds": 4.59,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 81.1,
      "end_seconds": 82.44,
      "duration_seconds": 1.34,
      "text": "are you active?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 88.06,
      "end_seconds": 90.84,
      "duration_seconds": 2.78,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 91.78,
      "end_seconds": 95.55,
      "duration_seconds": 3.77,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.24,
      "end_seconds": 100.82,
      "duration_seconds": 4.58,
      "text": "Rosuvastatin, 10 milligrams, maybe, at night for my cholesterol"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 102.8,
      "end_seconds": 107.7,
      "duration_seconds": 4.9,
      "text": "Have you got the box or the prescription on you?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 113.35,
      "end_seconds": 122.09,
      "duration_seconds": 8.74,
      "text": "No, it's at home. I had metformin at one point, but I'm off it it now."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 140.58,
      "end_seconds": 143.54,
      "duration_seconds": 2.96,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 147.45,
      "end_seconds": 149.43,
      "duration_seconds": 1.98,
      "text": "I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 151.21,
      "end_seconds": 152.19,
      "duration_seconds": 0.98,
      "text": "Right, right."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.71,
      "end_seconds": 161.85,
      "duration_seconds": 8.14,
      "text": "Right, I have high cholesterol. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 163.9,
      "end_seconds": 169.01,
      "duration_seconds": 5.11,
      "text": "Okay, I can see high cholesterol in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.16,
      "end_seconds": 190.69,
      "duration_seconds": 4.53,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 191.69,
      "end_seconds": 193.29,
      "duration_seconds": 1.6,
      "text": "No known allergies."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 194.49,
      "end_seconds": 195.81,
      "duration_seconds": 1.32,
      "text": "Any yellow eyes?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 196.75,
      "end_seconds": 200.68,
      "duration_seconds": 3.93,
      "text": "I, I haven't noticed any yellow eyes."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.92,
      "end_seconds": 204.96,
      "duration_seconds": 3.04,
      "text": "any fever, dark urine or vomiting?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 205.82,
      "end_seconds": 210.5,
      "duration_seconds": 4.68,
      "text": "No, um, no fever, dark urine or vomiting."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.12,
      "end_seconds": 214.33,
      "duration_seconds": 3.21,
      "text": "has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 215.12,
      "end_seconds": 218.16,
      "duration_seconds": 3.04,
      "text": "Uh, no, that's been fine."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.72,
      "end_seconds": 222.68,
      "duration_seconds": 2.96,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.85,
      "end_seconds": 233.92,
      "duration_seconds": 2.07,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.7,
      "end_seconds": 260.93,
      "duration_seconds": 9.23,
      "text": "okay: blood pressure 110 over 75, pulse 82. And oxygen saturation is 97 percent, temperature is 36.7 degrees"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 261.64,
      "end_seconds": 262.99,
      "duration_seconds": 1.35,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.07,
      "end_seconds": 266.75,
      "duration_seconds": 2.68,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.34,
      "end_seconds": 272.27,
      "duration_seconds": 3.93,
      "text": "Let me look at the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 273.45,
      "end_seconds": 274.69,
      "duration_seconds": 1.24,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.65,
      "end_seconds": 297.1,
      "duration_seconds": 3.45,
      "text": "the rest of the tummy is soft"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.44,
      "end_seconds": 299.8,
      "duration_seconds": 1.36,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.25,
      "end_seconds": 324.04,
      "duration_seconds": 7.79,
      "text": "Mild tenderness under the right ribs, and no pain when you breathe in while I press."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.42,
      "end_seconds": 329.73,
      "duration_seconds": 2.31,
      "text": "you can sit up now"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.52,
      "end_seconds": 350.3,
      "duration_seconds": 11.78,
      "text": "Let me tell you where I've got to. This is probably gallstone pain. Let's get an ultrasound of the abdomen, for right upper quadrant pain."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 352.33,
      "end_seconds": 355.12,
      "duration_seconds": 2.79,
      "text": "The earliest is Thursday, 2 pm."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.24,
      "end_seconds": 387.5,
      "duration_seconds": 31.26,
      "text": "Liver function tests is what I'd like next, for right upper quadrant pain. Smaller, lower-fat meals will probably keep the pain down until we've seen the scan. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Do get help quickly if the pain lasts for hours, you get a fever or turn yellow. Let's plan a check after the scan"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 388.93,
      "end_seconds": 390.99,
      "duration_seconds": 2.06,
      "text": "okay, I'll arrange it"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.16,
      "end_seconds": 396.6,
      "duration_seconds": 2.44,
      "text": "Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 397.42,
      "end_seconds": 399.77,
      "duration_seconds": 2.35,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 400.3,
      "end_seconds": 401.52,
      "duration_seconds": 1.22,
      "text": "See you soon."
    }
  ]
}