{
  "schema_version": "1.0",
  "encounter_id": "01352",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 2.84,
      "duration_seconds": 1.77,
      "text": "Good afternoon, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 3.89,
      "end_seconds": 8.34,
      "duration_seconds": 4.45,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 9.77,
      "end_seconds": 19.28,
      "duration_seconds": 9.51,
      "text": "Mainly cramps in my calves at night. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.75,
      "end_seconds": 24.81,
      "duration_seconds": 4.06,
      "text": "Okay, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.78,
      "end_seconds": 35.58,
      "duration_seconds": 9.8,
      "text": "It's been two years, I'm fairly sure. I thought it would sort itself out, but it hasn't."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.11,
      "end_seconds": 42.33,
      "duration_seconds": 5.22,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.36,
      "end_seconds": 71.17,
      "duration_seconds": 26.81,
      "text": "Erm, it's worse with lying in bed. Severe, really. I've never really been one for hospitals. I just want to get back to normal, really. I mean, there's tired legs by evening as well. Oh, you know, and trouble sleeping. About trouble sleeping, moderate, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.99,
      "end_seconds": 75.56,
      "duration_seconds": 2.57,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 77.47,
      "end_seconds": 83.69,
      "duration_seconds": 6.22,
      "text": "I had a mole taken off my arm a few years ago."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.23,
      "end_seconds": 89.23,
      "duration_seconds": 4.0,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.86,
      "end_seconds": 95.09,
      "duration_seconds": 5.23,
      "text": "Uh, um, my aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.25,
      "end_seconds": 102.65,
      "duration_seconds": 4.4,
      "text": "Do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.56,
      "end_seconds": 107.28,
      "duration_seconds": 3.72,
      "text": "No, nothing I can think of."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.35,
      "end_seconds": 113.85,
      "duration_seconds": 4.5,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.76,
      "end_seconds": 130.53,
      "duration_seconds": 15.77,
      "text": "I drink a lot of tea and snack through the day. I do a yoga class on Thursdays. My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 131.54,
      "end_seconds": 134.33,
      "duration_seconds": 2.79,
      "text": "Are you on any regular medication?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.1,
      "end_seconds": 136.23,
      "duration_seconds": 1.13,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.83,
      "end_seconds": 141.66,
      "duration_seconds": 4.83,
      "text": "Okay, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.76,
      "end_seconds": 147.38,
      "duration_seconds": 4.62,
      "text": "I don't think I have any, uh, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.1,
      "end_seconds": 153.48,
      "duration_seconds": 5.38,
      "text": "Any shortness of breath or weakness in the legs at all?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 154.9,
      "end_seconds": 160.85,
      "duration_seconds": 5.95,
      "text": "I haven't had shortness of breath or weakness in the legs, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.7,
      "end_seconds": 168.74,
      "duration_seconds": 6.04,
      "text": "Any swelling of the legs, redness of the leg or back pain at all?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.38,
      "end_seconds": 177.71,
      "duration_seconds": 4.33,
      "text": "I mean, no, nothing to report there."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.47,
      "end_seconds": 182.07,
      "duration_seconds": 3.6,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.27,
      "end_seconds": 186.67,
      "duration_seconds": 3.4,
      "text": "Hmm, no weakness or anything."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 195.0,
      "end_seconds": 199.64,
      "duration_seconds": 4.64,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.86,
      "end_seconds": 210.23,
      "duration_seconds": 2.37,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.29,
      "end_seconds": 237.27,
      "duration_seconds": 5.98,
      "text": "Okay: BP is 113 over 70, temp 36.8 degrees, heart rate 77."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.59,
      "end_seconds": 240.77,
      "duration_seconds": 2.18,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.54,
      "end_seconds": 245.3,
      "duration_seconds": 2.76,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.53,
      "end_seconds": 249.96,
      "duration_seconds": 3.43,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 250.97,
      "end_seconds": 252.88,
      "duration_seconds": 1.91,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 254.21,
      "end_seconds": 255.68,
      "duration_seconds": 1.47,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.14,
      "end_seconds": 278.83,
      "duration_seconds": 6.69,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 279.98,
      "end_seconds": 280.68,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 285.84,
      "end_seconds": 287.49,
      "duration_seconds": 1.65,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.15,
      "end_seconds": 305.29,
      "duration_seconds": 7.14,
      "text": "Let me tell you where I've got to. This is probably night-time muscle cramps without a worrying cause."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.34,
      "end_seconds": 323.58,
      "duration_seconds": 5.24,
      "text": "I think a blood sugar test makes sense here, for tingling feet."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 324.67,
      "end_seconds": 327.45,
      "duration_seconds": 2.78,
      "text": "The earliest is Wednesday, 2 pm."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.78,
      "end_seconds": 350.77,
      "duration_seconds": 21.99,
      "text": "We should do a vitamin level for tingling feet. Keep well hydrated through the day. If it hasn't settled in two weeks, we'd think about blood tests, but not now. I'd like you back after the results are back. How would you describe the plan, so we're on the same page?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 351.79,
      "end_seconds": 359.92,
      "duration_seconds": 8.13,
      "text": "So, you know, I come back after the results are back. Is that right?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.9,
      "end_seconds": 365.24,
      "duration_seconds": 4.34,
      "text": "Yes, exactly right. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.82,
      "end_seconds": 369.12,
      "duration_seconds": 3.3,
      "text": "Thank you, um, doctor, goodbye."
    }
  ]
}