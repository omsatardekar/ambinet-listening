  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 2.98,
      "duration_seconds": 1.65,
      "text": "Evening. Let's get started."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 3.6,
      "end_seconds": 6.22,
      "duration_seconds": 2.62,
      "text": "afternoon, is this seat fine?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 8.29,
      "end_seconds": 14.23,
      "duration_seconds": 5.94,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.42,
      "end_seconds": 22.14,
      "duration_seconds": 6.72,
      "text": "Okay, that's fine, sit down. We'll go through it together. Did you find the place alright?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 23.96,
      "end_seconds": 29.63,
      "duration_seconds": 5.67,
      "text": "yes, it was easy enough the parking was the hard part"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.51,
      "end_seconds": 34.06,
      "duration_seconds": 2.55,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 35.82,
      "end_seconds": 41.23,
      "duration_seconds": 5.41,
      "text": "Doctor, you know, it's my heart racing. That's what we're worried about."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 42.65,
      "end_seconds": 45.42,
      "duration_seconds": 2.77,
      "text": "how long has it been like this?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 47.12,
      "end_seconds": 54.41,
      "duration_seconds": 7.29,
      "text": "About... well, one week. And And there's shaky hands as well, one week now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.52,
      "end_seconds": 65.35,
      "duration_seconds": 9.83,
      "text": "tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 66.33,
      "end_seconds": 70.07,
      "duration_seconds": 3.74,
      "text": "it happens all the time it's mild, honestly"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.93,
      "end_seconds": 90.93,
      "duration_seconds": 7.0,
      "text": "A few quick ones: eye bulging, lump in the neck, trouble sleeping or chest pain?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 91.48,
      "end_seconds": 99.9,
      "duration_seconds": 8.42,
      "text": "No eye bulging, lump in the neck, trouble sleeping or chest pain, none of it."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.68,
      "end_seconds": 103.78,
      "duration_seconds": 3.1,
      "text": "Have you had diarrhoea, by any chance?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.63,
      "end_seconds": 110.93,
      "duration_seconds": 2.3,
      "text": "I haven't noticed any diarrhoea."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.96,
      "end_seconds": 115.08,
      "duration_seconds": 2.12,
      "text": "your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.14,
      "end_seconds": 122.06,
      "duration_seconds": 1.92,
      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 123.44,
      "end_seconds": 126.22,
      "duration_seconds": 2.78,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 128.28,
      "end_seconds": 129.36,
      "duration_seconds": 1.08,
      "text": "no rashes"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.04,
      "end_seconds": 134.31,
      "duration_seconds": 3.27,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 135.63,
      "end_seconds": 137.9,
      "duration_seconds": 2.27,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.68,
      "end_seconds": 142.06,
      "duration_seconds": 2.38,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 142.77,
      "end_seconds": 146.82,
      "duration_seconds": 4.05,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 148.04,
      "end_seconds": 150.05,
      "duration_seconds": 2.01,
      "text": "Do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 151.88,
      "end_seconds": 155.83,
      "duration_seconds": 3.95,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.23,
      "end_seconds": 159.53,
      "duration_seconds": 2.3,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 160.67,
      "end_seconds": 164.73,
      "duration_seconds": 4.06,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 175.59,
      "end_seconds": 178.01,
      "duration_seconds": 2.42,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 179.86,
      "end_seconds": 187.03,
      "duration_seconds": 7.17,
      "text": "She is on aspirin, 75 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.59,
      "end_seconds": 192.01,
      "duration_seconds": 3.42,
      "text": "So, since when have you been taking it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 192.8,
      "end_seconds": 194.79,
      "duration_seconds": 1.99,
      "text": "For about a year."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.88,
      "end_seconds": 202.38,
      "duration_seconds": 3.5,
      "text": "Let me get the readings out of the way."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.62,
      "end_seconds": 216.21,
      "duration_seconds": 2.59,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.49,
      "end_seconds": 247.28,
      "duration_seconds": 13.79,
      "text": "okay: heart rate 125, height 155 centimetres, BP is 122 over 84. And BMI works out to 39.5, temperature 36.5, oxygen saturation is 98 percent, weight 95 kilos"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.52,
      "end_seconds": 250.22,
      "duration_seconds": 1.7,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.22,
      "end_seconds": 256.01,
      "duration_seconds": 3.79,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.68,
      "end_seconds": 260.97,
      "duration_seconds": 2.29,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.81,
      "end_seconds": 263.11,
      "duration_seconds": 1.3,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.81,
      "end_seconds": 285.72,
      "duration_seconds": 6.91,
      "text": "There's a fine tremor in the outstretched hands, and your palms are warm and moist."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.69,
      "end_seconds": 288.05,
      "duration_seconds": 1.36,
      "text": "does that hurt?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 303.48,
      "end_seconds": 307.0,
      "duration_seconds": 3.52,
      "text": "Your thyroid feels a little enlarged and smooth."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 310.04,
      "end_seconds": 320.66,
      "duration_seconds": 10.62,
      "text": "You can relax now. Having listened and examined, the most likely explanation is an overactive thyroid. It could also be anxiety, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 333.38,
      "end_seconds": 341.46,
      "duration_seconds": 8.08,
      "text": "I think a thyroid scan makes sense here, for hyperthyroidism. Let's get a thyroid test, for hyperthyroid symptoms."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 342.65,
      "end_seconds": 344.58,
      "duration_seconds": 1.93,
      "text": "Okay, I'll do it."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.49,
      "end_seconds": 364.08,
      "duration_seconds": 18.59,
      "text": "you'll be taking propranolol, 20 milligrams, twice a day, until we review that's for palpitations and tremor limit tea, coffee and anything that speeds up the heart for now right, that's the plan do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 365.45,
      "end_seconds": 368.34,
      "duration_seconds": 2.89,
      "text": "Great, thank you for your help."
    }
  ]
}