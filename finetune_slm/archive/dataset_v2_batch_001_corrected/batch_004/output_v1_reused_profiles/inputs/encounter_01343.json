{
  "schema_version": "1.0",
  "encounter_id": "01343",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.19,
      "end_seconds": 3.3,
      "duration_seconds": 2.11,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.42,
      "end_seconds": 5.47,
      "duration_seconds": 1.05,
      "text": "Hi, thanks."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.3,
      "end_seconds": 8.76,
      "duration_seconds": 2.46,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.32,
      "end_seconds": 14.19,
      "duration_seconds": 4.87,
      "text": "So the thing is, I've got pain in my heel."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 15.65,
      "end_seconds": 18.29,
      "duration_seconds": 2.64,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.34,
      "end_seconds": 32.03,
      "duration_seconds": 2.69,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.83,
      "end_seconds": 57.65,
      "duration_seconds": 3.82,
      "text": "Okay: heart rate 77, BP is 110 over 68."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 59.58,
      "end_seconds": 62.5,
      "duration_seconds": 2.92,
      "text": "Is that alright, you know, doctor?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 63.48,
      "end_seconds": 67.15,
      "duration_seconds": 3.67,
      "text": "They help me see the whole picture, more shortly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.63,
      "end_seconds": 77.73,
      "duration_seconds": 3.1,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 79.82,
      "end_seconds": 82.44,
      "duration_seconds": 2.62,
      "text": "For two years, I'd say."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.83,
      "end_seconds": 94.57,
      "duration_seconds": 7.74,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.75,
      "end_seconds": 113.13,
      "duration_seconds": 17.38,
      "text": "I notice it more with first steps in the morning and standing long. About a seven out of ten. It's the not knowing that gets to me. Sorry, I know I'm rambling a bit."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 115.15,
      "end_seconds": 119.09,
      "duration_seconds": 3.94,
      "text": "Any fever, numbness in the foot or back pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 120.57,
      "end_seconds": 127.26,
      "duration_seconds": 6.69,
      "text": "Okay, so I haven't had fever, numbness in the foot or back pain, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.12,
      "end_seconds": 132.04,
      "duration_seconds": 2.92,
      "text": "And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.13,
      "end_seconds": 135.76,
      "duration_seconds": 2.63,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 144.51,
      "end_seconds": 148.44,
      "duration_seconds": 3.93,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 150.26,
      "end_seconds": 153.54,
      "duration_seconds": 3.28,
      "text": "I have migraines, for two years."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.23,
      "end_seconds": 158.03,
      "duration_seconds": 2.8,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.67,
      "end_seconds": 162.86,
      "duration_seconds": 3.19,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.34,
      "end_seconds": 167.31,
      "duration_seconds": 2.97,
      "text": "Alright, anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.32,
      "end_seconds": 172.55,
      "duration_seconds": 3.23,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.43,
      "end_seconds": 176.83,
      "duration_seconds": 2.4,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.09,
      "end_seconds": 183.34,
      "duration_seconds": 5.25,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 184.04,
      "end_seconds": 186.76,
      "duration_seconds": 2.72,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.31,
      "end_seconds": 203.05,
      "duration_seconds": 12.74,
      "text": "I had a cataract operation in my left eye about a year ago. I thought it would sort itself out, you know, but it hasn't."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 207.83,
      "end_seconds": 211.95,
      "duration_seconds": 4.12,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 213.23,
      "end_seconds": 217.96,
      "duration_seconds": 4.73,
      "text": "Right, it's propranolol, 40 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 228.69,
      "end_seconds": 234.37,
      "duration_seconds": 5.68,
      "text": "Before we go further, any allergies? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.45,
      "end_seconds": 238.1,
      "duration_seconds": 2.65,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.72,
      "end_seconds": 258.72,
      "duration_seconds": 11.0,
      "text": "Going by what you've described, this looks most like plantar fasciitis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 259.95,
      "end_seconds": 263.4,
      "duration_seconds": 3.45,
      "text": "Right, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.11,
      "end_seconds": 283.66,
      "duration_seconds": 18.55,
      "text": "I understand the worry. At the moment I'd say it's plantar fasciitis, and we'll know more once the a foot X-ray is back. Let me just check I've got this right. You've had pain in your heel for two years, and no fever or back pain."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 284.77,
      "end_seconds": 286.4,
      "duration_seconds": 1.63,
      "text": "Mm, that's right."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.1,
      "end_seconds": 312.96,
      "duration_seconds": 24.86,
      "text": "A foot X-ray is what I'd like next, for heel pain. I'll start you on ibuprofen gel, three times a day, for two weeks. That should help with heel pain. It's a commonly used medicine and most people tolerate it well. Stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.2,
      "end_seconds": 321.52,
      "duration_seconds": 8.32,
      "text": "I see, go ahead. See me again in six weeks. Alright, that's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.18,
      "end_seconds": 325.96,
      "duration_seconds": 3.78,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 327.45,
      "end_seconds": 328.72,
      "duration_seconds": 1.27,
      "text": "All the best."
    }
  ]
}