{
  "schema_version": "1.0",
  "encounter_id": "01183",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.07,
      "end_seconds": 5.09,
      "duration_seconds": 4.02,
      "text": "Morning, um, doctor. Lovely to meet you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.0,
      "end_seconds": 10.94,
      "duration_seconds": 3.94,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.97,
      "end_seconds": 16.9,
      "duration_seconds": 4.93,
      "text": "Mm, doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.53,
      "end_seconds": 20.84,
      "duration_seconds": 3.31,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.47,
      "end_seconds": 28.56,
      "duration_seconds": 7.09,
      "text": "It's a dry cough, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.7,
      "end_seconds": 33.21,
      "duration_seconds": 3.51,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.77,
      "end_seconds": 48.94,
      "duration_seconds": 14.17,
      "text": "About... well, two weeks. Sorry, I know I'm rambling a bit. I've also had loss of taste. I've also had a high temperature, for five days."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.74,
      "end_seconds": 56.88,
      "duration_seconds": 6.14,
      "text": "Have you had a dry cough before, or is this the first time?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.39,
      "end_seconds": 64.24,
      "duration_seconds": 6.85,
      "text": "A bit, a couple of years ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.23,
      "end_seconds": 84.42,
      "duration_seconds": 5.19,
      "text": "Let me check a few things. Any diarrhoea, leg swelling or chest pain?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.31,
      "end_seconds": 90.78,
      "duration_seconds": 5.47,
      "text": "I haven't had diarrhoea, leg swelling or chest pain, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.86,
      "end_seconds": 94.69,
      "duration_seconds": 2.83,
      "text": "Did you get vomiting or blue lips?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.56,
      "end_seconds": 98.01,
      "duration_seconds": 2.45,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.41,
      "end_seconds": 100.19,
      "duration_seconds": 1.78,
      "text": "Understood. Neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 100.82,
      "end_seconds": 102.29,
      "duration_seconds": 1.47,
      "text": "Nothing odd there."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 103.19,
      "end_seconds": 105.22,
      "duration_seconds": 2.03,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.48,
      "end_seconds": 111.56,
      "duration_seconds": 2.08,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 113.29,
      "end_seconds": 117.57,
      "duration_seconds": 4.28,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.73,
      "end_seconds": 121.37,
      "duration_seconds": 2.64,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.94,
      "end_seconds": 124.63,
      "duration_seconds": 1.69,
      "text": "Alright, any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 128.98,
      "end_seconds": 130.64,
      "duration_seconds": 1.66,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.35,
      "end_seconds": 140.81,
      "duration_seconds": 2.46,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 142.11,
      "end_seconds": 145.75,
      "duration_seconds": 3.64,
      "text": "Amlodipine, 5 milligrams, once a day."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.49,
      "end_seconds": 150.43,
      "duration_seconds": 2.94,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.76,
      "end_seconds": 156.71,
      "duration_seconds": 4.95,
      "text": "About nearly five years. I'm on sitagliptin, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.29,
      "end_seconds": 159.74,
      "duration_seconds": 2.45,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.55,
      "end_seconds": 165.57,
      "duration_seconds": 5.02,
      "text": "100 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.01,
      "end_seconds": 166.71,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.06,
      "end_seconds": 172.57,
      "duration_seconds": 4.51,
      "text": "I'm on Dolo, when I get the fever."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.94,
      "end_seconds": 177.89,
      "duration_seconds": 1.95,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.15,
      "end_seconds": 180.12,
      "duration_seconds": 0.97,
      "text": "650 milligrams."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.31,
      "end_seconds": 185.89,
      "duration_seconds": 2.58,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.35,
      "end_seconds": 189.5,
      "duration_seconds": 2.15,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.58,
      "end_seconds": 195.54,
      "duration_seconds": 3.96,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.39,
      "end_seconds": 202.98,
      "duration_seconds": 6.59,
      "text": "I, I have high blood pressure, for five years. I've had diabetes, yes."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.52,
      "end_seconds": 216.87,
      "duration_seconds": 10.35,
      "text": "Alright, high blood pressure and diabetes, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.25,
      "end_seconds": 233.59,
      "duration_seconds": 15.34,
      "text": "I retired from the post office two years ago. Not much, I mostly stay in these days. I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.62,
      "end_seconds": 238.63,
      "duration_seconds": 3.01,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.9,
      "end_seconds": 254.05,
      "duration_seconds": 3.15,
      "text": "Okay, that's it, just a little longer..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.69,
      "end_seconds": 277.75,
      "duration_seconds": 9.06,
      "text": "Okay: oxygen saturation is 94 percent, blood pressure 124 over 90. And temperature 36.9, pulse is 99 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.05,
      "end_seconds": 281.22,
      "duration_seconds": 2.17,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.11,
      "end_seconds": 285.07,
      "duration_seconds": 1.96,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.61,
      "end_seconds": 303.41,
      "duration_seconds": 8.8,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.18,
      "end_seconds": 311.51,
      "duration_seconds": 2.33,
      "text": "Right, all finished, thank you."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 325.17,
      "end_seconds": 336.41,
      "duration_seconds": 11.24,
      "text": "Okay, thinking it through, it fits best with a viral chest infection with mildly low oxygen. A viral swab is what I'd like next, for fever and cough."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.11,
      "end_seconds": 344.96,
      "duration_seconds": 2.85,
      "text": "Where would I go for that?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.46,
      "end_seconds": 369.75,
      "duration_seconds": 23.29,
      "text": "Rest, keep your fluids up and lie on your tummy or side to help your breathing. Don't skip meals, and try to eat smaller portions more often through the day. If it hasn't settled next month, we'd think about a chest X-ray, but not now. I'll want another look in two days."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.4,
      "end_seconds": 373.22,
      "duration_seconds": 1.82,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.5,
      "end_seconds": 377.21,
      "duration_seconds": 2.71,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 379.93,
      "end_seconds": 384.66,
      "duration_seconds": 4.73,
      "text": "Hmm, okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.82,
      "end_seconds": 387.27,
      "duration_seconds": 1.45,
      "text": "Goodbye for now."
    }
  ]
}