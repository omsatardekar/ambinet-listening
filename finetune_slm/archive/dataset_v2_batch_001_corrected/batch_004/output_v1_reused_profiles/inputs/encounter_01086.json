{
  "schema_version": "1.0",
  "encounter_id": "01086",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 1.3,
      "end_seconds": 6.04,
      "duration_seconds": 4.74,
      "text": "ready for you, doctor. I'll stay in case you need anything"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.06,
      "end_seconds": 12.92,
      "duration_seconds": 4.86,
      "text": "Great. Hello, come in and sit down. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 13.58,
      "end_seconds": 20.43,
      "duration_seconds": 6.85,
      "text": "Mainly a dry cough. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.92,
      "end_seconds": 35.13,
      "duration_seconds": 9.21,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 35.88,
      "end_seconds": 39.8,
      "duration_seconds": 3.92,
      "text": "I'd say on and off. It's severe, honestly."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.84,
      "end_seconds": 45.95,
      "duration_seconds": 4.11,
      "text": "What about aching all over, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 46.57,
      "end_seconds": 51.14,
      "duration_seconds": 4.57,
      "text": "Yes, I have. About aching all over, severe, really."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.72,
      "end_seconds": 56.07,
      "duration_seconds": 3.35,
      "text": "Have you noticed confusion or leg swelling?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 60.26,
      "end_seconds": 63.62,
      "duration_seconds": 3.36,
      "text": "No, um, not a single one."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.09,
      "end_seconds": 71.61,
      "duration_seconds": 3.52,
      "text": "have you noticed chest pain or blue lips?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 73.16,
      "end_seconds": 76.06,
      "duration_seconds": 2.9,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.06,
      "end_seconds": 79.22,
      "duration_seconds": 2.16,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 81.18,
      "end_seconds": 84.09,
      "duration_seconds": 2.91,
      "text": "Nothing unusual, you know, no."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.38,
      "end_seconds": 106.03,
      "duration_seconds": 5.65,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 107.68,
      "end_seconds": 128.86,
      "duration_seconds": 21.18,
      "text": "I smoke roughly a pack every two days. I used to drink heavily but I stopped four years ago. I retired from the post office two years ago. Lots of rice, lentils and some fruit. My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.02,
      "end_seconds": 148.96,
      "duration_seconds": 2.94,
      "text": "Alright, tell me your medicines, please."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 149.65,
      "end_seconds": 170.7,
      "duration_seconds": 21.05,
      "text": "It's metformin, 500 milligrams, twice a day for my sugar. I take hydrochlorothiazide, 12.5 milligrams, every morning. My sister suggested writing things down, but I forgot. Before this I was on glibenclamide; that's been stopped."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.75,
      "end_seconds": 186.88,
      "duration_seconds": 3.13,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 188.48,
      "end_seconds": 189.97,
      "duration_seconds": 1.49,
      "text": "I have diabetes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.01,
      "end_seconds": 193.4,
      "duration_seconds": 1.39,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 194.4,
      "end_seconds": 196.48,
      "duration_seconds": 2.08,
      "text": "Yes, high blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.76,
      "end_seconds": 205.34,
      "duration_seconds": 7.58,
      "text": "Alright, diabetes and high blood pressure, that matches what I have here. Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 206.86,
      "end_seconds": 218.98,
      "duration_seconds": 12.12,
      "text": "Yes, I had a cataract operation in my left eye, about a year ago. It's a relief to finally sit down and talk about it."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 219.91,
      "end_seconds": 224.58,
      "duration_seconds": 4.67,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 225.28,
      "end_seconds": 229.22,
      "duration_seconds": 3.94,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "NURSE",
      "start_seconds": 231.23,
      "end_seconds": 248.52,
      "duration_seconds": 17.29,
      "text": "Okay, so the vitals from earlier. BMI works out to 28.8, pulse is 99 beats a minute, weight 71 kilos, respiratory rate 23, height 157 centimetres, temperature is 37.6 degrees, oxygen saturation is 89 percent, blood pressure 126 over 83."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.2,
      "end_seconds": 250.68,
      "duration_seconds": 1.48,
      "text": "good, thank you"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.89,
      "end_seconds": 256.32,
      "duration_seconds": 4.43,
      "text": "okay, now I'm gonna do a a short physical check"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 258.21,
      "end_seconds": 259.78,
      "duration_seconds": 1.57,
      "text": "yeah, no problem"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 260.75,
      "end_seconds": 262.12,
      "duration_seconds": 1.37,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.73,
      "end_seconds": 289.48,
      "duration_seconds": 9.75,
      "text": "Your chest is clear apart from a few crackles at the right base and your oxygen level is a bit low."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.57,
      "end_seconds": 323.44,
      "duration_seconds": 28.87,
      "text": "please sit back down so, based on the the history and the examination, this looks most like a viral chest infection with mildly low oxygen i'll request a chest X-ray, it'll help with low oxygen and crackles rest, keep your fluids up and lie on your tummy or side to help your breathing have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 324.62,
      "end_seconds": 329.63,
      "duration_seconds": 5.01,
      "text": "Uh, okay, that makes sense. Thanks for explaining."
    }
  ]
}