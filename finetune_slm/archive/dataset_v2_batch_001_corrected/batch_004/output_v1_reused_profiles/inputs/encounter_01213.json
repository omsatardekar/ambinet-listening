{
  "schema_version": "1.0",
  "encounter_id": "01213",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.97,
      "end_seconds": 4.17,
      "duration_seconds": 3.2,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.41,
      "end_seconds": 10.34,
      "duration_seconds": 4.93,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.31,
      "end_seconds": 18.29,
      "duration_seconds": 6.98,
      "text": "Doctor, you know, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.94,
      "end_seconds": 24.36,
      "duration_seconds": 4.42,
      "text": "Right, yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.89,
      "end_seconds": 29.13,
      "duration_seconds": 3.24,
      "text": "Erm, we came because of a blister."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.26,
      "end_seconds": 38.21,
      "duration_seconds": 2.95,
      "text": "Is there any regular medication you use?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.67,
      "end_seconds": 41.21,
      "duration_seconds": 1.54,
      "text": "Nothing regular, no."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.49,
      "end_seconds": 44.35,
      "duration_seconds": 1.86,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 45.76,
      "end_seconds": 55.47,
      "duration_seconds": 9.71,
      "text": "Hm. It was either the end of last month or earlier than that. I couldn't tell you the date."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.12,
      "end_seconds": 59.57,
      "duration_seconds": 3.45,
      "text": "Has there been being worried about scarring too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.04,
      "end_seconds": 66.73,
      "duration_seconds": 5.69,
      "text": "Yes, for about a week. There's a stinging pain as well."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 67.64,
      "end_seconds": 72.34,
      "duration_seconds": 4.7,
      "text": "Have you had burn on the face, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 73.72,
      "end_seconds": 76.99,
      "duration_seconds": 3.27,
      "text": "Nope, no burn on the face."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.76,
      "end_seconds": 83.73,
      "duration_seconds": 5.97,
      "text": "Let me check a few things. Any chemical exposure, numbness at the burn or pus?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.58,
      "end_seconds": 91.73,
      "duration_seconds": 6.15,
      "text": "No chemical exposure, numbness at the burn or pus, none of it."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.26,
      "end_seconds": 96.04,
      "duration_seconds": 3.78,
      "text": "Anything with your heart, like skipped beats or fainting?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.83,
      "end_seconds": 99.92,
      "duration_seconds": 2.09,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.64,
      "end_seconds": 104.86,
      "duration_seconds": 4.22,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 106.56,
      "end_seconds": 108.67,
      "duration_seconds": 2.11,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.46,
      "end_seconds": 113.2,
      "duration_seconds": 3.74,
      "text": "Any medical conditions, anything you've been treated for?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.17,
      "end_seconds": 115.76,
      "duration_seconds": 1.59,
      "text": "No, no conditions."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.49,
      "end_seconds": 117.83,
      "duration_seconds": 1.34,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.47,
      "end_seconds": 121.51,
      "duration_seconds": 3.04,
      "text": "Nothing, I haven't had any operations."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.55,
      "end_seconds": 127.58,
      "duration_seconds": 4.03,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.35,
      "end_seconds": 132.82,
      "duration_seconds": 3.47,
      "text": "Mm, my father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.59,
      "end_seconds": 137.96,
      "duration_seconds": 3.37,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.09,
      "end_seconds": 156.22,
      "duration_seconds": 17.13,
      "text": "I have about eight cigarettes in a day. I only drink at family occasions. I walk the dog every morning. Yes, I work in a bakery, early starts. I live with my elderly mother."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.12,
      "end_seconds": 168.86,
      "duration_seconds": 4.74,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.29,
      "end_seconds": 173.31,
      "duration_seconds": 3.02,
      "text": "Erm, not to my knowledge, no."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.74,
      "end_seconds": 180.65,
      "duration_seconds": 2.91,
      "text": "Time for your numbers, if that's okay."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.2,
      "end_seconds": 195.53,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.25,
      "end_seconds": 224.81,
      "duration_seconds": 8.56,
      "text": "Okay: temperature 36.8, pulse is 75 beats a minute, BP is 118 over 79, oxygen saturation is 99 percent."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 227.61,
      "end_seconds": 232.03,
      "duration_seconds": 4.42,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.48,
      "end_seconds": 235.54,
      "duration_seconds": 2.06,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.55,
      "end_seconds": 253.8,
      "duration_seconds": 10.25,
      "text": "There is a five-centimetre area of redness with an intact blister on the left forearm, and it blanches and is painful."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.49,
      "end_seconds": 259.36,
      "duration_seconds": 1.87,
      "text": "Please sit back down."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.66,
      "end_seconds": 286.68,
      "duration_seconds": 10.02,
      "text": "Taking everything into account, I think we're dealing with a superficial partial-thickness burn at this stage. A scald with infection risk is still possible."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.46,
      "end_seconds": 303.49,
      "duration_seconds": 8.03,
      "text": "Let's use paracetamol, 1 gram, every six hours if needed, for three days. That's for burn pain."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 305.51,
      "end_seconds": 307.12,
      "duration_seconds": 1.61,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.74,
      "end_seconds": 324.94,
      "duration_seconds": 16.2,
      "text": "Cool the area under running water for twenty minutes and cover it with a non-stick dressing, and leave the blister alone. One warning sign to remember: the burn becomes smelly, spreads or you get a fever. In that case don't wait."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 326.44,
      "end_seconds": 329.8,
      "duration_seconds": 3.36,
      "text": "Okay, I'll look out for that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.53,
      "end_seconds": 335.71,
      "duration_seconds": 5.18,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 336.59,
      "end_seconds": 341.37,
      "duration_seconds": 4.78,
      "text": "Mm, okay, that makes sense. Thanks for explaining."
    }
  ]
}