{
  "schema_version": "1.0",
  "encounter_id": "01414",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.2,
      "end_seconds": 3.16,
      "duration_seconds": 1.96,
      "text": "Welcome. Make yourself comfortable."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.15,
      "end_seconds": 7.2,
      "duration_seconds": 2.05,
      "text": "Evening, you know, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 8.77,
      "end_seconds": 10.63,
      "duration_seconds": 1.86,
      "text": "Alright, was parking alright?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.54,
      "end_seconds": 15.8,
      "duration_seconds": 4.26,
      "text": "Not great, I ended up a few streets away."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.67,
      "end_seconds": 18.45,
      "duration_seconds": 1.78,
      "text": "Where shall we begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 20.16,
      "end_seconds": 23.15,
      "duration_seconds": 2.99,
      "text": "It's tingling in my feet, mostly."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.73,
      "end_seconds": 27.08,
      "duration_seconds": 2.35,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.59,
      "end_seconds": 30.6,
      "duration_seconds": 2.01,
      "text": "About... well, four weeks."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.03,
      "end_seconds": 33.8,
      "duration_seconds": 2.77,
      "text": "Understood. Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 35.47,
      "end_seconds": 50.48,
      "duration_seconds": 15.01,
      "text": "It, It comes and goes. As for cramps in my calves at night, I honestly can't say when that began. It might have been last month or the month before."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.17,
      "end_seconds": 61.26,
      "duration_seconds": 7.09,
      "text": "Did you get back pain, redness of the leg, chest pain or shortness of breath?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.82,
      "end_seconds": 65.38,
      "duration_seconds": 2.56,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 67.04,
      "end_seconds": 69.04,
      "duration_seconds": 2.0,
      "text": "Any trouble with the waterworks?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 70.14,
      "end_seconds": 71.76,
      "duration_seconds": 1.62,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.83,
      "end_seconds": 76.19,
      "duration_seconds": 2.36,
      "text": "Is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.29,
      "end_seconds": 79.89,
      "duration_seconds": 1.6,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 96.6,
      "end_seconds": 99.8,
      "duration_seconds": 3.2,
      "text": "Do you take any prescribed or over-the-counter medicines?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 101.31,
      "end_seconds": 108.95,
      "duration_seconds": 7.64,
      "text": "It's hydrochlorothiazide, 12.5 milligrams, every morning. I take magnesium tablets, at night."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 110.42,
      "end_seconds": 113.37,
      "duration_seconds": 2.95,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.28,
      "end_seconds": 122.74,
      "duration_seconds": 4.46,
      "text": "I have high blood pressure, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 124.35,
      "end_seconds": 133.08,
      "duration_seconds": 8.73,
      "text": "Alright, high blood pressure, that matches what I have here. Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.4,
      "end_seconds": 147.62,
      "duration_seconds": 13.22,
      "text": "I'm a bus driver, so I sit for long hours. I'm vegetarian and have been for years. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 166.17,
      "end_seconds": 168.64,
      "duration_seconds": 2.47,
      "text": "Have you been to theatre before?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.96,
      "end_seconds": 175.11,
      "duration_seconds": 5.15,
      "text": "I had a caesarean for my second baby nine years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.5,
      "end_seconds": 181.45,
      "duration_seconds": 4.95,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 182.57,
      "end_seconds": 184.73,
      "duration_seconds": 2.16,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 188.48,
      "end_seconds": 197.58,
      "duration_seconds": 9.1,
      "text": "Okay, so the vitals from earlier. SpO2 98 percent on room air, blood pressure 113 over 78, heart rate 84. Temp 36.9 degrees."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 199.66,
      "end_seconds": 200.99,
      "duration_seconds": 1.33,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 202.56,
      "end_seconds": 206.08,
      "duration_seconds": 3.52,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.42,
      "end_seconds": 208.43,
      "duration_seconds": 1.01,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.23,
      "end_seconds": 211.72,
      "duration_seconds": 2.49,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.22,
      "end_seconds": 229.5,
      "duration_seconds": 7.28,
      "text": "Both calves are soft and not tender, and the pulses at your feet are good."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.01,
      "end_seconds": 231.09,
      "duration_seconds": 1.08,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.14,
      "end_seconds": 253.79,
      "duration_seconds": 17.65,
      "text": "Okay, that's enough for me. From what you've told me and what I found, I think we're dealing with night-time muscle cramps without a worrying cause at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 258.45,
      "end_seconds": 260.34,
      "duration_seconds": 1.89,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.35,
      "end_seconds": 270.94,
      "duration_seconds": 9.59,
      "text": "Nothing I've seen today points to an emergency. It looks like night-time muscle cramps without a worrying cause, but I'd like to confirm."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 286.09,
      "end_seconds": 307.63,
      "duration_seconds": 21.54,
      "text": "I'm going to order a blood sugar test, for tingling feet. I'm going to order a vitamin level, for tingling feet. Gentle calf stretches against a wall before bed often help. Book a review in four weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 309.34,
      "end_seconds": 311.41,
      "duration_seconds": 2.07,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}