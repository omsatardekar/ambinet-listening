{
  "schema_version": "1.0",
  "encounter_id": "01445",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.16,
      "end_seconds": 5.24,
      "duration_seconds": 4.08,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.86,
      "end_seconds": 9.6,
      "duration_seconds": 3.74,
      "text": "Of course, leave it there. How can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.61,
      "end_seconds": 16.79,
      "duration_seconds": 6.18,
      "text": "Mainly I've been clearing my throat all the time. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 18.82,
      "end_seconds": 23.19,
      "duration_seconds": 4.37,
      "text": "How many days or weeks has it it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 25.07,
      "end_seconds": 27.03,
      "duration_seconds": 1.96,
      "text": "probably four weeks. Yeah"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.19,
      "end_seconds": 31.42,
      "duration_seconds": 3.23,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 32.12,
      "end_seconds": 34.85,
      "duration_seconds": 2.73,
      "text": "About a seven out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.56,
      "end_seconds": 39.38,
      "duration_seconds": 2.82,
      "text": "Have you had any shortness of breath?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.07,
      "end_seconds": 43.84,
      "duration_seconds": 2.77,
      "text": "No, no shortness of breath."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 45.69,
      "end_seconds": 48.7,
      "duration_seconds": 3.01,
      "text": "And what about trouble swallowing or wheezing?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.76,
      "end_seconds": 52.25,
      "duration_seconds": 2.49,
      "text": "No, I'd have said so."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.34,
      "end_seconds": 56.69,
      "duration_seconds": 2.35,
      "text": "Anything unusual with passing urine?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.32,
      "end_seconds": 59.9,
      "duration_seconds": 1.58,
      "text": "No changes there."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.98,
      "end_seconds": 64.75,
      "duration_seconds": 3.77,
      "text": "Right, anything on the skin I should know about?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.49,
      "end_seconds": 67.48,
      "duration_seconds": 0.99,
      "text": "skin's normal"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.8,
      "end_seconds": 80.26,
      "duration_seconds": 2.46,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.58,
      "end_seconds": 89.48,
      "duration_seconds": 7.9,
      "text": "I have acid reflux. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.14,
      "end_seconds": 93.59,
      "duration_seconds": 2.45,
      "text": "now some background about your lifestyle"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.42,
      "end_seconds": 104.88,
      "duration_seconds": 10.46,
      "text": "I swim twice a week. I drink a lot of tea and snack through the day. My partner and our baby."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.96,
      "end_seconds": 119.45,
      "duration_seconds": 3.49,
      "text": "So, are you on any regular medication?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.43,
      "end_seconds": 121.6,
      "duration_seconds": 1.17,
      "text": "No, none."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.01,
      "end_seconds": 136.47,
      "duration_seconds": 7.46,
      "text": "Are there any allergies I should be aware of? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.06,
      "end_seconds": 142.28,
      "duration_seconds": 4.22,
      "text": "Milk. I come out in... well, a rash."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.13,
      "end_seconds": 148.07,
      "duration_seconds": 3.94,
      "text": "shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.6,
      "end_seconds": 157.44,
      "duration_seconds": 2.84,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.46,
      "end_seconds": 186.25,
      "duration_seconds": 9.79,
      "text": "Okay: saturation 98 percent, respiratory rate 17, heart rate 71. And temp 36.8 degrees, blood pressure 128 over 68."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.47,
      "end_seconds": 188.96,
      "duration_seconds": 1.49,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.64,
      "end_seconds": 192.6,
      "duration_seconds": 2.96,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.8,
      "end_seconds": 197.82,
      "duration_seconds": 3.02,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.92,
      "end_seconds": 200.7,
      "duration_seconds": 1.78,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.07,
      "end_seconds": 204.24,
      "duration_seconds": 2.17,
      "text": "I'm just checking this side"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.28,
      "end_seconds": 218.63,
      "duration_seconds": 5.35,
      "text": "Chest is clear and the throat looks a little red at the back."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 221.15,
      "end_seconds": 232.39,
      "duration_seconds": 11.24,
      "text": "that's all I needed to check. So where does that leave us? The most likely explanation is a cough driven by acid reflux"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.91,
      "end_seconds": 275.45,
      "duration_seconds": 30.54,
      "text": "Let's get a chest X-ray, for chronic cough. We should do breathing tests for chronic cough. The result will help us decide whether anything more is needed. I'll start you on pantoprazole, 40 milligrams, before breakfast, for four weeks. That's for reflux. Don't eat for two or three hours before lying down, and raise the the head of the bed a little. Please come and see me in a month."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.05,
      "end_seconds": 286.58,
      "duration_seconds": 5.53,
      "text": "alright, before we finish, can you repeat the plan back to me?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.08,
      "end_seconds": 297.38,
      "duration_seconds": 9.3,
      "text": "So, I take the pantoprazole, 40 milligrams, before breakfast and come back in a month. Is that right?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 298.99,
      "end_seconds": 304.62,
      "duration_seconds": 5.63,
      "text": "Okay, yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 306.39,
      "end_seconds": 308.52,
      "duration_seconds": 2.13,
      "text": "Alright, thanks, take care."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.87,
      "end_seconds": 314.22,
      "duration_seconds": 1.35,
      "text": "See you soon."
    }
  ]
}