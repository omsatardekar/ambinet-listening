{
  "schema_version": "1.0",
  "encounter_id": "01206",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.75,
      "end_seconds": 5.07,
      "duration_seconds": 4.32,
      "text": "hi, doctor, I hope I'm not disturbing you"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.69,
      "end_seconds": 10.28,
      "duration_seconds": 3.59,
      "text": "come in please sit how can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.99,
      "end_seconds": 13.74,
      "duration_seconds": 2.75,
      "text": "it's pain in my heel mostly"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.25,
      "end_seconds": 20.46,
      "duration_seconds": 3.21,
      "text": "how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 22.32,
      "end_seconds": 26.07,
      "duration_seconds": 3.75,
      "text": "I've had it for nearly five years."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.66,
      "end_seconds": 36.17,
      "duration_seconds": 9.51,
      "text": "mm-hmm. Tell me a bit more about it: how bad it gets how often and whether anything makes it better or worse"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.16,
      "end_seconds": 55.85,
      "duration_seconds": 18.69,
      "text": "Maybe a six out of ten on a bad day. I'd say a couple of times a week. I get some relief from resting. And a tight calf too. And pain after exercise too."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.53,
      "end_seconds": 58.26,
      "duration_seconds": 1.73,
      "text": "what brings it on?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.64,
      "end_seconds": 62.73,
      "duration_seconds": 3.09,
      "text": "I notice it more with running"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.99,
      "end_seconds": 70.38,
      "duration_seconds": 6.39,
      "text": "have you had pain in your heel before, or is this the first time?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.33,
      "end_seconds": 76.79,
      "duration_seconds": 5.46,
      "text": "a bit, last winter. It settled by itself back then"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.88,
      "end_seconds": 81.35,
      "duration_seconds": 2.47,
      "text": "let me take your readings now"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.39,
      "end_seconds": 91.37,
      "duration_seconds": 2.98,
      "text": "okay, nearly done with the readings.."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.88,
      "end_seconds": 118.99,
      "duration_seconds": 16.11,
      "text": "Okay: blood pressure 116 over 78, temperature is 36.6 degrees, BMI works out to 20.0. And height 179 centimetres, pulse is 74 beats a minute, SpO2 99 percent on room air, respiratory rate 15, weight 64 kilos."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 120.32,
      "end_seconds": 123.97,
      "duration_seconds": 3.65,
      "text": "now I'm going to do a short physical check"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.5,
      "end_seconds": 125.99,
      "duration_seconds": 1.49,
      "text": "fine by me"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.51,
      "end_seconds": 129.44,
      "duration_seconds": 1.93,
      "text": "does that that hurt?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.02,
      "end_seconds": 151.63,
      "duration_seconds": 8.61,
      "text": "there is a sore spot at the inner front of the heel bone and pulling the toes back makes it worse"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 156.26,
      "end_seconds": 157.89,
      "duration_seconds": 1.63,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.86,
      "end_seconds": 165.74,
      "duration_seconds": 2.88,
      "text": "that's all I needed to check"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.83,
      "end_seconds": 186.81,
      "duration_seconds": 2.98,
      "text": "right, any sign of joint pain elsewhere?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.57,
      "end_seconds": 189.88,
      "duration_seconds": 2.31,
      "text": "definitely no joint pain elsewhere"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.27,
      "end_seconds": 197.19,
      "duration_seconds": 5.92,
      "text": "and and what about numbness in the foot, back pain or swelling?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.73,
      "end_seconds": 203.66,
      "duration_seconds": 5.93,
      "text": "No numbness in the foot back pain or swelling none of it."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 205.51,
      "end_seconds": 208.88,
      "duration_seconds": 3.37,
      "text": "And And your skin, any changes there?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.77,
      "end_seconds": 215.15,
      "duration_seconds": 3.38,
      "text": "Nothing on the the skin no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.44,
      "end_seconds": 218.96,
      "duration_seconds": 2.52,
      "text": "any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.59,
      "end_seconds": 222.17,
      "duration_seconds": 2.58,
      "text": "no, my breathing's been fine"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.26,
      "end_seconds": 224.57,
      "duration_seconds": 1.31,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.51,
      "end_seconds": 229.83,
      "duration_seconds": 4.32,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.7,
      "end_seconds": 233.16,
      "duration_seconds": 1.46,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 235.17,
      "end_seconds": 239.04,
      "duration_seconds": 3.87,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.03,
      "end_seconds": 242.41,
      "duration_seconds": 1.38,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 244.13,
      "end_seconds": 247.53,
      "duration_seconds": 3.4,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.43,
      "end_seconds": 251.38,
      "duration_seconds": 1.95,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.19,
      "end_seconds": 258.38,
      "duration_seconds": 6.19,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.11,
      "end_seconds": 280.09,
      "duration_seconds": 2.98,
      "text": "alright, do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 281.35,
      "end_seconds": 285.76,
      "duration_seconds": 4.41,
      "text": "Yes, depression. I've had arthritis in my knees, yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 287.45,
      "end_seconds": 289.34,
      "duration_seconds": 1.89,
      "text": "is there anything more?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.82,
      "end_seconds": 299.64,
      "duration_seconds": 8.82,
      "text": "right so depression and arthritis in your knees are already on your record. We'll keep that in mind today"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 309.87,
      "end_seconds": 312.6,
      "duration_seconds": 2.73,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 314.06,
      "end_seconds": 329.44,
      "duration_seconds": 15.38,
      "text": "Fluoxetine. I take it 20 milligrams, every morning for my mood. Diclofenac. I take it 50 milligrams, when needed for the joint pain. It's insoles, every day."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.2,
      "end_seconds": 334.38,
      "duration_seconds": 4.18,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 335.04,
      "end_seconds": 337.36,
      "duration_seconds": 2.32,
      "text": "My aunt has rheumatoid arthritis."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.47,
      "end_seconds": 344.81,
      "duration_seconds": 6.34,
      "text": "taking everything into account, I think we're dealing with plantar fasciitis at this stage"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 346.81,
      "end_seconds": 350.67,
      "duration_seconds": 3.86,
      "text": "mm, what are the the odds it's serious?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 351.3,
      "end_seconds": 365.08,
      "duration_seconds": 13.78,
      "text": "I understand the worry. At the moment I'd say it's plantar fasciitis, and we'll know more once the a foot X-ray is back. I'd like to arrange a foot X-ray for heel pain."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 365.93,
      "end_seconds": 368.65,
      "duration_seconds": 2.72,
      "text": "the earliest is Tuesday 9 am"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 369.19,
      "end_seconds": 382.6,
      "duration_seconds": 13.41,
      "text": "stretch the calf and the sole of the foot before getting out of bed and wear cushioned shoes we'll refer you to podiatry do get help quickly if the symptoms get worse"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 384.05,
      "end_seconds": 385.96,
      "duration_seconds": 1.91,
      "text": "That's fine by me."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 387.82,
      "end_seconds": 390.11,
      "duration_seconds": 2.29,
      "text": "come back in six weeks"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 390.8,
      "end_seconds": 392.9,
      "duration_seconds": 2.1,
      "text": "alright, I'll be back"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.76,
      "end_seconds": 399.77,
      "duration_seconds": 4.01,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 400.94,
      "end_seconds": 405.06,
      "duration_seconds": 4.12,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 406.53,
      "end_seconds": 407.99,
