{
  "schema_version": "1.0",
  "encounter_id": "01310",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.95,
      "end_seconds": 4.48,
      "duration_seconds": 3.53,
      "text": "Hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.48,
      "end_seconds": 10.42,
      "duration_seconds": 4.94,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.47,
      "end_seconds": 18.45,
      "duration_seconds": 6.98,
      "text": "Honestly, it's numbness in my fingers, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.43,
      "end_seconds": 22.71,
      "duration_seconds": 1.28,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.45,
      "end_seconds": 28.51,
      "duration_seconds": 4.06,
      "text": "It's been going on for about a month."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.9,
      "end_seconds": 36.26,
      "duration_seconds": 3.36,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 37.95,
      "end_seconds": 39.51,
      "duration_seconds": 1.56,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 40.97,
      "end_seconds": 48.45,
      "duration_seconds": 7.48,
      "text": "Did you get swelling of the wrist, injury to the wrist or weakness in the legs?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.82,
      "end_seconds": 58.09,
      "duration_seconds": 4.27,
      "text": "Erm, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.43,
      "end_seconds": 61.03,
      "duration_seconds": 1.6,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.79,
      "end_seconds": 64.26,
      "duration_seconds": 1.47,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.53,
      "end_seconds": 70.06,
      "duration_seconds": 4.53,
      "text": "Okay, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.61,
      "end_seconds": 74.55,
      "duration_seconds": 3.94,
      "text": "Bowels are regular, you know, nothing odd."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.71,
      "end_seconds": 77.36,
      "duration_seconds": 1.65,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.17,
      "end_seconds": 81.44,
      "duration_seconds": 2.27,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.85,
      "end_seconds": 88.82,
      "duration_seconds": 2.97,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.8,
      "end_seconds": 99.89,
      "duration_seconds": 5.09,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.74,
      "end_seconds": 117.24,
      "duration_seconds": 8.5,
      "text": "Anything in your past medical history I should know? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.93,
      "end_seconds": 133.33,
      "duration_seconds": 15.4,
      "text": "I've had diabetes for five years now. I looked a few things up online, and that probably didn't help. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 140.54,
      "end_seconds": 143.53,
      "duration_seconds": 2.99,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 145.43,
      "end_seconds": 146.93,
      "duration_seconds": 1.5,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.69,
      "end_seconds": 150.32,
      "duration_seconds": 2.63,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.07,
      "end_seconds": 161.88,
      "duration_seconds": 9.81,
      "text": "Hmm, years back I got a rash all over from amoxicillin, so I stay away from it now."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.67,
      "end_seconds": 166.18,
      "duration_seconds": 2.51,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.39,
      "end_seconds": 171.6,
      "duration_seconds": 4.21,
      "text": "I take metformin, 500 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.64,
      "end_seconds": 186.4,
      "duration_seconds": 2.76,
      "text": "Let me quickly check your readings."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.27,
      "end_seconds": 195.83,
      "duration_seconds": 2.56,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.84,
      "end_seconds": 222.76,
      "duration_seconds": 13.92,
      "text": "Okay: pulse is 80 beats a minute, temp 36.6 degrees. And saturation 99 percent, height 165 centimetres, respiratory rate 14, BP is 110 over 81, weight 95 kilos."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.82,
      "end_seconds": 228.85,
      "duration_seconds": 4.03,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.66,
      "end_seconds": 232.94,
      "duration_seconds": 2.28,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.79,
      "end_seconds": 250.84,
      "duration_seconds": 9.05,
      "text": "Tapping over the wrist brings on the tingling, and the muscle at the base of the thumb looks slightly thin."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.32,
      "end_seconds": 255.36,
      "duration_seconds": 2.04,
      "text": "All finished, thank you."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.04,
      "end_seconds": 299.83,
      "duration_seconds": 28.79,
      "text": "So, based on the history and the examination, the most likely explanation is carpal tunnel syndrome. I want to be honest that this is an impression, not a final answer. Nerve conduction tests is what I'd like next, for hand numbness. A wrist splint at night will often settle it. Come back in six weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 300.96,
      "end_seconds": 303.64,
      "duration_seconds": 2.68,
      "text": "Right, thank you, doctor, goodbye."
    }
  ]
}