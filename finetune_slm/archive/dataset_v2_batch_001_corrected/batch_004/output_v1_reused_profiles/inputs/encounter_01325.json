{
  "schema_version": "1.0",
  "encounter_id": "01325",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.59,
      "end_seconds": 3.5,
      "duration_seconds": 2.91,
      "text": "Hello, good to see you. Please sit."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.77,
      "end_seconds": 10.25,
      "duration_seconds": 5.48,
      "text": "Doctor, I'll sit in if that's okay, I know what's been happening."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.98,
      "end_seconds": 16.18,
      "duration_seconds": 5.2,
      "text": "Good, that'll be useful. Pull up a chair. Busy day out there?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 19.6,
      "end_seconds": 23.33,
      "duration_seconds": 3.73,
      "text": "Always is. The traffic coming in was terrible."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 24.51,
      "end_seconds": 27.64,
      "duration_seconds": 3.13,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 28.68,
      "end_seconds": 35.2,
      "duration_seconds": 6.52,
      "text": "Doctor, it's some chest discomfort when I climb stairs. That's what we're worried about."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.44,
      "end_seconds": 44.35,
      "duration_seconds": 7.91,
      "text": "Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 45.83,
      "end_seconds": 55.93,
      "duration_seconds": 10.1,
      "text": "I'd call it mild. I notice it more with stairs. I've had bruising easily too, for two months."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 61.07,
      "end_seconds": 64.39,
      "duration_seconds": 3.32,
      "text": "Any breathlessness or blood in the urine?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 65.75,
      "end_seconds": 70.93,
      "duration_seconds": 5.18,
      "text": "Ah, no, no breathlessness or blood in the urine."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 71.63,
      "end_seconds": 77.93,
      "duration_seconds": 6.3,
      "text": "Let me check a few things. Any black stools, palpitations or pain at rest?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 79.81,
      "end_seconds": 84.89,
      "duration_seconds": 5.08,
      "text": "No, no black stools, palpitations or pain at rest."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.4,
      "end_seconds": 89.85,
      "duration_seconds": 3.45,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 91.55,
      "end_seconds": 93.12,
      "duration_seconds": 1.57,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.54,
      "end_seconds": 97.96,
      "duration_seconds": 3.42,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 102.11,
      "end_seconds": 109.89,
      "duration_seconds": 7.78,
      "text": "She is on clopidogrel, 75 milligrams, once a day, I give it to her."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.8,
      "end_seconds": 114.34,
      "duration_seconds": 2.54,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 114.94,
      "end_seconds": 134.15,
      "duration_seconds": 19.21,
      "text": "I have about eight cigarettes in a day. I used to drink heavily but I stopped four years ago. I swim twice a week. My husband and I live above the shop. I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 139.24,
      "end_seconds": 141.81,
      "duration_seconds": 2.57,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 143.59,
      "end_seconds": 156.08,
      "duration_seconds": 12.49,
      "text": "I have heart disease, for nearly five years. I've never really been one for hospitals. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 158.16,
      "end_seconds": 161.17,
      "duration_seconds": 3.01,
      "text": "So, have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 162.19,
      "end_seconds": 164.44,
      "duration_seconds": 2.25,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.67,
      "end_seconds": 184.11,
      "duration_seconds": 2.44,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.49,
      "end_seconds": 199.53,
      "duration_seconds": 2.04,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 210.22,
      "end_seconds": 215.95,
      "duration_seconds": 5.73,
      "text": "Okay: SpO2 99 percent on room air, pressure 118 over 78, pulse 82."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 217.92,
      "end_seconds": 220.48,
      "duration_seconds": 2.56,
      "text": "Right, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 224.63,
      "end_seconds": 227.61,
      "duration_seconds": 2.98,
      "text": "Alright, that's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 229.61,
      "end_seconds": 231.75,
      "duration_seconds": 2.14,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 232.93,
      "end_seconds": 236.28,
      "duration_seconds": 3.35,
      "text": "Right, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 244.01,
      "end_seconds": 247.86,
      "duration_seconds": 3.85,
      "text": "There are a few small bruises on your forearms."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.8,
      "end_seconds": 251.31,
      "duration_seconds": 2.51,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.41,
      "end_seconds": 268.04,
      "duration_seconds": 3.63,
      "text": "Heart sounds are normal and your chest is clear."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.42,
      "end_seconds": 274.51,
      "duration_seconds": 3.09,
      "text": "Alright, that's all I needed to check."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 284.37,
      "end_seconds": 298.41,
      "duration_seconds": 14.04,
      "text": "Let me tell you where I've got to. My working impression is stable coronary disease on antiplatelet treatment, with minor bleeding. Reflux from the tablets is also on my list."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 316.28,
      "end_seconds": 326.54,
      "duration_seconds": 10.26,
      "text": "Take your blood-thinning tablets after food and do not stop them on your own. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 328.21,
      "end_seconds": 330.16,
      "duration_seconds": 1.95,
      "text": "Thank you, that's helpful."
    }
  ]
}