{
  "schema_version": "1.0",
  "encounter_id": "01261",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.82,
      "end_seconds": 3.64,
      "duration_seconds": 2.82,
      "text": "Hi doctor, am I too early?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.33,
      "end_seconds": 8.45,
      "duration_seconds": 4.12,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 14.19,
      "end_seconds": 23.9,
      "duration_seconds": 9.71,
      "text": "Good afternoon, doctor. I look after them so I thought I'd come. He's been having pain in my lower back, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.88,
      "end_seconds": 26.84,
      "duration_seconds": 1.96,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.7,
      "end_seconds": 32.94,
      "duration_seconds": 4.24,
      "text": "Uh, it's been like this since last Tuesday."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.33,
      "end_seconds": 42.35,
      "duration_seconds": 4.02,
      "text": "Okay, would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.75,
      "end_seconds": 45.51,
      "duration_seconds": 1.76,
      "text": "Severe, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.34,
      "end_seconds": 55.77,
      "duration_seconds": 9.43,
      "text": "So, uh, and the other thing I wanted to mention is that I can't really—"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 55.87,
      "end_seconds": 61.4,
      "duration_seconds": 5.53,
      "text": "Tell the doctor about the other thing, that's what worries me."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.45,
      "end_seconds": 67.64,
      "duration_seconds": 5.19,
      "text": "I was getting to that! I've also had stiffness, since Monday."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.72,
      "end_seconds": 87.11,
      "duration_seconds": 2.39,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.16,
      "end_seconds": 93.28,
      "duration_seconds": 4.12,
      "text": "I had my tonsils removed as a teenager."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.05,
      "end_seconds": 100.27,
      "duration_seconds": 3.22,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.35,
      "end_seconds": 110.31,
      "duration_seconds": 7.96,
      "text": "It's a... um, uh, I can't remember what it's called. It's a small white one."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.88,
      "end_seconds": 114.39,
      "duration_seconds": 3.51,
      "text": "Right, do you remember what it's for?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.22,
      "end_seconds": 132.18,
      "duration_seconds": 11.96,
      "text": "For my pressure, I believe. My son sets them out for me, I just take what I'm given. Paracetamol, 650 milligrams, maybe, when needed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.88,
      "end_seconds": 141.22,
      "duration_seconds": 3.34,
      "text": "Is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.2,
      "end_seconds": 153.64,
      "duration_seconds": 10.44,
      "text": "No, it's at home. Carvedilol. I take it 6.25 milligrams, twice a day. I, I take Volini gel, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.31,
      "end_seconds": 157.93,
      "duration_seconds": 3.62,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.99,
      "end_seconds": 170.69,
      "duration_seconds": 10.7,
      "text": "I have high blood pressure. I have arthritis in my knees. Heart failure, for nearly five years. High cholesterol, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.19,
      "end_seconds": 181.71,
      "duration_seconds": 10.52,
      "text": "Yes, arthritis in your knees is known to us, good to have that clear. Are you on your own at home?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.3,
      "end_seconds": 185.21,
      "duration_seconds": 2.91,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.38,
      "end_seconds": 191.44,
      "duration_seconds": 5.06,
      "text": "Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.25,
      "end_seconds": 197.8,
      "duration_seconds": 5.55,
      "text": "Um, you know, no, not that I know of."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 199.36,
      "end_seconds": 206.14,
      "duration_seconds": 6.78,
      "text": "Hold on, doctor, I think he reacted to trimethoprim once. I'm not certain, though."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 207.34,
      "end_seconds": 210.07,
      "duration_seconds": 2.73,
      "text": "Really? I don't think so."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.47,
      "end_seconds": 222.38,
      "duration_seconds": 8.91,
      "text": "Fair enough, I'll write down both versions. Have you noticed numbness around the groin, weight loss, fever or weakness in the legs?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.31,
      "end_seconds": 239.14,
      "duration_seconds": 14.83,
      "text": "No, no numbness around the groin, no weight loss, no fever. I did have pain going into the buttock at one point, but that went away on its own."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.48,
      "end_seconds": 245.38,
      "duration_seconds": 4.9,
      "text": "Have you had numbness in the legs, by any chance?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 247.43,
      "end_seconds": 250.7,
      "duration_seconds": 3.27,
      "text": "No, no numbness in the legs."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 255.79,
      "end_seconds": 258.03,
      "duration_seconds": 2.24,
      "text": "Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.09,
      "end_seconds": 261.02,
      "duration_seconds": 0.93,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 265.63,
      "end_seconds": 277.43,
      "duration_seconds": 11.8,
      "text": "Doctor, I've got the readings for you. Temperature is 36.8 degrees, blood pressure 118 over 73, heart rate 70. SpO2 99 percent on room air."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 280.42,
      "end_seconds": 295.11,
      "duration_seconds": 14.69,
      "text": "Okay, noted. Let me tell you where I've got to. It points towards mechanical low back pain. That's my thinking for now, and it may change as we learn more. A pinched nerve is still possible."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.78,
      "end_seconds": 318.72,
      "duration_seconds": 5.94,
      "text": "I want an X-ray of the lower back done, that's for back pain."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.2,
      "end_seconds": 321.21,
      "duration_seconds": 1.01,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.98,
      "end_seconds": 343.96,
      "duration_seconds": 20.98,
      "text": "Let's get an MRI of the lumbar spine, for persistent back pain. I'm going to put you on ibuprofen, 400 milligrams, twice a day after food, for five days. It's for back pain. We'll begin with thiocolchicoside, 4 milligrams, twice a day, for five days. It's for muscle spasm."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 344.61,
      "end_seconds": 346.59,
      "duration_seconds": 1.98,
      "text": "Fine, I'll begin it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 347.67,
      "end_seconds": 370.67,
      "duration_seconds": 23.0,
      "text": "Every hour, get up and stretch if you're at a desk. Physiotherapy would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. We'll catch up in two weeks."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 371.35,
      "end_seconds": 373.24,
      "duration_seconds": 1.89,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.88,
      "end_seconds": 376.78,
      "duration_seconds": 2.9,
      "text": "Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.6,
      "end_seconds": 381.31,
      "duration_seconds": 2.71,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 383.4,
      "end_seconds": 384.96,
      "duration_seconds": 1.56,
      "text": "Have a good day."
    }
  ]
}