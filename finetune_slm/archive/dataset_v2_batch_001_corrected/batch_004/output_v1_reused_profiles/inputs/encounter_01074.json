{
  "schema_version": "1.0",
  "encounter_id": "01074",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.23,
      "end_seconds": 9.09,
      "duration_seconds": 7.86,
      "text": "Hello doctor, uh, sorry, I took a wrong turn on the way here."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 10.71,
      "end_seconds": 15.57,
      "duration_seconds": 4.86,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 16.74,
      "end_seconds": 25.68,
      "duration_seconds": 8.94,
      "text": "Yeah, it's a mole that has changed. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 26.2,
      "end_seconds": 28.41,
      "duration_seconds": 2.21,
      "text": "Right, when did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 29.89,
      "end_seconds": 44.43,
      "duration_seconds": 14.54,
      "text": "Yeah, you know, for about three months, I'd say. Oh, um, and bleeding from the mole once. That's been about the same, three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.17,
      "end_seconds": 50.34,
      "duration_seconds": 4.17,
      "text": "Any a crusty edge on the mole as well?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.49,
      "end_seconds": 52.59,
      "duration_seconds": 1.1,
      "text": "Mm, yes."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.27,
      "end_seconds": 56.21,
      "duration_seconds": 2.94,
      "text": "Has there been any night sweats?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.74,
      "end_seconds": 59.91,
      "duration_seconds": 2.17,
      "text": "Definitely no night sweats."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.5,
      "end_seconds": 66.56,
      "duration_seconds": 5.06,
      "text": "And what about pain, other new moles or lumps in the armpit?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.61,
      "end_seconds": 72.27,
      "duration_seconds": 3.66,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 72.64,
      "end_seconds": 75.81,
      "duration_seconds": 3.17,
      "text": "Mm-hmm. Your breathing, any trouble there?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.76,
      "end_seconds": 79.9,
      "duration_seconds": 3.14,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 80.74,
      "end_seconds": 84.16,
      "duration_seconds": 3.42,
      "text": "Anything with your nerves, like weakness or numbness?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 89.29,
      "duration_seconds": 3.63,
      "text": "Um, no, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.07,
      "end_seconds": 107.27,
      "duration_seconds": 3.2,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 109.37,
      "end_seconds": 113.65,
      "duration_seconds": 4.28,
      "text": "Arthritis in my knees, for five years."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.03,
      "end_seconds": 117.05,
      "duration_seconds": 2.02,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 117.64,
      "end_seconds": 121.99,
      "duration_seconds": 4.35,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 122.72,
      "end_seconds": 124.54,
      "duration_seconds": 1.82,
      "text": "Who lives with you?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 127.09,
      "end_seconds": 129.82,
      "duration_seconds": 2.73,
      "text": "My partner and our baby."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.94,
      "end_seconds": 134.15,
      "duration_seconds": 3.21,
      "text": "What line of work are you in?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 134.86,
      "end_seconds": 141.01,
      "duration_seconds": 6.15,
      "text": "I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.62,
      "end_seconds": 157.49,
      "duration_seconds": 3.87,
      "text": "What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.39,
      "end_seconds": 163.11,
      "duration_seconds": 3.72,
      "text": "Naproxen, 250 milligrams, twice a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 164.88,
      "end_seconds": 167.73,
      "duration_seconds": 2.85,
      "text": "How long have you been on it?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 168.26,
      "end_seconds": 170.25,
      "duration_seconds": 1.99,
      "text": "About a year now."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.33,
      "end_seconds": 174.07,
      "duration_seconds": 2.74,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 175.52,
      "end_seconds": 178.56,
      "duration_seconds": 3.04,
      "text": "I've never had an allergy."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.94,
      "end_seconds": 182.99,
      "duration_seconds": 3.05,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.8,
      "end_seconds": 194.01,
      "duration_seconds": 5.21,
      "text": "So, uh, just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 201.37,
      "end_seconds": 204.39,
      "duration_seconds": 3.02,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.08,
      "end_seconds": 213.41,
      "duration_seconds": 2.33,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.12,
      "end_seconds": 238.61,
      "duration_seconds": 8.49,
      "text": "Okay: SpO2 99 percent on room air, pressure 114 over 72, pulse is 74 beats a minute, temperature 36.9."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.92,
      "end_seconds": 241.51,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.58,
      "end_seconds": 246.38,
      "duration_seconds": 2.8,
      "text": "That's fine, I'll explain it soon."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 247.76,
      "end_seconds": 251.95,
      "duration_seconds": 4.19,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.94,
      "end_seconds": 255.14,
      "duration_seconds": 1.2,
      "text": "Breathe out slowly."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.44,
      "end_seconds": 268.97,
      "duration_seconds": 4.53,
      "text": "I can't feel any glands in the armpit or neck."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.88,
      "end_seconds": 285.24,
      "duration_seconds": 11.36,
      "text": "That's all I needed to check. Okay, thinking it through, this is probably a pigmented lesion that needs removal for a proper diagnosis."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 285.78,
      "end_seconds": 288.05,
      "duration_seconds": 2.27,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.89,
      "end_seconds": 302.47,
      "duration_seconds": 13.58,
      "text": "I can't promise yet, but most people with a pigmented lesion that needs removal for a proper diagnosis do well once it's treated properly. I'll request a skin biopsy, it'll help with changing mole."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 304.23,
      "end_seconds": 308.41,
      "duration_seconds": 4.18,
      "text": "We have a slot Friday at 10 am, if that works."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 310.06,
      "end_seconds": 334.41,
      "duration_seconds": 24.35,
      "text": "Cover up and use factor 50 sunscreen on exposed skin. I think the skin cancer clinic should see you too. Keep an eye out, and if the mole bleeds or grows quickly, call us the same day or go to emergency. We'll catch up in two weeks. Alright, is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.96,
      "end_seconds": 338.58,
      "duration_seconds": 3.62,
      "text": "Actually, uh, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 340.13,
      "end_seconds": 342.11,
      "duration_seconds": 1.98,
      "text": "Right, take care now."
    }
  ]
}