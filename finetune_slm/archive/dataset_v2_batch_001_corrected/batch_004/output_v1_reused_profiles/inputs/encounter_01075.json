{
  "schema_version": "1.0",
  "encounter_id": "01075",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.33,
      "end_seconds": 3.83,
      "duration_seconds": 2.5,
      "text": "Afternoon, thanks for coming in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.36,
      "end_seconds": 7.52,
      "duration_seconds": 2.16,
      "text": "Hello, um, doctor."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 9.32,
      "end_seconds": 12.11,
      "duration_seconds": 2.79,
      "text": "What do you need help with?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 13.7,
      "end_seconds": 18.74,
      "duration_seconds": 5.04,
      "text": "Doctor, it's hot flushes. It's getting on my nerves now."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.15,
      "end_seconds": 26.82,
      "duration_seconds": 3.67,
      "text": "When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 28.21,
      "end_seconds": 34.47,
      "duration_seconds": 6.26,
      "text": "Erm, uh, it's been about a month, I'm fairly sure."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 35.57,
      "end_seconds": 37.9,
      "duration_seconds": 2.33,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 39.91,
      "end_seconds": 56.68,
      "duration_seconds": 16.77,
      "text": "Night sweats goes along with it, most of the time. Erm, the night sweats? That's been since last weekend. Actually, about night sweats, it happens a few times a day."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.35,
      "end_seconds": 62.28,
      "duration_seconds": 3.93,
      "text": "Alright, what about vaginal dryness, have you noticed that?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 64.16,
      "end_seconds": 71.28,
      "duration_seconds": 7.12,
      "text": "Yes, about the same, about four days. With vaginal dryness, mild, I'd say."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 72.74,
      "end_seconds": 77.16,
      "duration_seconds": 4.42,
      "text": "Okay, any weight loss, breast lumps or chest pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 78.3,
      "end_seconds": 82.45,
      "duration_seconds": 4.15,
      "text": "Mm, um, no, none that I've noticed."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 83.31,
      "end_seconds": 86.07,
      "duration_seconds": 2.76,
      "text": "Did you notice any heavy bleeding?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.36,
      "end_seconds": 90.91,
      "duration_seconds": 3.55,
      "text": "Nope, um, no heavy bleeding."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.39,
      "end_seconds": 94.95,
      "duration_seconds": 2.56,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 96.61,
      "end_seconds": 98.84,
      "duration_seconds": 2.23,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 100.55,
      "end_seconds": 104.86,
      "duration_seconds": 4.31,
      "text": "Are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 109.44,
      "end_seconds": 113.1,
      "duration_seconds": 3.66,
      "text": "Wheat. I come out in... well, bloating."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.88,
      "end_seconds": 133.86,
      "duration_seconds": 1.98,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.45,
      "end_seconds": 148.99,
      "duration_seconds": 14.54,
      "text": "I have thin bones. So, I have high blood pressure, for nearly five years. I told myself I'd wait and see, and here I am."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 153.0,
      "end_seconds": 157.73,
      "duration_seconds": 4.73,
      "text": "Okay, I can see thin bones in your file as well."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 172.73,
      "end_seconds": 178.18,
      "duration_seconds": 5.45,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 179.23,
      "end_seconds": 190.52,
      "duration_seconds": 11.29,
      "text": "My partner and our baby. I grab fast food at lunch most days. I'm a bus driver, so I sit for long hours."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.45,
      "end_seconds": 198.29,
      "duration_seconds": 2.84,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 199.26,
      "end_seconds": 204.29,
      "duration_seconds": 5.03,
      "text": "Erm, I had a bunion operation six years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 205.61,
      "end_seconds": 208.06,
      "duration_seconds": 2.45,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 209.33,
      "end_seconds": 215.04,
      "duration_seconds": 5.71,
      "text": "Uh, I'm on alendronate, once a week for my bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 216.35,
      "end_seconds": 218.31,
      "duration_seconds": 1.96,
      "text": "Do you know the dose?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.25,
      "end_seconds": 231.42,
      "duration_seconds": 11.17,
      "text": "70 milligrams, I think that's what's on the box. I'm on lisinopril, 10 milligrams, once a day for my pressure."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 231.99,
      "end_seconds": 234.19,
      "duration_seconds": 2.2,
      "text": "When did you start it?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 235.47,
      "end_seconds": 237.48,
      "duration_seconds": 2.01,
      "text": "About about three months."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.04,
      "end_seconds": 242.28,
      "duration_seconds": 3.24,
      "text": "Does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 243.2,
      "end_seconds": 245.68,
      "duration_seconds": 2.48,
      "text": "My uncle has high cholesterol."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 246.97,
      "end_seconds": 257.28,
      "duration_seconds": 10.31,
      "text": "Okay, so the vitals from earlier. Temp 36.7 degrees, saturation 99 percent, respiratory rate 16. BP is 126 over 69, pulse 78."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 258.91,
      "end_seconds": 260.27,
      "duration_seconds": 1.36,
      "text": "Good, thank you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 263.13,
      "end_seconds": 267.18,
      "duration_seconds": 4.05,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 268.3,
      "end_seconds": 270.93,
      "duration_seconds": 2.63,
      "text": "I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.75,
      "end_seconds": 295.7,
      "duration_seconds": 6.95,
      "text": "Blood pressure and pulse are fine, and there are no breast lumps on examination."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.56,
      "end_seconds": 303.32,
      "duration_seconds": 2.76,
      "text": "Right, you can sit up now."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.38,
      "end_seconds": 317.79,
      "duration_seconds": 4.41,
      "text": "Putting it all together, it fits best with perimenopausal symptoms."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 319.71,
      "end_seconds": 322.4,
      "duration_seconds": 2.69,
      "text": "Yeah, is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 324.21,
      "end_seconds": 338.55,
      "duration_seconds": 14.34,
      "text": "I understand the worry. At the moment I'd say it's perimenopausal symptoms, and we'll know more once the blood tests is back. Let's get blood tests, for irregular periods."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 339.7,
      "end_seconds": 340.95,
      "duration_seconds": 1.25,
      "text": "Right, understood."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 342.08,
      "end_seconds": 371.81,
      "duration_seconds": 29.73,
      "text": "Let's get a bone density scan, for menopause. That will help us see what's going on underneath and decide the next step. We should do a thyroid test for hot flushes. Layers of clothing, a fan by the bed, and cutting down on caffeine and spicy food can help the flushes. Please come and see me in six weeks. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 373.01,
      "end_seconds": 377.51,
      "duration_seconds": 4.5,
      "text": "Mm, okay, that makes sense. Thanks for explaining."
    }
  ]
}