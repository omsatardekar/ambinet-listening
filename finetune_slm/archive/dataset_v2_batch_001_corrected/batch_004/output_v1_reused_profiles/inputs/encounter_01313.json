{
  "schema_version": "1.0",
  "encounter_id": "01313",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.36,
      "end_seconds": 7.03,
      "duration_seconds": 5.67,
      "text": "Hello, come in. Mind the step. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 9.03,
      "end_seconds": 15.16,
      "duration_seconds": 6.13,
      "text": "Honestly, it's pale stools, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.23,
      "end_seconds": 20.09,
      "duration_seconds": 3.86,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 21.69,
      "end_seconds": 23.6,
      "duration_seconds": 1.91,
      "text": "Probably ten days. Yeah."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.97,
      "end_seconds": 24.67,
      "duration_seconds": 0.7,
      "text": "Ah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 26.62,
      "end_seconds": 40.78,
      "duration_seconds": 14.16,
      "text": "I've also had no appetite, for about a week. Oh, and tiredness. That's been about the same, three days. With tiredness, it settles a little with resting."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 50.4,
      "end_seconds": 53.12,
      "duration_seconds": 2.72,
      "text": "Let's start with the basic checks."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 66.55,
      "end_seconds": 69.39,
      "duration_seconds": 2.84,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 89.19,
      "end_seconds": 99.66,
      "duration_seconds": 10.47,
      "text": "Okay: SpO2 98 percent on room air, pressure 114 over 68, temperature is 36.6 degrees, pulse is 83 beats a minute."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.96,
      "end_seconds": 106.16,
      "duration_seconds": 4.2,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 108.13,
      "end_seconds": 111.34,
      "duration_seconds": 3.21,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 129.19,
      "end_seconds": 136.01,
      "duration_seconds": 6.82,
      "text": "The whites of your eyes are yellow and the liver edge is tender under the right ribs."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 141.4,
      "end_seconds": 147.87,
      "duration_seconds": 6.47,
      "text": "Thank you, you can get dressed. Okay, any sign of severe abdominal pain?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 149.23,
      "end_seconds": 153.58,
      "duration_seconds": 4.35,
      "text": "No, I haven't had any severe abdominal pain."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.12,
      "end_seconds": 158.9,
      "duration_seconds": 3.78,
      "text": "Have you noticed itching, vomiting blood, bleeding or confusion?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.79,
      "end_seconds": 165.17,
      "duration_seconds": 5.38,
      "text": "I haven't had itching, vomiting blood, bleeding or confusion, no."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.61,
      "end_seconds": 171.06,
      "duration_seconds": 5.45,
      "text": "I see, go ahead. How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 172.97,
      "end_seconds": 174.96,
      "duration_seconds": 1.99,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.36,
      "end_seconds": 179.91,
      "duration_seconds": 3.55,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.47,
      "end_seconds": 185.98,
      "duration_seconds": 4.51,
      "text": "I have gout. Eczema, for about a year."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 186.88,
      "end_seconds": 191.75,
      "duration_seconds": 4.87,
      "text": "Alright, gout, that matches what I have here. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.8,
      "end_seconds": 194.94,
      "duration_seconds": 2.14,
      "text": "No, not at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 213.22,
      "end_seconds": 218.67,
      "duration_seconds": 5.45,
      "text": "Okay, tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.01,
      "end_seconds": 241.31,
      "duration_seconds": 21.3,
      "text": "I quit smoking around ten years ago. I used to drink heavily but I stopped four years ago. Not much, I mostly stay in these days. Yes, I work in a bakery, early starts. My partner and our baby."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.08,
      "end_seconds": 245.63,
      "duration_seconds": 3.55,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.64,
      "end_seconds": 249.52,
      "duration_seconds": 1.88,
      "text": "My cousin has psoriasis."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.29,
      "end_seconds": 253.88,
      "duration_seconds": 2.59,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 254.96,
      "end_seconds": 263.54,
      "duration_seconds": 8.58,
      "text": "Yes, erythromycin. I've no idea what the reaction was, only that I'm not supposed to have it."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 265.1,
      "end_seconds": 267.31,
      "duration_seconds": 2.21,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 268.17,
      "end_seconds": 275.17,
      "duration_seconds": 7.0,
      "text": "I'm on something called febu... febuxostat, 80 milligrams, maybe, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 277.19,
      "end_seconds": 281.47,
      "duration_seconds": 4.28,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 282.78,
      "end_seconds": 288.17,
      "duration_seconds": 5.39,
      "text": "No, it's at home. I'm on hydrocortisone cream, when needed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.9,
      "end_seconds": 300.41,
      "duration_seconds": 11.51,
      "text": "Right, here's what I'm thinking. The most likely explanation is an acute viral hepatitis. That's my thinking for now, and it may change as we learn more."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 301.11,
      "end_seconds": 304.05,
      "duration_seconds": 2.94,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.43,
      "end_seconds": 316.23,
      "duration_seconds": 10.8,
      "text": "I understand the worry. At the moment I'd say it's an acute viral hepatitis, and we'll know more once the an ultrasound of the liver is back."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 330.46,
      "end_seconds": 361.6,
      "duration_seconds": 31.14,
      "text": "I'd like to arrange an ultrasound of the liver for jaundice. I'm going to order liver blood tests, for jaundice. No alcohol at all and avoid paracetamol and other painkillers unless we say. The liver clinic would be the right next step, I'll refer you. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 362.51,
      "end_seconds": 376.05,
      "duration_seconds": 13.54,
      "text": "One warning sign to remember: you become drowsy or confused. In that case don't wait. Come back after the results. Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.43,
      "end_seconds": 382.29,
      "duration_seconds": 4.86,
      "text": "So, I come back after the results. Is that right?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 384.34,
      "end_seconds": 389.09,
      "duration_seconds": 4.75,
      "text": "Yes, exactly right. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 390.41,
      "end_seconds": 393.72,
      "duration_seconds": 3.31,
      "text": "Hmm, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 394.6,
      "end_seconds": 396.0,
      "duration_seconds": 1.4,
      "text": "Goodbye for now."
    }
  ]
}