{
  "schema_version": "1.0",
  "encounter_id": "01080",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.03,
      "end_seconds": 6.59,
      "duration_seconds": 5.56,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.54,
      "end_seconds": 12.17,
      "duration_seconds": 4.63,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.97,
      "end_seconds": 24.44,
      "duration_seconds": 6.47,
      "text": "It's numbness in my feet. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.93,
      "end_seconds": 29.95,
      "duration_seconds": 4.02,
      "text": "Right, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.75,
      "end_seconds": 33.9,
      "duration_seconds": 3.15,
      "text": "It's been like this since last night."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.31,
      "end_seconds": 35.01,
      "duration_seconds": 0.7,
      "text": "yes"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 41.04,
      "end_seconds": 46.19,
      "duration_seconds": 5.15,
      "text": "and a sore on the bottom of my foot, too"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.8,
      "end_seconds": 52.65,
      "duration_seconds": 5.85,
      "text": "any chest pain, confusion, black toes or pain at rest in the leg?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 54.07,
      "end_seconds": 56.82,
      "duration_seconds": 2.75,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.73,
      "end_seconds": 61.95,
      "duration_seconds": 3.22,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.96,
      "end_seconds": 68.32,
      "duration_seconds": 1.36,
      "text": "nothing like that"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.14,
      "end_seconds": 72.68,
      "duration_seconds": 2.54,
      "text": "how are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.19,
      "end_seconds": 76.96,
      "duration_seconds": 2.77,
      "text": "oh, no, all normal there"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.18,
      "end_seconds": 81.01,
      "duration_seconds": 2.83,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 87.2,
      "end_seconds": 88.6,
      "duration_seconds": 1.4,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.5,
      "end_seconds": 93.89,
      "duration_seconds": 4.39,
      "text": "yes. Alright, diabetes, that matches what I have here"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.66,
      "end_seconds": 112.73,
      "duration_seconds": 3.07,
      "text": "okay, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.57,
      "end_seconds": 117.15,
      "duration_seconds": 2.58,
      "text": "It's Glycomet, twice a day."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.18,
      "end_seconds": 120.85,
      "duration_seconds": 2.67,
      "text": "Alright, how much do you take?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.93,
      "end_seconds": 126.88,
      "duration_seconds": 4.95,
      "text": "500 milligrams, I think that's what's on the box."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.66,
      "end_seconds": 139.86,
      "duration_seconds": 2.2,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 140.49,
      "end_seconds": 145.45,
      "duration_seconds": 4.96,
      "text": "just a caesarean for my second baby, nine years ago"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.28,
      "end_seconds": 147.54,
      "duration_seconds": 1.26,
      "text": "what about alcohol?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.52,
      "end_seconds": 152.26,
      "duration_seconds": 3.74,
      "text": "I'll have a glass of wine with dinner"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.31,
      "end_seconds": 154.63,
      "duration_seconds": 1.32,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.19,
      "end_seconds": 158.37,
      "duration_seconds": 3.18,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.18,
      "end_seconds": 160.52,
      "duration_seconds": 1.34,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.93,
      "end_seconds": 165.8,
      "duration_seconds": 3.87,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.23,
      "end_seconds": 169.41,
      "duration_seconds": 2.18,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.18,
      "end_seconds": 176.28,
      "duration_seconds": 6.1,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.3,
      "end_seconds": 181.59,
      "duration_seconds": 3.29,
      "text": "I'll just record a few vital signs."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 190.1,
      "end_seconds": 192.52,
      "duration_seconds": 2.42,
      "text": "keep your arm relaxed for me.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.94,
      "end_seconds": 210.32,
      "duration_seconds": 7.38,
      "text": "Okay: heart rate 88, pressure 113 over 73. And oxygen saturation is 96 percent, temperature 38.9."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 211.6,
      "end_seconds": 216.08,
      "duration_seconds": 4.48,
      "text": "Let me look at the the area, I'll be gentle."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 217.38,
      "end_seconds": 218.57,
      "duration_seconds": 1.19,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 235.81,
      "end_seconds": 243.28,
      "duration_seconds": 7.47,
      "text": "There is a two-centimetre ulcer on the ball of the right foot with redness around it."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 249.09,
      "end_seconds": 264.36,
      "duration_seconds": 15.27,
      "text": "You can sit up now. Putting it all together, it points towards an infected diabetic foot ulcer. It could also be poor circulation to the foot, so we'll keep that open."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.91,
      "end_seconds": 282.52,
      "duration_seconds": 3.61,
      "text": "I'm sending you for blood tests because of infection"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.46,
      "end_seconds": 285.48,
      "duration_seconds": 2.02,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.94,
      "end_seconds": 323.82,
      "duration_seconds": 36.88,
      "text": "A swab from the ulcer is what I'd like next, for infected ulcer. It's a routine test and it'll give us a much clearer picture. I'm going to put you on amoxicillin/clavulanic acid, 625 milligrams, three times a day, for seven days. That should help with foot infection. Keep the weight off that foot and keep the dressing dry. Cut down on salt and fried food for now, it really does make a difference."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.38,
      "end_seconds": 332.49,
      "duration_seconds": 4.11,
      "text": "I think the foot clinic should see you too."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.38,
      "end_seconds": 339.54,
      "duration_seconds": 6.16,
      "text": "Ah, um, can you send me for a foot X-ray?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.07,
      "end_seconds": 356.96,
      "duration_seconds": 15.89,
      "text": "I don't think that's needed at this stage, the history doesn't call for it. Come back or go to emergency straight away if the redness spreads or you feel unwell with a fever. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.95,
      "end_seconds": 361.08,
      "duration_seconds": 2.13,
      "text": "Thank you, that's helpful."
    }
  ]
}