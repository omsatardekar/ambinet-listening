{
  "schema_version": "1.0",
  "encounter_id": "01431",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.1,
      "end_seconds": 6.55,
      "duration_seconds": 5.45,
      "text": "Okay, so good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.75,
      "end_seconds": 12.35,
      "duration_seconds": 4.6,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.61,
      "end_seconds": 23.11,
      "duration_seconds": 9.5,
      "text": "Doctor, you know, I'm just here to help with the details. She's been feeling weak, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.63,
      "end_seconds": 26.0,
      "duration_seconds": 2.37,
      "text": "Did it come on recently?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.23,
      "end_seconds": 32.79,
      "duration_seconds": 2.56,
      "text": "Probably about a week. Yeah."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.01,
      "end_seconds": 37.74,
      "duration_seconds": 4.73,
      "text": "Okay, go on. How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.22,
      "end_seconds": 44.44,
      "duration_seconds": 5.22,
      "text": "Actually, um, pretty severe, if I'm being honest."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.85,
      "end_seconds": 45.78,
      "duration_seconds": 0.93,
      "text": "I follow."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 46.73,
      "end_seconds": 53.68,
      "duration_seconds": 6.95,
      "text": "Mm, there was a pounding in my head, yes, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 55.21,
      "end_seconds": 59.8,
      "duration_seconds": 4.59,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 61.6,
      "end_seconds": 64.71,
      "duration_seconds": 3.11,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 66.36,
      "end_seconds": 69.36,
      "duration_seconds": 3.0,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 70.71,
      "end_seconds": 77.57,
      "duration_seconds": 6.86,
      "text": "I have high blood pressure, for two years. I have diabetes."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.13,
      "end_seconds": 80.69,
      "duration_seconds": 1.56,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.41,
      "end_seconds": 85.23,
      "duration_seconds": 3.82,
      "text": "An irregular heartbeat, for about a year."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 87.21,
      "end_seconds": 96.79,
      "duration_seconds": 9.58,
      "text": "Yes, high blood pressure is known to us, good to have that clear. Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.42,
      "end_seconds": 102.07,
      "duration_seconds": 3.65,
      "text": "Just my septum straightened, in my thirties."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.09,
      "end_seconds": 106.25,
      "duration_seconds": 2.16,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 106.94,
      "end_seconds": 125.49,
      "duration_seconds": 18.55,
      "text": "Sorry, you know, what was I saying, she is on amlodipine, 5 milligrams, once a day, I give it to her. She is on glimepiride, 2 milligrams, before breakfast, I give it to her."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.2,
      "end_seconds": 129.53,
      "duration_seconds": 2.33,
      "text": "Roughly how long on that one?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 131.56,
      "end_seconds": 133.48,
      "duration_seconds": 1.92,
      "text": "About three months now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.86,
      "end_seconds": 135.33,
      "duration_seconds": 1.47,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 140.99,
      "end_seconds": 150.68,
      "duration_seconds": 9.69,
      "text": "She is on metoprolol, 50 milligrams, twice a day for the heart rhythm, I give it to her."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 152.0,
      "end_seconds": 153.93,
      "duration_seconds": 1.93,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 155.36,
      "end_seconds": 161.56,
      "duration_seconds": 6.2,
      "text": "I used to drink heavily but I stopped four years ago."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.31,
      "end_seconds": 164.19,
      "duration_seconds": 1.88,
      "text": "So, are you active?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 165.86,
      "end_seconds": 169.37,
      "duration_seconds": 3.51,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.22,
      "end_seconds": 172.3,
      "duration_seconds": 2.08,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.43,
      "end_seconds": 177.34,
      "duration_seconds": 3.91,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.84,
      "end_seconds": 195.21,
      "duration_seconds": 2.37,
      "text": "Any sign of slurred speech?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 197.05,
      "end_seconds": 202.91,
      "duration_seconds": 5.86,
      "text": "Ah, um, not that I've noticed, no slurred speech."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.66,
      "end_seconds": 209.31,
      "duration_seconds": 5.65,
      "text": "Let me check a few things. Any palpitations, black stools or fainting?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.11,
      "end_seconds": 214.16,
      "duration_seconds": 3.05,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.31,
      "end_seconds": 219.05,
      "duration_seconds": 3.74,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.65,
      "end_seconds": 223.43,
      "duration_seconds": 3.78,
      "text": "No, you know, nothing with my heart."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.22,
      "end_seconds": 226.19,
      "duration_seconds": 1.97,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.47,
      "end_seconds": 236.88,
      "duration_seconds": 2.41,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.16,
      "end_seconds": 265.03,
      "duration_seconds": 7.87,
      "text": "Okay: pulse 94, pressure 93 over 58, temp 36.6 degrees, height 165 centimetres, weight 56 kilos."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 267.37,
      "end_seconds": 271.29,
      "duration_seconds": 3.92,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.89,
      "end_seconds": 275.02,
      "duration_seconds": 2.13,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 288.44,
      "end_seconds": 292.33,
      "duration_seconds": 3.89,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 297.65,
      "end_seconds": 300.29,
      "duration_seconds": 2.64,
      "text": "That's all I needed to check."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.47,
      "end_seconds": 327.11,
      "duration_seconds": 14.64,
      "text": "Having listened and examined, my working impression is postural low blood pressure, possibly related to medicines or dehydration. It could also be an abnormal heart rhythm, so we'll keep that open."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 328.85,
      "end_seconds": 332.01,
      "duration_seconds": 3.16,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.96,
      "end_seconds": 344.75,
      "duration_seconds": 10.79,
      "text": "I can't promise yet, but most people with postural low blood pressure, possibly related to medicines or dehydration do well once it's treated properly."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.61,
      "end_seconds": 360.71,
      "duration_seconds": 3.1,
      "text": "We should do an ECG for dizziness."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 361.77,
      "end_seconds": 363.61,
      "duration_seconds": 1.84,
      "text": "That makes sense."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.27,
      "end_seconds": 393.77,
      "duration_seconds": 28.5,
      "text": "I'd like to arrange blood tests for dizziness. Get up slowly from lying and sitting, and keep drinking fluids through the day. A short walk every day, even twenty minutes, will help more than you'd think. A lying and standing blood pressure check is something we might do if this doesn't improve in two weeks. Let's plan a check after the results are back."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 394.33,
      "end_seconds": 396.54,
      "duration_seconds": 2.21,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 400.14,
      "end_seconds": 404.62,
      "duration_seconds": 4.48,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 405.81,
      "end_seconds": 408.12,
      "duration_seconds": 2.31,
      "text": "Alright, thanks, take care."
    }
  ]
}