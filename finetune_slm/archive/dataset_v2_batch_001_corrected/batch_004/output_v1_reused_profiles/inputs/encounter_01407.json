      "text": "no problems with breathing"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "NURSE",
      "start_seconds": 186.34,
      "end_seconds": 202.05,
      "duration_seconds": 15.71,
      "text": "okay, so the vitals from earlier heart rate 83, SpO2 98 percent on room air, height 155 centimetres respiratory rate 15, blood pressure 126 over 78, weight 79 kilos, temperature is 36.8 degrees"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.99,
      "end_seconds": 204.69,
      "duration_seconds": 0.7,
      "text": "Thanks."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.84,
      "end_seconds": 210.59,
      "duration_seconds": 3.75,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.57,
      "end_seconds": 215.9,
      "duration_seconds": 3.33,
      "text": "stay as you are for a moment"
