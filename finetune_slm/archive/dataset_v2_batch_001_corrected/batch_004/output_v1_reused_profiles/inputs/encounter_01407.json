      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 125.41,
      "end_seconds": 133.77,
      "duration_seconds": 8.36,
      "text": "I'm on hydrocortisone cream, when needed for the eczema. It's, It's atorvastatin, 20 milligrams, at night"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.46,
      "end_seconds": 135.67,
      "duration_seconds": 1.21,
      "text": "any previous surgeries?"
