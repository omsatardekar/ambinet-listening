      "role": "PATIENT",
      "start_seconds": 70.88,
      "end_seconds": 84.36,
      "duration_seconds": 13.48,
      "text": "Not much, I mostly stay in these days. Lots of rice, lentils and some fruit. No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 99.35,
      "end_seconds": 106.42,
      "duration_seconds": 7.07,
      "text": "What conditions have you been treated for in the past? Take your time, there's no rush."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 107.12,
      "end_seconds": 116.85,
      "duration_seconds": 9.73,
      "text": "I have eczema, for two years. I told my wife I'd come today. High cholesterol, for five years"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.49,
      "end_seconds": 124.43,
      "duration_seconds": 6.94,
      "text": "Alright, high cholesterol, that matches what I have here. Which medicines do you take at the moment?"
