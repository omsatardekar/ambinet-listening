    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.86,
      "end_seconds": 239.2,
      "duration_seconds": 5.34,
      "text": "Your vision is normal on the chart and the pupil reacts well."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.31,
      "end_seconds": 258.71,
      "duration_seconds": 16.4,
      "text": "That's all I needed to check. Right, here's what I'm thinking. This looks most like conjunctivitis. I want to be honest that this is an impression, not a final answer. I can't rule out an allergic eye problem yet."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.49,
      "end_seconds": 300.68,
      "duration_seconds": 27.19,
      "text": "Let's book an eye swab to look into red eye. I'd like you to take chloramphenicol eye drops, four times a day, for five days. It's for conjunctivitis. Wash your hands often, don't share towels, and don't rub the eye. Please come and see me if it's not better in three days. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.14,
      "end_seconds": 306.06,
