{
  "schema_version": "1.0",
  "encounter_id": "01465",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.61,
      "end_seconds": 5.64,
      "duration_seconds": 5.03,
      "text": "Hello, uh, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.4,
      "end_seconds": 12.51,
      "duration_seconds": 5.11,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 13.04,
      "end_seconds": 17.85,
      "duration_seconds": 4.81,
      "text": "Doctor, I'm just here to help with the the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 18.84,
      "end_seconds": 25.86,
      "duration_seconds": 7.02,
      "text": "Well, I've been having a blocked nose. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 27.03,
      "end_seconds": 29.95,
      "duration_seconds": 2.92,
      "text": "what's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.16,
      "end_seconds": 34.19,
      "duration_seconds": 3.03,
      "text": "About a week, give or take."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 35.95,
      "end_seconds": 40.88,
      "duration_seconds": 4.93,
      "text": "I, I think it's been nearer two weeks, actually"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.52,
      "end_seconds": 46.74,
      "duration_seconds": 4.22,
      "text": "okay, so roughly one to two weeks is that right?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.51,
      "end_seconds": 49.61,
      "duration_seconds": 1.1,
      "text": "yeah, roughly"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 51.55,
      "end_seconds": 53.91,
      "duration_seconds": 2.36,
      "text": "how much does it limit you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.0,
      "end_seconds": 59.46,
      "duration_seconds": 3.46,
      "text": "It, It feels mild to me."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 60.53,
      "end_seconds": 63.6,
      "duration_seconds": 3.07,
      "text": "have you had reduced sense of smell?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 64.33,
      "end_seconds": 67.75,
      "duration_seconds": 3.42,
      "text": "Um, yes, since this morning."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.57,
      "end_seconds": 75.31,
      "duration_seconds": 5.74,
      "text": "What about a a headache over your forehead, have you noticed that?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.71,
      "end_seconds": 87.38,
      "duration_seconds": 6.67,
      "text": "Mm, yes. There was pressure in the face, yes, but that went away."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.33,
      "end_seconds": 92.91,
      "duration_seconds": 4.58,
      "text": "any swelling around the eyes, nosebleeds or stiff neck at all?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 94.19,
      "end_seconds": 97.01,
      "duration_seconds": 2.82,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 98.63,
      "end_seconds": 102.16,
      "duration_seconds": 3.53,
      "text": "Have you noticed vision changes or ear pain?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 103.3,
      "end_seconds": 107.32,
      "duration_seconds": 4.02,
      "text": "No, uh, not a single one."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.22,
      "end_seconds": 110.23,
      "duration_seconds": 2.01,
      "text": "did you notice any fever?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.63,
      "end_seconds": 113.28,
      "duration_seconds": 1.65,
      "text": "no, no fever"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.15,
      "end_seconds": 117.27,
      "duration_seconds": 3.12,
      "text": "How are your joints, any aches elsewhere?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.32,
      "end_seconds": 123.98,
      "duration_seconds": 4.66,
      "text": "Hmm, you know, no, joints are fine."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.4,
      "end_seconds": 137.82,
      "duration_seconds": 2.42,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 138.6,
      "end_seconds": 143.01,
      "duration_seconds": 4.41,
      "text": "My husband and I live above the shop"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 144.76,
      "end_seconds": 147.25,
      "duration_seconds": 2.49,
      "text": "do you work outside the home?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.84,
      "end_seconds": 153.33,
      "duration_seconds": 4.49,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.52,
      "end_seconds": 159.41,
      "duration_seconds": 4.89,
      "text": "okay, what does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.52,
      "end_seconds": 164.1,
      "duration_seconds": 3.58,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.13,
      "end_seconds": 170.53,
      "duration_seconds": 4.4,
      "text": "right, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.04,
      "end_seconds": 173.73,
      "duration_seconds": 2.69,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 179.64,
      "end_seconds": 182.0,
      "duration_seconds": 2.36,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 182.77,
      "end_seconds": 186.3,
      "duration_seconds": 3.53,
      "text": "just my septum straightened, in my thirties"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.0,
      "end_seconds": 207.4,
      "duration_seconds": 4.4,
      "text": "can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 208.97,
      "end_seconds": 214.91,
      "duration_seconds": 5.94,
      "text": "He is on paracetamol, when needed, I give it to him."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.37,
      "end_seconds": 219.13,
      "duration_seconds": 2.76,
      "text": "Alright, and what strength is that?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 220.57,
      "end_seconds": 222.33,
      "duration_seconds": 1.76,
      "text": "It's 500 milligrams."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 223.27,
      "end_seconds": 227.5,
      "duration_seconds": 4.23,
      "text": "anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.96,
      "end_seconds": 231.36,
      "duration_seconds": 2.4,
      "text": "I, I have eczema"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.94,
      "end_seconds": 237.28,
      "duration_seconds": 5.34,
      "text": "alright, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.23,
      "end_seconds": 247.77,
      "duration_seconds": 2.54,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 266.05,
      "end_seconds": 275.63,
      "duration_seconds": 9.58,
      "text": "Okay: pulse is 72 beats a minute, SpO2 97 percent on room air, respiratory rate 18, BP is 120 over 70."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 276.56,
      "end_seconds": 278.25,
      "duration_seconds": 1.69,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.58,
      "end_seconds": 283.14,
      "duration_seconds": 3.56,
      "text": "don't worry, we'll discuss it in a second"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.36,
      "end_seconds": 288.3,
      "duration_seconds": 3.94,
      "text": "Alright, could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.31,
      "end_seconds": 290.54,
      "duration_seconds": 1.23,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.91,
      "end_seconds": 305.0,
      "duration_seconds": 3.09,
      "text": "The nose is congested with swollen lining."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.88,
      "end_seconds": 308.97,
      "duration_seconds": 2.09,
      "text": "raise your arm for me"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 319.52,
      "end_seconds": 324.32,
      "duration_seconds": 4.8,
      "text": "There's tenderness when I press over the cheeks and above the eyebrows."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.74,
      "end_seconds": 337.38,
      "duration_seconds": 9.64,
      "text": "Please sit back down. Putting it all together, this looks most like sinusitis. I'd also keep a viral cold in mind."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.34,
      "end_seconds": 341.32,
      "duration_seconds": 2.98,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 345.35,
      "end_seconds": 364.15,
      "duration_seconds": 18.8,
      "text": "I understand the worry. At the moment I'd say it's sinusitis, and we'll know more once the an X-ray of the sinuses is back. Let me repeat that back to make sure. You've had a blocked nose, mild, and no fever or stiff neck"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 365.94,
      "end_seconds": 368.54,
      "duration_seconds": 2.6,
      "text": "That's it, um, yes."
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 377.63,
      "end_seconds": 381.83,
      "duration_seconds": 4.2,
      "text": "I'm gonna order an X-ray of the sinuses, for sinusitis."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 382.63,
      "end_seconds": 384.87,
      "duration_seconds": 2.24,
      "text": "Is that done today?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.95,
      "end_seconds": 416.84,
      "duration_seconds": 30.89,
      "text": "What I'm giving you is amoxicillin-clavulanate, 625 milligrams, twice a day, for five days. That should help with sinusitis. I'd like you to take saline nasal spray, three times a day, for one week. That should help with nasal congestion. Steam a couple of times a day and saline rinses will help clear things. Please don't wait if the symptoms get worse. That's when to be seen urgently. Please come and see me in ten days."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 418.72,
      "end_seconds": 422.67,
      "duration_seconds": 3.95,
      "text": "Is there anything you'd like me to go over again?"
    },
    {
      "segment_id": "SEG0058",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.68,
      "end_seconds": 426.9,
      "duration_seconds": 3.22,
      "text": "I think I understand everything. Thanks."
    }
  ]
}