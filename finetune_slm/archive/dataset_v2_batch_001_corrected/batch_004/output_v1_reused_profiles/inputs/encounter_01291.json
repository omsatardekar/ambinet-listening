{
  "schema_version": "1.0",
  "encounter_id": "01291",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.63,
      "duration_seconds": 3.85,
      "text": "Sorry, uh, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.72,
      "end_seconds": 10.68,
      "duration_seconds": 3.96,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.23,
      "end_seconds": 17.63,
      "duration_seconds": 5.4,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.4,
      "end_seconds": 26.29,
      "duration_seconds": 3.89,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.84,
      "end_seconds": 34.63,
      "duration_seconds": 2.79,
      "text": "I'm here because of trouble sleeping."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.26,
      "end_seconds": 36.64,
      "duration_seconds": 1.38,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 38.62,
      "end_seconds": 45.36,
      "duration_seconds": 6.74,
      "text": "Let me think, uh, I've had it for nearly five years."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.52,
      "end_seconds": 49.39,
      "duration_seconds": 2.87,
      "text": "How troublesome is it day to day?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.48,
      "end_seconds": 53.11,
      "duration_seconds": 1.63,
      "text": "It's severe, honestly."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 54.2,
      "end_seconds": 56.26,
      "duration_seconds": 2.06,
      "text": "Any no energy as well?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 58.05,
      "end_seconds": 66.32,
      "duration_seconds": 8.27,
      "text": "Yes, um, I have. I was feeling low at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.41,
      "end_seconds": 76.12,
      "duration_seconds": 5.71,
      "text": "Have you had trouble sleeping before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.17,
      "end_seconds": 82.78,
      "duration_seconds": 4.61,
      "text": "A bit, last winter. It settled by itself back then."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 96.22,
      "end_seconds": 97.47,
      "duration_seconds": 1.25,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.44,
      "end_seconds": 99.95,
      "duration_seconds": 1.51,
      "text": "No surgery, no."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 117.08,
      "end_seconds": 123.76,
      "duration_seconds": 6.68,
      "text": "What about your medical history? Bear with me, I'm just building up the picture."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 124.33,
      "end_seconds": 133.13,
      "duration_seconds": 8.8,
      "text": "I've had anxiety for nearly five years now. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.01,
      "end_seconds": 138.27,
      "duration_seconds": 4.26,
      "text": "Understood. Alright, anxiety, that matches what I have here."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.65,
      "end_seconds": 148.41,
      "duration_seconds": 1.76,
      "text": "Do you drink alcohol?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.48,
      "end_seconds": 153.06,
      "duration_seconds": 3.58,
      "text": "I'll have a glass of wine with dinner."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.59,
      "end_seconds": 157.8,
      "duration_seconds": 3.21,
      "text": "What do you do during the day?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 158.45,
      "end_seconds": 161.79,
      "duration_seconds": 3.34,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 163.07,
      "end_seconds": 165.33,
      "duration_seconds": 2.26,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.59,
      "end_seconds": 170.87,
      "duration_seconds": 4.28,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 172.66,
      "end_seconds": 177.56,
      "duration_seconds": 4.9,
      "text": "Alright, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.33,
      "end_seconds": 189.12,
      "duration_seconds": 9.79,
      "text": "I think I reacted to some antibiotic once, years ago. I don't remember which one, or what happened exactly."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.8,
      "end_seconds": 191.93,
      "duration_seconds": 2.13,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 193.22,
      "end_seconds": 197.3,
      "duration_seconds": 4.08,
      "text": "It's escitalopram, 10 milligrams, once a day, doctor."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.65,
      "end_seconds": 202.11,
      "duration_seconds": 3.46,
      "text": "And what about panic attacks or hearing voices?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.88,
      "end_seconds": 208.32,
      "duration_seconds": 4.44,
      "text": "I mean, you know, none of those, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.43,
      "end_seconds": 212.59,
      "duration_seconds": 3.16,
      "text": "And what about chest pain or weight loss?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.54,
      "end_seconds": 217.89,
      "duration_seconds": 3.35,
      "text": "No, I haven't had any of them."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.65,
      "end_seconds": 221.57,
      "duration_seconds": 2.92,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 222.94,
      "end_seconds": 225.76,
      "duration_seconds": 2.82,
      "text": "Nothing on the skin, no."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_4",
      "role": "NURSE",
      "start_seconds": 227.89,
      "end_seconds": 239.28,
      "duration_seconds": 11.39,
      "text": "Doctor, I've got the readings for you. Respiratory rate 14, oxygen saturation is 99 percent, pressure 119 over 72. Temperature 36.8, heart rate 77."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 240.84,
      "end_seconds": 241.78,
      "duration_seconds": 0.94,
      "text": "Okay, thanks."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.59,
      "end_seconds": 247.63,
      "duration_seconds": 4.04,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 248.78,
      "end_seconds": 250.25,
      "duration_seconds": 1.47,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.02,
      "end_seconds": 254.4,
      "duration_seconds": 2.38,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.14,
      "end_seconds": 276.97,
      "duration_seconds": 6.83,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 278.5,
      "end_seconds": 279.97,
      "duration_seconds": 1.47,
      "text": "Yes, that's fine."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.76,
      "end_seconds": 300.6,
      "duration_seconds": 16.84,
      "text": "Okay, that's enough for me. So, based on the history and the examination, the most likely explanation is low mood linked to work stress. It could also be an anxiety disorder, so we'll keep that open."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 302.18,
      "end_seconds": 304.91,
      "duration_seconds": 2.73,
      "text": "Is there something to worry about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.64,
      "end_seconds": 329.25,
      "duration_seconds": 22.61,
      "text": "It's reasonable to be concerned, but right now low mood linked to work stress is my leading thought, not anything worse. I think a thyroid test makes sense here, for low mood and fatigue. That will help us see what's going on underneath and decide the next step."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 331.34,
      "end_seconds": 335.84,
      "duration_seconds": 4.5,
      "text": "Sorry, what was I saying, okay, I'll do it."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 337.67,
      "end_seconds": 355.46,
      "duration_seconds": 17.79,
      "text": "I'd like to arrange a blood count for fatigue. Try a short walk each day and keep a regular bedtime. Please don't wait if you have thoughts of harming yourself. That's when to be seen urgently. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 356.96,
      "end_seconds": 359.89,
      "duration_seconds": 2.93,
      "text": "Mm, alright, I'll be back."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 360.75,
      "end_seconds": 363.23,
      "duration_seconds": 2.48,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 364.85,
      "end_seconds": 368.04,
      "duration_seconds": 3.19,
      "text": "I think I understand everything. Thanks."
    }
  ]
}