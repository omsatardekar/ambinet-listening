  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 6.15,
      "duration_seconds": 5.29,
      "text": "Well, hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.84,
      "end_seconds": 11.14,
      "duration_seconds": 4.3,
      "text": "not at all please sit what seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 13.19,
      "end_seconds": 35.29,
      "duration_seconds": 22.1,
      "text": "yeah, it's sharp pain on the right side when I breathe in i don't know what's causing it i took the morning off to come in today i've been reading about it online and and it worried me"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 36.92,
      "end_seconds": 41.74,
      "duration_seconds": 4.82,
      "text": "right, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.76,
      "end_seconds": 49.78,
      "duration_seconds": 2.02,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 59.97,
      "end_seconds": 70.58,
      "duration_seconds": 10.61,
      "text": "okay: respiratory rate 26 saturation 92 percent pulse is 86 beats a minute blood pressure 137 over 77 temperature is 37.1 degrees"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 72.18,
      "end_seconds": 73.65,
      "duration_seconds": 1.47,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.91,
      "end_seconds": 80.64,
      "duration_seconds": 5.73,
      "text": "we'll go over that shortly. Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.62,
      "end_seconds": 85.06,
      "duration_seconds": 2.44,
      "text": "about... well, two days"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.92,
      "end_seconds": 89.17,
      "duration_seconds": 3.25,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.87,
      "end_seconds": 103.39,
      "duration_seconds": 13.52,
      "text": "Right, um, about a a six out of ten. Erm, you know, I did have shortness of breath at one point, but that's gone now."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.64,
      "end_seconds": 113.12,
      "duration_seconds": 8.48,
      "text": "right, have you had sharp pain on the right side when you breathe in before, or is this the first time?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.26,
      "end_seconds": 123.36,
      "duration_seconds": 9.1,
      "text": "um yes something like this happened about six months ago and and it went away on its own"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.09,
      "end_seconds": 131.31,
      "duration_seconds": 6.22,
      "text": "okay, and what about vomiting, coughing up blood, confusion or leg swelling?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.42,
      "end_seconds": 136.22,
      "duration_seconds": 3.8,
      "text": "no, I haven't had any of them"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 137.86,
      "end_seconds": 139.87,
      "duration_seconds": 2.01,
      "text": "Has there been any palpitations?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.68,
      "end_seconds": 143.41,
      "duration_seconds": 1.73,
      "text": "definitely no palpitations"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.96,
      "end_seconds": 146.91,
      "duration_seconds": 2.95,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.42,
      "end_seconds": 152.06,
      "duration_seconds": 3.64,
      "text": "no uh that side's been fine"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.03,
      "end_seconds": 174.09,
      "duration_seconds": 3.06,
      "text": "are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 178.03,
      "end_seconds": 181.65,
      "duration_seconds": 3.62,
      "text": "my mother has an underactive thyroid"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.37,
      "end_seconds": 187.28,
      "duration_seconds": 3.91,
      "text": "do you have any medical conditions I should know about?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.79,
      "end_seconds": 192.81,
      "duration_seconds": 4.02,
      "text": "Actually, no, nothing I can think of."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.76,
      "end_seconds": 197.79,
      "duration_seconds": 3.03,
      "text": "So have you ever had an operation?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 198.57,
      "end_seconds": 204.33,
      "duration_seconds": 5.76,
      "text": "uh, just an operation for a hernia, last spring"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.07,
      "end_seconds": 216.01,
      "duration_seconds": 3.94,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.38,
      "end_seconds": 232.07,
      "duration_seconds": 14.69,
      "text": "I'll have a glass of wine with dinner. I gave up cigarettes last spring. I'm a plumber, lots of bending and kneeling. I swim twice a week"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.87,
      "end_seconds": 237.49,
      "duration_seconds": 4.62,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 239.51,
      "end_seconds": 244.81,
      "duration_seconds": 5.3,
      "text": "no, um, nothing as far as I know"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 245.47,
      "end_seconds": 247.92,
      "duration_seconds": 2.45,
      "text": "Any regular medication at all?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 252.29,
      "end_seconds": 254.91,
      "duration_seconds": 2.62,
      "text": "No, you know, none."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.08,
      "end_seconds": 259.67,
      "duration_seconds": 3.59,
      "text": "Let me look at the area I'll be gentle."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.56,
      "end_seconds": 262.88,
      "duration_seconds": 1.32,
      "text": "nearly finished here"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.35,
      "end_seconds": 275.02,
      "duration_seconds": 2.67,
      "text": "Breathing rate is a bit fast"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.72,
      "end_seconds": 287.66,
      "duration_seconds": 9.94,
      "text": "Good you can sit up again. Okay thinking it through the most likely explanation is a possible pneumonia on the right side."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.46,
      "end_seconds": 295.29,
      "duration_seconds": 5.83,
      "text": "Right, you know, I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 299.81,
      "end_seconds": 323.98,
      "duration_seconds": 24.17,
      "text": "Nothing I've seen today points to an emergency. It looks like a possible pneumonia on the right side, but I'd like to confirm. Let me just check I've got this right. You've had sharp pain on the the right side when you breathe in for two days, and no vomiting or palpitations."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.78,
      "end_seconds": 328.71,
      "duration_seconds": 3.93,
      "text": "Okay um so that's what happened yes."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.17,
      "end_seconds": 368.75,
      "duration_seconds": 26.58,
      "text": "let's book blood tests to look into infection let's book a chest X-ray to look into suspected pneumonia i'll start you on paracetamol 500 milligrams every six hours if needed for three days that should help with fever and body aches i'd like you to take amoxicillin-clavulanate 625 milligrams three times a day for five days that should help with chest infection"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.25,
      "end_seconds": 374.84,
      "duration_seconds": 5.59,
      "text": "sorry, what was I saying, fine, I'll begin it it"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 376.59,
      "end_seconds": 389.31,
      "duration_seconds": 12.72,
      "text": "Rest and fluids and finish every dose of the antibiotic. If you smoke this is a good moment to think about stopping and we can help you with that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 391.31,
      "end_seconds": 397.33,
      "duration_seconds": 6.02,
      "text": "let me think, should I have a sputum culture as well?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 398.98,
      "end_seconds": 411.89,
      "duration_seconds": 12.91,
      "text": "I wouldn't order it today. If anything changes, we'll reconsider. I'd like to see you again in three days. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 413.19,
      "end_seconds": 416.54,
      "duration_seconds": 3.35,
      "text": "good, thanks, I'll see you then"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 417.77,
      "end_seconds": 419.04,
      "duration_seconds": 1.27,
      "text": "All the best."
    }
  ]
}