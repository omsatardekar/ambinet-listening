{
  "schema_version": "1.0",
  "encounter_id": "01338",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.29,
      "end_seconds": 7.78,
      "duration_seconds": 6.49,
      "text": "So, you know, good evening, doctor, thanks for seeing me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 11.6,
      "end_seconds": 16.29,
      "duration_seconds": 4.69,
      "text": "Not at all, please sit. What seems to be wrong?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.0,
      "end_seconds": 31.26,
      "duration_seconds": 10.26,
      "text": "Um, so... a dry cough. That's why I came. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.96,
      "end_seconds": 37.8,
      "duration_seconds": 2.84,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 39.58,
      "end_seconds": 43.16,
      "duration_seconds": 3.58,
      "text": "So, it's been four weeks now."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 44.93,
      "end_seconds": 47.94,
      "duration_seconds": 3.01,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 49.06,
      "end_seconds": 52.09,
      "duration_seconds": 3.03,
      "text": "About a six out of ten."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.76,
      "end_seconds": 55.27,
      "duration_seconds": 2.51,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.25,
      "end_seconds": 65.56,
      "duration_seconds": 9.31,
      "text": "It, It comes and goes. I'd been getting breathless walking short distances, but that went away."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.22,
      "end_seconds": 83.47,
      "duration_seconds": 6.25,
      "text": "Okay, a few quick ones: chest pain, night sweats, leg swelling or weight loss?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.68,
      "end_seconds": 95.69,
      "duration_seconds": 7.01,
      "text": "No, no chest pain, night sweats, leg swelling or weight loss."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 100.37,
      "end_seconds": 103.02,
      "duration_seconds": 2.65,
      "text": "Any sign of coughing up blood?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 104.34,
      "end_seconds": 110.37,
      "duration_seconds": 6.03,
      "text": "Mm, you know, I haven't noticed any coughing up blood."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.27,
      "end_seconds": 116.0,
      "duration_seconds": 4.73,
      "text": "Okay, any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 121.43,
      "end_seconds": 123.52,
      "duration_seconds": 2.09,
      "text": "No, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.18,
      "end_seconds": 128.7,
      "duration_seconds": 3.52,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.27,
      "end_seconds": 131.89,
      "duration_seconds": 1.62,
      "text": "Nothing like that."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 132.95,
      "end_seconds": 137.41,
      "duration_seconds": 4.46,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.48,
      "end_seconds": 145.72,
      "duration_seconds": 6.24,
      "text": "Ah, I take Tiotropium inhaler, once a day for my chest."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.82,
      "end_seconds": 149.6,
      "duration_seconds": 2.78,
      "text": "Since when have you been taking it?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.74,
      "end_seconds": 160.69,
      "duration_seconds": 9.95,
      "text": "About a year now. Valsartan. I take it 80 milligrams, maybe, once a day for my blood pressure."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 162.16,
      "end_seconds": 166.21,
      "duration_seconds": 4.05,
      "text": "Alright, is the packet here, or the prescription?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.63,
      "end_seconds": 178.6,
      "duration_seconds": 7.97,
      "text": "Not with me. I'll bring it next time. Hydrochlorothiazide I don't take anymore."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.95,
      "end_seconds": 194.09,
      "duration_seconds": 2.14,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 195.6,
      "end_seconds": 204.96,
      "duration_seconds": 9.36,
      "text": "I had a caesarean for my second baby nine years ago. I told my wife I'd come today."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.12,
      "end_seconds": 210.14,
      "duration_seconds": 4.02,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 210.8,
      "end_seconds": 215.38,
      "duration_seconds": 4.58,
      "text": "Grass pollen. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 216.04,
      "end_seconds": 219.69,
      "duration_seconds": 3.65,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 221.72,
      "end_seconds": 233.4,
      "duration_seconds": 11.68,
      "text": "COPD, for five years. I took the morning off to come in today. I kept putting it off, which I know isn't sensible."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 233.94,
      "end_seconds": 234.64,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.99,
      "end_seconds": 250.96,
      "duration_seconds": 11.97,
      "text": "Ah, um, I have high blood pressure. I wasn't sure whether to come in at all, to be honest."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 251.51,
      "end_seconds": 254.12,
      "duration_seconds": 2.61,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.91,
      "end_seconds": 259.4,
      "duration_seconds": 3.49,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 261.18,
      "end_seconds": 264.2,
      "duration_seconds": 3.02,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.32,
      "end_seconds": 268.49,
      "duration_seconds": 3.17,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 271.18,
      "end_seconds": 272.37,
      "duration_seconds": 1.19,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.11,
      "end_seconds": 278.22,
      "duration_seconds": 4.11,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.08,
      "end_seconds": 282.35,
      "duration_seconds": 3.27,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.38,
      "end_seconds": 295.56,
      "duration_seconds": 2.18,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.57,
      "end_seconds": 320.78,
      "duration_seconds": 16.21,
      "text": "Okay: pulse is 98 beats a minute, pressure 132 over 76, BMI works out to 42.5, saturation 94 percent, respiratory rate 26, temp 37.5 degrees, weight 97 kilos, height 151 centimetres."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.46,
      "end_seconds": 324.71,
      "duration_seconds": 3.25,
      "text": "Erm, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.5,
      "end_seconds": 328.56,
      "duration_seconds": 2.06,
      "text": "We'll go over that shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 330.42,
      "end_seconds": 332.74,
      "duration_seconds": 2.32,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 333.63,
      "end_seconds": 334.33,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.16,
      "end_seconds": 337.8,
      "duration_seconds": 2.64,
      "text": "So, I'm just checking this side."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 356.34,
      "end_seconds": 360.49,
      "duration_seconds": 4.15,
      "text": "There are fine crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 362.02,
      "end_seconds": 364.17,
      "duration_seconds": 2.15,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 371.46,
      "end_seconds": 373.44,
      "duration_seconds": 1.98,
      "text": "No clubbing in the fingers."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.94,
      "end_seconds": 375.64,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 378.51,
      "end_seconds": 387.9,
      "duration_seconds": 9.39,
      "text": "You can sit up now. Okay, so my impression is this: The most likely explanation is chronic breathlessness that needs a proper work-up."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 388.61,
      "end_seconds": 392.3,
      "duration_seconds": 3.69,
      "text": "Right, what are the odds it's serious?"
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.81,
      "end_seconds": 403.78,
      "duration_seconds": 10.97,
      "text": "I understand the worry. At the moment I'd say it's chronic breathlessness that needs a proper work-up, and we'll know more once the an echocardiogram is back."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 415.39,
      "end_seconds": 445.09,
      "duration_seconds": 29.7,
      "text": "I'd like to arrange an echocardiogram for breathlessness. Try a daily walk and note how far you get before you need to stop. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Breathing tests is something we might do if this doesn't improve in a month. I'd like you back in four weeks. Okay, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 446.35,
      "end_seconds": 449.74,
      "duration_seconds": 3.39,
      "text": "Good, thanks, I'll see you then."
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 451.24,
      "end_seconds": 452.43,
      "duration_seconds": 1.19,
      "text": "See you soon."
    }
  ]
}