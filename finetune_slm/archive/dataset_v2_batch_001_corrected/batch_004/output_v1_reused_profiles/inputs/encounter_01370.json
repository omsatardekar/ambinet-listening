{
  "schema_version": "1.0",
  "encounter_id": "01370",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.24,
      "end_seconds": 5.38,
      "duration_seconds": 4.14,
      "text": "So, hello, doctor. I think it's my turn."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.66,
      "end_seconds": 10.72,
      "duration_seconds": 4.06,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.31,
      "end_seconds": 21.2,
      "duration_seconds": 9.89,
      "text": "I've, I've been feeling dizzy when I stand up, and I wanted to get it checked."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.1,
      "end_seconds": 25.96,
      "duration_seconds": 2.86,
      "text": "How long has it been like this?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.72,
      "end_seconds": 42.3,
      "duration_seconds": 14.58,
      "text": "Honestly I can't say exactly when it started. It might have been last month or the month before, I really can't pin it down."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.88,
      "end_seconds": 46.73,
      "duration_seconds": 2.85,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.33,
      "end_seconds": 51.34,
      "duration_seconds": 3.01,
      "text": "It happens on and off."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 53.07,
      "end_seconds": 56.14,
      "duration_seconds": 3.07,
      "text": "Is it bearing on you a lot?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.8,
      "end_seconds": 67.34,
      "duration_seconds": 10.54,
      "text": "Mild, I'd say. A pounding in my head was there, but it's gone away on its own."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.09,
      "end_seconds": 75.32,
      "duration_seconds": 6.23,
      "text": "Have you been feeling dizzy when you stand up at any time before this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 76.95,
      "end_seconds": 83.68,
      "duration_seconds": 6.73,
      "text": "A bit, about six months ago. It settled by itself back then."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 85.36,
      "end_seconds": 88.97,
      "duration_seconds": 3.61,
      "text": "Have you had slurred speech, by any chance?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 89.51,
      "end_seconds": 93.33,
      "duration_seconds": 3.82,
      "text": "Not that I've noticed, no slurred speech."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.31,
      "end_seconds": 98.64,
      "duration_seconds": 4.33,
      "text": "So, did you get chest pain, vomiting or black stools?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.61,
      "end_seconds": 104.78,
      "duration_seconds": 5.17,
      "text": "Okay, uh, so no, none that I've noticed."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 109.58,
      "end_seconds": 113.29,
      "duration_seconds": 3.71,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 114.25,
      "end_seconds": 117.64,
      "duration_seconds": 3.39,
      "text": "Erm, no, nothing with my heart."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.77,
      "end_seconds": 122.21,
      "duration_seconds": 3.44,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.04,
      "end_seconds": 127.79,
      "duration_seconds": 1.75,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 129.24,
      "end_seconds": 131.25,
      "duration_seconds": 2.01,
      "text": "And alcohol, how much?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 132.36,
      "end_seconds": 134.14,
      "duration_seconds": 1.78,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.67,
      "end_seconds": 137.75,
      "duration_seconds": 2.08,
      "text": "Right, do you smoke?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 143.38,
      "duration_seconds": 4.16,
      "text": "No, I've never smoked in my life."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 145.18,
      "end_seconds": 147.69,
      "duration_seconds": 2.51,
      "text": "Alright, do you live by yourself?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 149.7,
      "end_seconds": 154.16,
      "duration_seconds": 4.46,
      "text": "No, I share a house with my brother."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 156.22,
      "end_seconds": 157.63,
      "duration_seconds": 1.41,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 159.63,
      "end_seconds": 163.79,
      "duration_seconds": 4.16,
      "text": "I'm a plumber, lots of bending and kneeling."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.64,
      "end_seconds": 167.74,
      "duration_seconds": 2.1,
      "text": "So, how active are you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 169.79,
      "end_seconds": 173.31,
      "duration_seconds": 3.52,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.62,
      "end_seconds": 186.13,
      "duration_seconds": 2.51,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 187.03,
      "end_seconds": 189.65,
      "duration_seconds": 2.62,
      "text": "I've got an enlarged prostate."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 191.11,
      "end_seconds": 201.27,
      "duration_seconds": 10.16,
      "text": "Yes. Yes, an enlarged prostate is known to us, good to have that clear. So, what's on your current medicine list?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 203.25,
      "end_seconds": 209.04,
      "duration_seconds": 5.79,
      "text": "I'm on tamsulosin, 0.4 milligrams, at night for the prostate."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 210.37,
      "end_seconds": 213.39,
      "duration_seconds": 3.02,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 214.38,
      "end_seconds": 216.82,
      "duration_seconds": 2.44,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.52,
      "end_seconds": 222.26,
      "duration_seconds": 3.74,
      "text": "Is there anything relevant on the family side?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 224.23,
      "end_seconds": 227.23,
      "duration_seconds": 3.0,
      "text": "Um, my cousin has psoriasis."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.29,
      "end_seconds": 231.45,
      "duration_seconds": 3.16,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.27,
      "end_seconds": 247.75,
      "duration_seconds": 3.48,
      "text": "Okay, bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 257.03,
      "end_seconds": 263.86,
      "duration_seconds": 6.83,
      "text": "Okay: pressure 101 over 63, temperature is 36.9 degrees. And respiratory rate 17, pulse 106."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 265.61,
      "end_seconds": 267.43,
      "duration_seconds": 1.82,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 268.25,
      "end_seconds": 270.96,
      "duration_seconds": 2.71,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.02,
      "end_seconds": 276.67,
      "duration_seconds": 3.65,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.63,
      "end_seconds": 290.74,
      "duration_seconds": 1.11,
      "text": "Sure thing."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.49,
      "end_seconds": 294.85,
      "duration_seconds": 2.36,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.5,
      "end_seconds": 317.43,
      "duration_seconds": 3.93,
      "text": "Heart sounds are normal and the chest is clear."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.78,
      "end_seconds": 341.48,
      "duration_seconds": 20.7,
      "text": "That's all I needed to check. Okay, thinking it through, the most likely explanation is postural low blood pressure, possibly related to medicines or dehydration. The reason I say that is that your story and my examination fit together. Dehydration is still possible."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 345.86,
      "end_seconds": 348.94,
      "duration_seconds": 3.08,
      "text": "Do you think it's something serious?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 354.94,
      "end_seconds": 367.16,
      "duration_seconds": 12.22,
      "text": "It's reasonable to be concerned, but right now postural low blood pressure, possibly related to medicines or dehydration is my leading thought, not anything worse."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 385.07,
      "end_seconds": 388.53,
      "duration_seconds": 3.46,
      "text": "I'd like to arrange an ECG for dizziness."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.73,
      "end_seconds": 394.63,
      "duration_seconds": 4.9,
      "text": "Let me think, um, that's fine with me."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 395.28,
      "end_seconds": 425.73,
      "duration_seconds": 30.45,
      "text": "I'd like to arrange a lying and standing blood pressure check for dizziness. I'll request blood tests, it'll help with dizziness. Get up slowly from lying and sitting, and keep drinking fluids through the day. If you faint or have chest pain, or you feel really unwell, please come to the emergency department. Anything else on your mind before you go?"
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 429.22,
      "end_seconds": 432.75,
      "duration_seconds": 3.53,
      "text": "Good, thanks, I'll see you then."
    }
  ]
}