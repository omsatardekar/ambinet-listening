{
  "schema_version": "1.0",
  "encounter_id": "01340",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.57,
      "end_seconds": 5.17,
      "duration_seconds": 4.6,
      "text": "Hi, is it okay to come in now?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.61,
      "end_seconds": 10.86,
      "duration_seconds": 4.25,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.47,
      "end_seconds": 22.22,
      "duration_seconds": 9.75,
      "text": "Yeah, uh, it's pins and needles in my hands and feet. I don't know what's causing it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.46,
      "end_seconds": 27.23,
      "duration_seconds": 3.77,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.15,
      "end_seconds": 31.75,
      "duration_seconds": 3.6,
      "text": "It's been going on for three weeks."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 33.5,
      "end_seconds": 42.18,
      "duration_seconds": 8.68,
      "text": "Tell me a bit more about it: how bad it gets, how often, and whether anything makes it better or worse."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 44.18,
      "end_seconds": 51.62,
      "duration_seconds": 7.44,
      "text": "About a eight out of ten. I'd say a couple of times a week."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 52.44,
      "end_seconds": 55.3,
      "duration_seconds": 2.86,
      "text": "Is there anything else with it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 57.35,
      "end_seconds": 60.78,
      "duration_seconds": 3.43,
      "text": "It usually comes with a sore tongue."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.7,
      "end_seconds": 65.18,
      "duration_seconds": 3.48,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 66.72,
      "end_seconds": 73.23,
      "duration_seconds": 6.51,
      "text": "Moderate, I'd say. And I've been forgetting words as well, for nearly five years."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 75.02,
      "end_seconds": 79.66,
      "duration_seconds": 4.64,
      "text": "Right, have you noticed loss of vision, rash or bladder problems?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 80.47,
      "end_seconds": 82.43,
      "duration_seconds": 1.96,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.29,
      "end_seconds": 87.0,
      "duration_seconds": 3.71,
      "text": "Have you noticed diarrhoea or weakness of one side?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.62,
      "end_seconds": 90.82,
      "duration_seconds": 2.2,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 91.24,
      "end_seconds": 95.13,
      "duration_seconds": 3.89,
      "text": "Yes. How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.71,
      "end_seconds": 100.22,
      "duration_seconds": 4.51,
      "text": "My heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 101.64,
      "end_seconds": 104.58,
      "duration_seconds": 2.94,
      "text": "Any rashes or skin problems otherwise?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 105.62,
      "end_seconds": 106.75,
      "duration_seconds": 1.13,
      "text": "No rashes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.46,
      "end_seconds": 111.17,
      "duration_seconds": 2.71,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.15,
      "end_seconds": 116.4,
      "duration_seconds": 4.25,
      "text": "Nothing, um, I haven't had any operations."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.63,
      "end_seconds": 132.03,
      "duration_seconds": 5.4,
      "text": "So, are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 133.44,
      "end_seconds": 136.93,
      "duration_seconds": 3.49,
      "text": "No, nothing as far as I know."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 146.35,
      "end_seconds": 150.21,
      "duration_seconds": 3.86,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.63,
      "end_seconds": 153.1,
      "duration_seconds": 1.47,
      "text": "Yes, acid reflux."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.7,
      "end_seconds": 156.28,
      "duration_seconds": 1.58,
      "text": "Yes, carry on."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.71,
      "end_seconds": 158.93,
      "duration_seconds": 1.22,
      "text": "Yes, diabetes."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 160.92,
      "end_seconds": 167.89,
      "duration_seconds": 6.97,
      "text": "Right, so diabetes is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.87,
      "end_seconds": 187.94,
      "duration_seconds": 4.07,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.41,
      "end_seconds": 192.49,
      "duration_seconds": 3.08,
      "text": "I take omeprazole, once a day."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 193.26,
      "end_seconds": 195.49,
      "duration_seconds": 2.23,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 196.8,
      "end_seconds": 211.36,
      "duration_seconds": 14.56,
      "text": "20 milligrams, I think that's what's on the box. It's metformin, 500 milligrams, twice a day for my sugar. I was on glimepiride before. I stopped taking it."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.84,
      "end_seconds": 217.97,
      "duration_seconds": 3.13,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.56,
      "end_seconds": 229.79,
      "duration_seconds": 11.23,
      "text": "My husband and I live above the shop. I'm vegetarian and have been for years. I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.0,
      "end_seconds": 233.65,
      "duration_seconds": 2.65,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.18,
      "end_seconds": 244.61,
      "duration_seconds": 2.43,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.21,
      "end_seconds": 269.22,
      "duration_seconds": 6.01,
      "text": "Okay: pressure 119 over 82, temperature 36.5, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.9,
      "end_seconds": 273.28,
      "duration_seconds": 2.38,
      "text": "Shall I start the examination?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.0,
      "end_seconds": 277.02,
      "duration_seconds": 2.02,
      "text": "I'm just checking this side."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.08,
      "end_seconds": 290.02,
      "duration_seconds": 3.94,
      "text": "Your vibration sense is reduced at the ankles."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.18,
      "end_seconds": 293.5,
      "duration_seconds": 2.32,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.73,
      "end_seconds": 306.49,
      "duration_seconds": 2.76,
      "text": "The tongue looks smooth and red."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.24,
      "end_seconds": 322.41,
      "duration_seconds": 10.17,
      "text": "All finished, thank you. Taking everything into account, this looks most like symptoms that fit a vitamin B12 deficiency. Another possibility is an under-active thyroid."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 324.06,
      "end_seconds": 325.98,
      "duration_seconds": 1.92,
      "text": "Is it dangerous, doctor?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 326.87,
      "end_seconds": 341.34,
      "duration_seconds": 14.47,
      "text": "I understand the worry. At the moment I'd say it's symptoms that fit a vitamin B12 deficiency, and we'll watch how it goes. Today I'm not changing anything. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 342.99,
      "end_seconds": 345.39,
      "duration_seconds": 2.4,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.26,
      "end_seconds": 347.92,
      "duration_seconds": 1.66,
      "text": "Have a good day."
    }
  ]
}