{
  "schema_version": "1.0",
  "encounter_id": "01441",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.88,
      "end_seconds": 4.06,
      "duration_seconds": 3.18,
      "text": "Right, thanks for waiting, come in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 4.76,
      "end_seconds": 10.39,
      "duration_seconds": 5.63,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 13.68,
      "end_seconds": 15.78,
      "duration_seconds": 2.1,
      "text": "weather's turned, hasn't it?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 16.95,
      "end_seconds": 21.5,
      "duration_seconds": 4.55,
      "text": "It has. I got caught in the rain walking over."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.75,
      "end_seconds": 24.5,
      "duration_seconds": 1.75,
      "text": "What's the the problem?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 26.06,
      "end_seconds": 28.89,
      "duration_seconds": 2.83,
      "text": "We came because of swollen ankles."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 29.43,
      "end_seconds": 32.58,
      "duration_seconds": 3.15,
      "text": "How long has this been bothering you?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 33.23,
      "end_seconds": 38.65,
      "duration_seconds": 5.42,
      "text": "Sorry, what was I saying, I'd say three days, maybe."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 40.04,
      "end_seconds": 44.26,
      "duration_seconds": 4.22,
      "text": "I think it's been nearer five days, actually."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 45.08,
      "end_seconds": 49.33,
      "duration_seconds": 4.25,
      "text": "Okay, so roughly three to five days. Is that right?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 50.87,
      "end_seconds": 52.89,
      "duration_seconds": 2.02,
      "text": "Yes, somewhere around that."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.3,
      "end_seconds": 58.58,
      "duration_seconds": 5.28,
      "text": "Ah. Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 59.16,
      "end_seconds": 86.68,
      "duration_seconds": 27.52,
      "text": "it's worse with standing and evenings. Mild, I'd say i've also been waking up breathless at night, for about three months and there's breathlessness lying flat as well, about three months now as for breathlessness lying flat, it's on and off. Lying flat definitely sets it off only propping myself on pillows, and it's not much"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 87.03,
      "end_seconds": 87.98,
      "duration_seconds": 0.95,
      "text": "right, right"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 95.22,
      "end_seconds": 97.73,
      "duration_seconds": 2.51,
      "text": "let me quickly check your readings"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 107.27,
      "end_seconds": 110.41,
      "duration_seconds": 3.14,
      "text": "okay, bear with me while this finishes.."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 128.69,
      "end_seconds": 141.13,
      "duration_seconds": 12.44,
      "text": "Okay: pulse is 109 beats a minute, temperature 36.9, pressure 112 over 84, height 186 centimetres, weight 57 kilos, BMI works out to 16.5."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 143.33,
      "end_seconds": 147.04,
      "duration_seconds": 3.71,
      "text": "Now I'm going to do a short physical check."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 147.93,
      "end_seconds": 150.68,
      "duration_seconds": 2.75,
      "text": "stay as you are for a moment"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.24,
      "end_seconds": 168.53,
      "duration_seconds": 4.29,
      "text": "I can hear crackles at the bases of both lungs."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.38,
      "end_seconds": 171.55,
      "duration_seconds": 1.17,
      "text": "look straight ahead"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 181.75,
      "end_seconds": 186.04,
      "duration_seconds": 4.29,
      "text": "there is pitting swelling up to the shins on both sides"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 190.95,
      "end_seconds": 197.19,
      "duration_seconds": 6.24,
      "text": "you can sit up now. A few quick ones: calf pain or fainting?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 198.36,
      "end_seconds": 201.16,
      "duration_seconds": 2.8,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 201.86,
      "end_seconds": 205.7,
      "duration_seconds": 3.84,
      "text": "A few quick ones: cough with blood or palpitations?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 207.12,
      "end_seconds": 209.33,
      "duration_seconds": 2.21,
      "text": "None of those, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.88,
      "end_seconds": 213.45,
      "duration_seconds": 3.57,
      "text": "Right, have you had any chest pain?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 214.26,
      "end_seconds": 218.07,
      "duration_seconds": 3.81,
      "text": "not that that I've noticed, no chest pain"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 219.19,
      "end_seconds": 223.08,
      "duration_seconds": 3.89,
      "text": "any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 223.9,
      "end_seconds": 225.39,
      "duration_seconds": 1.49,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.12,
      "end_seconds": 229.19,
      "duration_seconds": 2.07,
      "text": "Any surgery in the past?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 231.13,
      "end_seconds": 235.37,
      "duration_seconds": 4.24,
      "text": "Just my womb taken out, fifteen years ago."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 236.54,
      "end_seconds": 239.5,
      "duration_seconds": 2.96,
      "text": "Has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 240.93,
      "end_seconds": 249.05,
      "duration_seconds": 8.12,
      "text": "Heart failure, for about ten years i've had an irregular heartbeat for about ten years now"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 249.74,
      "end_seconds": 258.83,
      "duration_seconds": 9.09,
      "text": "Okay, I can see heart failure and an irregular heartbeat in your file as well. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 262.63,
      "end_seconds": 278.53,
      "duration_seconds": 15.9,
      "text": "She is on furosemide, 40 milligrams, every morning, I give it to her. She is on metoprolol, 50 milligrams, twice a day for the heart rhythm, I give it to her."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 280.18,
      "end_seconds": 283.02,
      "duration_seconds": 2.84,
      "text": "how long have you taken that?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "FAMILY_MEMBER",
      "start_seconds": 284.95,
      "end_seconds": 286.27,
      "duration_seconds": 1.32,
      "text": "about six months"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 298.43,
      "end_seconds": 300.78,
      "duration_seconds": 2.35,
      "text": "Tell me about your eating."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 302.64,
      "end_seconds": 307.93,
      "duration_seconds": 5.29,
      "text": "I drink a lot of tea and snack through the day."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 309.13,
      "end_seconds": 310.38,
      "duration_seconds": 1.25,
      "text": "What's your work?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 312.28,
      "end_seconds": 316.13,
      "duration_seconds": 3.85,
      "text": "I'm a plumber, lots of bending and kneeling"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 318.17,
      "end_seconds": 320.62,
      "duration_seconds": 2.45,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 322.24,
      "end_seconds": 324.94,
      "duration_seconds": 2.7,
      "text": "Not to my knowledge, no."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 326.81,
      "end_seconds": 329.81,
      "duration_seconds": 3.0,
      "text": "Are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 331.32,
      "end_seconds": 333.18,
      "duration_seconds": 1.86,
      "text": "My grandmother had dementia."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.71,
      "end_seconds": 353.18,
      "duration_seconds": 8.47,
      "text": "Just to be sure I understood. You've had swollen ankles, mild, and no palpitations or calf pain."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 354.25,
      "end_seconds": 355.98,
      "duration_seconds": 1.73,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 356.62,
      "end_seconds": 387.35,
      "duration_seconds": 30.73,
      "text": "I want a chest X-ray done, that's for breathlessness. Keep the salt low and avoid adding it at the table. Avoid taking any extra painkillers on top of what I'm prescribing without checking with us. I'd like you to see the community nursing team as well, and I'll write the referral. Come back after the heart scan. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_3",
      "role": "PATIENT",
      "start_seconds": 388.43,
      "end_seconds": 392.15,
      "duration_seconds": 3.72,
      "text": "Okay, that that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 392.89,
      "end_seconds": 394.65,
      "duration_seconds": 1.76,
      "text": "Have a good day."
    }
  ]
}