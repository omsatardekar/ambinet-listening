{
  "schema_version": "1.0",
  "encounter_id": "01334",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.78,
      "end_seconds": 4.99,
      "duration_seconds": 4.21,
      "text": "Ah, morning, doctor. Is this the right room?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.69,
      "end_seconds": 11.15,
      "duration_seconds": 5.46,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.2,
      "end_seconds": 19.56,
      "duration_seconds": 7.36,
      "text": "It's a bump on my head. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.5,
      "end_seconds": 23.32,
      "duration_seconds": 1.82,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.69,
      "end_seconds": 32.5,
      "duration_seconds": 7.81,
      "text": "Well, probably five days. Yeah. I just want to get back to normal, really."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.43,
      "end_seconds": 37.77,
      "duration_seconds": 3.34,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.87,
      "end_seconds": 50.39,
      "duration_seconds": 2.52,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.32,
      "end_seconds": 77.91,
      "duration_seconds": 9.59,
      "text": "Okay: saturation 97 percent, temp 36.9 degrees, heart rate 69, blood pressure 126 over 76, respiratory rate 17."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 79.63,
      "end_seconds": 84.01,
      "duration_seconds": 4.38,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.1,
      "end_seconds": 91.8,
      "duration_seconds": 0.7,
      "text": "Right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 93.0,
      "end_seconds": 96.26,
      "duration_seconds": 3.26,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 110.03,
      "end_seconds": 117.96,
      "duration_seconds": 7.93,
      "text": "There is a small bruise on the forehead, the pupils are equal and reactive, and you are walking steadily."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 118.84,
      "end_seconds": 120.34,
      "duration_seconds": 1.5,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.18,
      "end_seconds": 129.43,
      "duration_seconds": 6.25,
      "text": "Thank you, you can get dressed. A few quick ones: weakness or vomiting?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 131.1,
      "end_seconds": 134.01,
      "duration_seconds": 2.91,
      "text": "No, none of those at all."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 134.89,
      "end_seconds": 138.7,
      "duration_seconds": 3.81,
      "text": "Did you get double vision or loss of consciousness?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.22,
      "end_seconds": 141.71,
      "duration_seconds": 2.49,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 143.81,
      "end_seconds": 146.85,
      "duration_seconds": 3.04,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 148.77,
      "end_seconds": 152.15,
      "duration_seconds": 3.38,
      "text": "Okay, so no, joints are fine."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 153.71,
      "end_seconds": 156.33,
      "duration_seconds": 2.62,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.18,
      "end_seconds": 160.49,
      "duration_seconds": 3.31,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 177.8,
      "end_seconds": 182.53,
      "duration_seconds": 4.73,
      "text": "Let's talk a little about your daily life and habits."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 184.06,
      "end_seconds": 199.36,
      "duration_seconds": 15.3,
      "text": "I used to drink heavily but I stopped four years ago. No, I share a house with my brother. I hardly move around during the day. Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.9,
      "end_seconds": 216.03,
      "duration_seconds": 3.13,
      "text": "Which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 216.64,
      "end_seconds": 229.68,
      "duration_seconds": 13.04,
      "text": "Losartan, 50 milligrams, once a day. I looked a few things up online, and that probably didn't help. I took the morning off to come in today."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 244.33,
      "end_seconds": 248.11,
      "duration_seconds": 3.78,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 249.07,
      "end_seconds": 252.98,
      "duration_seconds": 3.91,
      "text": "I have high blood pressure, for five years."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.32,
      "end_seconds": 274.26,
      "duration_seconds": 17.94,
      "text": "Okay, so my impression is this: I'd lean towards a minor head injury without worrying signs. Let me just check I've got this right. You've had a bump on your head for five days, and no vomiting or weakness."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 274.9,
      "end_seconds": 275.6,
      "duration_seconds": 0.7,
      "text": "Correct."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 281.08,
      "end_seconds": 303.49,
      "duration_seconds": 22.41,
      "text": "Let's use paracetamol, 1 gram, every six hours if needed, for three days. It's for headache. Someone should stay with you tonight, and no alcohol or contact sport for now. Try to keep a simple diary of when it happens and what you were doing, and bring it to the next visit."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 303.75,
      "end_seconds": 309.53,
      "duration_seconds": 5.78,
      "text": "Right, right. I'd like to see you again if the headache gets worse."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 310.63,
      "end_seconds": 312.86,
      "duration_seconds": 2.23,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 313.43,
      "end_seconds": 319.34,
      "duration_seconds": 5.91,
      "text": "Can you run through the plan with me quickly, just to be certain?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 320.96,
      "end_seconds": 331.93,
      "duration_seconds": 10.97,
      "text": "So, I take the paracetamol, 1 gram, every six hours if needed and come back if the headache gets worse. Is that right?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.17,
      "end_seconds": 336.81,
      "duration_seconds": 3.64,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 338.22,
      "end_seconds": 341.06,
      "duration_seconds": 2.84,
      "text": "Well, thank you, that's helpful."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 342.13,
      "end_seconds": 343.3,
      "duration_seconds": 1.17,
      "text": "Look after yourself."
    }
  ]
}