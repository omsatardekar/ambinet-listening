{
  "schema_version": "1.0",
  "encounter_id": "01401",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.81,
      "end_seconds": 2.9,
      "duration_seconds": 2.09,
      "text": "Right then, come on in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 4.77,
      "end_seconds": 8.29,
      "duration_seconds": 3.52,
      "text": "Hello, thanks for fitting me in."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 10.11,
      "end_seconds": 13.09,
      "duration_seconds": 2.98,
      "text": "So what can I do for you?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 17.57,
      "end_seconds": 21.26,
      "duration_seconds": 3.69,
      "text": "So, I've been feeling very thirsty, doctor."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 22.03,
      "end_seconds": 23.58,
      "duration_seconds": 1.55,
      "text": "When did this begin?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 24.29,
      "end_seconds": 26.75,
      "duration_seconds": 2.46,
      "text": "For three weeks, I'd say."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 27.52,
      "end_seconds": 31.13,
      "duration_seconds": 3.61,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 32.85,
      "end_seconds": 35.56,
      "duration_seconds": 2.71,
      "text": "It feels mild to me."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.65,
      "end_seconds": 38.24,
      "duration_seconds": 1.59,
      "text": "Any tiredness as well?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 38.78,
      "end_seconds": 47.3,
      "duration_seconds": 8.52,
      "text": "Yes, I have. I had itching around the private area before. That's settled now, though."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 47.98,
      "end_seconds": 51.42,
      "duration_seconds": 3.44,
      "text": "And what about vomiting, fever or abdominal pain?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 53.22,
      "end_seconds": 56.79,
      "duration_seconds": 3.57,
      "text": "No, no vomiting, fever or abdominal pain."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 57.81,
      "end_seconds": 62.51,
      "duration_seconds": 4.7,
      "text": "Have you had any blurred vision or fruity smell on the breath?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.88,
      "end_seconds": 68.62,
      "duration_seconds": 4.74,
      "text": "No, no blurred vision or fruity smell on the breath."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 70.05,
      "end_seconds": 72.87,
      "duration_seconds": 2.82,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 73.76,
      "end_seconds": 74.74,
      "duration_seconds": 0.98,
      "text": "Breathing's normal."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 78.27,
      "end_seconds": 80.88,
      "duration_seconds": 2.61,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.17,
      "end_seconds": 91.43,
      "duration_seconds": 9.26,
      "text": "I've had heart failure for nearly five years now. I've got thin bones. Heart disease, for about ten years."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 92.89,
      "end_seconds": 94.26,
      "duration_seconds": 1.37,
      "text": "Okay, what else?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.41,
      "end_seconds": 104.83,
      "duration_seconds": 1.42,
      "text": "How about smoking?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.87,
      "end_seconds": 111.54,
      "duration_seconds": 2.67,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 112.5,
      "end_seconds": 115.84,
      "duration_seconds": 3.34,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.84,
      "end_seconds": 120.61,
      "duration_seconds": 2.77,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 121.84,
      "end_seconds": 123.07,
      "duration_seconds": 1.23,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 127.33,
      "end_seconds": 130.2,
      "duration_seconds": 2.87,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.24,
      "end_seconds": 135.89,
      "duration_seconds": 4.65,
      "text": "Can you list what you take, tablets, creams or inhalers?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 137.05,
      "end_seconds": 150.22,
      "duration_seconds": 13.17,
      "text": "It's carvedilol, 6.25 milligrams, twice a day. Though honestly, some days I forget to take it. Alendronate, 70 milligrams, maybe, once a week for my bones."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 152.06,
      "end_seconds": 156.84,
      "duration_seconds": 4.78,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 157.81,
      "end_seconds": 164.41,
      "duration_seconds": 6.6,
      "text": "No, it's at home. I take clopidogrel, 75 milligrams, once a day."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.93,
      "end_seconds": 165.63,
      "duration_seconds": 0.7,
      "text": "Understood."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 176.67,
      "end_seconds": 181.24,
      "duration_seconds": 4.57,
      "text": "Alright, do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 181.89,
      "end_seconds": 187.87,
      "duration_seconds": 5.98,
      "text": "Not currently, but as a youngster erythromycin gave me a rash."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 196.55,
      "end_seconds": 200.1,
      "duration_seconds": 3.55,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 209.64,
      "end_seconds": 212.52,
      "duration_seconds": 2.88,
      "text": "Alright, keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.21,
      "end_seconds": 239.69,
      "duration_seconds": 13.48,
      "text": "Okay: temperature 36.4, weight 78 kilos, height 172 centimetres. And BMI works out to 26.4, pulse is 76 beats a minute, pressure 118 over 76."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 240.28,
      "end_seconds": 241.85,
      "duration_seconds": 1.57,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 242.86,
      "end_seconds": 246.54,
      "duration_seconds": 3.68,
      "text": "I'll explain what these mean in a moment."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 247.64,
      "end_seconds": 250.95,
      "duration_seconds": 3.31,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 252.22,
      "end_seconds": 253.88,
      "duration_seconds": 1.66,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 272.19,
      "end_seconds": 277.24,
      "duration_seconds": 5.05,
      "text": "You're a little dry, but alert, and your breathing is normal."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.12,
      "end_seconds": 281.15,
      "duration_seconds": 2.03,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 290.88,
      "end_seconds": 293.42,
      "duration_seconds": 2.54,
      "text": "Your tummy is soft and non-tender."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 295.98,
      "end_seconds": 318.18,
      "duration_seconds": 22.2,
      "text": "Thank you, you can get dressed. Okay, thinking it through, this is probably possible new-onset diabetes. I want to be honest that this is an impression, not a final answer. It could also be diabetes insipidus, so we'll keep that open. Have you had any tests for this so far?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 323.47,
      "end_seconds": 330.53,
      "duration_seconds": 7.06,
      "text": "I did have a urine test done last year, but the paper's at home."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 332.05,
      "end_seconds": 336.97,
      "duration_seconds": 4.92,
      "text": "I'm sending you for an HbA1c because of possible diabetes."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_3",
      "role": "CLINICAL_STAFF",
      "start_seconds": 338.43,
      "end_seconds": 341.31,
      "duration_seconds": 2.88,
      "text": "The earliest is Thursday, 11:30 am."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.09,
      "end_seconds": 344.18,
      "duration_seconds": 1.09,
      "text": "That's fine."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.57,
      "end_seconds": 375.95,
      "duration_seconds": 30.38,
      "text": "I want a blood sugar test done, that's for polydipsia and polyuria. Until we have the results, avoid sugary drinks and fruit juices, and keep drinking plain water. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose. Keep an eye out, and if you start vomiting or become drowsy, call us the same day or go to emergency. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 377.82,
      "end_seconds": 379.41,
      "duration_seconds": 1.59,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 380.4,
      "end_seconds": 382.44,
      "duration_seconds": 2.04,
      "text": "So, all the best."
    }
  ]
}