  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.86,
      "end_seconds": 7.17,
      "duration_seconds": 6.31,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 8.61,
      "end_seconds": 12.82,
      "duration_seconds": 4.21,
      "text": "of course, leave it there how can I help?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.82,
      "end_seconds": 20.04,
      "duration_seconds": 5.22,
      "text": "I'm here because of bloating after milk or ice cream."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 21.36,
      "end_seconds": 23.23,
      "duration_seconds": 1.87,
      "text": "So, since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.29,
      "end_seconds": 28.03,
      "duration_seconds": 3.74,
      "text": "Since last Tuesday, that's when it began."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.61,
      "end_seconds": 34.34,
      "duration_seconds": 4.73,
      "text": "what about loose stools after dairy, have you noticed that?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.01,
      "end_seconds": 38.16,
      "duration_seconds": 2.15,
      "text": "yes that started yesterday"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 43.45,
      "end_seconds": 47.37,
      "duration_seconds": 3.92,
      "text": "how much trouble does it it give you?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.01,
      "end_seconds": 49.59,
      "duration_seconds": 1.58,
      "text": "I'd say moderate."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.83,
      "end_seconds": 54.77,
      "duration_seconds": 3.94,
      "text": "do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 56.01,
      "end_seconds": 59.83,
      "duration_seconds": 3.82,
      "text": "I don't think I have any, no."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.69,
      "end_seconds": 64.27,
      "duration_seconds": 2.58,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 65.51,
      "end_seconds": 69.59,
      "duration_seconds": 4.08,
      "text": "I've had depression for nearly five years now."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.15,
      "end_seconds": 75.84,
      "duration_seconds": 4.69,
      "text": "Okay I can see depression in your file as well."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.15,
      "end_seconds": 86.33,
      "duration_seconds": 2.18,
      "text": "tell me about your eating"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 88.34,
      "end_seconds": 93.29,
      "duration_seconds": 4.95,
      "text": "I drink a lot of tea and snack through the day"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.19,
      "end_seconds": 96.91,
      "duration_seconds": 1.72,
      "text": "how active are you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.45,
      "end_seconds": 100.92,
      "duration_seconds": 3.47,
      "text": "I hardly move around during the day"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.11,
      "end_seconds": 112.65,
      "duration_seconds": 4.54,
      "text": "any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.14,
      "end_seconds": 121.88,
      "duration_seconds": 2.74,
      "text": "My mother has an underactive thyroid."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.7,
      "end_seconds": 129.37,
      "duration_seconds": 3.67,
      "text": "Okay which medicines do you take at the moment?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.34,
      "end_seconds": 145.65,
      "duration_seconds": 15.31,
      "text": "Fluoxetine. I take it 20 milligrams, every morning for my mood. I do miss it now and then, to be fair. I'd been on mirtazapine, not any more though, I stopped"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 147.42,
      "end_seconds": 149.73,
      "duration_seconds": 2.31,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 150.67,
      "end_seconds": 155.89,
      "duration_seconds": 5.22,
      "text": "yes, I had a varicose vein procedure, last year"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 169.75,
      "end_seconds": 172.19,
      "duration_seconds": 2.44,
      "text": "did you get vomiting or fever?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 172.84,
      "end_seconds": 176.75,
      "duration_seconds": 3.91,
      "text": "I haven't had vomiting or fever, no."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 178.5,
      "end_seconds": 182.28,
      "duration_seconds": 3.78,
      "text": "Did you get night-time symptoms, weight loss or rash?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.23,
      "end_seconds": 185.95,
      "duration_seconds": 2.72,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.69,
      "end_seconds": 189.11,
      "duration_seconds": 1.42,
      "text": "neurologically, anything strange?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.98,
      "end_seconds": 191.45,
      "duration_seconds": 1.47,
      "text": "nothing odd there"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 192.83,
      "end_seconds": 195.64,
      "duration_seconds": 2.81,
      "text": "I'll just record a few vital signs"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.43,
      "end_seconds": 210.84,
      "duration_seconds": 2.41,
      "text": "okay, this won't take long.."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 231.24,
      "end_seconds": 237.12,
      "duration_seconds": 5.88,
      "text": "Okay: pulse is 68 beats a minute, blood pressure 116 over 76."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.19,
      "end_seconds": 240.43,
      "duration_seconds": 2.24,
      "text": "is that alright, doctor?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 241.03,
      "end_seconds": 244.2,
      "duration_seconds": 3.17,
      "text": "I'll interpret them after the the examination"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 246.97,
      "end_seconds": 250.77,
      "duration_seconds": 3.8,
      "text": "Could you come over to the couch, please?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.04,
      "end_seconds": 254.5,
      "duration_seconds": 2.46,
      "text": "so, raise your arm for me"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.68,
      "end_seconds": 268.19,
      "duration_seconds": 4.51,
      "text": "Your tummy is soft and non-tender, with active bowel sounds."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.09,
      "end_seconds": 273.16,
      "duration_seconds": 1.07,
      "text": "okay doctor"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 275.55,
      "end_seconds": 299.88,
      "duration_seconds": 24.33,
      "text": "so you can relax now. From what you've told me and what I found it fits best with lactose intolerance. That's my thinking for now and it may change as we learn more. Try two weeks without dairy and tell me if it makes a difference. Right that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 304.99,
      "end_seconds": 307.99,
      "duration_seconds": 3.0,
      "text": "I think I understand everything thanks"
    }
  ]
