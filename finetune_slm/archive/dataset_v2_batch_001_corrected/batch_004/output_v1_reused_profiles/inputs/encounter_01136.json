{
  "schema_version": "1.0",
  "encounter_id": "01136",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.69,
      "end_seconds": 4.23,
      "duration_seconds": 3.54,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.24,
      "end_seconds": 10.81,
      "duration_seconds": 4.57,
      "text": "you're alright, take a seat what can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.81,
      "end_seconds": 17.21,
      "duration_seconds": 4.4,
      "text": "Um, so... heavy periods. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.29,
      "end_seconds": 23.63,
      "duration_seconds": 4.34,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.86,
      "end_seconds": 35.24,
      "duration_seconds": 2.38,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 50.79,
      "end_seconds": 61.46,
      "duration_seconds": 10.67,
      "text": "Okay: respiratory rate 17, temperature 36.4, pressure 128 over 69, saturation 99 percent, heart rate 82. Have you been feeling exhausted?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.27,
      "end_seconds": 69.37,
      "duration_seconds": 7.1,
      "text": "Yes, for about a year. And, And I've been looking pale as well."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 70.77,
      "end_seconds": 76.85,
      "duration_seconds": 6.08,
      "text": "Let me check a a few things. Any pelvic pain, fainting or weight loss?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.69,
      "end_seconds": 84.25,
      "duration_seconds": 5.56,
      "text": "I haven't had pelvic pain, fainting or weight loss, no."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 88.16,
      "end_seconds": 91.55,
      "duration_seconds": 3.39,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.25,
      "end_seconds": 94.34,
      "duration_seconds": 2.09,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 95.05,
      "end_seconds": 99.47,
      "duration_seconds": 4.42,
      "text": "Has anything ever caused you a reaction? I mean any allergies."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 101.33,
      "end_seconds": 105.05,
      "duration_seconds": 3.72,
      "text": "Hmm, I've never had an allergy."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.47,
      "end_seconds": 110.98,
      "duration_seconds": 4.51,
      "text": "what about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.55,
      "end_seconds": 114.22,
      "duration_seconds": 2.67,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 123.64,
      "end_seconds": 124.87,
      "duration_seconds": 1.23,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 126.49,
      "end_seconds": 130.14,
      "duration_seconds": 3.65,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 130.97,
      "end_seconds": 133.45,
      "duration_seconds": 2.48,
      "text": "Anything you do to stay fit?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.01,
      "end_seconds": 138.9,
      "duration_seconds": 3.89,
      "text": "I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.47,
      "end_seconds": 151.63,
      "duration_seconds": 2.16,
      "text": "anything surgical in your history?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.44,
      "end_seconds": 156.31,
      "duration_seconds": 3.87,
      "text": "Just my tonsils removed, as a teenager."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.15,
      "end_seconds": 160.27,
      "duration_seconds": 2.12,
      "text": "tell me your medicines, please"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.35,
      "end_seconds": 164.21,
      "duration_seconds": 1.86,
      "text": "Rosuvastatin, at night."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 167.15,
      "duration_seconds": 2.12,
      "text": "and what strength is that?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.91,
      "end_seconds": 172.87,
      "duration_seconds": 4.96,
      "text": "10 milligrams. I'm on iron tablets, once a day."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.72,
      "end_seconds": 188.27,
      "duration_seconds": 4.55,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 188.99,
      "end_seconds": 196.11,
      "duration_seconds": 7.12,
      "text": "I've got high cholesterol it's the not knowing that gets to me"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 197.91,
      "end_seconds": 202.9,
      "duration_seconds": 4.99,
      "text": "Yes, high cholesterol is known to us, good to have that clear."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.1,
      "end_seconds": 208.01,
      "duration_seconds": 3.91,
      "text": "now I'm gonna do a short physical check"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 209.17,
      "end_seconds": 211.72,
      "duration_seconds": 2.55,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 230.51,
      "end_seconds": 234.73,
      "duration_seconds": 4.22,
      "text": "Your eyelids and the palms of your hands look pale."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.03,
      "end_seconds": 255.49,
      "duration_seconds": 18.46,
      "text": "Please sit back down. Having listened and examined, it fits best with heavy periods with iron deficiency. That's my thinking for now, and it may change as we learn more. It could also be fibroids, so we'll keep that open."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 256.81,
      "end_seconds": 261.59,
      "duration_seconds": 4.78,
      "text": "yeah, you know, is there something to worry about?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 263.61,
      "end_seconds": 292.4,
      "duration_seconds": 28.79,
      "text": "I understand the worry. At the moment I'd say it's heavy periods with iron deficiency, and we'll know more once the a pelvic ultrasound is back. I'll request a pelvic ultrasound, it'll help with heavy periods. I'll start you on tranexamic acid, 1 gram, three times a day during periods, for four days each cycle. It's for heavy periods."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 293.04,
      "end_seconds": 294.53,
      "duration_seconds": 1.49,
      "text": "That's simple enough."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.54,
      "end_seconds": 315.74,
      "duration_seconds": 20.2,
      "text": "Iron can darken the stools and bother the stomach, so take it after food. Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. Please come and see me after the results."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 317.52,
      "end_seconds": 319.9,
      "duration_seconds": 2.38,
      "text": "Good, I'll return then."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.86,
      "end_seconds": 326.04,
      "duration_seconds": 4.18,
      "text": "alright, that's everything on my side anything you're unsure about?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 330.82,
      "end_seconds": 335.24,
      "duration_seconds": 4.42,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 335.92,
      "end_seconds": 337.21,
      "duration_seconds": 1.29,
      "text": "see you soon"
    }
  ]
}