{
  "schema_version": "1.0",
  "encounter_id": "01139",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.02,
      "end_seconds": 5.36,
      "duration_seconds": 4.34,
      "text": "Sorry I'm a little late, uh, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.9,
      "end_seconds": 11.26,
      "duration_seconds": 4.36,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.66,
      "end_seconds": 24.18,
      "duration_seconds": 11.52,
      "text": "Yeah, it's an itchy rash. I don't know what's causing it. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.94,
      "end_seconds": 29.05,
      "duration_seconds": 3.11,
      "text": "Can you tell me when it first started?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.08,
      "end_seconds": 34.61,
      "duration_seconds": 3.53,
      "text": "Since yesterday, that's when it began"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 35.11,
      "end_seconds": 46.52,
      "duration_seconds": 11.41,
      "text": "Ah. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps. It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.84,
      "end_seconds": 63.89,
      "duration_seconds": 16.05,
      "text": "Mostly mild. Only moisturiser, and it's not much. I didn't want to make a fuss, you know. I've, I've also had itching that wakes me at night, for two months."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 65.24,
      "end_seconds": 67.19,
      "duration_seconds": 1.95,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 68.49,
      "end_seconds": 71.44,
      "duration_seconds": 2.95,
      "text": "It's once or twice a day."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 76.71,
      "end_seconds": 78.73,
      "duration_seconds": 2.02,
      "text": "Has there been redness too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 79.9,
      "end_seconds": 82.11,
      "duration_seconds": 2.21,
      "text": "Yes, that started yesterday."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 82.66,
      "end_seconds": 85.12,
      "duration_seconds": 2.46,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 86.83,
      "end_seconds": 91.41,
      "duration_seconds": 4.58,
      "text": "Erythromycin. I come out in... well, bad stomach cramps."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.73,
      "end_seconds": 95.26,
      "duration_seconds": 2.53,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.88,
      "end_seconds": 108.23,
      "duration_seconds": 12.35,
      "text": "I'm on Asthalin inhaler, when needed. I'm on hydrocortisone cream, once a day. I'd been on Seretide inhaler, not any more though, I stopped."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 108.79,
      "end_seconds": 111.2,
      "duration_seconds": 2.41,
      "text": "Have you ever had an operation?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.75,
      "end_seconds": 119.94,
      "duration_seconds": 8.19,
      "text": "I mean, yes, I had my appendix taken out, when I was in my twenties"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.68,
      "end_seconds": 142.12,
      "duration_seconds": 3.44,
      "text": "has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.43,
      "end_seconds": 145.42,
      "duration_seconds": 1.99,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 150.74,
      "end_seconds": 151.44,
      "duration_seconds": 0.7,
      "text": "Yes."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.43,
      "end_seconds": 153.81,
      "duration_seconds": 1.38,
      "text": "I've got eczema."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 159.17,
      "end_seconds": 160.65,
      "duration_seconds": 1.48,
      "text": "how about smoking?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 162.16,
      "end_seconds": 164.78,
      "duration_seconds": 2.62,
      "text": "I've never touched a cigarette."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.33,
      "end_seconds": 167.03,
      "duration_seconds": 1.7,
      "text": "do you drink alcohol?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 167.9,
      "end_seconds": 169.64,
      "duration_seconds": 1.74,
      "text": "Nothing, I'm teetotal."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 171.22,
      "end_seconds": 173.14,
      "duration_seconds": 1.92,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 174.82,
      "end_seconds": 179.1,
      "duration_seconds": 4.28,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 180.11,
      "end_seconds": 181.33,
      "duration_seconds": 1.22,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 183.12,
      "end_seconds": 185.9,
      "duration_seconds": 2.78,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.53,
      "end_seconds": 192.95,
      "duration_seconds": 3.42,
      "text": "are you in work at the moment?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.76,
      "end_seconds": 198.16,
      "duration_seconds": 4.4,
      "text": "Yes, I work in a bakery, early starts."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.06,
      "end_seconds": 203.26,
      "duration_seconds": 4.2,
      "text": "Any oozing, similar rash in family members or fever?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 204.87,
      "end_seconds": 210.86,
      "duration_seconds": 5.99,
      "text": "I haven't had oozing, similar rash in family members or fever, no"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 215.83,
      "end_seconds": 218.31,
      "duration_seconds": 2.48,
      "text": "any joint pain or breathing trouble?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.14,
      "end_seconds": 223.88,
      "duration_seconds": 4.74,
      "text": "So, no joint pain or breathing trouble, none of it."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 224.46,
      "end_seconds": 226.89,
      "duration_seconds": 2.43,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 228.26,
      "end_seconds": 231.1,
      "duration_seconds": 2.84,
      "text": "No, um, nothing there."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 242.46,
      "end_seconds": 245.31,
      "duration_seconds": 2.85,
      "text": "time for your numbers, if that's okay"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.62,
      "end_seconds": 256.28,
      "duration_seconds": 2.66,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.72,
      "end_seconds": 288.31,
      "duration_seconds": 14.59,
      "text": "Okay: temp 36.5 degrees, height 185 centimetres, weight 52 kilos. And pressure 119 over 78, saturation 97 percent, BMI works out to 15.2, pulse is 66 beats a minute."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 290.41,
      "end_seconds": 294.02,
      "duration_seconds": 3.61,
      "text": "Let me think, is that alright, doctor?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 295.84,
      "end_seconds": 299.45,
      "duration_seconds": 3.61,
      "text": "Don't worry, we'll discuss it in a second."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 301.64,
      "end_seconds": 304.35,
      "duration_seconds": 2.71,
      "text": "Okay, shall I start the examination?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 306.02,
      "end_seconds": 307.86,
      "duration_seconds": 1.84,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 320.66,
      "end_seconds": 327.26,
      "duration_seconds": 6.6,
      "text": "there are dry red patches in the creases of both elbows with scratch marks"
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.79,
      "end_seconds": 330.75,
      "duration_seconds": 1.96,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 341.89,
      "end_seconds": 344.4,
      "duration_seconds": 2.51,
      "text": "No signs of infection, no crusting."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 346.79,
      "end_seconds": 349.19,
      "duration_seconds": 2.4,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 363.18,
      "end_seconds": 368.57,
      "duration_seconds": 5.39,
      "text": "Putting it all together, the most likely explanation is an eczema flare-up."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 369.35,
      "end_seconds": 372.55,
      "duration_seconds": 3.2,
      "text": "um, will it clear up?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 374.44,
      "end_seconds": 401.15,
      "duration_seconds": 26.71,
      "text": "I understand the worry. At the moment I'd say it's an eczema flare-up, and we'll watch how it goes. I'd like you to take mometasone cream, once a day, for two weeks. It's for eczema. Moisturise right after a bath, thick creams are better than lotions, and use a mild soap. Come back in three weeks. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 402.52,
      "end_seconds": 404.12,
      "duration_seconds": 1.6,
      "text": "That's clear, thanks."
    }
  ]
}