{
  "schema_version": "1.0",
  "encounter_id": "01114",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.25,
      "end_seconds": 6.32,
      "duration_seconds": 5.07,
      "text": "Right, thanks for waiting, come in. Tell me what's brought you in."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 8.33,
      "end_seconds": 19.64,
      "duration_seconds": 11.31,
      "text": "Mainly neck pain going down my right arm. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 23.12,
      "end_seconds": 26.32,
      "duration_seconds": 3.2,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 27.83,
      "end_seconds": 32.07,
      "duration_seconds": 4.24,
      "text": "It's been about a week, I'm fairly sure."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 32.7,
      "end_seconds": 35.96,
      "duration_seconds": 3.26,
      "text": "How strong would you say it is?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 37.57,
      "end_seconds": 44.86,
      "duration_seconds": 7.29,
      "text": "About a five out of ten. I've also had stiffness in the neck."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 58.77,
      "end_seconds": 60.17,
      "duration_seconds": 1.4,
      "text": "Any previous surgeries?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 62.26,
      "end_seconds": 66.59,
      "duration_seconds": 4.33,
      "text": "Right, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 84.61,
      "end_seconds": 88.05,
      "duration_seconds": 3.44,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 92.66,
      "end_seconds": 103.15,
      "duration_seconds": 10.49,
      "text": "I walk the dog every morning. Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 103.69,
      "end_seconds": 107.54,
      "duration_seconds": 3.85,
      "text": "Tell me about any past illnesses or ongoing conditions."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.69,
      "end_seconds": 110.2,
      "duration_seconds": 1.51,
      "text": "I've got diabetes."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 111.27,
      "end_seconds": 112.78,
      "duration_seconds": 1.51,
      "text": "Okay, go on."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 114.13,
      "end_seconds": 118.55,
      "duration_seconds": 4.42,
      "text": "Thin bones, for five years. Yes, heart failure."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 120.22,
      "end_seconds": 127.55,
      "duration_seconds": 7.33,
      "text": "Okay, I can see diabetes and thin bones in your file as well. Let's run through your medicines."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 129.52,
      "end_seconds": 135.59,
      "duration_seconds": 6.07,
      "text": "Alendronate. I take it 70 milligrams, maybe, once a week."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.47,
      "end_seconds": 141.55,
      "duration_seconds": 4.08,
      "text": "Do you have the packet or the prescription with you?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 143.28,
      "end_seconds": 151.55,
      "duration_seconds": 8.27,
      "text": "No, it's at home. Let me think, it's furosemide, 40 milligrams, every morning."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 157.08,
      "end_seconds": 162.45,
      "duration_seconds": 5.37,
      "text": "Let me check a few things. Any bladder problems or headache?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 165.97,
      "end_seconds": 170.46,
      "duration_seconds": 4.49,
      "text": "No bladder problems or headache, none of it."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 170.93,
      "end_seconds": 177.16,
      "duration_seconds": 6.23,
      "text": "Okay, go on. Okay, any balance problems, recent fall or weakness in the legs?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.36,
      "end_seconds": 187.35,
      "duration_seconds": 8.99,
      "text": "So, no balance problems, recent fall or weakness in the legs, none of it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 188.79,
      "end_seconds": 191.4,
      "duration_seconds": 2.61,
      "text": "Right, is your chest okay generally?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.7,
      "end_seconds": 195.53,
      "duration_seconds": 2.83,
      "text": "No, my breathing's been fine."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 197.41,
      "end_seconds": 200.23,
      "duration_seconds": 2.82,
      "text": "How are your bowels, any trouble?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 201.12,
      "end_seconds": 205.17,
      "duration_seconds": 4.05,
      "text": "Uh, bowels are regular, nothing odd."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 206.93,
      "end_seconds": 211.45,
      "duration_seconds": 4.52,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 222.47,
      "end_seconds": 224.78,
      "duration_seconds": 2.31,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 241.17,
      "end_seconds": 248.15,
      "duration_seconds": 6.98,
      "text": "Okay: blood pressure 109 over 81, saturation 99 percent, temperature 36.6, pulse 65."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 248.72,
      "end_seconds": 250.38,
      "duration_seconds": 1.66,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 251.24,
      "end_seconds": 253.7,
      "duration_seconds": 2.46,
      "text": "We'll look at it together shortly."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 255.6,
      "end_seconds": 258.15,
      "duration_seconds": 2.55,
      "text": "Let's move on to the examination."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.61,
      "end_seconds": 261.99,
      "duration_seconds": 2.38,
      "text": "Take a deep breath for me."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 279.23,
      "end_seconds": 283.66,
      "duration_seconds": 4.43,
      "text": "Biceps power is a little reduced on the right."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 288.22,
      "end_seconds": 290.59,
      "duration_seconds": 2.37,
      "text": "Okay, that's enough for me."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 305.29,
      "end_seconds": 337.69,
      "duration_seconds": 32.4,
      "text": "Let me tell you where I've got to. This looks most like a pinched nerve in the neck. I'd like to arrange an X-ray of the neck for neck and arm pain. The treatment will be naproxen, 250 milligrams, twice a day after food, for five days. That's for nerve-related neck pain. Keep the neck moving gently and avoid long periods looking down at a phone."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 338.62,
      "end_seconds": 359.19,
      "duration_seconds": 20.57,
      "text": "Try to get to bed and wake up at the same time each day, and keep your phone away from the bed. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 361.26,
      "end_seconds": 370.41,
      "duration_seconds": 9.15,
      "text": "I mean, could I get an MRI of the cervical spine done? A friend had it."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 372.34,
      "end_seconds": 383.19,
      "duration_seconds": 10.85,
      "text": "Not right now, it wouldn't change what we do today. Let's plan a check after the scan. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 384.77,
      "end_seconds": 387.59,
      "duration_seconds": 2.82,
      "text": "Oh, thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 388.57,
      "end_seconds": 390.42,
      "duration_seconds": 1.85,
      "text": "Have a good day."
    }
  ]
}