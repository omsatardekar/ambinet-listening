{
  "schema_version": "1.0",
  "encounter_id": "01258",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 1.12,
      "end_seconds": 3.68,
      "duration_seconds": 2.56,
      "text": "Hi, sit anywhere you like."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 5.0,
      "end_seconds": 6.04,
      "duration_seconds": 1.04,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 6.96,
      "end_seconds": 9.52,
      "duration_seconds": 2.56,
      "text": "How are things, what's been happening?"
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 11.3,
      "end_seconds": 18.68,
      "duration_seconds": 7.38,
      "text": "So the thing is, I've got sharp heel pain with my first steps in the morning."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 20.5,
      "end_seconds": 24.58,
      "duration_seconds": 4.08,
      "text": "So, how many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 25.88,
      "end_seconds": 35.44,
      "duration_seconds": 9.56,
      "text": "Yeah, I'm not sure when it began, to be honest. Some weeks ago, but I can't say how many."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 37.32,
      "end_seconds": 40.55,
      "duration_seconds": 3.23,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 41.38,
      "end_seconds": 44.23,
      "duration_seconds": 2.85,
      "text": "Right, I'd call it mild."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.26,
      "end_seconds": 50.54,
      "duration_seconds": 4.28,
      "text": "Have you had limping a bit by the evening?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.05,
      "end_seconds": 53.12,
      "duration_seconds": 2.07,
      "text": "Yes, since this morning."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 54.36,
      "end_seconds": 62.95,
      "duration_seconds": 8.59,
      "text": "Have you had sharp heel pain with your first steps in the morning before, or is this the first time?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 63.88,
      "end_seconds": 73.06,
      "duration_seconds": 9.18,
      "text": "Yeah, um, yes, something like this happened about six months ago, and it went away on its own."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 73.63,
      "end_seconds": 79.64,
      "duration_seconds": 6.01,
      "text": "Any back pain, swelling, pain in other joints or numbness in the foot?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 82.69,
      "end_seconds": 85.25,
      "duration_seconds": 2.56,
      "text": "So, nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.06,
      "end_seconds": 88.43,
      "duration_seconds": 2.37,
      "text": "Any breathing difficulties apart from this?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.16,
      "end_seconds": 91.55,
      "duration_seconds": 2.39,
      "text": "Right, no problems with breathing."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 94.18,
      "end_seconds": 97.65,
      "duration_seconds": 3.47,
      "text": "On the cardiac side, anything I should know?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 99.09,
      "end_seconds": 104.34,
      "duration_seconds": 5.25,
      "text": "Ah, my heart's been fine, as far as I know."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.76,
      "end_seconds": 132.22,
      "duration_seconds": 9.46,
      "text": "Can you list what you take, tablets, creams or inhalers? I ask because it helps me narrow things down."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 133.8,
      "end_seconds": 137.86,
      "duration_seconds": 4.06,
      "text": "Seretide inhaler. I take it twice a day."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.51,
      "end_seconds": 152.41,
      "duration_seconds": 2.9,
      "text": "Have you got any known allergies?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 153.09,
      "end_seconds": 155.2,
      "duration_seconds": 2.11,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 155.91,
      "end_seconds": 158.44,
      "duration_seconds": 2.53,
      "text": "Right, how active are you?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.93,
      "end_seconds": 163.41,
      "duration_seconds": 3.48,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 164.38,
      "end_seconds": 166.72,
      "duration_seconds": 2.34,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 170.37,
      "end_seconds": 174.1,
      "duration_seconds": 3.73,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 174.67,
      "end_seconds": 177.02,
      "duration_seconds": 2.35,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.43,
      "end_seconds": 180.8,
      "duration_seconds": 2.37,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 182.71,
      "end_seconds": 184.94,
      "duration_seconds": 2.23,
      "text": "I'll do your observations first."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 198.36,
      "end_seconds": 201.31,
      "duration_seconds": 2.95,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.8,
      "end_seconds": 218.68,
      "duration_seconds": 3.88,
      "text": "Okay: BP is 111 over 74, heart rate 79."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 220.17,
      "end_seconds": 222.43,
      "duration_seconds": 2.26,
      "text": "Is that alright, doctor?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 223.27,
      "end_seconds": 225.6,
      "duration_seconds": 2.33,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 227.48,
      "end_seconds": 229.54,
      "duration_seconds": 2.06,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 230.81,
      "end_seconds": 232.73,
      "duration_seconds": 1.92,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.84,
      "end_seconds": 253.14,
      "duration_seconds": 4.3,
      "text": "Pressing on the inner heel brings on the pain."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 254.81,
      "end_seconds": 256.82,
      "duration_seconds": 2.01,
      "text": "Hold that for a second."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 271.33,
      "end_seconds": 273.74,
      "duration_seconds": 2.41,
      "text": "The ankle and foot move fully."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 278.41,
      "end_seconds": 292.16,
      "duration_seconds": 13.75,
      "text": "Please sit back down. Having listened and examined, I think we're dealing with plantar fasciitis at this stage. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 308.44,
      "end_seconds": 341.08,
      "duration_seconds": 32.64,
      "text": "Let's get an X-ray of the foot, for heel pain. Supportive shoes with a cushioned heel help. Roll the sole over a bottle and stretch the calf against a wall twice a day. Cut down on salt and fried food for now, it really does make a difference. If the symptoms get worse, that's the point to come in urgently. Book a review in six weeks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 343.01,
      "end_seconds": 343.71,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 345.49,
      "end_seconds": 352.09,
      "duration_seconds": 6.6,
      "text": "Let me check I've been clear. What will you do once you get home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 352.88,
      "end_seconds": 357.49,
      "duration_seconds": 4.61,
      "text": "So, I come back in six weeks. Is that right?"
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 358.67,
      "end_seconds": 363.43,
      "duration_seconds": 4.76,
      "text": "Yes, exactly right. I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 364.3,
      "end_seconds": 367.38,
      "duration_seconds": 3.08,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 368.67,
      "end_seconds": 370.05,
      "duration_seconds": 1.38,
      "text": "All the best."
    }
  ]
}