{
  "schema_version": "1.0",
  "encounter_id": "01135",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.68,
      "end_seconds": 6.11,
      "duration_seconds": 5.43,
      "text": "Come in, have a seat by the desk. Have you been here before?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 6.64,
      "end_seconds": 10.23,
      "duration_seconds": 3.59,
      "text": "A couple of times, but not recently."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 11.16,
      "end_seconds": 13.99,
      "duration_seconds": 2.83,
      "text": "Start wherever you like, I'm listening."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 15.2,
      "end_seconds": 23.83,
      "duration_seconds": 8.63,
      "text": "Uh, it's painful lumps on the chin. I thought I'd wait, but it hasn't gone."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 25.89,
      "end_seconds": 29.42,
      "duration_seconds": 3.53,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 31.14,
      "end_seconds": 35.46,
      "duration_seconds": 4.32,
      "text": "It's, It's been going on for nearly five years."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 36.62,
      "end_seconds": 39.36,
      "duration_seconds": 2.74,
      "text": "Does anything else come with it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 43.25,
      "end_seconds": 51.55,
      "duration_seconds": 8.3,
      "text": "When it starts I tend to get acne as well. The acne? That's been for two years."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 53.11,
      "end_seconds": 56.47,
      "duration_seconds": 3.36,
      "text": "Has there been any new face cream?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 57.25,
      "end_seconds": 62.55,
      "duration_seconds": 5.3,
      "text": "Actually, not that I've noticed, no new face cream."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 64.59,
      "end_seconds": 67.62,
      "duration_seconds": 3.03,
      "text": "And what about fever, scarring or pregnancy?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.73,
      "end_seconds": 72.66,
      "duration_seconds": 3.93,
      "text": "I haven't had fever, scarring or pregnancy, no."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 74.57,
      "end_seconds": 76.97,
      "duration_seconds": 2.4,
      "text": "Is your chest okay generally?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 77.65,
      "end_seconds": 80.7,
      "duration_seconds": 3.05,
      "text": "I mean, no problems with breathing."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 82.47,
      "end_seconds": 86.27,
      "duration_seconds": 3.8,
      "text": "Any pins and needles or loss of strength anywhere?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 87.82,
      "end_seconds": 89.62,
      "duration_seconds": 1.8,
      "text": "No weakness or anything."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 90.68,
      "end_seconds": 93.68,
      "duration_seconds": 3.0,
      "text": "Before we go further, any allergies?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 95.05,
      "end_seconds": 99.74,
      "duration_seconds": 4.69,
      "text": "I'm allergic to tramadol, I get feeling very drowsy."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 101.83,
      "end_seconds": 106.38,
      "duration_seconds": 4.55,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 107.82,
      "end_seconds": 112.36,
      "duration_seconds": 4.54,
      "text": "Omeprazole, 20 milligrams, once a day for the reflux."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.66,
      "end_seconds": 116.56,
      "duration_seconds": 2.9,
      "text": "Right, what about your medical history?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 117.1,
      "end_seconds": 129.71,
      "duration_seconds": 12.61,
      "text": "Sorry, what was I saying, I have acid reflux, for nearly five years. I'm not great at remembering details, so bear with me."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 131.2,
      "end_seconds": 133.6,
      "duration_seconds": 2.4,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 134.33,
      "end_seconds": 138.54,
      "duration_seconds": 4.21,
      "text": "Um, no, I've never been operated on."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 156.11,
      "end_seconds": 157.5,
      "duration_seconds": 1.39,
      "text": "So, any smoking?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 159.49,
      "end_seconds": 163.8,
      "duration_seconds": 4.31,
      "text": "I smoke roughly a pack every two days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 165.84,
      "end_seconds": 167.1,
      "duration_seconds": 1.26,
      "text": "Are you active?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 169.09,
      "end_seconds": 171.83,
      "duration_seconds": 2.74,
      "text": "I walk the dog every morning."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 173.58,
      "end_seconds": 177.12,
      "duration_seconds": 3.54,
      "text": "Okay, what do you do during the day?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 178.74,
      "end_seconds": 182.13,
      "duration_seconds": 3.39,
      "text": "I look after my grandchildren most days."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 183.83,
      "end_seconds": 186.82,
      "duration_seconds": 2.99,
      "text": "Are you on your own at home?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 190.84,
      "end_seconds": 193.52,
      "duration_seconds": 2.68,
      "text": "I live with my elderly mother."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 195.44,
      "end_seconds": 198.86,
      "duration_seconds": 3.42,
      "text": "Right, are there any illnesses in your family?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 200.49,
      "end_seconds": 202.9,
      "duration_seconds": 2.41,
      "text": "My father had bowel cancer."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 214.21,
      "end_seconds": 217.04,
      "duration_seconds": 2.83,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 225.48,
      "end_seconds": 228.27,
      "duration_seconds": 2.79,
      "text": "Keep your arm relaxed for me..."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 248.23,
      "end_seconds": 258.23,
      "duration_seconds": 10.0,
      "text": "Okay: pressure 128 over 73, respiratory rate 18, SpO2 97 percent on room air, heart rate 85, temperature 36.4."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 259.87,
      "end_seconds": 262.23,
      "duration_seconds": 2.36,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 264.05,
      "end_seconds": 266.32,
      "duration_seconds": 2.27,
      "text": "Raise your arm for me."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 281.67,
      "end_seconds": 288.95,
      "duration_seconds": 7.28,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 293.37,
      "end_seconds": 295.88,
      "duration_seconds": 2.51,
      "text": "Alright, you can sit up now."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 313.73,
      "end_seconds": 333.74,
      "duration_seconds": 20.01,
      "text": "For this, doxycycline, 100 milligrams, once a day, for six weeks. It's for acne. Don't squeeze them, that's how the marks stay. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. I'd like you back in six weeks."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 338.04,
      "end_seconds": 338.74,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 340.67,
      "end_seconds": 345.33,
      "duration_seconds": 4.66,
      "text": "Right, that's the plan. Do you want to ask me anything?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 346.19,
      "end_seconds": 348.42,
      "duration_seconds": 2.23,
      "text": "Thank you, doctor, goodbye."
    }
  ]
}