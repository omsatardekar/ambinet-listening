{
  "schema_version": "1.0",
  "encounter_id": "01321",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.66,
      "end_seconds": 3.6,
      "duration_seconds": 2.94,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 9.39,
      "end_seconds": 13.92,
      "duration_seconds": 4.53,
      "text": "No problem at all, come in. What's troubling you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 14.69,
      "end_seconds": 22.01,
      "duration_seconds": 7.32,
      "text": "Mainly drenching night sweats. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 23.88,
      "end_seconds": 26.32,
      "duration_seconds": 2.44,
      "text": "What's on your current medicine list?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 28.36,
      "end_seconds": 39.78,
      "duration_seconds": 11.42,
      "text": "Simvastatin. I take it 20 milligrams, at night for my cholesterol. Well, I take Dolo, 650 milligrams, when I get the fever."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 41.59,
      "end_seconds": 42.79,
      "duration_seconds": 1.2,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 43.5,
      "end_seconds": 46.43,
      "duration_seconds": 2.93,
      "text": "For about two weeks, I'd say."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.14,
      "end_seconds": 49.53,
      "duration_seconds": 2.39,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 50.69,
      "end_seconds": 54.91,
      "duration_seconds": 4.22,
      "text": "Actually, it settles a little with changing my clothes."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.51,
      "end_seconds": 58.46,
      "duration_seconds": 1.95,
      "text": "How frequently does it come?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 59.83,
      "end_seconds": 62.05,
      "duration_seconds": 2.22,
      "text": "Honestly, all the time."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 62.26,
      "end_seconds": 65.92,
      "duration_seconds": 3.66,
      "text": "Mm-hmm. Right, any other symptoms with it?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.88,
      "end_seconds": 77.45,
      "duration_seconds": 9.57,
      "text": "It usually comes with a lump in my armpit. The lump in my armpit? That's been for ten days."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.04,
      "end_seconds": 83.71,
      "duration_seconds": 5.67,
      "text": "Let me check a few things. Any joint pain, recent travel or chest pain?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.66,
      "end_seconds": 89.98,
      "duration_seconds": 4.32,
      "text": "No, no joint pain, recent travel or chest pain."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 90.67,
      "end_seconds": 93.81,
      "duration_seconds": 3.14,
      "text": "Any muscle or joint problems besides this?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 95.16,
      "end_seconds": 97.2,
      "duration_seconds": 2.04,
      "text": "I move fine otherwise."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.61,
      "end_seconds": 118.23,
      "duration_seconds": 3.62,
      "text": "Any health conditions I should have on record?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.15,
      "end_seconds": 126.47,
      "duration_seconds": 7.32,
      "text": "High cholesterol, for about a year. My sister suggested writing things down, but I forgot."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 127.72,
      "end_seconds": 137.67,
      "duration_seconds": 9.95,
      "text": "Okay, I can see high cholesterol in your file as well. Are you allergic to anything? Any allergies to medicines or foods?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.45,
      "end_seconds": 146.92,
      "duration_seconds": 3.47,
      "text": "Right, no, not that I know of."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.78,
      "end_seconds": 159.91,
      "duration_seconds": 2.13,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.99,
      "end_seconds": 165.01,
      "duration_seconds": 4.02,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 166.99,
      "end_seconds": 169.74,
      "duration_seconds": 2.75,
      "text": "Do you follow any particular diet?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.7,
      "end_seconds": 174.0,
      "duration_seconds": 3.3,
      "text": "I'm vegetarian and have been for years."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.94,
      "end_seconds": 193.4,
      "duration_seconds": 3.46,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 203.66,
      "end_seconds": 206.46,
      "duration_seconds": 2.8,
      "text": "So, sit still for a moment..."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.63,
      "end_seconds": 231.81,
      "duration_seconds": 6.18,
      "text": "Okay: BP is 114 over 79, heart rate 98, SpO2 98 percent on room air."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 234.1,
      "end_seconds": 237.07,
      "duration_seconds": 2.97,
      "text": "Okay, time for me to examine you."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 255.76,
      "end_seconds": 256.71,
      "duration_seconds": 0.95,
      "text": "Of course."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 258.0,
      "end_seconds": 259.35,
      "duration_seconds": 1.35,
      "text": "Does that hurt?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 273.94,
      "end_seconds": 276.05,
      "duration_seconds": 2.11,
      "text": "I can't feel your spleen."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 277.08,
      "end_seconds": 278.7,
      "duration_seconds": 1.62,
      "text": "Let me feel here."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 290.43,
      "end_seconds": 296.84,
      "duration_seconds": 6.41,
      "text": "There's a firm, rubbery gland about two centimetres in the left armpit, not tender."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 302.35,
      "end_seconds": 312.75,
      "duration_seconds": 10.4,
      "text": "You can sit up now. Okay, so my impression is this: This looks most like an enlarged gland with night sweats that needs a proper work-up."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 313.78,
      "end_seconds": 317.11,
      "duration_seconds": 3.33,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 318.74,
      "end_seconds": 333.35,
      "duration_seconds": 14.61,
      "text": "It's reasonable to be concerned, but right now an enlarged gland with night sweats that needs a proper work-up is my leading thought, not anything worse. I'll request blood tests, it'll help with night sweats."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 334.59,
      "end_seconds": 337.15,
      "duration_seconds": 2.56,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 338.02,
      "end_seconds": 356.98,
      "duration_seconds": 18.96,
      "text": "Keep a note of your temperature each evening. Let's get you seen by the haematology clinic, I'll arrange the letter. Come back or go to emergency straight away if the symptoms get worse. Please come and see me in a week. Have I covered everything you wanted?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 357.68,
      "end_seconds": 360.58,
      "duration_seconds": 2.9,
      "text": "I think I understand everything. Thanks."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.19,
      "end_seconds": 362.99,
      "duration_seconds": 1.8,
      "text": "Right, all the best."
    }
  ]
}