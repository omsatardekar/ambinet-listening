{
  "schema_version": "1.0",
  "encounter_id": "01238",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.72,
      "end_seconds": 3.96,
      "duration_seconds": 3.24,
      "text": "Sorry I'm a little late, doctor."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.54,
      "end_seconds": 10.31,
      "duration_seconds": 4.77,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.06,
      "end_seconds": 15.8,
      "duration_seconds": 4.74,
      "text": "Doctor, I'm just here to help with the details."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 17.67,
      "end_seconds": 21.65,
      "duration_seconds": 3.98,
      "text": "I've been feeling dizzy when I stand up."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 25.14,
      "end_seconds": 28.34,
      "duration_seconds": 3.2,
      "text": "Has this been going on for long?"
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 30.12,
      "end_seconds": 33.25,
      "duration_seconds": 3.13,
      "text": "I've had it for one week."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 34.21,
      "end_seconds": 36.8,
      "duration_seconds": 2.59,
      "text": "Is there something that settles it?"
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.17,
      "end_seconds": 46.93,
      "duration_seconds": 4.76,
      "text": "Erm, only sitting back down, and it's not much."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 47.8,
      "end_seconds": 49.82,
      "duration_seconds": 2.02,
      "text": "Any other symptoms with it?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.62,
      "end_seconds": 70.92,
      "duration_seconds": 19.3,
      "text": "It usually comes with nearly blacking out. The nearly blacking out? That's been for about a week. Ah, as for nearly blacking out, I get some relief from lying down. I've also had a pounding in my head, for about two weeks."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 74.65,
      "end_seconds": 81.05,
      "duration_seconds": 6.4,
      "text": "Have you been feeling dizzy when you stand up at any time before this?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 85.25,
      "end_seconds": 90.92,
      "duration_seconds": 5.67,
      "text": "Mm, I had a similar thing last year. It went away."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.73,
      "end_seconds": 98.78,
      "duration_seconds": 6.05,
      "text": "Okay, any chest pain, palpitations, black stools or slurred speech at all?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.53,
      "end_seconds": 104.78,
      "duration_seconds": 2.25,
      "text": "Nope, nothing like that."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.77,
      "end_seconds": 110.82,
      "duration_seconds": 3.05,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 112.67,
      "end_seconds": 114.8,
      "duration_seconds": 2.13,
      "text": "No, joints are fine."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.45,
      "end_seconds": 118.1,
      "duration_seconds": 2.65,
      "text": "Is your urine normal, no changes?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.38,
      "end_seconds": 121.12,
      "duration_seconds": 1.74,
      "text": "Nothing there, no."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 138.42,
      "end_seconds": 145.94,
      "duration_seconds": 7.52,
      "text": "Can you list what you take, tablets, creams or inhalers? I'm asking so that we don't miss anything."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 147.92,
      "end_seconds": 160.33,
      "duration_seconds": 12.41,
      "text": "Hydrochlorothiazide, 12.5 milligrams, every morning. I'm on something called tams... tamsulosin, 0.4 milligrams, maybe, at night for the prostate."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 161.29,
      "end_seconds": 165.3,
      "duration_seconds": 4.01,
      "text": "Did you happen to bring the box or the paperwork?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 166.49,
      "end_seconds": 185.45,
      "duration_seconds": 18.96,
      "text": "Not with me. I'll bring it next time. Thyronorm. I take it 50 micrograms, every morning for my thyroid. It's clopidogrel, 75 milligrams, once a day. I used to take metoprolol, but I stopped it."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 187.45,
      "end_seconds": 190.4,
      "duration_seconds": 2.95,
      "text": "Any past operations I should know about?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 192.13,
      "end_seconds": 197.91,
      "duration_seconds": 5.78,
      "text": "Yes, I had two stents put in my heart, three years ago."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 199.44,
      "end_seconds": 201.64,
      "duration_seconds": 2.2,
      "text": "Do you get out much?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 202.9,
      "end_seconds": 206.82,
      "duration_seconds": 3.92,
      "text": "Not much, I mostly stay in these days."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 208.71,
      "end_seconds": 211.06,
      "duration_seconds": 2.35,
      "text": "Do you work outside the home?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.93,
      "end_seconds": 215.68,
      "duration_seconds": 3.75,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 222.74,
      "end_seconds": 225.54,
      "duration_seconds": 2.8,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 226.18,
      "end_seconds": 236.23,
      "duration_seconds": 10.05,
      "text": "I've got high blood pressure. I have an enlarged prostate, for about ten years. Yes, an underactive thyroid."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 237.64,
      "end_seconds": 239.21,
      "duration_seconds": 1.57,
      "text": "Okay, anything else?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 240.52,
      "end_seconds": 242.4,
      "duration_seconds": 1.88,
      "text": "I have heart disease."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 243.08,
      "end_seconds": 251.64,
      "duration_seconds": 8.56,
      "text": "Alright, an enlarged prostate, that matches what I have here. I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 259.33,
      "end_seconds": 261.51,
      "duration_seconds": 2.18,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 278.88,
      "end_seconds": 301.68,
      "duration_seconds": 22.8,
      "text": "Okay: pulse is 106 beats a minute, pressure 93 over 60, oxygen saturation is 99 percent. And respiratory rate 20, temp 36.5 degrees. Putting together what you've described, this is probably postural low blood pressure, possibly related to medicines or dehydration. Another possibility is dehydration."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.99,
      "end_seconds": 320.93,
      "duration_seconds": 7.94,
      "text": "We should do blood tests for dizziness. The result will help us decide whether anything more is needed."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.7,
      "end_seconds": 324.22,
      "duration_seconds": 2.52,
      "text": "When would that take place?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 327.68,
      "end_seconds": 352.61,
      "duration_seconds": 24.93,
      "text": "I'll request an ECG, it'll help with dizziness. I'll request a lying and standing blood pressure check, it'll help with dizziness. Get up slowly from lying and sitting, and keep drinking fluids through the day. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 354.01,
      "end_seconds": 355.61,
      "duration_seconds": 1.6,
      "text": "Alright, I follow."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 357.39,
      "end_seconds": 361.78,
      "duration_seconds": 4.39,
      "text": "Do get help quickly if you faint or have chest pain."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 363.49,
      "end_seconds": 365.18,
      "duration_seconds": 1.69,
      "text": "I'll remember that."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 370.99,
      "end_seconds": 374.09,
      "duration_seconds": 3.1,
      "text": "Alright, that's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 374.86,
      "end_seconds": 378.27,
      "duration_seconds": 3.41,
      "text": "No, that's all. Thanks a lot."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 379.82,
      "end_seconds": 381.45,
      "duration_seconds": 1.63,
      "text": "Have a good day."
    }
  ]
}