{
  "schema_version": "1.0",
  "encounter_id": "01410",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 0.99,
      "end_seconds": 6.18,
      "duration_seconds": 5.19,
      "text": "Hello, take a seat, I'll be with you in a second."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 7.57,
      "end_seconds": 8.51,
      "duration_seconds": 0.94,
      "text": "Hi there."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 12.83,
      "end_seconds": 16.08,
      "duration_seconds": 3.25,
      "text": "Doctor, thank you for seeing us."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 16.89,
      "end_seconds": 23.17,
      "duration_seconds": 6.28,
      "text": "That's fine, sit down. We'll go through it together. What's the main thing today?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 24.01,
      "end_seconds": 30.65,
      "duration_seconds": 6.64,
      "text": "It's itching especially at night, doctor. He didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 31.5,
      "end_seconds": 34.65,
      "duration_seconds": 3.15,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 36.66,
      "end_seconds": 40.65,
      "duration_seconds": 3.99,
      "text": "Around three weeks, um, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 41.68,
      "end_seconds": 45.83,
      "duration_seconds": 4.15,
      "text": "I think it's been nearer a month, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 46.34,
      "end_seconds": 50.44,
      "duration_seconds": 4.1,
      "text": "Okay, so roughly three to four weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 51.8,
      "end_seconds": 53.8,
      "duration_seconds": 2.0,
      "text": "That sounds about right."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 55.33,
      "end_seconds": 58.49,
      "duration_seconds": 3.16,
      "text": "Would you say mild, moderate or severe?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 60.47,
      "end_seconds": 61.56,
      "duration_seconds": 1.09,
      "text": "Mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 62.88,
      "end_seconds": 66.62,
      "duration_seconds": 3.74,
      "text": "Has there been a rash between your fingers too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 68.33,
      "end_seconds": 85.43,
      "duration_seconds": 17.1,
      "text": "Yeah. Two years, I'd say. Okay, so I've had scratching sores too, for about three months. Actually, with scratching sores, severe, I'd say. And small red bumps on my wrists, too."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 86.2,
      "end_seconds": 88.74,
      "duration_seconds": 2.54,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 89.65,
      "end_seconds": 103.52,
      "duration_seconds": 13.87,
      "text": "I used to drink heavily but I stopped four years ago. My husband and I live above the shop. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 104.85,
      "end_seconds": 107.24,
      "duration_seconds": 2.39,
      "text": "Have you had any previous surgeries?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 108.78,
      "end_seconds": 111.83,
      "duration_seconds": 3.05,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 113.12,
      "end_seconds": 117.44,
      "duration_seconds": 4.32,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 118.28,
      "end_seconds": 121.65,
      "duration_seconds": 3.37,
      "text": "No, not that I know of."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 122.52,
      "end_seconds": 126.38,
      "duration_seconds": 3.86,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 126.95,
      "end_seconds": 128.77,
      "duration_seconds": 1.82,
      "text": "My brother has epilepsy."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 137.33,
      "end_seconds": 139.48,
      "duration_seconds": 2.15,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 141.31,
      "end_seconds": 146.13,
      "duration_seconds": 4.82,
      "text": "I've got an enlarged prostate. I have high cholesterol."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 149.89,
      "end_seconds": 157.4,
      "duration_seconds": 7.51,
      "text": "Yes. Okay, I can see an enlarged prostate and high cholesterol in your file as well."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 171.19,
      "end_seconds": 173.15,
      "duration_seconds": 1.96,
      "text": "Let's run through your medicines."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 174.69,
      "end_seconds": 187.75,
      "duration_seconds": 13.06,
      "text": "He takes tamsulosin, 0.4 milligrams, at night. It's simvastatin, 20 milligrams, at night for my cholesterol, doctor. It's calamine lotion, when needed, doctor."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 192.54,
      "end_seconds": 198.79,
      "duration_seconds": 6.25,
      "text": "I had atorvastatin at one point, but I'm off it now."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 200.6,
      "end_seconds": 206.35,
      "duration_seconds": 5.75,
      "text": "Let me check a few things. Any joint pain or new medicines?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 207.03,
      "end_seconds": 209.4,
      "duration_seconds": 2.37,
      "text": "No, nothing to report there."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 211.1,
      "end_seconds": 216.13,
      "duration_seconds": 5.03,
      "text": "Okay, a few quick ones: rash on the face, oozing or fever?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 218.15,
      "end_seconds": 220.56,
      "duration_seconds": 2.41,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 226.64,
      "end_seconds": 228.34,
      "duration_seconds": 1.7,
      "text": "Nothing like swollen glands?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 230.39,
      "end_seconds": 232.39,
      "duration_seconds": 2.0,
      "text": "No, no swollen glands."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 233.2,
      "end_seconds": 234.95,
      "duration_seconds": 1.75,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 236.67,
      "end_seconds": 238.68,
      "duration_seconds": 2.01,
      "text": "No problems with breathing."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 239.98,
      "end_seconds": 245.13,
      "duration_seconds": 5.15,
      "text": "Right, any change in your bowel habit or your stomach generally?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 247.22,
      "end_seconds": 248.82,
      "duration_seconds": 1.6,
      "text": "Nothing unusual, no."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 250.91,
      "end_seconds": 254.84,
      "duration_seconds": 3.93,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 261.94,
      "end_seconds": 263.9,
      "duration_seconds": 1.96,
      "text": "Sit still for a moment..."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 283.67,
      "end_seconds": 292.88,
      "duration_seconds": 9.21,
      "text": "Okay: temperature is 36.5 degrees, oxygen saturation is 99 percent, pulse 64. And blood pressure 120 over 73."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 294.83,
      "end_seconds": 298.76,
      "duration_seconds": 3.93,
      "text": "I'll examine you in a second, make yourself comfortable."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 300.69,
      "end_seconds": 302.77,
      "duration_seconds": 2.08,
      "text": "Tell me if that's sore."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 314.41,
      "end_seconds": 322.1,
      "duration_seconds": 7.69,
      "text": "There are small burrow-like tracks and red bumps between the fingers and on the wrists, with scratch marks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 322.89,
      "end_seconds": 324.58,
      "duration_seconds": 1.69,
      "text": "Yeah, no problem."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 328.97,
      "end_seconds": 338.84,
      "duration_seconds": 9.87,
      "text": "All finished, thank you. Having listened and examined, I think we're dealing with scabies at this stage. Another possibility is eczema."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 340.05,
      "end_seconds": 343.01,
      "duration_seconds": 2.96,
      "text": "What are the odds it's serious?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 344.56,
      "end_seconds": 352.07,
      "duration_seconds": 7.51,
      "text": "I understand the worry. At the moment I'd say it's scabies, and we'll watch how it goes."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 365.24,
      "end_seconds": 391.1,
      "duration_seconds": 25.86,
      "text": "What I'm giving you is permethrin cream, 5 percent, once, then again after a week, for two weeks. That's for scabies. Everyone at home should be treated at the same time, and wash bedding and clothes at a high temperature. Cut back on tea, coffee and fizzy drinks for a couple of weeks and see how things settle. We'll catch up in two weeks."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 391.74,
      "end_seconds": 394.87,
      "duration_seconds": 3.13,
      "text": "Uh, I can manage that."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 395.38,
      "end_seconds": 398.87,
      "duration_seconds": 3.49,
      "text": "I think we're done unless you have questions."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "PATIENT",
      "start_seconds": 399.66,
      "end_seconds": 401.3,
      "duration_seconds": 1.64,
      "text": "That's clear, thanks."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_1",
      "role": "DOCTOR",
      "start_seconds": 402.49,
      "end_seconds": 404.52,
      "duration_seconds": 2.03,
      "text": "Okay, see you soon."
    }
  ]
}