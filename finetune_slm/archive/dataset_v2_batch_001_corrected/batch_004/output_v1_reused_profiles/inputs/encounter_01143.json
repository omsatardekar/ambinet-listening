{
  "schema_version": "1.0",
  "encounter_id": "01143",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.15,
      "end_seconds": 4.06,
      "duration_seconds": 2.91,
      "text": "Hello, doctor. May I come in?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.93,
      "end_seconds": 10.02,
      "duration_seconds": 4.09,
      "text": "Come in. Please sit. How can I help you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 11.92,
      "end_seconds": 15.1,
      "duration_seconds": 3.18,
      "text": "Thank you for fitting us in, doctor."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 15.66,
      "end_seconds": 19.21,
      "duration_seconds": 3.55,
      "text": "Yes, that's no problem at all. Please sit."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 21.3,
      "end_seconds": 27.4,
      "duration_seconds": 6.1,
      "text": "Honestly, it's no energy, and my family pushed me to come."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.4,
      "end_seconds": 32.62,
      "duration_seconds": 4.22,
      "text": "Can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 39.96,
      "end_seconds": 42.44,
      "duration_seconds": 2.48,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.37,
      "end_seconds": 80.35,
      "duration_seconds": 16.98,
      "text": "Okay: oxygen saturation is 97 percent, BP is 115 over 77, height 157 centimetres, weight 85 kilos, BMI works out to 34.5, heart rate 71, temp 36.7 degrees. When was the first time you noticed it?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 82.13,
      "end_seconds": 84.92,
      "duration_seconds": 2.79,
      "text": "I'd say a week, maybe."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 86.63,
      "end_seconds": 90.71,
      "duration_seconds": 4.08,
      "text": "Well, it was closer to two weeks, doctor."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 92.19,
      "end_seconds": 96.83,
      "duration_seconds": 4.64,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.4,
      "end_seconds": 104.42,
      "duration_seconds": 6.02,
      "text": "I suppose so, you know, yes. Erm, I've been feeling low too."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 105.02,
      "end_seconds": 109.15,
      "duration_seconds": 4.13,
      "text": "Has there been a tight chest when stressed too?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.11,
      "end_seconds": 115.39,
      "duration_seconds": 4.28,
      "text": "Yes, um, about the same, three weeks."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 116.51,
      "end_seconds": 119.25,
      "duration_seconds": 2.74,
      "text": "How often do you get it?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 120.86,
      "end_seconds": 122.84,
      "duration_seconds": 1.98,
      "text": "It's all the time."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 125.47,
      "end_seconds": 127.97,
      "duration_seconds": 2.5,
      "text": "Any hearing voices or panic attacks?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.19,
      "end_seconds": 133.93,
      "duration_seconds": 4.74,
      "text": "Well, no, no hearing voices or panic attacks."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 135.44,
      "end_seconds": 139.61,
      "duration_seconds": 4.17,
      "text": "Any weight loss, chest pain or thoughts of harming myself?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 141.4,
      "end_seconds": 146.9,
      "duration_seconds": 5.5,
      "text": "No, no weight loss, chest pain or thoughts of harming myself."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.19,
      "end_seconds": 149.93,
      "duration_seconds": 1.74,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 151.3,
      "end_seconds": 152.84,
      "duration_seconds": 1.54,
      "text": "No, nothing there."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 154.67,
      "end_seconds": 158.79,
      "duration_seconds": 4.12,
      "text": "Do you react to any medicines or foods? Any allergies?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 160.4,
      "end_seconds": 164.24,
      "duration_seconds": 3.84,
      "text": "I'm allergic to naproxen, I get a rash."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.03,
      "end_seconds": 169.46,
      "duration_seconds": 4.43,
      "text": "What about your parents, brothers or sisters, any conditions?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 170.2,
      "end_seconds": 173.04,
      "duration_seconds": 2.84,
      "text": "Actually, my father had bowel cancer."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 174.79,
      "end_seconds": 179.66,
      "duration_seconds": 4.87,
      "text": "Tell me about your routine, work, habits, that sort of thing."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 181.67,
      "end_seconds": 200.24,
      "duration_seconds": 18.57,
      "text": "I only drink at family occasions. I smoke roughly a pack every two days. I walk the dog every morning. No, I share a house with my brother. I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.14,
      "end_seconds": 216.84,
      "duration_seconds": 3.7,
      "text": "Right, any regular medication, tablets or creams?"
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 217.91,
      "end_seconds": 221.21,
      "duration_seconds": 3.3,
      "text": "No, I don't take any tablets."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.54,
      "end_seconds": 241.58,
      "duration_seconds": 2.04,
      "text": "Anything surgical in your history?"
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 243.57,
      "end_seconds": 254.73,
      "duration_seconds": 11.16,
      "text": "Just my septum straightened, in my thirties. I've never really been one for hospitals. I've been putting this off for weeks."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 272.61,
      "end_seconds": 276.1,
      "duration_seconds": 3.49,
      "text": "Alright, has anyone ever diagnosed you with something?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 277.96,
      "end_seconds": 279.62,
      "duration_seconds": 1.66,
      "text": "I have anxiety."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 284.61,
      "end_seconds": 288.93,
      "duration_seconds": 4.32,
      "text": "Okay, I can see anxiety in your file as well."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 289.96,
      "end_seconds": 292.38,
      "duration_seconds": 2.42,
      "text": "May I examine you now?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 293.27,
      "end_seconds": 295.01,
      "duration_seconds": 1.74,
      "text": "Alright, nearly finished here."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 312.44,
      "end_seconds": 319.21,
      "duration_seconds": 6.77,
      "text": "Your pulse and blood pressure are normal and you are tearful when talking about work."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 321.72,
      "end_seconds": 336.4,
      "duration_seconds": 14.68,
      "text": "You can sit up now. So, based on the history and the examination, it fits best with low mood linked to work stress. The reason I say that is that your story and my examination fit together."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 337.87,
      "end_seconds": 341.35,
      "duration_seconds": 3.48,
      "text": "I'm scared it's something bad. Is it?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 343.24,
      "end_seconds": 378.61,
      "duration_seconds": 35.37,
      "text": "Nothing I've seen today points to an emergency. It looks like low mood linked to work stress, but I'd like to confirm. I'd like to arrange a thyroid test for low mood and fatigue. The treatment will be sertraline, 50 milligrams, once a day, for six weeks then review. It's for low mood. Try a short walk each day and keep a regular bedtime. I think the talking therapies service should see you too."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.4,
      "end_seconds": 385.99,
      "duration_seconds": 5.59,
      "text": "Let's review you in four weeks. Does all of that make sense?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 387.75,
      "end_seconds": 391.91,
      "duration_seconds": 4.16,
      "text": "Right, I'll do that. Thank you, doctor."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.62,
      "end_seconds": 393.91,
      "duration_seconds": 1.29,
      "text": "All the best."
    }
  ]
}