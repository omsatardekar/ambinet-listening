{
  "schema_version": "1.0",
  "encounter_id": "01253",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.87,
      "end_seconds": 6.06,
      "duration_seconds": 5.19,
      "text": "Hi, doctor, I came as soon as they called me."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.76,
      "end_seconds": 10.48,
      "duration_seconds": 3.72,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 11.48,
      "end_seconds": 16.28,
      "duration_seconds": 4.8,
      "text": "Hello, doctor, I came in with them, if that's okay."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.29,
      "end_seconds": 21.0,
      "duration_seconds": 3.71,
      "text": "That's fine, sit down. We'll go through it together."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 21.9,
      "end_seconds": 28.03,
      "duration_seconds": 6.13,
      "text": "It's swelling, doctor. She didn't want to come, but I insisted."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 28.93,
      "end_seconds": 32.66,
      "duration_seconds": 3.73,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 34.5,
      "end_seconds": 37.68,
      "duration_seconds": 3.18,
      "text": "Since Friday, that's when it began."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 37.9,
      "end_seconds": 46.49,
      "duration_seconds": 8.59,
      "text": "Hm, okay. Can you describe it a bit more for me? How strong it is, what the pattern is, what helps."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 47.88,
      "end_seconds": 59.92,
      "duration_seconds": 12.04,
      "text": "Only ice, and it's not much. It's once or twice a day. Oh, and bruising. That's been about the same, about two weeks."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 61.51,
      "end_seconds": 66.42,
      "duration_seconds": 4.91,
      "text": "Has there been pain in your left wrist after a fall too?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.49,
      "end_seconds": 68.71,
      "duration_seconds": 1.22,
      "text": "Yes, actually."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 69.8,
      "end_seconds": 73.02,
      "duration_seconds": 3.22,
      "text": "Any tingling in the fingers as well?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 74.79,
      "end_seconds": 76.61,
      "duration_seconds": 1.82,
      "text": "Yes, I have."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 78.35,
      "end_seconds": 81.19,
      "duration_seconds": 2.84,
      "text": "How much trouble does it give you?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 81.73,
      "end_seconds": 83.39,
      "duration_seconds": 1.66,
      "text": "It's moderate, honestly."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 84.28,
      "end_seconds": 90.43,
      "duration_seconds": 6.15,
      "text": "Alright, have you had swelling before, or is this the first time?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 91.24,
      "end_seconds": 96.61,
      "duration_seconds": 5.37,
      "text": "I had a similar thing last winter. It went away."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 97.98,
      "end_seconds": 101.86,
      "duration_seconds": 3.88,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 111.71,
      "end_seconds": 114.39,
      "duration_seconds": 2.68,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.25,
      "end_seconds": 137.25,
      "duration_seconds": 9.0,
      "text": "Okay: heart rate 79, temperature 36.7, BP is 109 over 79. And SpO2 97 percent on room air."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 139.12,
      "end_seconds": 140.51,
      "duration_seconds": 1.39,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 141.8,
      "end_seconds": 151.15,
      "duration_seconds": 9.35,
      "text": "I'll interpret them after the examination. Have you had any pain in the shoulder or pain in the elbow?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.65,
      "end_seconds": 156.14,
      "duration_seconds": 3.49,
      "text": "No, um, I'd have said so."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 157.25,
      "end_seconds": 160.87,
      "duration_seconds": 3.62,
      "text": "And what about loss of consciousness or deformity?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.98,
      "end_seconds": 165.88,
      "duration_seconds": 3.9,
      "text": "No, no loss of consciousness or deformity."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.6,
      "end_seconds": 171.04,
      "duration_seconds": 3.44,
      "text": "How about your heart, any problems like that?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 173.06,
      "end_seconds": 175.87,
      "duration_seconds": 2.81,
      "text": "No, nothing with my heart."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 183.95,
      "end_seconds": 187.72,
      "duration_seconds": 3.77,
      "text": "Let me ask about allergies, anything at all?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 189.48,
      "end_seconds": 198.5,
      "duration_seconds": 9.02,
      "text": "Kiwi. I come out in... well, an itchy mouth. Actually, yes, trimethoprim, it gives me a rash."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 207.44,
      "end_seconds": 209.96,
      "duration_seconds": 2.52,
      "text": "Do you have any chronic illnesses?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 211.02,
      "end_seconds": 213.16,
      "duration_seconds": 2.14,
      "text": "I have thin bones."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 214.18,
      "end_seconds": 214.93,
      "duration_seconds": 0.75,
      "text": "Mm-hmm."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 219.68,
      "end_seconds": 224.6,
      "duration_seconds": 4.92,
      "text": "I've had epilepsy for two years now. Yes, anxiety."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 225.52,
      "end_seconds": 236.96,
      "duration_seconds": 11.44,
      "text": "Mm-hmm. Yes, thin bones and anxiety are known to us, good to have that clear. What do you take on a normal day?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 238.0,
      "end_seconds": 250.26,
      "duration_seconds": 12.26,
      "text": "Alendronate, 70 milligrams, once a week for my bones. Let me think, it's sodium valproate, 500 milligrams, twice a day for the fits."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_3",
      "role": "CAREGIVER",
      "start_seconds": 254.9,
      "end_seconds": 264.19,
      "duration_seconds": 9.29,
      "text": "Doctor, I think the last prescription for the sodium valproate was 1000 milligrams. We changed it at the last visit."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.99,
      "end_seconds": 270.36,
      "duration_seconds": 5.37,
      "text": "Okay. Have you got the newest prescription or the box with you?"
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 272.36,
      "end_seconds": 279.21,
      "duration_seconds": 6.85,
      "text": "No, I left it at home. Escitalopram, 10 milligrams, once a day."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 279.95,
      "end_seconds": 282.61,
      "duration_seconds": 2.66,
      "text": "Now some background about your lifestyle."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 287.51,
      "end_seconds": 298.9,
      "duration_seconds": 11.39,
      "text": "I look after my grandchildren most days. I drink a lot of tea and snack through the day. I do a yoga class on Thursdays."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.03,
      "end_seconds": 308.39,
      "duration_seconds": 8.36,
      "text": "Just to be sure I understood. You've had swelling, since Friday, and no deformity or pain in the elbow."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.53,
      "end_seconds": 311.33,
      "duration_seconds": 1.8,
      "text": "Yes, that's right."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 329.45,
      "end_seconds": 357.08,
      "duration_seconds": 27.63,
      "text": "I want an X-ray of the wrist done, that's for wrist injury. I'll start you on paracetamol, 650 milligrams, three times a day, for five days. That's for wrist pain. I'd like you to wear a splint until the X-ray result is confirmed and keep the hand raised. And please bring the latest prescription or the medicine boxes to the next visit, so we can settle the dose."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 358.12,
      "end_seconds": 360.15,
      "duration_seconds": 2.03,
      "text": "Thank you, that's clear."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 361.0,
      "end_seconds": 368.89,
      "duration_seconds": 7.89,
      "text": "Keep an eye out, and if the symptoms get worse, call us the same day or go to emergency."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 370.06,
      "end_seconds": 371.67,
      "duration_seconds": 1.61,
      "text": "Yes, will do."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 373.17,
      "end_seconds": 376.68,
      "duration_seconds": 3.51,
      "text": "That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 378.3,
      "end_seconds": 380.45,
      "duration_seconds": 2.15,
      "text": "Thank you, doctor, goodbye."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 382.34,
      "end_seconds": 384.02,
      "duration_seconds": 1.68,
      "text": "Have a good day."
    }
  ]
}