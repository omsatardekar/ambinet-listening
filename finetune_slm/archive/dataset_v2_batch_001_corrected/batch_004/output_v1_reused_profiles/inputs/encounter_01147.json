{
  "schema_version": "1.0",
  "encounter_id": "01147",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 1.09,
      "end_seconds": 4.65,
      "duration_seconds": 3.56,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 5.65,
      "end_seconds": 10.06,
      "duration_seconds": 4.41,
      "text": "Yes, come in and sit down. What brings you here today?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 11.69,
      "end_seconds": 15.26,
      "duration_seconds": 3.57,
      "text": "I wanted to get acne looked at."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 17.15,
      "end_seconds": 18.36,
      "duration_seconds": 1.21,
      "text": "Since when exactly?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 19.77,
      "end_seconds": 22.93,
      "duration_seconds": 3.16,
      "text": "It's been going on for two months."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 24.84,
      "end_seconds": 29.95,
      "duration_seconds": 5.11,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 31.07,
      "end_seconds": 40.79,
      "duration_seconds": 9.72,
      "text": "Well, I'd say mild. It's worse with stress and oily food. Work has been very busy so I kept ignoring it."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 42.55,
      "end_seconds": 46.38,
      "duration_seconds": 3.83,
      "text": "What about oily skin, have you noticed that?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 48.08,
      "end_seconds": 61.5,
      "duration_seconds": 13.42,
      "text": "Yeah. Four weeks, I'd say. With oily skin, I'd give it a three, out of ten. I, I had flare-ups before my period before. That's settled now, though."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 68.91,
      "end_seconds": 70.83,
      "duration_seconds": 1.92,
      "text": "How active are you?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 71.39,
      "end_seconds": 75.09,
      "duration_seconds": 3.7,
      "text": "I hardly move around during the day."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 77.01,
      "end_seconds": 78.45,
      "duration_seconds": 1.44,
      "text": "And your job?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 78.96,
      "end_seconds": 82.24,
      "duration_seconds": 3.28,
      "text": "I work in accounts at a hospital."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 83.37,
      "end_seconds": 87.49,
      "duration_seconds": 4.12,
      "text": "Anything in your past medical history I should know?"
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 92.16,
      "end_seconds": 94.09,
      "duration_seconds": 1.93,
      "text": "I've had asthma, yes."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.75,
      "end_seconds": 101.69,
      "duration_seconds": 6.94,
      "text": "Right, so asthma is already on your record. We'll keep that in mind today. Any previous surgeries?"
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 102.61,
      "end_seconds": 105.98,
      "duration_seconds": 3.37,
      "text": "No, I've never been operated on."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 107.51,
      "end_seconds": 110.36,
      "duration_seconds": 2.85,
      "text": "Okay, have you got any known allergies?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.02,
      "end_seconds": 112.83,
      "duration_seconds": 1.81,
      "text": "No allergies at all."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 128.12,
      "end_seconds": 134.53,
      "duration_seconds": 6.41,
      "text": "What's on your current medicine list? It helps to be thorough at this stage."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 135.49,
      "end_seconds": 137.92,
      "duration_seconds": 2.43,
      "text": "Foracort inhaler, twice a day."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.98,
      "end_seconds": 141.21,
      "duration_seconds": 1.23,
      "text": "Is that long-standing?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.01,
      "end_seconds": 148.07,
      "duration_seconds": 5.06,
      "text": "For nearly five years. Seretide inhaler I don't take anymore."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 149.65,
      "end_seconds": 157.0,
      "duration_seconds": 7.35,
      "text": "Let me check a few things. Any new face cream, scarring, fever or excess hair growth?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 157.6,
      "end_seconds": 164.29,
      "duration_seconds": 6.69,
      "text": "No new face cream, scarring, fever or excess hair growth, none of it."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.04,
      "end_seconds": 167.18,
      "duration_seconds": 2.14,
      "text": "Is your mobility otherwise okay?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.86,
      "end_seconds": 173.37,
      "duration_seconds": 1.51,
      "text": "Nothing else aches."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 175.34,
      "end_seconds": 178.06,
      "duration_seconds": 2.72,
      "text": "Alright, is your digestion otherwise okay?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 179.85,
      "end_seconds": 183.02,
      "duration_seconds": 3.17,
      "text": "Ah, no, that side's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 184.62,
      "end_seconds": 190.0,
      "duration_seconds": 5.38,
      "text": "Alright, can I check a few measurements before we carry on?"
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 202.1,
      "end_seconds": 204.44,
      "duration_seconds": 2.34,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 218.2,
      "end_seconds": 223.81,
      "duration_seconds": 5.61,
      "text": "Okay: temperature is 36.9 degrees, blood pressure 114 over 69, pulse 86."
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 225.65,
      "end_seconds": 227.24,
      "duration_seconds": 1.59,
      "text": "Is that okay?"
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 228.24,
      "end_seconds": 230.72,
      "duration_seconds": 2.48,
      "text": "I'll interpret them after the examination."
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 232.78,
      "end_seconds": 236.05,
      "duration_seconds": 3.27,
      "text": "Right, let's have a proper look at you."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.99,
      "end_seconds": 238.33,
      "duration_seconds": 1.34,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 253.34,
      "end_seconds": 261.12,
      "duration_seconds": 7.78,
      "text": "There are red papules and a few pustules over the cheeks and chin, with some blackheads."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 264.38,
      "end_seconds": 267.27,
      "duration_seconds": 2.89,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 282.76,
      "end_seconds": 287.26,
      "duration_seconds": 4.5,
      "text": "Right, here's what I'm thinking. It points towards moderate acne."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 288.46,
      "end_seconds": 290.34,
      "duration_seconds": 1.88,
      "text": "Will it clear up?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 291.36,
      "end_seconds": 319.92,
      "duration_seconds": 28.56,
      "text": "Nothing I've seen today points to an emergency. It looks like moderate acne. Let's use doxycycline, 100 milligrams, once a day, for six weeks. It's for acne. Don't squeeze them, that's how the marks stay. It takes six to eight weeks to see the difference, so please don't give up in the first fortnight. That's everything on my side. Anything you're unsure about?"
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 321.02,
      "end_seconds": 324.38,
      "duration_seconds": 3.36,
      "text": "Yeah, I think I understand everything. Thanks."
    }
  ]
}