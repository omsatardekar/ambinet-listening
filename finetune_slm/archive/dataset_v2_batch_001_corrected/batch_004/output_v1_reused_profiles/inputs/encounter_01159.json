{
  "schema_version": "1.0",
  "encounter_id": "01159",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.94,
      "end_seconds": 4.23,
      "duration_seconds": 3.29,
      "text": "Sorry, doctor, shall I sit here?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 4.84,
      "end_seconds": 9.35,
      "duration_seconds": 4.51,
      "text": "Right, yes, have a seat. Tell me what's going on."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 10.89,
      "end_seconds": 18.74,
      "duration_seconds": 7.85,
      "text": "Mainly loose motions. There's a couple of other things, but that's the main one."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 22.75,
      "end_seconds": 26.08,
      "duration_seconds": 3.33,
      "text": "What's the timeline, when did it begin?"
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 27.21,
      "end_seconds": 30.76,
      "duration_seconds": 3.55,
      "text": "It's been five days, I'm fairly sure."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 32.32,
      "end_seconds": 35.53,
      "duration_seconds": 3.21,
      "text": "Is it a lot or only a little?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 36.05,
      "end_seconds": 37.08,
      "duration_seconds": 1.03,
      "text": "Mostly mild."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 38.97,
      "end_seconds": 41.34,
      "duration_seconds": 2.37,
      "text": "What aggravates it, if anything?"
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 42.48,
      "end_seconds": 47.7,
      "duration_seconds": 5.22,
      "text": "Erm, yes, eating and drinking milk. That makes it worse."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 49.52,
      "end_seconds": 51.93,
      "duration_seconds": 2.41,
      "text": "Is it constant or in episodes?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 53.29,
      "end_seconds": 56.59,
      "duration_seconds": 3.3,
      "text": "It sort of comes and goes."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 58.57,
      "end_seconds": 61.79,
      "duration_seconds": 3.22,
      "text": "Shall I check your blood pressure and pulse?"
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 71.75,
      "end_seconds": 74.52,
      "duration_seconds": 2.77,
      "text": "That's it, just a little longer..."
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 89.79,
      "end_seconds": 98.17,
      "duration_seconds": 8.38,
      "text": "Okay: SpO2 97 percent on room air, temperature 38.5, pressure 119 over 70, heart rate 89."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 99.95,
      "end_seconds": 101.48,
      "duration_seconds": 1.53,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 102.32,
      "end_seconds": 105.03,
      "duration_seconds": 2.71,
      "text": "I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 106.53,
      "end_seconds": 111.28,
      "duration_seconds": 4.75,
      "text": "I'd like to check you over now, if that's alright."
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 113.11,
      "end_seconds": 114.69,
      "duration_seconds": 1.58,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 115.7,
      "end_seconds": 118.89,
      "duration_seconds": 3.19,
      "text": "Stay as you are for a moment."
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 136.16,
      "end_seconds": 141.53,
      "duration_seconds": 5.37,
      "text": "Bowel sounds are active, tummy is soft with mild tenderness all around."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 142.66,
      "end_seconds": 145.75,
      "duration_seconds": 3.09,
      "text": "So, I'll listen to your chest now."
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.7,
      "end_seconds": 160.06,
      "duration_seconds": 1.36,
      "text": "You're mildly dehydrated."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 165.42,
      "end_seconds": 167.95,
      "duration_seconds": 2.53,
      "text": "Thank you, you can get dressed."
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 186.64,
      "end_seconds": 191.96,
      "duration_seconds": 5.32,
      "text": "Let me check a few things. Any recent antibiotics or black stools?"
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 193.75,
      "end_seconds": 196.44,
      "duration_seconds": 2.69,
      "text": "No, not a single one."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 198.21,
      "end_seconds": 201.24,
      "duration_seconds": 3.03,
      "text": "Have you noticed weight loss or vomiting?"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 201.75,
      "end_seconds": 205.51,
      "duration_seconds": 3.76,
      "text": "No weight loss or vomiting, none of it."
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 206.2,
      "end_seconds": 209.07,
      "duration_seconds": 2.87,
      "text": "Has your heart given you any trouble?"
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 209.6,
      "end_seconds": 211.62,
      "duration_seconds": 2.02,
      "text": "No, that's been fine."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 213.1,
      "end_seconds": 219.79,
      "duration_seconds": 6.69,
      "text": "Let me ask about allergies, anything at all? I'll explain everything as we go along."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 220.76,
      "end_seconds": 224.81,
      "duration_seconds": 4.05,
      "text": "Cat fur. I come out in... well, sneezing."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 236.55,
      "end_seconds": 241.07,
      "duration_seconds": 4.52,
      "text": "Are you taking anything regularly, including from the pharmacy?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 246.66,
      "end_seconds": 248.37,
      "duration_seconds": 1.71,
      "text": "Thyroxine, every morning."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 250.17,
      "end_seconds": 252.38,
      "duration_seconds": 2.21,
      "text": "How much do you take?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 254.17,
      "end_seconds": 255.21,
      "duration_seconds": 1.04,
      "text": "75 micrograms."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 256.54,
      "end_seconds": 259.1,
      "duration_seconds": 2.56,
      "text": "Do you have any long-term conditions?"
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 260.16,
      "end_seconds": 269.64,
      "duration_seconds": 9.48,
      "text": "Let me think, I've had diabetes, yes. I've been reading about it online and it worried me."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 270.24,
      "end_seconds": 270.94,
      "duration_seconds": 0.7,
      "text": "Sure."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 271.47,
      "end_seconds": 274.2,
      "duration_seconds": 2.73,
      "text": "I have an underactive thyroid."
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 283.73,
      "end_seconds": 287.97,
      "duration_seconds": 4.24,
      "text": "What does a normal day of food look like?"
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 289.65,
      "end_seconds": 293.47,
      "duration_seconds": 3.82,
      "text": "Lots of rice, lentils and some fruit."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 294.73,
      "end_seconds": 296.93,
      "duration_seconds": 2.2,
      "text": "Is there someone at home?"
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 298.88,
      "end_seconds": 303.27,
      "duration_seconds": 4.39,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 304.18,
      "end_seconds": 308.54,
      "duration_seconds": 4.36,
      "text": "Any inherited conditions that you know of in the family?"
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 309.59,
      "end_seconds": 311.89,
      "duration_seconds": 2.3,
      "text": "My father has Parkinson's disease."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 328.31,
      "end_seconds": 333.43,
      "duration_seconds": 5.12,
      "text": "Let me tell you where I've got to. This is probably acute gastroenteritis."
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 339.53,
      "end_seconds": 343.38,
      "duration_seconds": 3.85,
      "text": "Um, is there something to worry about?"
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 344.6,
      "end_seconds": 379.97,
      "duration_seconds": 35.37,
      "text": "I understand the worry. At the moment I'd say it's acute gastroenteritis, and we'll know more once the blood salts is back. I'll request blood salts, it'll help with dehydration. Let's use zinc, 20 milligrams, once a day, for ten days. That's for diarrhoea. I'll put all of this in writing so you don't have to remember it. Stick to bananas, rice, toast, curd, and avoid milk and oily food till it settles."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 380.93,
      "end_seconds": 388.23,
      "duration_seconds": 7.3,
      "text": "One warning sign to remember: you pass blood or can't keep anything down. In that case don't wait."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 389.29,
      "end_seconds": 391.1,
      "duration_seconds": 1.81,
      "text": "Okay, makes sense."
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 392.8,
      "end_seconds": 395.64,
      "duration_seconds": 2.84,
      "text": "I'll want another look in three days."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 396.63,
      "end_seconds": 398.57,
      "duration_seconds": 1.94,
      "text": "That's fine with me."
    },
    {
      "segment_id": "SEG0053",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 399.98,
      "end_seconds": 407.95,
      "duration_seconds": 7.97,
      "text": "Can you tell me the plan back in your own words, so I know I've explained it clearly?"
    },
    {
      "segment_id": "SEG0054",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 408.6,
      "end_seconds": 417.56,
      "duration_seconds": 8.96,
      "text": "So, I take the zinc, 20 milligrams, once a day and come back in three days. Is that right?"
    },
    {
      "segment_id": "SEG0055",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 419.03,
      "end_seconds": 422.84,
      "duration_seconds": 3.81,
      "text": "Yes, exactly right. That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0056",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 423.96,
      "end_seconds": 425.9,
      "duration_seconds": 1.94,
      "text": "Thank you, that's helpful."
    },
    {
      "segment_id": "SEG0057",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 426.4,
      "end_seconds": 427.82,
      "duration_seconds": 1.42,
      "text": "Goodbye for now."
    }
  ]
}