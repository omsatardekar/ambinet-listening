{
  "schema_version": "1.0",
  "encounter_id": "01041",
  "segments": [
    {
      "segment_id": "SEG0001",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 0.98,
      "end_seconds": 5.42,
      "duration_seconds": 4.44,
      "text": "Hi, doctor, I hope I'm not disturbing you."
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 6.06,
      "end_seconds": 10.59,
      "duration_seconds": 4.53,
      "text": "You're alright, take a seat. What can I do for you?"
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 12.05,
      "end_seconds": 17.99,
      "duration_seconds": 5.94,
      "text": "Doctor, I've come along because I know the history, if it helps."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 19.6,
      "end_seconds": 23.57,
      "duration_seconds": 3.97,
      "text": "Good, that'll be useful. Pull up a chair."
    },
    {
      "segment_id": "SEG0005",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 25.02,
      "end_seconds": 28.7,
      "duration_seconds": 3.68,
      "text": "She's been having itching especially at night, doctor."
    },
    {
      "segment_id": "SEG0006",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 29.24,
      "end_seconds": 32.69,
      "duration_seconds": 3.45,
      "text": "How many days or weeks has it been?"
    },
    {
      "segment_id": "SEG0007",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 33.22,
      "end_seconds": 35.85,
      "duration_seconds": 2.63,
      "text": "Around a week, I think."
    },
    {
      "segment_id": "SEG0008",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 41.23,
      "end_seconds": 44.89,
      "duration_seconds": 3.66,
      "text": "I think it's been nearer two weeks, actually."
    },
    {
      "segment_id": "SEG0009",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 46.63,
      "end_seconds": 50.91,
      "duration_seconds": 4.28,
      "text": "Okay, so roughly one to two weeks. Is that right?"
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 51.91,
      "end_seconds": 54.39,
      "duration_seconds": 2.48,
      "text": "Yeah, you know, roughly."
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 56.04,
      "end_seconds": 61.06,
      "duration_seconds": 5.02,
      "text": "Okay, give me more detail on it, whatever comes to mind."
    },
    {
      "segment_id": "SEG0012",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 62.69,
      "end_seconds": 84.54,
      "duration_seconds": 21.85,
      "text": "Warmth and night definitely sets it off. I'd call it moderate. Honestly, on and off. I'm hoping you can tell me something definite. I told my wife I'd come today. And, And scratching sores, too. About scratching sores, mostly moderate."
    },
    {
      "segment_id": "SEG0013",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.63,
      "end_seconds": 97.5,
      "duration_seconds": 2.87,
      "text": "Did you get swollen glands or oozing?"
    },
    {
      "segment_id": "SEG0014",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 98.64,
      "end_seconds": 102.91,
      "duration_seconds": 4.27,
      "text": "No swollen glands or oozing, none of it."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 104.2,
      "end_seconds": 109.35,
      "duration_seconds": 5.15,
      "text": "Did you get new medicines, fever or rash on the face?"
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 111.23,
      "end_seconds": 113.67,
      "duration_seconds": 2.44,
      "text": "No, none that I've noticed."
    },
    {
      "segment_id": "SEG0017",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 114.75,
      "end_seconds": 116.39,
      "duration_seconds": 1.64,
      "text": "How's your breathing otherwise?"
    },
    {
      "segment_id": "SEG0018",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 119.79,
      "end_seconds": 122.92,
      "duration_seconds": 3.13,
      "text": "Erm, no, my breathing's been fine."
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 126.8,
      "end_seconds": 129.4,
      "duration_seconds": 2.6,
      "text": "Have you had any surgical procedures?"
    },
    {
      "segment_id": "SEG0020",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 130.68,
      "end_seconds": 137.63,
      "duration_seconds": 6.95,
      "text": "Yeah, yes, I had a caesarean for my second baby, nine years ago."
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 139.28,
      "end_seconds": 140.99,
      "duration_seconds": 1.71,
      "text": "How are your meals?"
    },
    {
      "segment_id": "SEG0022",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 143.42,
      "end_seconds": 147.73,
      "duration_seconds": 4.31,
      "text": "I grab fast food at lunch most days."
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 148.46,
      "end_seconds": 151.58,
      "duration_seconds": 3.12,
      "text": "Alright, do you work outside the home?"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.3,
      "end_seconds": 156.62,
      "duration_seconds": 4.32,
      "text": "I'm a hairdresser, on my feet all day."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.22,
      "end_seconds": 160.96,
      "duration_seconds": 2.74,
      "text": "So, is there someone at home?"
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 161.9,
      "end_seconds": 166.38,
      "duration_seconds": 4.48,
      "text": "My husband and I live above the shop."
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 167.22,
      "end_seconds": 169.16,
      "duration_seconds": 1.94,
      "text": "What about your medical history?"
    },
    {
      "segment_id": "SEG0028",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 171.01,
      "end_seconds": 172.17,
      "duration_seconds": 1.16,
      "text": "Yes, eczema."
    },
    {
      "segment_id": "SEG0029",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 176.15,
      "end_seconds": 182.06,
      "duration_seconds": 5.91,
      "text": "Right, so eczema is already on your record. We'll keep that in mind today."
    },
    {
      "segment_id": "SEG0030",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 194.45,
      "end_seconds": 196.58,
      "duration_seconds": 2.13,
      "text": "Tell me your medicines, please."
    },
    {
      "segment_id": "SEG0031",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 197.91,
      "end_seconds": 202.73,
      "duration_seconds": 4.82,
      "text": "Ah, you know, it's hydrocortisone cream, when needed, doctor."
    },
    {
      "segment_id": "SEG0032",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 204.45,
      "end_seconds": 208.0,
      "duration_seconds": 3.55,
      "text": "So, how long have you been on it?"
    },
    {
      "segment_id": "SEG0033",
      "speaker_id": "person_3",
      "role": "FAMILY_MEMBER",
      "start_seconds": 209.7,
      "end_seconds": 211.52,
      "duration_seconds": 1.82,
      "text": "About nearly five years."
    },
    {
      "segment_id": "SEG0034",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 212.69,
      "end_seconds": 217.5,
      "duration_seconds": 4.81,
      "text": "Any allergies to tablets, food or anything in the environment?"
    },
    {
      "segment_id": "SEG0035",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 218.75,
      "end_seconds": 223.69,
      "duration_seconds": 4.94,
      "text": "Hmm, no, nothing as far as I know."
    },
    {
      "segment_id": "SEG0036",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 239.35,
      "end_seconds": 241.88,
      "duration_seconds": 2.53,
      "text": "Let me take your readings now."
    },
    {
      "segment_id": "SEG0037",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 252.32,
      "end_seconds": 254.57,
      "duration_seconds": 2.25,
      "text": "Okay, this won't take long..."
    },
    {
      "segment_id": "SEG0038",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 276.03,
      "end_seconds": 282.41,
      "duration_seconds": 6.38,
      "text": "Okay: saturation 99 percent, pressure 117 over 76, pulse 65, temp 36.8 degrees."
    },
    {
      "segment_id": "SEG0039",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 283.46,
      "end_seconds": 285.07,
      "duration_seconds": 1.61,
      "text": "Is that normal?"
    },
    {
      "segment_id": "SEG0040",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 286.53,
      "end_seconds": 290.11,
      "duration_seconds": 3.58,
      "text": "Right, I'll come back to the numbers."
    },
    {
      "segment_id": "SEG0041",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 292.79,
      "end_seconds": 296.87,
      "duration_seconds": 4.08,
      "text": "Alright, over here please and I'll take a look."
    },
    {
      "segment_id": "SEG0042",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 297.81,
      "end_seconds": 299.48,
      "duration_seconds": 1.67,
      "text": "Fine by me."
    },
    {
      "segment_id": "SEG0043",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 300.38,
      "end_seconds": 301.56,
      "duration_seconds": 1.18,
      "text": "Nearly finished here."
    },
    {
      "segment_id": "SEG0044",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 308.83,
      "end_seconds": 316.89,
      "duration_seconds": 8.06,
      "text": "There are small burrow-like tracks and red bumps between the fingers and on the wrists, with scratch marks."
    },
    {
      "segment_id": "SEG0045",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 322.61,
      "end_seconds": 327.42,
      "duration_seconds": 4.81,
      "text": "That's the examination finished. Having listened and examined, it points towards scabies."
    },
    {
      "segment_id": "SEG0046",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 329.23,
      "end_seconds": 332.9,
      "duration_seconds": 3.67,
      "text": "So, is there something to worry about?"
    },
    {
      "segment_id": "SEG0047",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 333.45,
      "end_seconds": 363.31,
      "duration_seconds": 29.86,
      "text": "I understand the worry. At the moment I'd say it's scabies, and we'll watch how it goes. I'd like you to take permethrin cream, 5 percent, once, then again after a week, for two weeks. That's for scabies. Everyone at home should be treated at the same time, and wash bedding and clothes at a high temperature. Don't skip meals, and try to eat smaller portions more often through the day."
    },
    {
      "segment_id": "SEG0048",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 365.15,
      "end_seconds": 375.9,
      "duration_seconds": 10.75,
      "text": "Come back or go to emergency straight away if the symptoms get worse. I'd like to see you again in two weeks."
    },
    {
      "segment_id": "SEG0049",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 377.84,
      "end_seconds": 380.11,
      "duration_seconds": 2.27,
      "text": "I can manage that."
    },
    {
      "segment_id": "SEG0050",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 381.38,
      "end_seconds": 384.2,
      "duration_seconds": 2.82,
      "text": "That's all from me. Any questions?"
    },
    {
      "segment_id": "SEG0051",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 385.4,
      "end_seconds": 389.0,
      "duration_seconds": 3.6,
      "text": "Okay, that makes sense. Thanks for explaining."
    },
    {
      "segment_id": "SEG0052",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 389.82,
      "end_seconds": 391.01,
      "duration_seconds": 1.19,
      "text": "Take care now."
    }
  ]
}