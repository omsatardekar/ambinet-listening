    {
      "segment_id": "SEG0017",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 122.65,
      "end_seconds": 124.29,
      "duration_seconds": 1.64,
      "text": "Nothing regular, no."
