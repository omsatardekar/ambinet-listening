    {
      "segment_id": "SEG0005",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 24.33,
      "end_seconds": 32.39,
      "duration_seconds": 8.06,
      "text": "It's been about three months, I'm fairly sure. I just want to get back to normal, really."
