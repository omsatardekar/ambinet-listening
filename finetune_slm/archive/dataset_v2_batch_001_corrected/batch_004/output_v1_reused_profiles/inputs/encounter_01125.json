      "start_seconds": 0.63,
      "end_seconds": 6.75,
      "duration_seconds": 6.12,
      "text": "Doctor, hi, where would you like me to put my coat?"
    },
    {
      "segment_id": "SEG0002",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 7.99,
      "end_seconds": 11.82,
      "duration_seconds": 3.83,
      "text": "That's fine, sit down. Tell me why you came."
    },
    {
      "segment_id": "SEG0003",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 12.7,
      "end_seconds": 19.34,
      "duration_seconds": 6.64,
      "text": "I mean, mainly I've been feeling cold all the time. That's why I came."
    },
    {
      "segment_id": "SEG0004",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 20.06,
      "end_seconds": 22.91,
      "duration_seconds": 2.85,
      "text": "Has this been going on for long?"
