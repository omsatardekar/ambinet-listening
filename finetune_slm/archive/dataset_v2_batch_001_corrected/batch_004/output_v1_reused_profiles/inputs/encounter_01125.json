    {
      "segment_id": "SEG0018",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 124.85,
      "end_seconds": 128.79,
      "duration_seconds": 3.94,
      "text": "What conditions have you been treated for in the past?"
    },
    {
      "segment_id": "SEG0019",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 129.93,
      "end_seconds": 132.44,
      "duration_seconds": 2.51,
      "text": "I've had low haemoglobin, yes."
