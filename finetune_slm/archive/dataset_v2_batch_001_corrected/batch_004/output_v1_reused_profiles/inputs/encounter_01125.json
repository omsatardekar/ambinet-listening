      "segment_id": "SEG0020",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 133.66,
      "end_seconds": 142.69,
      "duration_seconds": 9.03,
      "text": "right, so low haemoglobin is already on your record we'll keep that in mind today does your family have any medical conditions?"
    },
    {
      "segment_id": "SEG0021",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 144.56,
      "end_seconds": 147.09,
      "duration_seconds": 2.53,
      "text": "my uncle has high cholesterol"
