      "role": "DOCTOR",
      "start_seconds": 148.08,
      "end_seconds": 151.95,
      "duration_seconds": 3.87,
      "text": "are there any allergies I should be aware of?"
    },
    {
      "segment_id": "SEG0023",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 152.56,
      "end_seconds": 157.37,
      "duration_seconds": 4.81,
      "text": "hmm, you know, no, not that I know of"
    },
    {
      "segment_id": "SEG0024",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 158.46,
      "end_seconds": 161.58,
      "duration_seconds": 3.12,
      "text": "I'll note down your vital signs first."
    },
    {
      "segment_id": "SEG0025",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 170.81,
      "end_seconds": 173.53,
      "duration_seconds": 2.72,
      "text": "Bear with me while this finishes..."
    },
    {
      "segment_id": "SEG0026",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 189.75,
      "end_seconds": 204.33,
      "duration_seconds": 14.58,
      "text": "okay: pressure 121 over 70, BMI works out to 36.3, oxygen saturation is 98 percent, respiratory rate 15, weight 94 kilos, temp 36.9 degrees, height 161 centimetres, pulse is 74 beats a minute"
    },
    {
      "segment_id": "SEG0027",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 206.26,
      "end_seconds": 207.69,
      "duration_seconds": 1.43,
      "text": "is that okay?"
    },
    {
      "segment_id": "SEG0028",
