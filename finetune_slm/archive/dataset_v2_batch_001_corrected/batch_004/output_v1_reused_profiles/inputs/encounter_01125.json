    {
      "segment_id": "SEG0014",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 94.6,
      "end_seconds": 97.32,
      "duration_seconds": 2.72,
      "text": "A few questions about your lifestyle now."
    },
    {
      "segment_id": "SEG0015",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 97.83,
      "end_seconds": 117.95,
      "duration_seconds": 20.12,
      "text": "I used to drink heavily but I stopped four years ago. I have about eight cigarettes in a day. Lots of rice, lentils and some fruit. I'm a hairdresser, on my feet all day. I hardly move around during the day."
    },
    {
      "segment_id": "SEG0016",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 118.66,
      "end_seconds": 121.45,
      "duration_seconds": 2.79,
      "text": "are you on any regular medication?"
