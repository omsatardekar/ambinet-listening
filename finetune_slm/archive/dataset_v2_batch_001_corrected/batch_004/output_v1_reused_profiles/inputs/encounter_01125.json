      "role": "PATIENT",
      "start_seconds": 56.66,
      "end_seconds": 62.21,
      "duration_seconds": 5.55,
      "text": "Erm, um, no, I haven't had any of them."
    },
    {
      "segment_id": "SEG0010",
      "speaker_id": "person_2",
      "role": "DOCTOR",
      "start_seconds": 63.56,
      "end_seconds": 66.75,
      "duration_seconds": 3.19,
      "text": "Any problems with your joints or muscles?"
    },
    {
      "segment_id": "SEG0011",
      "speaker_id": "person_1",
      "role": "PATIENT",
      "start_seconds": 67.62,
      "end_seconds": 69.86,
      "duration_seconds": 2.24,
